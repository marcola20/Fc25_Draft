@page "/power-ranking"
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Utilities
@inject ILigaPublicService LigaService
@inject EscudoService EscudoService

<PageTitle>Power Ranking</PageTitle>

<div class="container-fluid py-3">
    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    }
    else if (_erro is not null)
    {
        <div class="alert alert-danger"><strong>Erro ao carregar o Power Ranking:</strong> @_erro</div>
    }
    else if (_ranking is null || _ranking.Itens.Count == 0)
    {
        <div class="alert alert-info">Nenhum time com elenco ainda.</div>
    }
    else
    {
        <div class="d-flex align-items-center gap-3 mb-1 flex-wrap">
            <h1 class="h3 mb-0">Power Ranking</h1>
            <a href="/ranking-clubes" class="btn btn-sm btn-outline-secondary">📊 Ranking de Clubes</a>
        </div>
        <p class="text-muted small mb-3">
            Quem está mais forte agora, juntando Série A e Série B: elenco, rating dos resultados e forma recente.
            Clique em Nota, XI, Rating ou Forma para ordenar; o # continua sendo a posição no Power Ranking.
            @if (_ranking.AtualizadoAte is DateOnly ate)
            {
                <span>Jogos até @ate.ToString("dd/MM")@(_ranking.ComparadoCom is DateOnly antes ? $"; setas comparam com {antes:dd/MM}" : "").</span>
            }
        </p>

        <ShareableCard Id="cap-power-ranking" Titulo="Power Ranking" Subtitulo="@Subtitulo" Arquivo="cbfv-power-ranking.png">
            <div class="table-responsive mb-4">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center">#</th>
                            <th class="text-center" title="Posições ganhas ou perdidas desde o dia de jogos anterior">±</th>
                            <th>Clube</th>
                            <th class="text-center" role="button" title="Nota final (0 a 100)" @onclick="() => OrdenarPor(Coluna.Nota)">Nota@(Seta(Coluna.Nota))</th>
                            <th class="text-center" role="button" title="Média de overall dos @PowerRankingCriterios.JogadoresNoXI melhores" @onclick="() => OrdenarPor(Coluna.XI)">XI@(Seta(Coluna.XI))</th>
                            <th class="text-center d-none d-md-table-cell" role="button" title="Rating Elo de todos os jogos" @onclick="() => OrdenarPor(Coluna.Rating)">Rating@(Seta(Coluna.Rating))</th>
                            <th class="d-none d-sm-table-cell" role="button" title="Últimos jogos, do mais recente para o mais antigo (ordena pelo aproveitamento)" @onclick="() => OrdenarPor(Coluna.Forma)">Forma@(Seta(Coluna.Forma))</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Linhas)
                        {
                            <tr>
                                <td class="text-center">
                                    <span class="badge @(r.Posicao <= 3 ? "bg-warning text-dark" : "bg-secondary")">@r.Posicao</span>
                                </td>
                                <td class="text-center small text-nowrap">
                                    @if (r.Variacao is int v && v != 0)
                                    {
                                        <span class="@(v > 0 ? "text-success" : "text-danger") fw-semibold">@(v > 0 ? "▲" : "▼")@Math.Abs(v)</span>
                                    }
                                    else if (r.Variacao is not null)
                                    {
                                        <span class="text-muted">–</span>
                                    }
                                </td>
                                <td>
                                    <a href="@($"/teams/details/{r.TimeId}")" class="d-flex align-items-center gap-2 text-decoration-none text-reset">
                                        <img src="@EscudoService.GetEscudo(r.TimeNome)" alt="Escudo @r.TimeNome"
                                             style="width:24px;height:24px;object-fit:contain;" />
                                        <span class="fw-semibold">@r.TimeNome</span>
                                        @if (r.Divisao is Divisao d)
                                        {
                                            <span class="badge @(d == Divisao.SerieA ? "bg-primary" : "bg-info text-dark")">@(d == Divisao.SerieA ? "A" : "B")</span>
                                        }
                                    </a>
                                </td>
                                <td class="text-center fw-bold" title="@Composicao(r)">@r.Nota.ToString("0.0")</td>
                                <td class="text-center" title="Nota do elenco: @r.NotaElenco.ToString("0")">@r.ForcaXI.ToString("0.0")</td>
                                <td class="text-center d-none d-md-table-cell" title="Nota do rating: @r.NotaRating.ToString("0")">@r.Rating</td>
                                <td class="d-none d-sm-table-cell">
                                    <div class="d-flex gap-1">
                                        @foreach (var resultado in r.Forma)
                                        {
                                            <span class="badge rounded-pill @TimeJogoEstilo.Badge(resultado)" style="width: 1.6rem;">@resultado</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </ShareableCard>

        <div class="card">
            <div class="card-body small">
                <h2 class="h6">Como a nota é calculada</h2>
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <strong>Elenco — @PowerRankingCriterios.PesoElenco%</strong>
                        <ul class="mb-0 ps-3">
                            <li>Média de overall dos @PowerRankingCriterios.JogadoresNoXI melhores do elenco atual.</li>
                            <li>O melhor XI da liga fica com 100 e o pior com 0.</li>
                        </ul>
                    </div>
                    <div class="col-12 col-md-4">
                        <strong>Rating — @PowerRankingCriterios.PesoRating%</strong>
                        <ul class="mb-0 ps-3">
                            <li>Elo de todos os jogos, de todas as competições: todo time começa com @PowerRankingCriterios.RatingInicial.</li>
                            <li>Ganhar de time forte rende mais que ganhar de time fraco; goleada pesa mais.</li>
                            <li>A cada temporada nova o rating volta 1/3 do caminho até @PowerRankingCriterios.RatingInicial.</li>
                            <li>O maior rating fica com 100 e o menor com 0.</li>
                        </ul>
                    </div>
                    <div class="col-12 col-md-4">
                        <strong>Forma — @PowerRankingCriterios.PesoForma%</strong>
                        <ul class="mb-0 ps-3">
                            <li>Aproveitamento nos últimos @PowerRankingCriterios.JogosNaForma jogos (todas as competições).</li>
                            <li>Com menos de @PowerRankingCriterios.JogosNaForma jogos, os que faltam contam como 50%.</li>
                        </ul>
                    </div>
                </div>
                <p class="text-muted mb-0 mt-2">
                    Jogo decidido nos pênaltis conta como empate; W.O. não entra.
                    As setas comparam com o ranking antes do último dia de jogos (com o elenco de hoje).
                </p>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private string? _erro;
    private PowerRankingDto? _ranking;

    private enum Coluna { Nota, XI, Rating, Forma }

    private Coluna _coluna = Coluna.Nota;
    private bool _crescente;

    // O desempate é sempre a posição no Power Ranking.
    private IEnumerable<PowerRankingItemDto> Linhas
    {
        get
        {
            if (_ranking is null)
                return Array.Empty<PowerRankingItemDto>();

            Func<PowerRankingItemDto, double> chave = _coluna switch
            {
                Coluna.XI => r => r.ForcaXI,
                Coluna.Rating => r => r.Rating,
                Coluna.Forma => r => r.NotaForma,
                _ => r => r.Nota
            };
            var ordenadas = _crescente ? _ranking.Itens.OrderBy(chave) : _ranking.Itens.OrderByDescending(chave);
            return ordenadas.ThenBy(r => r.Posicao);
        }
    }

    // Primeiro clique ordena do maior para o menor; clicar de novo inverte.
    private void OrdenarPor(Coluna coluna)
    {
        _crescente = _coluna == coluna && !_crescente;
        _coluna = coluna;
    }

    private string Seta(Coluna coluna) => _coluna != coluna ? "" : _crescente ? " ▲" : " ▼";

    private string Subtitulo => _ranking?.AtualizadoAte is DateOnly ate ? $"Jogos até {ate:dd/MM}" : "Elenco atual";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _ranking = await LigaService.GetPowerRankingAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Composicao(PowerRankingItemDto r) =>
        $"Elenco {r.NotaElenco:0} × {PowerRankingCriterios.PesoElenco}% + Rating {r.NotaRating:0} × {PowerRankingCriterios.PesoRating}% + Forma {r.NotaForma:0} × {PowerRankingCriterios.PesoForma}%";
}
