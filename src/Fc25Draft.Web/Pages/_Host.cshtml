@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace Fc25Draft.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />

    <meta name="theme-color" content="#0D1B2A" />
    <meta name="color-scheme" content="light dark" />

    @* Tema: escolhido no botão do topo (guardado no navegador) ou, sem escolha, o do sistema.
       Roda antes do CSS para a página não piscar clara ao abrir no modo escuro. *@
    <script>
        (function () {
            var chave = 'cbfv-tema';
            var escuroNoSistema = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;
            function salvo() { try { return localStorage.getItem(chave); } catch (e) { return null; } }
            function aplicar() {
                var t = salvo();
                var escuro = t === 'escuro' || (t !== 'claro' && !!escuroNoSistema && escuroNoSistema.matches);
                document.documentElement.setAttribute('data-bs-theme', escuro ? 'dark' : 'light');
            }
            aplicar();
            if (escuroNoSistema && escuroNoSistema.addEventListener) escuroNoSistema.addEventListener('change', aplicar);
            window.cbfvTema = {
                escuro: function () { return document.documentElement.getAttribute('data-bs-theme') === 'dark'; },
                alternar: function () {
                    try { localStorage.setItem(chave, this.escuro() ? 'claro' : 'escuro'); } catch (e) { }
                    aplicar();
                    return this.escuro();
                }
            };
        })();
    </script>

    @* App instalável no celular (PWA). A prévia dos links (Open Graph) vem de cada página, no HeadOutlet. *@
    <link rel="manifest" href="manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="CBFV" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" asp-append-version="true" />
    <link href="css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="Fc25Draft.Web.styles.css" rel="stylesheet" asp-append-version="true" />
    <link rel="icon" type="image/png" href="favicon.png?v=2" />
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" param-IpDoCliente="@(HttpContext.Connection.RemoteIpAddress?.ToString())" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            Ocorreu um erro. A aplicação pode não responder até ser recarregada.
        </environment>
        <environment include="Development">
            Ocorreu uma exceção não tratada. Verifique as ferramentas do navegador para mais detalhes.
        </environment>
        <a href="" class="reload">Recarregar</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="js/html2canvas.min.js"></script>
    <script src="js/app.js" asp-append-version="true"></script>
    <script src="_framework/blazor.server.js"></script>
    <script>
        // Service worker do app instalado: só mostra uma página de "sem conexão" quando a rede cai.
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () { navigator.serviceWorker.register('sw.js'); });
        }
    </script>
</body>
</html>
