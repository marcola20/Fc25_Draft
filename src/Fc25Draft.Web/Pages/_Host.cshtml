@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace Fc25Draft.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    // URL canônica pública (WhatsApp/redes exigem URL absoluta e estável em https).
    var baseUrl = "https://cbfv-app.onrender.com";
    var ogImage = $"{baseUrl}/images/og-cover.png?v=1";
    var siteTitle = "CBFV";
    var siteDesc = "Acompanhe a CBFV: classificação, rodadas, mata-mata, estatísticas, draft e mercado de transferências.";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />

    <title>@siteTitle</title>
    <meta name="description" content="@siteDesc" />
    <meta name="theme-color" content="#0D1B2A" />

    <!-- Open Graph (WhatsApp / Facebook / etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CBFV" />
    <meta property="og:title" content="@siteTitle" />
    <meta property="og:description" content="@siteDesc" />
    <meta property="og:url" content="@baseUrl/" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:secure_url" content="@ogImage" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CBFV" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@siteTitle" />
    <meta name="twitter:description" content="@siteDesc" />
    <meta name="twitter:image" content="@ogImage" />

    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="Fc25Draft.Web.styles.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.png?v=2" />
    <link rel="apple-touch-icon" href="favicon.png?v=2" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            Ocorreu um erro. A aplicação pode não responder até ser recarregada.
        </environment>
        <environment include="Development">
            Ocorreu uma exceção não tratada. Verifique as ferramentas do navegador para mais detalhes.
        </environment>
        <a href="" class="reload">Recarregar</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="js/html2canvas.min.js"></script>
    <script src="js/app.js"></script>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
