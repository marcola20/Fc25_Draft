@page "/mercado"
@page "/market"
@page "/market/{cycleId:guid}"
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading
@using System.Threading.Tasks
@using Microsoft.Extensions.Logging
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Interfaces
@using Fc25Draft.Web.Components.Market
@using Fc25Draft.Web.Hubs
@using Fc25Draft.Web.Models.Market
@using Fc25Draft.Web.Services
@using Fc25Draft.Web.Utilities
@using CoreItemVm = Fc25Draft.Core.DTOs.MarketItemVm
@using CoreQueryVm = Fc25Draft.Core.DTOs.MarketQueryVm
@inject MarketClient Client
@inject MarketHubClient Hub
@inject MarketUpdateService MarketUpdates
@inject IPositionService PositionService
@inject ILogger<Index> Logger
@inject TeamAccessService TeamAccess
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService
@implements IAsyncDisposable

<PageTitle>Mercado de Transferências</PageTitle>

<PageHeader Title="Mercado de Transferências"
            Subtitle="Negocie jogadores disponíveis e acompanhe o mercado em tempo real."
            Actions="@HeaderActions" />

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button type="button"
                class="nav-link @(_activeTab == MarketTab.Items ? "active" : null)"
                role="tab"
                aria-selected="@(_activeTab == MarketTab.Items)"
                @onclick="async () => await SetTabAsync(MarketTab.Items)">
            Itens disponíveis
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button type="button"
                class="nav-link @(_activeTab == MarketTab.History ? "active" : null)"
                role="tab"
                aria-selected="@(_activeTab == MarketTab.History)"
                @onclick="async () => await SetTabAsync(MarketTab.History)">
            Histórico de Lances
        </button>
    </li>
</ul>

@if (_activeTab == MarketTab.Items)
{
    <MarketFilters OnApply="ApplyFiltersAsync"
                   PositionOptions="@_positionOptions"
                   SortOptions="@SortOptions"
                   StatusOptions="@StatusOptions"
                   ResultsSummary="@GetResultsSummary()" />

    @if (!string.IsNullOrEmpty(_cycleNotice))
    {
        <div class="alert alert-info mt-3" role="status">@_cycleNotice</div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger mt-3" role="alert">@_errorMessage</div>
    }
    else if (_isLoading && PageData is null)
    {
        <div class="alert alert-info mt-3" role="status">Carregando itens...</div>
    }
    else if (PageData is null)
    {
        <div class="alert alert-info mt-3" role="status">Carregando itens...</div>
    }
    else if (PageData.Items.Count == 0)
    {
        <div class="alert alert-secondary mt-3" role="status">Nenhum item corresponde aos filtros selecionados.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mt-3">
            @foreach (var item in PageData.Items)
            {
                <div class="col">
                    <MarketItemCard @key="item.ItemId"
                                    Item="item"
                                    CurrentTeamId="_currentTeamId"
                                    ServerTimeOffset="ServerTimeOffset"
                                    OnBidPlaced="@(EventCallback.Factory.Create<CoreItemVm>(this, HandleBidPlacedAsync))"
                                    OnBought="@(EventCallback.Factory.Create<CoreItemVm>(this, HandleBoughtAsync))"
                                    OnTeamTokenMissing="@(EventCallback.Factory.Create(this, HandleTeamTokenMissingAsync))"
                                    OnEditStart="HandleEditStart"
                                    OnEditEnd="HandleEditEnd" />
                </div>
            }
        </div>
    }

    @if (_isLoading && PageData is not null)
    {
        <div class="alert alert-info mt-3" role="status">Recarregando itens...</div>
    }

    @if (TotalPages > 1 && PageData is not null)
    {
        <nav class="mt-4" aria-label="Paginação do mercado">
            <ul class="pagination pagination-sm justify-content-center flex-wrap">
                <li class="page-item @(Query.Page == 1 ? "disabled" : string.Empty)">
                    <button class="page-link" type="button" @onclick="async () => await GoToPageAsync(Query.Page - 1)" aria-label="Página anterior" disabled="@(Query.Page == 1)">Anterior</button>
                </li>
                @foreach (var page in GetVisiblePages())
                {
                    <li class="page-item @(page == Query.Page ? "active" : string.Empty)">
                        <button class="page-link" type="button" @onclick="async () => await GoToPageAsync(page)" aria-current="@(page) == Query.Page ? "page" : null)">@(page)</button>
                    </li>
                }
                <li class="page-item @(Query.Page >= TotalPages ? "disabled" : string.Empty)">
                    <button class="page-link" type="button" @onclick="async () => await GoToPageAsync(Query.Page + 1)" aria-label="Próxima página" disabled="@(Query.Page >= TotalPages)">Próxima</button>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <section class="mt-3" aria-live="polite">
        <p class="text-muted small">Eventos mais recentes aparecem no topo. Atualizações são aplicadas automaticamente.</p>

        @if (!string.IsNullOrEmpty(_historyError))
        {
            <div class="alert alert-danger" role="alert">@_historyError</div>
        }
        else if (_historyLoading && !_historyInitialized)
        {
            <div class="alert alert-info" role="status">Carregando histórico de lances...</div>
        }
        else if (_historyEvents.Count == 0)
        {
            <div class="alert alert-secondary" role="status">Nenhum lance registrado ainda neste ciclo.</div>
        }
        else
        {
            <div class="border-start border-2 ps-3 mt-3">
                @foreach (var entry in _historyEvents)
                {
                    <article class="mb-4 position-relative" @key="entry.TransactionId">
                        <span class="position-absolute start-0 translate-middle bg-primary rounded-circle" style="width: 12px; height: 12px;"></span>
                        <div class="ms-4">
                            <div class="fw-semibold">@entry.TypeName</div>
                            <div class="text-muted small">@FormatHistoryTimestamp(entry.OccurredAtUtc)</div>
                            <div class="small">@MarketHistoryTextFormatter.FormatDescription(entry)</div>
                        </div>
                    </article>
                }
            </div>
        }

        @if (_historyLoading && _historyInitialized)
        {
            <div class="alert alert-info" role="status">Atualizando histórico...</div>
        }

        @if (_historyHasMore || _historyLoadingMore)
        {
            <div class="d-flex gap-2 mt-3">
                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        @onclick="LoadMoreHistoryAsync"
                        disabled="@(!_historyHasMore || _historyLoadingMore)">
                    Carregar mais
                </button>
                @if (_historyLoadingMore)
                {
                    <span class="text-muted small align-self-center">Carregando eventos anteriores...</span>
                }
            </div>
        }
    </section>
}

@if (_teamTokenModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Token do time</h5>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="CloseTeamTokenModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="teamTokenInput">Token</label>
                        <input id="teamTokenInput"
                               class="form-control"
                               @bind="_teamTokenInput"
                               @bind:event="oninput"
                               autocomplete="one-time-code" />
                    </div>
                    @if (!string.IsNullOrEmpty(_teamTokenError))
                    {
                        <div class="alert alert-danger" role="alert">@_teamTokenError</div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Informe o token fornecido pelo administrador do seu time.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseTeamTokenModal">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ClearTeamTokenAsync" disabled="@(!_teamTokenConfigured)">Remover</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveTeamTokenAsync">Salvar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid? CycleId { get; set; }

    private static readonly IReadOnlyList<MarketSortOption> SortOptions = new[]
    {
        new MarketSortOption("expiresAtUtc", "Terminando em breve"),
        new MarketSortOption("-expiresAtUtc", "Terminando por último"),
        new MarketSortOption("-currentBid", "Maior lance"),
        new MarketSortOption("currentBid", "Menor lance")
    };

    private static readonly IReadOnlyList<string> StatusOptions = new[] { "Ativo", "Vendido", "Cancelado", "Expirado", "Encerrado" };

    private enum MarketTab
    {
        Items,
        History
    }

    private const int HistoryPageSize = 25;
    private static readonly TimeSpan[] HubReconnectDelays =
    {
        TimeSpan.Zero,
        TimeSpan.FromMilliseconds(250),
        TimeSpan.FromSeconds(1),
        TimeSpan.FromSeconds(2)
    };

    private readonly List<MarketPositionOption> _positionOptions = new();
    private readonly HashSet<Guid> _editing = new();
    private CoreQueryVm Query = new() { Page = 1, PageSize = 20 };
    private PagedResult<CoreItemVm>? PageData;
    private TimeSpan ServerTimeOffset = TimeSpan.Zero;
    private Guid ActiveCycleId;
    private CancellationTokenSource? _lifetimeCts;
    private CancellationTokenSource? _loadCts;
    private readonly SemaphoreSlim _joinSemaphore = new(1, 1);
    private Guid? _currentJoinedCycleId;
    private bool _hubConnected;
    private Task? _pendingReloadTask;
    private Func<CoreItemVm, Task>? _bidUpdatedHandler;
    private Func<CoreItemVm, Task>? _itemBoughtHandler;
    private Func<CoreItemVm, Task>? _itemClosedHandler;
    private bool _hubHandlersAttached;
    private bool _isLoading;
    private bool _initialized;
    private string? _errorMessage;
    private string? _cycleNotice;
    private MarketTab _activeTab = MarketTab.Items;
    private bool _teamTokenConfigured;
    private bool _teamTokenModalOpen;
    private string _teamTokenInput = string.Empty;
    private string? _teamTokenError;
    private Guid? _currentTeamId;

    private readonly List<MarketTransactionDto> _historyEvents = new();
    private readonly HashSet<Guid> _historyIds = new();
    private readonly SemaphoreSlim _historySemaphore = new(1, 1);
    private CancellationTokenSource? _historyLifecycleCts;
    private CancellationTokenSource? _historyRequestCts;
    private PeriodicTimer? _historyTimer;
    private Task? _historyPollingTask;
    private bool _historyInitialized;
    private bool _historyLoading;
    private bool _historyLoadingMore;
    private bool _historyHasMore;
    private string? _historyError;
    private DateTime? _historyLatestUtc;
    private int _historyNextPage = 1;

    private RenderFragment HeaderActions => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "d-flex flex-wrap gap-2");

        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", "btn btn-outline-primary btn-sm");
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, OpenTeamTokenModal));
        builder.AddContent(seq++, "Token do time");
        var badgeClass = _teamTokenConfigured ? "bg-success" : "bg-warning text-dark";
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", $"badge {badgeClass} ms-2");
        builder.AddContent(seq++, _teamTokenConfigured ? "Configurado" : "Não configurado");
        builder.CloseElement();
        builder.CloseElement();

        builder.OpenComponent<NavLink>(seq++);
        builder.AddAttribute(seq++, "class", "btn btn-outline-secondary btn-sm");
        builder.AddAttribute(seq++, "href", "/mercado/historico");
        builder.AddAttribute(seq++, "ChildContent", (RenderFragment)(builder2 =>
        {
            builder2.AddContent(0, "Histórico do Mercado");
        }));
        builder.CloseComponent();

        builder.OpenComponent<NavLink>(seq++);
        builder.AddAttribute(seq++, "class", "btn btn-outline-secondary btn-sm");
        builder.AddAttribute(seq++, "href", "/admin/transferencias/historico");
        builder.AddAttribute(seq++, "ChildContent", (RenderFragment)(builder2 =>
        {
            builder2.AddContent(0, "Histórico de Transferências");
        }));
        builder.CloseComponent();

        builder.CloseElement();
    };

    private void RefreshLayoutHeader()
    {
        LayoutState.SetPage(
            NavigationService.GetPageDefinition("/mercado"),
            subtitle: "Negocie jogadores disponíveis e acompanhe o mercado em tempo real.");
    }

    private int TotalPages
    {
        get
        {
            if (PageData is null)
            {
                return 0;
            }

            if (PageData.Total == 0 || PageData.PageSize <= 0)
            {
                return 1;
            }

            return (int)Math.Ceiling(PageData.Total / (double)PageData.PageSize);
        }
    }

    protected override void OnInitialized()
    {
        RefreshLayoutHeader();
        MarketUpdates.OnBidUpdated += HandleMarketUpdateEvent;
        MarketUpdates.OnItemBought += HandleMarketUpdateEvent;
        MarketUpdates.OnItemClosed += HandleMarketUpdateEvent;
    }

    private async void HandleMarketUpdateEvent(Guid cycleId, CoreItemVm vm)
    {
        if (ActiveCycleId != Guid.Empty && cycleId != ActiveCycleId)
            return;
        await InvokeAsync(() => HandleRealtimeUpdateAsync(vm));
    }

    protected override async Task OnInitializedAsync()
    {
        _lifetimeCts = new CancellationTokenSource();
        ActiveCycleId = CycleId ?? Guid.Empty;
        TeamAccess.TokenChanged += OnTeamTokenChanged;
        await LoadPositionsAsync();
    }

    protected override void OnParametersSet()
    {
        var incomingCycle = CycleId ?? Guid.Empty;
        if (incomingCycle == ActiveCycleId)
        {
            return;
        }

        ActiveCycleId = incomingCycle;
        _currentJoinedCycleId = null;
        ResetHistoryState();
        if (_initialized)
        {
            _pendingReloadTask = InvokeAsync(async () =>
            {
                Logger.LogInformation("Cycle changed to {CycleId}. Re-establishing hub join.", ActiveCycleId);
                await EnsureHubConnectedAsync();
                await JoinCycleAsync();
                var ct = PrepareNewLoadCts();
                await LoadPageAsync(1, ct);
            });
        }

        if (_activeTab == MarketTab.History)
        {
            _ = InvokeAsync(EnsureHistoryInitializedAsync);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var ct = PrepareNewLoadCts();
        await LoadPageAsync(1, ct);

        try
        {
            var hubToken = _lifetimeCts?.Token ?? CancellationToken.None;
            await Hub.ConnectAsync(hubToken);
            _hubConnected = Hub.IsConnected;

            if (_hubConnected)
            {
                AttachHubHandlers();
                var joined = await JoinCycleAsync();
                if (!joined)
                {
                    // hub unavailable — C# events (MarketUpdateService) handle real-time updates
                }
            }
            else
            {
                // hub unavailable — C# events (MarketUpdateService) handle real-time updates
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao estabelecer conexão com o hub do mercado.");
        }

        await LoadTeamTokenStatusAsync();

        _initialized = true;
    }

    private async Task LoadPositionsAsync()
    {
        try
        {
            var positions = await PositionService.GetAllAsync();
            _positionOptions.Clear();
            _positionOptions.AddRange(positions.Select(p => new MarketPositionOption(p.PositionId, p.Name)));
        }
        catch
        {
            _positionOptions.Clear();
        }
        finally
        {
            StateHasChangedSafe();
        }
    }

    private async Task LoadPageAsync(int page, CancellationToken ct)
    {
        Query.Page = page < 1 ? 1 : page;
        _isLoading = true;
        _errorMessage = null;
        _cycleNotice = null;
        StateHasChangedSafe();

        try
        {
            var cycleFilter = ActiveCycleId == Guid.Empty ? (Guid?)null : ActiveCycleId;
            var result = await Client.GetItemsAsync(cycleFilter, Query, ct);
            var items = result?.Items ?? Array.Empty<CoreItemVm>();
            var total = result?.Total ?? 0;
            PageData = new PagedResult<CoreItemVm>(items, total, Query.Page, Query.PageSize);
            ComputeServerOffsetFromClient();

            // Se não tinha ciclo na URL, descobre pelo primeiro item e entra no grupo SignalR
            if (ActiveCycleId == Guid.Empty)
            {
                var detectedCycle = items.FirstOrDefault(i => i.CycleId != Guid.Empty)?.CycleId;
                if (detectedCycle.HasValue && detectedCycle.Value != Guid.Empty)
                {
                    ActiveCycleId = detectedCycle.Value;
                    _ = InvokeAsync(JoinCycleAsync);
                }
            }
        }
        catch (MarketCycleUnavailableException ex)
        {
            Logger.LogInformation("Market cycle unavailable: {Message}", ex.Message);
            _cycleNotice = string.IsNullOrWhiteSpace(ex.Message)
                ? "Este ciclo ainda não está ativo."
                : ex.Message;
            PageData = PagedResult<CoreItemVm>.Empty(Query.Page, Query.PageSize);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao carregar os itens do mercado para a página {Page}", Query.Page);
            _errorMessage = "Não foi possível carregar os itens do mercado no momento. Tente novamente em instantes.";
        }
        finally
        {
            _isLoading = false;
            StateHasChangedSafe();
        }
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || page == Query.Page || PageData is null)
        {
            return;
        }

        var totalPages = TotalPages;
        if (page > totalPages)
        {
            page = totalPages;
        }

        var ct = PrepareNewLoadCts();
        await LoadPageAsync(page, ct);
    }

    private async Task ApplyFiltersAsync(CoreQueryVm incoming)
    {
        Query = new CoreQueryVm
        {
            Name = incoming.Name,
            Positions = incoming.Positions?.ToList() ?? new List<int>(),
            OverallMin = incoming.OverallMin,
            OverallMax = incoming.OverallMax,
            Status = incoming.Status,
            Page = 1,
            PageSize = incoming.PageSize > 0 ? incoming.PageSize : 20,
            Sort = incoming.Sort
        };

        var ct = PrepareNewLoadCts();
        await LoadPageAsync(1, ct);
    }

    private async Task HandleBidPlacedAsync(CoreItemVm vm)
    {
        var ct = PrepareNewLoadCts();
        await ReloadSingleItemAsync(vm.ItemId, ct);
        await RefreshHistoryAsync();
    }

    private async Task HandleBoughtAsync(CoreItemVm vm)
    {
        var ct = PrepareNewLoadCts();
        await ReloadSingleItemAsync(vm.ItemId, ct);
        await RefreshHistoryAsync();
    }

    private async Task ReloadSingleItemAsync(Guid itemId, CancellationToken ct)
    {
        if (itemId == Guid.Empty)
        {
            return;
        }

        if (_editing.Contains(itemId))
        {
            return;
        }

        await LoadPageAsync(Query.Page, ct);
    }

    private void MergeItem(CoreItemVm incoming)
    {
        if (PageData is null || PageData.Items is null || PageData.Items.Count == 0)
        {
            return;
        }

        if (_editing.Contains(incoming.ItemId))
        {
            return;
        }

        var list = PageData.Items.ToList();
        var index = list.FindIndex(item => item.ItemId == incoming.ItemId);
        if (index >= 0)
        {
            list[index] = incoming;
            PageData = new PagedResult<CoreItemVm>(list, PageData.Total, PageData.Page, PageData.PageSize);
        }
    }

    private async Task HandleRealtimeUpdateAsync(CoreItemVm incoming)
    {
        var isEditing = _editing.Contains(incoming.ItemId);

        if (!isEditing)
        {
            MergeItem(incoming);
        }

        if (!isEditing && IsItemClosed(incoming) && _lifetimeCts is not null && !_lifetimeCts.IsCancellationRequested)
        {
            Logger.LogInformation("Realtime update indicates item {ItemId} is closed. Reloading page {Page}.", incoming.ItemId, Query.Page);
            var ct = PrepareNewLoadCts();
            if (_editing.Count == 0)
            {
                await LoadPageAsync(Query.Page, ct);
            }
        }

        await RefreshHistoryAsync();

        if (_lifetimeCts is null || _lifetimeCts.IsCancellationRequested)
        {
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task HandleEditStart(Guid itemId)
    {
        _editing.Add(itemId);
        return Task.CompletedTask;
    }

    private Task HandleEditEnd(Guid itemId)
    {
        _editing.Remove(itemId);
        return Task.CompletedTask;
    }

    private bool IsItemClosed(CoreItemVm item)
    {
        var serverNow = DateTime.UtcNow + ServerTimeOffset;
        if (item.ExpiresAtUtc <= serverNow)
        {
            return true;
        }

        if (string.IsNullOrWhiteSpace(item.Status))
        {
            return false;
        }

        return item.Status.Equals("Encerrado", StringComparison.OrdinalIgnoreCase)
            || item.Status.Equals("Vendido", StringComparison.OrdinalIgnoreCase)
            || item.Status.Equals("Cancelado", StringComparison.OrdinalIgnoreCase)
            || item.Status.Equals("Expirado", StringComparison.OrdinalIgnoreCase);
    }

    private IEnumerable<int> GetVisiblePages()
    {
        var totalPages = TotalPages;
        if (totalPages <= 1)
        {
            yield break;
        }

        var start = Math.Max(1, Query.Page - 2);
        var end = Math.Min(totalPages, start + 4);
        start = Math.Max(1, end - 4);

        for (var page = start; page <= end; page++)
        {
            yield return page;
        }
    }

    private void ComputeServerOffsetFromClient()
    {
        if (Client.LastServerTimeUtc.HasValue)
        {
            ServerTimeOffset = Client.LastServerTimeUtc.Value - DateTime.UtcNow;
        }
    }

    private CancellationToken PrepareNewLoadCts()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCts?.Token ?? CancellationToken.None);
        return _loadCts.Token;
    }

    private async Task<bool> JoinCycleAsync()
    {
        if (_lifetimeCts is null || _lifetimeCts.IsCancellationRequested)
        {
            Logger.LogDebug("Join cycle skipped because the component is disposing.");
            return false;
        }

        if (ActiveCycleId == Guid.Empty)
        {
            Logger.LogInformation("Skipping hub join because no active cycle is selected.");
            _currentJoinedCycleId = null;
            return true;
        }

        var acquired = false;

        try
        {
            await _joinSemaphore.WaitAsync(_lifetimeCts.Token);
            acquired = true;
        }
        catch (OperationCanceledException)
        {
            Logger.LogDebug("Join semaphore wait canceled for cycle {CycleId}.", ActiveCycleId);
            return false;
        }
        catch (ObjectDisposedException)
        {
            return false;
        }

        try
        {
            if (_currentJoinedCycleId == ActiveCycleId && _hubConnected && Hub.IsConnected)
            {
                Logger.LogDebug("Already joined to cycle {CycleId}; skipping join.", ActiveCycleId);
                // hub connected — no-op (C# events already handle updates)
                return true;
            }

            var connected = await EnsureHubConnectedAsync();
            if (!connected)
            {
                Logger.LogWarning("Unable to join cycle {CycleId} because the hub connection is unavailable.", ActiveCycleId);
                // hub unavailable — C# events (MarketUpdateService) handle real-time updates
                return false;
            }

            try
            {
                Logger.LogInformation("Joining market cycle {CycleId} on hub.", ActiveCycleId);
                var joined = await Hub.JoinCycle(ActiveCycleId, _lifetimeCts.Token);
                if (joined)
                {
                    Logger.LogInformation("Successfully joined market cycle {CycleId} on hub.", ActiveCycleId);
                    _currentJoinedCycleId = ActiveCycleId;
                    // hub connected — no-op (C# events already handle updates)
                    return true;
                }

                Logger.LogWarning("Hub returned false when joining cycle {CycleId}.", ActiveCycleId);
                // hub unavailable — C# events (MarketUpdateService) handle real-time updates
                return false;
            }
            catch (OperationCanceledException)
            {
                Logger.LogDebug("Join operation canceled for cycle {CycleId}.", ActiveCycleId);
                return false;
            }
            catch (ObjectDisposedException)
            {
                Logger.LogDebug("Join operation aborted because the hub client was disposed.");
                return false;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to join market cycle {CycleId} on hub.", ActiveCycleId);
                // hub unavailable — C# events (MarketUpdateService) handle real-time updates
                return false;
            }
        }
        finally
        {
            if (acquired)
            {
                _joinSemaphore.Release();
            }
        }
    }

    private void StateHasChangedSafe()
    {
        if (_lifetimeCts is null || _lifetimeCts.IsCancellationRequested)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (_lifetimeCts is null || _lifetimeCts.IsCancellationRequested)
            {
                return Task.CompletedTask;
            }

            StateHasChanged();
            return Task.CompletedTask;
        });
    }

    private async Task<bool> EnsureHubConnectedAsync()
    {
        if (_lifetimeCts is null || _lifetimeCts.IsCancellationRequested)
        {
            return false;
        }

        if (Hub.IsConnected)
        {
            if (!_hubConnected)
            {
                Logger.LogInformation("Market hub already connected (state: {State}).", Hub.State);
            }

            _hubConnected = true;
            AttachHubHandlers();
            return true;
        }

        _hubConnected = false;

        for (var attempt = 0; attempt < HubReconnectDelays.Length; attempt++)
        {
            var delay = HubReconnectDelays[attempt];
            if (delay > TimeSpan.Zero)
            {
                try
                {
                    await Task.Delay(delay, _lifetimeCts.Token);
                }
                catch (OperationCanceledException)
                {
                    _hubConnected = false;
                    return false;
                }
            }

            try
            {
                Logger.LogInformation("Attempting to connect to market hub (attempt {Attempt}).", attempt + 1);
                await Hub.ConnectAsync(_lifetimeCts.Token);

                if (Hub.IsConnected)
                {
                    _hubConnected = true;
                    AttachHubHandlers();
                    Logger.LogInformation("Connected to market hub on attempt {Attempt}.", attempt + 1);
                    return true;
                }

                Logger.LogWarning("Market hub connection attempt {Attempt} completed with state {State}.", attempt + 1, Hub.State);
                _hubConnected = false;
            }
            catch (OperationCanceledException)
            {
                Logger.LogDebug("Market hub connection attempt canceled.");
                _hubConnected = false;
                return false;
            }
            catch (ObjectDisposedException)
            {
                Logger.LogDebug("Market hub connection aborted because the client was disposed.");
                _hubConnected = false;
                return false;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to connect to market hub on attempt {Attempt}.", attempt + 1);
            }
        }

        _hubConnected = false;
        Logger.LogWarning("Unable to establish market hub connection after {Attempts} attempts.", HubReconnectDelays.Length);
        return false;
    }

    private void AttachHubHandlers()
    {
        if (_hubHandlersAttached)
        {
            return;
        }

        _bidUpdatedHandler ??= HandleRealtimeUpdateAsync;
        _itemBoughtHandler ??= HandleRealtimeUpdateAsync;
        _itemClosedHandler ??= HandleRealtimeUpdateAsync;

        if (_bidUpdatedHandler is not null)
        {
            Hub.OnBidUpdated += _bidUpdatedHandler;
        }

        if (_itemBoughtHandler is not null)
        {
            Hub.OnItemBought += _itemBoughtHandler;
        }

        if (_itemClosedHandler is not null)
        {
            Hub.OnItemClosed += _itemClosedHandler;
        }

        _hubHandlersAttached = true;
    }

    private string GetResultsSummary()
    {
        if (PageData is null)
        {
            return string.Empty;
        }

        var total = PageData.Total;
        var suffix = total == 1 ? "item encontrado" : "itens encontrados";
        return $"{total} {suffix}";
    }

    private async Task SetTabAsync(MarketTab tab)
    {
        if (_activeTab == tab)
        {
            if (tab == MarketTab.History)
            {
                await EnsureHistoryInitializedAsync();
                await RefreshHistoryAsync();
            }

            return;
        }

        _activeTab = tab;
        StateHasChangedSafe();

        if (tab == MarketTab.History)
        {
            await EnsureHistoryInitializedAsync();
            await RefreshHistoryAsync();
        }
    }

    private void ResetHistoryState()
    {
        _historyInitialized = false;
        _historyLoading = false;
        _historyLoadingMore = false;
        _historyHasMore = false;
        _historyError = null;
        _historyEvents.Clear();
        _historyIds.Clear();
        _historyLatestUtc = null;
        _historyNextPage = 1;

        _historyRequestCts?.Cancel();
        _historyRequestCts?.Dispose();
        _historyRequestCts = null;

        _historyLifecycleCts?.Cancel();
        _historyLifecycleCts?.Dispose();
        _historyLifecycleCts = null;

        _historyTimer?.Dispose(); 
        _historyTimer = null;

        _historyPollingTask = null;
    }

    private CancellationToken PrepareHistoryRequestCts()
    {
        _historyRequestCts?.Cancel();
        _historyRequestCts?.Dispose();
        _historyRequestCts = CancellationTokenSource.CreateLinkedTokenSource(
            _historyLifecycleCts?.Token ?? _lifetimeCts?.Token ?? CancellationToken.None);
        return _historyRequestCts.Token;
    }

    private MarketHistoryQueryOptions BuildHistoryQuery(int page, DateTime? fromUtc = null)
    {
        return new MarketHistoryQueryOptions
        {
            CycleId = ActiveCycleId == Guid.Empty ? null : ActiveCycleId,
            Page = page,
            PageSize = HistoryPageSize,
            FromUtc = fromUtc
        };
    }

    private DateTime? GetHistoryCursorUtc()
    {
        if (!_historyLatestUtc.HasValue)
            return null;

        var latest = _historyLatestUtc.Value;
        return latest == DateTime.MaxValue ? latest : latest.AddTicks(1);
    }

    private async Task EnsureHistoryInitializedAsync()
    {
        if (_historyInitialized)
            return;

        _historyLifecycleCts?.Cancel();
        _historyLifecycleCts?.Dispose();
        _historyLifecycleCts = CancellationTokenSource.CreateLinkedTokenSource(
            _lifetimeCts?.Token ?? CancellationToken.None);

        var ct = PrepareHistoryRequestCts();
        var release = false;

        try
        {
            await _historySemaphore.WaitAsync(ct);
            release = true;
            _historyLoading = true;
            _historyError = null;
            await InvokeAsync(StateHasChanged);

            var result = await Client.GetHistoryAsync(BuildHistoryQuery(1), ct);

            _historyEvents.Clear();
            _historyIds.Clear();
            foreach (var item in result.Items)
            {
                _historyEvents.Add(item);
                _historyIds.Add(item.TransactionId);
            }

            _historyLatestUtc = result.Items.Count > 0
                ? result.Items.Max(i => i.OccurredAtUtc)
                : (DateTime?)null;

            var totalPages = result.PageSize > 0
                ? (int)Math.Ceiling(result.Total / (double)result.PageSize)
                : 1;
            _historyHasMore = totalPages > 1;
            _historyNextPage = _historyHasMore ? 2 : 1;
            _historyInitialized = true;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao carregar histórico de lances");
            _historyError = "Não foi possível carregar o histórico de lances. Tente novamente.";
        }
        finally
        {
            if (release)
                _historySemaphore.Release();

            _historyLoading = false;
            await InvokeAsync(StateHasChanged);
        }

        if (_historyLifecycleCts is not null && _historyInitialized)
            StartHistoryPolling();
    }

    private async Task RefreshHistoryAsync()
    {
        if (!_historyInitialized || _historyLifecycleCts is null)
            return;

        var fromUtc = GetHistoryCursorUtc();
        if (!fromUtc.HasValue)
            return;

        var ct = PrepareHistoryRequestCts();
        var release = false;

        try
        {
            await _historySemaphore.WaitAsync(ct);
            release = true;

            var result = await Client.GetHistoryAsync(BuildHistoryQuery(1, fromUtc), ct);
            var newItems = result.Items
                .Where(item => !_historyIds.Contains(item.TransactionId))
                .OrderBy(item => item.OccurredAtUtc)
                .ToList();

            if (newItems.Count == 0)
                return;

            foreach (var item in newItems)
            {
                _historyEvents.Insert(0, item);
                _historyIds.Add(item.TransactionId);
            }

            var latest = newItems.Max(i => i.OccurredAtUtc);
            if (!_historyLatestUtc.HasValue || latest > _historyLatestUtc)
                _historyLatestUtc = latest;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao atualizar histórico após evento");
        }
        finally
        {
            if (release)
                _historySemaphore.Release();

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadHistoryUpdatesAsync(CancellationToken ct)
    {
        if (!_historyInitialized)
            return;

        var fromUtc = GetHistoryCursorUtc();
        if (!fromUtc.HasValue)
            return;

        var release = false;
        try
        {
            await _historySemaphore.WaitAsync(ct);
            release = true;

            var result = await Client.GetHistoryAsync(BuildHistoryQuery(1, fromUtc), ct);
            var newItems = result.Items
                .Where(item => !_historyIds.Contains(item.TransactionId))
                .OrderBy(item => item.OccurredAtUtc)
                .ToList();

            if (newItems.Count == 0)
                return;

            foreach (var item in newItems)
            {
                _historyEvents.Insert(0, item);
                _historyIds.Add(item.TransactionId);
            }

            var latest = newItems.Max(i => i.OccurredAtUtc);
            if (!_historyLatestUtc.HasValue || latest > _historyLatestUtc)
                _historyLatestUtc = latest;

            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao atualizar histórico via polling");
        }
        finally
        {
            if (release)
                _historySemaphore.Release();
        }
    }

    private async Task LoadMoreHistoryAsync()
    {
        if (!_historyInitialized || (!_historyHasMore && !_historyLoadingMore))
        {
            return;
        }

        var ct = PrepareHistoryRequestCts();
        var release = false;

        try
        {
            await _historySemaphore.WaitAsync(ct);
            release = true;

            if (!_historyHasMore)
                return;

            _historyLoadingMore = true;
            _historyError = null;
            await InvokeAsync(StateHasChanged);

            var result = await Client.GetHistoryAsync(BuildHistoryQuery(_historyNextPage), ct);
            foreach (var item in result.Items)
                if (_historyIds.Add(item.TransactionId))
                    _historyEvents.Add(item);

            var totalPages = result.PageSize > 0
                ? (int)Math.Ceiling(result.Total / (double)result.PageSize)
                : _historyNextPage;
            _historyNextPage++;
            _historyHasMore = _historyNextPage <= totalPages;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao carregar eventos anteriores do histórico");
            _historyError = "Não foi possível carregar eventos anteriores.";
        }
        finally
        {
            if (release)
                _historySemaphore.Release();

            _historyLoadingMore = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StartHistoryPolling()
    {
        if (_historyLifecycleCts is null)
            return;

        var old = Interlocked.Exchange(ref _historyTimer, null);
        old?.Dispose();

        var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        _historyTimer = timer;

        var token = _historyLifecycleCts.Token;

        _historyPollingTask = Task.Run(() => PollAsync(timer, token), token);
    }

    private async Task PollAsync(PeriodicTimer timer, CancellationToken ct)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
                await LoadHistoryUpdatesAsync(ct);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha no polling do histórico de lances.");
        }
        finally
        {
            timer.Dispose();
        }
    }

    private static string FormatHistoryTimestamp(DateTime utc)
        => BrazilTime.FormatDateTimeLocal(utc);

    private async Task OpenTeamTokenModal()
    {
        _teamTokenError = null;

        try
        {
            var token = await TeamAccess.GetTokenAsync();
            _teamTokenInput = token ?? string.Empty;
            _teamTokenConfigured = !string.IsNullOrWhiteSpace(token);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao carregar token do time.");
            _teamTokenInput = string.Empty;
            _teamTokenError = "Não foi possível carregar o token atual.";
        }

        _teamTokenModalOpen = true;
        RefreshLayoutHeader();
        StateHasChangedSafe();
    }

    private void CloseTeamTokenModal()
    {
        _teamTokenModalOpen = false;
        _teamTokenError = null;
    }

    private async Task SaveTeamTokenAsync()
    {
        try
        {
            var trimmed = _teamTokenInput.Trim();
            await TeamAccess.SetTokenAsync(trimmed);
            _teamTokenInput = trimmed;
            _teamTokenConfigured = !string.IsNullOrWhiteSpace(trimmed);
            _teamTokenModalOpen = false;
            _teamTokenError = null;
            RefreshLayoutHeader();
            StateHasChangedSafe();
        }
        catch (ArgumentException ex)
        {
            _teamTokenError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao salvar token do time.");
            _teamTokenError = "Não foi possível salvar o token. Tente novamente.";
        }
    }

    private async Task ClearTeamTokenAsync()
    {
        try
        {
            await TeamAccess.ClearTokenAsync();
            _teamTokenConfigured = false;
            _teamTokenModalOpen = false;
            _teamTokenInput = string.Empty;
            _teamTokenError = null;
            _currentTeamId = null;
            RefreshLayoutHeader();
            StateHasChangedSafe();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao remover token do time.");
            _teamTokenError = "Não foi possível remover o token. Tente novamente.";
        }
    }

    private async Task HandleTeamTokenMissingAsync()
    {
        try
        {
            var token = await TeamAccess.GetTokenAsync();
            _teamTokenInput = token ?? string.Empty;
            _teamTokenConfigured = !string.IsNullOrWhiteSpace(token);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao carregar token do time.");
            _teamTokenInput = string.Empty;
        }

        var invalidMessage = TeamAccess.ConsumeInvalidTokenMessage();
        _teamTokenError = string.IsNullOrWhiteSpace(invalidMessage)
            ? "Informe o token do seu time para registrar lances."
            : invalidMessage;
        _teamTokenModalOpen = true;
        RefreshLayoutHeader();
        StateHasChangedSafe();
    }

    private async Task LoadTeamTokenStatusAsync()
    {
        string? token;
        try
        {
            token = await TeamAccess.GetTokenAsync();
        }
        catch (InvalidOperationException)
        {
            return;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao carregar token do time.");
            _teamTokenConfigured = false;
            _currentTeamId = null;
            StateHasChangedSafe();
            return;
        }

        _teamTokenInput = token ?? string.Empty;
        _teamTokenConfigured = !string.IsNullOrWhiteSpace(token);

        if (_teamTokenConfigured && token is not null)
        {
            await LoadCurrentTeamIdentityAsync(token);
        }
        else
        {
            _currentTeamId = null;
        }

        RefreshLayoutHeader();
        StateHasChangedSafe();
    }

    private async Task LoadCurrentTeamIdentityAsync(string token)
    {
        try
        {
            var identity = await Client.GetMyTeamAsync(token, _lifetimeCts?.Token ?? CancellationToken.None);
            _currentTeamId = identity?.TeamId;
        }
        catch (OperationCanceledException)
        {
        }
        catch (MarketClientException ex)
        {
            Logger.LogWarning(ex, "Falha ao carregar identidade do time.");
            _currentTeamId = null;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Falha HTTP ao carregar identidade do time.");
            _currentTeamId = null;
        }
    }

    private void OnTeamTokenChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadTeamTokenStatusAsync();
        });
    }

    public async ValueTask DisposeAsync()
    {
        TeamAccess.TokenChanged -= OnTeamTokenChanged;
        MarketUpdates.OnBidUpdated -= HandleMarketUpdateEvent;
        MarketUpdates.OnItemBought -= HandleMarketUpdateEvent;
        MarketUpdates.OnItemClosed -= HandleMarketUpdateEvent;

        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;

        _historyRequestCts?.Cancel();
        _historyRequestCts?.Dispose();
        _historyRequestCts = null;

        _historyLifecycleCts?.Cancel();
        _historyLifecycleCts?.Dispose();
        _historyLifecycleCts = null;

        _historyTimer?.Dispose();
        _historyTimer = null;

        if (_historyPollingTask is not null)
        {
            try
            {
                await _historyPollingTask;
            }
            catch (OperationCanceledException)
            {
            }

            _historyPollingTask = null;
        }

        if (_pendingReloadTask is not null)
        {
            try
            {
                await _pendingReloadTask;
            }
            catch (OperationCanceledException)
            {
            }
            catch (ObjectDisposedException)
            {
            }

            _pendingReloadTask = null;
        }

        if (_bidUpdatedHandler is not null)
            Hub.OnBidUpdated -= _bidUpdatedHandler;

        if (_itemBoughtHandler is not null)
            Hub.OnItemBought -= _itemBoughtHandler;

        if (_itemClosedHandler is not null)
            Hub.OnItemClosed -= _itemClosedHandler;

        _hubHandlersAttached = false;

        if (_lifetimeCts is not null)
        {
            _lifetimeCts.Cancel();
            _lifetimeCts.Dispose();
            _lifetimeCts = null;
        }

        _historySemaphore.Dispose();
        _joinSemaphore.Dispose();

        await Hub.DisposeAsync();
    }

}
