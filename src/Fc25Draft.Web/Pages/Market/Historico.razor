@page "/mercado/historico"
@page "/market/historico"
@using Fc25Draft.Core.Enums
@using Fc25Draft.Web.Components.Market
@using Fc25Draft.Web.Models.Market
@using Fc25Draft.Web.Utilities
@using System.Runtime.InteropServices
@using Microsoft.AspNetCore.Authorization
@inject MarketClient MarketClient
@inject NavigationManager Navigation
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService
@inject ILogger<Fc25Draft.Web.Pages.Market.Historico> Logger
@inject EscudoService Escudos

@attribute [Authorize(Roles = "Admin")]
@implements IDisposable

<PageTitle>Histórico do Mercado</PageTitle>

<PageHeader Title="Histórico do Mercado"
            Subtitle="Visualize os eventos registrados no mercado e acompanhe o movimento dos lances."
            Actions="@HistoryHeaderActions" />

<MarketHistoryFilters Model="_query" OnApply="LoadAsync" IsLoading="_isLoading" />

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger mt-3" role="alert">@_errorMessage</div>
}
else if (_isLoading && _page is null)
{
    <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
}
else if (_page is null)
{
    <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
}
else if (_page.Items.Count == 0)
{
    <div class="painel p-3 mt-3 small text-body-secondary">Nenhum evento encontrado com os filtros selecionados.</div>
}
else
{
    <div class="table-responsive painel mt-3">
        <table class="table table-hover align-middle mb-0 lances-tabela">
            <thead>
                <tr>
                    <th scope="col">Data</th>
                    <th scope="col">Evento</th>
                    <th scope="col">Jogador</th>
                    <th scope="col">Origem</th>
                    <th scope="col">Destino</th>
                    <th scope="col" class="text-end">Valor</th>
                    <th scope="col">Observações</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in _page.Items)
            {
                <tr>
                    <td class="text-nowrap numero text-body-secondary">@FormatTimestamp(item.OccurredAtUtc)</td>
                    <td>
                        <div class="fw-medium">@item.TypeName</div>
                        <div class="text-body-tertiary small">@BuildEventSummary(item)</div>
                    </td>
                    <td>
                        <div class="d-flex align-items-center">
                            <FotoJogador PlayerId="@item.PlayerId" Tamanho="32" Classe="me-2 lances-foto" />
                            <div>
                                <div class="fw-medium text-body-emphasis">@item.PlayerName</div>
                                <div class="text-body-tertiary small">@item.PositionName</div>
                            </div>
                        </div>
                    </td>
                    <td class="text-nowrap">@Time(item.TeamName, "Mercado")</td>
                    <td class="text-nowrap">@Time(item.TargetTeamName, null)</td>
                    <td class="text-nowrap text-end numero fw-medium text-body-emphasis">@FormatAmount(item.Amount)</td>
                    <td class="small text-body-secondary">@FormatObservation(item)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (_isLoading && _page is not null)
{
    <div class="small text-body-tertiary mt-2" role="status"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Atualizando...</div>
}

@if (TotalPages > 1 && _page is not null)
{
    <nav class="mt-4" aria-label="Paginação do histórico do mercado">
        <ul class="pagination pagination-sm flex-wrap justify-content-center">
            <li class="page-item @(_query.Page == 1 ? "disabled" : null)">
                <button type="button" class="page-link" @onclick="async () => await GoToPageAsync(_query.Page - 1)" disabled="@(_query.Page == 1)" title="Anterior"><Icone Nome="chevron-left" Tamanho="14" /></button>
            </li>
            @foreach (var page in VisiblePages)
            {
                <li class="page-item @(page == _query.Page ? "active" : null)">
                    <button type="button" class="page-link" @onclick="async () => await GoToPageAsync(page)">@(page)</button>
                </li>
            }
            <li class="page-item @(_query.Page >= TotalPages ? "disabled" : null)">
                <button type="button" class="page-link" @onclick="async () => await GoToPageAsync(_query.Page + 1)" disabled="@(_query.Page >= TotalPages)" title="Próxima"><Icone Nome="chevron-right" Tamanho="14" /></button>
            </li>
        </ul>
    </nav>
}

@code {
    private readonly MarketHistoryQueryOptions _query = new() { Page = 1, PageSize = 25 };
    private PagedResult<MarketTransactionDto>? _page;
    private bool _isLoading;
    private string? _errorMessage;
    private CancellationTokenSource? _loadCts;

    private RenderFragment HistoryHeaderActions => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "d-flex flex-wrap gap-2");

        builder.OpenElement(seq++, "a");
        builder.AddAttribute(seq++, "class", "btn btn-outline-secondary btn-sm");
        builder.AddAttribute(seq++, "href", ExportUrl);
        builder.AddAttribute(seq++, "target", "_blank");
        builder.AddAttribute(seq++, "rel", "noopener noreferrer");
        builder.AddContent(seq++, "Exportar CSV");
        builder.CloseElement();

        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", "btn btn-outline-primary btn-sm");
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, ReloadAsync));
        builder.AddAttribute(seq++, "disabled", _isLoading);
        builder.AddContent(seq++, "Recarregar");
        builder.CloseElement();

        builder.CloseElement();
    };

    private string ExportUrl => Navigation.ToAbsoluteUri(MarketClient.GetHistoryExportUrl(_query)).ToString();

    protected override void OnInitialized()
    {
        LayoutState.SetPage(
            NavigationService.GetPageDefinition("/mercado/historico"),
            subtitle: "Visualize os eventos registrados no mercado e acompanhe o movimento dos lances.",
            actions: HistoryHeaderActions);
    }

    private int TotalPages
        => _page is null || _page.PageSize <= 0
            ? 1
            : Math.Max(1, (int)Math.Ceiling(_page.Total / (double)_page.PageSize));

    private IEnumerable<int> VisiblePages
    {
        get
        {
            var current = _query.Page;
            var start = Math.Max(1, current - 2);
            var end = Math.Min(TotalPages, current + 2);
            for (var page = start; page <= end; page++)
            {
                yield return page;
            }
        }
    }

    protected override Task OnInitializedAsync()
        => LoadAsync();

    private async Task LoadAsync()
        => await LoadAsync(_query.Page);

    private async Task LoadAsync(int page)
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();

        _query.Page = page < 1 ? 1 : page;
        _isLoading = true;
        _errorMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await MarketClient.GetHistoryAsync(_query, _loadCts.Token);
            _page = result;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _errorMessage = "Não foi possível carregar o histórico do mercado. Tente novamente em instantes.";
            Logger.LogError(ex, "LayoutNav:Error ao carregar histórico do mercado {@Query}", _query);
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task ReloadAsync()
        => LoadAsync(_query.Page);

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || page == _query.Page)
        {
            return;
        }

        await LoadAsync(page);
    }

    private static string FormatTimestamp(DateTime utc)
        => BrazilTime.FormatDateTimeLocal(utc);

    /// <summary>Time com o escudo; sem time fica o texto de reserva ("Mercado") ou o traço.</summary>
    private RenderFragment Time(string? nome, string? reserva) => __builder =>
    {
        if (string.IsNullOrWhiteSpace(nome))
        {
            <span class="text-body-tertiary">@(reserva ?? "—")</span>
            return;
        }
        <span class="d-inline-flex align-items-center gap-2">
            <img src="@Escudos.GetEscudo(nome)" alt="" width="18" height="18" style="object-fit: contain;" />@nome
        </span>
    };

    private static string FormatTeam(string? teamName, string fallback = "-")
        => string.IsNullOrWhiteSpace(teamName) ? fallback : teamName;

    private static string FormatAmount(decimal? amount)
        => amount.HasValue ? string.Format(BrazilTime.Culture, "{0:C}", amount.Value) : "-";

    private static string FormatObservation(MarketTransactionDto entry)
    {
        var text = MarketHistoryTextFormatter.FormatObservation(entry);
        return string.IsNullOrWhiteSpace(text) ? "-" : text;
    }

    private static string BuildEventSummary(MarketTransactionDto item)
        => MarketHistoryTextFormatter.FormatDescription(item);

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }
}
