@page "/market/historico"
@using Fc25Draft.Web.Components.Market
@using Fc25Draft.Web.Models.Market
@using Fc25Draft.Web.Utilities
@inject MarketClient MarketClient
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Histórico do Mercado</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">Histórico do Mercado</h1>
        <p class="text-muted small mb-0">Visualize os eventos registrados no mercado e acompanhe o movimento dos lances.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary btn-sm"
           href="@ExportUrl"
           target="_blank"
           rel="noopener noreferrer">Exportar CSV</a>
        <button type="button"
                class="btn btn-outline-primary btn-sm"
                @onclick="ReloadAsync"
                disabled="@_isLoading">Recarregar</button>
    </div>
</div>

<MarketHistoryFilters Model="_query" OnApply="LoadAsync" IsLoading="_isLoading" />

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger mt-3" role="alert">@_errorMessage</div>
}
else if (_isLoading && _page is null)
{
    <div class="alert alert-info mt-3" role="status">Carregando histórico...</div>
}
else if (_page is null)
{
    <div class="alert alert-info mt-3" role="status">Carregando histórico...</div>
}
else if (_page.Items.Count == 0)
{
    <div class="alert alert-warning mt-3" role="status">Nenhum evento encontrado com os filtros selecionados.</div>
}
else
{
    <div class="table-responsive mt-3">
        <table class="table table-sm table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Data/Hora (UTC)</th>
                    <th scope="col">Evento</th>
                    <th scope="col">Jogador</th>
                    <th scope="col">Time Origem</th>
                    <th scope="col">Time Destino</th>
                    <th scope="col">Valor</th>
                    <th scope="col">Observações</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in _page.Items)
            {
                <tr>
                    <td class="text-nowrap">@FormatTimestamp(item.OccurredAtUtc)</td>
                    <td>
                        <div class="fw-semibold">@item.TypeName</div>
                        <div class="text-muted small">@BuildEventSummary(item)</div>
                    </td>
                    <td>
                        <div class="fw-semibold">@item.PlayerName</div>
                        <div class="text-muted small">@item.PositionName</div>
                    </td>
                    <td>@FormatTeam(item.TeamName, fallback:"Mercado")</td>
                    <td>@FormatTeam(item.TargetTeamName)</td>
                    <td>@FormatAmount(item.Amount)</td>
                    <td>@FormatNotes(item.Notes)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (_isLoading && _page is not null)
{
    <div class="alert alert-info mt-3" role="status">Recarregando histórico...</div>
}

@if (TotalPages > 1 && _page is not null)
{
    <nav class="mt-4" aria-label="Paginação do histórico do mercado">
        <ul class="pagination pagination-sm flex-wrap">
            <li class="page-item @(_query.Page == 1 ? "disabled" : null)">
                <button type="button" class="page-link" @onclick="async () => await GoToPageAsync(_query.Page - 1)" disabled="@(_query.Page == 1)">Anterior</button>
            </li>
            @foreach (var page in VisiblePages)
            {
                <li class="page-item @(page == _query.Page ? "active" : null)">
                    <button type="button" class="page-link" @onclick="async () => await GoToPageAsync(page)">@(page)</button>
                </li>
            }
            <li class="page-item @(_query.Page >= TotalPages ? "disabled" : null)">
                <button type="button" class="page-link" @onclick="async () => await GoToPageAsync(_query.Page + 1)" disabled="@(_query.Page >= TotalPages)">Próxima</button>
            </li>
        </ul>
    </nav>
}

@code {
    private readonly MarketHistoryQueryOptions _query = new() { Page = 1, PageSize = 25 };
    private PagedResult<MarketTransactionDto>? _page;
    private bool _isLoading;
    private string? _errorMessage;
    private CancellationTokenSource? _loadCts;

    private string ExportUrl => Navigation.ToAbsoluteUri(MarketClient.GetHistoryExportUrl(_query)).ToString();

    private int TotalPages
        => _page is null || _page.PageSize <= 0
            ? 1
            : Math.Max(1, (int)Math.Ceiling(_page.Total / (double)_page.PageSize));

    private IEnumerable<int> VisiblePages
    {
        get
        {
            var current = _query.Page;
            var start = Math.Max(1, current - 2);
            var end = Math.Min(TotalPages, current + 2);
            for (var page = start; page <= end; page++)
            {
                yield return page;
            }
        }
    }

    protected override Task OnInitializedAsync()
        => LoadAsync();

    private async Task LoadAsync()
        => await LoadAsync(_query.Page);

    private async Task LoadAsync(int page)
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();

        _query.Page = page < 1 ? 1 : page;
        _isLoading = true;
        _errorMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await MarketClient.GetHistoryAsync(_query, _loadCts.Token);
            _page = result;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _errorMessage = "Não foi possível carregar o histórico do mercado. Tente novamente em instantes.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task ReloadAsync()
        => LoadAsync(_query.Page);

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || page == _query.Page)
        {
            return;
        }

        await LoadAsync(page);
    }

    private static string FormatTimestamp(DateTime utc)
        => BrazilTime.FormatDateTimeWithZone(utc);

    private static string FormatTeam(string? teamName, string fallback = "-")
        => string.IsNullOrWhiteSpace(teamName) ? fallback : teamName;

    private static string FormatAmount(decimal? amount)
        => amount.HasValue ? string.Format(BrazilTime.Culture, "{0:C}", amount.Value) : "-";

    private static string FormatNotes(string? notes)
        => string.IsNullOrWhiteSpace(notes) ? "-" : notes!;

    private static string BuildEventSummary(MarketTransactionDto item)
    {
        var origin = FormatTeam(item.TeamName, "Mercado");
        var destination = FormatTeam(item.TargetTeamName);
        var amountText = item.Amount.HasValue
            ? string.Format(BrazilTime.Culture, "{0:C}", item.Amount.Value)
            : null;

        return item.Type switch
        {
            MarketTransactionType.BidPlaced when amountText is not null
                => $"Lance registrado por {origin}: {amountText}",
            MarketTransactionType.Outbid when amountText is not null
                => $"{origin} superou {destination} ({amountText})",
            MarketTransactionType.BuyNow when amountText is not null
                => $"Compra imediata por {origin} ({amountText})",
            _ when !string.IsNullOrWhiteSpace(destination)
                => $"{origin} → {destination}",
            _ => origin
        };
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }
}
