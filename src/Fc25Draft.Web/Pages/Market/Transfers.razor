@page "/market/transfers"
@using System.Threading
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Web.Models.Transfers
@using Fc25Draft.Web.Utilities
@using Microsoft.AspNetCore.Components.Forms
@inject TransfersClient TransfersClient
@inject TeamsApiClient TeamsApiClient
@inject ToastService Toasts
@implements IDisposable

<PageTitle>Histórico de Transferências</PageTitle>

<h1 class="h3 mb-3">Histórico de Transferências</h1>

<EditForm EditContext="_editContext" OnValidSubmit="HandleApplyAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-3">
            <label class="form-label" for="filter-team">Time</label>
            <InputSelect id="filter-team" class="form-select" @bind-Value="_selectedTeamId">
                <option value="">Todos os times</option>
                @foreach (var team in _teamOptions)
                {
                    <option value="@team.TeamId">@team.TeamName</option>
                }
            </InputSelect>
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label" for="filter-player">Jogador (GUID)</label>
            <InputText id="filter-player" class="form-control" @bind-Value="_playerIdText" placeholder="Cole o identificador do jogador" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label" for="filter-from">Período - início</label>
            <InputDate id="filter-from" class="form-control" @bind-Value="Model.PeriodStartLocal" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label" for="filter-to">Período - fim</label>
            <InputDate id="filter-to" class="form-control" @bind-Value="Model.PeriodEndLocal" />
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label" for="filter-notes">Observações</label>
            <InputText id="filter-notes" class="form-control" @bind-Value="Model.NotesQuery" placeholder="Palavras-chave nas observações" />
        </div>
        <div class="col-12 col-md-6 d-flex gap-2 flex-wrap justify-content-end">
            <button type="submit" class="btn btn-primary" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                <span>Aplicar</span>
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ClearFilters" disabled="@_isLoading">Limpar</button>
        </div>
    </div>
</EditForm>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger mt-3" role="alert">@_errorMessage</div>
}
else if (_isLoading && _page is null)
{
    <div class="alert alert-info mt-3" role="status">Carregando histórico de transferências...</div>
}
else if (_page is null)
{
    <div class="alert alert-info mt-3" role="status">Carregando histórico de transferências...</div>
}
else if (_page.Items.Count == 0)
{
    <div class="alert alert-warning mt-3" role="status">Sem resultados para os filtros selecionados.</div>
}
else
{
    <div class="table-responsive mt-3">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr>
                    <th scope="col">Data/Hora</th>
                    <th scope="col">Jogador</th>
                    <th scope="col">Saiu do time</th>
                    <th scope="col">Foi para o time</th>
                    <th scope="col">Valor</th>
                    <th scope="col">Observações</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in _page.Items)
            {
                <tr>
                    <td class="text-nowrap">@BrazilTime.FormatDateTime(item.OccurredAtUtc)</td>
                    <td class="fw-semibold">@item.PlayerName</td>
                    <td>@FormatTeam(item.FromTeamName)</td>
                    <td>@FormatTeam(item.ToTeamName)</td>
                    <td class="text-nowrap">@FormatAmount(item.Amount)</td>
                    <td class="text-truncate" style="max-width: 240px;" title="@item.Notes">@FormatNotes(item.Notes)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (_isLoading && _page is not null)
{
    <div class="alert alert-info mt-3" role="status">Atualizando dados...</div>
}

@if (_page is not null && TotalPages > 1)
{
    <nav class="mt-3" aria-label="Paginação do histórico de transferências">
        <ul class="pagination pagination-sm flex-wrap">
            <li class="page-item @(_currentPage <= 1 ? "disabled" : null)">
                <button class="page-link" type="button" @onclick="async () => await GoToPageAsync(_currentPage - 1)" disabled="@(_currentPage <= 1)">Anterior</button>
            </li>
            @foreach (var page in VisiblePages)
            {
                <li class="page-item @(page == _currentPage ? "active" : null)">
                    <button class="page-link" type="button" @onclick="async () => await GoToPageAsync(page)">@(page)</button>
                </li>
            }
            <li class="page-item @(_currentPage >= TotalPages ? "disabled" : null)">
                <button class="page-link" type="button" @onclick="async () => await GoToPageAsync(_currentPage + 1)" disabled="@(_currentPage >= TotalPages)">Próxima</button>
            </li>
        </ul>
    </nav>
}

@code {
    private readonly TransferHistoryFilterModel Model = new();
    private EditContext? _editContext;
    private PagedResult<TransferListItemDto>? _page;
    private bool _isLoading;
    private string? _errorMessage;
    private CancellationTokenSource? _loadCts;
    private List<TeamListItemDto> _teamOptions = new();
    private string? _selectedTeamId;
    private string? _playerIdText;
    private int _currentPage = 1;

    private int TotalPages => _page is null || _page.PageSize <= 0
        ? 1
        : Math.Max(1, (int)Math.Ceiling(_page.Total / (double)_page.PageSize));

    private IEnumerable<int> VisiblePages
    {
        get
        {
            var start = Math.Max(1, _currentPage - 2);
            var end = Math.Min(TotalPages, _currentPage + 2);
            for (var page = start; page <= end; page++)
            {
                yield return page;
            }
        }
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(Model);
        await LoadTeamsAsync();
        await LoadAsync(Model.Page, CancellationToken.None);
    }

    private async Task LoadTeamsAsync()
    {
        using var cts = new CancellationTokenSource();

        try
        {
            var response = await TeamsApiClient.GetAsync(null, 1, 200, cts.Token);
            _teamOptions = response.Items.ToList();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            _teamOptions = new List<TeamListItemDto>();
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleApplyAsync()
    {
        if (!TryParsePlayerId())
        {
            Toasts.ShowError("Informe um GUID válido para o jogador ou deixe o campo vazio.");
            return;
        }

        if (!TryParseTeamId())
        {
            Toasts.ShowError("Selecione um time válido.");
            return;
        }

        Model.Page = 1;
        await LoadAsync(Model.Page, CancellationToken.None);
    }

    private bool TryParsePlayerId()
    {
        if (string.IsNullOrWhiteSpace(_playerIdText))
        {
            Model.PlayerId = null;
            return true;
        }

        if (Guid.TryParse(_playerIdText, out var guid))
        {
            Model.PlayerId = guid;
            return true;
        }

        return false;
    }

    private bool TryParseTeamId()
    {
        if (string.IsNullOrWhiteSpace(_selectedTeamId))
        {
            Model.TeamId = null;
            return true;
        }

        if (Guid.TryParse(_selectedTeamId, out var teamId))
        {
            Model.TeamId = teamId;
            return true;
        }

        return false;
    }

    private async Task LoadAsync(int page, CancellationToken externalToken)
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = CancellationTokenSource.CreateLinkedTokenSource(externalToken);

        _isLoading = true;
        _errorMessage = null;
        Model.Page = page;
        _currentPage = page;
        await InvokeAsync(StateHasChanged);

        try
        {
            var request = new TransferHistoryQueryRequest
            {
                TeamId = Model.TeamId,
                PlayerId = Model.PlayerId,
                DateFromUtc = Model.PeriodStartUtc,
                DateToUtc = Model.PeriodEndUtc,
                NotesQuery = Model.NotesQuery,
                Page = Model.Page,
                PageSize = Model.PageSize
            };

            _page = await TransfersClient.GetHistoryAsync(request, _loadCts.Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            _errorMessage = "Não foi possível carregar o histórico de transferências. Tente novamente.";
            Toasts.ShowError(_errorMessage);
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || page == _currentPage)
        {
            return;
        }

        await LoadAsync(page, CancellationToken.None);
    }

    private async Task ClearFilters()
    {
        Model.Reset();
        _selectedTeamId = null;
        _playerIdText = null;
        await LoadAsync(1, CancellationToken.None);
    }

    private static string FormatTeam(string? name)
        => string.IsNullOrWhiteSpace(name) ? "-" : name;

    private static string FormatNotes(string? notes)
        => string.IsNullOrWhiteSpace(notes) ? "-" : notes;

    private static string FormatAmount(decimal amount)
        => string.Format(BrazilTime.Culture, "{0:C}", amount);
}
