@page "/market/transfers"
@page "/admin/transferencias/historico"
@using System.Threading
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Web.Models.Transfers
@using Fc25Draft.Web.Utilities
@using Microsoft.AspNetCore.Components.Forms
@inject TransfersClient TransfersClient
@inject ToastService Toasts
@inject TeamsApiClient TeamsApiClient
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService
@inject ILogger<Fc25Draft.Web.Pages.Market.Transfers> Logger
@inject AdminAuthService AdminAuth
@inject MarketCycleClient CycleClient


@implements IDisposable

<PageTitle>Histórico de Transferências</PageTitle>

<PageHeader Title="Histórico de Transferências"
            Subtitle="Filtre e acompanhe transações administrativas entre equipes." />

<EditForm EditContext="_editContext" OnValidSubmit="HandleApplyAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-3">
            <label class="form-label" for="filter-team">Time</label>
            <InputSelect id="filter-team" class="form-select" @bind-Value="_selectedTeamId">
                <option value="">Todos os times</option>
                @foreach (var team in _teamOptions)
                {
                    <option value="@team.TeamId">@team.TeamName</option>
                }
            </InputSelect>
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label" for="filter-player">Jogador (GUID)</label>
            <InputText id="filter-player" class="form-control" @bind-Value="_playerIdText" placeholder="Cole o identificador do jogador" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label" for="filter-from">Período - início</label>
            <InputDate id="filter-from" class="form-control" @bind-Value="Model.PeriodStartLocal" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label" for="filter-to">Período - fim</label>
            <InputDate id="filter-to" class="form-control" @bind-Value="Model.PeriodEndLocal" />
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label" for="filter-notes">Observações</label>
            <InputText id="filter-notes" class="form-control" @bind-Value="Model.NotesQuery" placeholder="Palavras-chave nas observações" />
        </div>
        @if (_isAdmin)
        {
            <div class="col-12 col-md-3">
                <label class="form-label" for="filter-cycle">Ciclo</label>
                <InputSelect id="filter-cycle" class="form-select" @bind-Value="_selectedCycleId" disabled="@(_cycleOptions.Count == 0)">
                    <option value="">Todos os ciclos</option>
                    @foreach (var c in _cycleOptions)
                    {
                        <option value="@c.CycleId">@c.Name</option>
                    }
                </InputSelect>
            </div>
        }
        <div class="col-12 col-sm-auto d-flex align-items-end pb-1">
            <div class="form-check mb-0">
                <InputCheckbox id="filter-only-acquisitions"
                               class="form-check-input"
                               @bind-Value="Model.OnlyAcquisitions" />
                <label class="form-check-label" for="filter-only-acquisitions">Apenas mercado externo</label>
            </div>
        </div>
        <div class="col-12 col-md-6 d-flex gap-2 flex-wrap justify-content-end">
            <button type="submit" class="btn btn-primary" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                <span>Aplicar</span>
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ClearFilters" disabled="@_isLoading">Limpar</button>
        </div>
    </div>
</EditForm>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger mt-3" role="alert">@_errorMessage</div>
}
else if (_isLoading && _page is null)
{
    <div class="alert alert-info mt-3" role="status">Carregando histórico de transferências...</div>
}
else if (_page is null)
{
    <div class="alert alert-info mt-3" role="status">Carregando histórico de transferências...</div>
}
else if (_page.Items.Count == 0)
{
    <div class="alert alert-warning mt-3" role="status">Sem resultados para os filtros selecionados.</div>
}
else
{
    <div class="table-responsive mt-3">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr>
                    <th scope="col">Data/Hora</th>
                    <th scope="col">Jogador</th>
                    <th scope="col">Saiu do time</th>
                    <th scope="col">Foi para o time</th>
                    <th scope="col">Valor</th>
                    <th scope="col" class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in _page.Items)
            {
                <tr>
                    <td class="text-nowrap">@BrazilTime.FormatDateTime(item.OccurredAtUtc)</td>
                    <td class="fw-semibold">@item.PlayerName</td>
                    <td>@FormatTeam(item.FromTeamName)</td>
                    <td>@FormatTeam(item.ToTeamName)</td>
                    <td class="text-nowrap">@FormatAmount(item.Amount)</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="async () => await ShowDetailsAsync(item)" disabled="@_isLoadingDetails">
                            Detalhes
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (_showDetailsModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0, 0, 0, 0.5);" @onclick="CloseDetailsModal">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Detalhes da negociação</h5>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="CloseDetailsModal"></button>
                </div>
                <div class="modal-body">
                    @if (_isLoadingDetails)
                    {
                        <div class="d-flex align-items-center justify-content-center py-4">
                            <div class="spinner-border" role="status" aria-hidden="true"></div>
                            <span class="ms-2">Carregando detalhes...</span>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_detailsErrorMessage))
                    {
                        <div class="alert alert-danger mb-0" role="alert">@_detailsErrorMessage</div>
                    }
                    else if (_selectedTransfer is not null)
                    {
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Data/Hora</dt>
                            <dd class="col-sm-8">@BrazilTime.FormatDateTime(_selectedTransfer.OccurredAtUtc)</dd>

                            <dt class="col-sm-4">Jogador</dt>
                            <dd class="col-sm-8">@_selectedTransfer.PlayerName</dd>

                            <dt class="col-sm-4">Saiu do time</dt>
                            <dd class="col-sm-8">@FormatTeam(_selectedTransfer.FromTeamName)</dd>

                            <dt class="col-sm-4">Foi para o time</dt>
                            <dd class="col-sm-8">@FormatTeam(_selectedTransfer.ToTeamName)</dd>

                            <dt class="col-sm-4">Valor</dt>
                            <dd class="col-sm-8">@FormatAmount(_selectedTransfer.Amount)</dd>

                            <dt class="col-sm-4">Observações</dt>
                            <dd class="col-sm-8">@FormatNotes(_selectedTransfer.Notes)</dd>
                        </dl>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0" role="alert">Detalhes não disponíveis.</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDetailsModal">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_isLoading && _page is not null)
{
    <div class="alert alert-info mt-3" role="status">Atualizando dados...</div>
}

@if (_page is not null && TotalPages > 1)
{
    <nav class="mt-3" aria-label="Paginação do histórico de transferências">
        <ul class="pagination pagination-sm flex-wrap">
            <li class="page-item @(_currentPage <= 1 ? "disabled" : null)">
                <button class="page-link" type="button" @onclick="async () => await GoToPageAsync(_currentPage - 1)" disabled="@(_currentPage <= 1)">Anterior</button>
            </li>
            @foreach (var page in VisiblePages)
            {
                <li class="page-item @(page == _currentPage ? "active" : null)">
                    <button class="page-link" type="button" @onclick="async () => await GoToPageAsync(page)">@(page)</button>
                </li>
            }
            <li class="page-item @(_currentPage >= TotalPages ? "disabled" : null)">
                <button class="page-link" type="button" @onclick="async () => await GoToPageAsync(_currentPage + 1)" disabled="@(_currentPage >= TotalPages)">Próxima</button>
            </li>
        </ul>
    </nav>
}

@code {
    private readonly TransferHistoryFilterModel Model = new();
    private EditContext? _editContext;
    private PagedResult<TransferListItemDto>? _page;
    private bool _isLoading;
    private string? _errorMessage;
    private CancellationTokenSource? _loadCts;
    private List<TeamListItemDto> _teamOptions = new();
    private string? _selectedTeamId;
    private string? _playerIdText;
    private int _currentPage = 1;
    private bool _showDetailsModal;
    private bool _isLoadingDetails;
    private string? _detailsErrorMessage;
    private TransferDetailsDto? _selectedTransfer;
    private CancellationTokenSource? _detailsCts;

    private bool _isAdmin;
    private string? _selectedCycleId;
    private List<MarketCycleDto> _cycleOptions = new();

    private int TotalPages => _page is null || _page.PageSize <= 0
        ? 1
        : Math.Max(1, (int)Math.Ceiling(_page.Total / (double)_page.PageSize));

    private IEnumerable<int> VisiblePages
    {
        get
        {
            var start = Math.Max(1, _currentPage - 2);
            var end = Math.Min(TotalPages, _currentPage + 2);
            for (var page = start; page <= end; page++)
            {
                yield return page;
            }
        }
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _detailsCts?.Cancel();
        _detailsCts?.Dispose();
    }

    protected override void OnInitialized()
    {
        LayoutState.SetPage(
            NavigationService.GetPageDefinition("/admin/transferencias/historico"),
            subtitle: "Filtre transações e consulte detalhes completos.");
    }

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(Model);
        await AdminAuth.EnsureInitializedAsync();
        _isAdmin = AdminAuth.IsAdmin;

        await Task.WhenAll(
            LoadTeamsAsync(),
            _isAdmin ? LoadCyclesAsync() : Task.CompletedTask
        );
        await LoadAsync(Model.Page, CancellationToken.None);
    }

    private async Task LoadTeamsAsync()
    {
        using var cts = new CancellationTokenSource();

        try
        {
            var response = await TeamsApiClient.GetAsync(null, 1, 200, cts.Token);
            _teamOptions = response.Items.ToList();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LayoutNav:Error ao carregar opções de times para histórico de transferências");
            _teamOptions = new List<TeamListItemDto>();
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadCyclesAsync()
    {
        try
        {
            var result = await CycleClient.QueryAsync(new Fc25Draft.Web.Models.MarketCycles.MarketCycleQueryRequest
            {
                Page = 1,
                PageSize = 100
            });
            _cycleOptions = result.Items.OrderByDescending(c => c.StartsAtUtc).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao carregar ciclos para filtro de transferências");
            _cycleOptions = new List<MarketCycleDto>();
        }
    }

    private async Task HandleApplyAsync()
    {
        if (!TryParsePlayerId())
        {
            Toasts.ShowError("Informe um GUID válido para o jogador ou deixe o campo vazio.");
            return;
        }

        if (!TryParseTeamId())
        {
            Toasts.ShowError("Selecione um time válido.");
            return;
        }

        Model.Page = 1;
        await LoadAsync(Model.Page, CancellationToken.None);
    }

    private bool TryParsePlayerId()
    {
        if (string.IsNullOrWhiteSpace(_playerIdText))
        {
            Model.PlayerId = null;
            return true;
        }

        if (Guid.TryParse(_playerIdText, out var guid))
        {
            Model.PlayerId = guid;
            return true;
        }

        return false;
    }

    private bool TryParseTeamId()
    {
        if (string.IsNullOrWhiteSpace(_selectedTeamId))
        {
            Model.TeamId = null;
            return true;
        }

        if (Guid.TryParse(_selectedTeamId, out var teamId))
        {
            Model.TeamId = teamId;
            return true;
        }

        return false;
    }

    private async Task LoadAsync(int page, CancellationToken externalToken)
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = CancellationTokenSource.CreateLinkedTokenSource(externalToken);

        _isLoading = true;
        _errorMessage = null;
        Model.Page = page;
        _currentPage = page;
        await InvokeAsync(StateHasChanged);

        TransferHistoryQueryRequest? request = null;
        try
        {
            DateTime? dateFrom = Model.PeriodStartUtc;
            DateTime? dateTo = Model.PeriodEndUtc;

            if (_isAdmin && Guid.TryParse(_selectedCycleId, out var cycleGuid))
            {
                var cycle = _cycleOptions.FirstOrDefault(c => c.CycleId == cycleGuid);
                if (cycle is not null)
                {
                    dateFrom = cycle.StartsAtUtc;
                    dateTo = cycle.EndsAtUtc;
                }
            }

            request = new TransferHistoryQueryRequest
            {
                TeamId = Model.TeamId,
                PlayerId = Model.PlayerId,
                DateFromUtc = dateFrom,
                DateToUtc = dateTo,
                NotesQuery = Model.NotesQuery,
                OnlyAcquisitions = Model.OnlyAcquisitions,
                Page = Model.Page,
                PageSize = Model.PageSize
            };

            _page = await TransfersClient.GetHistoryAsync(request, _loadCts.Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _errorMessage = "Não foi possível carregar o histórico de transferências. Tente novamente.";
            Toasts.ShowError(_errorMessage);
            Logger.LogError(ex, "LayoutNav:Error ao carregar histórico de transferências {@Request}", request);
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || page == _currentPage)
        {
            return;
        }

        await LoadAsync(page, CancellationToken.None);
    }

    private async Task ClearFilters()
    {
        Model.Reset();
        _selectedTeamId = null;
        _playerIdText = null;
        _selectedCycleId = null;
        await LoadAsync(1, CancellationToken.None);
    }

    private static string FormatTeam(string? name)
        => string.IsNullOrWhiteSpace(name) ? "-" : name;

    private static string FormatNotes(string? notes)
        => string.IsNullOrWhiteSpace(notes) ? "-" : notes;

    private static string FormatAmount(decimal amount)
        => string.Format(BrazilTime.Culture, "{0:C}", amount);

    private async Task ShowDetailsAsync(TransferListItemDto item)
    {
        _detailsCts?.Cancel();
        _detailsCts?.Dispose();
        _detailsCts = new CancellationTokenSource();

        _showDetailsModal = true;
        _isLoadingDetails = true;
        _detailsErrorMessage = null;
        _selectedTransfer = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var details = await TransfersClient.GetByIdAsync(item.TransferId, _detailsCts.Token);
            if (details is null)
            {
                _detailsErrorMessage = "Transferência não encontrada.";
            }
            else
            {
                _selectedTransfer = details;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _detailsErrorMessage = "Não foi possível carregar os detalhes da transferência. Tente novamente.";
            Toasts.ShowError(_detailsErrorMessage);
            Logger.LogError(ex, "LayoutNav:Error ao carregar detalhes da transferência {TransferId}", item.TransferId);
        }
        finally
        {
            if (_detailsCts is null || !_detailsCts.IsCancellationRequested)
            {
                _isLoadingDetails = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void CloseDetailsModal()
    {
        _detailsCts?.Cancel();
        _detailsCts?.Dispose();
        _detailsCts = null;
        _showDetailsModal = false;
        _isLoadingDetails = false;
        _detailsErrorMessage = null;
        _selectedTransfer = null;
    }
}
