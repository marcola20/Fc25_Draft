                                </ul>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6">
                            <div class="card h-100">
                                <div class="card-header fw-bold">🟨 Pendurados <span class="text-muted small fw-normal">· 2 amarelos</span></div>
                                <ul class="list-group list-group-flush">
                                    @foreach (var p in _disciplina.Pendurados)
                                    {
                                        <li class="list-group-item py-1 small">
                                            <span class="fw-semibold">@p.JogadorNome</span> <span class="text-muted">(@p.TimeNome)</span>
                                        </li>
                                    }
                                    @if (_disciplina.Pendurados.Count == 0)
                                    {
                                        <li class="list-group-item text-muted small">Nenhum pendurado.</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }

                @if (!_cartoes.Any())
                {
                    <div class="text-muted">Nenhum cartão registrado.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" style="font-size:0.875rem;">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width:35px;">#</th>
                                    <th>Jogador</th>
                                    <th class="d-none d-md-table-cell">Time</th>
                                    <th class="text-center" style="width:45px;">🟨</th>
                                    <th class="text-center" style="width:45px;">🟥</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int rc = 0; }
                                @foreach (var c in _cartoes)
