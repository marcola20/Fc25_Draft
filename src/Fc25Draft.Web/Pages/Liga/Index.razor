    private IReadOnlyList<ResultadoForma> Forma(Guid timeId)
    {
        if (!ReferenceEquals(_formaDasRodadas, _rodadas))
        {
            _forma = FormaDosTimes.Calcular(_rodadas);
            _formaDasRodadas = _rodadas;
        }
        return _forma.TryGetValue(timeId, out var jogos) ? jogos : Array.Empty<ResultadoForma>();
    }

