            : null;

    protected override void OnInitialized()
    {
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await AdminAuth.EnsureInitializedAsync();
        _authInitialized = true;
        StateHasChanged();
    }

    private void OnAuthenticationChanged()
    {
        if (!_authInitialized) return;
        InvokeAsync(StateHasChanged);
    }

    private bool _salvandoPartida;
    private bool _confirmandoEncerrar;
    private string? _erroPartida;

    private async Task IniciarPartida()
    {
        if (_partidaDetalhes is null) return;
        await AlterarStatusPartida(() => AdminSvc.IniciarPartidaAsync(_partidaDetalhes.PartidaId, CancellationToken.None));
    }

    private async Task EncerrarPartida()
    {
        if (_partidaDetalhes is null) return;
        // Encerrar grava a escalação de cada time e conta +1 jogo para os titulares.
        await AlterarStatusPartida(() => AdminSvc.EncerrarPartidaAsync(_partidaDetalhes.PartidaId, CancellationToken.None));
    }

    private async Task AlterarStatusPartida(Func<Task> acao)
    {
        if (!AdminAuth.IsAdmin) return;
        _salvandoPartida = true; _erroPartida = null;
        try
        {
            await acao();
            _confirmandoEncerrar = false;
            await AtualizarAoVivo();
        }
        catch (Exception ex) { _erroPartida = ex.Message; }
        finally { _salvandoPartida = false; }
    }

    private void EditarStats()
    {
        if (_partidaDetalhes is null) return;
        _showEditor = true;
    }

    private async Task AtualizarAoVivo()
    {
        if (_partidaDetalhes is null) return;

        _eventoPartida = await LigaService.GetEventosPartidaAsync(_partidaDetalhes.PartidaId, CancellationToken.None);
        _escalacoesPartida = await LigaService.GetEscalacoesPartidaAsync(_partidaDetalhes.PartidaId, CancellationToken.None);

        // Gols/cartões podem alterar o placar e a classificação: recarrega mantendo a rodada visível.
        var idxAtual = _rodadaIdx;
        await LoadLigaDataAsync(_ligaId);
        if (idxAtual < _rodadas.Count) _rodadaIdx = idxAtual;

        var atualizada = _rodadas.SelectMany(r => r.Partidas).FirstOrDefault(p => p.PartidaId == _partidaDetalhes.PartidaId);
        if (atualizada is not null) _partidaDetalhes = atualizada;
    }

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
    }

    /// <summary>Edição a abrir (link da página de Edições); vazio = liga atual.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "liga")]
    public Guid? LigaDaUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _ligas = await LigaService.ListAtivasAsync(CancellationToken.None);

            if (LigaDaUrl is Guid daUrl && daUrl != Guid.Empty)
            {
                _liga = _ligas.FirstOrDefault(l => l.LigaId == daUrl)
                        ?? await LigaService.GetByIdAsync(daUrl, CancellationToken.None);

                // Edição encerrada entra no seletor para dar para voltar às que estão rolando.
                if (_liga is not null && _ligas.All(l => l.LigaId != _liga.LigaId))
                    _ligas = _ligas.Append(_liga).ToArray();
            }

            // Padrão: liga atual; se não houver, cai para a primeira ativa.
            _liga ??= await LigaService.GetAtualAsync(CancellationToken.None)
                      ?? (_ligas.Count > 0 ? _ligas[0] : null);

            if (_liga is not null)
            {
                _ligaId = _liga.LigaId;
                await LoadLigaDataAsync(_liga.LigaId);
            }
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadLigaDataAsync(Guid ligaId)
    {
        _classif = await LigaService.GetClassificacaoAsync(ligaId, CancellationToken.None);
        var rodadas = await LigaService.GetRodadasComPartidasAsync(ligaId, CancellationToken.None);
        // Mini liga, decisão do título e playoff de acesso vêm depois das rodadas, com nome próprio.
        var extras = await LigaService.GetJogosExtrasAsync(ligaId, CancellationToken.None);
        _rodadas = rodadas.Where(r => r.Numero > 0).Concat(extras).ToArray();
        // O jogo decisivo da Copa aparece como rodada normal, mas não soma pontos:
        // o que ele resolve é a ordem entre os empatados.
        _decisivos = LigaDesempate.DosJogos(rodadas.Where(r => r.Desempate).SelectMany(r => r.Partidas));
        var confrontos = LigaDesempate.ConfrontosDasRodadas(rodadas);
        if (_regra.DesempateSerieB)
        {
            // Série B: quem segue empatado divide a posição; na faixa que muda de zona, fica azul.
            var blocos = LigaDesempate.BlocosSerieB(_classif, c => c.TimeId, CopaStats, confrontos, _decisivos);
            _classif = blocos.SelectMany(b => b).ToList();
            _posicoes = LigaDesempate.PosicoesSerieB(blocos, c => c.TimeId);
            _empatados = LigaDesempate.EmpatadosEmZona(blocos, _regra, c => c.TimeId);
        }
        else
        {
            _posicoes = null;
            _empatados = LigaDesempate.EmpatadosNoTopo(_classif, false, c => c.TimeId, CopaStats, confrontos, _decisivos);
        }
        _posicoesPorRodada = _liga?.Tipo == TipoCompetition.Liga
            ? PosicaoPorRodada.Calcular(_rodadas, _classif, Posicao)
            : new Dictionary<Guid, IReadOnlyList<PosicaoNaRodada>>();
        _knockoutJogos = await LigaService.GetKnockoutAsync(ligaId, CancellationToken.None);
        _tituloNoMataMata = _liga?.Tipo == TipoCompetition.Liga && _knockoutJogos.Count > 0;
        _artilheiros = await LigaService.GetArtilheirosAsync(ligaId, CancellationToken.None);
        _assistencias = await LigaService.GetAssistenciasAsync(ligaId, CancellationToken.None);
        _cartoes = await LigaService.GetCartoesEstatAsync(ligaId, CancellationToken.None);
        _numerosTimes = await EstatisticasPes.DosTimesAsync(ligaId, CancellationToken.None);
        _selecoes = await LigaService.GetSelecoesDasRodadasAsync(ligaId, CancellationToken.None);
        _notas = await LigaService.GetMediasNotasAsync(ligaId, CancellationToken.None);
        _disciplina = await LigaService.GetDisciplinaAsync(ligaId, CancellationToken.None);

        _rodadaIdx = 0;
        for (int i = _rodadas.Count - 1; i >= 0; i--)
        {
            if (_rodadas[i].Partidas.Any(p => p.Status != PartidaStatus.Agendada))
            {
                _rodadaIdx = i;
                break;
            }
        }
    }

    private async Task OnLigaChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var ligaId))
        {
            _ligaId = ligaId;
            _liga = _ligas?.FirstOrDefault(l => l.LigaId == ligaId);
            _tab = "classif";
            _loading = true;
            StateHasChanged();
            await LoadLigaDataAsync(ligaId);
            _loading = false;
            StateHasChanged();
        }
    }

    private void RodadaAnterior() { if (_rodadaIdx > 0) _rodadaIdx--; }
    private void RodadaProxima() { if (_rodadaIdx < _rodadas.Count - 1) _rodadaIdx++; }

    private async Task AbrirDetalhesPartida(LigaPartidaDto partida)
    {
        _partidaDetalhes = partida;
        _mostraDetalhesPartida = true;
        _eventoPartida = await LigaService.GetEventosPartidaAsync(partida.PartidaId, CancellationToken.None);
        _escalacoesPartida = await LigaService.GetEscalacoesPartidaAsync(partida.PartidaId, CancellationToken.None);
        StateHasChanged();
    }

    private void AbrirJogoKnockout(LigaKnockoutJogoDto jogo) => _jogoKnockoutAberto = jogo;

    // Gols/cartões do mata-mata mexem nas estatísticas; encerrar avança o bracket.
    private async Task AtualizarAposKnockout()
    {
        var idxAtual = _rodadaIdx;
        await LoadLigaDataAsync(_ligaId);
        if (idxAtual < _rodadas.Count) _rodadaIdx = idxAtual;

        if (_jogoKnockoutAberto is not null)
            _jogoKnockoutAberto = _knockoutJogos.FirstOrDefault(j => j.KnockoutJogoId == _jogoKnockoutAberto.KnockoutJogoId) ?? _jogoKnockoutAberto;
    }

    // O link do vídeo mudou: recarrega a rodada para o 📺 aparecer na lista.
    private async Task AtualizarAposVideo()
    {
        var idxAtual = _rodadaIdx;
        await LoadLigaDataAsync(_ligaId);
        if (idxAtual < _rodadas.Count) _rodadaIdx = idxAtual;
    }

    private void FecharDetalhesPartida()
    {
        _mostraDetalhesPartida = false;
        _confirmandoEncerrar = false;
        _erroPartida = null;
        _showEditor = false;
        _partidaDetalhes = null;
        _eventoPartida = Array.Empty<LigaEventoDto>();
        _escalacoesPartida = null;
    }

    // Edições antigas decidiam o título no mata-mata: lá o 1º da fase de pontos é só o líder,
    // e não o campeão — por isso a zona de campeão some quando a edição teve final.
    private bool _tituloNoMataMata;

    private string? CampeaoDaEdicao =>
        !string.IsNullOrWhiteSpace(_liga?.CampeaoNome)
            ? _liga!.CampeaoNome
            : _knockoutJogos.FirstOrDefault(j => j.Fase == FaseKnockout.Final)?.VencedorNome;

    private ZonaClassificacao ZonaDaPosicao(int posicao)
    {
        var zona = LigaZonas.Zona(_regra, posicao, _classif.Count);
        return _tituloNoMataMata && zona == ZonaClassificacao.Campeao ? ZonaClassificacao.Nenhuma : zona;
    }

    private IEnumerable<ZonaClassificacao> ZonasDaLegenda() =>
        LigaZonas.ZonasDaTabela(_regra, _classif.Count)
            .Where(z => !(_tituloNoMataMata && z == ZonaClassificacao.Campeao));

    // Zonas valem durante a temporada também ("se terminasse hoje").
    private string GetRowClass(LigaClassificacaoItemDto item) =>
        EmpateNoTopo(item) ? ZonaEstilo.LinhaEmpateTopo : ZonaEstilo.Linha(ZonaDaPosicao(Posicao(item)));

    private string GetBadgeClass(LigaClassificacaoItemDto item) =>
        EmpateNoTopo(item) ? ZonaEstilo.BadgeEmpateTopo : ZonaEstilo.Badge(ZonaDaPosicao(Posicao(item)));

    private int Posicao(LigaClassificacaoItemDto item) =>
        _posicoes is not null && _posicoes.TryGetValue(item.TimeId, out var p) ? p : item.Posicao;

    /// <summary>
    /// Série A: empatado em pontos com o líder — o título sai em jogo decisivo (2 times) ou mini liga (3+).
    /// Série B: empatado numa faixa que muda de zona (título, acesso, playoff), sem confronto direto
    /// que resolva. Mesmo critério do encerramento da temporada (LigaAdminService).
    /// </summary>
    private bool EmpateNoTopo(LigaClassificacaoItemDto item) =>
        _liga?.Status != LigaStatus.Criada && _empatados.Contains(item.TimeId);

    private static string StatusBadge(PartidaStatus s) => s switch
    {
        PartidaStatus.EmAndamento => "bg-warning text-dark",
        PartidaStatus.Encerrada => "bg-success",
        _ => "bg-secondary"
    };

    private static string StatusLabel(PartidaStatus s) => s switch
    {
        PartidaStatus.EmAndamento => "Ao vivo",
        PartidaStatus.Encerrada => "Encerrada",
        _ => "Agendada"
    };

    // A ordem do grupo é derivada dos próprios critérios, e não da posição gravada,
    // para a tabela já refletir o desempate mesmo antes do próximo recálculo.
    private List<LigaClassificacaoItemDto> OrdenarGrupo(GrupoCopa grupo) =>
        LigaDesempate.Ordenar(
            _classif.Where(c => c.Grupo == grupo),
            TipoCompetition.Copa,
            c => c.TimeId,
            CopaStats,
            Array.Empty<ConfrontoDireto>(),
            _decisivos);

    // Copa: Pontos → Vitórias → Saldo de Gols. Empatados nos três dividem a posição
    // e decidem a vaga em jogo decisivo — linha azul.
    private static DesempateStats CopaStats(LigaClassificacaoItemDto c) =>
        new(c.Pontos, c.Vitorias, c.SaldoGols, c.GolsPro);

    private static string CopaRowClass(int pos, bool emDecisao) =>
        emDecisao ? "table-primary" : pos <= 2 ? "table-success" : "table-danger";

    private static string CopaBadgeClass(int pos, bool emDecisao) =>
        emDecisao ? "bg-primary" : pos <= 2 ? "bg-success" : "bg-danger";

    private static string EscudoUrl(string? teamName)
    {
        if (string.IsNullOrWhiteSpace(teamName)) return "/images/escudos/escudo.png";
        var normalized = teamName.Normalize(System.Text.NormalizationForm.FormD);
        var clean = new string(normalized.Where(c =>
            System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) !=
            System.Globalization.UnicodeCategory.NonSpacingMark).ToArray());
        return $"/images/escudos/{clean}.png";
    }
