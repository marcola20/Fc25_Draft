@page "/liga"
@using System.Globalization
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Interfaces
@using Fc25Draft.Core.Utilities
@using Fc25Draft.Web.Components.Liga
@using Fc25Draft.Web.Utilities
@inject ILigaPublicService LigaService
@inject IEstatisticasPesService EstatisticasPes
@inject AdminAuthService AdminAuth
@inject ILigaAdminService AdminSvc
@implements IDisposable

<PageTitle>Liga</PageTitle>

<div class="container-fluid py-3">
    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    }
    else if (_erro is not null)
    {
        <div class="alert alert-danger"><strong>Erro ao carregar a liga:</strong> @_erro</div>
    }
    else if (_liga is null)
    {
        <div class="alert alert-info">
            Nenhuma liga ativa no momento.
            <a href="/liga/edicoes" class="alert-link">Ver as edições anteriores</a>.
        </div>
    }
    else
    {
        <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
            <h1 class="h3 mb-0">@_liga.Nome</h1>
            @if (_ligas is not null && _ligas.Count > 1)
            {
                <select class="form-select form-select-sm w-auto" @onchange="OnLigaChanged">
                    @if (_ligas.Any(l => l.Status != LigaStatus.Encerrada))
                    {
                        <optgroup label="Em andamento">
                            @foreach (var l in _ligas.Where(l => l.Status != LigaStatus.Encerrada))
                            {
                                <option value="@l.LigaId" selected="@(_ligaId == l.LigaId)">
                                    @l.Nome (@LigaLabels.Competicao(l.Tipo, l.Divisao))
                                </option>
                            }
                        </optgroup>
                    }
                    @* Edição encerrada só entra aqui quando foi aberta pela página de Edições. *@
                    @if (_ligas.Any(l => l.Status == LigaStatus.Encerrada))
                    {
                        <optgroup label="Encerradas">
                            @foreach (var l in _ligas.Where(l => l.Status == LigaStatus.Encerrada))
                            {
                                <option value="@l.LigaId" selected="@(_ligaId == l.LigaId)">
                                    @l.Nome (@LigaLabels.Competicao(l.Tipo, l.Divisao))
                                </option>
                            }
                        </optgroup>
                    }
                </select>
            }
            <a href="/liga/edicoes" class="btn btn-sm btn-outline-secondary">📚 Edições</a>
            <a href="/liga/historico" class="btn btn-sm btn-outline-secondary">📊 Histórico</a>
            @if (_liga.Tipo == TipoCompetition.Liga)
            {
                <a href="@($"/liga/reta-final?liga={_liga.LigaId}")" class="btn btn-sm btn-outline-secondary">🏁 Reta final</a>
            }
            <a href="@($"/liga/simulacao?liga={_liga.LigaId}")" class="btn btn-sm btn-outline-secondary">🧮 Simulação</a>
        </div>
        <p class="text-muted small mb-3">
            Status: <strong>@LigaLabels.Status(_liga.Status, _liga.Tipo)</strong>
            @if (_liga.Status == LigaStatus.Encerrada && !string.IsNullOrWhiteSpace(CampeaoDaEdicao))
            {
                <span> — 🏆 Campeão: <strong>@CampeaoDaEdicao</strong></span>
            }
        </p>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <ul class="nav nav-tabs mb-0">
                <li class="nav-item">
                    <button class="nav-link @(_tab == "classif" ? "active" : "")" @onclick='() => _tab = "classif"'>
                        @(EhSupercopa ? "O jogo" : "Classificação")
                    </button>
                </li>
                @if (!EhSupercopa && _liga.Status != LigaStatus.PrimeiraFase && _liga.Status != LigaStatus.Criada)
                {
                    <li class="nav-item">
                        <button class="nav-link @(_tab == "knockout" ? "active" : "")" @onclick='() => _tab = "knockout"'>Mata-Mata</button>
                    </li>
                }
                @if (_liga.Tipo == TipoCompetition.Liga)
                {
                    <li class="nav-item">
                        <button class="nav-link @(_tab == "matriz" ? "active" : "")" @onclick='() => _tab = "matriz"'>Confrontos</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(_tab == "linha" ? "active" : "")" @onclick='() => _tab = "linha"'>Linha do tempo</button>
                    </li>
                }
                <li class="nav-item">
                    <button class="nav-link @(_tab == "stats" ? "active" : "")" @onclick='() => _tab = "stats"'>Estatísticas</button>
                </li>
            </ul>

            @if (_tab == "classif" && _classif.Any() && !EhSupercopa)
            {
                <button type="button" class="btn btn-sm btn-success" @onclick="CompartilharClassificacao" disabled="@_sharingClassif">
                    @if (_sharingClassif)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Gerando…</span>
                    }
                    else
                    {
                        <span>📷 Compartilhar</span>
                    }
                </button>
            }
        </div>

        <!-- ── Classificação ── -->
        @if (_tab == "classif")
        {
            @if (EhSupercopa && JogoUnico)
            {
                <!-- Supercopa é jogo único: não tem tabela nem rodadas. -->
                <div class="alert alert-secondary">
                    <strong>Jogo único</strong> entre o campeão da Série A e o campeão da Copa.
                    Quem vencer leva a Supercopa; empate vai para os pênaltis.
                </div>
            }
            else if (EhSupercopa)
            {
                <!-- O mesmo time ganhou a Série A e a Copa: semifinal entre os vices e final contra ele. -->
                <div class="alert alert-secondary">
                    O mesmo time ganhou a Série A e a Copa: a Supercopa tem <strong>semifinal</strong> entre o vice da Série A
                    e o vice da Copa, e o vencedor enfrenta o campeão na <strong>final</strong>. Empate vai para os pênaltis.
                </div>
            }
            else if (!_classif.Any())
            {
                <div class="alert alert-info">Classificação ainda não disponível.</div>
            }
            else if (_liga.Tipo == TipoCompetition.Copa)
            {
                var itensGrupo = OrdenarGrupo(_grupoSelecionado);
                var posicoesGrupo = LigaDesempate.PosicoesCopa(itensGrupo, c => c.TimeId, CopaStats, _decisivos);

                <!-- Copa: seletor de grupo -->
                <div class="mb-3 d-flex gap-2 flex-wrap">
                    @foreach (var grupo in GruposDaCopa())
                    {
                        var atual = grupo;
                        <button class="btn @(_grupoSelecionado == atual ? "btn-primary" : "btn-outline-primary")" @onclick="() => _grupoSelecionado = atual">
                            Grupo @atual
                        </button>
                    }
                </div>

                <!-- Copa: tabela do grupo selecionado -->
                @if (itensGrupo.Count == 0)
                {
                    <div class="alert alert-info">Nenhum time neste grupo.</div>
                }
                else
                {
                    <ShareableCard Id="cap-tabela-copa"
                                   Titulo="@LigaNome"
                                   Subtitulo='@($"Classificação — Grupo {_grupoSelecionado}")'
                                   Arquivo='@($"cbfv-grupo-{_grupoSelecionado}.png")'
                                   MostrarBotao="false"
                                   @ref="_classifCardRef">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle" style="font-size:0.875rem;">
                                <thead class="table-dark">
                                    <tr>
                                        <th style="width:40px;">#</th>
                                        <th>Time</th>
                                        <th class="text-center" title="Pontos" style="width:40px;">Pts</th>
                                        <th class="text-center" title="Jogos" style="width:35px;">J</th>
                                        <th class="text-center" title="Vitórias" style="width:35px;">V</th>
                                        <th class="text-center" title="Empates" style="width:35px;">E</th>
                                        <th class="text-center" title="Derrotas" style="width:35px;">D</th>
                                        <th class="text-center" title="Gols Pró" style="width:35px;">GP</th>
                                        <th class="text-center" title="Gols Contra" style="width:35px;">GC</th>
                                        <th class="text-center" title="Saldo de Gols" style="width:35px;">SG</th>
                                        <th class="text-center" title="Últimos 5 jogos (o mais recente à direita)">Últimos 5</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in itensGrupo.Select((x, i) => new { Item = x, Position = posicoesGrupo[i], EmDecisao = posicoesGrupo.Count(p => p == posicoesGrupo[i]) > 1 }))
                                    {
                                        <tr class="@CopaRowClass(item.Position, item.EmDecisao)" style="height:44px;" title="@(item.EmDecisao ? "Empate em Pontos, Vitórias e Saldo de Gols — decidido em jogo decisivo" : null)">
                                            <td style="width:40px;"><span class="badge @CopaBadgeClass(item.Position, item.EmDecisao)">@item.Position</span></td>
                                            <td style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                                <img src="@EscudoUrl(item.Item.TimeNome)" alt="" width="22" height="22" class="me-1 rounded-circle" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" />
                                                <span class="fw-semibold">@item.Item.TimeNome</span>
                                            </td>
                                            <td class="text-center fw-bold" style="width:40px;">@item.Item.Pontos</td>
                                            <td class="text-center" style="width:35px;">@item.Item.Jogos</td>
                                            <td class="text-center" style="width:35px;">@item.Item.Vitorias</td>
                                            <td class="text-center" style="width:35px;">@item.Item.Empates</td>
                                            <td class="text-center" style="width:35px;">@item.Item.Derrotas</td>
                                            <td class="text-center" style="width:35px;">@item.Item.GolsPro</td>
                                            <td class="text-center" style="width:35px;">@item.Item.GolsContra</td>
                                            <td class="text-center @(item.Item.SaldoGols > 0 ? "text-success" : item.Item.SaldoGols < 0 ? "text-danger" : "")" style="width:35px;">
                                                @(item.Item.SaldoGols > 0 ? "+" : "")@item.Item.SaldoGols
                                            </td>
                                            <td class="text-center text-nowrap"><FormaBolinhas Jogos="@Forma(item.Item.TimeId)" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex flex-wrap gap-3 mt-2 small text-muted">
                            <span><span class="badge bg-success me-1">●</span> Avança (1º-2º)</span>
                            <span><span class="badge bg-danger me-1">●</span> Eliminado</span>
                            <span><span class="badge bg-primary me-1">●</span> Empatados (Pts, V e SG) — jogo decisivo</span>
                        </div>
                    </ShareableCard>
                }
            }
            else
            {
                <!-- Liga: tabela única -->
                <ShareableCard Id="cap-tabela-liga"
                               Titulo="@LigaNome"
                               Subtitulo="Classificação"
                               Arquivo="cbfv-classificacao.png"
                               MostrarBotao="false"
                               @ref="_classifCardRef">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" style="font-size:0.875rem;">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width:64px;" title="Posição e quanto mudou desde a rodada passada">#</th>
                                    <th>Time</th>
                                    <th class="text-center" title="Pontos" style="width:40px;">Pts</th>
                                    <th class="text-center" title="Jogos" style="width:35px;">J</th>
                                    <th class="text-center" title="Vitórias" style="width:35px;">V</th>
                                    <th class="text-center" title="Empates" style="width:35px;">E</th>
                                    <th class="text-center" title="Derrotas" style="width:35px;">D</th>
                                    <th class="text-center" title="Gols Pró" style="width:35px;">GP</th>
                                    <th class="text-center" title="Gols Contra" style="width:35px;">GC</th>
                                    <th class="text-center" title="Saldo de Gols" style="width:35px;">SG</th>
                                    <th class="text-center" title="Últimos 5 jogos (o mais recente à direita)">Últimos 5</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _classif)
                                {
                                    <tr class="@GetRowClass(item)" style="height:44px;">
                                        <td class="text-nowrap" style="width:64px;">
                                            <span class="badge @GetBadgeClass(item)">@Posicao(item)</span>
                                            @if (Variacao(item.TimeId) is int v && v != 0)
                                            {
                                                <span class="fw-bold ms-1 @(v > 0 ? "text-success" : "text-danger")" style="font-size:.7rem;"
                                                      title="@(v > 0 ? "Subiu" : "Caiu") @Math.Abs(v) @(Math.Abs(v) == 1 ? "posição" : "posições") desde a rodada passada">@(v > 0 ? "▲" : "▼")@Math.Abs(v)</span>
                                            }
                                        </td>
                                        <td style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                            <img src="@EscudoUrl(item.TimeNome)" alt="" width="22" height="22" class="me-1 rounded-circle" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" />
                                            <span class="fw-semibold">@item.TimeNome</span>
                                        </td>
                                        <td class="text-center fw-bold" style="width:40px;">@item.Pontos</td>
                                        <td class="text-center" style="width:35px;">@item.Jogos</td>
                                        <td class="text-center" style="width:35px;">@item.Vitorias</td>
                                        <td class="text-center" style="width:35px;">@item.Empates</td>
                                        <td class="text-center" style="width:35px;">@item.Derrotas</td>
                                        <td class="text-center" style="width:35px;">@item.GolsPro</td>
                                        <td class="text-center" style="width:35px;">@item.GolsContra</td>
                                        <td class="text-center @(item.SaldoGols > 0 ? "text-success" : item.SaldoGols < 0 ? "text-danger" : "")" style="width:35px;">
                                            @(item.SaldoGols > 0 ? "+" : "")@item.SaldoGols
                                        </td>
                                        <td class="text-center text-nowrap"><FormaBolinhas Jogos="@Forma(item.TimeId)" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex gap-3 flex-wrap mb-1 small">
                        @foreach (var zona in ZonasDaLegenda())
                        {
                            <span><span class="badge @ZonaEstilo.Badge(zona) px-2">&nbsp;</span> @LigaZonas.Rotulo(zona)</span>
                        }
                        @if (_classif.Any(EmpateNoTopo))
                        {
                            <span><span class="badge @ZonaEstilo.BadgeEmpateTopo px-2">&nbsp;</span> @(_regra.DesempateSerieB ? "Empate em posição de zona — jogo decisivo ou mini liga no fim da temporada" : "Empate no topo — jogo decisivo ou mini liga")</span>
                        }
                    </div>
                </ShareableCard>

                <PosicaoRodadaGrafico Posicoes="_posicoesPorRodada" Tabela="_classif" Regra="_regra" />
            }

            <!-- Matches/Rounds -->
            @if (_rodadas.Any())
            {
                <hr class="my-4" />
                <h5 class="text-uppercase text-muted small fw-bold mb-3">@(EhSupercopa && JogoUnico ? "A decisão" : "Partidas")</h5>

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        @if (EhSupercopa && JogoUnico)
                        {
                            <span class="fw-bold">Jogo único</span>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="RodadaAnterior" disabled="@(_rodadaIdx == 0)">‹ Anterior</button>
                            <span class="fw-bold px-2">
                                @(_rodadaAtual?.Titulo ?? $"Rodada {_rodadaAtual?.Numero}")
                                @if (_rodadaAtual?.DataHora is DateTime quando)
                                {
                                    <span class="text-muted fw-normal ms-1">· @quando.ToString("ddd dd/MM · HH'h'", Br)</span>
                                }
                                @if (_rodadaAtual is { Desempate: true, Titulo: null })
                                {
                                    <span class="badge bg-primary ms-1" title="Não vale pontos na classificação">Jogo Decisivo</span>
                                }
                            </span>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="RodadaProxima" disabled="@(_rodadaIdx == _rodadas.Count - 1)">Próxima ›</button>
                        }
                    </div>

                    @if (_rodadaAtual is not null)
                    {
                        <button type="button" class="btn btn-sm btn-success" @onclick="CompartilharRodada" disabled="@_sharingRodada">
                            @if (_sharingRodada)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Gerando…</span>
                            }
                            else
                            {
                                <span>📷 Compartilhar</span>
                            }
                        </button>
                    }
                </div>

                @if (_rodadaAtual is not null)
                {
                    <RodadaResumoCard @ref="_rodadaResumoRef"
                                      LigaNome="@LigaNome"
                                      Rodada="@_rodadaAtual"
                                      ProximaRodada="@_proximaRodada"
                                      Classificacao="@(_liga?.Tipo == TipoCompetition.Liga ? _classif : Array.Empty<LigaClassificacaoItemDto>())"
                                      JogoUnico="@(EhSupercopa && JogoUnico)" />

                    <ShareableCard Id="cap-rodada"
                                   Titulo="@LigaNome"
                                   Subtitulo='@(EhSupercopa && JogoUnico ? "Jogo único" : _rodadaAtual.Titulo ?? $"Rodada {_rodadaAtual.Numero}")'
                                   Arquivo='@(EhSupercopa ? "cbfv-supercopa.png" : _rodadaAtual.Titulo is null ? $"cbfv-rodada-{_rodadaAtual.Numero}.png" : "cbfv-decisao.png")'
                                   MostrarBotao="false"
                                   @ref="_rodadaCardRef">
                        <div class="list-group">
                            @foreach (var p in _rodadaAtual.Partidas)
                            {
                            <div class="list-group-item py-3 d-flex align-items-center gap-2 gap-md-3" style="cursor:pointer;flex-wrap:wrap;" @onclick="() => AbrirDetalhesPartida(p)">
                                <div class="flex-grow-1 d-flex align-items-center justify-content-between gap-1 gap-md-3">
                                    <div class="d-flex align-items-center justify-content-end gap-1" style="flex:1;min-width:0;">
                                        <span class="fw-semibold text-end d-none d-md-inline small">@p.TimeCasaNome</span>
                                        <img src="@EscudoUrl(p.TimeCasaNome)" alt="" width="20" height="20" style="object-fit:contain;flex-shrink:0" onerror="this.src='/images/escudos/escudo.png'" />
                                    </div>
                                    <div class="text-center fw-bold" style="flex:0 0 auto;min-width:45px;">
                                        @if (p.Status == PartidaStatus.Agendada)
                                        {
                                            <span class="text-muted small fw-normal">vs</span>
                                        }
                                        else
                                        {
                                            <span class="small">@p.GolsCasa <span class="text-muted fw-normal">–</span> @p.GolsFora</span>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center gap-1 justify-content-start" style="flex:1;min-width:0;justify-content:flex-end;">
                                        <img src="@EscudoUrl(p.TimeForaNome)" alt="" width="20" height="20" style="object-fit:contain;flex-shrink:0" onerror="this.src='/images/escudos/escudo.png'" />
                                        <span class="fw-semibold d-none d-md-inline small">@p.TimeForaNome</span>
                                    </div>
                                </div>
                                <div class="d-flex gap-1 align-items-center flex-shrink-0" style="min-width:auto;">
                                    <span class="badge @StatusBadge(p.Status)" style="font-size:0.7rem;">@StatusLabel(p.Status)</span>
                                    @if (p.TemPenaltis) { <span class="badge bg-info text-dark" style="font-size:0.7rem;">Pen</span> }
                                    @if (!string.IsNullOrWhiteSpace(p.YoutubeVideoId)) { <span title="Tem vídeo no telão" style="font-size:0.85rem;">📺</span> }
                                </div>
                                @* Sem jogo disputado o favorito não aparece: a linha vazia deixaria o jogo colado no topo. *@
                                @if (p.Status == PartidaStatus.Agendada && NaTabela(p.TimeCasaId) is { } mandante && NaTabela(p.TimeForaId) is { } visitante
                                     && (mandante.Jogos > 0 || visitante.Jogos > 0))
                                {
                                    <div class="w-100">
                                        <FavoritoJogo PontosCasa="mandante.Pontos" JogosCasa="mandante.Jogos" PontosFora="visitante.Pontos" JogosFora="visitante.Jogos" />
                                    </div>
                                }
                            </div>
                            }
                        </div>
                    </ShareableCard>

                    var suspensosDaRodada = _disciplina?.Suspensoes.Where(s => s.RodadaCumprida == _rodadaAtual.RodadaId).ToList() ?? [];
                    @if (suspensosDaRodada.Count > 0)
                    {
                        <div class="card mt-3">
                            <div class="card-header fw-bold">🟥 Suspensos nesta rodada</div>
                            <ul class="list-group list-group-flush">
                                @foreach (var s in suspensosDaRodada)
                                {
                                    <li class="list-group-item d-flex flex-wrap align-items-center gap-2 py-1">
                                        <img src="@EscudoUrl(s.TimeNome)" alt="" width="20" height="20" style="object-fit:contain;flex-shrink:0" onerror="this.src='/images/escudos/escudo.png'" />
                                        <span class="fw-semibold">@s.JogadorNome</span>
                                        <span class="text-muted small">@s.TimeNome · @s.Motivo (@s.JogoDoCartao)</span>
                                        @if (s.Cumprida)
                                        {
                                            <span class="badge bg-secondary ms-auto">cumprida</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (_selecoes.TryGetValue(_rodadaAtual.RodadaId, out var selecao) && selecao.Count > 0)
                    {
                        <div class="mt-4">
                        <ShareableCard Id="cap-selecao"
                                       Titulo="@LigaNome"
                                       Subtitulo='@($"Seleção da {(_rodadaAtual.Titulo ?? $"rodada {_rodadaAtual.Numero}")}")'
                                       Arquivo='@($"cbfv-selecao-{_rodadaAtual.Numero}.png")'>
                            <div class="card">
                                <div class="card-header fw-bold">
                                    ⭐ Seleção da rodada
                                    <span class="text-muted small fw-normal">· 4-3-3 pelas notas do PES</span>
                                </div>
                                <ul class="list-group list-group-flush">
                                    @foreach (var j in selecao)
                                    {
                                        <li class="list-group-item d-flex align-items-center gap-2 py-1">
                                            <span class="badge bg-light text-dark border" style="min-width:2.7rem">@j.Posicao</span>
                                            <img src="@EscudoUrl(j.TimeNome)" alt="" width="20" height="20" style="object-fit:contain;flex-shrink:0" onerror="this.src='/images/escudos/escudo.png'" />
                                            <a class="fw-semibold text-body text-decoration-none text-truncate" href="/players/details/@j.JogadorId">@j.JogadorNome</a>
                                            <span class="text-muted small text-truncate d-none d-sm-inline">@j.TimeNome</span>
                                            @if (j.MelhorEmCampo)
                                            {
                                                <span title="Melhor em campo">⭐</span>
                                            }
                                            <span class="badge ms-auto @NotaPes.Cor(j.Nota)">@NotaPes.Texto(j.Nota)</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </ShareableCard>
                        </div>
                    }
                }
            }
            else
            {
                <div class="text-muted small mt-4">Nenhuma rodada registrada.</div>
            }
        }

        <!-- ── Mata-Mata ── -->
        @if (_tab == "knockout")
        {
            @if (!_knockoutJogos.Any())
            {
                <div class="alert alert-info">Fase de mata-mata ainda não iniciada.</div>
            }
            else
            {
                <ShareableCard Id="cap-knockout" Titulo="@LigaNome" Subtitulo="Mata-Mata" Arquivo="cbfv-mata-mata.png">
                @if (_liga.Tipo != TipoCompetition.Copa)
                {
                <!-- Play-In e Quartas só na Liga: a Copa vai direto dos grupos para as semifinais -->
                <h5 class="text-uppercase text-muted small fw-bold mt-2 mb-2">Play-In</h5>
                <div class="row g-3 mb-4">
                    @foreach (var fase in new[] { FaseKnockout.PlayIn_A, FaseKnockout.PlayIn_B, FaseKnockout.PlayIn_C })
                    {
                        var jogo = _knockoutJogos.FirstOrDefault(j => j.Fase == fase);
                        if (jogo is not null)
                        {
                            <div class="col-12 col-md-4"><KnockoutCard Jogo="jogo" OnClick="AbrirJogoKnockout" /></div>
                        }
                    }
                </div>

                <h5 class="text-uppercase text-muted small fw-bold mt-2 mb-2">Quartas de Final</h5>
                <div class="row g-3 mb-4">
                    @foreach (var fase in new[] { FaseKnockout.QF1, FaseKnockout.QF2, FaseKnockout.QF3, FaseKnockout.QF4 })
                    {
                        var jogo = _knockoutJogos.FirstOrDefault(j => j.Fase == fase);
                        if (jogo is not null)
                        {
                            <div class="col-12 col-md-3"><KnockoutCard Jogo="jogo" OnClick="AbrirJogoKnockout" /></div>
                        }
                    }
                </div>
                }

                <h5 class="text-uppercase text-muted small fw-bold mt-2 mb-2">Semifinais</h5>
                <div class="row g-3 mb-4">
                    @foreach (var fase in new[] { FaseKnockout.Semi1, FaseKnockout.Semi2 })
                    {
                        var jogo = _knockoutJogos.FirstOrDefault(j => j.Fase == fase);
                        if (jogo is not null)
                        {
                            <div class="col-12 col-md-6"><KnockoutCard Jogo="jogo" OnClick="AbrirJogoKnockout" /></div>
                        }
                    }
                </div>

                @if (_knockoutJogos.FirstOrDefault(j => j.Fase == FaseKnockout.Final) is { } jogoFinal)
                {
                    <h5 class="text-uppercase text-muted small fw-bold mt-2 mb-2">Final</h5>
                    <div class="row g-3">
                        <div class="col-12 col-md-6 offset-md-3">
                            <KnockoutCard Jogo="jogoFinal" Destaque="true" OnClick="AbrirJogoKnockout" />
                        </div>
                    </div>
                }
                </ShareableCard>
            }
        }

        <!-- ── Confrontos (matriz de resultados da Liga) ── -->
        @if (_tab == "matriz")
        {
            <MatrizResultados Rodadas="_rodadas" Tabela="_classif" OnAbrir="AbrirDetalhesPartida" />
        }

        <!-- ── Linha do tempo da temporada (Liga) ── -->
        @if (_tab == "linha")
        {
            <LinhaDoTempoCard Rodadas="_rodadas" Tabela="_classif" Posicoes="_posicoesPorRodada" Regra="_regra" Selecoes="_selecoes" OnAbrir="AbrirDetalhesPartida" />
        }

        <!-- ── Estatísticas ── -->
        @if (_tab == "stats")
        {
            <ul class="nav nav-pills mb-3">
                <li class="nav-item">
                    <button class="nav-link @(_statsTab == "artilheiros" ? "active" : "")" @onclick='() => _statsTab = "artilheiros"'>Artilheiros</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_statsTab == "assistencias" ? "active" : "")" @onclick='() => _statsTab = "assistencias"'>Assistências</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_statsTab == "cartoes" ? "active" : "")" @onclick='() => _statsTab = "cartoes"'>Cartões</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_statsTab == "notas" ? "active" : "")" @onclick='() => _statsTab = "notas"'>Notas</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_statsTab == "times" ? "active" : "")" @onclick='() => _statsTab = "times"'>Times</button>
                </li>
            </ul>

            @if (_statsTab == "times")
            {
                if (_numerosTimes.Count == 0)
                {
                    <div class="alert alert-info">Nenhuma partida desta competição tem os números do PES (posse, chutes, passes…).</div>
                }
                else
                {
                    <p class="small text-muted mb-2">
                        Médias por jogo das partidas importadas do PES. Clique no título da coluna para ordenar.
                    </p>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle text-center" style="font-size:0.85rem;">
                            <thead class="table-dark">
                                <tr>
                                    <th class="text-start">Time</th>
                                    @foreach (var coluna in ColunasDosTimes)
                                    {
                                        var c = coluna;
                                        <th role="button" title="@c.Dica" @onclick="() => OrdenarTimes(c.Chave)" class="text-nowrap">
                                            @c.Titulo@(_ordemTimes == c.Chave ? (_ordemTimesDesc ? " ▼" : " ▲") : "")
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in TimesOrdenados)
                                {
                                    <tr>
                                        <td class="text-start text-nowrap">
                                            <img src="@EscudoUrl(t.TimeNome)" alt="" width="20" height="20" style="object-fit:contain" class="me-1" />
                                            <a href="/teams/details/@t.TimeId">@t.TimeNome</a>
                                        </td>
                                        @foreach (var coluna in ColunasDosTimes)
                                        {
                                            <td class="@(_ordemTimes == coluna.Chave ? "fw-semibold" : "")">@coluna.Texto(t)</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (_statsTab == "notas")
            {
                var minimo = MinimoDeJogosComNota;
