    private IReadOnlyDictionary<Guid, IReadOnlyList<PosicaoNaRodada>> _posicoesPorRodada = new Dictionary<Guid, IReadOnlyList<PosicaoNaRodada>>();

    /// <summary>Posições ganhas (positivo) ou perdidas desde a rodada anterior; nulo sem duas rodadas.</summary>
    private int? Variacao(Guid timeId) =>
        _posicoesPorRodada.TryGetValue(timeId, out var serie) && serie.Count > 1 ? serie[^2].Posicao - serie[^1].Posicao : null;
    private LigaRegraZonas _regra => _liga is null ? LigaRegraZonas.SoCampeao : LigaRegraZonas.De(_liga);
    private IReadOnlyList<LigaArtilheiroDto> _artilheiros = Array.Empty<LigaArtilheiroDto>();
    private IReadOnlyList<LigaArtilheiroDto> _assistencias = Array.Empty<LigaArtilheiroDto>();
    private IReadOnlyList<LigaCartaoEstatDto> _cartoes = Array.Empty<LigaCartaoEstatDto>();

    // ── Números do PES por time (aba Estatísticas › Times) ──
    private IReadOnlyList<NumerosDoTimeDto> _numerosTimes = Array.Empty<NumerosDoTimeDto>();
    private string _ordemTimes = "posse";
    private bool _ordemTimesDesc = true;

    private sealed record ColunaDoTime(string Chave, string Titulo, string Dica, Func<NumerosDoTimeDto, decimal?> Valor, bool EmPercentual = false)
    {
        public string Texto(NumerosDoTimeDto t) =>
            Valor(t) is decimal v ? v.ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) + (EmPercentual ? "%" : "") : "—";
    }

    private static readonly ColunaDoTime[] ColunasDosTimes =
    [
        new("jogos", "J", "Jogos com números do PES", t => t.Jogos),
        new("posse", "Posse", "Posse de bola média", t => t.Posse, EmPercentual: true),
        new("chutes", "Chutes", "Chutes por jogo", t => t.ChutesPorJogo),
        new("agol", "A gol", "Chutes a gol por jogo", t => t.ChutesAGolPorJogo),
        new("pontaria", "Pontaria", "Chutes a gol sobre chutes", t => t.Pontaria, EmPercentual: true),
        new("conversao", "Conversão", "Gols a cada chute a gol", t => t.Conversao, EmPercentual: true),
        new("passes", "Passes", "Acerto de passes", t => t.AcertoDePasses, EmPercentual: true),
        new("sofridos", "Sofre", "Chutes do adversário por jogo", t => t.ChutesSofridosPorJogo),
        new("sofridosgol", "Sofre a gol", "Chutes a gol do adversário por jogo", t => t.ChutesAGolSofridosPorJogo),
        new("defesas", "Defesas", "Defesas do goleiro por jogo", t => t.DefesasPorJogo),
        new("desarmes", "Desarmes", "Desarmes por jogo", t => t.DesarmesPorJogo),
        new("escanteios", "Escanteios", "Escanteios por jogo", t => t.EscanteiosPorJogo),
        new("faltas", "Faltas", "Faltas cometidas por jogo", t => t.FaltasPorJogo),
    ];

    private IEnumerable<NumerosDoTimeDto> TimesOrdenados
    {
        get
        {
            var coluna = ColunasDosTimes.FirstOrDefault(c => c.Chave == _ordemTimes) ?? ColunasDosTimes[1];
            return _ordemTimesDesc
                ? _numerosTimes.OrderByDescending(t => coluna.Valor(t) ?? decimal.MinValue)
                : _numerosTimes.OrderBy(t => coluna.Valor(t) ?? decimal.MaxValue);
        }
    }

    // Clicar de novo na mesma coluna inverte a ordem.
    private void OrdenarTimes(string chave)
    {
        _ordemTimesDesc = _ordemTimes != chave || !_ordemTimesDesc;
        _ordemTimes = chave;
    }
    private IReadOnlyDictionary<Guid, IReadOnlyList<SelecaoRodadaJogadorDto>> _selecoes = new Dictionary<Guid, IReadOnlyList<SelecaoRodadaJogadorDto>>();
