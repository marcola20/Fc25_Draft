@page "/liga"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Interfaces
@inject ILigaPublicService LigaService

<PageTitle>Liga</PageTitle>

<div class="container-fluid py-3">
    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    }
    else if (_erro is not null)
    {
        <div class="alert alert-danger"><strong>Erro ao carregar a liga:</strong> @_erro</div>
    }
    else if (_liga is null)
    {
        <div class="alert alert-info">Nenhuma liga ativa no momento.</div>
    }
    else
    {
        <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
            <h1 class="h3 mb-0">@_liga.Nome</h1>
            @if (_ligas is not null && _ligas.Count > 1)
            {
                <select class="form-select form-select-sm w-auto" @onchange="OnLigaChanged">
                    @foreach (var l in _ligas)
                    {
                        <option value="@l.LigaId" selected="@(l.LigaId == _liga.LigaId)">
                            @l.Nome (@(l.Tipo == TipoCompetition.Copa ? "Copa" : "Liga"))
                        </option>
                    }
                </select>
            }
        </div>
        <p class="text-muted small mb-3">Status: <strong>@LigaStatusLabel(_liga.Status)</strong></p>

        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button class="nav-link @(_tab == "classif" ? "active" : "")" @onclick='() => _tab = "classif"'>Classificação</button>
            </li>
            @if (_liga.Status != LigaStatus.PrimeiraFase && _liga.Status != LigaStatus.Criada)
            {
                <li class="nav-item">
                    <button class="nav-link @(_tab == "knockout" ? "active" : "")" @onclick='() => _tab = "knockout"'>Mata-Mata</button>
                </li>
            }
            <li class="nav-item">
                <button class="nav-link @(_tab == "stats" ? "active" : "")" @onclick='() => _tab = "stats"'>Estatísticas</button>
            </li>
        </ul>

        <!-- ── Classificação ── -->
        @if (_tab == "classif")
        {
            @if (!_classif.Any())
            {
                <div class="alert alert-info">Classificação ainda não disponível.</div>
            }
            else if (_liga.Tipo == TipoCompetition.Copa)
            {
                var itensGrupo = _classif.Where(c => c.Grupo == _grupoSelecionado).OrderBy(x => x.Posicao).ToList();

                <!-- Copa: seletor de grupo -->
                <div class="mb-3 d-flex gap-2">
                    <button class="btn @(_grupoSelecionado == GrupoCopa.A ? "btn-primary" : "btn-outline-primary")" @onclick='() => _grupoSelecionado = GrupoCopa.A'>
                        Grupo A
                    </button>
                    <button class="btn @(_grupoSelecionado == GrupoCopa.B ? "btn-primary" : "btn-outline-primary")" @onclick='() => _grupoSelecionado = GrupoCopa.B'>
                        Grupo B
                    </button>
                </div>

                <!-- Copa: tabela do grupo selecionado -->
                @if (itensGrupo.Count == 0)
                {
                    <div class="alert alert-info">Nenhum time neste grupo.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>#</th>
                                    <th>Time</th>
                                    <th class="text-center" title="Pontos">Pts</th>
                                    <th class="text-center" title="Jogos">J</th>
                                    <th class="text-center" title="Vitórias">V</th>
                                    <th class="text-center" title="Empates">E</th>
                                    <th class="text-center" title="Derrotas">D</th>
                                    <th class="text-center" title="Gols Pró">GP</th>
                                    <th class="text-center" title="Gols Contra">GC</th>
                                    <th class="text-center" title="Saldo de Gols">SG</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in itensGrupo.Select((x, i) => new { Item = x, Position = i + 1 }))
                                {
                                    <tr class="@(item.Position <= 2 ? "table-success" : "table-danger")">
                                        <td><span class="badge @(item.Position <= 2 ? "bg-success" : "bg-danger")">@item.Position</span></td>
                                        <td class="fw-semibold">
                                            <img src="@EscudoUrl(item.Item.TimeNome)" alt="" width="22" height="22" class="me-1 rounded-circle" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" />
                                            @item.Item.TimeNome
                                        </td>
                                        <td class="text-center fw-bold">@item.Item.Pontos</td>
                                        <td class="text-center">@item.Item.Jogos</td>
                                        <td class="text-center">@item.Item.Vitorias</td>
                                        <td class="text-center">@item.Item.Empates</td>
                                        <td class="text-center">@item.Item.Derrotas</td>
                                        <td class="text-center">@item.Item.GolsPro</td>
                                        <td class="text-center">@item.Item.GolsContra</td>
                                        <td class="text-center @(item.Item.SaldoGols > 0 ? "text-success" : item.Item.SaldoGols < 0 ? "text-danger" : "")">
                                            @(item.Item.SaldoGols > 0 ? "+" : "")@item.Item.SaldoGols
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex flex-wrap gap-3 mt-2 small text-muted">
                        <span><span class="badge bg-success me-1">●</span> Avança (1º-2º)</span>
                        <span><span class="badge bg-danger me-1">●</span> Eliminado</span>
                    </div>
                }
            }
            else
            {
                <!-- Liga: tabela única -->
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Time</th>
                                <th class="text-center" title="Pontos">Pts</th>
                                <th class="text-center" title="Jogos">J</th>
                                <th class="text-center" title="Vitórias">V</th>
                                <th class="text-center" title="Empates">E</th>
                                <th class="text-center" title="Derrotas">D</th>
                                <th class="text-center" title="Gols Pró">GP</th>
                                <th class="text-center" title="Gols Contra">GC</th>
                                <th class="text-center" title="Saldo de Gols">SG</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _classif)
                            {
                                <tr class="@GetRowClass(item)">
                                    <td>
                                        <span class="badge @GetBadgeClass(item)">@item.Posicao</span>
                                    </td>
                                    <td class="fw-semibold">
                                        <img src="@EscudoUrl(item.TimeNome)" alt="" width="22" height="22" class="me-1 rounded-circle" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" />
                                        @item.TimeNome
                                    </td>
                                    <td class="text-center fw-bold">@item.Pontos</td>
                                    <td class="text-center">@item.Jogos</td>
                                    <td class="text-center">@item.Vitorias</td>
                                    <td class="text-center">@item.Empates</td>
                                    <td class="text-center">@item.Derrotas</td>
                                    <td class="text-center">@item.GolsPro</td>
                                    <td class="text-center">@item.GolsContra</td>
                                    <td class="text-center @(item.SaldoGols > 0 ? "text-success" : item.SaldoGols < 0 ? "text-danger" : "")">
                                        @(item.SaldoGols > 0 ? "+" : "")@item.SaldoGols
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (_liga.Status != LigaStatus.PrimeiraFase && _liga.Status != LigaStatus.Criada)
                {
                    <div class="d-flex gap-3 flex-wrap mb-4 small">
                        <span><span class="badge bg-success px-2">&nbsp;</span> Bye (1º–2º)</span>
                        <span><span class="badge bg-success px-2">&nbsp;</span> QF direto (3º–6º)</span>
                        <span><span class="badge bg-info px-2">&nbsp;</span> Play-In (7º–10º)</span>
                        <span><span class="badge bg-danger px-2">&nbsp;</span> Eliminado (11º–12º)</span>
                    </div>
                }
            }
        }

        <!-- ── Mata-Mata ── -->
        @if (_tab == "knockout")
        {
            @if (!_knockoutJogos.Any())
            {
                <div class="alert alert-info">Fase de mata-mata ainda não iniciada.</div>
            }
            else
            {
                <h5 class="text-uppercase text-muted small fw-bold mt-2 mb-2">Play-In</h5>
                <div class="row g-3 mb-4">
                    @foreach (var fase in new[] { FaseKnockout.PlayIn_A, FaseKnockout.PlayIn_B, FaseKnockout.PlayIn_C })
                    {
                        var jogo = _knockoutJogos.FirstOrDefault(j => j.Fase == fase);
                        if (jogo is not null)
                        {
                            <div class="col-12 col-md-4"><KnockoutCard Jogo="jogo" /></div>
                        }
                    }
                </div>

                <h5 class="text-uppercase text-muted small fw-bold mt-2 mb-2">Quartas de Final</h5>
                <div class="row g-3 mb-4">
                    @foreach (var fase in new[] { FaseKnockout.QF1, FaseKnockout.QF2, FaseKnockout.QF3, FaseKnockout.QF4 })
                    {
                        var jogo = _knockoutJogos.FirstOrDefault(j => j.Fase == fase);
                        if (jogo is not null)
                        {
                            <div class="col-12 col-md-3"><KnockoutCard Jogo="jogo" /></div>
                        }
                    }
                </div>

                <h5 class="text-uppercase text-muted small fw-bold mt-2 mb-2">Semifinais</h5>
                <div class="row g-3 mb-4">
                    @foreach (var fase in new[] { FaseKnockout.Semi1, FaseKnockout.Semi2 })
                    {
                        var jogo = _knockoutJogos.FirstOrDefault(j => j.Fase == fase);
                        if (jogo is not null)
                        {
                            <div class="col-12 col-md-6"><KnockoutCard Jogo="jogo" /></div>
                        }
                    }
                </div>

                @if (_knockoutJogos.FirstOrDefault(j => j.Fase == FaseKnockout.Final) is { } jogoFinal)
                {
                    <h5 class="text-uppercase text-muted small fw-bold mt-2 mb-2">Final</h5>
                    <div class="row g-3">
                        <div class="col-12 col-md-6 offset-md-3">
                            <KnockoutCard Jogo="jogoFinal" Destaque="true" />
                        </div>
                    </div>
                }
            }
        }

        <!-- ── Estatísticas ── -->
        @if (_tab == "stats")
        {
            <ul class="nav nav-pills mb-3">
                <li class="nav-item">
                    <button class="nav-link @(_statsTab == "artilheiros" ? "active" : "")" @onclick='() => _statsTab = "artilheiros"'>Artilheiros</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_statsTab == "assistencias" ? "active" : "")" @onclick='() => _statsTab = "assistencias"'>Assistências</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_statsTab == "cartoes" ? "active" : "")" @onclick='() => _statsTab = "cartoes"'>Cartões</button>
                </li>
            </ul>

            @if (_statsTab == "artilheiros")
            {
                @if (!_artilheiros.Any())
                {
                    <div class="text-muted">Nenhum gol registrado.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-dark">
                                <tr><th>#</th><th>Jogador</th><th>Time</th><th class="text-center">⚽ Gols</th><th class="text-center">Assist.</th></tr>
                            </thead>
                            <tbody>
                                @{ int r = 0; }
                                @foreach (var a in _artilheiros)
                                {
                                    r++;
                                    <tr>
                                        <td class="fw-bold text-muted">@r</td>
                                        <td>@a.JogadorNome</td>
                                        <td class="text-muted small">
                                            <img src="@EscudoUrl(a.TimeNome)" alt="" width="18" height="18" class="me-1" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" />
                                            @a.TimeNome
                                        </td>
                                        <td class="text-center fw-bold">@a.Gols</td>
                                        <td class="text-center text-muted">@(a.Assistencias > 0 ? a.Assistencias.ToString() : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (_statsTab == "assistencias")
            {
                @if (!_assistencias.Any())
                {
                    <div class="text-muted">Nenhuma assistência registrada.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-dark">
                                <tr><th>#</th><th>Jogador</th><th>Time</th><th class="text-center">Assistências</th></tr>
                            </thead>
                            <tbody>
                                @{ int ra = 0; }
                                @foreach (var a in _assistencias)
                                {
                                    ra++;
                                    <tr>
                                        <td class="fw-bold text-muted">@ra</td>
                                        <td>@a.JogadorNome</td>
                                        <td class="text-muted small">
                                            <img src="@EscudoUrl(a.TimeNome)" alt="" width="18" height="18" class="me-1" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" />
                                            @a.TimeNome
                                        </td>
                                        <td class="text-center fw-bold">@a.Assistencias</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (_statsTab == "cartoes")
            {
                @if (!_cartoes.Any())
                {
                    <div class="text-muted">Nenhum cartão registrado.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-dark">
                                <tr><th>#</th><th>Jogador</th><th>Time</th><th class="text-center">🟨</th><th class="text-center">🟥</th></tr>
                            </thead>
                            <tbody>
                                @{ int rc = 0; }
                                @foreach (var c in _cartoes)
                                {
                                    rc++;
                                    <tr>
                                        <td class="fw-bold text-muted">@rc</td>
                                        <td>@c.JogadorNome</td>
                                        <td class="text-muted small">
                                            <img src="@EscudoUrl(c.TimeNome)" alt="" width="18" height="18" class="me-1" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" />
                                            @c.TimeNome
                                        </td>
                                        <td class="text-center">@c.CartoesAmarelos</td>
                                        <td class="text-center">@(c.CartoesVermelhos > 0 ? c.CartoesVermelhos.ToString() : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        }
    }
</div>

@code {
    private string _tab = "classif";
    private string _statsTab = "artilheiros";
    private int _rodadaIdx;
    private bool _loading = true;
    private GrupoCopa _grupoSelecionado = GrupoCopa.A;

    private LigaDto? _liga;
    private IReadOnlyList<LigaDto>? _ligas;
    private IReadOnlyList<LigaClassificacaoItemDto> _classif = Array.Empty<LigaClassificacaoItemDto>();
    private IReadOnlyList<LigaRodadaComPartidasDto> _rodadas = Array.Empty<LigaRodadaComPartidasDto>();
    private IReadOnlyList<LigaKnockoutJogoDto> _knockoutJogos = Array.Empty<LigaKnockoutJogoDto>();
    private IReadOnlyList<LigaArtilheiroDto> _artilheiros = Array.Empty<LigaArtilheiroDto>();
    private IReadOnlyList<LigaArtilheiroDto> _assistencias = Array.Empty<LigaArtilheiroDto>();
    private IReadOnlyList<LigaCartaoEstatDto> _cartoes = Array.Empty<LigaCartaoEstatDto>();

    private string? _erro;

    private LigaRodadaComPartidasDto? _rodadaAtual =>
        _rodadas.Count > 0 && _rodadaIdx < _rodadas.Count ? _rodadas[_rodadaIdx] : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _ligas = await LigaService.ListAtivasAsync(CancellationToken.None);
            _liga = await LigaService.GetAtualAsync(CancellationToken.None);

            if (_liga is not null)
            {
                await LoadLigaDataAsync(_liga.LigaId);
            }
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadLigaDataAsync(Guid ligaId)
    {
        _classif = await LigaService.GetClassificacaoAsync(ligaId, CancellationToken.None);
        var rodadas = await LigaService.GetRodadasComPartidasAsync(ligaId, CancellationToken.None);
        _rodadas = rodadas.Where(r => r.Numero > 0).ToArray();
        _knockoutJogos = await LigaService.GetKnockoutAsync(ligaId, CancellationToken.None);
        _artilheiros = await LigaService.GetArtilheirosAsync(ligaId, CancellationToken.None);
        _assistencias = await LigaService.GetAssistenciasAsync(ligaId, CancellationToken.None);
        _cartoes = await LigaService.GetCartoesEstatAsync(ligaId, CancellationToken.None);

        _rodadaIdx = 0;
        for (int i = _rodadas.Count - 1; i >= 0; i--)
        {
            if (_rodadas[i].Partidas.Any(p => p.Status != PartidaStatus.Agendada))
            {
                _rodadaIdx = i;
                break;
            }
        }
    }

    private async Task OnLigaChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var ligaId))
        {
            _liga = _ligas?.FirstOrDefault(l => l.LigaId == ligaId);
            _loading = true;
            StateHasChanged();
            await LoadLigaDataAsync(ligaId);
            _loading = false;
            StateHasChanged();
        }
    }

    private void RodadaAnterior() { if (_rodadaIdx > 0) _rodadaIdx--; }
    private void RodadaProxima() { if (_rodadaIdx < _rodadas.Count - 1) _rodadaIdx++; }

    private string GetRowClass(LigaClassificacaoItemDto item)
    {
        // During Primeira Fase, all teams same color (no qualifications yet)
        if (_liga?.Status == LigaStatus.PrimeiraFase || _liga?.Status == LigaStatus.Criada)
            return "table-success";

        if (_classif.Count == 0) return RowClass(item.Posicao);

        var topTeam = _classif[0];
        // Highlight all teams tied with the leader in green
        if (item.Pontos == topTeam.Pontos && item.Vitorias == topTeam.Vitorias &&
            item.SaldoGols == topTeam.SaldoGols && item.GolsPro == topTeam.GolsPro)
            return "table-success";

        return RowClass(item.Posicao);
    }

    private string GetBadgeClass(LigaClassificacaoItemDto item)
    {
        if (_classif.Count == 0) return BadgeClass(item.Posicao);

        var topTeam = _classif[0];
        // Highlight all teams tied with the leader in green
        if (item.Pontos == topTeam.Pontos && item.Vitorias == topTeam.Vitorias &&
            item.SaldoGols == topTeam.SaldoGols && item.GolsPro == topTeam.GolsPro)
            return "bg-success";

        return BadgeClass(item.Posicao);
    }

    private static string RowClass(int pos) => pos switch
    {
        <= 6 => "table-success",
        >= 7 and <= 10 => "table-info",
        _ => "table-danger"
    };

    private static string BadgeClass(int pos) => pos switch
    {
        <= 6 => "bg-success",
        >= 7 and <= 10 => "bg-info text-dark",
        _ => "bg-danger"
    };

    private static string StatusBadge(PartidaStatus s) => s switch
    {
        PartidaStatus.EmAndamento => "bg-warning text-dark",
        PartidaStatus.Encerrada => "bg-success",
        _ => "bg-secondary"
    };

    private static string StatusLabel(PartidaStatus s) => s switch
    {
        PartidaStatus.EmAndamento => "Ao vivo",
        PartidaStatus.Encerrada => "Encerrada",
        _ => "Agendada"
    };

    private static string LigaStatusLabel(LigaStatus s) => s switch
    {
        LigaStatus.Criada => "Criada",
        LigaStatus.PrimeiraFase => "Primeira Fase",
        LigaStatus.PlayIn => "Play-In",
        LigaStatus.Playoffs => "Playoffs",
        LigaStatus.Encerrada => "Encerrada",
        _ => s.ToString()
    };

    private static string EscudoUrl(string? teamName)
    {
        if (string.IsNullOrWhiteSpace(teamName)) return "/images/escudos/escudo.png";
        var normalized = teamName.Normalize(System.Text.NormalizationForm.FormD);
        var clean = new string(normalized.Where(c =>
            System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) !=
            System.Globalization.UnicodeCategory.NonSpacingMark).ToArray());
        return $"/images/escudos/{clean}.png";
    }
}
