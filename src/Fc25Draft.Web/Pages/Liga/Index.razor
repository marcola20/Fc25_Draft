@page "/liga"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Interfaces
@inject ILigaPublicService LigaService

<PageTitle>Liga</PageTitle>

<div class="container-fluid py-3">
    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    }
    else if (_erro is not null)
    {
        <div class="alert alert-danger"><strong>Erro ao carregar a liga:</strong> @_erro</div>
    }
    else if (_liga is null)
    {
        <div class="alert alert-info">Nenhuma liga ativa no momento.</div>
    }
    else
    {
        <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
            <h1 class="h3 mb-0">@_liga.Nome</h1>
            @if (_ligas is not null && _ligas.Count > 1)
            {
                <select class="form-select form-select-sm w-auto" @onchange="OnLigaChanged">
                    @foreach (var l in _ligas)
                    {
                        <option value="@l.LigaId" selected="@(_ligaId == l.LigaId)">
                            @l.Nome (@(l.Tipo == TipoCompetition.Copa ? "Copa" : "Liga"))
                        </option>
                    }
                </select>
            }
            <a href="/liga/historico" class="btn btn-sm btn-outline-secondary">📊 Histórico</a>
        </div>
        <p class="text-muted small mb-3">Status: <strong>@LigaStatusLabel(_liga.Status)</strong></p>

        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button class="nav-link @(_tab == "classif" ? "active" : "")" @onclick='() => _tab = "classif"'>Classificação</button>
            </li>
            @if (_liga.Status != LigaStatus.PrimeiraFase && _liga.Status != LigaStatus.Criada)
            {
                <li class="nav-item">
                    <button class="nav-link @(_tab == "knockout" ? "active" : "")" @onclick='() => _tab = "knockout"'>Mata-Mata</button>
                </li>
            }
            <li class="nav-item">
                <button class="nav-link @(_tab == "stats" ? "active" : "")" @onclick='() => _tab = "stats"'>Estatísticas</button>
            </li>
        </ul>

        <!-- ── Classificação ── -->
        @if (_tab == "classif")
        {
            @if (!_classif.Any())
            {
                <div class="alert alert-info">Classificação ainda não disponível.</div>
            }
            else if (_liga.Tipo == TipoCompetition.Copa)
            {
                var itensGrupo = _classif.Where(c => c.Grupo == _grupoSelecionado).OrderBy(x => x.Posicao).ToList();

                <!-- Copa: seletor de grupo -->
                <div class="mb-3 d-flex gap-2">
                    <button class="btn @(_grupoSelecionado == GrupoCopa.A ? "btn-primary" : "btn-outline-primary")" @onclick='() => _grupoSelecionado = GrupoCopa.A'>
                        Grupo A
                    </button>
                    <button class="btn @(_grupoSelecionado == GrupoCopa.B ? "btn-primary" : "btn-outline-primary")" @onclick='() => _grupoSelecionado = GrupoCopa.B'>
                        Grupo B
                    </button>
                </div>

                <!-- Copa: tabela do grupo selecionado -->
                @if (itensGrupo.Count == 0)
                {
                    <div class="alert alert-info">Nenhum time neste grupo.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" style="font-size:0.875rem;">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width:40px;">#</th>
                                    <th>Time</th>
                                    <th class="text-center" title="Pontos" style="width:40px;">Pts</th>
                                    <th class="text-center" title="Jogos" style="width:35px;">J</th>
                                    <th class="text-center" title="Vitórias" style="width:35px;">V</th>
                                    <th class="text-center" title="Empates" style="width:35px;">E</th>
                                    <th class="text-center" title="Derrotas" style="width:35px;">D</th>
                                    <th class="text-center" title="Gols Pró" style="width:35px;">GP</th>
                                    <th class="text-center" title="Gols Contra" style="width:35px;">GC</th>
                                    <th class="text-center" title="Saldo de Gols" style="width:35px;">SG</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in itensGrupo.Select((x, i) => new { Item = x, Position = i + 1 }))
                                {
                                    <tr class="@(item.Position <= 2 ? "table-success" : "table-danger")" style="height:44px;">
                                        <td style="width:40px;"><span class="badge @(item.Position <= 2 ? "bg-success" : "bg-danger")">@item.Position</span></td>
                                        <td style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                            <img src="@EscudoUrl(item.Item.TimeNome)" alt="" width="22" height="22" class="me-1 rounded-circle" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" />
                                            <span class="fw-semibold">@item.Item.TimeNome</span>
                                        </td>
                                        <td class="text-center fw-bold" style="width:40px;">@item.Item.Pontos</td>
                                        <td class="text-center" style="width:35px;">@item.Item.Jogos</td>
                                        <td class="text-center" style="width:35px;">@item.Item.Vitorias</td>
                                        <td class="text-center" style="width:35px;">@item.Item.Empates</td>
                                        <td class="text-center" style="width:35px;">@item.Item.Derrotas</td>
                                        <td class="text-center" style="width:35px;">@item.Item.GolsPro</td>
                                        <td class="text-center" style="width:35px;">@item.Item.GolsContra</td>
                                        <td class="text-center @(item.Item.SaldoGols > 0 ? "text-success" : item.Item.SaldoGols < 0 ? "text-danger" : "")" style="width:35px;">
                                            @(item.Item.SaldoGols > 0 ? "+" : "")@item.Item.SaldoGols
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex flex-wrap gap-3 mt-2 small text-muted">
                        <span><span class="badge bg-success me-1">●</span> Avança (1º-2º)</span>
                        <span><span class="badge bg-danger me-1">●</span> Eliminado</span>
                    </div>
                }
            }
            else
            {
                <!-- Liga: tabela única -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle" style="font-size:0.875rem;">
                        <thead class="table-dark">
                            <tr>
                                <th style="width:40px;">#</th>
                                <th>Time</th>
                                <th class="text-center" title="Pontos" style="width:40px;">Pts</th>
                                <th class="text-center" title="Jogos" style="width:35px;">J</th>
                                <th class="text-center" title="Vitórias" style="width:35px;">V</th>
                                <th class="text-center" title="Empates" style="width:35px;">E</th>
                                <th class="text-center" title="Derrotas" style="width:35px;">D</th>
                                <th class="text-center" title="Gols Pró" style="width:35px;">GP</th>
                                <th class="text-center" title="Gols Contra" style="width:35px;">GC</th>
                                <th class="text-center" title="Saldo de Gols" style="width:35px;">SG</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _classif)
                            {
                                <tr class="@GetRowClass(item)" style="height:44px;">
                                    <td style="width:40px;">
                                        <span class="badge @GetBadgeClass(item)">@item.Posicao</span>
                                    </td>
                                    <td style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                        <img src="@EscudoUrl(item.TimeNome)" alt="" width="22" height="22" class="me-1 rounded-circle" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" />
                                        <span class="fw-semibold">@item.TimeNome</span>
                                    </td>
                                    <td class="text-center fw-bold" style="width:40px;">@item.Pontos</td>
                                    <td class="text-center" style="width:35px;">@item.Jogos</td>
                                    <td class="text-center" style="width:35px;">@item.Vitorias</td>
                                    <td class="text-center" style="width:35px;">@item.Empates</td>
                                    <td class="text-center" style="width:35px;">@item.Derrotas</td>
                                    <td class="text-center" style="width:35px;">@item.GolsPro</td>
                                    <td class="text-center" style="width:35px;">@item.GolsContra</td>
                                    <td class="text-center @(item.SaldoGols > 0 ? "text-success" : item.SaldoGols < 0 ? "text-danger" : "")" style="width:35px;">
                                        @(item.SaldoGols > 0 ? "+" : "")@item.SaldoGols
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (_liga.Status != LigaStatus.PrimeiraFase && _liga.Status != LigaStatus.Criada)
                {
                    <div class="d-flex gap-3 flex-wrap mb-4 small">
                        <span><span class="badge bg-success px-2">&nbsp;</span> Bye (1º–2º)</span>
                        <span><span class="badge bg-success px-2">&nbsp;</span> QF direto (3º–6º)</span>
                        <span><span class="badge bg-info px-2">&nbsp;</span> Play-In (7º–10º)</span>
                        <span><span class="badge bg-danger px-2">&nbsp;</span> Eliminado (11º–12º)</span>
                    </div>
                }
            }

            <!-- Matches/Rounds -->
            @if (_rodadas.Any())
            {
                <hr class="my-4" />
                <h5 class="text-uppercase text-muted small fw-bold mb-3">Partidas</h5>

                <div class="d-flex align-items-center gap-2 mb-3">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="RodadaAnterior" disabled="@(_rodadaIdx == 0)">‹ Anterior</button>
                    <span class="fw-bold px-2">Rodada @(_rodadaAtual?.Numero)</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="RodadaProxima" disabled="@(_rodadaIdx == _rodadas.Count - 1)">Próxima ›</button>
                </div>

                @if (_rodadaAtual is not null)
                {
                    <div class="list-group">
                        @foreach (var p in _rodadaAtual.Partidas)
                        {
                            <div class="list-group-item py-2 d-flex align-items-center gap-2 gap-md-3" style="cursor:pointer;flex-wrap:wrap;" @onclick="() => AbrirDetalhesPartida(p)">
                                <div class="flex-grow-1 d-flex align-items-center justify-content-between gap-1 gap-md-3">
                                    <div class="d-flex align-items-center justify-content-end gap-1" style="flex:1;min-width:0;">
                                        <span class="fw-semibold text-end d-none d-md-inline small">@p.TimeCasaNome</span>
                                        <img src="@EscudoUrl(p.TimeCasaNome)" alt="" width="20" height="20" style="object-fit:contain;flex-shrink:0" onerror="this.src='/images/escudos/escudo.png'" />
                                    </div>
                                    <div class="text-center fw-bold" style="flex:0 0 auto;min-width:45px;">
                                        @if (p.Status == PartidaStatus.Agendada)
                                        {
                                            <span class="text-muted small fw-normal">vs</span>
                                        }
                                        else
                                        {
                                            <span class="small">@p.GolsCasa <span class="text-muted fw-normal">–</span> @p.GolsFora</span>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center gap-1 justify-content-start" style="flex:1;min-width:0;justify-content:flex-end;">
                                        <img src="@EscudoUrl(p.TimeForaNome)" alt="" width="20" height="20" style="object-fit:contain;flex-shrink:0" onerror="this.src='/images/escudos/escudo.png'" />
                                        <span class="fw-semibold d-none d-md-inline small">@p.TimeForaNome</span>
                                    </div>
                                </div>
                                <div class="d-flex gap-1 align-items-center flex-shrink-0" style="min-width:auto;">
                                    <span class="badge @StatusBadge(p.Status)" style="font-size:0.7rem;">@StatusLabel(p.Status)</span>
                                    @if (p.TemPenaltis) { <span class="badge bg-info text-dark" style="font-size:0.7rem;">Pen</span> }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="text-muted small mt-4">Nenhuma rodada registrada.</div>
            }
        }

        <!-- ── Mata-Mata ── -->
        @if (_tab == "knockout")
        {
            @if (!_knockoutJogos.Any())
            {
                <div class="alert alert-info">Fase de mata-mata ainda não iniciada.</div>
            }
            else
            {
                <h5 class="text-uppercase text-muted small fw-bold mt-2 mb-2">Play-In</h5>
                <div class="row g-3 mb-4">
                    @foreach (var fase in new[] { FaseKnockout.PlayIn_A, FaseKnockout.PlayIn_B, FaseKnockout.PlayIn_C })
                    {
                        var jogo = _knockoutJogos.FirstOrDefault(j => j.Fase == fase);
                        if (jogo is not null)
                        {
                            <div class="col-12 col-md-4"><KnockoutCard Jogo="jogo" /></div>
                        }
                    }
                </div>

                <h5 class="text-uppercase text-muted small fw-bold mt-2 mb-2">Quartas de Final</h5>
                <div class="row g-3 mb-4">
                    @foreach (var fase in new[] { FaseKnockout.QF1, FaseKnockout.QF2, FaseKnockout.QF3, FaseKnockout.QF4 })
                    {
                        var jogo = _knockoutJogos.FirstOrDefault(j => j.Fase == fase);
                        if (jogo is not null)
                        {
                            <div class="col-12 col-md-3"><KnockoutCard Jogo="jogo" /></div>
                        }
                    }
                </div>

                <h5 class="text-uppercase text-muted small fw-bold mt-2 mb-2">Semifinais</h5>
                <div class="row g-3 mb-4">
                    @foreach (var fase in new[] { FaseKnockout.Semi1, FaseKnockout.Semi2 })
                    {
                        var jogo = _knockoutJogos.FirstOrDefault(j => j.Fase == fase);
                        if (jogo is not null)
                        {
                            <div class="col-12 col-md-6"><KnockoutCard Jogo="jogo" /></div>
                        }
                    }
                </div>

                @if (_knockoutJogos.FirstOrDefault(j => j.Fase == FaseKnockout.Final) is { } jogoFinal)
                {
                    <h5 class="text-uppercase text-muted small fw-bold mt-2 mb-2">Final</h5>
                    <div class="row g-3">
                        <div class="col-12 col-md-6 offset-md-3">
                            <KnockoutCard Jogo="jogoFinal" Destaque="true" />
                        </div>
                    </div>
                }
            }
        }

        <!-- ── Estatísticas ── -->
        @if (_tab == "stats")
        {
            <ul class="nav nav-pills mb-3">
                <li class="nav-item">
                    <button class="nav-link @(_statsTab == "artilheiros" ? "active" : "")" @onclick='() => _statsTab = "artilheiros"'>Artilheiros</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_statsTab == "assistencias" ? "active" : "")" @onclick='() => _statsTab = "assistencias"'>Assistências</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_statsTab == "cartoes" ? "active" : "")" @onclick='() => _statsTab = "cartoes"'>Cartões</button>
                </li>
            </ul>

            @if (_statsTab == "artilheiros")
            {
                @if (!_artilheiros.Any())
                {
                    <div class="text-muted">Nenhum gol registrado.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" style="font-size:0.875rem;">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width:35px;">#</th>
                                    <th>Jogador</th>
                                    <th class="d-none d-md-table-cell">Time</th>
                                    <th class="text-center" style="width:50px;">⚽</th>
                                    <th class="text-center" style="width:45px;">A</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int r = 0; }
                                @foreach (var a in _artilheiros)
                                {
                                    r++;
                                    <tr style="height:40px;">
                                        <td style="width:35px;" class="fw-bold text-muted">@r</td>
                                        <td style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@a.JogadorNome</td>
                                        <td class="d-none d-md-table-cell text-muted small" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                            <img src="@EscudoUrl(a.TimeNome)" alt="" width="18" height="18" class="me-1" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" />
                                            @a.TimeNome
                                        </td>
                                        <td class="text-center fw-bold" style="width:50px;">@a.Gols</td>
                                        <td class="text-center text-muted" style="width:45px;">@(a.Assistencias > 0 ? a.Assistencias.ToString() : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (_statsTab == "assistencias")
            {
                @if (!_assistencias.Any())
                {
                    <div class="text-muted">Nenhuma assistência registrada.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" style="font-size:0.875rem;">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width:35px;">#</th>
                                    <th>Jogador</th>
                                    <th class="d-none d-md-table-cell">Time</th>
                                    <th class="text-center" style="width:60px;">Assist.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int ra = 0; }
                                @foreach (var a in _assistencias)
                                {
                                    ra++;
                                    <tr style="height:40px;">
                                        <td style="width:35px;" class="fw-bold text-muted">@ra</td>
                                        <td style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@a.JogadorNome</td>
                                        <td class="d-none d-md-table-cell text-muted small" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                            <img src="@EscudoUrl(a.TimeNome)" alt="" width="18" height="18" class="me-1" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" />
                                            @a.TimeNome
                                        </td>
                                        <td class="text-center fw-bold" style="width:60px;">@a.Assistencias</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (_statsTab == "cartoes")
            {
                @if (!_cartoes.Any())
                {
                    <div class="text-muted">Nenhum cartão registrado.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" style="font-size:0.875rem;">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width:35px;">#</th>
                                    <th>Jogador</th>
                                    <th class="d-none d-md-table-cell">Time</th>
                                    <th class="text-center" style="width:45px;">🟨</th>
                                    <th class="text-center" style="width:45px;">🟥</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int rc = 0; }
                                @foreach (var c in _cartoes)
                                {
                                    rc++;
                                    <tr style="height:40px;">
                                        <td style="width:35px;" class="fw-bold text-muted">@rc</td>
                                        <td style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@c.JogadorNome</td>
                                        <td class="d-none d-md-table-cell text-muted small" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                            <img src="@EscudoUrl(c.TimeNome)" alt="" width="18" height="18" class="me-1" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" />
                                            @c.TimeNome
                                        </td>
                                        <td class="text-center" style="width:45px;">@c.CartoesAmarelos</td>
                                        <td class="text-center" style="width:45px;">@(c.CartoesVermelhos > 0 ? c.CartoesVermelhos.ToString() : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        }
    }
</div>

<!-- Match Details Modal -->
@if (_mostraDetalhesPartida && _partidaDetalhes is not null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center;">
        <div class="modal-dialog modal-lg" style="max-height: 80vh; overflow-y: auto;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <img src="@EscudoUrl(_partidaDetalhes.TimeCasaNome)" alt="" width="24" height="24" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" class="me-2" />
                        @_partidaDetalhes.TimeCasaNome
                        <span class="text-muted mx-2">@_partidaDetalhes.GolsCasa – @_partidaDetalhes.GolsFora</span>
                        @_partidaDetalhes.TimeForaNome
                        <img src="@EscudoUrl(_partidaDetalhes.TimeForaNome)" alt="" width="24" height="24" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" class="ms-2" />
                    </h5>
                    <button type="button" class="btn-close" @onclick="FecharDetalhesPartida"></button>
                </div>
                <div class="modal-body">
                    @if (_eventoPartida.Any())
                    {
                        var gols = _eventoPartida.Where(e => e.Tipo == TipoEvento.Gol).ToList();
                        if (gols.Any())
                        {
                            <h6 class="mb-3"><strong>⚽ Gols</strong></h6>
                            <ul class="list-unstyled">
                                @foreach (var gol in gols)
                                {
                                    <li class="mb-2">
                                        <span class="badge bg-primary me-2">@gol.Minuto'</span>
                                        <strong>@gol.JogadorNome</strong> (@gol.TimeNome)
                                        @if (!string.IsNullOrEmpty(gol.AssistenteNome))
                                        {
                                            <span class="text-muted small">- Assistência: @gol.AssistenteNome</span>
                                        }
                                    </li>
                                }
                            </ul>
                            <hr />
                        }

                        var cartoes = _eventoPartida.Where(e => e.Tipo == TipoEvento.CartaoAmarelo || e.Tipo == TipoEvento.CartaoVermelho).ToList();
                        if (cartoes.Any())
                        {
                            <h6 class="mb-3"><strong>🟨 Cartões</strong></h6>
                            <ul class="list-unstyled">
                                @foreach (var cartao in cartoes)
                                {
                                    <li class="mb-2">
                                        <span class="badge @(cartao.Tipo == TipoEvento.CartaoAmarelo ? "bg-warning text-dark" : "bg-danger") me-2">@cartao.Minuto'</span>
                                        <strong>@cartao.JogadorNome</strong> (@cartao.TimeNome)
                                        <span class="ms-2">@(cartao.Tipo == TipoEvento.CartaoAmarelo ? "🟨 Amarelo" : "🟥 Vermelho")</span>
                                    </li>
                                }
                            </ul>
                        }
                    }
                    else
                    {
                        <div class="text-muted">Nenhum evento registrado.</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharDetalhesPartida">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string _tab = "classif";
    private string _statsTab = "artilheiros";
    private int _rodadaIdx;
    private bool _loading = true;
    private GrupoCopa _grupoSelecionado = GrupoCopa.A;
    private Guid _ligaId = Guid.Empty;

    private LigaDto? _liga;
    private IReadOnlyList<LigaDto>? _ligas;
    private IReadOnlyList<LigaClassificacaoItemDto> _classif = Array.Empty<LigaClassificacaoItemDto>();
    private IReadOnlyList<LigaRodadaComPartidasDto> _rodadas = Array.Empty<LigaRodadaComPartidasDto>();
    private IReadOnlyList<LigaKnockoutJogoDto> _knockoutJogos = Array.Empty<LigaKnockoutJogoDto>();
    private IReadOnlyList<LigaArtilheiroDto> _artilheiros = Array.Empty<LigaArtilheiroDto>();
    private IReadOnlyList<LigaArtilheiroDto> _assistencias = Array.Empty<LigaArtilheiroDto>();
    private IReadOnlyList<LigaCartaoEstatDto> _cartoes = Array.Empty<LigaCartaoEstatDto>();

    private bool _mostraDetalhesPartida = false;
    private LigaPartidaDto? _partidaDetalhes;
    private IReadOnlyList<LigaEventoDto> _eventoPartida = Array.Empty<LigaEventoDto>();

    private string? _erro;

    private LigaRodadaComPartidasDto? _rodadaAtual =>
        _rodadas.Count > 0 && _rodadaIdx < _rodadas.Count ? _rodadas[_rodadaIdx] : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _ligas = await LigaService.ListAtivasAsync(CancellationToken.None);
            _liga = await LigaService.GetAtualAsync(CancellationToken.None);

            if (_liga is not null)
            {
                _ligaId = _liga.LigaId;
                await LoadLigaDataAsync(_liga.LigaId);
            }
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadLigaDataAsync(Guid ligaId)
    {
        _classif = await LigaService.GetClassificacaoAsync(ligaId, CancellationToken.None);
        var rodadas = await LigaService.GetRodadasComPartidasAsync(ligaId, CancellationToken.None);
        _rodadas = rodadas.Where(r => r.Numero > 0).ToArray();
        _knockoutJogos = await LigaService.GetKnockoutAsync(ligaId, CancellationToken.None);
        _artilheiros = await LigaService.GetArtilheirosAsync(ligaId, CancellationToken.None);
        _assistencias = await LigaService.GetAssistenciasAsync(ligaId, CancellationToken.None);
        _cartoes = await LigaService.GetCartoesEstatAsync(ligaId, CancellationToken.None);

        _rodadaIdx = 0;
        for (int i = _rodadas.Count - 1; i >= 0; i--)
        {
            if (_rodadas[i].Partidas.Any(p => p.Status != PartidaStatus.Agendada))
            {
                _rodadaIdx = i;
                break;
            }
        }
    }

    private async Task OnLigaChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var ligaId))
        {
            _ligaId = ligaId;
            _liga = _ligas?.FirstOrDefault(l => l.LigaId == ligaId);
            _tab = "classif";
            _loading = true;
            StateHasChanged();
            await LoadLigaDataAsync(ligaId);
            _loading = false;
            StateHasChanged();
        }
    }

    private void RodadaAnterior() { if (_rodadaIdx > 0) _rodadaIdx--; }
    private void RodadaProxima() { if (_rodadaIdx < _rodadas.Count - 1) _rodadaIdx++; }

    private async Task AbrirDetalhesPartida(LigaPartidaDto partida)
    {
        _partidaDetalhes = partida;
        _mostraDetalhesPartida = true;
        _eventoPartida = await LigaService.GetEventosPartidaAsync(partida.PartidaId, CancellationToken.None);
        StateHasChanged();
    }

    private void FecharDetalhesPartida()
    {
        _mostraDetalhesPartida = false;
        _partidaDetalhes = null;
        _eventoPartida = Array.Empty<LigaEventoDto>();
    }

    private string GetRowClass(LigaClassificacaoItemDto item)
    {
        // Only highlight 1st place in green
        return item.Posicao == 1 ? "table-success" : "";
    }

    private string GetBadgeClass(LigaClassificacaoItemDto item)
    {
        // Only highlight 1st place in green
        return item.Posicao == 1 ? "bg-success" : "bg-secondary";
    }

    private static string StatusBadge(PartidaStatus s) => s switch
    {
        PartidaStatus.EmAndamento => "bg-warning text-dark",
        PartidaStatus.Encerrada => "bg-success",
        _ => "bg-secondary"
    };

    private static string StatusLabel(PartidaStatus s) => s switch
    {
        PartidaStatus.EmAndamento => "Ao vivo",
        PartidaStatus.Encerrada => "Encerrada",
        _ => "Agendada"
    };

    private static string LigaStatusLabel(LigaStatus s) => s switch
    {
        LigaStatus.Criada => "Criada",
        LigaStatus.PrimeiraFase => "Primeira Fase",
        LigaStatus.PlayIn => "Play-In",
        LigaStatus.Playoffs => "Playoffs",
        LigaStatus.Encerrada => "Encerrada",
        _ => s.ToString()
    };

    private static string EscudoUrl(string? teamName)
    {
        if (string.IsNullOrWhiteSpace(teamName)) return "/images/escudos/escudo.png";
        var normalized = teamName.Normalize(System.Text.NormalizationForm.FormD);
        var clean = new string(normalized.Where(c =>
            System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) !=
            System.Globalization.UnicodeCategory.NonSpacingMark).ToArray());
        return $"/images/escudos/{clean}.png";
    }
}
