<!-- Match Details Modal -->
@if (_mostraDetalhesPartida && _partidaDetalhes is not null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center;">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <img src="@EscudoUrl(_partidaDetalhes.TimeCasaNome)" alt="" width="24" height="24" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" class="me-2" />
                        @_partidaDetalhes.TimeCasaNome
                        <span class="text-muted mx-2">@(_partidaDetalhes.Status == PartidaStatus.Agendada ? "x" : $"{_partidaDetalhes.GolsCasa} – {_partidaDetalhes.GolsFora}")</span>
                        @_partidaDetalhes.TimeForaNome
                        <img src="@EscudoUrl(_partidaDetalhes.TimeForaNome)" alt="" width="24" height="24" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" class="ms-2" />
                    </h5>
                    <button type="button" class="btn-close" @onclick="FecharDetalhesPartida"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_erroPartida))
                    {
                        <div class="alert alert-danger alert-dismissible">@_erroPartida <button class="btn-close" @onclick="() => _erroPartida = null"></button></div>
                    }
                    @if (_showEditor)
                    {
                        <PartidaStatsEditor PartidaId="_partidaDetalhes.PartidaId" OnChanged="AtualizarAoVivo" />
                    }
                    else
                    {
                    <PartidaTelaoLink PartidaId="_partidaDetalhes.PartidaId" YoutubeVideoId="@_partidaDetalhes.YoutubeVideoId" OnAlterado="AtualizarAposVideo" />
                    <ReacoesJogo PartidaId="_partidaDetalhes.PartidaId" Class="mb-3" />
                    @if (_partidaDetalhes.Status == PartidaStatus.Encerrada)
                    {
                        <CraqueDaPartidaCard Escalacoes="_escalacoesPartida" PartidaId="_partidaDetalhes.PartidaId"
                                             CasaNome="@_partidaDetalhes.TimeCasaNome" ForaNome="@_partidaDetalhes.TimeForaNome"
                                             GolsCasa="_partidaDetalhes.GolsCasa" GolsFora="_partidaDetalhes.GolsFora"
                                             Rotulo="@(_partidaDetalhes.RodadaNumero > 0 ? $"Rodada {_partidaDetalhes.RodadaNumero} · {LigaNome}" : LigaNome)" />
                    }
                    <PartidaAbas PartidaId="_partidaDetalhes.PartidaId" CasaId="_partidaDetalhes.TimeCasaId" CasaNome="@_partidaDetalhes.TimeCasaNome" ForaNome="@_partidaDetalhes.TimeForaNome" Eventos="_eventoPartida" Escalacoes="_escalacoesPartida" />
                    }
                </div>
                <div class="modal-footer">
                    @if (_showEditor)
                    {
                        <button type="button" class="btn btn-outline-secondary me-auto" @onclick="() => _showEditor = false">← Voltar</button>
                    }
                    else if (AdminAuth.IsAdmin)
                    {
                        <div class="me-auto d-flex gap-2 flex-wrap align-items-center">
                            <button type="button" class="btn btn-primary" @onclick="EditarStats">✏️ Editar stats</button>
                            @if (_partidaDetalhes.Status == PartidaStatus.Agendada)
                            {
                                <button type="button" class="btn btn-success" @onclick="IniciarPartida" disabled="@_salvandoPartida">▶️ Iniciar partida</button>
                            }
                            else if (_partidaDetalhes.Status == PartidaStatus.EmAndamento && !_confirmandoEncerrar)
                            {
                                <button type="button" class="btn btn-warning" @onclick="() => _confirmandoEncerrar = true">⏹️ Encerrar partida</button>
                            }
                            else if (_partidaDetalhes.Status == PartidaStatus.EmAndamento)
                            {
                                <span class="small text-muted">Encerrar @_partidaDetalhes.GolsCasa – @_partidaDetalhes.GolsFora?</span>
                                <button type="button" class="btn btn-warning" @onclick="EncerrarPartida" disabled="@_salvandoPartida">Confirmar</button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="() => _confirmandoEncerrar = false">Cancelar</button>
                            }
                        </div>
                    }
                    <button type="button" class="btn btn-secondary" @onclick="FecharDetalhesPartida">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string _tab = "classif";
    private string _statsTab = "artilheiros";
    private int _rodadaIdx;
    private bool _loading = true;
    private GrupoCopa _grupoSelecionado = GrupoCopa.A;

    /// <summary>Grupos que a competição realmente tem (a Copa pode ter 2 ou 4).</summary>
    private IEnumerable<GrupoCopa> GruposDaCopa() =>
        _classif.Where(c => c.Grupo is not null).Select(c => c.Grupo!.Value).Distinct().OrderBy(g => g);

    private ShareableCard? _classifCardRef;
    private ShareableCard? _rodadaCardRef;
    private RodadaResumoCard? _rodadaResumoRef;
    private bool _sharingClassif;
    private bool _sharingRodada;

    private async Task CompartilharClassificacao()
    {
        if (_sharingClassif || _classifCardRef is null) return;
        _sharingClassif = true;
        StateHasChanged();
        try { await _classifCardRef.Share(); }
        finally { _sharingClassif = false; StateHasChanged(); }
    }

    private async Task CompartilharRodada()
    {
        if (_sharingRodada || _rodadaResumoRef is null) return;
        _sharingRodada = true;
        StateHasChanged();
        try { await _rodadaResumoRef.CompartilharAsync(); }
        finally { _sharingRodada = false; StateHasChanged(); }
    }
    private Guid _ligaId = Guid.Empty;

    private LigaDto? _liga;
    private IReadOnlyList<LigaDto>? _ligas;
    private IReadOnlyList<LigaClassificacaoItemDto> _classif = Array.Empty<LigaClassificacaoItemDto>();
