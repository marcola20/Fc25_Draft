                                    <th class="text-center" style="width:65px;">Média</th>
                                    <th class="text-center d-none d-sm-table-cell" style="width:65px;" title="Melhor nota">Máx.</th>
                                    <th class="text-center" style="width:40px;" title="Melhor em campo">⭐</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < notas.Count; i++)
