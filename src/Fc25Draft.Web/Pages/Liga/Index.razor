                                    <th style="width:35px;">#</th>
                                    <th>Jogador</th>
                                    <th class="d-none d-md-table-cell">Time</th>
                                    <th class="text-center" style="width:50px;">⚽</th>
                                    <th class="text-center" style="width:45px;">A</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int r = 0; }
                                @foreach (var a in _artilheiros)
                                {
                                    r++;
                                    <tr style="height:40px;">
                                        <td style="width:35px;" class="fw-bold text-muted">@r</td>
                                        <td style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                            <FotoJogador PlayerId="@a.JogadorId" Tamanho="28" Classe="me-2" />
                                            <a href="/players/details/@a.JogadorId" class="text-body">@a.JogadorNome</a>
                                        </td>
                                        <td class="d-none d-md-table-cell text-muted small" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                            @if (a.TimeId != Guid.Empty)
                                            {
                                                <img src="@EscudoUrl(a.TimeNome)" alt="" width="18" height="18" class="me-1" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" />
                                            }
                                            <span class="@(a.TimeId == Guid.Empty ? "fst-italic" : "")">@a.TimeNome</span>
                                        </td>
                                        <td class="text-center fw-bold" style="width:50px;">@a.Gols</td>
                                        <td class="text-center text-muted" style="width:45px;">@(a.Assistencias > 0 ? a.Assistencias.ToString() : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (_statsTab == "assistencias")
            {
                @if (!_assistencias.Any())
                {
                    <div class="text-muted">Nenhuma assistência registrada.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" style="font-size:0.875rem;">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width:35px;">#</th>
                                    <th>Jogador</th>
                                    <th class="d-none d-md-table-cell">Time</th>
                                    <th class="text-center" style="width:60px;">Assist.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int ra = 0; }
                                @foreach (var a in _assistencias)
                                {
                                    ra++;
                                    <tr style="height:40px;">
                                        <td style="width:35px;" class="fw-bold text-muted">@ra</td>
                                        <td style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                            <FotoJogador PlayerId="@a.JogadorId" Tamanho="28" Classe="me-2" />
                                            <a href="/players/details/@a.JogadorId" class="text-body">@a.JogadorNome</a>
                                        </td>
                                        <td class="d-none d-md-table-cell text-muted small" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                            @if (a.TimeId != Guid.Empty)
                                            {
                                                <img src="@EscudoUrl(a.TimeNome)" alt="" width="18" height="18" class="me-1" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" />
                                            }
                                            <span class="@(a.TimeId == Guid.Empty ? "fst-italic" : "")">@a.TimeNome</span>
                                        </td>
                                        <td class="text-center fw-bold" style="width:60px;">@a.Assistencias</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (_statsTab == "cartoes")
            {
                @if (_disciplina is not null)
                {
                    var aCumprir = _disciplina.Suspensoes.Where(s => !s.Cumprida).ToList();
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-lg-6">
                            <div class="card h-100">
                                <div class="card-header fw-bold">🟥 Suspensos <span class="text-muted small fw-normal">· 3 amarelos ou vermelho = 1 jogo</span></div>
                                <ul class="list-group list-group-flush">
                                    @foreach (var s in aCumprir)
                                    {
                                        <li class="list-group-item py-1 small">
                                            <span class="fw-semibold">@s.JogadorNome</span> <span class="text-muted">(@s.TimeNome)</span>
                                            · @s.Motivo em @s.JogoDoCartao · fora @(s.JogoCumprido is null ? "do próximo jogo" : $"de {s.JogoCumprido}")
                                        </li>
                                    }
                                    @if (aCumprir.Count == 0)
                                    {
                                        <li class="list-group-item text-muted small">Ninguém suspenso para o próximo jogo.</li>
