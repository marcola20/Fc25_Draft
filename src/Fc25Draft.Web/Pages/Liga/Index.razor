                                            <a href="/players/details/@c.JogadorId" class="text-body">@c.JogadorNome</a>
                                        </td>
                                        <td class="d-none d-md-table-cell text-muted small" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                            @if (c.TimeId != Guid.Empty)
                                            {
                                                <img src="@EscudoUrl(c.TimeNome)" alt="" width="18" height="18" class="me-1" style="object-fit:contain" onerror="this.src='/images/escudos/escudo.png'" />
                                            }
                                            <span class="@(c.TimeId == Guid.Empty ? "fst-italic" : "")">@c.TimeNome</span>
                                        </td>
                                        <td class="text-center" style="width:45px;">@c.CartoesAmarelos</td>
                                        <td class="text-center" style="width:45px;">@(c.CartoesVermelhos > 0 ? c.CartoesVermelhos.ToString() : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        }
    }
</div>

<!-- Modal de jogo do mata-mata -->
@if (_jogoKnockoutAberto is not null)
{
    <KnockoutJogoModal Jogo="_jogoKnockoutAberto" OnFechar="() => _jogoKnockoutAberto = null" OnAlterado="AtualizarAposKnockout" />
