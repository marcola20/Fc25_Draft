@page "/liga/classificacao"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Interfaces
@using Fc25Draft.Core.Utilities
@using Fc25Draft.Web.Utilities
@inject ILigaPublicService LigaService
@inject NavigationManager Navigation

<PageTitle>Classificação</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex align-items-center gap-3 mb-1 flex-wrap">
        <h1 class="h3 mb-0">Classificação</h1>
        @if (_ligas is not null && _ligas.Count > 1)
        {
            <select class="form-select form-select-sm w-auto" @onchange="OnLigaChanged">
                @foreach (var l in _ligas)
                {
                    <option value="@l.LigaId" selected="@(l.LigaId == _ligaId)">
                        @l.Nome (@LigaLabels.Competicao(l.Tipo, l.Divisao))
                    </option>
                }
            </select>
        }
    </div>

    @if (_liga is not null)
    {
        <p class="text-muted mb-3">@_liga.Nome — @StatusLabel(_liga.Status)</p>
    }

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    }
    else if (_classif is null || _classif.Count == 0)
    {
        <div class="alert alert-info">Classificação ainda não disponível.</div>
    }
    else if (_liga?.Tipo == TipoCompetition.Copa)
    {
        <!-- Copa: tabelas separadas por grupo -->
        @foreach (var grupo in GruposDaCopa())
        {
            var itensGrupo = OrdenarGrupo(grupo);
            if (itensGrupo.Count == 0) continue;
            var posicoes = LigaDesempate.PosicoesCopa(itensGrupo, c => c.TimeId, CopaStats, _decisivos);

            <h5 class="mt-3 mb-2">Grupo @grupo</h5>
            <ShareableCard Id='@($"cap-classif-grupo-{grupo}")'
                           Titulo="@LigaNome"
                           Subtitulo='@($"Classificação — Grupo {grupo}")'
                           Arquivo='@($"cbfv-grupo-{grupo}.png")'>
            <div class="table-responsive mb-4">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Time</th>
                            <th class="text-center" title="Pontos">Pts</th>
                            <th class="text-center" title="Jogos">J</th>
                            <th class="text-center" title="Vitórias">V</th>
                            <th class="text-center" title="Empates">E</th>
                            <th class="text-center" title="Derrotas">D</th>
                            <th class="text-center" title="Gols Pró">GP</th>
                            <th class="text-center" title="Gols Contra">GC</th>
                            <th class="text-center" title="Saldo de Gols">SG</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < itensGrupo.Count; i++)
                        {
                            var item = itensGrupo[i];
                            var grupoPos = posicoes[i];
                            var emDecisao = posicoes.Count(x => x == grupoPos) > 1;
                            <tr class="@CopaRowClass(grupoPos, emDecisao)" title="@(emDecisao ? "Empate em Pontos, Vitórias e Saldo de Gols — decidido em jogo decisivo" : null)">
                                <td><span class="badge @CopaBadgeClass(grupoPos, emDecisao)">@grupoPos</span></td>
                                <td class="fw-semibold">@item.TimeNome</td>
                                <td class="text-center fw-bold">@item.Pontos</td>
                                <td class="text-center">@item.Jogos</td>
                                <td class="text-center">@item.Vitorias</td>
                                <td class="text-center">@item.Empates</td>
                                <td class="text-center">@item.Derrotas</td>
                                <td class="text-center">@item.GolsPro</td>
                                <td class="text-center">@item.GolsContra</td>
                                <td class="text-center @(item.SaldoGols > 0 ? "text-success" : item.SaldoGols < 0 ? "text-danger" : "")">
                                    @(item.SaldoGols > 0 ? "+" : "")@item.SaldoGols
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            </ShareableCard>
        }

        @if (_jogosDecisivos.Count > 0)
        {
            <h6 class="text-uppercase text-muted small fw-bold mt-3 mb-2">Jogo Decisivo</h6>
            <ul class="list-group mb-3">
                @foreach (var jd in _jogosDecisivos)
                {
                    <li class="list-group-item py-2 small d-flex align-items-center gap-2 flex-wrap">
                        <span class="fw-semibold">@jd.TimeCasaNome</span>
                        <span class="fw-bold">
                            @(jd.Status == PartidaStatus.Agendada ? "vs" : $"{jd.GolsCasa} – {jd.GolsFora}")
                        </span>
                        <span class="fw-semibold">@jd.TimeForaNome</span>
                        @if (_decisivos.VencedorEntre(jd.TimeCasaId, jd.TimeForaId) is Guid vencedorId)
                        {
                            <span class="badge bg-success">
                                Classificado: @(vencedorId == jd.TimeCasaId ? jd.TimeCasaNome : jd.TimeForaNome)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">A disputar</span>
                        }
                        <span class="text-muted">não vale pontos</span>
                    </li>
                }
            </ul>
        }

        <div class="d-flex flex-wrap gap-3 mt-1 small text-muted">
            <span><span class="badge bg-success me-1">●</span> Avança (1º-2º do grupo)</span>
            <span><span class="badge bg-danger me-1">●</span> Eliminado</span>
            <span><span class="badge bg-primary me-1">●</span> Empatados (Pts, V e SG) — jogo decisivo</span>
        </div>
    }
    else
    {
        <!-- Liga: tabela única -->
        <ShareableCard Id="cap-classif-liga" Titulo="@LigaNome" Subtitulo="Classificação" Arquivo="cbfv-classificacao.png">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Time</th>
                        <th class="text-center" title="Pontos">Pts</th>
                        <th class="text-center" title="Jogos">J</th>
                        <th class="text-center" title="Vitórias">V</th>
                        <th class="text-center" title="Empates">E</th>
                        <th class="text-center" title="Derrotas">D</th>
                        <th class="text-center" title="Gols Pró">GP</th>
                        <th class="text-center" title="Gols Contra">GC</th>
                        <th class="text-center" title="Saldo de Gols">SG</th>
                        <th class="text-center d-none d-md-table-cell" title="Cartões Amarelos">CA</th>
                        <th class="text-center d-none d-md-table-cell" title="Cartões Vermelhos">CV</th>
                        <th class="text-center d-none d-md-table-cell" title="Pontos descontados por punição">Pun.</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _classif)
                    {
                        <tr class="@GetRowClass(item)">
                            <td>
                                <span class="badge @GetBadgeClass(item)">@item.Posicao</span>
                            </td>
                            <td class="fw-semibold">@item.TimeNome</td>
                            <td class="text-center fw-bold">@item.Pontos</td>
                            <td class="text-center">@item.Jogos</td>
                            <td class="text-center">@item.Vitorias</td>
                            <td class="text-center">@item.Empates</td>
                            <td class="text-center">@item.Derrotas</td>
                            <td class="text-center">@item.GolsPro</td>
                            <td class="text-center">@item.GolsContra</td>
                            <td class="text-center @(item.SaldoGols > 0 ? "text-success" : item.SaldoGols < 0 ? "text-danger" : "")">
                                @(item.SaldoGols > 0 ? "+" : "")@item.SaldoGols
                            </td>
                            <td class="text-center d-none d-md-table-cell">@item.CartoesAmarelos</td>
                            <td class="text-center d-none d-md-table-cell text-danger">@item.CartoesVermelhos</td>
                            <td class="text-center d-none d-md-table-cell @(item.PontosDescontados > 0 ? "text-danger fw-bold" : "text-muted")">
                                @(item.PontosDescontados > 0 ? $"-{item.PontosDescontados}" : "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-wrap gap-3 mt-3 small text-muted">
            @foreach (var zona in LigaZonas.ZonasDaTabela(_regra, _classif.Count))
            {
                <span><span class="badge @ZonaEstilo.Badge(zona) me-1">●</span> @LigaZonas.Rotulo(zona)</span>
            }
            @if (_classif.Any(EmpateNoTopo))
            {
                <span><span class="badge @ZonaEstilo.BadgeEmpateTopo me-1">●</span> Empate no topo — jogo decisivo (2 times) ou mini liga (3+)</span>
            }
        </div>
        </ShareableCard>
    }
</div>

@code {
    private LigaDto? _liga;
    private IReadOnlyList<LigaDto>? _ligas;
    private Guid _ligaId;
    private IReadOnlyList<LigaClassificacaoItemDto>? _classif;
    private IReadOnlyList<LigaPartidaDto> _jogosDecisivos = Array.Empty<LigaPartidaDto>();
    private JogosDecisivos _decisivos = JogosDecisivos.Nenhum;
    private LigaRegraZonas _regra => _liga is null ? LigaRegraZonas.SoCampeao : LigaRegraZonas.De(_liga);
    private bool _loading = true;

    private string LigaNome => _liga?.Nome ?? "CBFV";

    protected override async Task OnInitializedAsync()
    {
        _ligas = await LigaService.ListAtivasAsync(CancellationToken.None);

        // Padrão: liga atual; se não houver, cai para a primeira ativa.
        _liga = await LigaService.GetAtualAsync(CancellationToken.None)
                ?? (_ligas.Count > 0 ? _ligas[0] : null);

        if (_liga is not null)
        {
            _ligaId = _liga.LigaId;
            await CarregarAsync(_ligaId);
        }

        _loading = false;
    }

    private async Task OnLigaChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _ligaId = id;
            _liga = _ligas?.FirstOrDefault(l => l.LigaId == id);
            _loading = true;
            StateHasChanged();
            await CarregarAsync(_ligaId);
            _loading = false;
        }
    }

    private async Task CarregarAsync(Guid ligaId)
    {
        _classif = await LigaService.GetClassificacaoAsync(ligaId, CancellationToken.None);

        var rodadas = await LigaService.GetRodadasComPartidasAsync(ligaId, CancellationToken.None);
        _jogosDecisivos = rodadas.Where(r => r.Desempate).SelectMany(r => r.Partidas).ToArray();
        _decisivos = LigaDesempate.DosJogos(_jogosDecisivos);
    }

    // Zonas valem durante a temporada também ("se terminasse hoje").
    private string GetRowClass(LigaClassificacaoItemDto item) =>
        EmpateNoTopo(item) ? ZonaEstilo.LinhaEmpateTopo : ZonaEstilo.Linha(LigaZonas.Zona(_regra, item.Posicao, _classif?.Count ?? 0));

    private string GetBadgeClass(LigaClassificacaoItemDto item) =>
        EmpateNoTopo(item) ? ZonaEstilo.BadgeEmpateTopo : ZonaEstilo.Badge(LigaZonas.Zona(_regra, item.Posicao, _classif?.Count ?? 0));

    /// <summary>
    /// Empatado com o líder em Pts, V, SG e GP depois do fim da fase regular: o título sai em
    /// jogo decisivo ou mini liga. Durante a temporada não marca (no começo todos estão zerados).
    /// </summary>
    private bool EmpateNoTopo(LigaClassificacaoItemDto item)
    {
        if (_classif is not { Count: > 1 } || _liga?.Status is LigaStatus.Criada or LigaStatus.PrimeiraFase or LigaStatus.Encerrada)
            return false;

        var lider = _classif[0];
        bool IgualAoLider(LigaClassificacaoItemDto c) =>
            c.Pontos == lider.Pontos && c.Vitorias == lider.Vitorias && c.SaldoGols == lider.SaldoGols && c.GolsPro == lider.GolsPro;

        return IgualAoLider(item) && _classif.Count(IgualAoLider) > 1;
    }

    /// <summary>Grupos que a competição realmente tem (a Copa pode ter 2 ou 4).</summary>
    private IEnumerable<GrupoCopa> GruposDaCopa() =>
        (_classif ?? Array.Empty<LigaClassificacaoItemDto>())
            .Where(c => c.Grupo is not null)
            .Select(c => c.Grupo!.Value)
            .Distinct()
            .OrderBy(g => g);

    // A ordem do grupo é derivada dos próprios critérios, e não da posição gravada,
    // para a tabela já refletir o desempate mesmo antes do próximo recálculo.
    private List<LigaClassificacaoItemDto> OrdenarGrupo(GrupoCopa grupo) =>
        LigaDesempate.Ordenar(
            _classif!.Where(c => c.Grupo == grupo),
            TipoCompetition.Copa,
            c => c.TimeId,
            CopaStats,
            Array.Empty<ConfrontoDireto>(),
            _decisivos);

    // Copa: Pontos → Vitórias → Saldo de Gols. Quem empatar nos três divide a posição
    // e a vaga sai em jogo decisivo — por isso a linha fica azul.
    private static DesempateStats CopaStats(LigaClassificacaoItemDto c) =>
        new(c.Pontos, c.Vitorias, c.SaldoGols, c.GolsPro);

    private static string CopaRowClass(int pos, bool emDecisao) =>
        emDecisao ? "table-primary" : pos <= 2 ? "table-success" : "table-danger";

    private static string CopaBadgeClass(int pos, bool emDecisao) =>
        emDecisao ? "bg-primary" : pos <= 2 ? "bg-success" : "bg-danger";

    private static string StatusLabel(LigaStatus s) => s switch
    {
        LigaStatus.Criada => "Não iniciada",
        LigaStatus.PrimeiraFase => "Fase regular em andamento",
        LigaStatus.PlayIn => "Play-In / Knockout",
        LigaStatus.Playoffs => "Playoffs",
        LigaStatus.DecisaoCampeao => "Decisão de Campeão",
        LigaStatus.MiniLiga => "Mini Liga (desempate)",
        LigaStatus.Encerrada => "Encerrada",
        _ => s.ToString()
    };
}
