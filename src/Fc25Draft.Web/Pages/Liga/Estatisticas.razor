@page "/liga/estatisticas"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Interfaces
@using Fc25Draft.Core.Utilities
@inject ILigaPublicService LigaService

<PageTitle>Estatísticas</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0">Estatísticas</h1>
        @if (_ligas.Count > 1)
        {
            <select class="form-select form-select-sm w-auto" @onchange="OnLigaChanged">
                @foreach (var l in _ligas)
                {
                    <option value="@l.LigaId" selected="@(l.LigaId == _liga?.LigaId)">
                        @l.Nome (@LigaLabels.Competicao(l.Tipo, l.Divisao))
                    </option>
                }
            </select>
        }
    </div>

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    }
    else if (_liga is null)
    {
        <div class="alert alert-info">Nenhuma liga encontrada.</div>
    }
    else
    {
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button class="nav-link @(_tab == "artilheiros" ? "active" : "")" @onclick='() => _tab = "artilheiros"'>Artilheiros</button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_tab == "assistencias" ? "active" : "")" @onclick='() => _tab = "assistencias"'>Assistências</button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_tab == "cartoes" ? "active" : "")" @onclick='() => _tab = "cartoes"'>Cartões</button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_tab == "notas" ? "active" : "")" @onclick='() => _tab = "notas"'>Notas</button>
            </li>
        </ul>

        @if (_tab == "notas")
        {
            var minimo = MinimoDeJogos;
            var lista = _notas.Where(n => _todasAsNotas || n.Jogos >= minimo).ToList();
            <div class="d-flex flex-wrap align-items-center gap-3 mb-2 small text-muted">
                <span>Média das notas do PES nos jogos importados.</span>
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="todasNotas" @bind="_todasAsNotas" />
                    <label class="form-check-label" for="todasNotas">
                        Mostrar todos (sem o mínimo de @minimo jogo@(minimo == 1 ? "" : "s"))
                    </label>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Jogador</th>
                            <th>Pos.</th>
                            <th>Time</th>
                            <th class="text-center">Jogos</th>
                            <th class="text-center">Média</th>
                            <th class="text-center">Melhor nota</th>
                            <th class="text-center" title="Melhor em campo">⭐</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < lista.Count; i++)
                        {
                            var n = lista[i];
                            <tr>
                                <td class="text-muted">@(i + 1)</td>
                                <td class="fw-semibold"><a class="text-decoration-none" href="/players/details/@n.JogadorId">@n.JogadorNome</a></td>
                                <td class="text-muted small">@n.Posicao</td>
                                <td>@n.TimeNome</td>
                                <td class="text-center">@n.Jogos</td>
                                <td class="text-center"><span class="badge @NotaPes.Cor(n.Media)">@NotaPes.Media(n.Media)</span></td>
                                <td class="text-center">@NotaPes.Texto(n.MelhorNota)</td>
                                <td class="text-center">@(n.VezesMelhorEmCampo > 0 ? n.VezesMelhorEmCampo : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (lista.Count == 0)
                {
                    <div class="text-center text-muted py-3">Sem notas do PES nesta competição.</div>
                }
            </div>
        }

        @if (_tab == "artilheiros")
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Jogador</th>
                            <th>Time</th>
                            <th class="text-center">Gols</th>
                            <th class="text-center">Assist.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rankArt = 0; }
                        @foreach (var a in _artilheiros ?? Array.Empty<LigaArtilheiroDto>())
                        {
                            rankArt++;
                            <tr>
                                <td class="text-muted">@rankArt</td>
                                <td class="fw-semibold">@a.JogadorNome</td>
                                <td class="@(a.TimeId == Guid.Empty ? "fst-italic text-muted" : "")">@a.TimeNome</td>
                                <td class="text-center fw-bold">@a.Gols</td>
                                <td class="text-center">@a.Assistencias</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!_artilheiros?.Any() ?? true)
                {
                    <div class="text-center text-muted py-3">Sem gols registrados.</div>
                }
            </div>
        }

        @if (_tab == "assistencias")
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Jogador</th>
                            <th>Time</th>
                            <th class="text-center">Assist.</th>
                            <th class="text-center">Gols</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rankAss = 0; }
                        @foreach (var a in (_artilheiros ?? Array.Empty<LigaArtilheiroDto>()).OrderByDescending(x => x.Assistencias).ThenByDescending(x => x.Gols))
                        {
                            if (a.Assistencias == 0) continue;
                            rankAss++;
                            <tr>
                                <td class="text-muted">@rankAss</td>
                                <td class="fw-semibold">@a.JogadorNome</td>
                                <td class="@(a.TimeId == Guid.Empty ? "fst-italic text-muted" : "")">@a.TimeNome</td>
                                <td class="text-center fw-bold">@a.Assistencias</td>
                                <td class="text-center">@a.Gols</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (rankAss == 0)
                {
                    <div class="text-center text-muted py-3">Sem assistências registradas.</div>
                }
            </div>
        }

        @if (_tab == "cartoes")
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Jogador</th>
                            <th>Time</th>
                            <th class="text-center">🟨 Amarelos</th>
                            <th class="text-center">🟥 Vermelhos</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rankCart = 0; }
                        @foreach (var c in _cartoes ?? Array.Empty<LigaCartaoEstatDto>())
                        {
                            rankCart++;
                            <tr>
                                <td class="text-muted">@rankCart</td>
                                <td class="fw-semibold">@c.JogadorNome</td>
                                <td class="@(c.TimeId == Guid.Empty ? "fst-italic text-muted" : "")">@c.TimeNome</td>
                                <td class="text-center text-warning fw-bold">@c.CartoesAmarelos</td>
                                <td class="text-center text-danger fw-bold">@c.CartoesVermelhos</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!_cartoes?.Any() ?? true)
                {
                    <div class="text-center text-muted py-3">Sem cartões registrados.</div>
                }
            </div>
        }
    }
</div>

@code {
    private LigaDto? _liga;
    private IReadOnlyList<LigaDto> _ligas = Array.Empty<LigaDto>();
    private IReadOnlyList<LigaArtilheiroDto>? _artilheiros;
    private IReadOnlyList<LigaCartaoEstatDto>? _cartoes;
    private IReadOnlyList<NotaMediaJogadorDto> _notas = Array.Empty<NotaMediaJogadorDto>();
    private bool _todasAsNotas;

    /// <summary>Para entrar no ranking: metade dos jogos de quem mais jogou com nota (arredondando para cima).</summary>
    private int MinimoDeJogos => _notas.Count == 0 ? 1 : Math.Max(1, (int)Math.Ceiling(_notas.Max(n => n.Jogos) / 2.0));
    private bool _loading = true;
    private string _tab = "artilheiros";

    protected override async Task OnInitializedAsync()
    {
        _ligas = await LigaService.ListAtivasAsync(CancellationToken.None);
        _liga = await LigaService.GetAtualAsync(CancellationToken.None);
        await CarregarAsync();
        _loading = false;
    }

    private async Task OnLigaChanged(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var id)) return;

        _liga = _ligas.FirstOrDefault(l => l.LigaId == id);
        _loading = true;
        StateHasChanged();
        await CarregarAsync();
        _loading = false;
    }

    private async Task CarregarAsync()
    {
        if (_liga is null) return;
        _artilheiros = await LigaService.GetArtilheirosAsync(_liga.LigaId, CancellationToken.None);
        _cartoes = await LigaService.GetCartoesEstatAsync(_liga.LigaId, CancellationToken.None);
        _notas = await LigaService.GetMediasNotasAsync(_liga.LigaId, CancellationToken.None);
    }
}
