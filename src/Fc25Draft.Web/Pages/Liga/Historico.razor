@page "/liga/historico"
@using Fc25Draft.Web.Utilities
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Interfaces
@implements IDisposable
@inject ILigaPublicService LigaService

<PageTitle>Histórico - Artilheiros</PageTitle>

<div class="container-fluid py-3">
    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    }
    else if (_erro is not null)
    {
        <div class="alert alert-danger"><strong>Erro ao carregar histórico:</strong> @_erro</div>
    }
    else
    {
        <div class="mb-3">
            <h1 class="h3">Histórico de Estatísticas</h1>
            <p class="text-muted">Estatísticas de todas as competições</p>
        </div>

        <div class="row mb-3">
            <div class="col-md-6 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text">🔎</span>
                    @* Input não controlado: sem value="@..." o re-render do Blazor Server não
                       sobrescreve o que o usuário ainda está digitando. O @key recria o elemento
                       (vazio) quando a busca é limpa. *@
                    <input @key="_buscaInputKey" class="form-control" placeholder="Pesquisar jogador pelo nome"
                           @oninput="OnBuscaChanged" />
                    @if (!string.IsNullOrWhiteSpace(_buscaRaw))
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="LimparBusca">✕</button>
                    }
                </div>
            </div>
        </div>

        @if (!_artilheiros.Any())
        {
            <div class="alert alert-info">Nenhum gol registrado no histórico.</div>
        }
        else if (!FilteredItems.Any())
        {
            <div class="alert alert-warning">Nenhum jogador encontrado para "<strong>@_busca</strong>".</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle" style="font-size:0.875rem;">
                    <thead class="table-dark">
                        <tr>
                            <th style="width:40px;">#</th>
                            <th>Jogador</th>
                            <th class="text-center" style="width:90px;cursor:pointer;user-select:none;" @onclick='() => SetSort("gols")'>
                                ⚽ Gols @SortIcon("gols")
                            </th>
                            <th class="text-center" style="width:130px;cursor:pointer;user-select:none;" @onclick='() => SetSort("assistencias")'>
                                🅰️ Assist. @SortIcon("assistencias")
                            </th>
                            <th class="text-center" style="width:90px;cursor:pointer;user-select:none;" @onclick='() => SetSort("ga")'>
                                G/A @SortIcon("ga")
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (item, idx) in PagedItems.Select((x, i) => (x, (_page - 1) * _pageSize + i + 1)))
                        {
                            <tr style="cursor:pointer;height:44px;" @onclick='() => SelecionarJogador(item)'>
                                <td style="width:40px;" class="fw-bold text-muted">@idx</td>
                                <td style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@item.JogadorNome</td>
                                <td class="text-center fw-bold" style="width:90px;">@item.TotalGols</td>
                                <td class="text-center text-muted" style="width:130px;">@(item.TotalAssistencias > 0 ? item.TotalAssistencias.ToString() : "—")</td>
                                <td class="text-center fw-bold" style="width:90px;">@(item.TotalGols + item.TotalAssistencias)</td>
                            </tr>
                            @if (_jogadorSelecionado == item)
                            {
                                <tr>
                                    <td colspan="5" class="p-0 border-0">
                                        <div class="p-3 bg-light border-top border-bottom">
                                            <div class="table-responsive">
                                                <table class="table table-sm table-striped mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Competição</th>
                                                            <th class="text-center" style="width:70px;">⚽</th>
                                                            <th class="text-center" style="width:70px;">Assist.</th>
                                                            <th class="text-center" style="width:70px;">G/A</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var comp in item.Competicoes)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    <span>@comp.NomeCompeticion</span>
                                                                    <br />
                                                                    <small class="text-muted">@(comp.TipoCompeticion == TipoCompetition.Copa ? "Copa" : "Liga")</small>
                                                                </td>
                                                                <td class="text-center fw-bold">@comp.Gols</td>
                                                                <td class="text-center text-muted">@(comp.Assistencias > 0 ? comp.Assistencias.ToString() : "—")</td>
                                                                <td class="text-center fw-bold">@(comp.Gols + comp.Assistencias)</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (_totalPages > 1)
            {
                <nav class="d-flex justify-content-center mt-2">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(_page == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(_page - 1)" disabled="@(_page == 1)">‹</button>
                        </li>
                        @for (int p = 1; p <= _totalPages; p++)
                        {
                            var pg = p;
                            <li class="page-item @(_page == pg ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(pg)">@pg</button>
                            </li>
                        }
                        <li class="page-item @(_page == _totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(_page + 1)" disabled="@(_page == _totalPages)">›</button>
                        </li>
                    </ul>
                </nav>
                <p class="text-center text-muted small mt-1">@_totalFiltrados jogadores · página @_page de @_totalPages</p>
            }
        }
    }
</div>

@code {
    private bool _loading = true;
    private string? _erro;
    private IReadOnlyList<HistoricoArtilheiroDto> _artilheiros = Array.Empty<HistoricoArtilheiroDto>();
    private HistoricoArtilheiroDto? _jogadorSelecionado;

    private string _sortBy = "gols";
    private bool _sortAsc = false;

    // _buscaRaw reflete o texto exatamente como digitado (liga o <input>); _busca só é
    // atualizado após uma pequena pausa (debounce). Isso evita que o round-trip do Blazor
    // Server sobrescreva o campo com um valor desatualizado enquanto o usuário digita rápido.
    private string _busca = string.Empty;
    private string _buscaRaw = string.Empty;
    private int _buscaInputKey;
    private CancellationTokenSource? _buscaDebounceCts;

    // Pagination
    private int _page = 1;
    private const int _pageSize = 20;
    private int _totalFiltrados => FilteredItems.Count();
    private int _totalPages => (int)Math.Ceiling(_totalFiltrados / (double)_pageSize);

    private IEnumerable<HistoricoArtilheiroDto> FilteredItems
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_busca))
                return _artilheiros;

            var termo = TextoBusca.Normalizar(_busca);
            return _artilheiros.Where(x => TextoBusca.Normalizar(x.JogadorNome).Contains(termo));
        }
    }

    private IEnumerable<HistoricoArtilheiroDto> SortedItems => _sortBy switch
    {
        "assistencias" => _sortAsc
            ? FilteredItems.OrderBy(x => x.TotalAssistencias).ThenBy(x => x.TotalGols)
            : FilteredItems.OrderByDescending(x => x.TotalAssistencias).ThenByDescending(x => x.TotalGols),
        "ga" => _sortAsc
            ? FilteredItems.OrderBy(x => x.TotalGols + x.TotalAssistencias).ThenBy(x => x.TotalGols)
            : FilteredItems.OrderByDescending(x => x.TotalGols + x.TotalAssistencias).ThenByDescending(x => x.TotalGols),
        _ => _sortAsc
            ? FilteredItems.OrderBy(x => x.TotalGols).ThenBy(x => x.TotalAssistencias)
            : FilteredItems.OrderByDescending(x => x.TotalGols).ThenByDescending(x => x.TotalAssistencias),
    };

    private IEnumerable<HistoricoArtilheiroDto> PagedItems =>
        SortedItems.Skip((_page - 1) * _pageSize).Take(_pageSize);

    private void SetSort(string col)
    {
        if (_sortBy == col)
            _sortAsc = !_sortAsc;
        else
        {
            _sortBy = col;
            _sortAsc = false;
        }
        _page = 1;
    }

    private void OnBuscaChanged(ChangeEventArgs e)
    {
        _buscaRaw = e.Value?.ToString() ?? string.Empty;

        _buscaDebounceCts?.Cancel();
        _buscaDebounceCts?.Dispose();
        var cts = new CancellationTokenSource();
        _buscaDebounceCts = cts;

        _ = AplicarBuscaComDebounceAsync(cts.Token);
    }

    private async Task AplicarBuscaComDebounceAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(300, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        _busca = _buscaRaw;
        _page = 1;
        _jogadorSelecionado = null;
        await InvokeAsync(StateHasChanged);
    }

    private void LimparBusca()
    {
        _buscaDebounceCts?.Cancel();
        _buscaRaw = string.Empty;
        _busca = string.Empty;
        _buscaInputKey++;
        _page = 1;
        _jogadorSelecionado = null;
    }

    public void Dispose()
    {
        _buscaDebounceCts?.Cancel();
        _buscaDebounceCts?.Dispose();
    }

    private void GoToPage(int p)
    {
        if (p < 1 || p > _totalPages) return;
        _page = p;
        _jogadorSelecionado = null;
    }

    private string SortIcon(string col)
    {
        if (_sortBy != col) return "⇅";
        return _sortAsc ? "↑" : "↓";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _artilheiros = await LigaService.GetHistoricoArtilheirosAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelecionarJogador(HistoricoArtilheiroDto jogador)
    {
        _jogadorSelecionado = _jogadorSelecionado == jogador ? null : jogador;
    }
}
