@page "/liga/historico"
@using Fc25Draft.Core.Utilities
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Interfaces
@using Fc25Draft.Web.Components.Liga
@implements IDisposable
@inject ILigaPublicService LigaService

<PageTitle>Histórico</PageTitle>

<div>
    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    }
    else if (_erro is not null)
    {
        <div class="alert alert-danger"><strong>Erro ao carregar histórico:</strong> @_erro</div>
    }
    else
    {
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <p class="text-body-secondary small mb-0">@(_temporada is int ano ? $"Estatísticas da temporada {ano}" : "Estatísticas de todas as competições")</p>
            @if (_temporadas.Count > 0)
            {
                <select class="form-select form-select-sm w-auto" value="@(_temporada?.ToString() ?? "")" @onchange="TrocarTemporada" disabled="@_carregandoTemporada">
                    <option value="">Todas as temporadas</option>
                    @foreach (var t in _temporadas)
                    {
                        <option value="@t">Temporada @t</option>
                    }
                </select>
            }
        </div>

        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button class="nav-link @(_aba == "artilheiros" ? "active" : "")" @onclick='() => TrocarAba("artilheiros")'>Artilheiros</button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_aba == "goleiros" ? "active" : "")" @onclick='() => TrocarAba("goleiros")'>Goleiros</button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_aba == "duplas" ? "active" : "")" @onclick='() => TrocarAba("duplas")'>Duplas</button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_aba == "carrascos" ? "active" : "")" @onclick='() => TrocarAba("carrascos")'>Carrascos</button>
            </li>
        </ul>

        @if (_aba == "duplas")
        {
            <DuplasDeGol Duplas="_duplas" MostrarCompeticao="true" />
        }
        else if (_aba == "carrascos")
        {
            <CarrascosDeTimes Carrascos="_carrascos" />
        }
        else
        {

        <div class="row mb-3">
            <div class="col-md-6 col-lg-4">
                <div class="campo-busca">
                    <Icone Nome="search" Tamanho="14" Classe="campo-busca-icone" />
                    @* Input não controlado: sem value="@..." o re-render do Blazor Server não
                       sobrescreve o que o usuário ainda está digitando. O @key recria o elemento
                       (vazio) quando a busca é limpa. *@
                    <input @key="_buscaInputKey" class="form-control form-control-sm" placeholder="Jogador"
                           @oninput="OnBuscaChanged" />
                    @if (!string.IsNullOrWhiteSpace(_buscaRaw))
                    {
                        <button type="button" class="campo-busca-limpar" title="Limpar a busca" @onclick="LimparBusca"><Icone Nome="x" Tamanho="14" /></button>
                    }
                </div>
            </div>
        </div>

        @if (_aba == "goleiros")
        {
            var goleiros = GoleirosFiltrados.ToList();
            if (!_goleiros.Any())
            {
                <div class="alert alert-info">Nenhum clean sheet registrado no histórico.</div>
            }
            else if (!goleiros.Any())
            {
                <div class="alert alert-warning">Nenhum goleiro encontrado para "<strong>@_busca</strong>".</div>
            }
            else
            {
                <div class="table-responsive painel mb-3">
                    <table class="table table-hover align-middle mb-0" style="font-size:0.875rem;">
                        <thead class="table-dark">
                            <tr>
                                <th style="width:40px;">#</th>
                                <th>Goleiro</th>
                                <th class="text-center" style="width:70px;" title="Jogos">J</th>
                                <th class="text-center" style="width:130px;">Clean sheets</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (item, idx) in goleiros.Select((x, i) => (x, i + 1)))
                            {
                                <tr style="cursor:pointer;height:44px;" @onclick='() => SelecionarGoleiro(item)'>
                                    <td class="numero text-body-tertiary">@idx</td>
                                    <td style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><FotoJogador PlayerId="@item.JogadorId" Tamanho="28" Classe="me-2" />@item.JogadorNome</td>
                                    <td class="text-center numero text-body-secondary">@JogosTotal(item.Jogos, item.JogosParcial)</td>
                                    <td class="text-center fw-semibold numero">@item.CleanSheets</td>
                                </tr>
                                @if (_goleiroSelecionado == item)
                                {
                                    <tr>
                                        <td colspan="4" class="p-0 border-0">
                                            <div class="historico-detalhe">
                                                <table class="table table-sm mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Competição</th>
                                                            <th class="text-center" style="width:70px;" title="Jogos">J</th>
                                                            <th class="text-center" style="width:110px;">Clean sheets</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var comp in item.Competicoes)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    <span>@comp.NomeCompeticao</span>
                                                                    <br />
                                                                    <small class="text-body-tertiary">@(comp.TipoCompeticao == TipoCompetition.Copa ? "Copa" : "Liga")</small>
                                                                </td>
                                                                <td class="text-center numero">@(comp.Jogos?.ToString() ?? "—")</td>
                                                                <td class="text-center fw-semibold numero">@comp.CleanSheets</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else if (!_artilheiros.Any())
        {
            <div class="alert alert-info">Nenhum gol registrado no histórico.</div>
        }
        else if (!FilteredItems.Any())
        {
            <div class="alert alert-warning">Nenhum jogador encontrado para "<strong>@_busca</strong>".</div>
        }
        else
        {
            <div class="table-responsive painel mb-3">
                <table class="table table-hover align-middle mb-0" style="font-size:0.875rem;">
                    <thead class="table-dark">
                        <tr>
                            <th style="width:40px;">#</th>
                            <th>Jogador</th>
                            <th class="text-center" style="width:70px;">
                                <button type="button" class="ordenar @(_sortBy == "jogos" ? "ativo" : "")" @onclick='() => SetSort("jogos")' title="Jogos">
                                J
                                @if (_sortBy == "jogos")
                                {
                                    <Icone Nome="@(_sortAsc ? "arrow-up" : "arrow-down")" Tamanho="12" />
                                }
                                </button>
                            </th>
                            <th class="text-center" style="width:90px;">
                                <button type="button" class="ordenar @(_sortBy == "gols" ? "ativo" : "")" @onclick='() => SetSort("gols")'>
                                Gols
                                @if (_sortBy == "gols")
                                {
                                    <Icone Nome="@(_sortAsc ? "arrow-up" : "arrow-down")" Tamanho="12" />
                                }
                                </button>
                            </th>
                            <th class="text-center" style="width:130px;">
                                <button type="button" class="ordenar @(_sortBy == "assistencias" ? "ativo" : "")" @onclick='() => SetSort("assistencias")'>
                                Assist.
                                @if (_sortBy == "assistencias")
                                {
                                    <Icone Nome="@(_sortAsc ? "arrow-up" : "arrow-down")" Tamanho="12" />
                                }
                                </button>
                            </th>
                            <th class="text-center" style="width:90px;">
                                <button type="button" class="ordenar @(_sortBy == "ga" ? "ativo" : "")" @onclick='() => SetSort("ga")' title="Gols + assistências">
                                G/A
                                @if (_sortBy == "ga")
                                {
                                    <Icone Nome="@(_sortAsc ? "arrow-up" : "arrow-down")" Tamanho="12" />
                                }
                                </button>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (item, idx) in PagedItems.Select((x, i) => (x, (_page - 1) * _pageSize + i + 1)))
                        {
                            <tr style="cursor:pointer;height:44px;" @onclick='() => SelecionarJogador(item)'>
                                <td style="width:40px;" class="numero text-body-tertiary">@idx</td>
                                <td style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><FotoJogador PlayerId="@item.JogadorId" Tamanho="28" Classe="me-2" />@item.JogadorNome</td>
                                <td class="text-center numero text-body-secondary" style="width:70px;">@JogosTotal(item.TotalJogos, item.JogosParcial)</td>
                                <td class="text-center fw-semibold numero" style="width:90px;">@item.TotalGols</td>
                                <td class="text-center text-body-secondary numero" style="width:130px;">@(item.TotalAssistencias > 0 ? item.TotalAssistencias.ToString() : "—")</td>
                                <td class="text-center numero" style="width:90px;">@(item.TotalGols + item.TotalAssistencias)</td>
                            </tr>
                            @if (_jogadorSelecionado == item)
                            {
                                <tr>
                                    <td colspan="6" class="p-0 border-0">
                                        <div class="historico-detalhe">
                                            <div class="table-responsive">
                                                <table class="table table-sm mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Competição</th>
                                                            <th class="text-center" style="width:70px;" title="Jogos">J</th>
                                                            <th class="text-center" style="width:70px;">Gols</th>
                                                            <th class="text-center" style="width:70px;">Assist.</th>
                                                            <th class="text-center" style="width:70px;">G/A</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var comp in item.Competicoes)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    <span>@comp.NomeCompeticion</span>
                                                                    <br />
                                                                    <small class="text-body-tertiary">@(comp.TipoCompeticion == TipoCompetition.Copa ? "Copa" : "Liga")</small>
                                                                </td>
                                                                <td class="text-center numero">@(comp.Jogos?.ToString() ?? "—")</td>
                                                                <td class="text-center fw-semibold numero">@comp.Gols</td>
                                                                <td class="text-center text-body-secondary numero">@(comp.Assistencias > 0 ? comp.Assistencias.ToString() : "—")</td>
                                                                <td class="text-center numero">@(comp.Gols + comp.Assistencias)</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (_totalPages > 1)
            {
                <nav class="d-flex justify-content-center mt-2">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(_page == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(_page - 1)" disabled="@(_page == 1)" title="Anterior"><Icone Nome="chevron-left" Tamanho="14" /></button>
                        </li>
                        @for (int p = 1; p <= _totalPages; p++)
                        {
                            var pg = p;
                            <li class="page-item @(_page == pg ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(pg)">@pg</button>
                            </li>
                        }
                        <li class="page-item @(_page == _totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(_page + 1)" disabled="@(_page == _totalPages)" title="Próxima"><Icone Nome="chevron-right" Tamanho="14" /></button>
                        </li>
                    </ul>
                </nav>
                <p class="text-center text-body-tertiary small mt-2">@_totalFiltrados jogadores · página @_page de @_totalPages</p>
            }
        }
        }
    }
</div>

@code {
    private bool _loading = true;
    private string? _erro;
    private IReadOnlyList<HistoricoArtilheiroDto> _artilheiros = Array.Empty<HistoricoArtilheiroDto>();
    private HistoricoArtilheiroDto? _jogadorSelecionado;
    private IReadOnlyList<HistoricoGoleiroDto> _goleiros = Array.Empty<HistoricoGoleiroDto>();
    private HistoricoGoleiroDto? _goleiroSelecionado;
    private string _aba = "artilheiros";
    private IReadOnlyList<DuplaDto> _duplas = Array.Empty<DuplaDto>();
    private IReadOnlyList<CarrascoDto> _carrascos = Array.Empty<CarrascoDto>();
    private IReadOnlyList<int> _temporadas = Array.Empty<int>();
    private int? _temporada;
    private bool _carregandoTemporada;

    private string _sortBy = "gols";
    private bool _sortAsc = false;

    // _buscaRaw reflete o texto exatamente como digitado (liga o <input>); _busca só é
    // atualizado após uma pequena pausa (debounce). Isso evita que o round-trip do Blazor
    // Server sobrescreva o campo com um valor desatualizado enquanto o usuário digita rápido.
    private string _busca = string.Empty;
    private string _buscaRaw = string.Empty;
    private int _buscaInputKey;
    private CancellationTokenSource? _buscaDebounceCts;

    // Pagination
    private int _page = 1;
    private const int _pageSize = 20;
    private int _totalFiltrados => FilteredItems.Count();
    private int _totalPages => (int)Math.Ceiling(_totalFiltrados / (double)_pageSize);

    private IEnumerable<HistoricoArtilheiroDto> FilteredItems
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_busca))
                return _artilheiros;

            var termo = TextoBusca.Normalizar(_busca);
            return _artilheiros.Where(x => TextoBusca.Normalizar(x.JogadorNome).Contains(termo));
        }
    }

    private IEnumerable<HistoricoGoleiroDto> GoleirosFiltrados => string.IsNullOrWhiteSpace(_busca)
        ? _goleiros
        : _goleiros.Where(x => TextoBusca.Normalizar(x.JogadorNome).Contains(TextoBusca.Normalizar(_busca)));

    private void TrocarAba(string aba)
    {
        _aba = aba;
        _jogadorSelecionado = null;
        _goleiroSelecionado = null;
    }

    private void SelecionarGoleiro(HistoricoGoleiroDto goleiro)
    {
        _goleiroSelecionado = _goleiroSelecionado == goleiro ? null : goleiro;
    }

    private IEnumerable<HistoricoArtilheiroDto> SortedItems => _sortBy switch
    {
        "assistencias" => _sortAsc
            ? FilteredItems.OrderBy(x => x.TotalAssistencias).ThenBy(x => x.TotalGols)
            : FilteredItems.OrderByDescending(x => x.TotalAssistencias).ThenByDescending(x => x.TotalGols),
        "ga" => _sortAsc
            ? FilteredItems.OrderBy(x => x.TotalGols + x.TotalAssistencias).ThenBy(x => x.TotalGols)
            : FilteredItems.OrderByDescending(x => x.TotalGols + x.TotalAssistencias).ThenByDescending(x => x.TotalGols),
        "jogos" => _sortAsc
            ? FilteredItems.OrderBy(x => x.TotalJogos).ThenBy(x => x.TotalGols)
            : FilteredItems.OrderByDescending(x => x.TotalJogos).ThenByDescending(x => x.TotalGols),
        _ => _sortAsc
            ? FilteredItems.OrderBy(x => x.TotalGols).ThenBy(x => x.TotalAssistencias)
            : FilteredItems.OrderByDescending(x => x.TotalGols).ThenByDescending(x => x.TotalAssistencias),
    };

    /// <summary>Total de jogos; o "+" avisa que falta competição antes do contador sem jogos anotados.</summary>
    private RenderFragment JogosTotal(int jogos, bool parcial) => __builder =>
    {
        if (jogos == 0 && parcial)
        {
            <span title="Jogos de competições antes do contador ainda não anotados">—</span>
            return;
        }
        <span>@jogos</span>
        @if (parcial)
        {
            <span class="text-body-tertiary" title="Faltam jogos de competições antes do contador, ainda não anotados">+</span>
        }
    };

    private IEnumerable<HistoricoArtilheiroDto> PagedItems =>
        SortedItems.Skip((_page - 1) * _pageSize).Take(_pageSize);

    private void SetSort(string col)
    {
        if (_sortBy == col)
            _sortAsc = !_sortAsc;
        else
        {
            _sortBy = col;
            _sortAsc = false;
        }
        _page = 1;
    }

    private void OnBuscaChanged(ChangeEventArgs e)
    {
        _buscaRaw = e.Value?.ToString() ?? string.Empty;

        _buscaDebounceCts?.Cancel();
        _buscaDebounceCts?.Dispose();
        var cts = new CancellationTokenSource();
        _buscaDebounceCts = cts;

        _ = AplicarBuscaComDebounceAsync(cts.Token);
    }

    private async Task AplicarBuscaComDebounceAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(300, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        _busca = _buscaRaw;
        _page = 1;
        _jogadorSelecionado = null;
        await InvokeAsync(StateHasChanged);
    }

    private void LimparBusca()
    {
        _buscaDebounceCts?.Cancel();
        _buscaRaw = string.Empty;
        _busca = string.Empty;
        _buscaInputKey++;
        _page = 1;
        _jogadorSelecionado = null;
    }

    public void Dispose()
    {
        _buscaDebounceCts?.Cancel();
        _buscaDebounceCts?.Dispose();
    }

    private void GoToPage(int p)
    {
        if (p < 1 || p > _totalPages) return;
        _page = p;
        _jogadorSelecionado = null;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _temporadas = await LigaService.GetTemporadasAsync(CancellationToken.None);
            await CarregarAsync();
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CarregarAsync()
    {
        _artilheiros = await LigaService.GetHistoricoArtilheirosAsync(_temporada, CancellationToken.None);
        _goleiros = await LigaService.GetHistoricoGoleirosAsync(_temporada, CancellationToken.None);
        _duplas = await LigaService.GetDuplasAsync(null, _temporada, CancellationToken.None);
        _carrascos = await LigaService.GetCarrascosAsync(_temporada, CancellationToken.None);
    }

    private async Task TrocarTemporada(ChangeEventArgs e)
    {
        _temporada = int.TryParse(e.Value?.ToString(), out var t) ? t : null;
        _page = 1;
        _jogadorSelecionado = null;
        _goleiroSelecionado = null;
        _carregandoTemporada = true;
        try
        {
            await CarregarAsync();
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _carregandoTemporada = false;
        }
    }

    private void SelecionarJogador(HistoricoArtilheiroDto jogador)
    {
        _jogadorSelecionado = _jogadorSelecionado == jogador ? null : jogador;
    }
}
