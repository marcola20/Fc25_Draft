@page "/liga/edicoes"
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Utilities
@inject ILigaPublicService LigaService
@inject EscudoService EscudoService

<PageTitle>Edições</PageTitle>

<div class="container-fluid py-3">
    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    }
    else if (_erro is not null)
    {
        <div class="alert alert-danger"><strong>Erro ao carregar as edições:</strong> @_erro</div>
    }
    else if (_edicoes.Count == 0)
    {
        <div class="alert alert-info">Nenhuma competição cadastrada ainda.</div>
    }
    else
    {
        <div class="d-flex align-items-center gap-3 mb-1 flex-wrap">
            <h1 class="h3 mb-0">Edições</h1>
            <a href="/hall-of-fame" class="btn btn-sm btn-outline-secondary">🏆 Hall of Fame</a>
        </div>
        <p class="text-muted small mb-4">Todas as competições da CBFV, temporada por temporada — cada uma com o formato que teve.</p>

        @if (_emAndamento.Count > 0)
        {
            <h2 class="h5 d-flex align-items-center gap-2 border-bottom pb-2 mb-3">
                <span class="badge bg-success">Em andamento</span>
                <span class="fw-normal">@TemporadaTitulo(_emAndamento)</span>
            </h2>
            <div class="row g-3 mb-4">
                @foreach (var edicao in _emAndamento)
                {
                    <div class="col-12 col-md-6 col-xl-4">@CardEdicao(edicao)</div>
                }
            </div>
        }

        @foreach (var temporada in _encerradas)
        {
            <h2 class="h5 d-flex align-items-center gap-2 border-bottom pb-2 mb-3">
                <span class="badge bg-secondary">Encerrada</span>
                <span class="fw-normal">@(temporada.Key is null ? "Sem temporada" : $"Temporada {temporada.Key}")</span>
            </h2>
            <div class="row g-3 mb-4">
                @foreach (var edicao in temporada)
                {
                    <div class="col-12 col-md-6 col-xl-4">@CardEdicao(edicao)</div>
                }
            </div>
        }
    }
</div>

@code {
    private bool _loading = true;
    private string? _erro;

    private IReadOnlyList<LigaEdicaoDto> _edicoes = Array.Empty<LigaEdicaoDto>();
    private List<LigaEdicaoDto> _emAndamento = new();
    private List<IGrouping<int?, LigaEdicaoDto>> _encerradas = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _edicoes = await LigaService.ListEdicoesAsync(CancellationToken.None);
            _emAndamento = _edicoes.Where(e => !e.Encerrada).ToList();
            _encerradas = _edicoes
                .Where(e => e.Encerrada)
                .GroupBy(e => e.Temporada)
                .OrderByDescending(g => g.Key ?? 0)
                .ToList();
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private RenderFragment CardEdicao(LigaEdicaoDto e) =>
        @<div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <span class="badge bg-dark">@LigaLabels.Competicao(e.Tipo, e.Divisao)</span>
                    <span class="badge @StatusBadge(e.Status)">@LigaLabels.Status(e.Status, e.Tipo)</span>
                </div>

                <h3 class="h6 mb-2">@e.Nome</h3>

                @if (!string.IsNullOrWhiteSpace(e.CampeaoNome))
                {
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <img src="@EscudoService.GetEscudo(e.CampeaoNome)" alt="Escudo @e.CampeaoNome"
                             style="width:32px;height:32px;object-fit:contain;" />
                        <span class="small">🏆 <strong>@e.CampeaoNome</strong></span>
                    </div>
                }
                else if (e.PartidasTotal > 0)
                {
                    <p class="text-muted small mb-2">@e.PartidasJogadas de @e.PartidasTotal jogos disputados</p>
                }

                <div class="d-flex flex-wrap gap-1 mb-3">
                    @foreach (var item in LigaFormatoResumo.Itens(e))
                    {
                        <span class="badge bg-light text-dark border fw-normal">@item</span>
                    }
                </div>

                <a href="@($"/liga?liga={e.LigaId}")" class="btn btn-sm btn-outline-primary mt-auto align-self-start">
                    Ver edição
                </a>
            </div>
        </div>;

    /// <summary>Temporadas presentes no bloco (normalmente uma só).</summary>
    private static string TemporadaTitulo(IReadOnlyList<LigaEdicaoDto> edicoes)
    {
        var temporadas = edicoes.Select(e => e.Temporada).Where(t => t is not null).Distinct().OrderBy(t => t).ToList();
        return temporadas.Count switch
        {
            0 => "",
            1 => $"Temporada {temporadas[0]}",
            _ => $"Temporadas {string.Join(", ", temporadas)}"
        };
    }

    private static string StatusBadge(LigaStatus status) => status switch
    {
        LigaStatus.Encerrada => "bg-secondary",
        LigaStatus.Criada => "bg-light text-dark border",
        _ => "bg-success"
    };
}
