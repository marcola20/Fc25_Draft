@page "/liga/edicoes"
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Utilities
@inject ILigaPublicService LigaService
@inject EscudoService EscudoService

<PageTitle>Edições</PageTitle>

<div>
    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    }
    else if (_erro is not null)
    {
        <div class="alert alert-danger"><strong>Erro ao carregar as edições:</strong> @_erro</div>
    }
    else if (_edicoes.Count == 0)
    {
        <div class="alert alert-info">Nenhuma competição cadastrada ainda.</div>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">
            <p class="text-body-secondary small mb-0">Todas as competições da CBFV, temporada por temporada, cada uma com o formato que teve</p>
            <a href="/hall-of-fame" class="btn btn-sm btn-outline-secondary"><Icone Nome="trophy" Tamanho="14" /> Hall da Fama</a>
        </div>

        @foreach (var temporada in _emAndamento)
        {
            <div class="secao-titulo justify-content-start align-items-center gap-2">
                <h2>@TemporadaTitulo(temporada.Key)</h2>
                <span class="etiqueta sucesso">Em andamento</span>
            </div>
            <div class="row g-3 mb-4">
                @foreach (var edicao in temporada)
                {
                    <div class="col-12 col-md-6 col-xl-4">@CardEdicao(edicao)</div>
                }
            </div>
        }

        @foreach (var temporada in _encerradas)
        {
            <div class="secao-titulo justify-content-start align-items-center gap-2">
                <h2>@TemporadaTitulo(temporada.Key)</h2>
                <span class="etiqueta">Encerrada</span>
            </div>
            <div class="row g-3 mb-4">
                @foreach (var edicao in temporada)
                {
                    <div class="col-12 col-md-6 col-xl-4">@CardEdicao(edicao)</div>
                }
            </div>
        }
    }
</div>

@code {
    private bool _loading = true;
    private string? _erro;

    private IReadOnlyList<LigaEdicaoDto> _edicoes = Array.Empty<LigaEdicaoDto>();
    private List<IGrouping<int?, LigaEdicaoDto>> _emAndamento = new();
    private List<IGrouping<int?, LigaEdicaoDto>> _encerradas = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _edicoes = await LigaService.ListEdicoesAsync(CancellationToken.None);
            _emAndamento = PorTemporada(_edicoes.Where(e => !e.Encerrada));
            _encerradas = PorTemporada(_edicoes.Where(e => e.Encerrada));
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static List<IGrouping<int?, LigaEdicaoDto>> PorTemporada(IEnumerable<LigaEdicaoDto> edicoes) =>
        edicoes.GroupBy(e => e.Temporada).OrderByDescending(g => g.Key ?? 0).ToList();

    // O cartão inteiro é o link da edição. O campeão é o destaque; edição rolando mostra o andamento.
    private RenderFragment CardEdicao(LigaEdicaoDto e) =>
        @<a href="@($"/liga?liga={e.LigaId}")" class="edicao painel">
            <div class="edicao-topo">
                <span class="edicao-competicao">@LigaLabels.Competicao(e.Tipo, e.Divisao)</span>
                <span class="etiqueta @StatusEtiqueta(e.Status)">@LigaLabels.Status(e.Status, e.Tipo)</span>
            </div>

            <h3 class="edicao-nome">@e.Nome</h3>

            @if (!string.IsNullOrWhiteSpace(e.CampeaoNome))
            {
                <div class="edicao-campeao">
                    <img src="@EscudoService.GetEscudo(e.CampeaoNome)" alt="" />
                    <div style="min-width:0">
                        <div class="edicao-rotulo"><Icone Nome="trophy" Tamanho="12" /> Campeão</div>
                        <div class="edicao-campeao-nome">@e.CampeaoNome</div>
                    </div>
                </div>
            }
            else if (e.PartidasTotal > 0)
            {
                <div class="edicao-andamento">
                    <div class="d-flex justify-content-between small">
                        <span class="text-body-secondary">Jogos disputados</span>
                        <span class="numero">@e.PartidasJogadas<span class="text-body-tertiary">/@e.PartidasTotal</span></span>
                    </div>
                    <div class="edicao-barra"><span style="width:@(Pct(e))%"></span></div>
                </div>
            }

            <ul class="edicao-formato">
                @foreach (var item in LigaFormatoResumo.Itens(e))
                {
                    <li>@item</li>
                }
            </ul>

            <span class="edicao-ver">Ver edição <Icone Nome="arrow-right" Tamanho="14" /></span>
        </a>;

    private static int Pct(LigaEdicaoDto e) =>
        e.PartidasTotal <= 0 ? 0 : Math.Clamp(e.PartidasJogadas * 100 / e.PartidasTotal, 0, 100);

    private static string TemporadaTitulo(int? temporada) =>
        temporada is null ? "Sem temporada" : $"Temporada {temporada}";

    private static string StatusEtiqueta(LigaStatus status) => status switch
    {
        LigaStatus.Encerrada or LigaStatus.Criada => "",
        _ => "sucesso"
    };
}
