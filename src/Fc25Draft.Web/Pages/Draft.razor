@page "/draft"
@page "/draft/controle"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Entities
@using Fc25Draft.Web.Components.Common
@using Fc25Draft.Web.Components.Draft
@using Fc25Draft.Web.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@inject DraftStateService DraftStateService
@inject DraftAutoPickService AutoPickService
@inject DraftAvisoTempoEsgotado AvisoTempo
@inject IPositionService PositionService
@inject NavigationManager Navigation
@inject ILogger<Fc25Draft.Web.Pages.Draft> Logger
@inject IJSRuntime JSRuntime
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService
@inject AdminAuthService AdminAuth
@inject ApiClientFactory ApiClientFactory
@implements IAsyncDisposable

<PageHeader Title="Controle do Draft"
            Subtitle="Gerencie o andamento do draft em tempo real."
            Actions="@BuildDraftActions()" />

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert @statusCss alert-dismissible fade show" role="alert" style="white-space: pre-line;">
        @statusMessage
        <button type="button" class="btn-close" aria-label="Fechar" @onclick="() => statusMessage = null"></button>
    </div>
    @if (lastSelection is not null)
    {
        <div class="mb-3">
            <button class="btn btn-success" @onclick="CompartilharWhatsappAsync">Compartilhar no WhatsApp</button>
            @if (!string.IsNullOrEmpty(shareFeedback))
            {
                <span class="ms-2 text-muted">@shareFeedback</span>
            }
        </div>
    }
}

@if (!string.IsNullOrEmpty(connectionError))
{
    <div class="alert alert-warning" role="alert">@connectionError</div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<DraftStateCard IsLoading="@isLoadingState" State="@state" />

<DraftRelogio State="@state" IsAdmin="@AdminAuth.IsAdmin" />

@if (AvisoTempo.Ultimo is { } aviso && DateTime.UtcNow - aviso.Em < TimeSpan.FromHours(3) && !_avisoTempoFechado)
{
    <div class="alert alert-warning alert-dismissible" role="status">
        <div class="fw-semibold mb-1">⏱️ Tempo esgotado: o site escolheu (@BrazilTime.ConvertFromUtc(aviso.Em).ToString("HH:mm"))</div>
        <div style="white-space: pre-line;">@aviso.Selecao.Mensagem</div>
        <button type="button" class="btn btn-success btn-sm mt-2" @onclick="() => CompartilharAsync(aviso.Selecao)">Compartilhar no WhatsApp</button>
        <button type="button" class="btn-close" aria-label="Fechar" @onclick="() => _avisoTempoFechado = true"></button>
    </div>
}

@if (state is { HasDraft: true, DraftCompleted: false })
{
    <p class="small mb-3">
        🤖 Não vai estar online na sua vez? <a href="/draft/automatico" class="text-primary fw-semibold">Configure a escolha automática</a>.
    </p>
}

@if (state is { IsExpansao: true, DraftCompleted: false })
{
    @if (state.AguardandoProtecao)
    {
        <div class="alert alert-warning">
            🛡️ <strong>Draft de expansão:</strong> os times existentes ainda estão definindo os jogadores protegidos.
            As escolhas começam quando o admin encerrar as listas. <a href="/draft/protecao">Montar minha lista de protegidos</a>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            🆕 <strong>Draft de expansão:</strong> os times novos escolhem jogadores não protegidos dos times existentes.
            Quem perde um jogador recebe compensação pelo valor de mercado.
        </div>
    }
}

<DraftPlayerFilters Positions="@positions" IsLoading="@isLoadingPlayers" OnFilterChanged="@OnFilterChangedAsync" />

<DraftPlayerTable Players="@availablePlayers" IsLoading="@isLoadingPlayers" DisableSelection="@DisableSelection" OnPlayerSelected="@OpenModal" />

@if (isModalOpen && selectedPlayer is not null)
{
    <DraftPickModal Player="@selectedPlayer"
                    IsSubmitting="@isSubmittingPick"
                    IsAuthenticated="@AdminAuth.IsAuthenticated"
                    Error="@modalError"
                    TokenInput="@tokenInput"
                    TokenInputChanged="@(v => tokenInput = v)"
                    OnClose="@CloseModal"
                    OnConfirm="@ConfirmPickAsync" />
}

@code {
    private readonly List<Position> positions = new();
    private readonly List<AvailablePlayerDto> availablePlayers = new();
    private DraftStateDto? state;
    private HubConnection? hubConnection;
    private string? statusMessage;
    private string statusCss = "alert-success";
    private string? connectionError;
    private string? errorMessage;
    private bool isLoadingState = true;
    private bool isLoadingPlayers = true;
    private bool isGeneratingDraft;
    private bool authInitialized;
    private bool isModalOpen;
    private AvailablePlayerDto? selectedPlayer;
    private string tokenInput = string.Empty;
    private string? modalError;
    private bool isSubmittingPick;
    private DraftPickSelectionDto? lastSelection;
    private string? shareFeedback;
    private DraftPlayerFilters.PlayerFilterState currentFilter = new(null, new HashSet<short>(), null, null);

    private bool DisableSelection => state is null || !state.HasDraft || state.DraftCompleted || state.CurrentTeamId is null || isSubmittingPick;

    private bool CanGenerateDraft =>
        AdminAuth.IsAdmin &&
        !isGeneratingDraft &&
        !isLoadingState &&
        (state is null || !state.HasDraft || state.DraftCompleted);

    private RenderFragment? BuildDraftActions()
    {
        if (!AdminAuth.IsAdmin)
        {
            return null;
        }

        return builder =>
        {
            var seq = 0;
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "type", "button");
            builder.AddAttribute(seq++, "class", "btn btn-warning");
            builder.AddAttribute(seq++, "disabled", !CanGenerateDraft);
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, GenerateDraftAsync));

            if (isGeneratingDraft)
            {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "spinner-border spinner-border-sm me-2");
                builder.AddAttribute(seq++, "role", "status");
                builder.AddAttribute(seq++, "aria-hidden", "true");
                builder.CloseElement();
                builder.AddContent(seq++, "Gerando...");
            }
            else
            {
                builder.AddContent(seq++, "Gerar novo draft");
            }

            builder.CloseElement();
        };
    }

    private void RefreshDraftHeader()
    {
        LayoutState.SetPage(
            NavigationService.GetPageDefinition("/draft/controle"),
            subtitle: "Gerencie o andamento do draft em tempo real.",
            actions: BuildDraftActions());
    }

    protected override void OnInitialized()
    {
        LayoutState.SetPage(
            NavigationService.GetPageDefinition("/draft/controle"),
            subtitle: "Gerencie o andamento do draft em tempo real.",
            actions: BuildDraftActions());

        AdminAuth.AuthenticationChanged += OnAdminAuthChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPositionsAsync();
        await RefreshAsync();
        RefreshDraftHeader();

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/draft"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On("DraftAtualizado", async () =>
        {
            await InvokeAsync(async () =>
            {
                await RefreshAsync();
                StateHasChanged();
            });
        });

        hubConnection.Reconnected += _ =>
        {
            InvokeAsync(() =>
            {
                connectionError = null;
                StateHasChanged();
                return Task.CompletedTask;
            });
            return Task.CompletedTask;
        };

        // Conecta aqui, logo depois de criar. Antes a conexão só começava no primeiro render, que o Blazor
        // faz enquanto a carga inicial ainda roda: nesse momento ela não existia e a página nunca se conectava.
        try
        {
            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            connectionError = "Não foi possível conectar às atualizações automáticas do draft.";
            Logger.LogError(ex, "Erro ao iniciar conexão com o hub de draft.");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AdminAuth.EnsureInitializedAsync();
            authInitialized = true;
            RefreshDraftHeader();
        }
    }

    private async Task LoadPositionsAsync()
    {
        try
        {
            positions.Clear();
            var items = await PositionService.GetAllAsync();
            positions.AddRange(items);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Logger.LogError(ex, "Erro ao carregar posições.");
        }
    }

    // No Blazor Server a página divide a mesma conexão com o banco. Com o tempo real funcionando, um aviso
    // do draft pode chegar enquanto a página já carrega algo (ex.: logo depois de confirmar uma escolha):
    // as cargas entram numa fila, uma por vez.
    private readonly SemaphoreSlim _umaPorVez = new(1, 1);

    private async Task UmPorVezAsync(Func<Task> acao)
    {
        await _umaPorVez.WaitAsync();
        try
        {
            await acao();
        }
        finally
        {
            _umaPorVez.Release();
        }
    }

    private Task RefreshAsync() => UmPorVezAsync(RefreshSemTravaAsync);

    private Task LoadStateAsync() => UmPorVezAsync(CarregarEstadoAsync);

    private Task LoadPlayersAsync() => UmPorVezAsync(CarregarJogadoresAsync);

    private Task ConfirmPickAsync() => UmPorVezAsync(ConfirmarSemTravaAsync);

    private async Task RefreshSemTravaAsync()
    {
        errorMessage = null;
        await CarregarEstadoAsync();
        await CarregarJogadoresAsync();
    }

    private async Task OnFilterChangedAsync(DraftPlayerFilters.PlayerFilterState filter)
    {
        currentFilter = filter;
        await LoadPlayersAsync();
    }

    private async Task GenerateDraftAsync()
    {
        if (isGeneratingDraft)
        {
            return;
        }

        statusMessage = null;
        statusCss = "alert-success";

        if (!AdminAuth.IsAdmin)
        {
            statusCss = "alert-warning";
            statusMessage = "Entre como administrador para gerar o draft.";
            Logger.LogWarning("LayoutNav:AccessDenied tentativa de geração de draft sem autenticação.");
            return;
        }

        if (isLoadingState)
        {
            await LoadStateAsync();
        }

        if (state?.HasDraft == true && !state.DraftCompleted)
        {
            statusCss = "alert-warning";
            statusMessage = "Não é possível gerar um novo draft enquanto o atual não foi concluído.";
            return;
        }

        string? nameInput;
        var defaultName = $"cbfv Draft - {DateTime.Now:yyyy-MM-dd HH:mm}";

        try
        {
            nameInput = await JSRuntime.InvokeAsync<string?>("prompt", "Informe o nome do draft:", defaultName);
        }
        catch (JSException ex)
        {
            statusCss = "alert-danger";
            statusMessage = $"Não foi possível solicitar o nome do draft: {ex.Message}";
            Logger.LogError(ex, "LayoutNav:Error ao solicitar nome do draft");
            return;
        }

        if (nameInput is null)
        {
            return;
        }

        var draftName = nameInput.Trim();
        if (string.IsNullOrWhiteSpace(draftName))
        {
            statusCss = "alert-warning";
            statusMessage = "Informe um nome válido para o draft.";
            return;
        }

        // Se o próximo draft foi planejado (para as listas da escolha automática), ele já vem preenchido.
        IReadOnlyList<DraftPlanoRodadaDto> plano;
        try
        {
            plano = await AutoPickService.GetPlanoAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Não foi possível carregar o planejamento do próximo draft.");
            plano = Array.Empty<DraftPlanoRodadaDto>();
        }

        string? roundsInput;

        try
        {
            roundsInput = await JSRuntime.InvokeAsync<string?>("prompt", "Quantas rodadas o draft deve ter?", plano.Count > 0 ? plano.Count.ToString() : "19");
        }
        catch (JSException ex)
        {
            statusCss = "alert-danger";
            statusMessage = $"Não foi possível solicitar o número de rodadas: {ex.Message}";
            Logger.LogError(ex, "LayoutNav:Error ao solicitar rodadas do draft");
            return;
        }

        if (string.IsNullOrWhiteSpace(roundsInput))
        {
            return;
        }

        if (!int.TryParse(roundsInput, out var totalRounds))
        {
            statusCss = "alert-warning";
            statusMessage = "Informe um número válido de rodadas.";
            return;
        }

        if (totalRounds is < 1 or > 50)
        {
            statusCss = "alert-warning";
            statusMessage = "O número de rodadas deve estar entre 1 e 50.";
            return;
        }

        string? tempoInput;
        try
        {
            tempoInput = await JSRuntime.InvokeAsync<string?>("prompt",
                "Tempo por escolha, em minutos (ex.: 3 ao vivo, 240 pelo WhatsApp). Deixe vazio para sem limite.", "");
        }
        catch (JSException ex)
        {
            statusCss = "alert-danger";
            statusMessage = $"Não foi possível solicitar o tempo por escolha: {ex.Message}";
            return;
        }

        if (tempoInput is null)
        {
            return;
        }

        int? tempoPorEscolha = null;
        if (!string.IsNullOrWhiteSpace(tempoInput))
        {
            if (!int.TryParse(tempoInput, out var minutos) || minutos <= 0)
            {
                statusCss = "alert-warning";
                statusMessage = "Informe o tempo por escolha em minutos (maior que zero) ou deixe vazio.";
                return;
            }

            tempoPorEscolha = minutos;
        }

        var roundRules = new List<DraftRoundRuleDto>(totalRounds);

        for (var round = 1; round <= totalRounds; round++)
        {
            string? minInput;
            string? maxInput;
            var planejada = plano.FirstOrDefault(r => r.Round == round);

            try
            {
                minInput = await JSRuntime.InvokeAsync<string?>("prompt", $"Informe o overall mínimo para a rodada {round}:", planejada is null ? "" : (planejada.OverallMin ?? 0).ToString());
            }
            catch (JSException ex)
            {
                statusCss = "alert-danger";
                statusMessage = $"Não foi possível solicitar o overall mínimo da rodada {round}: {ex.Message}";
                Logger.LogError(ex, "LayoutNav:Error ao solicitar overall mínimo da rodada {Round}", round);
                return;
            }

            if (minInput is null)
            {
                return;
            }

            if (!int.TryParse(minInput, out var overallMin) || overallMin < 0 || overallMin > 150)
            {
                statusCss = "alert-warning";
                statusMessage = $"Informe um overall mínimo válido (0 a 150) para a rodada {round}.";
                return;
            }

            try
            {
                maxInput = await JSRuntime.InvokeAsync<string?>("prompt", $"Informe o overall máximo para a rodada {round}:", planejada is null ? "" : (planejada.OverallMax ?? 150).ToString());
            }
            catch (JSException ex)
            {
                statusCss = "alert-danger";
                statusMessage = $"Não foi possível solicitar o overall máximo da rodada {round}: {ex.Message}";
                Logger.LogError(ex, "LayoutNav:Error ao solicitar overall máximo da rodada {Round}", round);
                return;
            }

            if (maxInput is null)
            {
                return;
            }

            if (!int.TryParse(maxInput, out var overallMax) || overallMax < 0 || overallMax > 150)
            {
                statusCss = "alert-warning";
                statusMessage = $"Informe um overall máximo válido (0 a 150) para a rodada {round}.";
                return;
            }

            if (overallMin > overallMax)
            {
                statusCss = "alert-warning";
                statusMessage = $"O overall mínimo não pode ser maior que o máximo na rodada {round}.";
                return;
            }

            roundRules.Add(new DraftRoundRuleDto(round, overallMin, overallMax));
        }

        isGeneratingDraft = true;
        RefreshDraftHeader();

        try
        {
            var client = await ApiClientFactory.CreateAsync(includeAdminToken: true);
            var uri = new Uri(new Uri(Navigation.BaseUri), "api/admin/draft/generate");
            var response = await client.PostAsJsonAsync(uri, new GenerateDraftRequestDto(totalRounds, false, roundRules, draftName, tempoPorEscolha));

            if (response.IsSuccessStatusCode)
            {
                DraftStateDto? updatedState = null;
                DraftPickResultDto? escolhasIniciais = null;
                try
                {
                    var resultado = await response.Content.ReadFromJsonAsync<GenerateDraftResultDto>();
                    updatedState = resultado?.State;
                    escolhasIniciais = resultado?.Escolhas;
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "LayoutNav:Error ao interpretar resposta de geração de draft");
                }

                if (updatedState is not null)
                {
                    state = updatedState;
                    statusCss = "alert-success";
                    var responseName = string.IsNullOrWhiteSpace(updatedState.DraftName) ? draftName : updatedState.DraftName;
                    statusMessage = $"{responseName} gerado com {updatedState.TotalRounds} rodadas!";
                }

                // Times com lista para o próximo draft já escolheram: a mensagem vai para o WhatsApp.
                if (escolhasIniciais?.Selection is { } selecao)
                {
                    state = escolhasIniciais.State;
                    lastSelection = selecao;
                    shareFeedback = null;
                    statusMessage += $"\n\n🤖 Escolhas automáticas feitas na abertura:\n{selecao.Mensagem}";
                }
                else
                {
                    statusCss = "alert-success";
                    statusMessage = $"{draftName} gerado com {totalRounds} rodadas!";
                }
            }
            else
            {
                ApiErrorResponse? error = null;
                try
                {
                    error = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "LayoutNav:Error ao ler erro de geração de draft");
                }

                statusCss = "alert-danger";
                statusMessage = error?.Message ?? $"Erro ao gerar o draft: {response.StatusCode}.";
            }
        }
        catch (Exception ex)
        {
            statusCss = "alert-danger";
            statusMessage = $"Erro ao gerar o draft: {ex.Message}";
            Logger.LogError(ex, "LayoutNav:Error inesperado ao gerar draft");
        }
        finally
        {
            isGeneratingDraft = false;
            await RefreshAsync();
            RefreshDraftHeader();
            StateHasChanged();
        }
    }

    private async Task CarregarEstadoAsync()
    {
        isLoadingState = true;
        try
        {
            state = await DraftStateService.GetStateAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Logger.LogError(ex, "Erro ao carregar o estado do draft.");
        }
        finally
        {
            isLoadingState = false;
            RefreshDraftHeader();
        }
    }

    private async Task CarregarJogadoresAsync()
    {
        if (currentFilter.OverallMin.HasValue && currentFilter.OverallMax.HasValue && currentFilter.OverallMin > currentFilter.OverallMax)
        {
            errorMessage = "Overall mínimo não pode ser maior que o máximo.";
            return;
        }

        errorMessage = null;
        isLoadingPlayers = true;
        try
        {
            availablePlayers.Clear();

            var players = await DraftStateService.GetAvailablePlayersAsync(
                currentFilter.PositionIds,
                currentFilter.SearchTerm,
                currentFilter.OverallMin,
                currentFilter.OverallMax);
            availablePlayers.AddRange(players);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Logger.LogError(ex, "Erro ao carregar jogadores disponíveis.");
        }
        finally
        {
            isLoadingPlayers = false;
        }
    }

    private async Task OpenModal(AvailablePlayerDto player)
    {
        selectedPlayer = player;
        tokenInput = await AdminAuth.GetTokenAsync() ?? string.Empty;
        modalError = null;
        isModalOpen = true;
        shareFeedback = null;
        lastSelection = null;
    }

    private void CloseModal()
    {
        isModalOpen = false;
        selectedPlayer = null;
        tokenInput = string.Empty;
        modalError = null;
    }

    private async Task ConfirmarSemTravaAsync()
    {
        if (selectedPlayer is null)
        {
            return;
        }

        modalError = null;
        isSubmittingPick = true;

        try
        {
            var result = await DraftStateService.MakePickAsync(selectedPlayer.PlayerId, tokenInput);
            state = result.State;
            lastSelection = result.Selection;
            shareFeedback = null;
            statusMessage = result.Selection?.Mensagem ?? "✅ Jogador selecionado com sucesso!";
            statusCss = "alert-success";
            await CarregarJogadoresAsync();
            CloseModal();
        }
        catch (InvalidOperationException ex)
        {
            modalError = ex.Message;
            lastSelection = null;
        }
        catch (ArgumentException ex)
        {
            modalError = ex.Message;
            lastSelection = null;
        }
        catch (Exception ex)
        {
            modalError = "Ocorreu um erro ao registrar a escolha.";
            Logger.LogError(ex, "Erro inesperado ao confirmar escolha do draft.");
            lastSelection = null;
        }
        finally
        {
            isSubmittingPick = false;
        }

        if (!string.IsNullOrEmpty(modalError))
        {
            statusMessage = null;
            lastSelection = null;
        }
    }

    private bool _avisoTempoFechado;

    private async Task CompartilharAsync(DraftPickSelectionDto selecao)
    {
        try
        {
            await JSRuntime.InvokeAsync<string>("fc25Share.openWhatsapp", selecao.ShareUrl, selecao.WhatsappGroupLink, selecao.Mensagem);
        }
        catch (JSException ex)
        {
            Logger.LogError(ex, "Erro ao compartilhar no WhatsApp.");
        }
    }

    private async Task CompartilharWhatsappAsync()
    {
        if (lastSelection is null)
        {
            return;
        }

        try
        {
            var outcome = await JSRuntime.InvokeAsync<string>(
                "fc25Share.openWhatsapp",
                lastSelection.ShareUrl,
                lastSelection.WhatsappGroupLink,
                lastSelection.Mensagem);

            shareFeedback = outcome switch
            {
                "share" => "Mensagem aberta no WhatsApp! Envie para concluir.",
                "fallback" => "WhatsApp aberto. Caso a mensagem não apareça automaticamente, cole o texto copiado.",
                _ => "Não foi possível abrir o WhatsApp automaticamente."
            };
        }
        catch (JSException ex)
        {
            shareFeedback = "Não foi possível abrir o WhatsApp automaticamente.";
            Logger.LogError(ex, "Erro ao compartilhar no WhatsApp.");
        }
    }

    private void OnAdminAuthChanged()
    {
        if (!authInitialized)
        {
            return;
        }

        InvokeAsync(async () =>
        {
            await AdminAuth.EnsureInitializedAsync();
            RefreshDraftHeader();
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }

        AdminAuth.AuthenticationChanged -= OnAdminAuthChanged;
    }

    private sealed record ApiErrorResponse(string? Message);
}
