@page "/draft"
@using System.Collections.Generic
@using System.Linq
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Web.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@inject DraftStateService DraftStateService
@inject IPositionService PositionService
@inject NavigationManager Navigation
@inject ILogger<Fc25Draft.Web.Pages.Draft> Logger
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<h3>Draft</h3>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert @statusCss alert-dismissible fade show" role="alert">
        @statusMessage
        <button type="button" class="btn-close" aria-label="Fechar" @onclick="() => statusMessage = null"></button>
    </div>
    @if (lastSelection is not null)
    {
        <div class="mb-3">
            <button class="btn btn-success" @onclick="CompartilharWhatsappAsync">Compartilhar no WhatsApp</button>
            @if (!string.IsNullOrEmpty(shareFeedback))
            {
                <span class="ms-2 text-muted">@shareFeedback</span>
            }
        </div>
    }
}

@if (!string.IsNullOrEmpty(connectionError))
{
    <div class="alert alert-warning" role="alert">@connectionError</div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        @if (isLoadingState)
        {
            <p><em>Carregando estado do draft...</em></p>
        }
        else if (state is null || !state.HasDraft)
        {
            <p class="mb-0">Nenhum draft configurado no momento.</p>
        }
        else if (state.DraftCompleted)
        {
            <h4 class="mb-2">Draft concluído</h4>
            <p class="mb-2">Todas as @state.TotalPicks escolhas foram finalizadas.</p>
            <div class="progress" style="height: 8px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-lg-between gap-2">
                <div>
                    <h4 class="mb-1">Rodada @state.CurrentRound — Escolha @state.CurrentPickInRound</h4>
                    <p class="mb-0 text-muted">Escolha geral @state.CurrentOverallPick de @state.TotalPicks.</p>
                </div>
                <div class="text-lg-end">
                    <p class="mb-0">É a vez do time <strong>@state.CurrentTeamName</strong>@FormatOwner(state.CurrentTeamOwner).</p>
                    @if (!string.IsNullOrEmpty(state.NextTeamName))
                    {
                        <small class="text-muted">Próximo: @state.NextTeamName@FormatOwner(state.NextTeamOwner).</small>
                    }
                </div>
            </div>
            <div class="progress mt-3" style="height: 8px;">
                <div class="progress-bar" role="progressbar" style="width: @GetProgressWidth();" aria-valuenow="@GetProgressValue()" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        }
    </div>
</div>

<div class="row g-3 align-items-end mb-3">
    <div class="col-lg-4">
        <label class="form-label" for="playerSearch">Pesquisar</label>
        <form class="d-flex" @onsubmit="OnSearchAsync" @onsubmit:preventDefault>
            <input id="playerSearch" class="form-control me-2" placeholder="Procurar por nome" @bind="searchTerm" />
            <button type="submit" class="btn btn-primary" disabled="@isLoadingPlayers">Buscar</button>
        </form>
    </div>
    <div class="col-lg-3">
        <label class="form-label" for="draftPositionFilter">Posições</label>
        @if (isPositionDropdownOpen)
        {
            <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1000;" @onclick="ClosePositionDropdown"></div>
        }
        <div class="position-relative" style="z-index: 1010;">
            <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start text-wrap d-flex align-items-center justify-content-between"
                    type="button"
                    id="draftPositionFilter"
                    @onclick="TogglePositionDropdown"
                    @onkeydown="HandlePositionDropdownKeyDown"
                    aria-expanded="@isPositionDropdownOpen">
                <span class="me-2 flex-grow-1">@GetSelectedPositionsLabel()</span>
            </button>
            <div class="dropdown-menu w-100 p-3 shadow-sm @(isPositionDropdownOpen ? "show" : string.Empty)"
                 aria-labelledby="draftPositionFilter"
                 style="@GetPositionDropdownMenuStyles()"
                 @onclick:stopPropagation>
                <div class="form-check mb-2">
                    <input class="form-check-input"
                           type="checkbox"
                           id="draftPositionsAll"
                           checked="@(!selectedPositionIds.Any())"
                           @onchange="OnSelectAllPositionsChanged" />
                    <label class="form-check-label" for="draftPositionsAll">Todas</label>
                </div>
                <div class="dropdown-divider"></div>
                @foreach (var position in positions)
                {
                    var checkboxId = $"draftPosition{position.PositionId}";
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="@checkboxId"
                               checked="@selectedPositionIds.Contains(position.PositionId)"
                               @onchange="args => OnPositionToggled(position.PositionId, args.Value)" />
                        <label class="form-check-label" for="@checkboxId">@position.Name</label>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-3 d-none d-sm-block">
        <label class="form-label d-block">Atualizar</label>
        <button class="btn btn-outline-primary w-50" @onclick="LoadPlayersAsync" disabled="@isLoadingPlayers">Atualizar lista</button>
    </div>
</div>

<div class="row g-3 align-items-end mb-4 draft-filter-group">
    <div class="col-4 col-sm-4 col-md-3 col-lg-2">
        <label class="form-label" for="overallMin">Overall mínimo</label>
        <InputNumber TValue="int?" id="overallMin" class="form-control" min="70" max="99" @bind-Value="overallMin" />
    </div>
    <div class="col-5 col-sm-4 col-md-3 col-lg-2">
        <label class="form-label" for="overallMax">Overall máximo</label>
        <InputNumber TValue="int?" id="overallMax" class="form-control" min="70" max="99" @bind-Value="overallMax" />
    </div>
    <div class="col-3 col-sm-4 col-md-3 col-lg-2 d-flex flex-column justify-content-end gap-2">
        <label class="form-label d-none d-sm-block">&nbsp;</label>
        <button type="button" class="btn btn-outline-primary filter-apply-btn w-100" @onclick="ApplyFiltersAsync" disabled="@isLoadingPlayers">Filtrar</button>
    </div>
</div>

@if (isLoadingPlayers)
{
    <p><em>Carregando jogadores disponíveis...</em></p>
}
else if (availablePlayers.Count == 0)
{
    <p>Nenhum jogador disponível para seleção.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Jogador</th>
                    <th>Posição</th>
                    <th>Overall</th>
                    <th>Idade</th>
                    <th class="text-end">Ação</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var player in availablePlayers)
                {
                    <tr>
                        <td>@player.Name</td>
                        <td>@player.PositionName</td>
                        <td>@player.Overall</td>
                        <td>@(player.Age?.ToString() ?? "-")</td>
                        <td class="text-end">
                            <button class="btn btn-primary" @onclick="() => OpenModal(player)" disabled="@DisableSelection">Escolher</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (isModalOpen && selectedPlayer is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar escolha</h5>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <p>Confirme a escolha do jogador <strong>@selectedPlayer.Name</strong> (@selectedPlayer.PositionName, Overall @selectedPlayer.Overall).</p>
                    <div class="mb-3">
                        <label for="tokenInput" class="form-label">Token do time</label>
                        <input id="tokenInput" type="password" class="form-control" @bind="tokenInput" autocomplete="one-time-code" />
                    </div>
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="alert alert-danger" role="alert">@modalError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal" disabled="@isSubmittingPick">Cancelar</button>
                    <button class="btn btn-success" @onclick="ConfirmPickAsync" disabled="@isSubmittingPick">Confirmar escolha</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<Position> positions = new();
    private readonly List<AvailablePlayerDto> availablePlayers = new();
    private DraftStateDto? state;
    private HubConnection? hubConnection;
    private readonly HashSet<short> selectedPositionIds = new();
    private string? statusMessage;
    private string statusCss = "alert-success";
    private string? connectionError;
    private string? errorMessage;
    private bool isLoadingState = true;
    private bool isLoadingPlayers = true;
    private bool isPositionDropdownOpen;
    private bool isModalOpen;
    private AvailablePlayerDto? selectedPlayer;
    private string tokenInput = string.Empty;
    private string? modalError;
    private bool isSubmittingPick;
    private DraftPickSelectionDto? lastSelection;
    private string? shareFeedback;
    private string searchTerm = string.Empty;
    private int? overallMin;
    private int? overallMax;

    private bool DisableSelection => state is null || !state.HasDraft || state.DraftCompleted || state.CurrentTeamId is null || isSubmittingPick;

    protected override async Task OnInitializedAsync()
    {
        await LoadPositionsAsync();
        await RefreshAsync();

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/draft"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On("DraftAtualizado", async () =>
        {
            await InvokeAsync(async () =>
            {
                await RefreshAsync();
                StateHasChanged();
            });
        });

        hubConnection.Reconnected += _ =>
        {
            InvokeAsync(() =>
            {
                connectionError = null;
                StateHasChanged();
                return Task.CompletedTask;
            });
            return Task.CompletedTask;
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || hubConnection is null)
        {
            return;
        }

        try
        {
            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            connectionError = "Não foi possível conectar às atualizações automáticas do draft.";
            Logger.LogError(ex, "Erro ao iniciar conexão com o hub de draft.");
            StateHasChanged();
        }
    }

    private async Task LoadPositionsAsync()
    {
        try
        {
            positions.Clear();
            var items = await PositionService.GetAllAsync();
            positions.AddRange(items);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Logger.LogError(ex, "Erro ao carregar posições.");
        }
    }

    private async Task RefreshAsync()
    {
        errorMessage = null;
        await LoadStateAsync();
        await LoadPlayersAsync();
    }

    private async Task LoadStateAsync()
    {
        isLoadingState = true;
        try
        {
            state = await DraftStateService.GetStateAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Logger.LogError(ex, "Erro ao carregar o estado do draft.");
        }
        finally
        {
            isLoadingState = false;
        }
    }

    private async Task LoadPlayersAsync()
    {
        if (overallMin.HasValue && overallMax.HasValue && overallMin > overallMax)
        {
            errorMessage = "Overall mínimo não pode ser maior que o máximo.";
            return;
        }

        errorMessage = null;
        isLoadingPlayers = true;
        try
        {
            availablePlayers.Clear();

            var players = await DraftStateService.GetAvailablePlayersAsync(
                selectedPositionIds,
                string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
                overallMin,
                overallMax);
            availablePlayers.AddRange(players);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Logger.LogError(ex, "Erro ao carregar jogadores disponíveis.");
        }
        finally
        {
            isLoadingPlayers = false;
        }
    }

    private async Task OnSearchAsync()
    {
        await LoadPlayersAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        await LoadPlayersAsync();
    }

    private void OpenModal(AvailablePlayerDto player)
    {
        selectedPlayer = player;
        tokenInput = string.Empty;
        modalError = null;
        isModalOpen = true;
        shareFeedback = null;
        lastSelection = null;
    }

    private void CloseModal()
    {
        isModalOpen = false;
        selectedPlayer = null;
        tokenInput = string.Empty;
        modalError = null;
    }

    private async Task ConfirmPickAsync()
    {
        if (selectedPlayer is null)
        {
            return;
        }

        modalError = null;
        isSubmittingPick = true;

        try
        {
            var result = await DraftStateService.MakePickAsync(selectedPlayer.PlayerId, tokenInput);
            state = result.State;
            lastSelection = result.Selection;
            shareFeedback = null;
            statusMessage = result.Selection?.Mensagem ?? "✅ Jogador selecionado com sucesso!";
            statusCss = "alert-success";
            await LoadPlayersAsync();
            CloseModal();
        }
        catch (InvalidOperationException ex)
        {
            modalError = ex.Message;
            lastSelection = null;
        }
        catch (ArgumentException ex)
        {
            modalError = ex.Message;
            lastSelection = null;
        }
        catch (Exception ex)
        {
            modalError = "Ocorreu um erro ao registrar a escolha.";
            Logger.LogError(ex, "Erro inesperado ao confirmar escolha do draft.");
            lastSelection = null;
        }
        finally
        {
            isSubmittingPick = false;
        }

        if (!string.IsNullOrEmpty(modalError))
        {
            statusMessage = null;
            lastSelection = null;
        }
    }

    private async Task CompartilharWhatsappAsync()
    {
        if (lastSelection is null)
        {
            return;
        }

        try
        {
            var outcome = await JSRuntime.InvokeAsync<string>(
                "fc25Share.openWhatsapp",
                lastSelection.ShareUrl,
                lastSelection.WhatsappGroupLink,
                lastSelection.Mensagem);

            shareFeedback = outcome switch
            {
                "share" => "Mensagem aberta no WhatsApp! Envie para concluir.",
                "fallback" => "WhatsApp aberto. Caso a mensagem não apareça automaticamente, cole o texto copiado.",
                _ => "Não foi possível abrir o WhatsApp automaticamente."
            };
        }
        catch (JSException ex)
        {
            shareFeedback = "Não foi possível abrir o WhatsApp automaticamente.";
            Logger.LogError(ex, "Erro ao compartilhar no WhatsApp.");
        }
    }

    private string FormatOwner(string? owner)
        => string.IsNullOrWhiteSpace(owner) ? string.Empty : $" (responsável: {owner})";

    private string GetSelectedPositionsLabel()
    {
        if (selectedPositionIds.Count == 0 || positions.Count == 0)
        {
            return "Todas as posições";
        }

        var names = positions
            .Where(p => selectedPositionIds.Contains(p.PositionId))
            .Select(p => p.Name)
            .ToList();

        return names.Count == 0 ? "Todas as posições" : string.Join(", ", names);
    }

    private string GetPositionDropdownMenuStyles()
    {
        var visibility = isPositionDropdownOpen ? string.Empty : " display: none;";
        return $"max-height: 280px; overflow-y: auto; z-index: 1050;{visibility}";
    }

    private void TogglePositionDropdown()
    {
        isPositionDropdownOpen = !isPositionDropdownOpen;
    }

    private void ClosePositionDropdown()
    {
        if (!isPositionDropdownOpen)
        {
            return;
        }

        isPositionDropdownOpen = false;
    }

    private void HandlePositionDropdownKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            ClosePositionDropdown();
        }
    }

    private async Task OnPositionToggled(short positionId, object? value)
    {
        var isChecked = ParseCheckboxValue(value);
        var changed = isChecked
            ? selectedPositionIds.Add(positionId)
            : selectedPositionIds.Remove(positionId);

        if (changed)
        {
            await ApplyFiltersAsync();
        }
    }

    private async Task OnSelectAllPositionsChanged(ChangeEventArgs args)
    {
        if (!ParseCheckboxValue(args.Value))
        {
            return;
        }

        if (selectedPositionIds.Count == 0)
        {
            return;
        }

        selectedPositionIds.Clear();
        await ApplyFiltersAsync();
    }

    private static bool ParseCheckboxValue(object? value)
    {
        return value switch
        {
            bool boolean => boolean,
            string text when bool.TryParse(text, out var parsed) => parsed,
            _ => false
        };
    }

    private int GetProgressValue()
    {
        if (state is null || state.TotalPicks == 0)
        {
            return 0;
        }

        return (int)Math.Round((double)state.CompletedPicks * 100 / state.TotalPicks);
    }

    private string GetProgressWidth()
        => state is null || state.TotalPicks == 0 ? "0%" : $"{GetProgressValue()}%";

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
