@page "/admin/negociacoes"
@using System.Collections.Generic
@using System.Linq
@using System.Net.Http.Json
@using Fc25Draft.Core.DTOs
@inject AdminAuthService AdminAuth
@inject AdminTransferApiClient TransferApi
@inject TeamsApiClient TeamsApi
@inject ApiClientFactory ApiClientFactory
@inject IJSRuntime JSRuntime

@implements IDisposable

<h3>Negociações Administrativas</h3>

@if (!string.IsNullOrWhiteSpace(globalError))
{
    <div class="alert alert-danger" role="alert">@globalError</div>
}

@if (!string.IsNullOrWhiteSpace(globalSuccess))
{
    <div class="alert alert-success" role="status">@globalSuccess</div>
}

@if (!authInitialized)
{
    <p><em>Carregando informações...</em></p>
}
else
{
    if (!AdminAuth.IsAuthenticated)
    {
        <div class="alert alert-warning" role="alert">
            Informe um token de administrador na página inicial para habilitar as operações.
        </div>
    }

    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button type="button" class="nav-link @(activeTab == "venda" ? "active" : string.Empty)" @onclick="() => SetActiveTab("venda")">Venda</button>
        </li>
        <li class="nav-item" role="presentation">
            <button type="button" class="nav-link @(activeTab == "troca" ? "active" : string.Empty)" @onclick="() => SetActiveTab("troca")">Troca</button>
        </li>
        <li class="nav-item" role="presentation">
            <button type="button" class="nav-link @(activeTab == "move" ? "active" : string.Empty)" @onclick="() => SetActiveTab("move")">Move</button>
        </li>
        <li class="nav-item" role="presentation">
            <button type="button" class="nav-link @(activeTab == "orcamento" ? "active" : string.Empty)" @onclick="() => SetActiveTab("orcamento")">Ajuste de orçamento</button>
        </li>
        <li class="nav-item" role="presentation">
            <button type="button" class="nav-link @(activeTab == "cancelamento" ? "active" : string.Empty)" @onclick="() => SetActiveTab("cancelamento")">Cancelar item</button>
        </li>
        <li class="nav-item" role="presentation">
            <button type="button" class="nav-link @(activeTab == "historico" ? "active" : string.Empty)" @onclick="() => SetActiveTab("historico")">Histórico</button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade @(activeTab == "venda" ? "show active" : string.Empty)">
            @if (AdminAuth.IsAuthenticated)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Venda direta</h5>

                        @if (saleError is not null)
                        {
                            <div class="alert alert-danger" role="alert">@saleError</div>
                        }

                        @if (saleSuccess is not null)
                        {
                            <div class="alert alert-success" role="status">@saleSuccess</div>
                        }

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label" for="saleFrom">Time vendedor</label>
                                <select id="saleFrom" class="form-select" @onchange="async args => { saleFromTeamId = ParseGuid(args.Value?.ToString()); await LoadSalePlayersAsync(); }">
                                    <option value="">@(isLoadingTeams ? "Carregando times..." : "Selecione")</option>
                                    @foreach (var team in teams)
                                    {
                                        <option value="@team.TeamId" selected="@(saleFromTeamId == team.TeamId)">@team.TeamName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="saleTo">Time comprador</label>
                                <select id="saleTo" class="form-select" @onchange="args => saleToTeamId = ParseGuid(args.Value?.ToString())">
                                    <option value="">@(isLoadingTeams ? "Carregando times..." : "Selecione")</option>
                                    @foreach (var team in teams)
                                    {
                                        <option value="@team.TeamId" selected="@(saleToTeamId == team.TeamId)">@team.TeamName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="saleAmount">Valor total (R$)</label>
                                <input id="saleAmount" class="form-control" type="number" step="0.01" min="0" value="@(saleAmount?.ToString("0.00") ?? string.Empty)" @onchange="args => saleAmount = ParseDecimal(args.Value?.ToString())" />
                            </div>
                        </div>

                        @if (salePlayers.Count > 0)
                        {
                            <div class="table-responsive mb-3">
                                <table class="table table-sm table-striped align-middle">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>Jogador</th>
                                            <th>Posição</th>
                                            <th>OVR</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var player in salePlayers)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="checkbox" class="form-check-input" checked="@saleSelectedPlayers.Contains(player.PlayerId)" @onchange="args =>
                                                    {
                                                        if (args.Value is bool selected && selected)
                                                        {
                                                            saleSelectedPlayers.Add(player.PlayerId);
                                                        }
                                                        else
                                                        {
                                                            saleSelectedPlayers.Remove(player.PlayerId);
                                                        }
                                                    }" />
                                                </td>
                                                <td>@player.Nome</td>
                                                <td>@player.Posicao</td>
                                                <td>@player.Overall</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else if (saleFromTeamId.HasValue)
                        {
                            <p>Nenhum jogador disponível para o time selecionado.</p>
                        }

                        <div class="mb-3">
                            <label class="form-label" for="saleReason">Motivo</label>
                            <textarea id="saleReason" class="form-control" rows="3" @onchange="args => saleReason = args.Value?.ToString() ?? string.Empty">@saleReason</textarea>
                        </div>

                        <button class="btn btn-primary" @onclick="ExecuteSaleAsync" disabled="@saleProcessing">@(saleProcessing ? "Processando..." : "Confirmar venda")</button>
                    </div>
                </div>
            }
            else
            {
                <p>Funcionalidade restrita a administradores.</p>
            }
        </div>
        <div class="tab-pane fade @(activeTab == "troca" ? "show active" : string.Empty)">
            @if (AdminAuth.IsAuthenticated)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Troca entre times</h5>

                        @if (swapError is not null)
                        {
                            <div class="alert alert-danger" role="alert">@swapError</div>
                        }

                        @if (swapSuccess is not null)
                        {
                            <div class="alert alert-success" role="status">@swapSuccess</div>
                        }

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="swapTeamA">Time A</label>
                                <select id="swapTeamA" class="form-select" @onchange="async args => { swapTeamAId = ParseGuid(args.Value?.ToString()); await LoadSwapPlayersAsync(true); }">
                                    <option value="">@(isLoadingTeams ? "Carregando times..." : "Selecione")</option>
                                    @foreach (var team in teams)
                                    {
                                        <option value="@team.TeamId" selected="@(swapTeamAId == team.TeamId)">@team.TeamName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="swapTeamB">Time B</label>
                                <select id="swapTeamB" class="form-select" @onchange="async args => { swapTeamBId = ParseGuid(args.Value?.ToString()); await LoadSwapPlayersAsync(false); }">
                                    <option value="">@(isLoadingTeams ? "Carregando times..." : "Selecione")</option>
                                    @foreach (var team in teams)
                                    {
                                        <option value="@team.TeamId" selected="@(swapTeamBId == team.TeamId)">@team.TeamName</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <h6>Jogadores do time A</h6>
                                <div class="list-group list-group-flush border">
                                    @if (swapTeamAPlayers.Count == 0 && swapTeamAId.HasValue)
                                    {
                                        <div class="list-group-item">Nenhum jogador encontrado.</div>
                                    }
                                    @foreach (var player in swapTeamAPlayers)
                                    {
                                        <label class="list-group-item list-group-item-action d-flex align-items-center gap-2">
                                            <input type="checkbox" class="form-check-input" checked="@swapPlayersA.Contains(player.PlayerId)" @onchange="args =>
                                            {
                                                if (args.Value is bool selected && selected)
                                                {
                                                    swapPlayersA.Add(player.PlayerId);
                                                }
                                                else
                                                {
                                                    swapPlayersA.Remove(player.PlayerId);
                                                }
                                            }" />
                                            @FormatPlayerDisplay(player)
                                        </label>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6>Jogadores do time B</h6>
                                <div class="list-group list-group-flush border">
                                    @if (swapTeamBPlayers.Count == 0 && swapTeamBId.HasValue)
                                    {
                                        <div class="list-group-item">Nenhum jogador encontrado.</div>
                                    }
                                    @foreach (var player in swapTeamBPlayers)
                                    {
                                        <label class="list-group-item list-group-item-action d-flex align-items-center gap-2">
                                            <input type="checkbox" class="form-check-input" checked="@swapPlayersB.Contains(player.PlayerId)" @onchange="args =>
                                            {
                                                if (args.Value is bool selected && selected)
                                                {
                                                    swapPlayersB.Add(player.PlayerId);
                                                }
                                                else
                                                {
                                                    swapPlayersB.Remove(player.PlayerId);
                                                }
                                            }" />
                                            @FormatPlayerDisplay(player)
                                        </label>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="swapCash">Ajuste financeiro (A → B)</label>
                                <input id="swapCash" class="form-control" type="number" step="0.01" value="@(swapCashAdjust?.ToString("0.00") ?? "0.00")" @onchange="args => swapCashAdjust = ParseDecimal(args.Value?.ToString()) ?? 0m" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="swapReason">Motivo</label>
                            <textarea id="swapReason" class="form-control" rows="3" @onchange="args => swapReason = args.Value?.ToString() ?? string.Empty">@swapReason</textarea>
                        </div>

                        <button class="btn btn-primary" @onclick="ExecuteSwapAsync" disabled="@swapProcessing">@(swapProcessing ? "Processando..." : "Confirmar troca")</button>
                    </div>
                </div>
            }
            else
            {
                <p>Funcionalidade restrita a administradores.</p>
            }
        </div>
        <div class="tab-pane fade @(activeTab == "move" ? "show active" : string.Empty)">
            @if (AdminAuth.IsAuthenticated)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Move administrativo</h5>

                        @if (moveError is not null)
                        {
                            <div class="alert alert-danger" role="alert">@moveError</div>
                        }

                        @if (moveSuccess is not null)
                        {
                            <div class="alert alert-success" role="status">@moveSuccess</div>
                        }

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="moveFrom">Time atual</label>
                                <select id="moveFrom" class="form-select" @onchange="async args => { moveSourceTeamId = ParseGuid(args.Value?.ToString()); await LoadMovePlayersAsync(); }">
                                    <option value="">@(isLoadingTeams ? "Carregando times..." : "Selecione")</option>
                                    @foreach (var team in teams)
                                    {
                                        <option value="@team.TeamId" selected="@(moveSourceTeamId == team.TeamId)">@team.TeamName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="moveTo">Time destino</label>
                                <select id="moveTo" class="form-select" @onchange="args => moveDestinationTeamId = ParseGuid(args.Value?.ToString())">
                                    <option value="">@(isLoadingTeams ? "Carregando times..." : "Selecione")</option>
                                    @foreach (var team in teams)
                                    {
                                        <option value="@team.TeamId" selected="@(moveDestinationTeamId == team.TeamId)">@team.TeamName</option>
                                    }
                                </select>
                            </div>
                        </div>

                        @if (movePlayers.Count > 0)
                        {
                            <div class="mb-3">
                                <label class="form-label" for="movePlayer">Jogador</label>
                                <select id="movePlayer" class="form-select" @onchange="args => movePlayerId = ParseGuid(args.Value?.ToString())">
                                    <option value="">Selecione</option>
                                    @foreach (var player in movePlayers)
                                    {
                                        <option value="@player.PlayerId" selected="@(movePlayerId == player.PlayerId)">@FormatPlayerDisplay(player)</option>
                                    }
                                </select>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label" for="moveReason">Motivo</label>
                            <textarea id="moveReason" class="form-control" rows="3" @onchange="args => moveReason = args.Value?.ToString() ?? string.Empty">@moveReason</textarea>
                        </div>

                        <button class="btn btn-primary" @onclick="ExecuteMoveAsync" disabled="@moveProcessing">@(moveProcessing ? "Processando..." : "Confirmar move")</button>
                    </div>
                </div>
            }
            else
            {
                <p>Funcionalidade restrita a administradores.</p>
            }
        </div>
        <div class="tab-pane fade @(activeTab == "orcamento" ? "show active" : string.Empty)">
            @if (AdminAuth.IsAuthenticated)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Ajuste de orçamento</h5>

                        @if (budgetError is not null)
                        {
                            <div class="alert alert-danger" role="alert">@budgetError</div>
                        }

                        @if (budgetSuccess is not null)
                        {
                            <div class="alert alert-success" role="status">@budgetSuccess</div>
                        }

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="budgetTeam">Time</label>
                                <select id="budgetTeam" class="form-select" @onchange="args => budgetTeamId = ParseGuid(args.Value?.ToString())">
                                    <option value="">@(isLoadingTeams ? "Carregando times..." : "Selecione")</option>
                                    @foreach (var team in teams)
                                    {
                                        <option value="@team.TeamId" selected="@(budgetTeamId == team.TeamId)">@team.TeamName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="budgetValue">Valor (positivo crédito / negativo débito)</label>
                                <input id="budgetValue" class="form-control" type="number" step="0.01" value="@(budgetDelta?.ToString("0.00") ?? string.Empty)" @onchange="args => budgetDelta = ParseDecimal(args.Value?.ToString())" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="budgetReason">Motivo</label>
                            <textarea id="budgetReason" class="form-control" rows="3" @onchange="args => budgetReason = args.Value?.ToString() ?? string.Empty">@budgetReason</textarea>
                        </div>

                        <button class="btn btn-primary" @onclick="ExecuteBudgetAsync" disabled="@budgetProcessing">@(budgetProcessing ? "Processando..." : "Aplicar ajuste")</button>
                    </div>
                </div>
            }
            else
            {
                <p>Funcionalidade restrita a administradores.</p>
            }
        </div>
        <div class="tab-pane fade @(activeTab == "cancelamento" ? "show active" : string.Empty)">
            @if (AdminAuth.IsAuthenticated)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Cancelar item de mercado</h5>

                        @if (cancelError is not null)
                        {
                            <div class="alert alert-danger" role="alert">@cancelError</div>
                        }

                        @if (cancelSuccess is not null)
                        {
                            <div class="alert alert-success" role="status">@cancelSuccess</div>
                        }

                        <div class="mb-3">
                            <label class="form-label" for="cancelReason">Motivo</label>
                            <textarea id="cancelReason" class="form-control" rows="3" @onchange="args => cancelReason = args.Value?.ToString() ?? string.Empty">@cancelReason</textarea>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm table-striped align-middle">
                                <thead>
                                    <tr>
                                        <th>Jogador</th>
                                        <th>Posição</th>
                                        <th>OVR</th>
                                        <th>Expira em</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (cancellableItems.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="5">Nenhum item cancelável no momento.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in cancellableItems)
                                        {
                                            <tr>
                                                <td>@item.PlayerName</td>
                                                <td>@item.Position</td>
                                                <td>@item.Ovr</td>
                                                <td>@item.ExpiresAtUtc.ToLocalTime().ToString("g")</td>
                                                <td>
                                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => ExecuteCancelAsync(item.ItemId)" disabled="@cancelProcessing">Cancelar</button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p>Funcionalidade restrita a administradores.</p>
            }
        </div>
        <div class="tab-pane fade @(activeTab == "historico" ? "show active" : string.Empty)">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Histórico de transferências</h5>

                    <div class="row g-3 align-items-end mb-3">
                        <div class="col-md-3">
                            <label class="form-label" for="histTeam">Time</label>
                            <select id="histTeam" class="form-select" @onchange="args => historyFilter = historyFilter with { TeamId = ParseGuid(args.Value?.ToString()) }">
                                <option value="">Todos</option>
                                @foreach (var team in teams)
                                {
                                    <option value="@team.TeamId" selected="@(historyFilter.TeamId == team.TeamId)">@team.TeamName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="histPlayer">Jogador (GUID)</label>
                            <input id="histPlayer" class="form-control" type="text" value="@(historyFilter.PlayerId?.ToString() ?? string.Empty)" @onchange="args => historyFilter = historyFilter with { PlayerId = ParseGuid(args.Value?.ToString()) }" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label" for="histType">Tipo</label>
                            <select id="histType" class="form-select" @onchange="args => historyFilter = historyFilter with { Type = ParseInt(args.Value?.ToString()) }">
                                <option value="">Todos</option>
                                @foreach (var option in GetTransferTypeOptions())
                                {
                                    <option value="@option.Key" selected="@(historyFilter.Type == option.Key)">@option.Value</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label" for="histFrom">De (UTC)</label>
                            <input id="histFrom" class="form-control" type="datetime-local" value="@(historyFilter.FromUtc?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm") ?? string.Empty)" @onchange="args => historyFilter = historyFilter with { FromUtc = ParseDate(args.Value?.ToString()) }" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label" for="histTo">Até (UTC)</label>
                            <input id="histTo" class="form-control" type="datetime-local" value="@(historyFilter.ToUtc?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm") ?? string.Empty)" @onchange="args => historyFilter = historyFilter with { ToUtc = ParseDate(args.Value?.ToString()) }" />
                        </div>
                        <div class="col-md-1 d-grid">
                            <button class="btn btn-primary" @onclick="async () => await LoadHistoryAsync()">Filtrar</button>
                        </div>
                    </div>

                    @if (historyError is not null)
                    {
                        <div class="alert alert-danger" role="alert">@historyError</div>
                    }
                    else if (historyLoading)
                    {
                        <p><em>Carregando histórico...</em></p>
                    }
                    else if (historyResult is null || historyResult.Items.Count == 0)
                    {
                        <p>Nenhum registro encontrado.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-striped align-middle">
                                <thead>
                                    <tr>
                                        <th>Data</th>
                                        <th>Tipo</th>
                                        <th>Jogador</th>
                                        <th>Origem</th>
                                        <th>Destino</th>
                                        <th>Valor</th>
                                        <th>Observações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in historyResult.Items)
                                    {
                                        <tr>
                                            <td>@item.PerformedAtUtc.ToLocalTime().ToString("g")</td>
                                            <td>@FormatHistoryType(item.Type)</td>
                                            <td><span title="@item.PlayerId">@item.PlayerId.ToString()[..8]</span> - @item.PlayerName</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.FromTeamName) ? "-" : item.FromTeamName)</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.ToTeamName) ? "-" : item.ToTeamName)</td>
                                            <td>@(item.Amount.HasValue ? $"R$ {item.Amount.Value:0,0.00}" : "-")</td>
                                            <td>
                                                <div><strong>Notas:</strong> @(string.IsNullOrWhiteSpace(item.Notes) ? "-" : item.Notes)</div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        var totalPages = (int)Math.Ceiling(historyResult.Total / (double)historyFilter.PageSize);
                        if (totalPages > 1)
                        {
                            <nav aria-label="Paginação do histórico">
                                <ul class="pagination pagination-sm">
                                    @for (var page = 1; page <= totalPages; page++)
                                    {
                                        <li class="page-item @(historyFilter.Page == page ? "active" : string.Empty)">
                                            <button type="button" class="page-link" @onclick="async () => await LoadHistoryAsync(page)">@page</button>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<TeamListItemDto> teams = new();
    private readonly Dictionary<Guid, TeamRosterDto> rosterCache = new();
    private readonly List<MarketItemDto> cancellableItems = new();

    private bool authInitialized;
    private bool isLoadingTeams = true;
    private string activeTab = "venda";
    private string? globalError;
    private string? globalSuccess;

    private Guid? saleFromTeamId;
    private Guid? saleToTeamId;
    private readonly HashSet<Guid> saleSelectedPlayers = new();
    private readonly List<TeamRosterPlayerDto> salePlayers = new();
    private decimal? saleAmount;
    private string saleReason = string.Empty;
    private bool saleProcessing;
    private string? saleError;
    private string? saleSuccess;

    private Guid? swapTeamAId;
    private Guid? swapTeamBId;
    private readonly HashSet<Guid> swapPlayersA = new();
    private readonly HashSet<Guid> swapPlayersB = new();
    private readonly List<TeamRosterPlayerDto> swapTeamAPlayers = new();
    private readonly List<TeamRosterPlayerDto> swapTeamBPlayers = new();
    private decimal? swapCashAdjust;
    private string swapReason = string.Empty;
    private bool swapProcessing;
    private string? swapError;
    private string? swapSuccess;

    private Guid? moveSourceTeamId;
    private Guid? moveDestinationTeamId;
    private readonly List<TeamRosterPlayerDto> movePlayers = new();
    private Guid? movePlayerId;
    private string moveReason = string.Empty;
    private bool moveProcessing;
    private string? moveError;
    private string? moveSuccess;

    private Guid? budgetTeamId;
    private decimal? budgetDelta;
    private string budgetReason = string.Empty;
    private bool budgetProcessing;
    private string? budgetError;
    private string? budgetSuccess;

    private bool cancelProcessing;
    private string? cancelError;
    private string? cancelSuccess;
    private string cancelReason = string.Empty;

    private TransfersFilter historyFilter = new(null, null, null, null, null);
    private PagedResult<TransferHistoryDto>? historyResult;
    private bool historyLoading;
    private string? historyError;

    protected override async Task OnInitializedAsync()
    {
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
        await LoadTeamsAsync();
        authInitialized = true;
        if (AdminAuth.IsAuthenticated)
        {
            await LoadCancellableItemsAsync();
        }
        await LoadHistoryAsync();
    }

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
    }

    private async void OnAuthenticationChanged(object? sender, bool isAuthenticated)
    {
        if (isAuthenticated)
        {
            await LoadTeamsAsync();
            await LoadCancellableItemsAsync();
            StateHasChanged();
        }
    }

    private async Task LoadTeamsAsync()
    {
        isLoadingTeams = true;
        globalError = null;
        try
        {
            var result = await TeamsApi.GetAsync(null, 1, 200, CancellationToken.None);
            teams.Clear();
            teams.AddRange(result.Items.OrderBy(t => t.TeamName));
        }
        catch (Exception ex)
        {
            globalError = $"Falha ao carregar equipes: {ex.Message}";
        }
        finally
        {
            isLoadingTeams = false;
        }
    }

    private async Task<TeamRosterDto?> GetRosterAsync(Guid teamId)
    {
        if (rosterCache.TryGetValue(teamId, out var cached))
        {
            return cached;
        }

        try
        {
            var roster = await TeamsApi.GetRosterByIdAsync(teamId);
            if (roster is not null)
            {
                rosterCache[teamId] = roster;
            }

            return roster;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.warn", ex.Message);
            return null;
        }
    }

    private void InvalidateRoster(Guid? teamId)
    {
        if (teamId.HasValue)
        {
            rosterCache.Remove(teamId.Value);
        }
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        if (tab == "historico" && historyResult is null && !historyLoading)
        {
            _ = LoadHistoryAsync();
        }

        if (tab == "cancelamento" && cancellableItems.Count == 0 && !cancelProcessing)
        {
            _ = LoadCancellableItemsAsync();
        }
    }

    private static Guid? ParseGuid(string? value)
        => Guid.TryParse(value, out var guid) ? guid : null;

    private static decimal? ParseDecimal(string? value)
        => decimal.TryParse(value, out var dec) ? dec : null;

    private static int? ParseInt(string? value)
        => int.TryParse(value, out var number) ? number : null;

    private static DateTime? ParseDate(string? value)
        => DateTime.TryParse(value, out var date) ? DateTime.SpecifyKind(date, DateTimeKind.Local).ToUniversalTime() : null;

    private static string FormatPlayerDisplay(TeamRosterPlayerDto player)
        => $"#{player.LegacyNumber} - {player.Nome} ({player.Posicao}) OVR {player.Overall}";

    private static string FormatHistoryType(int type) => type switch
    {
        0 => "Leilão",
        1 => "Compra imediata",
        2 => "Venda",
        3 => "Troca",
        4 => "Move adm",
        _ => $"Tipo {type}"
    };

    private IEnumerable<KeyValuePair<int, string>> GetTransferTypeOptions() => new Dictionary<int, string>
    {
        [0] = "Leilão",
        [1] = "Compra imediata",
        [2] = "Venda",
        [3] = "Troca",
        [4] = "Move adm"
    };

    private async Task LoadSalePlayersAsync()
    {
        salePlayers.Clear();
        saleSelectedPlayers.Clear();
        if (saleFromTeamId is null)
        {
            return;
        }

        var roster = await GetRosterAsync(saleFromTeamId.Value);
        if (roster?.Jogadores is not null)
        {
            salePlayers.AddRange(roster.Jogadores.OrderBy(p => p.Nome));
        }
    }

    private async Task LoadSwapPlayersAsync(bool forTeamA)
    {
        if (forTeamA)
        {
            swapTeamAPlayers.Clear();
            swapPlayersA.Clear();
            if (swapTeamAId is null)
            {
                return;
            }

            var roster = await GetRosterAsync(swapTeamAId.Value);
            if (roster?.Jogadores is not null)
            {
                swapTeamAPlayers.AddRange(roster.Jogadores.OrderBy(p => p.Nome));
            }
        }
        else
        {
            swapTeamBPlayers.Clear();
            swapPlayersB.Clear();
            if (swapTeamBId is null)
            {
                return;
            }

            var roster = await GetRosterAsync(swapTeamBId.Value);
            if (roster?.Jogadores is not null)
            {
                swapTeamBPlayers.AddRange(roster.Jogadores.OrderBy(p => p.Nome));
            }
        }
    }

    private async Task LoadMovePlayersAsync()
    {
        movePlayers.Clear();
        movePlayerId = null;
        if (moveSourceTeamId is null)
        {
            return;
        }

        var roster = await GetRosterAsync(moveSourceTeamId.Value);
        if (roster?.Jogadores is not null)
        {
            movePlayers.AddRange(roster.Jogadores.OrderBy(p => p.Nome));
        }
    }

    private async Task ExecuteSaleAsync()
    {
        saleError = null;
        saleSuccess = null;

        if (!saleFromTeamId.HasValue || !saleToTeamId.HasValue)
        {
            saleError = "Selecione os times de origem e destino.";
            return;
        }

        if (saleFromTeamId == saleToTeamId)
        {
            saleError = "Origem e destino devem ser diferentes.";
            return;
        }

        if (saleSelectedPlayers.Count == 0)
        {
            saleError = "Escolha ao menos um jogador.";
            return;
        }

        if (!saleAmount.HasValue || saleAmount.Value < 0)
        {
            saleError = "Informe um valor válido.";
            return;
        }

        if (string.IsNullOrWhiteSpace(saleReason))
        {
            saleError = "Informe o motivo da operação.";
            return;
        }

        saleProcessing = true;
        try
        {
            var request = new AdminTransferApiClient.AdminSellRequest(
                saleFromTeamId.Value,
                saleToTeamId.Value,
                saleSelectedPlayers.ToArray(),
                decimal.Round(saleAmount.Value, 2),
                saleReason.Trim());

            var result = await TransferApi.SellAsync(request);
            saleSuccess = result.Message;
            saleSelectedPlayers.Clear();
            saleAmount = null;
            saleReason = string.Empty;
            InvalidateRoster(saleFromTeamId);
            InvalidateRoster(saleToTeamId);
            await LoadSalePlayersAsync();
        }
        catch (Exception ex)
        {
            saleError = ex.Message;
        }
        finally
        {
            saleProcessing = false;
        }
    }

    private async Task ExecuteSwapAsync()
    {
        swapError = null;
        swapSuccess = null;

        if (!swapTeamAId.HasValue || !swapTeamBId.HasValue)
        {
            swapError = "Selecione os dois times.";
            return;
        }

        if (swapTeamAId == swapTeamBId)
        {
            swapError = "Os times precisam ser diferentes.";
            return;
        }

        if (swapPlayersA.Count == 0 || swapPlayersB.Count == 0)
        {
            swapError = "Selecione os jogadores de cada equipe.";
            return;
        }

        if (string.IsNullOrWhiteSpace(swapReason))
        {
            swapError = "Informe o motivo da operação.";
            return;
        }

        swapProcessing = true;
        try
        {
            var request = new AdminTransferApiClient.AdminSwapRequest(
                swapTeamAId.Value,
                swapPlayersA.ToArray(),
                swapTeamBId.Value,
                swapPlayersB.ToArray(),
                decimal.Round(swapCashAdjust ?? 0m, 2),
                swapReason.Trim());

            var result = await TransferApi.SwapAsync(request);
            swapSuccess = result.Message;
            swapPlayersA.Clear();
            swapPlayersB.Clear();
            swapCashAdjust = 0m;
            swapReason = string.Empty;
            InvalidateRoster(swapTeamAId);
            InvalidateRoster(swapTeamBId);
            await LoadSwapPlayersAsync(true);
            await LoadSwapPlayersAsync(false);
        }
        catch (Exception ex)
        {
            swapError = ex.Message;
        }
        finally
        {
            swapProcessing = false;
        }
    }

    private async Task ExecuteMoveAsync()
    {
        moveError = null;
        moveSuccess = null;

        if (!movePlayerId.HasValue)
        {
            moveError = "Selecione o jogador.";
            return;
        }

        if (!moveDestinationTeamId.HasValue)
        {
            moveError = "Selecione o time de destino.";
            return;
        }

        if (string.IsNullOrWhiteSpace(moveReason))
        {
            moveError = "Informe o motivo da operação.";
            return;
        }

        moveProcessing = true;
        try
        {
            var request = new AdminTransferApiClient.AdminMoveRequest(movePlayerId.Value, moveDestinationTeamId.Value, moveReason.Trim());
            var result = await TransferApi.MoveAsync(request);
            moveSuccess = result.Message;
            var origem = moveSourceTeamId;
            var destino = moveDestinationTeamId;
            moveSourceTeamId = null;
            moveDestinationTeamId = null;
            movePlayerId = null;
            moveReason = string.Empty;
            movePlayers.Clear();
            InvalidateRoster(origem);
            InvalidateRoster(destino);
        }
        catch (Exception ex)
        {
            moveError = ex.Message;
        }
        finally
        {
            moveProcessing = false;
        }
    }

    private async Task ExecuteBudgetAsync()
    {
        budgetError = null;
        budgetSuccess = null;

        if (!budgetTeamId.HasValue)
        {
            budgetError = "Selecione um time.";
            return;
        }

        if (!budgetDelta.HasValue || budgetDelta.Value == 0m)
        {
            budgetError = "Informe um valor diferente de zero.";
            return;
        }

        if (string.IsNullOrWhiteSpace(budgetReason))
        {
            budgetError = "Informe o motivo do ajuste.";
            return;
        }

        budgetProcessing = true;
        try
        {
            var request = new AdminTransferApiClient.AdminAdjustBudgetRequest(
                budgetTeamId.Value,
                decimal.Round(budgetDelta.Value, 2),
                budgetReason.Trim());

            var result = await TransferApi.AdjustBudgetAsync(request);
            budgetSuccess = $"{result.Message} Novo saldo: R$ {result.NewBudget:0,0.00}";
            budgetDelta = null;
            budgetReason = string.Empty;
        }
        catch (Exception ex)
        {
            budgetError = ex.Message;
        }
        finally
        {
            budgetProcessing = false;
        }
    }

    private async Task LoadCancellableItemsAsync()
    {
        cancelError = null;
        cancellableItems.Clear();
        try
        {
            var client = await ApiClientFactory.CreateAsync();
            var response = await client.GetAsync("api/market");
            response.EnsureSuccessStatusCode();
            var items = await response.Content.ReadFromJsonAsync<List<MarketItemDto>>();
            if (items is not null)
            {
                cancellableItems.AddRange(items
                    .Where(i => string.Equals(i.Status, "Ativo", StringComparison.OrdinalIgnoreCase) && i.CurrentLeaderTeamId is null)
                    .OrderBy(i => i.ExpiresAtUtc));
            }
        }
        catch (Exception ex)
        {
            cancelError = $"Falha ao carregar itens do mercado: {ex.Message}";
        }
    }

    private async Task ExecuteCancelAsync(Guid itemId)
    {
        cancelError = null;
        cancelSuccess = null;

        if (string.IsNullOrWhiteSpace(cancelReason))
        {
            cancelError = "Informe o motivo do cancelamento.";
            return;
        }

        cancelProcessing = true;
        try
        {
            var result = await TransferApi.CancelMarketItemAsync(itemId, cancelReason.Trim());
            cancelSuccess = result.Message;
            cancelReason = string.Empty;
            await LoadCancellableItemsAsync();
        }
        catch (Exception ex)
        {
            cancelError = ex.Message;
        }
        finally
        {
            cancelProcessing = false;
        }
    }

    private async Task LoadHistoryAsync(int page = 1)
    {
        historyLoading = true;
        historyError = null;
        try
        {
            historyFilter = historyFilter with { Page = page };
            historyResult = await TransferApi.GetHistoryAsync(historyFilter);
        }
        catch (Exception ex)
        {
            historyError = ex.Message;
        }
        finally
        {
            historyLoading = false;
        }
    }

}
