@page "/admin/hall-of-fame"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Interfaces
@using Fc25Draft.Core.Utilities
@using Fc25Draft.Web.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IHallOfFameService HallOfFameService
@inject ITreinadorService TreinadorSvc
@inject EscudoService EscudoService
@inject IJSRuntime JS

<PageTitle>Administração do Hall da Fama</PageTitle>

<div>
    <h1 class="h3 mb-3">Hall da Fama — Campeões</h1>

    @if (!string.IsNullOrEmpty(_erro))
    {
        <div class="alert alert-danger alert-dismissible">
            @_erro
            <button type="button" class="btn-close" @onclick="() => _erro = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_ok))
    {
        <div class="alert alert-success alert-dismissible">
            @_ok
            <button type="button" class="btn-close" @onclick="() => _ok = null"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header">@(_editandoId.HasValue ? "Editar campeão" : "Adicionar campeão")</div>
                <div class="card-body">
                    <div class="mb-3 text-center">
                        <img src="@EscudoService.GetEscudo(_formTime)"
                             alt="Escudo do time"
                             style="width:64px;height:64px;object-fit:contain;" />
                        @if (!string.IsNullOrWhiteSpace(_formTime) && !EscudoService.HasEscudo(_formTime))
                        {
                            <div class="text-muted small mt-1">Sem escudo cadastrado para este nome — será exibido o escudo padrão.</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Time campeão</label>
                        <input class="form-control" @bind="_formTime" @bind:event="oninput" maxlength="120"
                               placeholder="Ex.: Flamengo" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tipo de competição</label>
                        <select class="form-select" @bind="_formTipo">
                            <option value="@TipoCompetition.Liga">Liga</option>
                            <option value="@TipoCompetition.Copa">Copa</option>
                            <option value="@TipoCompetition.Supercopa">Supercopa</option>
                        </select>
                    </div>

                    @if (_formTipo == TipoCompetition.Liga)
                    {
                        <div class="mb-3">
                            <label class="form-label">Divisão</label>
                            <select class="form-select" @bind="_formDivisao">
                                <option value="">Sem divisão (antes da Série B)</option>
                                <option value="@Divisao.SerieA">Série A</option>
                                <option value="@Divisao.SerieB">Série B</option>
                            </select>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Técnico</label>
                        <select class="form-select mb-2" value="@_formTreinadorId?.ToString()"
                                @onchange="EscolherTreinador">
                            <option value="">Nome solto (digitar abaixo)</option>
                            @foreach (var t in _treinadores)
                            {
                                <option value="@t.TreinadorId">@t.Nome</option>
                            }
                        </select>
                        <input class="form-control" @bind="_formTecnico" maxlength="120"
                               placeholder="Ex.: nome do técnico"
                               disabled="@(_formTreinadorId is not null)" />
                        <div class="form-text">
                            Escolha um treinador cadastrado para o título entrar na carreira dele, ou digite o nome de quem não está mais na liga.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Vice (opcional)</label>
                        <input class="form-control mb-2" @bind="_formTimeVice" maxlength="120" placeholder="Time que perdeu a final / 2º colocado" />
                        <select class="form-select mb-2" value="@_formTreinadorViceId?.ToString()" @onchange="EscolherTreinadorVice">
                            <option value="">Técnico do vice: nome solto (digitar abaixo)</option>
                            @foreach (var t in _treinadores)
                            {
                                <option value="@t.TreinadorId">@t.Nome</option>
                            }
                        </select>
                        <input class="form-control" @bind="_formTecnicoVice" maxlength="120" placeholder="Técnico do vice"
                               disabled="@(_formTreinadorViceId is not null)" />
                        <div class="form-text">Conta na aba "Por treinador" do Hall da Fama (maiores vices).</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Descrição</label>
                        <input class="form-control" @bind="_formDescricao" maxlength="200"
                               placeholder="Ex.: Campeão do Brasileirão" />
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Ano</label>
                            <input type="number" class="form-control" @bind="_formAno" placeholder="2025" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Temporada</label>
                            <input class="form-control" @bind="_formTemporada" maxlength="60"
                                   placeholder="Ex.: 1 (vira &quot;1ª Temporada&quot;)" />
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" @onclick="Salvar" disabled="@_saving">
                            @(_editandoId.HasValue ? "Salvar alterações" : "Adicionar")
                        </button>
                        @if (_editandoId.HasValue)
                        {
                            <button class="btn btn-outline-secondary" @onclick="CancelarEdicao" disabled="@_saving">Cancelar</button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            @if (_loading)
            {
                <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
            }
            else if (!_entradas.Any())
            {
                <div class="alert alert-info">Nenhum campeão cadastrado.</div>
            }
            else
            {
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="PreencherVices" disabled="@_saving">Buscar vices das competições do site</button>
                    <span class="small text-muted">Preenche o vice dos títulos automáticos que ainda estão sem. Os antigos, à mão no formulário.</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle" style="font-size:0.875rem;">
                        <thead class="table-dark">
                            <tr>
                                <th style="width:56px;"></th>
                                <th>Time</th>
                                <th>Técnico</th>
                                <th>Vice</th>
                                <th>Descrição</th>
                                <th class="text-center">Tipo</th>
                                <th class="text-center">Temporada</th>
                                <th class="text-end" style="width:130px;">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entrada in _entradas)
                            {
                                <tr>
                                    <td><img src="@EscudoService.GetEscudo(entrada.TimeCampeao)" alt="Escudo @entrada.TimeCampeao" style="width:32px;height:32px;object-fit:contain;" /></td>
                                    <td class="fw-bold">@entrada.TimeCampeao</td>
                                    <td class="text-muted">
                                        @if (entrada.TreinadorId is { } tid)
                                        {
                                            <a href="/treinadores/@tid">@entrada.Tecnico</a>
                                        }
                                        else
                                        {
                                            @(entrada.Tecnico ?? "—")
                                        }
                                    </td>
                                    <td class="text-muted small">
                                        @if (string.IsNullOrWhiteSpace(entrada.TimeVice))
                                        {
                                            <span>—</span>
                                        }
                                        else
                                        {
                                            @entrada.TimeVice
                                            @if (!string.IsNullOrWhiteSpace(entrada.TecnicoVice))
                                            {
                                                <div>@entrada.TecnicoVice</div>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @entrada.Descricao
                                        @if (entrada.Automatica)
                                        {
                                            <span class="badge bg-light text-muted border ms-1" title="Entrou sozinha quando a competição foi encerrada">automático</span>
                                        }
                                    </td>
                                    <td class="text-center"><span class="badge bg-dark">@RotuloCompeticao(entrada)</span></td>
                                    <td class="text-center text-muted">@(entrada.Temporada is not null ? TemporadaLabel(entrada.Temporada) : (entrada.Ano?.ToString() ?? "—"))</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => Editar(entrada)" disabled="@_saving">Editar</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarExcluir(entrada)" disabled="@_saving">Excluir</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<div class="mt-5">
    <h2 class="h4 mb-1">Hall da Fama — jogadores</h2>
    <p class="text-muted small mb-3">
        Quem entra aqui é escolha da organização: uma turma por temporada, com 1º, 2º e 3º (dá para fazer a cerimônia anual).
        Cada jogador entra uma vez só. Aparece no topo da aba Títulos do Hall da Fama, com jogos, gols e assistências na liga.
    </p>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header">Colocar no Hall da Fama</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Jogador</label>
                        @if (_hofJogador is { } escolhido)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="etiqueta">@escolhido.Name · @escolhido.PositionName · @escolhido.Overall</span>
                                <button class="btn btn-sm btn-link p-0" @onclick="() => _hofJogador = null">trocar</button>
                            </div>
                        }
                        else
                        {
                            <JogadorBusca Placeholder="Buscar jogador pelo nome" OnEscolhido="p => _hofJogador = p" />
                        }
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Turma (temporada)</label>
                            <input type="number" class="form-control" @bind="_hofTemporada" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Colocação</label>
                            <select class="form-select" @bind="_hofColocacao">
                                <option value="1">1º</option>
                                <option value="2">2º</option>
                                <option value="3">3º</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Motivo (opcional)</label>
                        <input class="form-control" @bind="_hofMotivo" maxlength="300" placeholder="Ex.: artilheiro de três Brasileirões" />
                    </div>
                    <button class="btn btn-primary" @onclick="IncluirJogador" disabled="@(_saving || _hofJogador is null)">Colocar no Hall da Fama</button>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            @if (_hofJogadores.Count == 0)
            {
                <div class="alert alert-info">Nenhum jogador no Hall da Fama ainda.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" style="font-size:0.875rem;">
                        <thead class="table-dark">
                            <tr>
                                <th class="text-center">Turma</th>
                                <th class="text-center">Lugar</th>
                                <th>Jogador</th>
                                <th class="text-center">J / G / A</th>
                                <th>Motivo</th>
                                <th class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var j in _hofJogadores)
                            {
                                <tr>
                                    <td class="text-center">@j.Temporada</td>
                                    <td class="text-center fw-bold">@(j.Colocacao)º</td>
                                    <td>
                                        <a href="/players/details/@j.PlayerId">@j.Nome</a>
                                        <div class="small text-muted">@j.Posicao@(j.Aposentado ? " · aposentado" : "")@(j.Clube is null ? "" : $" · {j.Clube}")</div>
                                    </td>
                                    <td class="text-center text-muted">@j.Jogos / @j.Gols / @j.Assistencias</td>
                                    <td class="small">@(j.Motivo ?? "—")</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoverJogador(j)" disabled="@_saving">Tirar</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@if (_entradaParaExcluir is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Excluir campeão</h5>
                    <button type="button" class="btn-close" @onclick="() => _entradaParaExcluir = null"></button>
                </div>
                <div class="modal-body">
                    <p>Remover <strong>@_entradaParaExcluir.TimeCampeao</strong> (@_entradaParaExcluir.Descricao) do Hall da Fama?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _entradaParaExcluir = null" disabled="@_saving">Cancelar</button>
                    <button class="btn btn-danger" @onclick="Excluir" disabled="@_saving">Excluir</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private string? _erro;
    private string? _ok;
    private IReadOnlyList<HallOfFameEntryDto> _entradas = Array.Empty<HallOfFameEntryDto>();
    private IReadOnlyList<TreinadorDto> _treinadores = Array.Empty<TreinadorDto>();

    private Guid? _editandoId;
    private string _formTime = string.Empty;
    private string _formTecnico = string.Empty;
    private Guid? _formTreinadorId;
    private string _formDescricao = string.Empty;
    private TipoCompetition _formTipo = TipoCompetition.Liga;
    private Divisao? _formDivisao;
    private int? _formAno;
    private string _formTemporada = string.Empty;

    private string _formTimeVice = string.Empty;
    private string _formTecnicoVice = string.Empty;
    private Guid? _formTreinadorViceId;

    private HallOfFameEntryDto? _entradaParaExcluir;

    private IReadOnlyList<HallDaFamaJogadorDto> _hofJogadores = Array.Empty<HallDaFamaJogadorDto>();
    private PlayerListItemDto? _hofJogador;
    private int _hofTemporada;
    private int _hofColocacao = 1;
    private string _hofMotivo = string.Empty;

    protected override async Task OnInitializedAsync() => await CarregarDados();

    private async Task CarregarDados()
    {
        _loading = true;
        try
        {
            _entradas = await HallOfFameService.GetAllAsync(CancellationToken.None);
            _treinadores = await TreinadorSvc.ListAsync(true, CancellationToken.None);
            _hofJogadores = await HallOfFameService.JogadoresAsync(CancellationToken.None);
            if (_hofTemporada == 0)
                _hofTemporada = await HallOfFameService.UltimaTemporadaAsync(CancellationToken.None) ?? 2010;
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Salvar()
    {
        _erro = null; _ok = null; _saving = true;
        try
        {
            if (_editandoId.HasValue)
            {
                await HallOfFameService.UpdateAsync(_editandoId.Value,
                    new HallOfFameUpdateRequest(_formDescricao, _formTipo, _formTime, _formTecnico, _formTreinadorId, _formAno, _formTemporada, _formDivisao,
                        _formTimeVice, _formTecnicoVice, _formTreinadorViceId),
                    CancellationToken.None);
                _ok = "Campeão atualizado.";
            }
            else
            {
                await HallOfFameService.CreateAsync(
                    new HallOfFameCreateRequest(_formDescricao, _formTipo, _formTime, _formTecnico, _formTreinadorId, _formAno, _formTemporada, _formDivisao,
                        _formTimeVice, _formTecnicoVice, _formTreinadorViceId),
                    CancellationToken.None);
                _ok = "Campeão adicionado.";
            }
            LimparFormulario();
            await CarregarDados();
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void Editar(HallOfFameEntryDto entrada)
    {
        _editandoId = entrada.Id;
        _formTime = entrada.TimeCampeao;
        _formTecnico = entrada.Tecnico ?? string.Empty;
        _formTreinadorId = entrada.TreinadorId;
        _formDescricao = entrada.Descricao;
        _formTipo = entrada.Tipo;
        _formDivisao = entrada.Divisao;
        _formAno = entrada.Ano;
        _formTemporada = entrada.Temporada ?? string.Empty;
        _formTimeVice = entrada.TimeVice ?? string.Empty;
        _formTecnicoVice = entrada.TecnicoVice ?? string.Empty;
        _formTreinadorViceId = entrada.TreinadorViceId;
        _erro = null; _ok = null;
    }

    /// <summary>Treinador cadastrado preenche o nome sozinho; "nome solto" devolve o campo livre.</summary>
    private void EscolherTreinador(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _formTreinadorId = id;
            _formTecnico = _treinadores.FirstOrDefault(t => t.TreinadorId == id)?.Nome ?? _formTecnico;
        }
        else
        {
            _formTreinadorId = null;
        }
    }

    private void CancelarEdicao() => LimparFormulario();

    private void LimparFormulario()
    {
        _editandoId = null;
        _formTime = string.Empty;
        _formTecnico = string.Empty;
        _formTreinadorId = null;
        _formDescricao = string.Empty;
        _formTipo = TipoCompetition.Liga;
        _formDivisao = null;
        _formAno = null;
        _formTemporada = string.Empty;
        _formTimeVice = string.Empty;
        _formTecnicoVice = string.Empty;
        _formTreinadorViceId = null;
    }

    private void EscolherTreinadorVice(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _formTreinadorViceId = id;
            _formTecnicoVice = _treinadores.FirstOrDefault(t => t.TreinadorId == id)?.Nome ?? _formTecnicoVice;
        }
        else
        {
            _formTreinadorViceId = null;
        }
    }

    private async Task PreencherVices()
    {
        _erro = null; _ok = null; _saving = true;
        try
        {
            var n = await HallOfFameService.PreencherVicesAsync(CancellationToken.None);
            _ok = n == 0 ? "Nenhum vice novo para preencher." : $"{n} vice(s) preenchido(s).";
            await CarregarDados();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private async Task IncluirJogador()
    {
        if (_hofJogador is null) return;
        _erro = null; _ok = null; _saving = true;
        try
        {
            await HallOfFameService.IncluirJogadorAsync(
                new HallDaFamaJogadorRequest(_hofJogador.PlayerId, _hofTemporada, _hofColocacao, _hofMotivo), CancellationToken.None);
            _ok = $"{_hofJogador.Name} entrou no Hall da Fama ({_hofColocacao}º da turma de {_hofTemporada}).";
            _hofJogador = null;
            _hofMotivo = string.Empty;
            _hofColocacao = Math.Min(3, _hofColocacao + 1);
            await CarregarDados();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private async Task RemoverJogador(HallDaFamaJogadorDto j)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Tirar {j.Nome} do Hall da Fama?")) return;
        _erro = null; _ok = null; _saving = true;
        try
        {
            await HallOfFameService.RemoverJogadorAsync(j.Id, CancellationToken.None);
            _ok = $"{j.Nome} saiu do Hall da Fama.";
            await CarregarDados();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private void ConfirmarExcluir(HallOfFameEntryDto entrada) => _entradaParaExcluir = entrada;

    private async Task Excluir()
    {
        if (_entradaParaExcluir is null) return;
        _erro = null; _ok = null; _saving = true;
        try
        {
            await HallOfFameService.DeleteAsync(_entradaParaExcluir.Id, CancellationToken.None);
            _ok = "Campeão removido.";
            if (_editandoId == _entradaParaExcluir.Id) LimparFormulario();
            _entradaParaExcluir = null;
            await CarregarDados();
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private static string RotuloCompeticao(HallOfFameEntryDto e) => LigaLabels.Competicao(e.Tipo, e.Divisao);

    private static string TipoLabel(TipoCompetition tipo) => tipo switch
    {
        TipoCompetition.Copa => "Copa",
        TipoCompetition.Supercopa => "Supercopa",
        _ => "Liga"
    };

    private static string TemporadaLabel(string temporada)
    {
        var t = temporada.Trim();
        return int.TryParse(t, out var n) ? $"{n}ª Temporada" : t;
    }
}
