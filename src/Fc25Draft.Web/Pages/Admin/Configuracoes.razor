@page "/admin/configuracoes"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Entities
@using Fc25Draft.Core.Interfaces
@using Fc25Draft.Core.Utilities
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IPricingConfigService PricingCfg
@inject ITransferConfigService TransferCfg
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService
@inject IJSRuntime JSRuntime

<PageTitle>Configurações</PageTitle>

<div class="container-fluid py-3">
    <h1 class="h3 mb-3">Configurações</h1>

    @if (_erro is not null)
    {
        <div class="alert alert-danger alert-dismissible">@_erro<button type="button" class="btn-close" @onclick="() => _erro = null"></button></div>
    }
    @if (_ok is not null)
    {
        <div class="alert alert-success alert-dismissible">@_ok<button type="button" class="btn-close" @onclick="() => _ok = null"></button></div>
    }

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><button class="nav-link @(_tab == "preco" ? "active" : "")" @onclick='() => _tab = "preco"'>Precificação</button></li>
        <li class="nav-item"><button class="nav-link @(_tab == "transf" ? "active" : "")" @onclick='() => _tab = "transf"'>Transferências</button></li>
    </ul>

    @if (_tab == "preco")
    {
        @if (_loading)
        {
            <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-12 col-xl-7">
                    <div class="card mb-3">
                        <div class="card-header fw-bold">Fórmula base</div>
                        <div class="card-body">
                            <p class="text-muted small mb-3">
                                Preço base = <strong>peso da posição</strong> × <strong>fator de overall</strong> × <strong>fator de idade</strong> × <strong>escala base</strong>,
                                arredondado ao passo. Os pesos por posição são fixos no sistema.
                            </p>
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Escala base (BaseScale)</label>
                                    <input type="number" step="any" class="form-control" @bind="_baseScale" />
                                    <div class="form-text">Multiplicador geral. Sobe/desce todos os preços.</div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <label class="form-label">Base overall</label>
                                    <input type="number" step="any" class="form-control" @bind="_overallBase" />
                                    <div class="form-text">1.08 = +8% por ponto.</div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <label class="form-label">Pivô overall</label>
                                    <input type="number" class="form-control" @bind="_overallPivot" />
                                    <div class="form-text">Overall "neutro" (fator = 1).</div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <label class="form-label">Fator comprar-agora</label>
                                    <input type="number" step="any" class="form-control" @bind="_buyNow" />
                                    <div class="form-text">Base × isto = comprar agora.</div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <label class="form-label">Taxa incremento mín.</label>
                                    <input type="number" step="any" class="form-control" @bind="_minRate" />
                                    <div class="form-text">Ex.: 0.03 = 3% do lance.</div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <label class="form-label">Passo de arredondamento</label>
                                    <input type="number" step="any" class="form-control" @bind="_minStep" />
                                    <div class="form-text">Arredonda preços a múltiplos disto.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header fw-bold">Fatores de idade</div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-6 col-md-3"><label class="form-label">Até 22</label><input type="number" step="any" class="form-control" @bind="_f22" /></div>
                                <div class="col-6 col-md-3"><label class="form-label">23–24</label><input type="number" step="any" class="form-control" @bind="_f24" /></div>
                                <div class="col-6 col-md-3"><label class="form-label">25–26</label><input type="number" step="any" class="form-control" @bind="_f26" /></div>
                                <div class="col-6 col-md-3"><label class="form-label">27–28</label><input type="number" step="any" class="form-control" @bind="_f28" /></div>
                                <div class="col-6 col-md-3"><label class="form-label">29–30</label><input type="number" step="any" class="form-control" @bind="_f30" /></div>
                                <div class="col-6 col-md-3"><label class="form-label">31–32</label><input type="number" step="any" class="form-control" @bind="_f32" /></div>
                                <div class="col-6 col-md-3"><label class="form-label">33–34</label><input type="number" step="any" class="form-control" @bind="_f34" /></div>
                                <div class="col-6 col-md-3"><label class="form-label">35+</label><input type="number" step="any" class="form-control" @bind="_f35" /></div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" @onclick="Salvar" disabled="@_saving">@(_saving ? "Salvando..." : "Salvar")</button>
                        <button class="btn btn-outline-secondary" @onclick="RestaurarPadroes" disabled="@_saving">Restaurar padrões</button>
                    </div>
                </div>

                <div class="col-12 col-xl-5">
                    <div class="card">
                        <div class="card-header fw-bold">Prévia (com os valores acima, sem salvar)</div>
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr><th>Exemplo</th><th class="text-end">Base</th><th class="text-end">Comprar agora</th><th class="text-end">Incr. mín.</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var ex in _exemplos)
                                    {
                                        var r = Preview(ex.PositionId, ex.Overall, ex.Age);
                                        <tr>
                                            <td>@ex.Label</td>
                                            <td class="text-end">@r.Base.ToString("N0")</td>
                                            <td class="text-end">@r.BuyNow.ToString("N0")</td>
                                            <td class="text-end">@r.MinInc.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer small text-muted">A prévia usa os pesos de posição fixos do sistema.</div>
                    </div>
                </div>
            </div>
        }
    }

    @if (_tab == "transf")
    {
        @if (_loading)
        {
            <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-12 col-lg-7">
                    <div class="card">
                        <div class="card-header fw-bold">Limites de transferências</div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <label class="form-label">Vendas rápidas por janela</label>
                                    <input type="number" min="0" class="form-control" @bind="_maxQuickSell" />
                                    <div class="form-text">Máximo de quick-sells que um time pode fazer.</div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label">Transferências por janela</label>
                                    <input type="number" min="0" class="form-control" @bind="_maxTransfers" />
                                    <div class="form-text">Máximo de transferências por time.</div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label">Mínimo de jogadores no elenco</label>
                                    <input type="number" min="0" class="form-control" @bind="_minRoster" />
                                    <div class="form-text">Um time não pode ficar abaixo disto.</div>
                                </div>
                            </div>

                            <hr />

                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" role="switch" id="qsLiberado"
                                           checked="@(!_quickSellBloqueado)"
                                           @onchange="e => _quickSellBloqueado = !(bool)(e.Value ?? false)" />
                                    <label class="form-check-label" for="qsLiberado">Vendas rápidas liberadas</label>
                                </div>
                                <span class="badge @(_quickSellBloqueadoSalvo ? "bg-danger" : "bg-success")">
                                    @(_quickSellBloqueadoSalvo ? "Bloqueadas agora" : "Liberadas agora")
                                </span>
                            </div>
                            <div class="form-text">
                                Bloqueado, ninguém consegue fazer venda rápida — nem quem ainda tem vendas sobrando.
                                O padrão do sistema é bloqueado; libere só quando a janela abrir.
                            </div>

                            <div class="mt-3">
                                <button class="btn btn-primary" @onclick="SalvarTransf" disabled="@_saving">@(_saving ? "Salvando..." : "Salvar")</button>
                                <button class="btn btn-outline-secondary ms-2" @onclick="RestaurarTransf" disabled="@_saving">Restaurar padrões</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-5">
                    <div class="card border-danger">
                        <div class="card-header fw-bold text-danger">Zerar vendas rápidas</div>
                        <div class="card-body">
                            <p class="text-muted small mb-3">
                                Zera o contador de quick-sells de <strong>todos os times</strong>, liberando o limite da janela novamente.
                                Não desfaz vendas já feitas nem altera o caixa.
                            </p>
                            <button class="btn btn-outline-danger" @onclick="ZerarQuickSells" disabled="@_saving">
                                @(_saving ? "Zerando..." : "Zerar quick-sells de todos os times")
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Time</th>
                                        <th class="text-end">Usados</th>
                                        <th style="width: 6.5rem">Limite</th>
                                        <th style="width: 6.5rem">Restantes</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_quickSells.Count == 0)
                                    {
                                        <tr><td colspan="5" class="text-muted text-center">Nenhum time cadastrado.</td></tr>
                                    }
                                    @foreach (var t in _quickSells)
                                    {
                                        var limite = t.LimiteIndividual ?? _maxQuickSellSalvo;
                                        var restantes = Math.Max(0, limite - t.QuickSellCount);
                                        <tr>
                                            <td>
                                                @t.TeamName
                                                @if (!string.IsNullOrWhiteSpace(t.OwnerName))
                                                {
                                                    <span class="text-muted small"> · @t.OwnerName</span>
                                                }
                                                @if (t.LimiteIndividual is not null)
                                                {
                                                    <span class="badge bg-info text-dark ms-1">individual</span>
                                                }
                                            </td>
                                            <td class="text-end @(restantes == 0 ? "text-danger fw-bold" : "")">@t.QuickSellCount</td>
                                            <td>
                                                <input type="number" min="0" class="form-control form-control-sm" placeholder="@_maxQuickSellSalvo"
                                                       value="@_limitesEditados.GetValueOrDefault(t.TeamId, t.LimiteIndividual?.ToString())"
                                                       @onchange="e => _limitesEditados[t.TeamId] = e.Value?.ToString()" />
                                            </td>
                                            <td>
                                                <input type="number" min="0" max="@limite" class="form-control form-control-sm"
                                                       value="@_restantesEditados.GetValueOrDefault(t.TeamId, restantes.ToString())"
                                                       @onchange="e => _restantesEditados[t.TeamId] = e.Value?.ToString()" />
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => SalvarQuickSellDoTime(t)" disabled="@_saving">Salvar</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer small text-muted">
                            <strong>Limite</strong>: em branco usa o limite geral da janela (@_maxQuickSellSalvo); preenchido vale só para aquele time —
                            é assim que um time novo entra com menos vendas rápidas que os outros.
                            <strong>Restantes</strong>: quantas ele ainda pode fazer agora (limite menos as já feitas).
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-7">
                    <div class="card border-danger">
                        <div class="card-header fw-bold text-danger">Transferências por janela dos times</div>
                        <div class="card-body">
                            <p class="text-muted small mb-3">
                                Zera o contador de transferências de <strong>todos os times</strong> (use na virada de janela/temporada).
                                Não desfaz transferências já feitas. Depois ajuste na tabela quem precisa de valor personalizado.
                            </p>
                            <button class="btn btn-outline-danger" @onclick="ZerarTransferencias" disabled="@_saving">
                                @(_saving ? "Zerando..." : "Zerar transferências de todos os times")
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Time</th>
                                        <th class="text-end">Usadas</th>
                                        <th style="width: 6.5rem">Limite</th>
                                        <th style="width: 6.5rem">Restantes</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_transferencias.Count == 0)
                                    {
                                        <tr><td colspan="5" class="text-muted text-center">Nenhum time cadastrado.</td></tr>
                                    }
                                    @foreach (var t in _transferencias)
                                    {
                                        var limite = t.LimiteIndividual ?? _maxTransfersSalvo;
                                        var restantes = Math.Max(0, limite - t.TransferCount);
                                        <tr>
                                            <td>
                                                @t.TeamName
                                                @if (!string.IsNullOrWhiteSpace(t.OwnerName))
                                                {
                                                    <span class="text-muted small"> · @t.OwnerName</span>
                                                }
                                                @if (t.LimiteIndividual is not null)
                                                {
                                                    <span class="badge bg-info text-dark ms-1">individual</span>
                                                }
                                            </td>
                                            <td class="text-end @(restantes == 0 ? "text-danger fw-bold" : "")">@t.TransferCount</td>
                                            <td>
                                                <input type="number" min="0" class="form-control form-control-sm" placeholder="@_maxTransfersSalvo"
                                                       value="@_transfLimitesEditados.GetValueOrDefault(t.TeamId, t.LimiteIndividual?.ToString())"
                                                       @onchange="e => _transfLimitesEditados[t.TeamId] = e.Value?.ToString()" />
                                            </td>
                                            <td>
                                                <input type="number" min="0" max="@limite" class="form-control form-control-sm"
                                                       value="@_transfRestantesEditados.GetValueOrDefault(t.TeamId, restantes.ToString())"
                                                       @onchange="e => _transfRestantesEditados[t.TeamId] = e.Value?.ToString()" />
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => SalvarTransferenciasDoTime(t)" disabled="@_saving">Salvar</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer small text-muted">
                            <strong>Limite</strong>: em branco usa o limite geral da janela (@_maxTransfersSalvo); preenchido vale só para aquele time.
                            <strong>Restantes</strong>: quantas ele ainda pode fazer agora (limite menos as já feitas).
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-7">
                    <div class="card">
                        <div class="card-header fw-bold">Mínimo de elenco temporário</div>
                        <div class="card-body pb-0">
                            <p class="text-muted small mb-2">
                                Libera um time para ficar abaixo do mínimo geral (@_minRosterSalvo) por um tempo, por exemplo quem perdeu jogadores
                                no draft de expansão. Deixe em branco para usar o mínimo geral.
                            </p>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr><th>Time</th><th class="text-end">Elenco</th><th style="width: 9rem">Mínimo temporário</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in _elencos)
                                    {
                                        var abaixo = t.Elenco < (t.MinimoTemporario ?? _minRosterSalvo);
                                        <tr>
                                            <td>
                                                @t.TeamName
                                                @if (t.MinimoTemporario is not null)
                                                {
                                                    <span class="badge bg-warning text-dark ms-1">temporário</span>
                                                }
                                            </td>
                                            <td class="text-end fw-bold @(abaixo ? "text-danger" : "")">@t.Elenco</td>
                                            <td>
                                                <input type="number" min="0" class="form-control form-control-sm" placeholder="@_minRosterSalvo"
                                                       value="@_minimosEditados.GetValueOrDefault(t.TeamId)"
                                                       @onchange="e => _minimosEditados[t.TeamId] = e.Value?.ToString()" />
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => SalvarMinimoTemporario(t)" disabled="@_saving">Salvar</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private string _tab = "preco";
    private bool _loading = true;
    private bool _saving;
    private string? _erro, _ok;

    private decimal _baseScale, _overallBase, _buyNow, _minRate, _minStep;
    private int _overallPivot;
    private decimal _f22, _f24, _f26, _f28, _f30, _f32, _f34, _f35;

    // Transferências
    private int _maxQuickSell, _maxTransfers, _minRoster;
    private int _maxQuickSellSalvo, _maxTransfersSalvo, _minRosterSalvo;
    private bool _quickSellBloqueado, _quickSellBloqueadoSalvo;
    private IReadOnlyList<TeamQuickSellStatusDto> _quickSells = Array.Empty<TeamQuickSellStatusDto>();
    private IReadOnlyList<TeamElencoMinimoDto> _elencos = Array.Empty<TeamElencoMinimoDto>();
    private readonly Dictionary<Guid, string?> _minimosEditados = new();
    private readonly Dictionary<Guid, string?> _restantesEditados = new();
    private readonly Dictionary<Guid, string?> _limitesEditados = new();
    private IReadOnlyList<TeamTransferStatusDto> _transferencias = Array.Empty<TeamTransferStatusDto>();
    private readonly Dictionary<Guid, string?> _transfRestantesEditados = new();
    private readonly Dictionary<Guid, string?> _transfLimitesEditados = new();

    private record Exemplo(string Label, short PositionId, int Overall, int Age);
    private static readonly Exemplo[] _exemplos =
    {
        new("Centroavante · 85 · 24", 12, 85, 24),
        new("Meia · 80 · 27", 6, 80, 27),
        new("Zagueiro · 78 · 30", 2, 78, 30),
        new("Goleiro · 82 · 33", 1, 82, 33),
    };

    protected override async Task OnInitializedAsync()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/admin/configuracoes"));
        try
        {
            var cfg = await PricingCfg.GetAsync(CancellationToken.None);
            Aplicar(cfg);

            var tcfg = await TransferCfg.GetAsync(CancellationToken.None);
            AplicarTransf(tcfg);
            await CarregarQuickSells();
            await CarregarTransferencias();
            await CarregarElencos();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _loading = false; }
    }

    private void AplicarTransf(TransferConfigDto t)
    {
        _maxQuickSell = t.MaxQuickSellPerWindow;
        _maxQuickSellSalvo = t.MaxQuickSellPerWindow;
        _maxTransfers = t.MaxTransfers;
        _maxTransfersSalvo = t.MaxTransfers;
        _minRoster = t.MinRosterSize;
        _minRosterSalvo = t.MinRosterSize;
        _quickSellBloqueado = t.QuickSellBloqueado;
        _quickSellBloqueadoSalvo = t.QuickSellBloqueado;
    }

    private async Task CarregarQuickSells()
        => _quickSells = await TransferCfg.GetQuickSellStatusAsync(CancellationToken.None);

    private async Task CarregarTransferencias()
        => _transferencias = await TransferCfg.GetTransferStatusAsync(CancellationToken.None);

    /// <summary>
    /// Salva o limite individual de transferências do time (vazio = usa o geral) e quantas ainda sobram para ele.
    /// </summary>
    private async Task SalvarTransferenciasDoTime(TeamTransferStatusDto time)
    {
        _erro = null; _ok = null;

        var textoLimite = _transfLimitesEditados.GetValueOrDefault(time.TeamId, time.LimiteIndividual?.ToString());
        int? limiteIndividual = null;
        if (!string.IsNullOrWhiteSpace(textoLimite))
        {
            if (!int.TryParse(textoLimite, out var valor) || valor < 0) { _erro = "O limite precisa ser um número inteiro a partir de zero."; return; }
            limiteIndividual = valor;
        }

        var limite = limiteIndividual ?? _maxTransfersSalvo;

        var textoRestantes = _transfRestantesEditados.GetValueOrDefault(time.TeamId);
        int restantes;
        if (string.IsNullOrWhiteSpace(textoRestantes))
            restantes = Math.Max(0, limite - time.TransferCount);
        else if (!int.TryParse(textoRestantes, out restantes) || restantes < 0)
        {
            _erro = "As transferências restantes precisam ser um número inteiro a partir de zero.";
            return;
        }

        if (restantes > limite) { _erro = $"{time.TeamName} tem limite {limite}: não dá para sobrar {restantes}."; return; }

        _saving = true;
        try
        {
            await TransferCfg.SetTransferLimitAsync(time.TeamId, limiteIndividual, CancellationToken.None);
            await TransferCfg.SetTransferCountAsync(time.TeamId, limite - restantes, CancellationToken.None);

            _transfLimitesEditados.Remove(time.TeamId);
            _transfRestantesEditados.Remove(time.TeamId);
            await CarregarTransferencias();

            _ok = limiteIndividual is null
                ? $"{time.TeamName} usa o limite geral ({_maxTransfersSalvo}) e ficou com {restantes} transferência(s)."
                : $"{time.TeamName} agora tem limite próprio de {limiteIndividual} e ficou com {restantes} transferência(s).";
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private async Task ZerarTransferencias()
    {
        var confirmado = await JSRuntime.InvokeAsync<bool>("confirm", "Zerar o contador de transferências de TODOS os times? Esta ação não pode ser desfeita.");
        if (!confirmado) return;

        _erro = null; _ok = null; _saving = true;
        try
        {
            var afetados = await TransferCfg.ResetTransferCountsAsync(CancellationToken.None);
            _transfRestantesEditados.Clear();
            _transfLimitesEditados.Clear();
            await CarregarTransferencias();
            _ok = afetados == 0
                ? "Nenhum time tinha transferências para zerar."
                : $"Transferências zeradas em {afetados} time(s).";
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private async Task CarregarElencos()
    {
        _elencos = await TransferCfg.ListElencoMinimoAsync(CancellationToken.None);
        _minimosEditados.Clear();
        foreach (var t in _elencos)
            _minimosEditados[t.TeamId] = t.MinimoTemporario?.ToString();
    }

    /// <summary>
    /// Salva o limite individual do time (vazio = usa o geral) e quantas vendas ainda sobram para ele.
    /// </summary>
    private async Task SalvarQuickSellDoTime(TeamQuickSellStatusDto time)
    {
        _erro = null; _ok = null;

        var textoLimite = _limitesEditados.GetValueOrDefault(time.TeamId, time.LimiteIndividual?.ToString());
        int? limiteIndividual = null;
        if (!string.IsNullOrWhiteSpace(textoLimite))
        {
            if (!int.TryParse(textoLimite, out var valor) || valor < 0) { _erro = "O limite precisa ser um número inteiro a partir de zero."; return; }
            limiteIndividual = valor;
        }

        var limite = limiteIndividual ?? _maxQuickSellSalvo;

        var textoRestantes = _restantesEditados.GetValueOrDefault(time.TeamId);
        int restantes;
        if (string.IsNullOrWhiteSpace(textoRestantes))
            restantes = Math.Max(0, limite - time.QuickSellCount);
        else if (!int.TryParse(textoRestantes, out restantes) || restantes < 0)
        {
            _erro = "As vendas restantes precisam ser um número inteiro a partir de zero.";
            return;
        }

        if (restantes > limite) { _erro = $"{time.TeamName} tem limite {limite}: não dá para sobrar {restantes}."; return; }

        _saving = true;
        try
        {
            await TransferCfg.SetQuickSellLimitAsync(time.TeamId, limiteIndividual, CancellationToken.None);
            await TransferCfg.SetQuickSellCountAsync(time.TeamId, limite - restantes, CancellationToken.None);

            _limitesEditados.Remove(time.TeamId);
            _restantesEditados.Remove(time.TeamId);
            await CarregarQuickSells();

            _ok = limiteIndividual is null
                ? $"{time.TeamName} usa o limite geral ({_maxQuickSellSalvo}) e ficou com {restantes} venda(s) rápida(s)."
                : $"{time.TeamName} agora tem limite próprio de {limiteIndividual} e ficou com {restantes} venda(s) rápida(s).";
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private async Task SalvarMinimoTemporario(TeamElencoMinimoDto time)
    {
        _erro = null; _ok = null;

        var texto = _minimosEditados.GetValueOrDefault(time.TeamId);
        int? minimo = null;
        if (!string.IsNullOrWhiteSpace(texto))
        {
            if (!int.TryParse(texto, out var valor)) { _erro = "Informe um número inteiro."; return; }
            minimo = valor;
        }

        _saving = true;
        try
        {
            await TransferCfg.SetElencoMinimoTemporarioAsync(time.TeamId, minimo, CancellationToken.None);
            await CarregarElencos();
            _ok = minimo is null
                ? $"{time.TeamName} voltou a usar o mínimo geral ({_minRosterSalvo})."
                : $"{time.TeamName} pode ficar com até {minimo} jogadores temporariamente.";
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private async Task SalvarTransf()
    {
        _erro = null; _ok = null; _saving = true;
        try
        {
            var salvo = await TransferCfg.UpdateAsync(new TransferConfigDto(_maxQuickSell, _maxTransfers, _minRoster, _quickSellBloqueado), CancellationToken.None);
            AplicarTransf(salvo);
            // Mudou o limite da janela: o "restantes" de cada time muda junto.
            _restantesEditados.Clear();
            _limitesEditados.Clear();
            _transfRestantesEditados.Clear();
            _transfLimitesEditados.Clear();
            _ok = "Limites de transferências salvos.";
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private async Task ZerarQuickSells()
    {
        var confirmado = await JSRuntime.InvokeAsync<bool>("confirm", "Zerar o contador de vendas rápidas de TODOS os times? Esta ação não pode ser desfeita.");
        if (!confirmado) return;

        _erro = null; _ok = null; _saving = true;
        try
        {
            var afetados = await TransferCfg.ResetQuickSellCountsAsync(CancellationToken.None);
            _restantesEditados.Clear();
            _limitesEditados.Clear();
            await CarregarQuickSells();
            _ok = afetados == 0
                ? "Nenhum time tinha vendas rápidas para zerar."
                : $"Vendas rápidas zeradas em {afetados} time(s).";
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private void RestaurarTransf()
    {
        var d = TransferConfig.Default();
        _maxQuickSell = d.MaxQuickSellPerWindow;
        _maxTransfers = d.MaxTransfers;
        _minRoster = d.MinRosterSize;
        _quickSellBloqueado = d.QuickSellBloqueado;
        _ok = "Valores padrão carregados no formulário. Clique em Salvar para aplicar.";
    }

    private void Aplicar(PricingConfigDto c)
    {
        _baseScale = c.BaseScale; _overallBase = c.OverallBase; _overallPivot = c.OverallPivot;
        _buyNow = c.BuyNowFactor; _minRate = c.MinIncrementRate; _minStep = c.MinIncrementStep;
        _f22 = c.AgeFactorUpTo22; _f24 = c.AgeFactor23To24; _f26 = c.AgeFactor25To26; _f28 = c.AgeFactor27To28;
        _f30 = c.AgeFactor29To30; _f32 = c.AgeFactor31To32; _f34 = c.AgeFactor33To34; _f35 = c.AgeFactor35Plus;
    }

    private PricingConfigDto Montar() => new(
        _baseScale, _overallBase, _overallPivot, _buyNow, _minRate, _minStep,
        _f22, _f24, _f26, _f28, _f30, _f32, _f34, _f35);

    private async Task Salvar()
    {
        _erro = null; _ok = null; _saving = true;
        try
        {
            var salvo = await PricingCfg.UpdateAsync(Montar(), CancellationToken.None);
            Aplicar(salvo);
            _ok = "Precificação salva. Vale para os próximos itens gerados no mercado.";
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private void RestaurarPadroes()
    {
        var d = PricingConfig.Default();
        _baseScale = d.BaseScale; _overallBase = d.OverallBase; _overallPivot = d.OverallPivot;
        _buyNow = d.BuyNowFactor; _minRate = d.MinIncrementRate; _minStep = d.MinIncrementStep;
        _f22 = d.AgeFactorUpTo22; _f24 = d.AgeFactor23To24; _f26 = d.AgeFactor25To26; _f28 = d.AgeFactor27To28;
        _f30 = d.AgeFactor29To30; _f32 = d.AgeFactor31To32; _f34 = d.AgeFactor33To34; _f35 = d.AgeFactor35Plus;
        _ok = "Valores padrão carregados no formulário. Clique em Salvar para aplicar.";
    }

    private decimal AgeFactor(int age) => age switch
    {
        <= 22 => _f22, <= 24 => _f24, <= 26 => _f26, <= 28 => _f28,
        <= 30 => _f30, <= 32 => _f32, <= 34 => _f34, _ => _f35
    };

    private (decimal Base, decimal BuyNow, decimal MinInc) Preview(short positionId, int overall, int age)
    {
        if (_overallBase <= 0 || _baseScale <= 0 || _minStep <= 0) return (0, 0, 0);
        var weight = MarketWeightResolver.GetByPositionId(positionId);
        var overFactor = (decimal)Math.Pow((double)_overallBase, overall - _overallPivot);
        var raw = weight * overFactor * AgeFactor(age) * _baseScale;
        var base_ = Round(raw, _minStep);
        var buyNow = Round(base_ * _buyNow, _minStep);
        var minInc = RoundUp(base_ * _minRate, _minStep);
        return (base_, buyNow, minInc);
    }

    private static decimal Round(decimal value, decimal step)
    {
        if (value <= 0) return step;
        var rounded = Math.Round(decimal.Divide(value, step), MidpointRounding.AwayFromZero);
        if (rounded == 0) rounded = 1;
        return rounded * step;
    }

    private static decimal RoundUp(decimal value, decimal step)
    {
        if (value <= 0) return step;
        return Math.Ceiling(decimal.Divide(value, step)) * step;
    }
}
