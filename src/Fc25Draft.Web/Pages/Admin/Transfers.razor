    private IEnumerable<TeamRosterInfo> GetDestinationTeams(Guid excludeTeamId)
        => excludeTeamId == Guid.Empty ? teams : teams.Where(t => t.TeamId != excludeTeamId);

    private Guid GetCurrentTeamForPlayer(Guid playerId)
        => playersById.TryGetValue(playerId, out var player)
            ? player.TeamId
            : Guid.Empty;

    private string GetTeamName(Guid teamId)
        => teamsById.TryGetValue(teamId, out var team) ? team.TeamName : "Time";

    private IReadOnlyList<SwapPreviewItem> GetSwapPreview(Guid teamId, IReadOnlyList<Guid> outgoing, IReadOnlyList<Guid> incoming)
    {
        if (!teamsById.TryGetValue(teamId, out var team))
        {
            return Array.Empty<SwapPreviewItem>();
        }

        var preview = new List<SwapPreviewItem>();

        foreach (var player in team.Players)
        {
            if (outgoing.Contains(player.PlayerId))
            {
                continue;
            }

            preview.Add(new SwapPreviewItem(player.PlayerId, player.Name, player.Position, player.Overall, "Permanece", "Continua no elenco"));
        }

        foreach (var incomingId in incoming)
        {
            if (!playersById.TryGetValue(incomingId, out var incomingPlayer))
            {
                continue;
            }

            preview.Add(new SwapPreviewItem(incomingPlayer.PlayerId, incomingPlayer.Name, incomingPlayer.Position, incomingPlayer.Overall, "Chega", $"Vem de {incomingPlayer.TeamName}"));
        }

        return preview
            .OrderBy(p => p.Name)
            .ToList();
    }

    private bool TryGetBudgetPreview(Guid teamId, decimal cashAdjust, bool isTeamA, out decimal current, out decimal preview)
    {
        current = 0m;
        preview = 0m;

        if (!teamBudgets.TryGetValue(teamId, out var saldo))
        {
            return false;
        }

        current = saldo;
        preview = isTeamA ? saldo - cashAdjust : saldo + cashAdjust;
        return true;
    }

    private IEnumerable<PlayerGroup> GetPlayersGroupedByTeam()
        => teams.Select(t => new PlayerGroup(
            t.TeamId,
            t.TeamName,
            t.Players
                .Select(p => new PlayerDisplay(p.PlayerId, $"{p.Name} ({p.Position})", p.TeamId))
                .OrderBy(p => p.Display)
                .ToList()));

