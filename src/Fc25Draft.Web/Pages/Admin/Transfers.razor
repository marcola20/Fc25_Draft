    private async Task RefreshTeamAsync(Guid teamId, bool refreshRoster = true)
    {
        if (refreshRoster)
        {
            var roster = await TeamsApiClient.GetRosterByIdAsync(teamId);
            if (roster is not null)
            {
                var index = teamRosters.FindIndex(t => t.TeamId == teamId);
                if (index >= 0)
                {
                    teamRosters[index] = roster;
                }
                else
                {
                    teamRosters.Add(roster);
                }
            }
        }

        await LoadBudgetAsync(teamId);
        UpdateSwapPreview();
    }

