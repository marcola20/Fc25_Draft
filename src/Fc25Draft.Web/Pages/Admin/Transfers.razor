            var toTeam = moveModel.ToTeamId!.Value;
            var fromTeam = teamRosters.FirstOrDefault(t => t.Jogadores.Any(p => p.PlayerGuid == playerId))?.TeamId;

            var request = new AdminMovePlayerRequestDto(playerId, toTeam, moveModel.Reason.Trim());
            moveSuccessMessage = await AdminTransfersApiClient.MovePlayerAsync(request);

            if (fromTeam.HasValue)
            {
                await RefreshTeamAsync(fromTeam.Value);
            }

            await RefreshTeamAsync(toTeam);

            moveModel = new MoveFormModel();
            moveEditContext = CreateEditContext(moveModel);
        }
        catch (Exception ex)
        {
            moveErrorMessage = ex.Message;
        }
        finally
        {
