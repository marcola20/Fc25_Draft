        => value.ToString("C", currencyCulture);

    private void ClearMessages()
    {
        sellSuccessMessage = null;
        sellErrorMessage = null;
        swapSuccessMessage = null;
        swapErrorMessage = null;
        moveSuccessMessage = null;
        moveErrorMessage = null;
        budgetSuccessMessage = null;
        budgetErrorMessage = null;
        cancelSuccessMessage = null;
        cancelErrorMessage = null;
    }

    private void OnAuthenticationChanged()
    {
        if (!authInitialized)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            if (AdminAuth.IsAuthenticated)
            {
                await LoadDataAsync();
            }
            else
            {
                isLoadingData = false;
                teams.Clear();
                teamsById.Clear();
                playersById.Clear();
                marketItems.Clear();
                teamBudgets.Clear();
                ClearMessages();
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;

        if (sellEditContext is not null)
        {
            sellEditContext.OnValidationRequested -= OnSellValidationRequested;
        }

        if (swapEditContext is not null)
        {
            swapEditContext.OnValidationRequested -= OnSwapValidationRequested;
        }
    }

