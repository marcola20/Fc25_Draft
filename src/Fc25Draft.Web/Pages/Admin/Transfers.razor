    private async Task EnsureBudgetAsync(Guid teamId)
    {
        if (teamId == Guid.Empty || teamBudgets.ContainsKey(teamId))
        {
            return;
        }

        try
        {
            var summary = await BudgetsApiClient.GetSummaryAsync(teamId);
            if (summary is not null)
            {
                teamBudgets[teamId] = summary.Saldo;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            pageError = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnSellValidationRequested(object? sender, ValidationRequestedEventArgs args)
        => ValidateSellSelection();

    private void ValidateSellSelection()
    {
        sellModel.SelectedPlayerIds = sellPlayerOptions.Where(p => p.IsSelected).Select(p => p.PlayerId).ToList();

        if (sellValidationMessages is null || sellEditContext is null)
        {
            return;
        }

        var field = new FieldIdentifier(sellModel, nameof(SellFormModel.SelectedPlayerIds));
        sellValidationMessages.Clear(field);

        if (sellModel.SelectedPlayerIds.Count == 0)
        {
            sellValidationMessages.Add(field, "Selecione ao menos um jogador.");
        }

        sellEditContext.NotifyValidationStateChanged();
    }

    private void OnSwapValidationRequested(object? sender, ValidationRequestedEventArgs args)
        => ValidateSwapSelection();

    private void ValidateSwapSelection()
    {
        swapModel.PlayersFromA = swapTeamAOptions.Where(p => p.IsSelected).Select(p => p.PlayerId).ToList();
        swapModel.PlayersFromB = swapTeamBOptions.Where(p => p.IsSelected).Select(p => p.PlayerId).ToList();

        if (swapValidationMessages is null || swapEditContext is null)
        {
            return;
        }

        var fieldA = new FieldIdentifier(swapModel, nameof(SwapFormModel.PlayersFromA));
        var fieldB = new FieldIdentifier(swapModel, nameof(SwapFormModel.PlayersFromB));
        swapValidationMessages.Clear(fieldA);
        swapValidationMessages.Clear(fieldB);

        if (swapModel.PlayersFromA.Count == 0 && swapModel.PlayersFromB.Count == 0)
        {
            swapValidationMessages.Add(fieldA, "Selecione ao menos um jogador.");
            swapValidationMessages.Add(fieldB, "Selecione ao menos um jogador.");
        }

        swapEditContext.NotifyValidationStateChanged();
    }

    private async Task SubmitSellAsync()
    {
        if (sellModel.FromTeamId == sellModel.ToTeamId)
        {
            sellErrorMessage = "Escolha times diferentes para a venda.";
            return;
        }

        isSubmittingSell = true;
        sellErrorMessage = null;
        sellSuccessMessage = null;

        try
        {
            var request = new AdminSellPlayersRequestDto(
                sellModel.FromTeamId,
                sellModel.ToTeamId,
                sellModel.SelectedPlayerIds.ToArray(),
                sellModel.Amount,
                sellModel.Reason!.Trim());

            var message = await AdminTransfersApiClient.SellAsync(request);
            sellSuccessMessage = message;

            teamBudgets.Remove(sellModel.FromTeamId);
            teamBudgets.Remove(sellModel.ToTeamId);

            sellModel.SelectedPlayerIds.Clear();
            foreach (var option in sellPlayerOptions)
            {
                option.IsSelected = false;
            }

            sellModel.Amount = 0m;
            sellModel.Reason = string.Empty;

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            sellErrorMessage = ex.Message;
        }
        finally
        {
            isSubmittingSell = false;
        }
    }

    private async Task SubmitSwapAsync()
    {
        if (swapModel.TeamAId == swapModel.TeamBId)
        {
            swapErrorMessage = "Selecione times diferentes para a troca.";
            return;
        }

        isSubmittingSwap = true;
        swapErrorMessage = null;
        swapSuccessMessage = null;

        try
        {
            var request = new AdminSwapPlayersRequestDto(
                swapModel.TeamAId,
                swapModel.PlayersFromA.ToArray(),
                swapModel.TeamBId,
                swapModel.PlayersFromB.ToArray(),
                swapModel.CashAdjustFromAToB,
                swapModel.Reason!.Trim());

            var message = await AdminTransfersApiClient.SwapAsync(request);
            swapSuccessMessage = message;

            teamBudgets.Remove(swapModel.TeamAId);
            teamBudgets.Remove(swapModel.TeamBId);

            swapModel.PlayersFromA.Clear();
            swapModel.PlayersFromB.Clear();
            foreach (var option in swapTeamAOptions)
            {
                option.IsSelected = false;
            }
            foreach (var option in swapTeamBOptions)
            {
                option.IsSelected = false;
            }

            swapModel.CashAdjustFromAToB = 0m;
            swapModel.Reason = string.Empty;

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            swapErrorMessage = ex.Message;
        }
        finally
        {
            isSubmittingSwap = false;
        }
    }

    private async Task SubmitMoveAsync()
    {
        var currentTeam = GetCurrentTeamForPlayer(moveModel.PlayerId);
        if (currentTeam == Guid.Empty)
        {
            moveErrorMessage = "Jogador inválido.";
            return;
        }

        if (moveModel.ToTeamId == currentTeam)
        {
            moveErrorMessage = "Selecione um time diferente do atual.";
            return;
        }

        isSubmittingMove = true;
        moveErrorMessage = null;
        moveSuccessMessage = null;

        try
        {
            var request = new AdminMovePlayerRequestDto(
                moveModel.PlayerId,
                moveModel.ToTeamId,
                moveModel.Reason!.Trim());

            var message = await AdminTransfersApiClient.MoveAsync(request);
            moveSuccessMessage = message;

            teamBudgets.Remove(currentTeam);
            teamBudgets.Remove(moveModel.ToTeamId);

            moveModel.PlayerId = Guid.Empty;
            moveModel.ToTeamId = Guid.Empty;
            moveModel.Reason = string.Empty;

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            moveErrorMessage = ex.Message;
        }
        finally
        {
            isSubmittingMove = false;
        }
    }

    private async Task SubmitAdjustBudgetAsync()
    {
        if (adjustModel.TeamId == Guid.Empty)
        {
            budgetErrorMessage = "Selecione um time.";
