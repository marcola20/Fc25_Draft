    private sealed class SellFormModel
    {
        [Required(ErrorMessage = "Selecione o time vendedor.")]
        public Guid? FromTeamId { get; set; }

        [Required(ErrorMessage = "Selecione o time comprador.")]
        public Guid? ToTeamId { get; set; }

        [MinLength(1, ErrorMessage = "Selecione ao menos um jogador.")]
        public List<Guid> PlayerIds { get; set; } = new();

        [Required(ErrorMessage = "Informe o valor da venda.")]
        [Range(typeof(decimal), "0", "999999999", ErrorMessage = "Informe um valor válido.")]
        public decimal? Amount { get; set; }

        [Required(ErrorMessage = "Informe o motivo da venda.")]
        [StringLength(500, ErrorMessage = "O motivo deve ter até 500 caracteres.")]
        public string Reason { get; set; } = string.Empty;
    }

    private sealed class SwapFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "Selecione o time A.")]
        public Guid? TeamAId { get; set; }

        [Required(ErrorMessage = "Selecione o time B.")]
        public Guid? TeamBId { get; set; }

        [MinLength(1, ErrorMessage = "Selecione ao menos um jogador do time A.")]
        public List<Guid> PlayersFromA { get; set; } = new();

        [MinLength(1, ErrorMessage = "Selecione ao menos um jogador do time B.")]
        public List<Guid> PlayersFromB { get; set; } = new();

        [Range(typeof(decimal), "0", "999999999", ErrorMessage = "Informe um ajuste válido.")]
        public decimal? CashAdjust { get; set; } = 0m;

        [Required(ErrorMessage = "Informe o motivo da troca.")]
        [StringLength(500, ErrorMessage = "O motivo deve ter até 500 caracteres.")]
        public string Reason { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (TeamAId == TeamBId && TeamAId.HasValue)
            {
                yield return new ValidationResult("Selecione times diferentes para a troca.", new[] { nameof(TeamBId) });
            }

            if (PlayersFromA.Count == 0)
            {
                yield return new ValidationResult("Selecione ao menos um jogador do time A.", new[] { nameof(PlayersFromA) });
            }

            if (PlayersFromB.Count == 0)
            {
                yield return new ValidationResult("Selecione ao menos um jogador do time B.", new[] { nameof(PlayersFromB) });
            }
        }
    }

