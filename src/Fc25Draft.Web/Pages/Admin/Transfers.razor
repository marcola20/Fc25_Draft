@page "/admin/transferencias"
@using System.Globalization
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Web.Utilities
@inject AdminAuthService AdminAuth
@inject TransfersClient TransfersClient
@inject TeamsApiClient TeamsApiClient
@inject PlayersApiClient PlayersApiClient
@inject ToastService Toasts

@implements IDisposable

<PageTitle>Histórico de Transferências</PageTitle>

<h1 class="h3 mb-3">Histórico de Transferências</h1>

@if (!AdminAuth.IsAuthenticated)
{
    <div class="alert alert-warning" role="alert">
        Entre como administrador para visualizar o histórico de transferências.
    </div>
}
else
{
    <EditForm EditContext="_filterContext" OnValidSubmit="ApplyFiltersAsync">
        <DataAnnotationsValidator />
        <div class="card mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="filter-team">Time</label>
                        <InputSelect id="filter-team" class="form-select" @bind-Value="_filter.TeamId" TValue="Guid?">
                            <option value="">Todos os times</option>
                            @foreach (var team in _teams)
                            {
                                <option value="@team.TeamId">@team.TeamName</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="filter-player">Jogador</label>
                        <input id="filter-player"
                               class="form-control"
                               placeholder="Busque pelo nome"
                               @bind="_playerSearch"
                               @bind:event="oninput"
                               @oninput="OnPlayerSearchChanged"
                               autocomplete="off" />
                        @if (_selectedPlayer is not null)
                        {
                            <div class="form-text text-success">Selecionado: @_selectedPlayer.Name</div>
                            <div class="mt-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearSelectedPlayer">Remover jogador</button>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(_playerSearch) && _playerSuggestions.Count > 0)
                        {
                            <div class="list-group shadow-sm mt-2">
                                @foreach (var suggestion in _playerSuggestions)
                                {
                                    <button type="button" class="list-group-item list-group-item-action"
                                            @onclick="() => SelectPlayer(suggestion)">
                                        @suggestion.Name (@suggestion.Position) - OVR @suggestion.Overall
                                    </button>
                                }
                            </div>
                        }
                        <div class="form-text">Selecione um jogador na lista sugerida.</div>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="filter-start">Início do período</label>
                        <input id="filter-start" type="date" class="form-control" @bind="_filter.StartDate" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="filter-end">Fim do período</label>
                        <input id="filter-end" type="date" class="form-control" @bind="_filter.EndDate" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="filter-texto">Busca textual</label>
                        <InputText id="filter-texto" class="form-control" @bind-Value="_filter.Query" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="filter-pagesize">Itens por página</label>
                        <InputNumber id="filter-pagesize" class="form-control" @bind-Value="_filter.PageSize" />
                        <ValidationMessage For="@(() => _filter.PageSize)" />
                    </div>
                    <div class="col-12 col-md-3 d-flex gap-2 justify-content-md-end">
                        <button type="submit" class="btn btn-primary" disabled="@_isLoading">Aplicar</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="ClearFiltersAsync" disabled="@_isLoading">Limpar</button>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    else if (_isLoading && _transfers is null)
    {
        <div class="alert alert-info" role="status">Carregando transferências...</div>
    }
    else if (_transfers is null)
    {
        <div class="alert alert-info" role="status">Carregando transferências...</div>
    }
    else if (_transfers.Total == 0)
    {
        <div class="alert alert-warning" role="status">Nenhuma transferência encontrada para os filtros informados.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead>
                    <tr>
                        <th>
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => ChangeSort(nameof(TransferSort.Date))">
                                Data/Hora @SortIcon(nameof(TransferSort.Date))
                            </button>
                        </th>
                        <th>
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => ChangeSort(nameof(TransferSort.Player))">
                                Jogador @SortIcon(nameof(TransferSort.Player))
                            </button>
                        </th>
                        <th>
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => ChangeSort(nameof(TransferSort.FromTeam))">
                                Saiu do time @SortIcon(nameof(TransferSort.FromTeam))
                            </button>
                        </th>
                        <th>
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => ChangeSort(nameof(TransferSort.ToTeam))">
                                Foi para o time @SortIcon(nameof(TransferSort.ToTeam))
                            </button>
                        </th>
                        <th class="text-end">
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => ChangeSort(nameof(TransferSort.Amount))">
                                Valor @SortIcon(nameof(TransferSort.Amount))
                            </button>
                        </th>
                        <th>Observações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in GetSortedItems())
                {
                    <tr>
                        <td class="text-nowrap">@BrazilTime.FormatDateTime(item.OccurredAtUtc)</td>
                        <td class="fw-semibold">@item.PlayerName</td>
                        <td>@item.FromTeamName</td>
                        <td>@item.ToTeamName</td>
                        <td class="text-end">@item.Amount.ToString("C0", CultureInfo.GetCultureInfo("pt-BR"))</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                            {
                                var shortText = item.Notes.Length > 60 ? item.Notes[..60] + "…" : item.Notes;
                                <span title="@item.Notes">@shortText</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (_transfers.TotalPages > 1)
        {
            <nav class="mt-3" aria-label="Paginação do histórico de transferências">
                <ul class="pagination pagination-sm flex-wrap mb-0">
                    <li class="page-item @(_currentPage <= 1 ? "disabled" : null)">
                        <button class="page-link" type="button" @onclick="async () => await LoadAsync(_currentPage - 1)" disabled="@(_currentPage <= 1)">Anterior</button>
                    </li>
                    @foreach (var page in VisiblePages)
                    {
                        <li class="page-item @(page == _currentPage ? "active" : null)">
                            <button class="page-link" type="button" @onclick="async () => await LoadAsync(page)">@page</button>
                        </li>
                    }
                    <li class="page-item @(_currentPage >= _transfers.TotalPages ? "disabled" : null)">
                        <button class="page-link" type="button" @onclick="async () => await LoadAsync(_currentPage + 1)" disabled="@(_currentPage >= _transfers.TotalPages)">Próxima</button>
                    </li>
                </ul>
            </nav>
        }

        @if (_isLoading)
        {
            <div class="alert alert-info mt-3" role="status">Atualizando dados...</div>
        }
    }
}

@code {
    private readonly TransferHistoryFilterModel _filter = new();
    private EditContext _filterContext = default!;
    private IReadOnlyList<TeamListItemDto> _teams = Array.Empty<TeamListItemDto>();
    private readonly List<PlayerSuggestion> _playerSuggestions = new();
    private PlayerSuggestion? _selectedPlayer;
    private string? _playerSearch;
    private PagedResult<TransferListItemDto>? _transfers;
    private int _currentPage = 1;
    private string _sortColumn = nameof(TransferSort.Date);
    private bool _sortDescending = true;
    private bool _isLoading;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private CancellationTokenSource? _playerSearchCts;

    private IEnumerable<int> VisiblePages
    {
        get
        {
            if (_transfers is null)
            {
                yield return 1;
                yield break;
            }

            var start = Math.Max(1, _currentPage - 2);
            var end = Math.Min(_transfers.TotalPages, _currentPage + 2);
            for (var page = start; page <= end; page++)
            {
                yield return page;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _filterContext = new EditContext(_filter);
        _filterContext.OnFieldChanged += (_, __) => InvokeAsync(StateHasChanged);

        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
        await AdminAuth.EnsureInitializedAsync();

        if (AdminAuth.IsAuthenticated)
        {
            await LoadInitialDataAsync();
        }
    }

    private async Task LoadInitialDataAsync()
    {
        await LoadTeamsAsync();
        await LoadAsync();
    }

    private async Task LoadTeamsAsync()
    {
        try
        {
            var result = await TeamsApiClient.GetAsync(null, 1, 100, CancellationToken.None).ConfigureAwait(false);
            _teams = result.Items
                .OrderBy(t => t.TeamName, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
        }
        catch (Exception ex)
        {
            _teams = Array.Empty<TeamListItemDto>();
            Console.Error.WriteLine(ex);
            Toasts.ShowError("Não foi possível carregar a lista de times.");
        }
    }

    private async Task ApplyFiltersAsync()
    {
        await LoadAsync(1);
    }

    private async Task ClearFiltersAsync()
    {
        _filter.TeamId = null;
        _filter.StartDate = null;
        _filter.EndDate = null;
        _filter.Query = null;
        _filter.PageSize = 20;
        _selectedPlayer = null;
        _playerSearch = null;
        _playerSuggestions.Clear();

        await LoadAsync(1);
    }

    private async Task LoadAsync(int page = 1)
    {
        if (!AdminAuth.IsAuthenticated)
        {
            return;
        }

        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();

        _isLoading = true;
        _error = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var request = new TransferHistoryQueryRequest
            {
                TeamId = _filter.TeamId,
                PlayerId = _selectedPlayer?.PlayerId,
                DateFromUtc = _filter.StartDate.HasValue ? BrazilTime.ConvertToUtc(_filter.StartDate.Value) : null,
                DateToUtc = _filter.EndDate.HasValue ? BrazilTime.ConvertToUtc(_filter.EndDate.Value.AddDays(1).AddTicks(-1)) : null,
                Query = _filter.Query,
                Page = page,
                PageSize = Math.Clamp(_filter.PageSize, 5, 100)
            };

            _transfers = await TransfersClient.QueryAsync(request, _loadCts.Token).ConfigureAwait(false);
            _currentPage = _transfers.Page;
        }
        catch (OperationCanceledException)
        {
            // ignorado
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
            Toasts.ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            _error = "Não foi possível carregar o histórico de transferências.";
            Toasts.ShowError(_error);
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private IEnumerable<TransferListItemDto> GetSortedItems()
    {
        if (_transfers is null)
        {
            return Array.Empty<TransferListItemDto>();
        }

        var items = _transfers.Items.AsEnumerable();
        return (_sortColumn, _sortDescending) switch
        {
            (nameof(TransferSort.Player), true) => items.OrderByDescending(i => i.PlayerName, StringComparer.CurrentCultureIgnoreCase),
            (nameof(TransferSort.Player), false) => items.OrderBy(i => i.PlayerName, StringComparer.CurrentCultureIgnoreCase),
            (nameof(TransferSort.FromTeam), true) => items.OrderByDescending(i => i.FromTeamName, StringComparer.CurrentCultureIgnoreCase),
            (nameof(TransferSort.FromTeam), false) => items.OrderBy(i => i.FromTeamName, StringComparer.CurrentCultureIgnoreCase),
            (nameof(TransferSort.ToTeam), true) => items.OrderByDescending(i => i.ToTeamName, StringComparer.CurrentCultureIgnoreCase),
            (nameof(TransferSort.ToTeam), false) => items.OrderBy(i => i.ToTeamName, StringComparer.CurrentCultureIgnoreCase),
            (nameof(TransferSort.Amount), true) => items.OrderByDescending(i => i.Amount),
            (nameof(TransferSort.Amount), false) => items.OrderBy(i => i.Amount),
            _ when _sortDescending => items.OrderByDescending(i => i.OccurredAtUtc),
            _ => items.OrderBy(i => i.OccurredAtUtc)
        };
    }

    private void ChangeSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortColumn = column;
            _sortDescending = column == nameof(TransferSort.Date);
        }
    }

    private string SortIcon(string column)
    {
        if (_sortColumn != column)
        {
            return string.Empty;
        }

        return _sortDescending ? "▼" : "▲";
    }

    private async Task OnPlayerSearchChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value) || value.Length < 2)
        {
            _playerSuggestions.Clear();
            _selectedPlayer = null;
            return;
        }

        _playerSearchCts?.Cancel();
        _playerSearchCts?.Dispose();
        _playerSearchCts = new CancellationTokenSource(TimeSpan.FromSeconds(5));

        try
        {
            var result = await PlayersApiClient.GetAsync(value.Trim(), null, false, null, null, null, null, 1, 10, _playerSearchCts.Token).ConfigureAwait(false);
            _playerSuggestions.Clear();
            _playerSuggestions.AddRange(result.Items.Select(p => new PlayerSuggestion(p.PlayerId, p.Name, p.Position, p.Overall)));
        }
        catch (OperationCanceledException)
        {
            // ignorado
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            Toasts.ShowError("Falha ao buscar jogadores.");
        }
    }

    private void SelectPlayer(PlayerSuggestion suggestion)
    {
        _selectedPlayer = suggestion;
        _playerSearch = suggestion.Name;
        _playerSuggestions.Clear();
    }

    private void ClearSelectedPlayer()
    {
        _selectedPlayer = null;
        _playerSearch = null;
        _playerSuggestions.Clear();
    }

    private void OnAuthenticationChanged()
    {
        InvokeAsync(async () =>
        {
            if (!AdminAuth.IsAuthenticated)
            {
                _transfers = null;
                _error = null;
                CancelPendingRequests();
            }
            else
            {
                await LoadInitialDataAsync();
            }
        });
    }

    private void CancelPendingRequests()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;

        _playerSearchCts?.Cancel();
        _playerSearchCts?.Dispose();
        _playerSearchCts = null;
    }

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
        CancelPendingRequests();
    }

    private enum TransferSort
    {
        Date,
        Player,
        FromTeam,
        ToTeam,
        Amount
    }

    private sealed class PlayerSuggestion
    {
        public PlayerSuggestion(int playerId, string name, string position, int overall)
        {
            PlayerId = playerId;
            Name = name;
            Position = position;
            Overall = overall;
        }

        public int PlayerId { get; }
        public string Name { get; }
        public string Position { get; }
        public int Overall { get; }
    }

    private sealed class TransferHistoryFilterModel : IValidatableObject
    {
        public Guid? TeamId { get; set; }

        public DateTime? StartDate { get; set; }

        public DateTime? EndDate { get; set; }

        public string? Query { get; set; }

        [Range(5, 100, ErrorMessage = "Informe um valor entre 5 e 100.")]
        public int PageSize { get; set; } = 20;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (StartDate.HasValue && EndDate.HasValue && StartDate > EndDate)
            {
                yield return new ValidationResult(
                    "A data inicial deve ser anterior à data final.",
                    new[] { nameof(StartDate), nameof(EndDate) });
            }
        }
    }
}
