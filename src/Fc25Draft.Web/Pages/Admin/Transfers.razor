    private sealed class SellFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "Time vendedor é obrigatório.")]
        public Guid FromTeamId { get; set; }

        [Required(ErrorMessage = "Time comprador é obrigatório.")]
        public Guid ToTeamId { get; set; }

        [Range(typeof(decimal), "0", "79228162514264337593543950335", ErrorMessage = "O valor não pode ser negativo.")]
        public decimal Amount { get; set; }

        [Required(ErrorMessage = "Motivo é obrigatório.")]
        [StringLength(200, ErrorMessage = "Motivo deve ter até 200 caracteres.")]
        public string? Reason { get; set; }

        public List<Guid> SelectedPlayerIds { get; set; } = new();

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (FromTeamId != Guid.Empty && FromTeamId == ToTeamId)
            {
                yield return new ValidationResult("Selecione times diferentes.", new[] { nameof(ToTeamId) });
            }
        }
    }

    private sealed class SwapFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "Selecione o Time A.")]
        public Guid TeamAId { get; set; }

        [Required(ErrorMessage = "Selecione o Time B.")]
