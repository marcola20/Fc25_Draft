        [Range(typeof(decimal), "0", "79228162514264337593543950335", ErrorMessage = "O ajuste não pode ser negativo.")]
        public decimal CashAdjustFromAToB { get; set; }

        [Required(ErrorMessage = "Motivo é obrigatório.")]
        [StringLength(200, ErrorMessage = "Motivo deve ter até 200 caracteres.")]
        public string? Reason { get; set; }

        public List<Guid> PlayersFromA { get; set; } = new();
        public List<Guid> PlayersFromB { get; set; } = new();

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (TeamAId != Guid.Empty && TeamAId == TeamBId)
            {
                yield return new ValidationResult("Selecione times diferentes.", new[] { nameof(TeamBId) });
            }
        }
    }

