@page "/admin/lineups"
@page "/admin/escalacoes"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Utilities
@using Fc25Draft.Web.Models.Navigation
@using Fc25Draft.Web.Utilities
@using System.Linq
@using Microsoft.AspNetCore.Authorization
@inject AdminAuthService AdminAuth
@inject AdminLineupsApiClient AdminLineupsApiClient
@inject TeamsApiClient TeamsApiClient
@inject LayoutState LayoutState
@inject ILogger<Fc25Draft.Web.Pages.Admin.Lineups> Logger

@attribute [Authorize(Roles = "Admin")]
@implements IDisposable

<PageHeader Title="Escalações (Admin)"
            Subtitle="Visualize as escalações salvas por cada equipe." />

@if (!AdminAuth.IsAdmin)
{
    <div class="alert alert-warning" role="alert">
        Entre como administrador para consultar as escalações das equipes.
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6 col-lg-4">
                    <label class="form-label" for="team-filter">Equipe</label>
                    <select id="team-filter"
                            class="form-select"
                            value="@TeamFilterValue"
                            @onchange="OnTeamFilterChanged"
                            disabled="@isLoading">
                        <option value="">Todas as equipes</option>
                        @foreach (var team in teams)
                        {
                            <option value="@team.TeamId">@team.TeamName (@team.Jogadores)</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 col-lg-8 text-md-end">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="OnReloadRequested"
                            disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Carregando...</span>
                        }
                        else
                        {
                            <span>Recarregar</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>

    if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    else if (isLoading && lineups.Count == 0)
    {
        <div class="alert alert-info" role="status">Carregando escalações...</div>
    }
    else if (lineups.Count == 0)
    {
        <div class="alert alert-warning" role="status">Nenhuma escalação encontrada para o filtro selecionado.</div>
    }
    else
    {
        @foreach (var lineup in lineups)
        {
            var showDetails = IsDetailsVisible(lineup.LineupId);
            var autoSubLabel = LineupLabels.AutoSubstitution(lineup.AutoSubstitution);
            <div class="card mb-3">
                <div class="card-header">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                        <div class="me-auto">
                            <div class="fw-semibold">@lineup.TeamName</div>
                            <div class="text-muted small @(Changed(lineup, "Geral", "Formação") ? "lineup-changed" : "")">@lineup.LineupName • Formação @lineup.Formation</div>
                            <div class="text-muted small @(Changed(lineup, "Geral", "Substituições automáticas") ? "lineup-changed" : "")">Sub. automáticas: @autoSubLabel</div>
                        </div>
                        <div class="text-end ms-auto">
                            @if (lineup.IsActive)
                            {
                                <span class="badge bg-success">Ativa</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inativa</span>
                            }
                            <div class="text-muted small mt-1">
                                Atualizada em @BrazilTime.FormatDateTime(lineup.UpdatedAtUtc)
                            </div>
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary mt-2"
                                    @onclick="() => ToggleDetails(lineup.LineupId)"
                                    aria-expanded="@showDetails">
                                @(showDetails ? "Ocultar detalhes" : "Mostrar detalhes")
                            </button>
                        </div>
                    </div>
                </div>
                @if (lineup.LastChange is not null && lineup.LastChange.Changes.Count > 0)
                {
                    <div class="lineup-changes-banner">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                            <div class="lineup-changes-banner-title mb-0">
                                🔔 Mudanças desde a última vez que você viu
                            </div>
                            <button type="button"
                                    class="btn btn-sm btn-outline-success"
                                    @onclick="() => AcknowledgeAsync(lineup.LineupId)"
                                    disabled="@IsAcknowledging(lineup.LineupId)">
                                @(IsAcknowledging(lineup.LineupId) ? "Marcando..." : "✓ Marcar como visto")
                            </button>
                        </div>
                        <ul class="lineup-changes-list mb-0 mt-2">
                            @foreach (var change in lineup.LastChange.Changes)
                            {
                                <li>
                                    <strong>@change.Field:</strong>
                                    @(change.OldValue ?? "—") → @(change.NewValue ?? "—")
                                </li>
                            }
                        </ul>
                    </div>
                }
                @if (showDetails)
                {
                    <div class="card-body">
                        <div class="row g-4">
                            <div class="col-12 col-lg-4">
                                <h6 class="text-uppercase text-muted small mb-2">Titulares</h6>
                                <ul class="list-unstyled mb-0">
                                    @foreach (var starter in lineup.Starters.OrderBy(s => s.Order))
                                    {
                                        <li class="mb-1 @(Changed(lineup, "Titular", starter.DisplayName) ? "lineup-changed" : "")">
                                            <strong>@starter.DisplayName:</strong>
                                            <span>@FormatPlayer(starter.Player)</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                            <div class="col-12 col-lg-4">
                                <h6 class="text-uppercase text-muted small mb-2">Reservas</h6>
                                <ul class="list-unstyled mb-0">
                                    @foreach (var sub in lineup.Bench.OrderBy(s => s.Order))
                                    {
                                        <li class="mb-1 @(Changed(lineup, "Reserva", sub.DisplayName) ? "lineup-changed" : "")">
                                            <strong>@sub.DisplayName:</strong>
                                            <span>@FormatPlayer(sub.Player)</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                            <div class="col-12 col-lg-4">
                                <h6 class="text-uppercase text-muted small mb-2">Funções especiais</h6>
                                <ul class="list-unstyled mb-0">
                                    <li class="@(Changed(lineup, "Função especial", "Capitão") ? "lineup-changed" : "")"><strong>Capitão:</strong> @FormatRolePlayer(lineup.Roles.Captain)</li>
                                    <li class="@(Changed(lineup, "Função especial", "Falta curta") ? "lineup-changed" : "")"><strong>Falta curta:</strong> @FormatRolePlayer(lineup.Roles.ShortFreeKick1)</li>
                                    <li class="@(Changed(lineup, "Função especial", "Falta curta 2") ? "lineup-changed" : "")"><strong>Falta curta 2:</strong> @FormatRolePlayer(lineup.Roles.ShortFreeKick2)</li>
                                    <li class="@(Changed(lineup, "Função especial", "Falta longa") ? "lineup-changed" : "")"><strong>Falta longa:</strong> @FormatRolePlayer(lineup.Roles.LongFreeKick)</li>
                                    <li class="@(Changed(lineup, "Função especial", "Pênaltis") ? "lineup-changed" : "")"><strong>Pênaltis:</strong> @FormatRolePlayer(lineup.Roles.Penalties)</li>
                                    <li class="@(Changed(lineup, "Função especial", "Escanteio esq.") ? "lineup-changed" : "")"><strong>Escanteio esq.:</strong> @FormatRolePlayer(lineup.Roles.CornerLeft)</li>
                                    <li class="@(Changed(lineup, "Função especial", "Escanteio dir.") ? "lineup-changed" : "")"><strong>Escanteio dir.:</strong> @FormatRolePlayer(lineup.Roles.CornerRight)</li>
                                </ul>

                                <h6 class="text-uppercase text-muted small mt-3 mb-2">Jogadores que atacam</h6>
                                <ul class="list-unstyled mb-0">
                                    <li class="@(Changed(lineup, "Função especial", "Ataque 1") ? "lineup-changed" : "")"><strong>Ataque 1:</strong> @FormatRolePlayer(lineup.Roles.AttackingPlayer1)</li>
                                    <li class="@(Changed(lineup, "Função especial", "Ataque 2") ? "lineup-changed" : "")"><strong>Ataque 2:</strong> @FormatRolePlayer(lineup.Roles.AttackingPlayer2)</li>
                                    <li class="@(Changed(lineup, "Função especial", "Ataque 3") ? "lineup-changed" : "")"><strong>Ataque 3:</strong> @FormatRolePlayer(lineup.Roles.AttackingPlayer3)</li>
                                </ul>
                            </div>

                            @if (lineup.OffensiveInstructions is not null)
                            {
                                <div class="col-12 col-lg-6">
                                    <h6 class="text-uppercase text-muted small mb-2">Instruções Ofensivas</h6>
                                    <ul class="list-unstyled mb-0">
                                        <li class="@(Changed(lineup, "Instrução ofensiva", "Estilo") ? "lineup-changed" : "")"><strong>Estilo:</strong> @LineupLabels.OffensiveStyle(lineup.OffensiveInstructions.OffensiveStyle)</li>
                                        <li class="@(Changed(lineup, "Instrução ofensiva", "Provocador") ? "lineup-changed" : "")"><strong>Provocador:</strong> @LineupLabels.Playmaker(lineup.OffensiveInstructions.Playmaker)</li>
                                        <li class="@(Changed(lineup, "Instrução ofensiva", "Área de ataque") ? "lineup-changed" : "")"><strong>Área de ataque:</strong> @LineupLabels.AttackArea(lineup.OffensiveInstructions.AttackArea)</li>
                                        <li class="@(Changed(lineup, "Instrução ofensiva", "Posicionamento") ? "lineup-changed" : "")"><strong>Posicionamento:</strong> @LineupLabels.Positioning(lineup.OffensiveInstructions.Positioning)</li>
                                        <li class="@(Changed(lineup, "Instrução ofensiva", "Alcance de apoio") ? "lineup-changed" : "")"><strong>Alcance de apoio:</strong> @lineup.OffensiveInstructions.SupportRange</li>
                                    </ul>
                                </div>
                            }

                            @if (lineup.DefensiveInstructions is not null)
                            {
                                <div class="col-12 col-lg-6">
                                    <h6 class="text-uppercase text-muted small mb-2">Instruções Defensivas</h6>
                                    <ul class="list-unstyled mb-0">
                                        <li class="@(Changed(lineup, "Instrução defensiva", "Estilo") ? "lineup-changed" : "")"><strong>Estilo:</strong> @LineupLabels.DefensiveStyle(lineup.DefensiveInstructions.DefensiveStyle)</li>
                                        <li class="@(Changed(lineup, "Instrução defensiva", "Área de contenção") ? "lineup-changed" : "")"><strong>Área de contenção:</strong> @LineupLabels.ContainmentArea(lineup.DefensiveInstructions.ContainmentArea)</li>
                                        <li class="@(Changed(lineup, "Instrução defensiva", "Pressão") ? "lineup-changed" : "")"><strong>Pressão:</strong> @LineupLabels.Pressure(lineup.DefensiveInstructions.Pressure)</li>
                                        <li class="@(Changed(lineup, "Instrução defensiva", "Linha defensiva") ? "lineup-changed" : "")"><strong>Linha defensiva:</strong> @lineup.DefensiveInstructions.DefensiveLine</li>
                                        <li class="@(Changed(lineup, "Instrução defensiva", "Densidade") ? "lineup-changed" : "")"><strong>Densidade:</strong> @lineup.DefensiveInstructions.Density</li>
                                    </ul>
                                </div>
                            }

                            @if (lineup.AdvancedInstructions is not null)
                            {
                                <div class="col-12">
                                    <h6 class="text-uppercase text-muted small mb-2">Instruções Avançadas</h6>
                                    <div class="row g-3">
                                        <div class="col-12 col-lg-6">
                                            <ul class="list-unstyled mb-0">
                                                <li class="@(Changed(lineup, "Instrução avançada", "Ataque 1") ? "lineup-changed" : "")">
                                                    <strong>Ataque 1:</strong> @LineupLabels.AdvancedAttack(lineup.AdvancedInstructions.Attack1)
                                                    @if (lineup.AdvancedInstructions.AttackPlayer1 is not null)
                                                    {
                                                        <span class="text-muted"> — @FormatPlayer(lineup.AdvancedInstructions.AttackPlayer1)</span>
                                                    }
                                                </li>
                                                <li class="@(Changed(lineup, "Instrução avançada", "Ataque 2") ? "lineup-changed" : "")">
                                                    <strong>Ataque 2:</strong> @LineupLabels.AdvancedAttack(lineup.AdvancedInstructions.Attack2)
                                                    @if (lineup.AdvancedInstructions.AttackPlayer2 is not null)
                                                    {
                                                        <span class="text-muted"> — @FormatPlayer(lineup.AdvancedInstructions.AttackPlayer2)</span>
                                                    }
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="col-12 col-lg-6">
                                            <ul class="list-unstyled mb-0">
                                                <li class="@(Changed(lineup, "Instrução avançada", "Defesa 1") ? "lineup-changed" : "")">
                                                    <strong>Defesa 1:</strong> @LineupLabels.AdvancedDefense(lineup.AdvancedInstructions.Defense1)
                                                    @if (lineup.AdvancedInstructions.DefensePlayer1 is not null)
                                                    {
                                                        <span class="text-muted"> — @FormatPlayer(lineup.AdvancedInstructions.DefensePlayer1)</span>
                                                    }
                                                </li>
                                                <li class="@(Changed(lineup, "Instrução avançada", "Defesa 2") ? "lineup-changed" : "")">
                                                    <strong>Defesa 2:</strong> @LineupLabels.AdvancedDefense(lineup.AdvancedInstructions.Defense2)
                                                    @if (lineup.AdvancedInstructions.DefensePlayer2 is not null)
                                                    {
                                                        <span class="text-muted"> — @FormatPlayer(lineup.AdvancedInstructions.DefensePlayer2)</span>
                                                    }
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
}

@code {
    private readonly PageDefinition pageDefinition = new()
    {
        Title = "Escalações (Admin)",
        Breadcrumbs = new List<BreadcrumbSegment>
        {
            new("Início", "/home"),
            new("Escalações (Admin)")
        }
    };

    private readonly List<TeamListItemDto> teams = new();
    private readonly List<AdminLineupOverviewDto> lineups = new();
    private readonly Dictionary<Guid, bool> lineupDetailsState = new();
    private readonly HashSet<Guid> acknowledgingLineupIds = new();
    private bool isLoading = true;
    private string? errorMessage;
    private Guid selectedTeamId = Guid.Empty;
    private bool teamsLoaded;
    private CancellationTokenSource? loadCts;

    private string TeamFilterValue => selectedTeamId == Guid.Empty ? string.Empty : selectedTeamId.ToString();

    protected override void OnInitialized()
    {
        LayoutState.SetPage(pageDefinition);
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await AdminAuth.EnsureInitializedAsync();
        if (AdminAuth.IsAdmin) await ReloadAsync();
        else isLoading = false;
    }

    private async Task ReloadAsync()
    {
        loadCts?.Cancel();
        loadCts?.Dispose();
        loadCts = new CancellationTokenSource();
        await LoadAsync(loadCts.Token);
    }

    private async Task LoadAsync(CancellationToken ct)
    {
        if (!AdminAuth.IsAdmin) { lineups.Clear(); lineupDetailsState.Clear(); isLoading = false; return; }

        isLoading = true;
        errorMessage = null;

        try
        {
            if (!teamsLoaded)
            {
                await LoadTeamsAsync(ct);
                teamsLoaded = true;
                if (selectedTeamId != Guid.Empty && teams.All(t => t.TeamId != selectedTeamId))
                    selectedTeamId = Guid.Empty;
            }
            await LoadLineupsAsync(ct);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AdminLineups: erro ao carregar dados para o time {TeamId}", selectedTeamId);
            errorMessage = "Não foi possível carregar as escalações. Tente novamente em instantes.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadTeamsAsync(CancellationToken ct)
    {
        const int pageSize = 50;
        var allTeams = new List<TeamListItemDto>();
        var page = 1;
        while (true)
        {
            var result = await TeamsApiClient.GetAsync(null, page, pageSize, ct);
            if (result.Items.Count == 0) break;
            allTeams.AddRange(result.Items);
            if (allTeams.Count >= result.Total) break;
            page++;
        }
        teams.Clear();
        teams.AddRange(allTeams.OrderBy(t => t.TeamName));
    }

    private async Task LoadLineupsAsync(CancellationToken ct)
    {
        var filter = selectedTeamId == Guid.Empty ? (Guid?)null : selectedTeamId;
        var fetched = await AdminLineupsApiClient.GetLineupsAsync(filter, ct);
        lineups.Clear();
        lineups.AddRange(fetched
            .OrderByDescending(l => l.UpdatedAtUtc)
            .ThenByDescending(l => l.IsActive)
            .ThenBy(l => l.LineupName));
        UpdateDetailsState();
    }

    private void ToggleDetails(Guid lineupId)
    {
        var current = IsDetailsVisible(lineupId);
        lineupDetailsState[lineupId] = !current;
    }

    private bool IsDetailsVisible(Guid lineupId)
        => lineupDetailsState.TryGetValue(lineupId, out var show) && show;

    private void UpdateDetailsState()
    {
        var defaultExpanded = selectedTeamId != Guid.Empty;
        var previous = lineupDetailsState.ToDictionary(static kvp => kvp.Key, static kvp => kvp.Value);
        lineupDetailsState.Clear();
        foreach (var lineup in lineups)
        {
            if (previous.TryGetValue(lineup.LineupId, out var show))
                lineupDetailsState[lineup.LineupId] = show;
            else
                lineupDetailsState[lineup.LineupId] = defaultExpanded;
        }
    }

    private async Task OnTeamFilterChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        selectedTeamId = Guid.TryParse(value, out var parsed) ? parsed : Guid.Empty;
        await ReloadAsync();
    }

    private async Task OnReloadRequested() => await ReloadAsync();

    private void OnAuthenticationChanged()
    {
        InvokeAsync(async () =>
        {
            if (!AdminAuth.IsAdmin)
            {
                loadCts?.Cancel();
                lineups.Clear(); lineupDetailsState.Clear(); teams.Clear();
                teamsLoaded = false; isLoading = false; errorMessage = null;
                StateHasChanged();
                return;
            }
            await ReloadAsync();
        });
    }

    private static string FormatPlayer(TeamLineupSlotPlayerDto? player)
        => player is null ? "Não definido" : $"{player.Name} ({player.PositionName})";

    private static string FormatRolePlayer(TeamLineupSlotPlayerDto? player)
        => player is null ? "Melhor na função" : $"{player.Name} ({player.PositionName})";

    private static bool Changed(AdminLineupOverviewDto lineup, string category, string field)
        => lineup.LastChange?.Changes.Any(c => c.Category == category && c.Field == field) == true;

    private bool IsAcknowledging(Guid lineupId) => acknowledgingLineupIds.Contains(lineupId);

    private async Task AcknowledgeAsync(Guid lineupId)
    {
        if (!acknowledgingLineupIds.Add(lineupId)) return;
        StateHasChanged();

        try
        {
            await AdminLineupsApiClient.AcknowledgeAsync(lineupId);
            await LoadLineupsAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AdminLineups: erro ao marcar escalação {LineupId} como vista", lineupId);
            errorMessage = "Não foi possível marcar a escalação como vista. Tente novamente.";
        }
        finally
        {
            acknowledgingLineupIds.Remove(lineupId);
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        loadCts?.Cancel();
        loadCts?.Dispose();
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
    }
}

<style>
    .lineup-changes-banner {
        margin: 0 1rem;
        margin-top: 0.75rem;
        padding: 0.75rem 1rem;
        border-radius: 0.4rem;
        background: color-mix(in srgb, var(--bs-warning, #ffc107) 14%, var(--bs-body-bg, #fff));
        border: 1px solid color-mix(in srgb, var(--bs-warning, #ffc107) 40%, transparent);
    }

    .lineup-changes-banner-title {
        font-weight: 600;
        font-size: 0.85rem;
        margin-bottom: 0.4rem;
        color: var(--bs-emphasis-color, #212529);
    }

    .lineup-changes-list {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .lineup-changes-list li {
        font-size: 0.85rem;
        line-height: 1.4;
    }

    .lineup-changed {
        background: color-mix(in srgb, var(--bs-warning, #ffc107) 22%, transparent);
        border-radius: 0.25rem;
        padding: 0.1rem 0.35rem;
        margin: 0 -0.35rem;
    }
</style>
