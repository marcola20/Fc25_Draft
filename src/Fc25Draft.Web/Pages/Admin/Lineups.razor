@page "/admin/escalacoes"
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Authorization
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Web.Services
@using Fc25Draft.Web.Utilities
@inject AdminAuthService AdminAuth
@inject TeamsApiClient TeamsApiClient
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService
@inject ILogger<Fc25Draft.Web.Pages.Admin.Lineups> Logger

@attribute [Authorize(Roles = "Admin")]

@implements IDisposable

<PageHeader Title="Escalações dos Times"
            Subtitle="Visualize titulares, reservas e o código cadastrado para cada equipe." />

@if (!_authInitialized)
{
    <div class="alert alert-info" role="status">Carregando permissões de administrador...</div>
}
else if (!AdminAuth.IsAuthenticated)
{
    <div class="alert alert-warning" role="alert">
        Entre como administrador para visualizar as escalações dos times.
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label" for="team-search">Buscar time</label>
                    <input id="team-search"
                           class="form-control"
                           placeholder="Digite parte do nome do time"
                           @bind="_searchTerm"
                           @bind:event="oninput"
                           disabled="@_isLoading" />
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-primary" @onclick="async () => await LoadTeamsAsync(1)" disabled="@_isLoading">Pesquisar</button>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-outline-secondary" @onclick="ClearFilters" disabled="@_isLoading">Limpar</button>
                </div>
            </div>
        </div>
    </div>

    if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }
    else if (_isLoading && (_teams is null || _teams.Items.Count == 0))
    {
        <div class="alert alert-info" role="status">Carregando lista de times...</div>
    }
    else if (_teams is null || _teams.Items.Count == 0)
    {
        <div class="alert alert-warning" role="status">Nenhum time encontrado com os filtros atuais.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">Time</th>
                        <th scope="col" class="text-center">Jogadores</th>
                        <th scope="col" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var team in TeamItems)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@team.TeamName</div>
                            @if (!string.IsNullOrWhiteSpace(team.OwnerName))
                            {
                                <div class="text-muted small">Responsável: @team.OwnerName</div>
                            }
                        </td>
                        <td class="text-center">@team.Jogadores</td>
                        <td class="text-end">
                            <button type="button"
                                    class="btn btn-outline-primary btn-sm"
                                    disabled="@_isLoading"
                                    @onclick="async () => await OpenLineupModalAsync(team)">
                                Escalação
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (HasMultiplePages)
        {
            <nav aria-label="Paginação de times" class="mt-2">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(_currentPage == 1 ? "disabled" : null)">
                        <button class="page-link" @onclick="async () => await ChangePageAsync(_currentPage - 1)" disabled="@(_currentPage == 1)">Anterior</button>
                    </li>
                    @for (var page = 1; page <= TotalPages; page++)
                    {
                        <li class="page-item @(page == _currentPage ? "active" : null)">
                            <button class="page-link" @onclick="async () => await ChangePageAsync(page)">@(page)</button>
                        </li>
                    }
                    <li class="page-item @(_currentPage >= TotalPages ? "disabled" : null)">
                        <button class="page-link" @onclick="async () => await ChangePageAsync(_currentPage + 1)" disabled="@(_currentPage >= TotalPages)">Próxima</button>
                    </li>
                </ul>
            </nav>
        }
    }
}

@if (_showModal && _selectedTeam is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0, 0, 0, 0.5);" @onclick="CloseModal">
        <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Escalação de @_selectedTeam.TeamName</h5>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (_isModalLoading)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <div class="spinner-border" role="status" aria-hidden="true"></div>
                            <span>Carregando escalação...</span>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_modalError))
                    {
                        <div class="alert alert-warning" role="alert">@_modalError</div>
                    }
                    else if (_selectedLineup is null)
                    {
                        <div class="alert alert-info" role="status">Nenhuma escalação ativa cadastrada para este time.</div>
                    }
                    else
                    {
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <strong>Nome da escalação:</strong>
                                <div>@_selectedLineup.Name</div>
                            </div>
                            <div class="col-md-2">
                                <strong>Formação:</strong>
                                <div>@_selectedLineup.FormationCode</div>
                            </div>
                            <div class="col-md-3">
                                <strong>Código da tática:</strong>
                                <div>@_selectedLineup.TacticCode</div>
                            </div>
                            <div class="col-md-3">
                                <strong>Atualizado em:</strong>
                                <div>@BrazilTime.FormatDateTimeLocal(_selectedLineup.UpdatedAtUtc)</div>
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <strong>Código da escalação:</strong>
                                <div class="text-truncate">@_selectedLineup.LineupId</div>
                            </div>
                            <div class="col-md-6">
                                <strong>Observação:</strong>
                                <div>@(!string.IsNullOrWhiteSpace(_selectedLineup.Observation) ? _selectedLineup.Observation : "—")</div>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <h6 class="text-uppercase text-muted">Titulares</h6>
                                <ul class="list-group list-group-flush">
                                    @foreach (var slot in GetLineupSlots(0))
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="fw-semibold">@slot.PositionLabel</div>
                                                <div class="text-muted small">Slot #@slot.Order</div>
                                            </div>
                                            <div class="text-end">
                                                <div>@(slot.PlayerName ?? "—")</div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-uppercase text-muted">Reservas</h6>
                                <ul class="list-group list-group-flush">
                                    @foreach (var item in GetLineupSlots(1).Select((slot, index) => new { Slot = slot, Index = index + 1 }))
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="fw-semibold">@GetReserveLabel(item.Index)</div>
                                                <div class="text-muted small">Posição original: @item.Slot.PositionLabel</div>
                                            </div>
                                            <div class="text-end">
                                                <div>@(item.Slot.PlayerName ?? "—")</div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>

                        <div class="row g-4 mt-3">
                            <div class="col-md-6">
                                <h6 class="text-uppercase text-muted">Funções especiais</h6>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Capitão</span>
                                        <span class="fw-semibold">@(_selectedLineup.SpecialRoles.CaptainPlayerName ?? "—")</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Falta perto (esquerda)</span>
                                        <span class="fw-semibold">@(_selectedLineup.SpecialRoles.ShortFreeKickLeftPlayerName ?? "—")</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Falta perto (direita)</span>
                                        <span class="fw-semibold">@(_selectedLineup.SpecialRoles.ShortFreeKickRightPlayerName ?? "—")</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Falta de longe</span>
                                        <span class="fw-semibold">@(_selectedLineup.SpecialRoles.LongFreeKickPlayerName ?? "—")</span>
                                    </li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-uppercase text-muted">Bolas paradas</h6>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Pênaltis</span>
                                        <span class="fw-semibold">@(_selectedLineup.SpecialRoles.PenaltyKickPlayerName ?? "—")</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Escanteio esquerdo</span>
                                        <span class="fw-semibold">@(_selectedLineup.SpecialRoles.LeftCornerPlayerName ?? "—")</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Escanteio direito</span>
                                        <span class="fw-semibold">@(_selectedLineup.SpecialRoles.RightCornerPlayerName ?? "—")</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="async () => await RefreshModalAsync()" disabled="@_isModalLoading">
                        Recarregar
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="CloseModal">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const int PageSize = 25;
    private bool _authInitialized;
    private bool _isLoading = true;
    private string? _errorMessage;
    private PagedResult<TeamListItemDto>? _teams;
    private int _currentPage = 1;
    private string? _searchTerm;

    private bool _showModal;
    private bool _isModalLoading;
    private string? _modalError;
    private TeamListItemDto? _selectedTeam;
    private TeamLineupResponse? _selectedLineup;

    protected override void OnInitialized()
    {
        LayoutState.SetPage(
            NavigationService.GetPageDefinition("/admin/escalacoes"),
            subtitle: "Consulte rapidamente a escalação ativa e o código informado por cada equipe.");
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AdminAuth.EnsureInitializedAsync();
        _authInitialized = true;

        if (AdminAuth.IsAuthenticated)
        {
            await LoadTeamsAsync();
        }
        else
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private IReadOnlyList<TeamListItemDto> TeamItems => _teams?.Items ?? Array.Empty<TeamListItemDto>();

    private int TotalPages => _teams is null || _teams.PageSize <= 0
        ? 1
        : (int)Math.Ceiling((double)_teams.Total / _teams.PageSize);

    private bool HasMultiplePages => _teams is not null && TotalPages > 1;

    private async Task LoadTeamsAsync(int page = 1)
    {
        if (!AdminAuth.IsAuthenticated)
        {
            return;
        }

        _isLoading = true;
        _errorMessage = null;

        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await TeamsApiClient.GetAsync(_searchTerm, page, PageSize);
            _teams = result;
            _currentPage = result.Page;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            Logger.LogError(ex, "Erro ao carregar times para a visualização de escalações.");
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ChangePageAsync(int page)
    {
        if (_teams is null)
        {
            return;
        }

        if (page < 1 || page > TotalPages || page == _currentPage)
        {
            return;
        }

        await LoadTeamsAsync(page);
    }

    private async Task ClearFilters()
    {
        _searchTerm = string.Empty;
        await LoadTeamsAsync(1);
    }

    private IEnumerable<LineupSlotResponse> GetLineupSlots(byte role)
    {
        if (_selectedLineup is null)
        {
            return Array.Empty<LineupSlotResponse>();
        }

        return _selectedLineup.Slots
            .Where(s => s.Role == role)
            .OrderBy(s => s.Order)
            .ToList();
    }

    private static string GetReserveLabel(int index) => $"Reserva {index}";

    private async Task OpenLineupModalAsync(TeamListItemDto team)
    {
        _selectedTeam = team;
        _modalError = null;
        _selectedLineup = null;
        _showModal = true;
        _isModalLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var lineup = await TeamsApiClient.GetActiveLineupAsync(team.TeamId);
            if (lineup is null)
            {
                _modalError = "O time não possui uma escalação ativa.";
            }
            else
            {
                _selectedLineup = lineup;
            }
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
            Logger.LogError(ex, "Erro ao carregar escalação do time {TeamId}.", team.TeamId);
        }
        finally
        {
            _isModalLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshModalAsync()
    {
        if (_selectedTeam is null)
        {
            return;
        }

        await OpenLineupModalAsync(_selectedTeam);
    }

    private void CloseModal()
    {
        _showModal = false;
        _isModalLoading = false;
        _modalError = null;
        _selectedLineup = null;
        _selectedTeam = null;
    }

    private void OnAuthenticationChanged()
    {
        InvokeAsync(async () =>
        {
            if (!AdminAuth.IsAuthenticated)
            {
                _teams = null;
                _errorMessage = null;
                _isLoading = false;
                _showModal = false;
                _selectedLineup = null;
                _selectedTeam = null;
                StateHasChanged();
            }
            else
            {
                await LoadTeamsAsync(1);
            }
        });
    }

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
    }
}
