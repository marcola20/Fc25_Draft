@page "/admin/temporada"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Interfaces
@using Fc25Draft.Core.Utilities
@using Fc25Draft.Web.Utilities
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject ILigaTemporadaService TemporadaSvc
@inject IJSRuntime JSRuntime
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService

<PageTitle>Virada de Temporada</PageTitle>

<div class="container-fluid py-3">
    @if (_erro is not null)
    {
        <div class="alert alert-danger alert-dismissible">@_erro<button type="button" class="btn-close" @onclick="() => _erro = null"></button></div>
    }
    @if (_ok is not null)
    {
        <div class="alert alert-success alert-dismissible">@_ok<button type="button" class="btn-close" @onclick="() => _ok = null"></button></div>
    }

    @if (_carregando)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    }
    else if (_temporadas.Count == 0)
    {
        <div class="alert alert-info">Nenhuma liga com temporada cadastrada.</div>
    }
    else
    {
        <div class="d-flex align-items-center gap-2 mb-3">
            <label class="form-label mb-0">Temporada</label>
            <select class="form-select w-auto" @onchange="OnTemporadaChanged">
                @foreach (var t in _temporadas)
                {
                    <option value="@t" selected="@(t == _temporada)">@t</option>
                }
            </select>
        </div>

        <IdadesCard />

        <EvolucaoTemporadaCard Temporada="@_temporada" />

        <AposentadoriaCard Temporada="@_temporada" />

        <div class="card mb-3">
            <div class="card-header fw-bold">Calendário</div>
            <div class="card-body">
                <p class="text-muted small mb-2">
                    A temporada abre no domingo da Supercopa, e é dessa data que saem todas as rodadas, as janelas de
                    transferência e o playoff (veja em <a href="/formato" target="_blank">Formato</a>). Para mudar só uma
                    rodada, use a aba Rodadas da competição.
                </p>
                <div class="d-flex flex-wrap align-items-end gap-3">
                    <div>
                        <label class="form-label">Abertura de @_temporada</label>
                        <input type="date" class="form-control" @bind="_abertura" />
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="remarcar" @bind="_remarcarRodadas" />
                        <label class="form-check-label" for="remarcar">Remarcar as rodadas ainda não jogadas</label>
                    </div>
                    <button class="btn btn-primary mb-1" @onclick="SalvarAbertura" disabled="@(_salvando || _abertura is null)">Salvar</button>
                </div>
                @if (_aberturaGravada is null)
                {
                    <div class="form-text text-warning">A abertura de @_temporada ainda não foi definida: o calendário não aparece e as rodadas ficam sem data.</div>
                }
            </div>
        </div>

        @if (_resumo is null)
        {
            <div class="alert alert-info">Temporada sem Série A ou Série B.</div>
        }
        else
        {
            <div class="row g-3 mb-3">
                <div class="col-12 col-lg-6">
                    <div class="card h-100">
                        <div class="card-header fw-bold">Divisões</div>
                        <ul class="list-group list-group-flush">
                            @foreach (var liga in new[] { _resumo.SerieA, _resumo.SerieB }.Where(l => l is not null))
                            {
                                <li class="list-group-item d-flex flex-wrap align-items-center gap-2">
                                    <span class="badge bg-dark">@LigaLabels.Competicao(liga!.Tipo, liga.Divisao)</span>
                                    <span class="fw-semibold">@liga.Nome</span>
                                    <span class="badge @(liga.Status == LigaStatus.Encerrada ? "bg-success" : "bg-warning text-dark")">
                                        @(liga.Status == LigaStatus.Encerrada ? "Encerrada" : "Em andamento")
                                    </span>
                                    <span class="text-muted small ms-auto">
                                        @(liga.Divisao == Divisao.SerieA ? "↓" : "↑")@(liga.VagasDiretas ?? 0) direto · @(liga.VagasPlayoff ?? 0) playoff
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="card h-100">
                        <div class="card-header fw-bold">Playoff de acesso</div>
                        <div class="card-body">
                            @if (_resumo.Playoffs.Count == 0)
                            {
                                <p class="text-muted small mb-2">
                                    Jogo único entre quem está logo acima da zona de queda na Série A e quem ficou logo abaixo do acesso na Série B.
                                    Ele não soma pontos e entra como rodada extra da Série A, onde você registra o placar (e os pênaltis, se empatar).
                                </p>
                                <button class="btn btn-primary" @onclick="CriarPlayoff" disabled="@(_salvando || !_resumo.PodeCriarPlayoff)">
                                    Criar playoff de acesso
                                </button>
                                @if (!_resumo.PodeCriarPlayoff)
                                {
                                    <div class="form-text">Disponível com as duas divisões encerradas e vaga de playoff configurada.</div>
                                }
                            }
                            else
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var p in _resumo.Playoffs)
                                    {
                                        <li class="list-group-item d-flex flex-wrap align-items-center gap-2 px-0">
                                            <span class="fw-semibold">@p.TimeSerieANome</span>
                                            <span class="fw-bold">@(p.Status == PartidaStatus.Agendada ? "vs" : $"{p.GolsSerieA} – {p.GolsSerieB}")</span>
                                            <span class="fw-semibold">@p.TimeSerieBNome</span>
                                            @if (p.VencedorNome is not null)
                                            {
                                                <span class="badge bg-success ms-auto">Vaga na Série A: @p.VencedorNome</span>
                                            }
                                            else if (p.Status == PartidaStatus.Encerrada)
                                            {
                                                <span class="badge bg-warning text-dark ms-auto">Empatado — registre os pênaltis</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary ms-auto">A disputar</span>
                                            }
                                        </li>
                                    }
                                </ul>
                                @if (_resumo.SerieA is not null)
                                {
                                    <a class="btn btn-sm btn-outline-secondary mt-2" href="@($"/admin/liga/{_resumo.SerieA.LigaId}?tab=rodadas")">Abrir rodadas da Série A</a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-bold">Supercopa</div>
                <div class="card-body">
                    @{ var sc = _resumo.Supercopa; }
                    @if (sc.ComSemifinal)
                    {
                        <p class="text-muted small mb-2">
                            O <strong>@sc.CampeaoSerieANome</strong> ganhou a Série A e a Copa: a Supercopa tem <strong>semifinal</strong>
                            entre o vice da Série A (@(sc.ViceSerieANome ?? "—")) e o vice da Copa (@(sc.ViceCopaNome ?? "—")),
                            e o vencedor enfrenta o @sc.CampeaoSerieANome na <strong>final</strong>.
                        </p>
                    }
                    else
                    {
                        <p class="text-muted small mb-2">
                            Jogo único entre o <strong>campeão da Série A</strong> e o <strong>campeão da Copa</strong> da temporada.
                        </p>
                    }

                    @if (sc.ComSemifinal)
                    {
                        @foreach (var jogo in sc.Jogos ?? [])
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <span class="badge bg-secondary">@jogo.Fase</span>
                                <span>@jogo.CasaNome</span>
                                <span class="fw-bold">@(jogo.Status == PartidaStatus.Agendada ? "x" : $"{jogo.GolsCasa} – {jogo.GolsFora}")</span>
                                <span>@jogo.ForaNome</span>
                                @if (jogo.VencedorNome is not null && jogo.Fase == "Semifinal")
                                {
                                    <span class="text-muted small">· @jogo.VencedorNome vai à final</span>
                                }
                            </div>
                        }
                        @if (sc.CampeaoNome is not null)
                        {
                            <span class="badge bg-warning text-dark mb-2">🏆 Campeão: @sc.CampeaoNome</span>
                        }
                    }
                    else
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="badge bg-success">Série A: @(sc.CampeaoSerieANome ?? "—")</span>
                            <span class="text-muted">x</span>
                            <span class="badge bg-primary">Copa: @(sc.CampeaoCopaNome ?? "—")</span>
                            @if (sc.GolsSerieA is not null)
                            {
                                <span class="fw-bold">@sc.GolsSerieA – @sc.GolsCopa</span>
                            }
                            @if (sc.CampeaoNome is not null)
                            {
                                <span class="badge bg-warning text-dark">🏆 Campeão: @sc.CampeaoNome</span>
                            }
                        </div>
                    }

                    @if (sc.LigaId is null)
                    {
                        <div class="d-flex flex-wrap align-items-end gap-2">
                            <div>
                                <label class="form-label">Nome</label>
                                <input class="form-control" @bind="_nomeSupercopa" placeholder="@($"Supercopa CBFV {_temporada}")" />
                            </div>
                            <div>
                                <label class="form-label">Data</label>
                                <input type="date" class="form-control" @bind="_dataSupercopa" />
                            </div>
                            <button class="btn btn-primary" @onclick="CriarSupercopa" disabled="@(_salvando || !sc.PodeCriar)">Criar Supercopa</button>
                        </div>
                        @if (sc.Impedimento is not null)
                        {
                            <div class="form-text">@sc.Impedimento</div>
                        }
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <a class="btn btn-sm btn-outline-secondary" href="@($"/admin/liga/{sc.LigaId}?tab=rodadas")">
                                Abrir @sc.Nome (@(sc.Status == LigaStatus.Encerrada ? "encerrada" : "registrar o jogo"))
                            </a>
                            @if (sc.PodeCriarFinal)
                            {
                                <button class="btn btn-sm btn-primary" @onclick="CriarFinalSupercopa" disabled="@_salvando">Criar a final</button>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-bold">Como a temporada termina</div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr><th>#</th><th>Time</th><th>Divisão</th><th>Situação</th><th>Próxima temporada</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var t in _resumo.Times)
                            {
                                <tr class="@ZonaEstilo.Linha(t.Zona)">
                                    <td>@t.Posicao</td>
                                    <td class="fw-semibold">@t.Nome</td>
                                    <td>@LigaLabels.DivisaoNome(t.Divisao)</td>
                                    <td>@t.Situacao</td>
                                    <td>@(t.DivisaoProxima is null ? "—" : LigaLabels.DivisaoNome(t.DivisaoProxima.Value))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card">
                <div class="card-header fw-bold">Gerar temporada @(_temporada + 1)</div>
                <div class="card-body">
                    @if (_resumo.Impedimento is not null)
                    {
                        <div class="alert alert-warning mb-3">@_resumo.Impedimento</div>
                    }

                    <div class="row g-2">
                        <div class="col-12 col-md-6">
                            <label class="form-label">Nome da Série A</label>
                            <input class="form-control" @bind="_nomeA" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Nome da Série B</label>
                            <input class="form-control" @bind="_nomeB" disabled="@(!_criarSerieB)" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label">Início</label>
                            <input type="date" class="form-control" @bind="_inicio" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label">Fim</label>
                            <input type="date" class="form-control" @bind="_fim" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label">Série A: caem / playoff</label>
                            <div class="d-flex gap-1">
                                <input type="number" min="0" class="form-control" @bind="_vagasDiretasA" />
                                <input type="number" min="0" class="form-control" @bind="_vagasPlayoffA" />
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label">Série B: sobem / playoff</label>
                            <div class="d-flex gap-1">
                                <input type="number" min="0" class="form-control" @bind="_vagasDiretasB" disabled="@(!_criarSerieB)" />
                                <input type="number" min="0" class="form-control" @bind="_vagasPlayoffB" disabled="@(!_criarSerieB)" />
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="criarB" @bind="_criarSerieB" />
                                <label class="form-check-label" for="criarB">Criar a Série B</label>
                            </div>
                        </div>
                    </div>

                    @if (_criarSerieB && _resumo.TimesSemDivisao.Count > 0)
                    {
                        <div class="mt-3">
                            <label class="form-label">Times que entram na Série B <span class="text-muted small">(não disputaram esta temporada)</span></label>
                            <div class="border rounded p-2" style="max-height: 14rem; overflow-y: auto">
                                @foreach (var t in _resumo.TimesSemDivisao)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="extra-@t.TimeId"
                                               checked="@_extras.Contains(t.TimeId)" @onchange="() => AlternarExtra(t.TimeId)" />
                                        <label class="form-check-label" for="extra-@t.TimeId">@t.Nome <span class="text-muted small">elenco @t.Elenco</span></label>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="alert alert-light border mt-3 mb-2 small">
                        Série A: <strong>@ContarProxima(Divisao.SerieA)</strong> times
                        @if (ContarProxima(Divisao.SerieA) != _resumo.Times.Count(t => t.Divisao == Divisao.SerieA))
                        {
                            <span class="text-warning">(hoje @_resumo.Times.Count(t => t.Divisao == Divisao.SerieA))</span>
                        }
                        ·
                        Série B: <strong>@(ContarProxima(Divisao.SerieB) + _extras.Count)</strong> times
                        @if (_resumo.Times.Any(t => t.DivisaoProxima is null))
                        {
                            <span class="text-warning">· @_resumo.Times.Count(t => t.DivisaoProxima is null) time(s) dependem do playoff</span>
                        }
                    </div>

                    <div class="border rounded p-2 mb-3 small">
                        <div class="fw-semibold mb-1">Mercado na virada</div>
                        <div class="text-muted mb-1">
                            @(_virada?.Emprestimos ?? 0) jogador(es) emprestado(s) voltam para os times donos.
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="zerarContadores" @bind="_zerarContadores" />
                            <label class="form-check-label" for="zerarContadores">
                                Zerar transferências, empréstimos e vendas rápidas usados na janela
                                <span class="text-muted">(@(_virada?.TimesComContador ?? 0) time(s) com algo usado)</span>
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="cancelarPropostas" @bind="_cancelarPropostas" />
                            <label class="form-check-label" for="cancelarPropostas">
                                Cancelar as propostas pendentes <span class="text-muted">(@(_virada?.PropostasPendentes ?? 0))</span>
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="limparLista" @bind="_limparLista" />
                            <label class="form-check-label" for="limparLista">
                                Tirar os jogadores da lista de transferências <span class="text-muted">(@(_virada?.JogadoresNaLista ?? 0))</span>
                            </label>
                        </div>
                        @if (_virada is { MinimosTemporarios.Count: > 0 })
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="removerMinimos" @bind="_removerMinimos" />
                                <label class="form-check-label" for="removerMinimos">
                                    Tirar o mínimo de elenco temporário de @string.Join(", ", _virada.MinimosTemporarios)
                                </label>
                            </div>
                        }
                    </div>

                    <button class="btn btn-success" @onclick="GerarProxima" disabled="@(_salvando || !_resumo.PodeGerarProxima)">
                        Gerar temporada @(_temporada + 1)
                    </button>
                </div>
            </div>
        }
    }
</div>

@code {
    private bool _carregando = true;
    private bool _salvando;
    private string? _erro, _ok;
    private IReadOnlyList<int> _temporadas = Array.Empty<int>();
    private int _temporada;
    private TemporadaResumoDto? _resumo;

    private string _nomeA = "", _nomeB = "";
    private DateTime _inicio = DateTime.Today, _fim = DateTime.Today.AddMonths(2);
    private int _vagasDiretasA = 1, _vagasPlayoffA = 1, _vagasDiretasB = 1, _vagasPlayoffB = 1;
    private bool _criarSerieB = true;
    private readonly HashSet<Guid> _extras = new();
    private TemporadaViradaMercadoDto? _virada;
    private bool _zerarContadores = true, _cancelarPropostas = true, _limparLista = true, _removerMinimos;
    private DateTime? _abertura, _aberturaGravada;
    private bool _remarcarRodadas = true;
    private string _nomeSupercopa = "";
    private DateTime _dataSupercopa = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/admin/temporada"));
        try
        {
            _temporadas = await TemporadaSvc.ListTemporadasAsync(CancellationToken.None);
            _temporada = _temporadas.FirstOrDefault();
            await CarregarAsync();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _carregando = false; }
    }

    private async Task CarregarAsync()
    {
        _aberturaGravada = _temporadas.Count == 0 ? null : await TemporadaSvc.GetAberturaAsync(_temporada, CancellationToken.None);
        _virada = await TemporadaSvc.GetViradaMercadoAsync(CancellationToken.None);
        _abertura = _aberturaGravada;
        _resumo = _temporadas.Count == 0 ? null : await TemporadaSvc.GetResumoAsync(_temporada, CancellationToken.None);
        _extras.Clear();
        if (_resumo is null) return;

        var proxima = _temporada + 1;
        _nomeA = ProximoNome(_resumo.SerieA?.Nome, proxima, "Série A");
        _nomeB = ProximoNome(_resumo.SerieB?.Nome, proxima, "Série B");
        _criarSerieB = true;
        _vagasDiretasA = _vagasPlayoffA = _vagasDiretasB = _vagasPlayoffB = 1;
    }

    /// <summary>Repete o nome da divisão trocando o ano; sem ano no nome, usa "Série X {temporada}".</summary>
    private static string ProximoNome(string? nomeAtual, int proximaTemporada, string padrao)
    {
        if (string.IsNullOrWhiteSpace(nomeAtual)) return $"{padrao} {proximaTemporada}";

        var comAno = System.Text.RegularExpressions.Regex.Replace(
            nomeAtual, @"(19|2[0-9])[0-9]{2}", proximaTemporada.ToString());

        return comAno == nomeAtual ? $"{nomeAtual} {proximaTemporada}" : comAno;
    }

    private async Task OnTemporadaChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var t)) return;
        _erro = null; _ok = null;
        _temporada = t;
        await CarregarAsync();
    }

    private void AlternarExtra(Guid timeId)
    {
        if (!_extras.Remove(timeId)) _extras.Add(timeId);
    }

    private int ContarProxima(Divisao divisao) => _resumo?.Times.Count(t => t.DivisaoProxima == divisao) ?? 0;

    private async Task SalvarAbertura()
    {
        if (_abertura is not DateTime abertura) return;
        if (_remarcarRodadas && !await JSRuntime.InvokeAsync<bool>("confirm",
                "As rodadas ainda não jogadas voltam para as datas do calendário, inclusive as que foram mudadas à mão. Continuar?"))
            return;

        _erro = null; _ok = null; _salvando = true;
        try
        {
            var remarcadas = await TemporadaSvc.DefinirAberturaAsync(_temporada, abertura, _remarcarRodadas, CancellationToken.None);
            _aberturaGravada = abertura;
            _ok = $"Abertura de {_temporada} em {abertura:dd/MM/yyyy}."
                + (_remarcarRodadas ? $" {remarcadas} rodada(s) remarcada(s)." : "");
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _salvando = false; }
    }

    private async Task CriarSupercopa()
    {
        _erro = null; _ok = null; _salvando = true;
        try
        {
            var liga = await TemporadaSvc.CriarSupercopaAsync(_temporada, _nomeSupercopa, _dataSupercopa, CancellationToken.None);
            _ok = $"{liga.Nome} criada. Registre o placar na rodada da competição.";
            _nomeSupercopa = "";
            await CarregarAsync();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _salvando = false; }
    }

    private async Task CriarFinalSupercopa()
    {
        _erro = null; _ok = null; _salvando = true;
        try
        {
            await TemporadaSvc.CriarFinalSupercopaAsync(_temporada, CancellationToken.None);
            _ok = "Final da Supercopa criada. Registre o placar na rodada 2 da competição.";
            await CarregarAsync();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _salvando = false; }
    }

    private async Task CriarPlayoff()
    {
        _erro = null; _ok = null; _salvando = true;
        try
        {
            var jogos = await TemporadaSvc.CriarPlayoffAcessoAsync(_temporada, CancellationToken.None);
            _ok = $"Playoff criado: {string.Join(", ", jogos.Select(j => $"{j.TimeSerieANome} x {j.TimeSerieBNome}"))}.";
            await CarregarAsync();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _salvando = false; }
    }

    private async Task GerarProxima()
    {
        if (_resumo is null) return;

        var resumoTimes = $"Série A com {ContarProxima(Divisao.SerieA)} times" +
                          (_criarSerieB ? $" e Série B com {ContarProxima(Divisao.SerieB) + _extras.Count}" : "");
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Gerar a temporada {_temporada + 1} ({resumoTimes})?")) return;

        _erro = null; _ok = null; _salvando = true;
        try
        {
            var criadas = await TemporadaSvc.GerarProximaTemporadaAsync(
                new GerarProximaTemporadaRequest(
                    _temporada, _nomeA, _nomeB, _inicio, _fim,
                    _vagasDiretasA, _vagasPlayoffA, _vagasDiretasB, _vagasPlayoffB,
                    _extras.ToList(), _criarSerieB,
                    _zerarContadores, _cancelarPropostas, _limparLista, _removerMinimos),
                CancellationToken.None);

            _ok = $"Temporada {_temporada + 1} criada: {string.Join(", ", criadas.Select(l => l.Nome))}. Gere as rodadas em Gerenciar Liga.";
            _temporadas = await TemporadaSvc.ListTemporadasAsync(CancellationToken.None);
            _temporada = _temporada + 1;
            await CarregarAsync();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _salvando = false; }
    }
}
