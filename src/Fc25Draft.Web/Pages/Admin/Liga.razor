@page "/admin/liga"
@page "/admin/liga/{LigaId:guid}"
@page "/admin/liga/{LigaId:guid}/rodada/{RodadaId:guid}"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Interfaces
@using Fc25Draft.Web.Components.Liga
@using Fc25Draft.Web.Models.Navigation
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject ILigaAdminService AdminSvc
@inject ILigaPublicService PublicSvc
@inject ITeamService TeamSvc
@inject NavigationManager Nav
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService

<PageTitle>Administração da Liga</PageTitle>

<div class="container-fluid py-3">
    <h1 class="h3 mb-3">Administração da Liga</h1>

    @if (!string.IsNullOrEmpty(_erro))
    {
        <div class="alert alert-danger alert-dismissible">
            @_erro
            <button type="button" class="btn-close" @onclick='() => _erro = null'></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_ok))
    {
        <div class="alert alert-success alert-dismissible">
            @_ok
            <button type="button" class="btn-close" @onclick='() => _ok = null'></button>
        </div>
    }

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><button class="nav-link @(_tab=="liga"?"active":"")" @onclick='()=>SetTab("liga")'>Liga</button></li>
        @if (_ligaAtual?.Tipo == TipoCompetition.Copa)
        {
            <li class="nav-item"><button class="nav-link @(_tab=="grupos"?"active":"")" @onclick='()=>SetTab("grupos")' disabled="@(_ligaAtual == null)">Grupos Copa</button></li>
        }
        @if (_ligaAtual?.Tipo == TipoCompetition.Liga)
        {
            <li class="nav-item"><button class="nav-link @(_tab=="times"?"active":"")" @onclick='()=>SetTab("times")' disabled="@(_ligaAtual == null)">Times</button></li>
        }
        <li class="nav-item"><button class="nav-link @(_tab=="rodadas"?"active":"")" @onclick='()=>SetTab("rodadas")' disabled="@(_ligaAtual == null)">Rodadas</button></li>
        <li class="nav-item"><button class="nav-link @(_tab=="partidas"?"active":"")" @onclick='()=>SetTab("partidas")' disabled="@(_rodadaSelecionada == null)">Partidas</button></li>
        <li class="nav-item"><button class="nav-link @(_tab=="punicoes"?"active":"")" @onclick='()=>_tab="punicoes"' disabled="@(_ligaAtual == null)">Punições</button></li>
        <li class="nav-item"><button class="nav-link @(_tab=="knockout"?"active":"")" @onclick='()=>_tab="knockout"' disabled="@(_ligaAtual == null)">Mata-Mata</button></li>
    </ul>

    <!-- ─ Tab: Liga ─ -->
    @if (_tab == "liga")
    {
        <div class="row g-3">
            <div class="col-12 col-lg-5">
                <div class="card">
                    <div class="card-header fw-bold">@(_editandoLigaId.HasValue ? "Editar Liga" : "Nova Liga")</div>
                    <div class="card-body">
                        <div class="mb-2">
                            <label class="form-label">Nome</label>
                            <input class="form-control" @bind="_formNome" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Tipo</label>
                            <select class="form-select" @bind="_formTipo" disabled="@_editandoLigaId.HasValue">
                                <option value="@TipoCompetition.Liga">Liga (pontos corridos)</option>
                                <option value="@TipoCompetition.Copa">Copa (grupos A e B)</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Início</label>
                            <input type="date" class="form-control" @bind="_formInicio" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Fim</label>
                            <input type="date" class="form-control" @bind="_formFim" />
                        </div>
                        <button class="btn btn-primary" @onclick="SalvarLiga" disabled="@_saving">
                            @(_saving ? "Salvando..." : (_editandoLigaId.HasValue ? "Salvar" : "Criar Liga"))
                        </button>
                        @if (_editandoLigaId.HasValue)
                        {
                            <button class="btn btn-outline-secondary ms-2" @onclick="CancelarEdicao">Cancelar</button>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-7">
                <div class="card">
                    <div class="card-header fw-bold">Ligas</div>
                    <div class="list-group list-group-flush">
                        @foreach (var liga in _ligas)
                        {
                            <div class="list-group-item d-flex flex-wrap align-items-center gap-2">
                                <div class="flex-grow-1">
                                    <span class="fw-semibold">@liga.Nome</span>
                                    <span class="badge ms-1 @(liga.Tipo == TipoCompetition.Copa ? "bg-purple text-white" : "bg-dark")">@(liga.Tipo == TipoCompetition.Copa ? "Copa" : "Liga")</span>
                                    <span class="badge ms-1 @StatusBadge(liga.Status)">@StatusLabel(liga.Status, liga.Tipo)</span>
                                    @if (liga.Status == LigaStatus.Encerrada && liga.CampeaoNome is not null)
                                    {
                                        <span class="badge ms-1 bg-warning text-dark">🏆 Campeão: @liga.CampeaoNome</span>
                                    }
                                    <div class="small text-muted">@liga.DataInicio.ToLocalTime().ToString("dd/MM/yyyy") – @liga.DataFim.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                </div>
                                <div class="d-flex gap-1 flex-wrap">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditarLiga(liga)">Editar</button>
                                    @if (liga.Status == LigaStatus.Criada)
                                    {
                                        <button class="btn btn-sm btn-success" @onclick="() => IniciarFase(liga.LigaId)">@(liga.Tipo == TipoCompetition.Liga ? "Iniciar Temporada" : "Iniciar Fase de Grupos")</button>
                                    }
                                    @if (liga.Status == LigaStatus.PrimeiraFase)
                                    {
                                        <button class="btn btn-sm btn-warning" @onclick="() => ConfirmarEncerrarFase(liga)">@(liga.Tipo == TipoCompetition.Liga ? "Encerrar Temporada" : "Encerrar Fase de Grupos")</button>
                                    }
                                    @if (liga.Status == LigaStatus.MiniLiga)
                                    {
                                        <button class="btn btn-sm btn-info" @onclick="() => IniciarMiniLiga(liga.LigaId)">Gerar Mini Liga</button>
                                        <button class="btn btn-sm btn-success" @onclick="() => ConfirmarConcluirMiniLiga(liga)" title="Apurar os 2 melhores da mini liga">Concluir Mini Liga</button>
                                    }
                                    @if (liga.Status == LigaStatus.DecisaoCampeao)
                                    {
                                        <button class="btn btn-sm btn-info" @onclick="() => IniciarDecisao(liga.LigaId)">Criar Jogo Decisivo</button>
                                        <button class="btn btn-sm btn-success" @onclick="() => ConfirmarConcluirDecisao(liga)" title="Definir o campeão pelo jogo decisivo">Concluir Decisão</button>
                                    }
                                    @if (liga.Status is LigaStatus.PlayIn or LigaStatus.Playoffs or LigaStatus.DecisaoCampeao or LigaStatus.MiniLiga)
                                    {
                                        <button class="btn btn-sm btn-outline-warning" @onclick="() => ConfirmarReverterFase(liga)" title="Voltar para a fase anterior">↩ Reverter Fase</button>
                                    }
                                    <button class="btn btn-sm btn-primary" @onclick="() => SelecionarLiga(liga)">Gerenciar</button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => ConfirmarDelete(liga)">Apagar</button>
                                </div>
                            </div>
                        }
                        @if (!_ligas.Any())
                        {
                            <div class="list-group-item text-muted">Nenhuma liga criada.</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Delete Liga Modal ── -->
        @if (_ligaParaDeleter is not null)
        {
            <div class="modal fade show d-block" style="background-color:rgba(0,0,0,0.5)">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Apagar Liga</h5>
                            <button type="button" class="btn-close" @onclick="CancelarDelete"></button>
                        </div>
                        <div class="modal-body">
                            <p><strong>⚠️ Confirmar exclusão</strong></p>
                            <p>Você tem certeza que deseja apagar a liga "<strong>@_ligaParaDeleter.Nome</strong>"?</p>
                            <p class="text-danger">Todos os dados serão deletados permanentemente (rodadas, partidas, classificação, etc).</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CancelarDelete">Cancelar</button>
                            <button type="button" class="btn btn-danger" @onclick="ApagarLiga" disabled="@_saving">
                                @(_saving ? "Apagando..." : "Apagar Liga")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ── Modal de Confirmação Genérico ── -->
        @if (_confirmAction is not null)
        {
            <div class="modal fade show d-block" style="background-color:rgba(0,0,0,0.5)">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">@_confirmTitulo</h5>
                            <button type="button" class="btn-close" @onclick="CancelarConfirmacao"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-0">@_confirmMensagem</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CancelarConfirmacao">Cancelar</button>
                            <button type="button" class="btn @_confirmBotaoClasse" @onclick="ExecutarConfirmacao" disabled="@_saving">
                                @(_saving ? "Processando..." : _confirmBotaoTexto)
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <!-- ─ Tab: Grupos Copa ─ -->
    @if (_tab == "grupos" && _ligaAtual is not null && _ligaAtual.Tipo == TipoCompetition.Copa)
    {
        <div class="row g-3">
            <div class="col-12 col-lg-6">
                <div class="card">
                    <div class="card-header fw-bold">Grupo A</div>
                    <div class="card-body">
                        @for (int i = 0; i < 6; i++)
                        {
                            var idx = i;
                            <div class="mb-2">
                                <select class="form-select form-select-sm" @bind="_grupoA[idx]">
                                    <option value="">Selecione...</option>
                                    @foreach (var t in _times)
                                    {
                                        <option value="@t.TeamId">@t.TeamName</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="card">
                    <div class="card-header fw-bold">Grupo B</div>
                    <div class="card-body">
                        @for (int i = 0; i < 6; i++)
                        {
                            var idx = i;
                            <div class="mb-2">
                                <select class="form-select form-select-sm" @bind="_grupoB[idx]">
                                    <option value="">Selecione...</option>
                                    @foreach (var t in _times)
                                    {
                                        <option value="@t.TeamId">@t.TeamName</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-12">
                <button class="btn btn-primary" @onclick="SalvarGrupos" disabled="@_saving">Salvar Grupos</button>
            </div>
        </div>

        @if (_grupos.Any())
        {
            <div class="row g-3 mt-3">
                @foreach (var grupo in new[] { GrupoCopa.A, GrupoCopa.B })
                {
                    <div class="col-12 col-md-6">
                        <div class="card">
                            <div class="card-header fw-bold">Grupo @grupo configurado</div>
                            <ul class="list-group list-group-flush">
                                @foreach (var g in _grupos.Where(x => x.Grupo == grupo))
                                {
                                    <li class="list-group-item">@g.TimeNome</li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        }
    }

    <!-- ─ Tab: Times (Liga) ─ -->
    @if (_tab == "times" && _ligaAtual is not null && _ligaAtual.Tipo == TipoCompetition.Liga)
    {
        <div class="card">
            <div class="card-header fw-bold d-flex flex-wrap align-items-center gap-2">
                Times participantes
                <span class="badge bg-primary">@_timesLigaSel.Count selecionados</span>
                @if (_ligaAtual.Status != LigaStatus.Criada)
                {
                    <span class="badge bg-secondary">Somente leitura (liga já iniciada)</span>
                }
                <span class="ms-auto small text-muted">Rodadas geradas: @(Math.Max(0, _timesLigaSel.Count - 1))</span>
            </div>
            <div class="card-body">
                <p class="text-muted small">Selecione os times que disputam esta liga. O total de rodadas é o nº de times − 1 (todos se enfrentam uma vez).</p>
                <div class="row g-2">
                    @foreach (var t in _times)
                    {
                        var id = t.TeamId;
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="tl-@id"
                                       checked="@_timesLigaSel.Contains(id)"
                                       disabled="@(_ligaAtual.Status != LigaStatus.Criada || _saving)"
                                       @onchange="e => ToggleTimeLiga(id, (bool)(e.Value ?? false))" />
                                <label class="form-check-label" for="tl-@id">@t.TeamName</label>
                            </div>
                        </div>
                    }
                </div>
                @if (_ligaAtual.Status == LigaStatus.Criada)
                {
                    <div class="mt-3 d-flex gap-2">
                        <button class="btn btn-primary" @onclick="SalvarTimesLiga" disabled="@_saving">@(_saving ? "Salvando..." : "Salvar times")</button>
                        <button class="btn btn-outline-secondary" @onclick="() => { _timesLigaSel = _times.Select(t => t.TeamId).ToHashSet(); }" disabled="@_saving">Selecionar todos</button>
                        <button class="btn btn-outline-secondary" @onclick="() => { _timesLigaSel = new(); }" disabled="@_saving">Limpar</button>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ─ Tab: Rodadas ─ -->
    @if (_tab == "rodadas" && _ligaAtual is not null)
    {
        <div class="d-flex gap-2 mb-3">
            <button class="btn btn-primary btn-sm" @onclick="CriarRodada" disabled="@_saving">+ Criar Rodada</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="GerarRodadasAuto" disabled="@_saving">Gerar Automático (todas)</button>
        </div>

        <div class="row g-2">
            @foreach (var r in _rodadas)
            {
                <div class="col-6 col-md-3 col-lg-2">
                    <div class="card @(_rodadaSelecionada?.RodadaId == r.RodadaId ? "border-primary border-2" : "")">
                        <div class="card-body py-2 text-center">
                            <div class="fw-bold">@RodadaLabel(r.Numero)</div>
                            <div class="small text-muted">@r.TotalPartidas partidas</div>
                            <div class="d-flex gap-1 justify-content-center mt-1">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => SelecionarRodada(r)">Gerenciar</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletarRodada(r.RodadaId)">X</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
            @if (!_rodadas.Any())
            {
                <div class="col-12"><div class="alert alert-info">Nenhuma rodada criada.</div></div>
            }
        </div>
    }

    <!-- ─ Tab: Partidas ─ -->
    @if (_tab == "partidas" && _rodadaSelecionada is not null)
    {
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
            <span class="fw-semibold">@RodadaLabel(_rodadaSelecionada.Numero)</span>
            <button class="btn btn-primary btn-sm" @onclick="() => _showCriarPartida = !_showCriarPartida">+ Nova Partida</button>
        </div>

        @if (_showCriarPartida)
        {
            <div class="card mb-3" style="max-width:420px">
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label small">Mandante</label>
                        <select class="form-select" @bind="_novaCasa">
                            <option value="">Selecione...</option>
                            @foreach (var t in _times)
                            {
                                <option value="@t.TeamId">@t.TeamName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Visitante</label>
                        <select class="form-select" @bind="_novaFora">
                            <option value="">Selecione...</option>
                            @foreach (var t in _times)
                            {
                                <option value="@t.TeamId">@t.TeamName</option>
                            }
                        </select>
                    </div>
                    <button class="btn btn-sm btn-primary" @onclick="CriarPartida" disabled="@_saving">Criar</button>
                    <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => _showCriarPartida = false">Cancelar</button>
                </div>
            </div>
        }

        @foreach (var p in _partidas)
        {
            <div class="card mb-2">
                <div class="card-body py-2">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="fw-semibold">@p.TimeCasaNome</span>
                        <span class="fw-bold fs-5">@p.GolsCasa – @p.GolsFora</span>
                        <span class="fw-semibold">@p.TimeForaNome</span>
                        <span class="badge @PartidaBadge(p.Status)">@p.Status</span>
                        @if (p.IsWO) { <span class="badge bg-danger">W.O.</span> }

                        <div class="ms-auto d-flex gap-1 flex-wrap">
                            @if (p.Status == PartidaStatus.Agendada)
                            {
                                <button class="btn btn-sm btn-success" @onclick="() => IniciarPartida(p.PartidaId)">Iniciar</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => MostrarWO(p)">W.O.</button>
                            }
                            @if (p.Status == PartidaStatus.EmAndamento)
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirStats(p.PartidaId)">Stats</button>
                                <button class="btn btn-sm btn-warning" @onclick="() => EncerrarPartida(p.PartidaId)">Encerrar</button>
                                @if (_rodadaSelecionada?.Numero == -1)
                                {
                                    <button class="btn btn-sm btn-outline-warning" @onclick="() => MostrarPenaltis(p)">Pênaltis</button>
                                }
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => MostrarWO(p)">W.O.</button>
                            }
                            @if (p.Status == PartidaStatus.Encerrada)
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirStats(p.PartidaId)">Ver Stats</button>
                                @if (p.TemPenaltis && p.PenaltisVencedorId is Guid pv)
                                {
                                    <span class="badge bg-warning text-dark align-self-center">Pên.: @(pv == p.TimeCasaId ? p.TimeCasaNome : p.TimeForaNome)</span>
                                }
                            }
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletarPartida(p.PartidaId)">Del</button>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (!_partidas.Any())
        {
            <div class="alert alert-info">Nenhuma partida nesta rodada.</div>
        }

        @if (_woPartida is not null)
        {
            <div class="modal show d-block" style="background:rgba(0,0,0,0.5)">
                <div class="modal-dialog modal-sm">
                    <div class="modal-content">
                        <div class="modal-header"><h5 class="modal-title">Aplicar W.O.</h5></div>
                        <div class="modal-body">
                            <p>Selecione o time que fez W.O. (ele perderá 2x0):</p>
                            <select class="form-select" @bind="_woTimeId">
                                <option value="">Selecione...</option>
                                <option value="@_woPartida.TimeCasaId">@_woPartida.TimeCasaNome</option>
                                <option value="@_woPartida.TimeForaId">@_woPartida.TimeForaNome</option>
                            </select>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-danger" @onclick="ConfirmarWO" disabled="@_saving">Confirmar W.O.</button>
                            <button class="btn btn-secondary" @onclick="() => { _woPartida = null; _woTimeId = null; }">Cancelar</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (_penPartida is not null)
        {
            <div class="modal show d-block" style="background:rgba(0,0,0,0.5)">
                <div class="modal-dialog modal-sm">
                    <div class="modal-content">
                        <div class="modal-header"><h5 class="modal-title">Vencedor nos pênaltis</h5></div>
                        <div class="modal-body">
                            <p class="small text-muted">Jogo empatado em @_penPartida.GolsCasa × @_penPartida.GolsFora. Selecione o vencedor da disputa de pênaltis:</p>
                            <select class="form-select" @bind="_penTimeId">
                                <option value="">Selecione...</option>
                                <option value="@_penPartida.TimeCasaId">@_penPartida.TimeCasaNome</option>
                                <option value="@_penPartida.TimeForaId">@_penPartida.TimeForaNome</option>
                            </select>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-warning" @onclick="ConfirmarPenaltis" disabled="@_saving">Encerrar nos pênaltis</button>
                            <button class="btn btn-secondary" @onclick="() => { _penPartida = null; _penTimeId = null; }">Cancelar</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <!-- ─ Tab: Punições ─ -->
    @if (_tab == "punicoes" && _ligaAtual is not null)
    {
        <div class="row g-3">
            <div class="col-12 col-lg-4">
                <div class="card">
                    <div class="card-header fw-bold">Nova Punição</div>
                    <div class="card-body">
                        <div class="mb-2">
                            <label class="form-label small">Time</label>
                            <select class="form-select" @bind="_punTimeId">
                                <option value="">Selecione...</option>
                                @foreach (var t in _times)
                                {
                                    <option value="@t.TeamId">@t.TeamName</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Pontos a descontar</label>
                            <input type="number" class="form-control" min="1" @bind="_punPontos" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Motivo</label>
                            <input class="form-control" @bind="_punMotivo" />
                        </div>
                        <button class="btn btn-danger btn-sm" @onclick="AplicarPunicao" disabled="@_saving">Aplicar Punição</button>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-8">
                <div class="card">
                    <div class="card-header fw-bold">Punições Aplicadas</div>
                    <div class="list-group list-group-flush">
                        @foreach (var p in _punicoes)
                        {
                            <div class="list-group-item d-flex align-items-center gap-2">
                                <div class="flex-grow-1">
                                    <span class="fw-semibold">@p.TimeNome</span>
                                    <span class="badge bg-danger ms-1">-@p.PontosSubtraidos pts</span>
                                    <div class="small text-muted">@p.Motivo</div>
                                </div>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoverPunicao(p.PunicaoId)">Remover</button>
                            </div>
                        }
                        @if (!_punicoes.Any())
                        {
                            <div class="list-group-item text-muted">Nenhuma punição.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ─ Tab: Mata-Mata ─ -->
    @if (_tab == "knockout" && _ligaAtual is not null)
    {
        @if (!_knockoutJogos.Any())
        {
            <div class="alert alert-info">
                Mata-mata não gerado.
                @if (_ligaAtual.Status == LigaStatus.PlayIn || _ligaAtual.Status == LigaStatus.Playoffs)
                {
                    <button class="btn btn-sm btn-primary ms-3" @onclick="GerarKnockout" disabled="@_saving">Gerar Bracket</button>
                }
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var jogo in _knockoutJogos)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card">
                            <div class="card-header small fw-bold bg-dark text-white py-1">@jogo.FaseLabel</div>
                            <div class="card-body py-2">
                                <div class="fw-semibold">@(jogo.TimeCasaNome ?? "A definir") @(jogo.GolsCasa?.ToString() ?? "—") × @(jogo.GolsFora?.ToString() ?? "—") @(jogo.TimeForaNome ?? "A definir")</div>
                                @if (jogo.VencedorNome is not null)
                                {
                                    <div class="small text-success mt-1">✓ @jogo.VencedorNome</div>
                                }
                                @if (jogo.VencedorId is null && jogo.TimeCasaId.HasValue && jogo.TimeForaId.HasValue)
                                {
                                    <div class="mt-1 d-flex gap-1 flex-wrap">
                                        @if (!jogo.PartidaId.HasValue)
                                        {
                                            <button class="btn btn-sm btn-primary" @onclick="() => CriarPartidaKnockout(jogo)" disabled="@_saving">Criar Partida</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirStats(jogo.PartidaId!.Value)">Stats</button>
                                            <button class="btn btn-sm btn-warning" @onclick="() => MostrarEncerrarKnockout(jogo)" disabled="@_saving">Encerrar</button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (_knockoutJogoParaEncerrar is not null)
            {
                <div class="modal show d-block" style="background:rgba(0,0,0,0.5)">
                    <div class="modal-dialog modal-sm">
                        <div class="modal-content">
                            <div class="modal-header"><h5 class="modal-title">Encerrar: @_knockoutJogoParaEncerrar.FaseLabel</h5></div>
                            <div class="modal-body">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="temPen" @bind="_knockoutTemPenaltis" />
                                    <label class="form-check-label" for="temPen">Foi para pênaltis?</label>
                                </div>
                                @if (_knockoutTemPenaltis)
                                {
                                    <label class="form-label small">Vencedor nos pênaltis</label>
                                    <select class="form-select" @bind="_knockoutPenaltisVencedor">
                                        <option value="">Selecione...</option>
                                        <option value="@_knockoutJogoParaEncerrar.TimeCasaId">@_knockoutJogoParaEncerrar.TimeCasaNome</option>
                                        <option value="@_knockoutJogoParaEncerrar.TimeForaId">@_knockoutJogoParaEncerrar.TimeForaNome</option>
                                    </select>
                                }
                            </div>
                            <div class="modal-footer">
                                <button class="btn btn-primary" @onclick="ConfirmarEncerrarKnockout" disabled="@_saving">Confirmar</button>
                                <button class="btn btn-secondary" @onclick="() => _knockoutJogoParaEncerrar = null">Cancelar</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>

<!-- ── Modal de Stats da Partida (gols/cartões) ── -->
@if (_statsPartidaId is not null)
{
    <div class="modal fade show d-block" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" style="max-height:85vh;">
                <div class="modal-header">
                    <h5 class="modal-title">Stats da Partida</h5>
                    <button type="button" class="btn-close" @onclick="FecharStats"></button>
                </div>
                <div class="modal-body" style="overflow-y:auto;">
                    <PartidaStatsEditor PartidaId="_statsPartidaId.Value" OnChanged="AtualizarAposEvento" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharStats">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? LigaId { get; set; }
    [Parameter] public Guid? RodadaId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] [Parameter] public string? TabQuery { get; set; }

    private string _tab = "liga";
    private string? _erro, _ok;
    private bool _saving;
    private Guid? _statsPartidaId;

    // Liga
    private IReadOnlyList<LigaDto> _ligas = Array.Empty<LigaDto>();
    private LigaDto? _ligaAtual;
    private LigaDto? _ligaParaDeleter;
    private Guid? _editandoLigaId;

    // Confirmação genérica
    private string _confirmTitulo = "", _confirmMensagem = "", _confirmBotaoTexto = "Confirmar", _confirmBotaoClasse = "btn-primary";
    private Func<Task>? _confirmAction;
    private string _formNome = "";
    private DateTime _formInicio = DateTime.Today;
    private DateTime _formFim = DateTime.Today.AddMonths(2);
    private TipoCompetition _formTipo = TipoCompetition.Liga;

    // Grupos Copa
    private IReadOnlyList<LigaGrupoTimeDto> _grupos = Array.Empty<LigaGrupoTimeDto>();
    private readonly string[] _grupoA = new string[6];
    private readonly string[] _grupoB = new string[6];

    // Times
    private IReadOnlyList<TeamListItemDto> _times = Array.Empty<TeamListItemDto>();

    // Times inscritos (Liga)
    private HashSet<Guid> _timesLigaSel = new();

    // Rodadas
    private IReadOnlyList<LigaRodadaDto> _rodadas = Array.Empty<LigaRodadaDto>();
    private LigaRodadaDto? _rodadaSelecionada;

    // Partidas
    private IReadOnlyList<LigaPartidaDto> _partidas = Array.Empty<LigaPartidaDto>();
    private bool _showCriarPartida;
    private string? _novaCasa, _novaFora;
    private LigaPartidaDto? _woPartida;
    private string? _woTimeId;
    private LigaPartidaDto? _penPartida;
    private string? _penTimeId;

    // Punições
    private IReadOnlyList<LigaPunicaoDto> _punicoes = Array.Empty<LigaPunicaoDto>();
    private string? _punTimeId;
    private int _punPontos = 3;
    private string _punMotivo = "";

    // Knockout
    private IReadOnlyList<LigaKnockoutJogoDto> _knockoutJogos = Array.Empty<LigaKnockoutJogoDto>();
    private LigaKnockoutJogoDto? _knockoutJogoParaEncerrar;
    private bool _knockoutTemPenaltis;
    private string? _knockoutPenaltisVencedor;

    protected override async Task OnParametersSetAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        _ligas = await AdminSvc.ListAsync(CancellationToken.None);
        var (teams, _) = await TeamSvc.SearchAsync(null, 1, 100);
        _times = teams.Select(t => new TeamListItemDto(t.TeamId, t.TeamName, t.OwnerName, 0)).ToList();

        _ligaAtual = LigaId.HasValue ? _ligas.FirstOrDefault(l => l.LigaId == LigaId.Value) : null;

        if (_ligaAtual is not null)
        {
            _rodadas = await AdminSvc.ListRodadasAsync(_ligaAtual.LigaId, CancellationToken.None);
            _punicoes = await AdminSvc.ListPunicoesAsync(_ligaAtual.LigaId, CancellationToken.None);
            _knockoutJogos = await PublicSvc.GetKnockoutAsync(_ligaAtual.LigaId, CancellationToken.None);

            _rodadaSelecionada = RodadaId.HasValue ? _rodadas.FirstOrDefault(r => r.RodadaId == RodadaId.Value) : null;
            _partidas = _rodadaSelecionada is not null
                ? await AdminSvc.ListPartidasAsync(_rodadaSelecionada.RodadaId, CancellationToken.None)
                : Array.Empty<LigaPartidaDto>();

            if (_ligaAtual.Tipo == TipoCompetition.Copa)
            {
                _grupos = await AdminSvc.ListGruposAsync(_ligaAtual.LigaId, CancellationToken.None);
                PreencherSelects();
            }
            else
            {
                _timesLigaSel = (await AdminSvc.ListTimesLigaAsync(_ligaAtual.LigaId, CancellationToken.None)).ToHashSet();
            }

            _tab = RodadaId.HasValue ? "partidas" : (string.IsNullOrEmpty(TabQuery) ? "rodadas" : TabQuery);
        }
        else
        {
            _rodadaSelecionada = null;
            _partidas = Array.Empty<LigaPartidaDto>();
            _tab = "liga";
        }

        AtualizarBreadcrumb();
    }

    private void AtualizarBreadcrumb()
    {
        var crumbs = new List<BreadcrumbSegment>
        {
            new("Início", "/home"),
            new("Admin", "/admin/liga"),
            new("Liga", "/admin/liga")
        };

        if (_ligaAtual is not null)
        {
            crumbs.Add(new BreadcrumbSegment(_ligaAtual.Nome, $"/admin/liga/{_ligaAtual.LigaId}"));
            if (_rodadaSelecionada is not null)
                crumbs.Add(new BreadcrumbSegment(RodadaLabel(_rodadaSelecionada.Numero)));
            else if (_tab != "rodadas")
                crumbs.Add(new BreadcrumbSegment(TabLabel(_tab)));
        }

        LayoutState.SetPage(
            NavigationService.GetPageDefinition("/admin/liga"),
            breadcrumbs: crumbs,
            subtitle: _ligaAtual is null ? "Administração da Liga" : $"Administração — {_ligaAtual.Nome}");
    }

    private static string TabLabel(string tab) => tab switch
    {
        "grupos" => "Grupos Copa",
        "times" => "Times",
        "rodadas" => "Rodadas",
        "partidas" => "Partidas",
        "punicoes" => "Punições",
        "knockout" => "Mata-Mata",
        _ => "Liga"
    };

    private void SetTab(string tab)
    {
        if (_ligaAtual is null) { Nav.NavigateTo("/admin/liga"); return; }

        var baseUrl = $"/admin/liga/{_ligaAtual.LigaId}";
        Nav.NavigateTo(tab switch
        {
            "rodadas" => baseUrl,
            "partidas" when _rodadaSelecionada is not null => $"{baseUrl}/rodada/{_rodadaSelecionada.RodadaId}",
            _ => $"{baseUrl}?tab={tab}"
        });
    }

    private void AbrirStats(Guid partidaId) => _statsPartidaId = partidaId;

    private async Task FecharStats()
    {
        _statsPartidaId = null;
        await CarregarDados();
    }

    private async Task AtualizarAposEvento() => await CarregarDados();

    private void ToggleTimeLiga(Guid id, bool on)
    {
        if (on) _timesLigaSel.Add(id);
        else _timesLigaSel.Remove(id);
    }

    private async Task SalvarTimesLiga()
    {
        _erro = null; _saving = true;
        try
        {
            await AdminSvc.ConfigurarTimesLigaAsync(_ligaAtual!.LigaId, _timesLigaSel.ToList(), CancellationToken.None);
            _ok = $"Times salvos. Total de rodadas: {Math.Max(0, _timesLigaSel.Count - 1)}.";
            await CarregarDados();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private void PreencherSelects()
    {
        var a = _grupos.Where(g => g.Grupo == GrupoCopa.A).Select(g => g.TimeId.ToString()).ToArray();
        var b = _grupos.Where(g => g.Grupo == GrupoCopa.B).Select(g => g.TimeId.ToString()).ToArray();
        for (int i = 0; i < 6; i++) { _grupoA[i] = i < a.Length ? a[i] : ""; _grupoB[i] = i < b.Length ? b[i] : ""; }
    }

    private async Task SalvarLiga()
    {
        _erro = null; _saving = true;
        try
        {
            if (_editandoLigaId.HasValue)
            {
                await AdminSvc.UpdateAsync(_editandoLigaId.Value, new LigaUpdateRequest(_formNome, _formInicio, _formFim), CancellationToken.None);
                _ok = "Liga atualizada.";
            }
            else
            {
                await AdminSvc.CreateAsync(new LigaCreateRequest(_formNome, _formInicio, _formFim, _formTipo), CancellationToken.None);
                _ok = "Liga criada.";
            }
            CancelarEdicao();
            await CarregarDados();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private void EditarLiga(LigaDto l) { _editandoLigaId = l.LigaId; _formNome = l.Nome; _formTipo = l.Tipo; _formInicio = l.DataInicio.ToLocalTime(); _formFim = l.DataFim.ToLocalTime(); }
    private void CancelarEdicao() { _editandoLigaId = null; _formNome = ""; _formTipo = TipoCompetition.Liga; _formInicio = DateTime.Today; _formFim = DateTime.Today.AddMonths(2); }

    private void SelecionarLiga(LigaDto liga) => Nav.NavigateTo($"/admin/liga/{liga.LigaId}");

    private async Task IniciarFase(Guid ligaId)
    {
        try { await AdminSvc.IniciarPrimeiraFaseAsync(ligaId, CancellationToken.None); _ok = "Fase iniciada."; await CarregarDados(); }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private async Task EncerrarFase(Guid ligaId)
    {
        try
        {
            var liga = await AdminSvc.EncerrarPrimeiraFaseAsync(ligaId, CancellationToken.None);
            _ok = liga.Status switch
            {
                LigaStatus.Encerrada => "Temporada encerrada. Campeão definido pelo 1º colocado.",
                LigaStatus.DecisaoCampeao => "Empate no topo: use \"Decisão Campeão\" para o jogo decisivo.",
                LigaStatus.MiniLiga => "Empate no topo (3+ times): use \"Gerar Mini Liga\".",
                LigaStatus.PlayIn => "Fase de grupos encerrada. Mata-mata ativo.",
                _ => "Fase encerrada."
            };
            await CarregarDados();
        }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private async Task ReverterFase(Guid ligaId)
    {
        try { await AdminSvc.ReverterParaPrimeiraFaseAsync(ligaId, CancellationToken.None); _ok = "Fase revertida."; await CarregarDados(); }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private void ConfirmarEncerrarFase(LigaDto liga)
    {
        var isLiga = liga.Tipo == TipoCompetition.Liga;
        PedirConfirmacao(
            isLiga ? "Encerrar Temporada" : "Encerrar Fase de Grupos",
            isLiga
                ? $"Tem certeza que deseja encerrar a temporada de \"{liga.Nome}\"? A classificação atual será usada para definir o campeão (ou o desempate, se houver empate no topo). Você pode reverter depois."
                : $"Tem certeza que deseja encerrar a fase de grupos de \"{liga.Nome}\"? Os classificados avançarão para o mata-mata. Você pode reverter depois.",
            isLiga ? "Encerrar Temporada" : "Encerrar Fase de Grupos",
            "btn-warning",
            () => EncerrarFase(liga.LigaId));
    }

    private void ConfirmarReverterFase(LigaDto liga)
    {
        PedirConfirmacao(
            "Reverter Fase",
            $"Tem certeza que deseja reverter \"{liga.Nome}\" para a fase anterior? Os jogos de mata-mata e de mini liga gerados serão removidos. As rodadas e a classificação regulares são preservadas.",
            "Reverter Fase",
            "btn-warning",
            () => ReverterFase(liga.LigaId));
    }

    private void PedirConfirmacao(string titulo, string mensagem, string botaoTexto, string botaoClasse, Func<Task> action)
    {
        _confirmTitulo = titulo;
        _confirmMensagem = mensagem;
        _confirmBotaoTexto = botaoTexto;
        _confirmBotaoClasse = botaoClasse;
        _confirmAction = action;
    }

    private void CancelarConfirmacao() => _confirmAction = null;

    private async Task ExecutarConfirmacao()
    {
        var action = _confirmAction;
        _confirmAction = null;
        if (action is not null) await action();
    }

    private void ConfirmarDelete(LigaDto liga)
    {
        _ligaParaDeleter = liga;
    }

    private async Task ApagarLiga()
    {
        if (_ligaParaDeleter is null) return;
        _saving = true;
        try
        {
            var apagouAtual = _ligaParaDeleter.LigaId == LigaId;
            await AdminSvc.DeleteLigaAsync(_ligaParaDeleter.LigaId, CancellationToken.None);
            _ok = $"Liga '{_ligaParaDeleter.Nome}' apagada.";
            _ligaParaDeleter = null;
            if (apagouAtual) Nav.NavigateTo("/admin/liga");
            else await CarregarDados();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private void CancelarDelete()
    {
        _ligaParaDeleter = null;
    }

    private async Task CriarRodada()
    {
        _erro = null; _saving = true;
        try { await AdminSvc.CreateRodadaAsync(_ligaAtual!.LigaId, CancellationToken.None); await CarregarDados(); }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private async Task GerarRodadasAuto()
    {
        _erro = null; _saving = true;
        try { await AdminSvc.GerarRodadasAutoAsync(_ligaAtual!.LigaId, CancellationToken.None); _ok = "Rodadas geradas automaticamente."; await CarregarDados(); }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private async Task DeletarRodada(Guid id)
    {
        try { await AdminSvc.DeleteRodadaAsync(id, CancellationToken.None); await CarregarDados(); }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private void SelecionarRodada(LigaRodadaDto r) => Nav.NavigateTo($"/admin/liga/{_ligaAtual!.LigaId}/rodada/{r.RodadaId}");

    private async Task CriarPartida()
    {
        if (!Guid.TryParse(_novaCasa, out var casa) || !Guid.TryParse(_novaFora, out var fora)) { _erro = "Selecione os dois times."; return; }
        _saving = true;
        try { await AdminSvc.CreatePartidaAsync(_rodadaSelecionada!.RodadaId, new LigaPartidaCreateRequest(casa, fora), CancellationToken.None); _showCriarPartida = false; _novaCasa = null; _novaFora = null; await CarregarDados(); }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private async Task IniciarPartida(Guid id)
    {
        try { await AdminSvc.IniciarPartidaAsync(id, CancellationToken.None); await CarregarDados(); }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private async Task EncerrarPartida(Guid id)
    {
        try { await AdminSvc.EncerrarPartidaAsync(id, CancellationToken.None); await CarregarDados(); }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private async Task DeletarPartida(Guid id)
    {
        try { await AdminSvc.DeletePartidaAsync(id, CancellationToken.None); await CarregarDados(); }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private void MostrarWO(LigaPartidaDto p) { _woPartida = p; _woTimeId = null; }

    private async Task ConfirmarWO()
    {
        if (!Guid.TryParse(_woTimeId, out var timeId)) { _erro = "Selecione o time."; return; }
        _saving = true;
        try { await AdminSvc.AplicarWOAsync(_woPartida!.PartidaId, timeId, CancellationToken.None); _woPartida = null; _woTimeId = null; _ok = "W.O. aplicado."; await CarregarDados(); }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private void MostrarPenaltis(LigaPartidaDto p) { _penPartida = p; _penTimeId = null; }

    private async Task ConfirmarPenaltis()
    {
        if (!Guid.TryParse(_penTimeId, out var timeId)) { _erro = "Selecione o vencedor dos pênaltis."; return; }
        _saving = true;
        try { await AdminSvc.EncerrarPartidaComPenaltisAsync(_penPartida!.PartidaId, timeId, CancellationToken.None); _penPartida = null; _penTimeId = null; _ok = "Jogo encerrado nos pênaltis."; await CarregarDados(); }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private async Task AplicarPunicao()
    {
        if (!Guid.TryParse(_punTimeId, out var timeId)) { _erro = "Selecione o time."; return; }
        if (_punPontos < 1) { _erro = "Pontos devem ser >= 1."; return; }
        if (string.IsNullOrWhiteSpace(_punMotivo)) { _erro = "Informe o motivo."; return; }
        _saving = true;
        try { await AdminSvc.AplicarPunicaoAsync(_ligaAtual!.LigaId, new LigaPunicaoRequest(timeId, _punPontos, _punMotivo), CancellationToken.None); _punTimeId = null; _punPontos = 3; _punMotivo = ""; _ok = "Punição aplicada."; await CarregarDados(); }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private async Task RemoverPunicao(Guid id)
    {
        try { await AdminSvc.RemoverPunicaoAsync(id, CancellationToken.None); _ok = "Punição removida."; await CarregarDados(); }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private async Task SalvarGrupos()
    {
        var a = _grupoA.Where(x => Guid.TryParse(x, out _)).Select(x => Guid.Parse(x)).ToList();
        var b = _grupoB.Where(x => Guid.TryParse(x, out _)).Select(x => Guid.Parse(x)).ToList();
        if (a.Count != 6 || b.Count != 6) { _erro = "Selecione exatamente 6 times em cada grupo."; return; }
        _saving = true;
        try
        {
            await AdminSvc.ConfigurarGruposCopaAsync(_ligaAtual!.LigaId, new LigaConfigurarGruposRequest(a, b), CancellationToken.None);
            _ok = "Grupos configurados.";
            await CarregarDados();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private async Task IniciarDecisao(Guid ligaId)
    {
        try { await AdminSvc.IniciarDecisaoCampeaoAsync(ligaId, CancellationToken.None); _ok = "Jogo decisivo criado. Registre o resultado na aba Partidas e depois clique em \"Concluir Decisão\"."; await CarregarDados(); }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private async Task IniciarMiniLiga(Guid ligaId)
    {
        try { await AdminSvc.IniciarMiniLigaAsync(ligaId, CancellationToken.None); _ok = "Mini Liga gerada. Registre os resultados na aba Partidas e depois clique em \"Concluir Mini Liga\"."; await CarregarDados(); }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private void ConfirmarConcluirMiniLiga(LigaDto liga) => PedirConfirmacao(
        "Concluir Mini Liga",
        $"Apurar os 2 melhores da mini liga de \"{liga.Nome}\"? Eles avançarão para o jogo decisivo. Todos os jogos da mini liga precisam estar encerrados.",
        "Concluir Mini Liga", "btn-success", () => ConcluirMiniLiga(liga.LigaId));

    private async Task ConcluirMiniLiga(Guid ligaId)
    {
        try { await AdminSvc.ConcluirMiniLigaAsync(ligaId, CancellationToken.None); _ok = "Mini liga apurada. Jogo decisivo criado entre os 2 melhores."; await CarregarDados(); }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private void ConfirmarConcluirDecisao(LigaDto liga) => PedirConfirmacao(
        "Concluir Decisão",
        $"Definir o campeão de \"{liga.Nome}\" pelo jogo decisivo? O jogo precisa estar encerrado (com vencedor nos pênaltis, se empatado). A liga será encerrada.",
        "Concluir Decisão", "btn-success", () => ConcluirDecisao(liga.LigaId));

    private async Task ConcluirDecisao(Guid ligaId)
    {
        try
        {
            var liga = await AdminSvc.ConcluirDecisaoCampeaoAsync(ligaId, CancellationToken.None);
            _ok = liga.CampeaoNome is not null ? $"Liga encerrada. Campeão: {liga.CampeaoNome}." : "Liga encerrada.";
            await CarregarDados();
        }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private async Task GerarKnockout()
    {
        _saving = true;
        try { await AdminSvc.GerarFaseKnockoutAsync(_ligaAtual!.LigaId, CancellationToken.None); _ok = "Bracket gerado."; await CarregarDados(); }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private async Task CriarPartidaKnockout(LigaKnockoutJogoDto jogo)
    {
        _saving = true; _erro = null;
        try
        {
            var partida = await AdminSvc.CriarPartidaKnockoutAsync(jogo.KnockoutJogoId, CancellationToken.None);
            await CarregarDados();
            AbrirStats(partida.PartidaId);
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private void MostrarEncerrarKnockout(LigaKnockoutJogoDto jogo) { _knockoutJogoParaEncerrar = jogo; _knockoutTemPenaltis = false; _knockoutPenaltisVencedor = null; }

    private async Task ConfirmarEncerrarKnockout()
    {
        Guid? penId = _knockoutTemPenaltis && Guid.TryParse(_knockoutPenaltisVencedor, out var g) ? g : null;
        if (_knockoutTemPenaltis && penId is null) { _erro = "Selecione o vencedor nos pênaltis."; return; }
        _saving = true;
        try { await AdminSvc.EncerrarKnockoutJogoAsync(_knockoutJogoParaEncerrar!.KnockoutJogoId, new LigaEncerrarKnockoutRequest(_knockoutTemPenaltis, penId), CancellationToken.None); _knockoutJogoParaEncerrar = null; _ok = "Jogo encerrado. Bracket atualizado."; await CarregarDados(); }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

    private static string StatusBadge(LigaStatus s) => s switch
    {
        LigaStatus.PrimeiraFase => "bg-success",
        LigaStatus.PlayIn => "bg-info text-dark",
        LigaStatus.Playoffs => "bg-warning text-dark",
        LigaStatus.DecisaoCampeao => "bg-danger",
        LigaStatus.MiniLiga => "bg-danger",
        LigaStatus.Encerrada => "bg-secondary",
        _ => "bg-light text-dark"
    };

    private static string RodadaLabel(int numero) => numero switch
    {
        0  => "Mini Liga",
        -1 => "Jogo Decisivo",
        _  => $"Rodada {numero}"
    };

    private static string StatusLabel(LigaStatus s, TipoCompetition tipo) => s switch
    {
        LigaStatus.Criada => "Não iniciada",
        LigaStatus.PrimeiraFase => tipo == TipoCompetition.Liga ? "Em andamento" : "Fase de Grupos",
        LigaStatus.PlayIn => "Play-In",
        LigaStatus.Playoffs => "Playoffs",
        LigaStatus.DecisaoCampeao => "Decisão Campeão",
        LigaStatus.MiniLiga => "Mini Liga",
        LigaStatus.Encerrada => "Encerrada",
        _ => s.ToString()
    };

    private static string PartidaBadge(PartidaStatus s) => s switch
    {
        PartidaStatus.EmAndamento => "bg-warning text-dark",
        PartidaStatus.Encerrada => "bg-success",
        _ => "bg-secondary"
    };
}
