    private async Task SalvarGrupos()
    {
        var a = _grupoPorTime.Where(x => x.Value == GrupoCopa.A).Select(x => x.Key).ToList();
        var b = _grupoPorTime.Where(x => x.Value == GrupoCopa.B).Select(x => x.Key).ToList();
        if (a.Count < 2 || b.Count < 2) { _erro = "Cada grupo precisa de pelo menos 2 times."; return; }
        _saving = true;
        try
        {
            await AdminSvc.ConfigurarGruposCopaAsync(_ligaAtual!.LigaId, new LigaConfigurarGruposRequest(a, b), CancellationToken.None);
            _ok = $"Grupos configurados: {a.Count} x {b.Count} times, {Math.Max(a.Count, b.Count)} rodadas.";
            await CarregarDados();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _saving = false; }
    }

