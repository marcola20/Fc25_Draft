        try
        {
            if (_editandoLigaId.HasValue)
            {
                await AdminSvc.UpdateAsync(_editandoLigaId.Value,
                    new LigaUpdateRequest(_formNome, _formInicio, _formFim, _formTemporada, _formDivisao, RemoverDivisao: _formDivisao is null, VagasDiretas: _formVagasDiretas ?? 0, VagasPlayoff: _formVagasPlayoff ?? 0),
                    CancellationToken.None);
                _ok = "Liga atualizada.";
            }
            else
            {
                var divisao = _formTipo == TipoCompetition.Liga ? _formDivisao : null;
                await AdminSvc.CreateAsync(new LigaCreateRequest(_formNome, _formInicio, _formFim, _formTipo, _formTemporada, divisao, _formVagasDiretas, _formVagasPlayoff), CancellationToken.None);
                _ok = "Liga criada.";
