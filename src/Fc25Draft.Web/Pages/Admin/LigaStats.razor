@page "/admin/liga/stats/{PartidaId:guid}"
@using Fc25Draft.Web.Components.Liga
@using Fc25Draft.Web.Models.Navigation
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject NavigationManager Nav
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService

<PageTitle>Stats da Partida</PageTitle>

<div class="container-fluid py-3">
    <button class="btn btn-sm btn-outline-secondary mb-3" @onclick='() => Nav.NavigateTo(ReturnUrl ?? "/admin/liga")'>← Voltar</button>

    <PartidaStatsEditor PartidaId="PartidaId" />
</div>

@code {
    [Parameter] public Guid PartidaId { get; set; }
    [SupplyParameterFromQuery(Name = "return")] [Parameter] public string? ReturnUrl { get; set; }

    protected override void OnParametersSet()
    {
        LayoutState.SetPage(
            NavigationService.GetPageDefinition("/admin/liga"),
            breadcrumbs: new List<BreadcrumbSegment>
            {
                new("Início", "/home"),
                new("Admin", "/admin/liga"),
                new("Liga", ReturnUrl ?? "/admin/liga"),
                new("Stats da Partida")
            },
            subtitle: "Lançamento de eventos da partida");
    }
}
