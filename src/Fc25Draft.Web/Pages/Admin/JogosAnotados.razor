@page "/admin/jogos-anotados"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IJogosAnotadosService JogosSvc
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService

<PageTitle>Jogos Anotados — Admin</PageTitle>

<div>
    @if (_erro is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_erro
            <button type="button" class="btn-close" @onclick="() => _erro = null"></button>
        </div>
    }
    @if (_ok is not null)
    {
        <div class="alert alert-success alert-dismissible">
            @_ok
            <button type="button" class="btn-close" @onclick="() => _ok = null"></button>
        </div>
    }

    <p class="text-muted small mb-3">
        As competições antes do contador não têm escalação registrada, então os jogos delas ficam em branco na carreira.
        Aqui dá para anotar quantos jogos o jogador fez em cada uma, por time. Campo vazio = sem anotação.
    </p>

    <div class="btn-group mb-3" role="group">
        <button type="button" class="btn btn-sm @(_porTime ? "btn-primary" : "btn-outline-primary")" @onclick="() => _porTime = true">Por time</button>
        <button type="button" class="btn btn-sm @(!_porTime ? "btn-primary" : "btn-outline-primary")" @onclick="() => _porTime = false">Por jogador</button>
    </div>

    @if (_porTime)
    {
        <div class="mb-3" style="max-width: 320px;">
            <select class="form-select" value="@(_grade?.TimeId.ToString() ?? "")" @onchange="e => CarregarTimeAsync(e.Value?.ToString())">
                <option value="">Escolha o time…</option>
                @foreach (var t in _times)
                {
                    <option value="@t.TimeId">@t.TimeNome</option>
                }
            </select>
        </div>

        @if (_carregandoTime)
        {
            <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
        }
        else if (_grade is not null)
        {
            @if (_grade.Jogadores.Count == 0)
            {
                <div class="alert alert-info">Ninguém encontrado nesse time nas competições sem contador.</div>
            }
            else
            {
                <p class="small text-muted mb-2">
                    Quem passou pelo @_grade.TimeNome enquanto cada competição era jogada (pelo draft, transferências e gols).
                    Campo apagado = ele não estava no time naquela competição, mas dá para anotar mesmo assim.
                </p>
                <div class="table-responsive mb-3">
                    <table class="table table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Jogador</th>
                                @foreach (var c in _grade.Competicoes)
                                {
                                    <th class="text-center">
                                        @c.Nome
                                        <div class="small fw-normal text-muted">@c.JogosDoTime jogos do time</div>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var j in _linhasTime)
                            {
                                <tr>
                                    <td class="text-nowrap">
                                        <a href="/players/details/@j.PlayerId">@j.Nome</a>
                                        <span class="small text-muted">@j.Posicao</span>
                                    </td>
                                    @foreach (var cel in j.Celulas)
                                    {
                                        var teto = _grade.Competicoes.First(c => c.LigaId == cel.LigaId).JogosDoTime;
                                        <td class="text-center" style="@(cel.NoPeriodo ? "" : "opacity: .45;")">
                                            <input type="number" min="0" max="@teto"
                                                   class="form-control form-control-sm text-end mx-auto @(cel.Jogos > teto ? "is-invalid" : "")"
                                                   style="width: 80px;" placeholder="—" @bind="cel.Jogos" />
                                            @if (cel.Gols + cel.Assistencias > 0)
                                            {
                                                <div class="small text-muted">@cel.Gols G · @cel.Assistencias A</div>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <button class="btn btn-primary" disabled="@_salvando" @onclick="SalvarTimeAsync">
                    @(_salvando ? "Salvando…" : "Salvar jogos do time")
                </button>
            }
        }
    }
    else
    {
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="mb-3" style="max-width: 420px;">
                <JogadorBusca Placeholder="Buscar jogador para anotar os jogos" OnEscolhido="p => CarregarAsync(p.PlayerId)" />
            </div>

            @if (_carregando)
            {
                <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
            }
            else if (_jogador is not null)
            {
                <div class="d-flex align-items-baseline gap-2 flex-wrap mb-3">
                    <a class="h5 mb-0" href="/players/details/@_jogador.PlayerId">@_jogador.Nome</a>
                    <span class="text-muted small">@_jogador.Posicao@(_jogador.TimeAtual is null ? "" : $" · {_jogador.TimeAtual}")</span>
                </div>

                @if (_competicoes.Count == 0)
                {
                    <div class="alert alert-info">Não há competição sem contador de jogos.</div>
                }

                @foreach (var c in _competicoes)
                {
                    var foraDaLista = c.Participantes.Where(p => c.Linhas.All(l => l.TimeId != p.TimeId)).ToList();
                    <div class="card mb-3">
                        <div class="card-header d-flex align-items-baseline gap-2 flex-wrap">
                            <span class="fw-semibold">@c.Nome</span>
                            @if (c.Gols + c.Assistencias > 0)
                            {
                                <span class="small text-muted ms-auto">registrado: @c.Gols gol(s), @c.Assistencias assistência(s)</span>
                            }
                        </div>
                        <div class="card-body py-2">
                            @if (c.Linhas.Count == 0)
                            {
                                <div class="small text-muted mb-2">A carreira não acha ele nesta competição. Se jogou, escolha o time abaixo.</div>
                            }
                            @foreach (var l in c.Linhas)
                            {
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="flex-grow-1">@l.TimeNome</span>
                                    <input type="number" min="0" max="200" class="form-control form-control-sm text-end"
                                           style="width: 90px;" placeholder="—" @bind="l.Jogos" />
                                    <span class="small text-muted" style="width: 40px;">jogos</span>
                                </div>
                            }
                            @if (foraDaLista.Count > 0)
                            {
                                <select class="form-select form-select-sm mt-1" style="max-width: 280px;" value=""
                                        @onchange="e => AdicionarTime(c, e.Value?.ToString())">
                                    <option value="">+ outro time…</option>
                                    @foreach (var t in foraDaLista)
                                    {
                                        <option value="@t.TimeId">@t.TimeNome</option>
                                    }
                                </select>
                            }
                        </div>
                    </div>
                }

                @if (_competicoes.Count > 0)
                {
                    <button class="btn btn-primary" disabled="@_salvando" @onclick="SalvarAsync">
                        @(_salvando ? "Salvando…" : "Salvar jogos")
                    </button>
                }
            }
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">Já anotados</div>
                @if (_resumo is null)
                {
                    <div class="card-body text-center"><div class="spinner-border spinner-border-sm" role="status"></div></div>
                }
                else if (_resumo.Count == 0)
                {
                    <div class="card-body small text-muted">Nenhum jogador anotado ainda.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var r in _resumo)
                        {
                            <li class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                                role="button" @onclick="() => CarregarAsync(r.PlayerId)">
                                <span class="flex-grow-1">@r.Nome</span>
                                <span class="small text-muted" title="@r.Competicoes competição(ões) · @r.AtualizadoEmUtc.ToLocalTime().ToString("dd/MM HH:mm", Br)">
                                    @r.Jogos jogos
                                </span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
    }
</div>

@code {
    private static readonly CultureInfo Br = CultureInfo.GetCultureInfo("pt-BR");

    private sealed class LinhaEdit
    {
        public Guid TimeId { get; init; }
        public string TimeNome { get; init; } = "";
        public int? Jogos { get; set; }
    }

    private sealed class CompeticaoEdit
    {
        public Guid LigaId { get; init; }
        public string Nome { get; init; } = "";
        public int Gols { get; init; }
        public int Assistencias { get; init; }
        public List<LinhaEdit> Linhas { get; init; } = new();
        public IReadOnlyList<JogosAnotadosTimeDto> Participantes { get; init; } = Array.Empty<JogosAnotadosTimeDto>();
    }

    private sealed class CelulaEdit
    {
        public Guid LigaId { get; init; }
        public bool NoPeriodo { get; init; }
        public int? Original { get; init; }
        public int? Jogos { get; set; }
        public int Gols { get; init; }
        public int Assistencias { get; init; }
    }

    private sealed class JogadorDoTimeEdit
    {
        public int PlayerId { get; init; }
        public string Nome { get; init; } = "";
        public string Posicao { get; init; } = "";
        public List<CelulaEdit> Celulas { get; init; } = new();
    }

    private bool _porTime = true;
    private IReadOnlyList<JogosAnotadosTimeDto> _times = Array.Empty<JogosAnotadosTimeDto>();
    private JogosAnotadosTimeGradeDto? _grade;
    private List<JogadorDoTimeEdit> _linhasTime = new();
    private bool _carregandoTime;

    private JogosAnotadosJogadorDto? _jogador;
    private List<CompeticaoEdit> _competicoes = new();
    private IReadOnlyList<JogosAnotadosResumoDto>? _resumo;
    private bool _carregando;
    private bool _salvando;
    private string? _erro;
    private string? _ok;

    protected override void OnInitialized()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/admin/jogos-anotados"));
    }

    protected override async Task OnInitializedAsync()
    {
        await CarregarResumoAsync();
        try { _times = await JogosSvc.TimesAsync(CancellationToken.None); }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private async Task CarregarTimeAsync(string? valor)
    {
        _ok = null;
        _erro = null;
        if (!Guid.TryParse(valor, out var timeId))
        {
            _grade = null;
            _linhasTime = new();
            return;
        }

        _carregandoTime = true;
        try
        {
            _grade = await JogosSvc.DoTimeAsync(timeId, CancellationToken.None);
            _linhasTime = _grade?.Jogadores
                .Select(j => new JogadorDoTimeEdit
                {
                    PlayerId = j.PlayerId,
                    Nome = j.Nome,
                    Posicao = j.Posicao,
                    Celulas = j.Celulas.Select(c => new CelulaEdit
                    {
                        LigaId = c.LigaId, NoPeriodo = c.NoPeriodo, Original = c.Jogos, Jogos = c.Jogos,
                        Gols = c.Gols, Assistencias = c.Assistencias
                    }).ToList()
                })
                .ToList() ?? new();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _carregandoTime = false; }
    }

    private async Task SalvarTimeAsync()
    {
        if (_grade is null) return;
        _salvando = true;
        _ok = null;
        _erro = null;
        try
        {
            // Só o que mudou: o resto fica como está.
            var linhas = _linhasTime
                .SelectMany(j => j.Celulas.Where(c => c.Jogos != c.Original)
                    .Select(c => new JogosAnotadosDoTimeSalvarDto(j.PlayerId, c.LigaId, c.Jogos)))
                .ToList();
            var time = _grade.TimeNome;
            if (linhas.Count > 0)
                await JogosSvc.SalvarDoTimeAsync(_grade.TimeId, linhas, CancellationToken.None);
            await CarregarTimeAsync(_grade.TimeId.ToString());
            _ok = linhas.Count == 0 ? "Nada mudou." : $"Jogos do {time} salvos ({linhas.Count} alteração(ões)).";
            await CarregarResumoAsync();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _salvando = false; }
    }

    private async Task CarregarResumoAsync()
    {
        try { _resumo = await JogosSvc.ListarAsync(CancellationToken.None); }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private async Task CarregarAsync(int playerId)
    {
        _porTime = false;
        _carregando = true;
        _ok = null;
        _erro = null;
        try
        {
            _jogador = await JogosSvc.DoJogadorAsync(playerId, CancellationToken.None);
            _competicoes = _jogador?.Competicoes
                .Select(c => new CompeticaoEdit
                {
                    LigaId = c.LigaId,
                    Nome = c.Nome,
                    Gols = c.Gols,
                    Assistencias = c.Assistencias,
                    Participantes = c.Participantes,
                    Linhas = c.Linhas.Select(l => new LinhaEdit { TimeId = l.TimeId, TimeNome = l.TimeNome, Jogos = l.Jogos }).ToList()
                })
                .ToList() ?? new();
            if (_jogador is null) _erro = "Jogador não encontrado.";
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _carregando = false; }
    }

    private void AdicionarTime(CompeticaoEdit c, string? valor)
    {
        if (!Guid.TryParse(valor, out var timeId) || c.Linhas.Any(l => l.TimeId == timeId)) return;
        var time = c.Participantes.FirstOrDefault(p => p.TimeId == timeId);
        if (time is null) return;
        c.Linhas.Add(new LinhaEdit { TimeId = time.TimeId, TimeNome = time.TimeNome });
    }

    private async Task SalvarAsync()
    {
        if (_jogador is null) return;
        _salvando = true;
        _ok = null;
        _erro = null;
        try
        {
            var linhas = _competicoes
                .SelectMany(c => c.Linhas.Select(l => new JogosAnotadosSalvarDto(c.LigaId, l.TimeId, l.Jogos)))
                .ToList();
            await JogosSvc.SalvarAsync(_jogador.PlayerId, linhas, CancellationToken.None);
            var nome = _jogador.Nome;
            await CarregarAsync(_jogador.PlayerId);
            _ok = $"Jogos de {nome} salvos.";
            await CarregarResumoAsync();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _salvando = false; }
    }
}
