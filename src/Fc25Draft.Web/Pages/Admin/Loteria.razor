@page "/admin/loteria"
@implements IDisposable
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Entities
@using Fc25Draft.Infra.Data
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Admin")]
@inject ILigaAdminService AdminSvc
@inject ILigaPublicService PublicSvc
@inject LotteryStateService LotteryService
@inject IDbContextFactory<DraftDbContext> DbFactory
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService

<PageTitle>Loteria do Draft — Admin</PageTitle>

<div class="container-fluid py-3" style="max-width:860px">
    <h1 class="h3 mb-1">🎰 Loteria do Draft</h1>
    <p class="text-muted mb-3">Controle do sorteio das picks. Todos os espectadores veem em tempo real.</p>

    @if (!string.IsNullOrEmpty(_erro))
    {
        <div class="alert alert-danger alert-dismissible">
            @_erro
            <button type="button" class="btn-close" @onclick='() => _erro = null'></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_ok))
    {
        <div class="alert alert-success alert-dismissible">
            @_ok
            <button type="button" class="btn-close" @onclick='() => _ok = null'></button>
        </div>
    }

    @if (LotteryService.State is null)
    {
        <div class="card mb-3">
            <div class="card-header fw-bold">Configurar Loteria</div>
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">🏆 Liga <span class="text-muted fw-normal">(Round 1)</span></label>
                        @if (_ligas is null)
                        {
                            <div class="text-muted">Carregando...</div>
                        }
                        else if (_ligas.Count == 0)
                        {
                            <div class="alert alert-info mb-0">Nenhuma liga cadastrada.</div>
                        }
                        else
                        {
                            <select class="form-select" @bind="_ligaIdSelecionada">
                                <option value="">— Selecione a Liga —</option>
                                @foreach (var l in _ligas)
                                {
                                    <option value="@l.LigaId">@l.Nome</option>
                                }
                            </select>
                        }
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">🥇 Copa <span class="text-muted fw-normal">(Round 2 — opcional)</span></label>
                        @if (_ligas is null)
                        {
                            <div class="text-muted">Carregando...</div>
                        }
                        else
                        {
                            <select class="form-select" @bind="_copaIdSelecionada">
                                <option value="">— Selecione a Copa —</option>
                                @foreach (var l in _ligas)
                                {
                                    <option value="@l.LigaId">@l.Nome</option>
                                }
                            </select>
                        }
                    </div>
                </div>
                <button class="btn btn-success fw-semibold"
                        disabled="@(_ligaIdSelecionada == Guid.Empty || _carregando)"
                        @onclick="IniciarLoteria">
                    🚀 Começar Loteria
                </button>
            </div>
        </div>
    }
    else
    {
        var s = LotteryService.State;

        <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
            <span class="badge bg-primary fs-6">🏆 @s.LigaNome</span>
            @if (!string.IsNullOrEmpty(s.CopaLigaNome))
            {
                <span class="badge bg-info text-dark fs-6">🥇 @s.CopaLigaNome</span>
            }
            <span class="badge @(s.Rodada == 1 ? "bg-success" : "bg-warning text-dark") fs-6">Round @s.Rodada</span>
            @if (s.IsFinished) { <span class="badge bg-secondary fs-6">Encerrado</span> }
            <div class="ms-auto d-flex gap-2">
                <button class="btn btn-sm btn-outline-danger" @onclick="Reset">✖ Resetar</button>
            </div>
        </div>

        @if (s.IsFinished)
        {
            <div class="card mb-3">
                <div class="card-header fw-bold">⚙️ Configurar Draft</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="fw-semibold mb-2 small text-muted text-uppercase">Round 1 — Overall dos Jogadores</div>
                            <div class="d-flex gap-2 align-items-center">
                                <div class="flex-fill">
                                    <label class="form-label small mb-1">Mínimo</label>
                                    <input type="number" class="form-control form-control-sm" placeholder="ex: 75"
                                           @bind="_r1OverallMin" min="1" max="99" />
                                </div>
                                <div class="flex-fill">
                                    <label class="form-label small mb-1">Máximo</label>
                                    <input type="number" class="form-control form-control-sm" placeholder="ex: 99"
                                           @bind="_r1OverallMax" min="1" max="99" />
                                </div>
                            </div>
                        </div>
                        @if (s.Round1Results.Count > 0)
                        {
                            <div class="col-12 col-md-6">
                                <div class="fw-semibold mb-2 small text-muted text-uppercase">Round 2 — Overall dos Jogadores</div>
                                <div class="d-flex gap-2 align-items-center">
                                    <div class="flex-fill">
                                        <label class="form-label small mb-1">Mínimo</label>
                                        <input type="number" class="form-control form-control-sm" placeholder="ex: 75"
                                               @bind="_r2OverallMin" min="1" max="99" />
                                    </div>
                                    <div class="flex-fill">
                                        <label class="form-label small mb-1">Máximo</label>
                                        <input type="number" class="form-control form-control-sm" placeholder="ex: 99"
                                               @bind="_r2OverallMax" min="1" max="99" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-success fw-semibold" @onclick="CriarDraft" disabled="@_carregando">
                            🏈 Gerar Draft
                        </button>
                        <span class="text-muted small ms-2">Min/Máx opcionais — deixe vazio para sem restrição</span>
                    </div>
                </div>
            </div>
        }

        @if (!s.IsFinished)
        {
            <div class="card mb-3">
                <div class="card-header fw-bold">Controles</div>
                <div class="card-body d-flex gap-2 flex-wrap">
                    @if (s.HasPending)
                    {
                        <button class="btn btn-primary fw-semibold px-4" @onclick="RevealNext" disabled="@_carregando">
                            ▶ Revelar Próxima Pick
                            <span class="badge bg-light text-dark ms-2">
                                @s.Pending.Count restante@(s.Pending.Count != 1 ? "s" : "")
                            </span>
                        </button>
                    }
                    @if (s.Round1Done)
                    {
                        <button class="btn btn-warning fw-semibold" @onclick="AdvanceRound2" disabled="@_carregando">
                            ⏭ Seguir para Round 2
                        </button>
                        <button class="btn btn-outline-secondary fw-semibold" @onclick="() => Finish()" disabled="@_carregando">
                            ✅ Finalizar
                        </button>
                    }
                    @if (s.Round2Done)
                    {
                        <button class="btn btn-outline-secondary fw-semibold" @onclick="() => Finish()" disabled="@_carregando">
                            ✅ Finalizar
                        </button>
                    }
                </div>
            </div>
        }

        <!-- Preview ao vivo -->
        <div class="row g-3">
            @if (s.Round1Results.Count > 0 || (s.Rodada == 1 && s.Revealed.Count > 0))
            {
                var r1list = s.Round1Results.Count > 0
                    ? s.Round1Results
                    : s.Revealed.OrderBy(p => p.PickNumero).ToList();
                <div class="col-12 @(s.Rodada == 2 || s.Round1Results.Count > 0 ? "col-md-6" : "")">
                    <div class="card h-100">
                        <div class="card-header fw-bold">
                            🏆 Round 1
                            @if (s.Rodada == 1 && s.HasPending)
                            {
                                <span class="badge bg-success ms-2">ao vivo</span>
                            }
                        </div>
                        <div class="card-body p-2">
                            @if (r1list.Count == 0)
                            {
                                <p class="text-muted text-center py-3 mb-0">Nenhuma pick revelada ainda.</p>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var pick in r1list)
                                    {
                                        <div class="list-group-item d-flex align-items-center gap-2 py-2">
                                            <span class="badge @(pick.PickNumero == 1 ? "bg-warning text-dark" : "bg-primary")">#@pick.PickNumero</span>
                                            <img src="@EscudoUrl(pick.TimeNome)" alt="" style="width:22px;height:22px;object-fit:contain" onerror="this.style.display='none'" />
                                            <span class="fw-semibold flex-grow-1">@pick.TimeNome</span>
                                            <span class="text-muted" style="font-size:.75rem">@pick.Posicao°</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (s.Rodada == 2 || (s.IsFinished && s.Revealed.Count > 0))
            {
                var r2list = s.IsFinished || s.Round2Done
                    ? s.Revealed.OrderBy(p => p.PickNumero).ToList()
                    : s.Revealed.OrderBy(p => p.PickNumero).ToList();
                <div class="col-12 @(s.Round1Results.Count > 0 ? "col-md-6" : "")">
                    <div class="card h-100">
                        <div class="card-header fw-bold">
                            🎲 Round 2
                            @if (s.Rodada == 2 && s.HasPending)
                            {
                                <span class="badge bg-success ms-2">ao vivo</span>
                            }
                        </div>
                        <div class="card-body p-2">
                            @if (r2list.Count == 0)
                            {
                                <p class="text-muted text-center py-3 mb-0">Nenhuma pick revelada ainda.</p>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var pick in r2list)
                                    {
                                        <div class="list-group-item d-flex align-items-center gap-2 py-2">
                                            <span class="badge bg-warning text-dark">#@pick.PickNumero</span>
                                            <img src="@EscudoUrl(pick.TimeNome)" alt="" style="width:22px;height:22px;object-fit:contain" onerror="this.style.display='none'" />
                                            <span class="fw-semibold">@pick.TimeNome</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (s.Rodada == 1 && s.Revealed.Count == 0 && s.HasPending)
            {
                <div class="col-12">
                    <div class="card">
                        <div class="card-body p-2">
                            <p class="text-muted text-center py-3 mb-0">Nenhuma pick revelada ainda. Clique em "Revelar".</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-2 text-muted" style="font-size:.82rem">
            <a href="/loteria" target="_blank">🔗 Abrir página pública da loteria</a>
        </div>
    }
</div>

@code {
    private IReadOnlyList<LigaDto>? _ligas;
    private Guid _ligaIdSelecionada;
    private Guid _copaIdSelecionada;
    private string? _erro;
    private string? _ok;
    private bool _carregando;
    private int? _r1OverallMin;
    private int? _r1OverallMax;
    private int? _r2OverallMin;
    private int? _r2OverallMax;

    protected override async Task OnInitializedAsync()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/admin/loteria"));
        LotteryService.OnChange += HandleChange;
        try { _ligas = await AdminSvc.ListAsync(CancellationToken.None); }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private async void HandleChange() => await InvokeAsync(StateHasChanged);
    public void Dispose() => LotteryService.OnChange -= HandleChange;

    private async Task IniciarLoteria()
    {
        if (_ligaIdSelecionada == Guid.Empty) return;
        _carregando = true; _erro = null;
        try
        {
            var liga = _ligas?.FirstOrDefault(l => l.LigaId == _ligaIdSelecionada);
            if (liga is null) { _erro = "Liga não encontrada."; return; }

            LigaDto? copaLiga = _copaIdSelecionada != Guid.Empty
                ? _ligas?.FirstOrDefault(l => l.LigaId == _copaIdSelecionada)
                : null;

            var classif = await PublicSvc.GetClassificacaoAsync(_ligaIdSelecionada, CancellationToken.None);
            if (classif.Count < 12) { _erro = "Classificação incompleta (mínimo 12 times)."; return; }

            // sorted[0]=1°(melhor)  sorted[11]=12°(pior)
            var sorted = classif.OrderBy(c => c.Posicao).ToList();

            var allPicks = new List<LotteryPickItem>();
            var rng = new Random();

            // ── Picks 1-4: loteria ponderada entre 12°/11°/10°/9° (pesos 35/35/15/15) ──
            var pool = new List<(Guid Id, string Nome, int Pos, int Peso)>
            {
                (sorted[11].TimeId, sorted[11].TimeNome, sorted[11].Posicao, 35), // 12°
                (sorted[10].TimeId, sorted[10].TimeNome, sorted[10].Posicao, 35), // 11°
                (sorted[9].TimeId,  sorted[9].TimeNome,  sorted[9].Posicao,  15), // 10°
                (sorted[8].TimeId,  sorted[8].TimeNome,  sorted[8].Posicao,  15), //  9°
            };
            for (int pick = 1; pick <= 4; pick++)
            {
                if (pool.Count == 1)
                {
                    allPicks.Add(new LotteryPickItem(pick, pool[0].Id, pool[0].Nome, pool[0].Pos));
                    pool.RemoveAt(0); break;
                }
                int total = pool.Sum(e => e.Peso), acum = 0, idx = 0;
                int rollW = rng.Next(total);
                for (int i = 0; i < pool.Count; i++) { acum += pool[i].Peso; if (rollW < acum) { idx = i; break; } }
                allPicks.Add(new LotteryPickItem(pick, pool[idx].Id, pool[idx].Nome, pool[idx].Pos));
                pool.RemoveAt(idx);
            }

            // ── Picks 5-6: 50/50 entre 8° e 7° ──
            var p56 = new[] { sorted[7], sorted[6] };
            if (rng.Next(2) == 1) (p56[0], p56[1]) = (p56[1], p56[0]);
            allPicks.Add(new LotteryPickItem(5, p56[0].TimeId, p56[0].TimeNome, p56[0].Posicao));
            allPicks.Add(new LotteryPickItem(6, p56[1].TimeId, p56[1].TimeNome, p56[1].Posicao));

            // ── Picks 7-8: 50/50 entre 6° e 5° ──
            var p78 = new[] { sorted[5], sorted[4] };
            if (rng.Next(2) == 1) (p78[0], p78[1]) = (p78[1], p78[0]);
            allPicks.Add(new LotteryPickItem(7, p78[0].TimeId, p78[0].TimeNome, p78[0].Posicao));
            allPicks.Add(new LotteryPickItem(8, p78[1].TimeId, p78[1].TimeNome, p78[1].Posicao));

            // ── Picks 9-10: 50/50 entre 4° e 3° ──
            var p910 = new[] { sorted[3], sorted[2] };
            if (rng.Next(2) == 1) (p910[0], p910[1]) = (p910[1], p910[0]);
            allPicks.Add(new LotteryPickItem(9,  p910[0].TimeId, p910[0].TimeNome, p910[0].Posicao));
            allPicks.Add(new LotteryPickItem(10, p910[1].TimeId, p910[1].TimeNome, p910[1].Posicao));

            // ── Picks 11-12: 50/50 entre 2° e 1° ──
            var p1112 = new[] { sorted[1], sorted[0] };
            if (rng.Next(2) == 1) (p1112[0], p1112[1]) = (p1112[1], p1112[0]);
            allPicks.Add(new LotteryPickItem(11, p1112[0].TimeId, p1112[0].TimeNome, p1112[0].Posicao));
            allPicks.Add(new LotteryPickItem(12, p1112[1].TimeId, p1112[1].TimeNome, p1112[1].Posicao));

            // Revelação: pick #12 primeiro → pick #1 por último (máximo drama)
            allPicks = allPicks.OrderByDescending(p => p.PickNumero).ToList();

            LotteryService.Start(new LotteryState
            {
                LigaId       = _ligaIdSelecionada,
                LigaNome     = liga.Nome,
                CopaLigaId   = copaLiga?.LigaId,
                CopaLigaNome = copaLiga?.Nome ?? "",
                Rodada       = 1,
                Pending      = allPicks
            });
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _carregando = false; }
    }

    private void RevealNext() => LotteryService.RevealNext();

    private async Task AdvanceRound2()
    {
        var s = LotteryService.State;
        if (s is null) return;
        if (s.CopaLigaId is null)
        {
            _erro = "Nenhuma Copa configurada. Reinicie a loteria selecionando a Copa.";
            return;
        }

        _carregando = true; _erro = null;
        try
        {
            var copaId   = s.CopaLigaId.Value;
            var classif  = await PublicSvc.GetClassificacaoAsync(copaId, CancellationToken.None);
            var knockout = await PublicSvc.GetKnockoutAsync(copaId, CancellationToken.None);

            var classifByTeam = classif.ToDictionary(c => c.TimeId);
            string GetNome(Guid id) => classifByTeam.TryGetValue(id, out var c) ? c.TimeNome : "?";
            int    GetPos(Guid id)  => classifByTeam.TryGetValue(id, out var c) ? c.Posicao  : 0;

            Guid? Loser(FaseKnockout fase)
            {
                var j = knockout.FirstOrDefault(x => x.Fase == fase);
                if (j?.VencedorId == null) return null;
                return j.TimeCasaId == j.VencedorId ? j.TimeForaId : j.TimeCasaId;
            }
            Guid? Winner(FaseKnockout fase) => knockout.FirstOrDefault(x => x.Fase == fase)?.VencedorId;

            // Times no bracket = participantes das semis (4 times)
            var bracketTeams = new HashSet<Guid>(
                new[] { FaseKnockout.Semi1, FaseKnockout.Semi2 }
                    .SelectMany(f =>
                    {
                        var j = knockout.FirstOrDefault(x => x.Fase == f);
                        if (j is null) return Enumerable.Empty<Guid>();
                        return new[] { j.TimeCasaId, j.TimeForaId }
                            .Where(id => id.HasValue).Select(id => id!.Value);
                    }));

            // Eliminados na fase de grupos = todos exceto bracket, pior campanha primeiro
            var groupElims = classif
                .Where(c => !bracketTeams.Contains(c.TimeId))
                .OrderByDescending(c => c.Posicao)
                .ToList();

            if (groupElims.Count < 8) { _erro = "Menos de 8 times eliminados na fase de grupos da Copa."; return; }

            var allPicks = new List<LotteryPickItem>();
            var rng = new Random();

            // ── Picks 1-4: loteria ponderada entre os 4 piores eliminados (35/35/15/15) ──
            var pool14 = groupElims.Take(4)
                .Select((c, i) => (c.TimeId, c.TimeNome, c.Posicao, Peso: i < 2 ? 35 : 15))
                .ToList();
            for (int pick = 1; pick <= 4; pick++)
            {
                if (pool14.Count == 1)
                {
                    allPicks.Add(new LotteryPickItem(pick, pool14[0].TimeId, pool14[0].TimeNome, pool14[0].Posicao));
                    pool14.Clear(); break;
                }
                int total = pool14.Sum(e => e.Peso), acum = 0, idx = 0;
                int rollA = rng.Next(total);
                for (int i = 0; i < pool14.Count; i++) { acum += pool14[i].Peso; if (rollA < acum) { idx = i; break; } }
                allPicks.Add(new LotteryPickItem(pick, pool14[idx].TimeId, pool14[idx].TimeNome, pool14[idx].Posicao));
                pool14.RemoveAt(idx);
            }

            // ── Picks 5-8: loteria ponderada entre os 4 seguintes (35/35/15/15) ──
            var pool58 = groupElims.Skip(4).Take(4)
                .Select((c, i) => (c.TimeId, c.TimeNome, c.Posicao, Peso: i < 2 ? 35 : 15))
                .ToList();
            for (int pick = 5; pick <= 8; pick++)
            {
                if (pool58.Count == 1)
                {
                    allPicks.Add(new LotteryPickItem(pick, pool58[0].TimeId, pool58[0].TimeNome, pool58[0].Posicao));
                    pool58.Clear(); break;
                }
                int total = pool58.Sum(e => e.Peso), acum = 0, idx = 0;
                int rollB = rng.Next(total);
                for (int i = 0; i < pool58.Count; i++) { acum += pool58[i].Peso; if (rollB < acum) { idx = i; break; } }
                allPicks.Add(new LotteryPickItem(pick, pool58[idx].TimeId, pool58[idx].TimeNome, pool58[idx].Posicao));
                pool58.RemoveAt(idx);
            }

            // ── Picks 9-10: perdedores das semis (pior campanha Copa → pick 9) ──
            var semiLosers = new[] { Loser(FaseKnockout.Semi1), Loser(FaseKnockout.Semi2) }
                .Where(x => x.HasValue).Select(x => x!.Value)
                .OrderByDescending(id => GetPos(id)).ToList();
            for (int i = 0; i < semiLosers.Count; i++)
                allPicks.Add(new LotteryPickItem(9 + i, semiLosers[i], GetNome(semiLosers[i]), GetPos(semiLosers[i])));

            // ── Pick 11: vice-campeão Copa ──
            var vice = Loser(FaseKnockout.Final);
            if (vice.HasValue)
                allPicks.Add(new LotteryPickItem(11, vice.Value, GetNome(vice.Value), GetPos(vice.Value)));

            // ── Pick 12: campeão Copa ──
            var champ = Winner(FaseKnockout.Final);
            if (champ.HasValue)
                allPicks.Add(new LotteryPickItem(12, champ.Value, GetNome(champ.Value), GetPos(champ.Value)));

            // Revelação: pick #12 primeiro → pick #1 por último
            var round2 = allPicks.OrderByDescending(p => p.PickNumero).ToList();
            LotteryService.AdvanceToRound2(round2);
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _carregando = false; }
    }

    private async Task Finish()
    {
        LotteryService.Finish();

        var s = LotteryService.State;
        if (s is null) return;

        _carregando = true;
        try
        {
            await using var Db = await DbFactory.CreateDbContextAsync();

            // Remove loteria anterior da mesma liga (se existir)
            var existing = await Db.LigaLoterias
                .Where(x => x.LigaId == s.LigaId)
                .ToListAsync(CancellationToken.None);
            if (existing.Count > 0)
                Db.LigaLoterias.RemoveRange(existing);

            var loteria = new LigaLoteria
            {
                LoteraiaId = Guid.NewGuid(),
                LigaId     = s.LigaId,
                LigaNome   = s.LigaNome,
                IsFinished = true,
                CriadoEm   = DateTime.UtcNow
            };

            // Round 1: salvo em Round1Results (se teve round 2) ou em Revealed (se encerrou no round 1)
            var r1 = s.Round1Results.Count > 0 ? s.Round1Results : (s.Rodada == 1 ? s.Revealed : new());
            foreach (var p in r1)
                loteria.Picks.Add(new LigaLoteriaPick { PickId = Guid.NewGuid(), LoteraiaId = loteria.LoteraiaId, Rodada = 1, PickNumero = p.PickNumero, TimeId = p.TimeId, TimeNome = p.TimeNome, Posicao = p.Posicao });

            // Round 2
            if (s.Rodada == 2)
                foreach (var p in s.Revealed)
                    loteria.Picks.Add(new LigaLoteriaPick { PickId = Guid.NewGuid(), LoteraiaId = loteria.LoteraiaId, Rodada = 2, PickNumero = p.PickNumero, TimeId = p.TimeId, TimeNome = p.TimeNome, Posicao = p.Posicao });

            Db.LigaLoterias.Add(loteria);
            await Db.SaveChangesAsync(CancellationToken.None);
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _carregando = false; }
    }

    private void Reset()
    {
        LotteryService.Reset();
        _ligaIdSelecionada = Guid.Empty;
        _copaIdSelecionada = Guid.Empty;
        _ok = null; _erro = null;
    }

    private async Task CriarDraft()
    {
        var s = LotteryService.State;
        if (s is null || !s.IsFinished) { _erro = "Finalize a loteria antes de gerar o draft."; return; }

        // R1: Round1Results (se teve round 2) ou Revealed (se encerrou no round 1)
        var r1 = s.Round1Results.Count > 0
            ? s.Round1Results.OrderBy(p => p.PickNumero).ToList()
            : s.Revealed.OrderBy(p => p.PickNumero).ToList();
        var r2 = s.Rodada == 2 ? s.Revealed.OrderBy(p => p.PickNumero).ToList() : new List<LotteryPickItem>();

        if (r1.Count == 0) { _erro = "Nenhuma pick do Round 1 encontrada."; return; }

        _carregando = true; _erro = null; _ok = null;
        try
        {
            await using var Db = await DbFactory.CreateDbContextAsync();

            int totalTeams = r1.Count;
            int totalRounds = r2.Count > 0 ? 2 : 1;

            var draft = new Draft
            {
                DraftId      = Guid.NewGuid(),
                Name         = $"Draft — {s.LigaNome}",
                TotalTeams   = totalTeams,
                TotalRounds  = totalRounds,
                CreatedAtUtc = DateTime.UtcNow
            };

            draft.Rounds.Add(new DraftRound
            {
                DraftId     = draft.DraftId,
                RoundNumber = 1,
                OverallMin  = _r1OverallMin,
                OverallMax  = _r1OverallMax
            });
            if (totalRounds == 2)
                draft.Rounds.Add(new DraftRound
                {
                    DraftId     = draft.DraftId,
                    RoundNumber = 2,
                    OverallMin  = _r2OverallMin,
                    OverallMax  = _r2OverallMax
                });

            // Round 1 picks
            foreach (var p in r1)
                draft.Picks.Add(new DraftPick
                {
                    DraftId     = draft.DraftId,
                    OverallPick = p.PickNumero,
                    RoundNumber = 1,
                    PickInRound = p.PickNumero,
                    TeamId      = p.TimeId
                });

            // Round 2 picks (overall continua de totalTeams+1)
            foreach (var p in r2)
                draft.Picks.Add(new DraftPick
                {
                    DraftId     = draft.DraftId,
                    OverallPick = totalTeams + p.PickNumero,
                    RoundNumber = 2,
                    PickInRound = p.PickNumero,
                    TeamId      = p.TimeId
                });

            Db.Drafts.Add(draft);
            await Db.SaveChangesAsync(CancellationToken.None);

            _ok = $"Draft \"{draft.Name}\" criado com sucesso! {draft.Picks.Count} picks geradas.";
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _carregando = false; }
    }

    private static string EscudoUrl(string teamName)
    {
        var normalized = string.Concat(
            teamName.Normalize(System.Text.NormalizationForm.FormD)
                    .Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c)
                                != System.Globalization.UnicodeCategory.NonSpacingMark));
        return $"/images/escudos/{normalized}.png";
    }
}
