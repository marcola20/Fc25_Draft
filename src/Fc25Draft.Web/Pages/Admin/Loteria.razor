@page "/admin/loteria"
@implements IDisposable
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Entities
@using Fc25Draft.Core.Utilities
@using Fc25Draft.Infra.Data
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Admin")]
@inject ILigaAdminService AdminSvc
@inject ILigaPublicService PublicSvc
@inject LotteryStateService LotteryService
@inject IDbContextFactory<DraftDbContext> DbFactory
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService
@inject DraftService DraftSvc
@inject DraftStateService DraftStateSvc
@inject DraftAutoPickService AutoPickSvc
@inject IJSRuntime JS

<PageTitle>Loteria do Draft — Admin</PageTitle>

<div class="container-fluid py-3" style="max-width:860px">
    <h1 class="h3 mb-1">🎰 Loteria do Draft</h1>
    <p class="text-muted mb-3">Controle do sorteio das picks. Todos os espectadores veem em tempo real.</p>

    @if (!string.IsNullOrEmpty(_erro))
    {
        <div class="alert alert-danger alert-dismissible">
            @_erro
            <button type="button" class="btn-close" @onclick='() => _erro = null'></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_ok))
    {
        <div class="alert alert-success alert-dismissible">
            @_ok
            <button type="button" class="btn-close" @onclick='() => _ok = null'></button>
        </div>
    }
    @if (_escolhasIniciais?.Selection is { } selecao)
    {
        <div class="alert alert-info">
            <div class="fw-semibold mb-1">🤖 Escolhas automáticas feitas na abertura do draft</div>
            <div style="white-space: pre-line;">@selecao.Mensagem</div>
            <button type="button" class="btn btn-success btn-sm mt-2" @onclick="CompartilharEscolhasAsync">Compartilhar no WhatsApp</button>
        </div>
    }

    @if (LotteryService.State is null)
    {
        <div class="card mb-3">
            <div class="card-header fw-bold">Configurar Loteria</div>
            <div class="card-body">
                <p class="text-muted small">
                    Regra com Série A (@LoteriaDraft.TimesSerieA times) e Série B (@LoteriaDraft.TimesSerieB times), a mesma de <a href="/picks" target="_blank">Picks do Draft</a>.
                    Round 1: a Série B escolhe antes da A, e do 3º ao 8º da B disputam as picks 1–@LoteriaDraft.PicksSorteadasRound1 na loteria.
                    Round 2: só a campanha na Copa.
                </p>
                @if (_ligas is null)
                {
                    <div class="text-muted">Carregando...</div>
                }
                else
                {
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">🏆 Série A <span class="text-muted fw-normal">(Round 1)</span></label>
                            <select class="form-select" @bind="_serieAId">
                                <option value="">— Selecione —</option>
                                @foreach (var l in Ligas(TipoCompetition.Liga, Divisao.SerieA))
                                {
                                    <option value="@l.LigaId">@l.Nome</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">🥈 Série B <span class="text-muted fw-normal">(Round 1)</span></label>
                            <select class="form-select" @bind="_serieBId">
                                <option value="">— Selecione —</option>
                                @foreach (var l in Ligas(TipoCompetition.Liga, Divisao.SerieB))
                                {
                                    <option value="@l.LigaId">@l.Nome</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">🥇 Copa <span class="text-muted fw-normal">(Round 2)</span></label>
                            <select class="form-select" @bind="_copaIdSelecionada">
                                <option value="">— Selecione —</option>
                                @foreach (var l in Ligas(TipoCompetition.Copa, null))
                                {
                                    <option value="@l.LigaId">@l.Nome</option>
                                }
                            </select>
                        </div>
                    </div>
                }
                <button class="btn btn-success fw-semibold"
                        disabled="@(_serieAId == Guid.Empty || _serieBId == Guid.Empty || _carregando)"
                        @onclick="IniciarLoteria">
                    🚀 Começar Loteria
                </button>
            </div>
        </div>
    }
    else
    {
        var s = LotteryService.State;

        <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
            <span class="badge bg-primary fs-6">🏆 @s.LigaNome</span>
            @if (!string.IsNullOrEmpty(s.CopaLigaNome))
            {
                <span class="badge bg-info text-dark fs-6">🥇 @s.CopaLigaNome</span>
            }
            <span class="badge @(s.Rodada == 1 ? "bg-success" : "bg-warning text-dark") fs-6">Round @s.Rodada</span>
            @if (s.IsFinished) { <span class="badge bg-secondary fs-6">Encerrado</span> }
            <div class="ms-auto d-flex gap-2">
                <button class="btn btn-sm btn-outline-danger" @onclick="Reset">✖ Resetar</button>
            </div>
        </div>

        @if (s.IsFinished)
        {
            <div class="card mb-3">
                <div class="card-header fw-bold">⚙️ Configurar Draft</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="fw-semibold mb-2 small text-muted text-uppercase">Round 1 — Overall dos Jogadores</div>
                            <div class="d-flex gap-2 align-items-center">
                                <div class="flex-fill">
                                    <label class="form-label small mb-1">Mínimo</label>
                                    <input type="number" class="form-control form-control-sm" placeholder="ex: 75"
                                           @bind="_r1OverallMin" min="1" max="99" />
                                </div>
                                <div class="flex-fill">
                                    <label class="form-label small mb-1">Máximo</label>
                                    <input type="number" class="form-control form-control-sm" placeholder="ex: 99"
                                           @bind="_r1OverallMax" min="1" max="99" />
                                </div>
                            </div>
                        </div>
                        @if (s.Round1Results.Count > 0)
                        {
                            <div class="col-12 col-md-6">
                                <div class="fw-semibold mb-2 small text-muted text-uppercase">Round 2 — Overall dos Jogadores</div>
                                <div class="d-flex gap-2 align-items-center">
                                    <div class="flex-fill">
                                        <label class="form-label small mb-1">Mínimo</label>
                                        <input type="number" class="form-control form-control-sm" placeholder="ex: 75"
                                               @bind="_r2OverallMin" min="1" max="99" />
                                    </div>
                                    <div class="flex-fill">
                                        <label class="form-label small mb-1">Máximo</label>
                                        <input type="number" class="form-control form-control-sm" placeholder="ex: 99"
                                               @bind="_r2OverallMax" min="1" max="99" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="mt-3 d-flex align-items-end gap-2 flex-wrap">
                        <div>
                            <label class="form-label small mb-1">⏱️ Tempo por escolha (min)</label>
                            <input type="number" min="1" class="form-control form-control-sm" style="width: 170px;" placeholder="vazio = sem limite"
                                   @bind="_tempoPorEscolha" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-success fw-semibold" @onclick="CriarDraft" disabled="@_carregando">
                            🏈 Gerar Draft
                        </button>
                        <span class="text-muted small ms-2">Min/Máx opcionais — deixe vazio para sem restrição</span>
                    </div>
                </div>
            </div>
        }

        @if (!s.IsFinished)
        {
            <div class="card mb-3">
                <div class="card-header fw-bold">Controles</div>
                <div class="card-body d-flex gap-2 flex-wrap">
                    @if (s.HasPending)
                    {
                        <button class="btn btn-primary fw-semibold px-4" @onclick="RevealNext" disabled="@_carregando">
                            ▶ Revelar Próxima Pick
                            <span class="badge bg-light text-dark ms-2">
                                @s.Pending.Count restante@(s.Pending.Count != 1 ? "s" : "")
                            </span>
                        </button>
                    }
                    @if (s.Round1Done)
                    {
                        <button class="btn btn-warning fw-semibold" @onclick="AdvanceRound2" disabled="@_carregando">
                            ⏭ Seguir para Round 2
                        </button>
                        <button class="btn btn-outline-secondary fw-semibold" @onclick="() => Finish()" disabled="@_carregando">
                            ✅ Finalizar
                        </button>
                    }
                    @if (s.Round2Done)
                    {
                        <button class="btn btn-outline-secondary fw-semibold" @onclick="() => Finish()" disabled="@_carregando">
                            ✅ Finalizar
                        </button>
                    }
                </div>
            </div>
        }

        <!-- Preview ao vivo -->
        <div class="row g-3">
            @if (s.Round1Results.Count > 0 || (s.Rodada == 1 && s.Revealed.Count > 0))
            {
                var r1list = s.Round1Results.Count > 0
                    ? s.Round1Results
                    : s.Revealed.OrderBy(p => p.PickNumero).ToList();
                <div class="col-12 @(s.Rodada == 2 || s.Round1Results.Count > 0 ? "col-md-6" : "")">
                    <div class="card h-100">
                        <div class="card-header fw-bold">
                            🏆 Round 1
                            @if (s.Rodada == 1 && s.HasPending)
                            {
                                <span class="badge bg-success ms-2">ao vivo</span>
                            }
                        </div>
                        <div class="card-body p-2">
                            @if (r1list.Count == 0)
                            {
                                <p class="text-muted text-center py-3 mb-0">Nenhuma pick revelada ainda.</p>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var pick in r1list)
                                    {
                                        <div class="list-group-item d-flex align-items-center gap-2 py-2">
                                            <span class="badge @(pick.PickNumero == 1 ? "bg-warning text-dark" : "bg-primary")">#@pick.PickNumero</span>
                                            <img src="@EscudoUrl(pick.TimeNome)" alt="" style="width:22px;height:22px;object-fit:contain" onerror="this.style.display='none'" />
                                            <span class="fw-semibold flex-grow-1">@pick.TimeNome</span>
                                            <span class="text-muted" style="font-size:.75rem">@pick.OrigemTexto</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (s.Rodada == 2 || (s.IsFinished && s.Revealed.Count > 0))
            {
                var r2list = s.IsFinished || s.Round2Done
                    ? s.Revealed.OrderBy(p => p.PickNumero).ToList()
                    : s.Revealed.OrderBy(p => p.PickNumero).ToList();
                <div class="col-12 @(s.Round1Results.Count > 0 ? "col-md-6" : "")">
                    <div class="card h-100">
                        <div class="card-header fw-bold">
                            🎲 Round 2
                            @if (s.Rodada == 2 && s.HasPending)
                            {
                                <span class="badge bg-success ms-2">ao vivo</span>
                            }
                        </div>
                        <div class="card-body p-2">
                            @if (r2list.Count == 0)
                            {
                                <p class="text-muted text-center py-3 mb-0">Nenhuma pick revelada ainda.</p>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var pick in r2list)
                                    {
                                        <div class="list-group-item d-flex align-items-center gap-2 py-2">
                                            <span class="badge bg-warning text-dark">#@pick.PickNumero</span>
                                            <img src="@EscudoUrl(pick.TimeNome)" alt="" style="width:22px;height:22px;object-fit:contain" onerror="this.style.display='none'" />
                                            <span class="fw-semibold flex-grow-1">@pick.TimeNome</span>
                                            <span class="text-muted" style="font-size:.75rem">@pick.OrigemTexto</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (s.Rodada == 1 && s.Revealed.Count == 0 && s.HasPending)
            {
                <div class="col-12">
                    <div class="card">
                        <div class="card-body p-2">
                            <p class="text-muted text-center py-3 mb-0">Nenhuma pick revelada ainda. Clique em "Revelar".</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-2 text-muted" style="font-size:.82rem">
            <a href="/loteria" target="_blank">🔗 Abrir página pública da loteria</a>
        </div>
    }
</div>

@code {
    private IReadOnlyList<LigaDto>? _ligas;
    private Guid _serieAId;
    private Guid _serieBId;
    private Guid _copaIdSelecionada;
    private string? _erro;
    private string? _ok;
    private bool _carregando;
    private int? _r1OverallMin;
    private int? _r1OverallMax;
    private int? _r2OverallMin;
    private int? _r2OverallMax;
    private int? _tempoPorEscolha;
    private DraftPickResultDto? _escolhasIniciais;

    protected override async Task OnInitializedAsync()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/admin/loteria"));
        LotteryService.OnChange += HandleChange;
        try
        {
            _ligas = await AdminSvc.ListAsync(CancellationToken.None);
            SelecionarUltimaTemporada();
        }
        catch (Exception ex) { _erro = ex.Message; }

        await PreencherComPlanoAsync();
    }

    // O overall de cada round vem do planejamento do próximo draft (o mesmo que os times usaram
    // para montar a escolha automática). Dá para mudar antes de gerar.
    private async Task PreencherComPlanoAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var plano = await db.DraftPlanejadoRodadas.AsNoTracking().ToDictionaryAsync(r => r.RoundNumber);
            if (plano.TryGetValue(1, out var r1))
            {
                _r1OverallMin ??= r1.OverallMin;
                _r1OverallMax ??= r1.OverallMax;
            }
            if (plano.TryGetValue(2, out var r2))
            {
                _r2OverallMin ??= r2.OverallMin;
                _r2OverallMax ??= r2.OverallMax;
            }
        }
        catch
        {
            // Sem planejamento os campos só ficam vazios.
        }
    }

    private async void HandleChange() => await InvokeAsync(StateHasChanged);
    public void Dispose() => LotteryService.OnChange -= HandleChange;

    private IEnumerable<LigaDto> Ligas(TipoCompetition tipo, Divisao? divisao) =>
        (_ligas ?? [])
            .Where(l => l.Tipo == tipo && (divisao is null || l.Divisao == divisao))
            .OrderByDescending(l => l.Temporada)
            .ThenBy(l => l.Nome);

    /// <summary>Já deixa escolhidas a Série A, a Série B e a Copa da temporada mais recente.</summary>
    private void SelecionarUltimaTemporada()
    {
        var temporada = Ligas(TipoCompetition.Liga, Divisao.SerieB).FirstOrDefault()?.Temporada;
        if (temporada is null) return;

        Guid DaTemporada(TipoCompetition tipo, Divisao? divisao) =>
            Ligas(tipo, divisao).FirstOrDefault(l => l.Temporada == temporada)?.LigaId ?? Guid.Empty;

        _serieAId = DaTemporada(TipoCompetition.Liga, Divisao.SerieA);
        _serieBId = DaTemporada(TipoCompetition.Liga, Divisao.SerieB);
        _copaIdSelecionada = DaTemporada(TipoCompetition.Copa, null);
    }

    private async Task IniciarLoteria()
    {
        _carregando = true; _erro = null;
        try
        {
            var serieA = _ligas?.FirstOrDefault(l => l.LigaId == _serieAId);
            var serieB = _ligas?.FirstOrDefault(l => l.LigaId == _serieBId);
            if (serieA is null || serieB is null) { _erro = "Selecione a Série A e a Série B."; return; }
            if (serieA.Temporada != serieB.Temporada) { _erro = "A Série A e a Série B precisam ser da mesma temporada."; return; }

            // A ordem sai da tabela final: com a liga em andamento ainda faltam jogos ou desempates.
            var emAndamento = new[] { serieA, serieB }.Where(l => l.Status != LigaStatus.Encerrada).Select(l => l.Nome).ToList();
            if (emAndamento.Count > 0) { _erro = $"Encerre antes da loteria: {string.Join(" e ", emAndamento)}."; return; }

            LigaDto? copaLiga = _copaIdSelecionada != Guid.Empty
                ? _ligas?.FirstOrDefault(l => l.LigaId == _copaIdSelecionada)
                : null;

            var picks = LoteriaDraft.Round1(await TabelaAsync(serieA.LigaId), await TabelaAsync(serieB.LigaId), Random.Shared);

            LotteryService.Start(new LotteryState
            {
                LigaId       = serieA.LigaId,
                LigaNome     = $"Temporada {serieA.Temporada}",
                CopaLigaId   = copaLiga?.LigaId,
                CopaLigaNome = copaLiga?.Nome ?? "",
                Rodada       = 1,
                Pending      = ParaRevelar(picks)
            });
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _carregando = false; }
    }

    /// <summary>Tabela da divisão com a posição que vale (na Série B, empatados dividem a posição).</summary>
    private async Task<List<TimeNaTabela>> TabelaAsync(Guid ligaId)
    {
        var classif = await PublicSvc.GetClassificacaoAsync(ligaId, CancellationToken.None);
        var posicoes = await AdminSvc.GetPosicoesTabelaAsync(ligaId, CancellationToken.None);
        return classif
            .Select(c => new TimeNaTabela(c.TimeId, c.TimeNome, posicoes.GetValueOrDefault(c.TimeId, c.Posicao)))
            .ToList();
    }

    /// <summary>Revelação: a última pick primeiro e a #1 por último (máximo drama).</summary>
    private static List<LotteryPickItem> ParaRevelar(IEnumerable<PickLoteria> picks) =>
        picks.OrderByDescending(p => p.Pick)
            .Select(p => new LotteryPickItem(p.Pick, p.TimeId, p.TimeNome, p.Posicao, p.Origem))
            .ToList();

    private void RevealNext() => LotteryService.RevealNext();

    private async Task AdvanceRound2()
    {
        var s = LotteryService.State;
        if (s is null) return;
        if (s.CopaLigaId is null)
        {
            _erro = "Nenhuma Copa configurada. Reinicie a loteria selecionando a Copa.";
            return;
        }

        _carregando = true; _erro = null;
        try
        {
            var copaId   = s.CopaLigaId.Value;
            var classif  = await PublicSvc.GetClassificacaoAsync(copaId, CancellationToken.None);
            var knockout = await PublicSvc.GetKnockoutAsync(copaId, CancellationToken.None);

            // Posição dentro do grupo: a tabela gravada já vem na ordem de cada grupo.
            var copa = classif
                .Where(c => c.Grupo is not null)
                .GroupBy(c => c.Grupo!.Value)
                .SelectMany(g => g.OrderBy(c => c.Posicao).Select((c, i) => new TimeNaCopa(
                    c.TimeId, c.TimeNome, g.Key, i + 1, c.Pontos, c.Jogos, c.SaldoGols, c.GolsPro)))
                .ToList();

            LigaKnockoutJogoDto Jogo(FaseKnockout fase)
            {
                var j = knockout.FirstOrDefault(x => x.Fase == fase)
                    ?? throw new InvalidOperationException($"A Copa ainda não tem o mata-mata completo (falta {fase}).");
                if (j.VencedorId is null || j.TimeCasaId is null || j.TimeForaId is null)
                    throw new InvalidOperationException($"A Copa ainda não terminou: falta o resultado de {j.FaseLabel}.");
                return j;
            }
            Guid Perdedor(FaseKnockout fase)
            {
                var j = Jogo(fase);
                return j.TimeCasaId == j.VencedorId ? j.TimeForaId!.Value : j.TimeCasaId!.Value;
            }

            var chave = new ChaveCopa(
                [Perdedor(FaseKnockout.QF1), Perdedor(FaseKnockout.QF2), Perdedor(FaseKnockout.QF3), Perdedor(FaseKnockout.QF4)],
                [Perdedor(FaseKnockout.Semi1), Perdedor(FaseKnockout.Semi2)],
                Perdedor(FaseKnockout.Final),
                Jogo(FaseKnockout.Final).VencedorId!.Value);

            var picks = LoteriaDraft.Round2(copa, chave, Random.Shared);
            LotteryService.AdvanceToRound2(ParaRevelar(picks));
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _carregando = false; }
    }

    private async Task Finish()
    {
        LotteryService.Finish();

        var s = LotteryService.State;
        if (s is null) return;

        _carregando = true;
        try
        {
            await using var Db = await DbFactory.CreateDbContextAsync();

            // Remove loteria anterior da mesma liga (se existir)
            var existing = await Db.LigaLoterias
                .Where(x => x.LigaId == s.LigaId)
                .ToListAsync(CancellationToken.None);
            if (existing.Count > 0)
                Db.LigaLoterias.RemoveRange(existing);

            var loteria = new LigaLoteria
            {
                LoteraiaId = Guid.NewGuid(),
                LigaId     = s.LigaId,
                LigaNome   = s.LigaNome,
                IsFinished = true,
                CriadoEm   = DateTime.UtcNow
            };

            // Round 1: salvo em Round1Results (se teve round 2) ou em Revealed (se encerrou no round 1)
            var r1 = s.Round1Results.Count > 0 ? s.Round1Results : (s.Rodada == 1 ? s.Revealed : new());
            foreach (var p in r1)
                loteria.Picks.Add(new LigaLoteriaPick { PickId = Guid.NewGuid(), LoteraiaId = loteria.LoteraiaId, Rodada = 1, PickNumero = p.PickNumero, TimeId = p.TimeId, TimeNome = p.TimeNome, Posicao = p.Posicao, Origem = p.Origem });

            // Round 2
            if (s.Rodada == 2)
                foreach (var p in s.Revealed)
                    loteria.Picks.Add(new LigaLoteriaPick { PickId = Guid.NewGuid(), LoteraiaId = loteria.LoteraiaId, Rodada = 2, PickNumero = p.PickNumero, TimeId = p.TimeId, TimeNome = p.TimeNome, Posicao = p.Posicao, Origem = p.Origem });

            Db.LigaLoterias.Add(loteria);
            await Db.SaveChangesAsync(CancellationToken.None);
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _carregando = false; }
    }

    private void Reset()
    {
        LotteryService.Reset();
        SelecionarUltimaTemporada();
        _ok = null; _erro = null;
    }

    private async Task CriarDraft()
    {
        var s = LotteryService.State;
        if (s is null || !s.IsFinished) { _erro = "Finalize a loteria antes de gerar o draft."; return; }

        // R1: Round1Results (se teve round 2) ou Revealed (se encerrou no round 1)
        var r1 = s.Round1Results.Count > 0
            ? s.Round1Results.OrderBy(p => p.PickNumero).ToList()
            : s.Revealed.OrderBy(p => p.PickNumero).ToList();
        var r2 = s.Rodada == 2 ? s.Revealed.OrderBy(p => p.PickNumero).ToList() : new List<LotteryPickItem>();

        if (r1.Count == 0) { _erro = "Nenhuma pick do Round 1 encontrada."; return; }

        _carregando = true; _erro = null; _ok = null; _escolhasIniciais = null;
        try
        {
            // Só um draft por vez: o atual (ex.: o complementar da expansão) precisa terminar antes.
            await DraftSvc.EnsureNoDraftInProgressAsync();

            await using var Db = await DbFactory.CreateDbContextAsync();

            int totalTeams = r1.Count;
            int totalRounds = r2.Count > 0 ? 2 : 1;

            var draft = new Draft
            {
                DraftId      = Guid.NewGuid(),
                Name         = $"Draft — {s.LigaNome}",
                TempoPorEscolhaMinutos = _tempoPorEscolha is > 0 ? _tempoPorEscolha : null,
                TotalTeams   = totalTeams,
                TotalRounds  = totalRounds,
                CreatedAtUtc = DateTime.UtcNow
            };

            draft.Rounds.Add(new DraftRound
            {
                DraftId     = draft.DraftId,
                RoundNumber = 1,
                OverallMin  = _r1OverallMin,
                OverallMax  = _r1OverallMax
            });
            if (totalRounds == 2)
                draft.Rounds.Add(new DraftRound
                {
                    DraftId     = draft.DraftId,
                    RoundNumber = 2,
                    OverallMin  = _r2OverallMin,
                    OverallMax  = _r2OverallMax
                });

            // Round 1 picks
            foreach (var p in r1)
                draft.Picks.Add(new DraftPick
                {
                    DraftId     = draft.DraftId,
                    OverallPick = p.PickNumero,
                    RoundNumber = 1,
                    PickInRound = p.PickNumero,
                    TeamId      = p.TimeId
                });

            // Round 2 picks (overall continua de totalTeams+1)
            foreach (var p in r2)
                draft.Picks.Add(new DraftPick
                {
                    DraftId     = draft.DraftId,
                    OverallPick = totalTeams + p.PickNumero,
                    RoundNumber = 2,
                    PickInRound = p.PickNumero,
                    TeamId      = p.TimeId
                });

            Db.Drafts.Add(draft);
            await Db.SaveChangesAsync(CancellationToken.None);

            _ok = $"Draft \"{draft.Name}\" criado com sucesso! {draft.Picks.Count} picks geradas.";

            // Listas montadas para o próximo draft entram agora e já escolhem por quem abre o draft.
            await AutoPickSvc.AplicarPreviasAsync(draft.DraftId);
            _escolhasIniciais = await DraftStateSvc.ProcessarAutomaticasAsync();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _carregando = false; }
    }

    private async Task CompartilharEscolhasAsync()
    {
        if (_escolhasIniciais?.Selection is not { } selecao) return;
        try
        {
            await JS.InvokeAsync<string>("fc25Share.openWhatsapp", selecao.ShareUrl, selecao.WhatsappGroupLink, selecao.Mensagem);
        }
        catch (JSException ex)
        {
            _erro = $"Não foi possível abrir o WhatsApp: {ex.Message}";
        }
    }

    private static string EscudoUrl(string teamName)
    {
        var normalized = string.Concat(
            teamName.Normalize(System.Text.NormalizationForm.FormD)
                    .Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c)
                                != System.Globalization.UnicodeCategory.NonSpacingMark));
        return $"/images/escudos/{normalized}.png";
    }
}
