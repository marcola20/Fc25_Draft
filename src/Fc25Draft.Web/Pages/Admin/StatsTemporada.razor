@page "/admin/stats-temporada"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Interfaces
@using Fc25Draft.Core.Utilities
@using Fc25Draft.Web.Utilities
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject ILigaPublicService LigaService
@inject IPremiosEstatisticaService PremiosEstatSvc
@inject IJSRuntime JSRuntime
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService

<PageTitle>Stats da temporada</PageTitle>

<div>
    @if (_erro is not null)
    {
        <div class="alert alert-danger alert-dismissible">@_erro<button type="button" class="btn-close" @onclick="() => _erro = null"></button></div>
    }
    @if (_ok is not null)
    {
        <div class="alert alert-success alert-dismissible">@_ok<button type="button" class="btn-close" @onclick="() => _ok = null"></button></div>
    }

    @if (_carregando)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    }
    else if (_edicoes.Count == 0)
    {
        <div class="alert alert-info">Nenhuma competição ainda.</div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body d-flex align-items-end gap-3 flex-wrap">
                <div>
                    <label class="form-label mb-0 small">Competição</label>
                    <select class="form-select" style="min-width:22rem;" value="@_ligaId" @onchange="Trocar">
                        @foreach (var e in _edicoes)
                        {
                            <option value="@e.LigaId">@e.Nome@(e.Encerrada ? "" : " (em andamento)")</option>
                        }
                    </select>
                </div>

                <button class="btn btn-success" @onclick="Copiar" disabled="@(_texto.Length == 0)"><Icone Nome="copy" Tamanho="14" /> Copiar para o WhatsApp</button>
                <button class="btn btn-outline-secondary" @onclick="() => Carregar(_ligaId)">Recarregar</button>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12 col-lg-7">
                <div class="card h-100">
                    <div class="card-header d-flex align-items-center gap-2">
                        <span class="fw-bold">Texto</span>
                        <span class="text-muted small">top 3 com empates juntos · dá para editar antes de copiar</span>
                    </div>
                    <div class="card-body">
                        <textarea class="form-control font-monospace" style="min-height:26rem; font-size:.85rem;"
                                  @bind="_texto" @bind:event="oninput"></textarea>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="card h-100">
                    <div class="card-header fw-medium">Como vai chegar</div>
                    <div class="card-body" style="background:#e5ddd5;">
                        <div class="p-3 rounded shadow-sm" style="background:var(--bs-body-bg); white-space:pre-wrap; font-size:.9rem;">
                            @((MarkupString)Prever(_texto))
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (_premios is { } pr)
        {
            <div class="card mt-3">
                <div class="card-header d-flex flex-wrap align-items-center gap-2">
                    <Icone Nome="award" Tamanho="16" />
                    <span class="fw-bold">Prêmios de estatística — @(pr.Antigos ? $"temporada {pr.Temporada} somada" : pr.LigaNome)</span>
                    <span class="text-muted small">top 3 da competição · dinheiro para o clube e +1 over para o jogador · quem entra em duas listas na temporada repassa um over (o treinador escolhe na Minha Área, overall até @PremiosEstatistica.OverallMaximoDoRepasse)</span>
                    <div class="ms-auto d-flex gap-2">
                        @if (pr.JaDado)
                        {
                            <span class="badge bg-success align-self-center">Dados em @pr.DadoEm?.ToString("dd/MM HH:mm")</span>
                            <button class="btn btn-sm btn-outline-danger" disabled="@_ocupado" @onclick="DesfazerPremios">Desfazer</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-primary" disabled="@(_ocupado || pr.Impedimento is not null)" @onclick="DarPremios">
                                <Icone Nome="award" Tamanho="14" /> Dar prêmios e overs
                            </button>
                        }
                    </div>
                </div>
                @if (pr.Antigos)
                {
                    <div class="alert alert-warning m-3 mb-0 py-2 small">
                        Estes prêmios foram dados pela temporada somada (Série A + Série B + Copa). Para premiar cada competição,
                        clique em <strong>Desfazer</strong> e depois dê os prêmios da Série A, da Série B e da Copa, uma de cada vez.
                    </div>
                }
                @if (pr.Impedimento is not null && !pr.JaDado)
                {
                    <div class="alert alert-warning m-3 mb-0 py-2 small">@pr.Impedimento</div>
                }
                @if (pr.Linhas.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr class="small text-muted">
                                    <th>Prêmio</th><th>Jogador</th><th class="text-end">Clube recebe</th><th>Over</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in pr.Linhas)
                                {
                                    <tr>
                                        <td class="text-nowrap">@PremiosEstatistica.Titulo(l.Categoria, l.Posicao) <span class="text-muted small">(@l.Numero)</span>
                                            @if (!string.IsNullOrEmpty(l.Detalhe)) { <div class="text-muted small">@l.Detalhe</div> }
                                        </td>
                                        <td>@l.JogadorNome <span class="text-muted small">@l.TimeNome</span></td>
                                        <td class="text-end text-nowrap">@Dinheiro.Curto(l.Valor)</td>
                                        <td class="small">
                                            @if (l.OverDado)
                                            {
                                                <span class="text-success">+1 em @(l.OverParaNome ?? l.JogadorNome)</span>
                                                @if (l.Repasse) { <span class="text-muted"> (repasse)</span> }
                                                @if (l.NoSave) { <span class="badge bg-secondary ms-1">no save</span> }
                                            }
                                            else if (!pr.JaDado)
                                            {
                                                @(l.Repasse ? "repasse — o treinador escolhe o companheiro" : "+1 nele")
                                            }
                                            else
                                            {
                                                <div class="d-flex flex-wrap gap-1 align-items-center">
                                                    <span class="text-warning-emphasis">@(l.Repasse ? "esperando o treinador escolher" : "over não foi dado")</span>
                                                    @if (l.Repasse && _companheiros.TryGetValue(l.PremioId!.Value, out var opcoes))
                                                    {
                                                        var id = l.PremioId!.Value;
                                                        <select class="form-select form-select-sm w-auto" value="@_escolhido.GetValueOrDefault(id)"
                                                                @onchange="e => _escolhido[id] = int.TryParse(e.Value?.ToString(), out var v) ? v : 0">
                                                            <option value="0">companheiro…</option>
                                                            @foreach (var o in opcoes)
                                                            {
                                                                <option value="@o.PlayerId">@o.Nome (@o.Posicao @o.Overall)</option>
                                                            }
                                                        </select>
                                                    }
                                                    <button class="btn btn-sm btn-outline-primary" disabled="@_ocupado" @onclick="() => DarOver(l)">Dar over</button>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private bool _carregando = true;
    private string? _erro, _ok;

    private IReadOnlyList<LigaEdicaoDto> _edicoes = Array.Empty<LigaEdicaoDto>();
    private Guid _ligaId;
    private string _texto = "";

    private PremiosEstatisticaDto? _premios;
    private bool _ocupado;
    private readonly Dictionary<Guid, IReadOnlyList<PremioJogadorOpcaoDto>> _companheiros = new();
    private readonly Dictionary<Guid, int> _escolhido = new();

    protected override void OnInitialized()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/admin/stats-temporada"));
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Já vem da temporada mais recente para a mais antiga, Série A na frente.
            _edicoes = await LigaService.ListEdicoesAsync(CancellationToken.None);
            if (_edicoes.Count > 0) await Carregar(_edicoes[0].LigaId);
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _carregando = false; }
    }

    private async Task Trocar(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id)) await Carregar(id);
    }

    private async Task Carregar(Guid ligaId)
    {
        _erro = null; _ok = null;
        try
        {
            _ligaId = ligaId;
            var ct = CancellationToken.None;
            var edicao = _edicoes.First(e => e.LigaId == ligaId);

            var artilheiros = await LigaService.GetArtilheirosAsync(ligaId, ct);
            var assistencias = await LigaService.GetAssistenciasAsync(ligaId, ct);
            var cleanSheets = await LigaService.GetCleanSheetsAsync(ligaId, ct);
            var notas = await LigaService.GetMediasNotasAsync(ligaId, ct);

            // Mesmo corte da página da competição: metade dos jogos de quem mais jogou com nota.
            var minimo = notas.Count == 0 ? 1 : Math.Max(1, (int)Math.Ceiling(notas.Max(n => n.Jogos) / 2.0));

            _texto = StatsTemporadaTexto.Montar(
                edicao.Nome,
                edicao.Encerrada,
                artilheiros.Select(a => new StatJogador(a.JogadorNome, a.TimeNome, a.Gols)).ToList(),
                assistencias.Select(a => new StatJogador(a.JogadorNome, a.TimeNome, a.Assistencias)).ToList(),
                cleanSheets.Select(c => new StatJogador(c.JogadorNome, c.TimeNome, c.CleanSheets)).ToList(),
                // Arredonda como aparece no texto, para quem mostra a mesma nota ficar empatado.
                notas.Where(n => n.Jogos >= minimo)
                     .Select(n => new StatJogador(n.JogadorNome, n.TimeNome, Math.Round(n.Media, 2)))
                     .ToList(),
                minimo);

            await CarregarPremios();
        }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private async Task CarregarPremios()
    {
        _premios = await PremiosEstatSvc.GetAsync(_ligaId, CancellationToken.None);
        _companheiros.Clear();
        _escolhido.Clear();
        foreach (var l in _premios.Linhas.Where(l => l.PremioId is not null && l.Repasse && !l.OverDado))
            _companheiros[l.PremioId!.Value] = await PremiosEstatSvc.CompanheirosAsync(l.PremioId.Value, CancellationToken.None);
    }

    private Task DarPremios() => Acao(
        $"Dar os prêmios de estatística da {_premios?.LigaNome}? Os clubes recebem o dinheiro e os jogadores o +1 over agora.",
        () => PremiosEstatSvc.DarAsync(_ligaId, CancellationToken.None));

    private Task DesfazerPremios() => Acao(
        _premios?.Antigos == true
            ? $"Desfazer os prêmios da temporada {_premios.Temporada} somada? Tira o dinheiro dos clubes e os overs (se o Editor PES ainda não levou)."
            : $"Desfazer os prêmios de estatística da {_premios?.LigaNome}? Tira o dinheiro dos clubes e os overs (se o Editor PES ainda não levou).",
        () => PremiosEstatSvc.DesfazerAsync(_ligaId, CancellationToken.None));

    private Task DarOver(PremioEstatisticaLinhaDto l)
    {
        int? para = l.Repasse ? _escolhido.GetValueOrDefault(l.PremioId!.Value) : null;
        if (l.Repasse && para is not > 0) { _erro = "Escolha o companheiro que recebe o over."; return Task.CompletedTask; }
        return Acao($"Dar o +1 over do prêmio de {l.JogadorNome}?",
            () => PremiosEstatSvc.DarOverAsync(l.PremioId!.Value, para, CancellationToken.None));
    }

    private async Task Acao(string pergunta, Func<Task<string>> passo)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", pergunta)) return;
        _erro = null; _ok = null; _ocupado = true;
        try
        {
            _ok = await passo();
            await CarregarPremios();
        }
        catch (InvalidOperationException ex) { _erro = ex.Message; }
        finally { _ocupado = false; }
    }

    private async Task Copiar()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _texto);
            _ok = "Copiado. É só colar no grupo.";
        }
        catch (Exception)
        {
            _erro = "O navegador não deixou copiar sozinho — selecione o texto e copie na mão.";
        }
    }

    /// <summary>Mostra o negrito e o itálico como o WhatsApp mostra.</summary>
    private static string Prever(string texto)
    {
        var seguro = System.Net.WebUtility.HtmlEncode(texto);

        seguro = System.Text.RegularExpressions.Regex.Replace(seguro, @"\*([^*\n]+)\*", "<strong>$1</strong>");
        seguro = System.Text.RegularExpressions.Regex.Replace(seguro, @"_([^_\n]+)_", "<em>$1</em>");

        return seguro;
    }
}
