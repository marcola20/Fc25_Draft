@page "/admin/login"
@using Fc25Draft.Web.Services
@inject AdminAuthService AdminAuth
@inject NavigationManager Navigation

<PageTitle>Admin - Entrar</PageTitle>

<div class="d-flex align-items-center justify-content-center py-5" style="min-height: 60vh;">
    <div class="painel w-100" style="max-width: 400px;">
        <div class="p-4">
            <div class="text-center mb-4">
                <h1 class="h5 fw-medium text-body-emphasis mb-1">Acesso admin</h1>
                <p class="text-body-secondary small mb-0">Informe seu token para continuar</p>
            </div>

            @if (!string.IsNullOrEmpty(_erro))
            {
                <div class="alert alert-danger alert-dismissible" role="alert">
                    @_erro
                    <button type="button" class="btn-close btn-sm" @onclick='() => _erro = null'></button>
                </div>
            }

            <div class="mb-3">
                <label for="tokenInput" class="form-label">Token</label>
                <input
                    id="tokenInput"
                    type="password"
                    class="form-control"
                    placeholder="Cole seu token de admin aqui"
                    @bind="_token"
                    @bind:event="oninput"
                    @onkeyup="@((KeyboardEventArgs e) => { if (e.Key == "Enter") SubmeterAsync().GetAwaiter().GetResult(); })"
                    autocomplete="one-time-code"
                    disabled="@_carregando" />
            </div>

            <button
                class="btn btn-primary w-100"
                @onclick="SubmeterAsync"
                disabled="@(_carregando || string.IsNullOrWhiteSpace(_token))">
                @(_carregando ? "Autenticando..." : "Entrar como Admin")
            </button>

            <div class="text-center mt-3">
                <a href="/" class="text-body-secondary text-decoration-none small d-inline-flex align-items-center gap-1">
                    <Icone Nome="arrow-left" Tamanho="14" /> Voltar ao início
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>Página de admin que mandou para cá; só caminhos do próprio site.</summary>
    [SupplyParameterFromQuery(Name = "voltar")] public string? Voltar { get; set; }

    private string Destino =>
        !string.IsNullOrEmpty(Voltar) && Voltar.StartsWith('/') && !Voltar.StartsWith("//") && !Voltar.StartsWith("/\\")
            ? Voltar
            : "/admin/liga";

    private string _token = string.Empty;
    private string? _erro;
    private bool _carregando;

    private async Task SubmeterAsync()
    {
        if (string.IsNullOrWhiteSpace(_token))
            return;

        _erro = null;
        _carregando = true;

        try
        {
            var resultado = await AdminAuth.EntrarAsync(_token);
            if (resultado.Sucesso)
            {
                Navigation.NavigateTo(Destino, forceLoad: false);
            }
            else
            {
                _erro = resultado.Mensagem;
                _token = string.Empty;
            }
        }
        catch
        {
            _erro = "Erro ao validar token. Tente novamente.";
            _token = string.Empty;
        }
        finally
        {
            _carregando = false;
        }
    }
}
