@page "/admin/abas"
@using Fc25Draft.Web.Models.Navigation
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IAbasEscondidasService AbasSvc
@inject AbasEscondidas AbasEscondidas
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService

<PageTitle>Abas do Site — Admin</PageTitle>

<div>
    @if (_erro is not null)
    {
        <div class="alert alert-danger alert-dismissible">@_erro<button type="button" class="btn-close" @onclick="() => _erro = null"></button></div>
    }
    @if (_ok is not null)
    {
        <div class="alert alert-success alert-dismissible">@_ok<button type="button" class="btn-close" @onclick="() => _ok = null"></button></div>
    }

    <p class="text-muted small mb-3">
        Desligue as páginas que não precisam ficar no menu agora (o draft acabou, o álbum ainda não começou...).
        Elas somem do menu lateral, da barra de baixo do celular e dos atalhos da Central para todo mundo, na hora,
        mesmo para quem já está com o site aberto. Os links que já existem (Plantão, notícias, avisos) continuam
        abrindo a página. Você, como admin, continua vendo no menu, apagadas e com
        <Icone Nome="eye-off" Tamanho="13" />.
    </p>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <button type="button" class="btn btn-primary" disabled="@(_salvando || !Mudou)" @onclick="SalvarAsync">
            @if (_salvando)
            {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
            }
            Salvar
        </button>
        <button type="button" class="btn btn-outline-secondary" disabled="@(_salvando || !Mudou)" @onclick="Desfazer">Desfazer</button>
        <span class="small text-muted ms-1">
            @if (Mudou)
            {
                <text>Alterações não salvas.</text>
            }
            else if (_escondidas.Count == 0)
            {
                <text>Todas as páginas aparecem.</text>
            }
            else
            {
                <text>@(_escondidas.Count == 1 ? "1 página escondida." : $"{_escondidas.Count} páginas escondidas.")</text>
            }
        </span>
    </div>

    <div class="row g-3">
        @foreach (var grupo in _grupos)
        {
            var escondidasNoGrupo = grupo.Items.Count(i => _escondidas.Contains(i.Href));
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-header d-flex flex-wrap align-items-center gap-2">
                        <span class="fw-medium">@grupo.Title</span>
                        @if (escondidasNoGrupo > 0)
                        {
                            <span class="badge text-bg-secondary">@escondidasNoGrupo escondida@(escondidasNoGrupo == 1 ? "" : "s")</span>
                        }
                        <span class="ms-auto d-flex gap-1 text-nowrap">
                            <button type="button" class="btn btn-sm btn-link p-0 px-1" disabled="@(escondidasNoGrupo == 0)"
                                    @onclick="() => MarcarGrupo(grupo, esconder: false)">Mostrar todas</button>
                            <button type="button" class="btn btn-sm btn-link p-0 px-1" disabled="@(escondidasNoGrupo == grupo.Items.Count)"
                                    @onclick="() => MarcarGrupo(grupo, esconder: true)">Esconder todas</button>
                        </span>
                    </div>
                    <ul class="list-group list-group-flush">
                        @foreach (var item in grupo.Items)
                        {
                            var aparece = !_escondidas.Contains(item.Href);
                            var id = "aba-" + item.Href.Trim('/').Replace('/', '-');
                            <li class="list-group-item d-flex align-items-center gap-2 @(aparece ? "" : "text-body-tertiary")">
                                <Icone Nome="@item.Icon" Tamanho="16" />
                                <label class="flex-grow-1 mb-0" for="@id" style="cursor: pointer;">
                                    @item.Title
                                    <span class="d-block small text-muted">@item.Href</span>
                                </label>
                                <div class="form-check form-switch mb-0" title="@(aparece ? "Aparece no menu" : "Escondida")">
                                    <input class="form-check-input" type="checkbox" role="switch" id="@id"
                                           checked="@aparece" @onchange="e => Marcar(item.Href, e.Value is true)" />
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private IReadOnlyList<MenuGroup> _grupos = Array.Empty<MenuGroup>();
    private HashSet<string> _escondidas = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _salvas = new(StringComparer.OrdinalIgnoreCase);
    private bool _salvando;
    private string? _erro;
    private string? _ok;

    private bool Mudou => !_escondidas.SetEquals(_salvas);

    protected override void OnInitialized()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/admin/abas"));
        _grupos = NavigationService.ItensQuePodemSerEscondidos();

        // Só os endereços que ainda existem no menu (um item que saiu do menu não volta a contar aqui).
        var doMenu = _grupos.SelectMany(g => g.Items).Select(i => i.Href).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _salvas = AbasEscondidas.Rotas.Where(doMenu.Contains).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _escondidas = new HashSet<string>(_salvas, StringComparer.OrdinalIgnoreCase);
    }

    private void Marcar(string href, bool aparece)
    {
        _ok = null;
        if (aparece) _escondidas.Remove(href);
        else _escondidas.Add(href);
    }

    private void MarcarGrupo(MenuGroup grupo, bool esconder)
    {
        foreach (var item in grupo.Items)
            Marcar(item.Href, aparece: !esconder);
    }

    private void Desfazer()
    {
        _escondidas = new HashSet<string>(_salvas, StringComparer.OrdinalIgnoreCase);
        _ok = null;
    }

    private async Task SalvarAsync()
    {
        _salvando = true;
        _erro = null;
        _ok = null;
        try
        {
            var rotas = _escondidas.ToList();
            await AbasSvc.SalvarAsync(rotas, CancellationToken.None);
            AbasEscondidas.Usar(rotas);
            _salvas = new HashSet<string>(_escondidas, StringComparer.OrdinalIgnoreCase);
            _ok = rotas.Count == 0
                ? "Salvo. Todas as páginas aparecem no menu."
                : $"Salvo. {(rotas.Count == 1 ? "1 página escondida" : $"{rotas.Count} páginas escondidas")} do menu.";
        }
        catch (Exception ex)
        {
            _erro = "Não foi possível salvar: " + ex.Message;
        }
        finally
        {
            _salvando = false;
        }
    }
}
