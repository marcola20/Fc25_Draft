@page "/treinadores"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Entities
@using Fc25Draft.Core.Interfaces
@inject ITreinadorService TreinadorSvc
@inject EscudoService EscudoService

<PageTitle>Treinadores</PageTitle>

<div>
    @if (_carregando)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    }
    else if (_erro is not null)
    {
        <div class="alert alert-danger"><strong>Erro ao carregar os treinadores:</strong> @_erro</div>
    }
    else if (_treinadores.Count == 0)
    {
        <div class="alert alert-info">Nenhum treinador cadastrado ainda.</div>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">
            <p class="text-body-secondary small mb-0">Quem comanda cada clube da CBFV. Clique no técnico para ver a carreira</p>
            <a href="/hall-of-fame" class="btn btn-sm btn-outline-secondary"><Icone Nome="trophy" Tamanho="14" /> Hall da Fama</a>
        </div>

        @if (_noComando.Count > 0)
        {
            <div class="secao-titulo"><h2>No comando <span class="numero text-body-tertiary">@_noComando.Count</span></h2></div>
            <div class="row g-3 mb-4">
                @foreach (var t in _noComando)
                {
                    <div class="col-12 col-md-6 col-xl-4">@Card(t)</div>
                }
            </div>
        }

        @if (_semTime.Count > 0)
        {
            <div class="secao-titulo"><h2>Sem clube <span class="numero text-body-tertiary">@_semTime.Count</span></h2></div>
            <div class="row g-3">
                @foreach (var t in _semTime)
                {
                    <div class="col-12 col-md-6 col-xl-4">@Card(t)</div>
                }
            </div>
        }
    }
</div>

@code {
    private bool _carregando = true;
    private string? _erro;

    private IReadOnlyList<TreinadorDto> _treinadores = Array.Empty<TreinadorDto>();
    private List<TreinadorDto> _noComando = new();
    private List<TreinadorDto> _semTime = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Quem saiu continua na lista: a carreira dele é parte da história da liga.
            _treinadores = await TreinadorSvc.ListAsync(true, CancellationToken.None);
            _noComando = _treinadores.Where(t => t.Hoje is not null)
                .OrderBy(t => t.Hoje!.TimeNome).ThenBy(t => t.Hoje!.Papel).ToList();
            _semTime = _treinadores.Where(t => t.Hoje is null)
                .OrderByDescending(t => t.Ativo).ThenBy(t => t.Nome).ToList();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _carregando = false; }
    }

    // O cartão inteiro leva à carreira: foto do técnico, nome e o clube de hoje com o escudo.
    private RenderFragment Card(TreinadorDto t) => @<a href="/treinadores/@t.TreinadorId" class="treinador painel @(t.Hoje is null && !t.Ativo ? "fora" : "")">
        <FotoTreinador TreinadorId="@t.TreinadorId" Tamanho="48" Alt="@t.Nome" Classe="treinador-foto" />
        <div class="treinador-info">
            <div class="treinador-nome">
                <span class="text-truncate">@t.Nome</span>
                @if (t.Passagens.Count > 1)
                {
                    <span class="treinador-clubes"><span class="numero">@t.Passagens.Count</span> clubes</span>
                }
            </div>
            <div class="treinador-clube">
                @if (t.Hoje is { } atual)
                {
                    <img src="@EscudoService.GetEscudo(atual.TimeNome)" alt="" />
                    <span class="text-truncate">@(atual.Papel == PapelTreinador.Auxiliar ? "Auxiliar" : "Treinador") do @atual.TimeNome</span>
                }
                else if (!t.Ativo)
                {
                    <span class="text-truncate">Fora da liga · último clube: @(t.Passagens.FirstOrDefault()?.TimeNome ?? "—")</span>
                }
                else
                {
                    <span>Sem clube no momento</span>
                }
            </div>
        </div>
    </a>;
}
