@page "/loteria"
@implements IDisposable
@using Fc25Draft.Core.Utilities
@inject LotteryStateService LotteryService
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService

<PageTitle>Loteria do Draft</PageTitle>

<div class="lottery-page">

    @if (LotteryService.State is null)
    {
        <div class="lottery-waiting">
            <div class="lottery-waiting-icon"><Icone Nome="ticket" Tamanho="28" /></div>
            <h2>Aguardando a Loteria</h2>
            <p>A loteria ainda não foi iniciada. Acompanhe quando o administrador começar o sorteio.</p>
        </div>
    }
    else
    {
        var s = LotteryService.State;

        <div class="lottery-header">
            <div class="lottery-header-meta">
                <span class="etiqueta">@s.LigaNome</span>
                <span class="etiqueta acento">Round @s.Rodada</span>
            </div>
            <h1 class="lottery-title">Loteria do Draft</h1>
            <p class="lottery-subtitle">
                @if (s.IsFinished)
                {
                    <span class="lottery-finished-label">Sorteio encerrado</span>
                }
                else if (s.HasPending)
                {
                    <span>Revelando as picks</span>
                }
                else if (s.Round1Done)
                {
                    <span>Round 1 concluído · aguardando o Round 2</span>
                }
                else if (s.Round2Done)
                {
                    <span>Aguardando encerramento</span>
                }
            </p>
        </div>

        @if (s.IsFinished)
        {
            var r1Final = s.Round1Results.Count > 0
                ? s.Round1Results.OrderBy(p => p.PickNumero).ToList()
                : (s.Rodada == 1 ? s.Revealed.OrderBy(p => p.PickNumero).ToList() : new());
            var r2Final = s.Rodada == 2 ? s.Revealed.OrderBy(p => p.PickNumero).ToList() : new();

            <div class="lottery-final-wrap">
                <!-- Round 1 -->
                <div class="lottery-final-board">
                    <div class="lottery-final-header">
                        <span>Round 1 · ordem do draft</span>
                    </div>
                    @foreach (var pick in r1Final)
                    {
                        <div class="lottery-final-row">
                            <span class="lottery-final-pick @(pick.PickNumero == 1 ? "lottery-final-pick-gold" : "")">#@pick.PickNumero</span>
                            <img src="@EscudoUrl(pick.TimeNome)" alt="" class="lottery-final-escudo" onerror="this.style.display='none'" />
                            <span class="lottery-final-name">@pick.TimeNome</span>
                            <span class="lottery-final-pos">@pick.OrigemTexto</span>
                        </div>
                    }
                </div>

                <!-- Round 2 (só se existir) -->
                @if (r2Final.Count > 0)
                {
                    <div class="lottery-final-board">
                        <div class="lottery-final-header">
                            <span>Round 2 · ordem do draft</span>
                        </div>
                        @foreach (var pick in r2Final)
                        {
                            <div class="lottery-final-row">
                                <span class="lottery-final-pick">#@pick.PickNumero</span>
                                <img src="@EscudoUrl(pick.TimeNome)" alt="" class="lottery-final-escudo" onerror="this.style.display='none'" />
                                <span class="lottery-final-name">@pick.TimeNome</span>
                                <span class="lottery-final-pos">@pick.OrigemTexto</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="lottery-stage">
                <!-- Revealed picks -->
                @if (s.Revealed.Count > 0)
                {
                    <div class="lottery-revealed-list">
                        @for (int i = s.Revealed.Count - 1; i >= 0; i--)
                        {
                            var pick = s.Revealed[i];
                            bool isLatest    = i == s.Revealed.Count - 1;
                            bool isPick1     = pick.PickNumero == 1 && s.Rodada == 1;
                            bool isZone      = pick.PickNumero <= LoteriaDraft.PicksSorteadasRound1 && s.Rodada == 1 && !isPick1;

                            string cardClass = isLatest
                                ? (isPick1 ? "lottery-card-latest lottery-card-pick1"
                                           : isZone ? "lottery-card-latest lottery-card-zone"
                                           : "lottery-card-latest")
                                : (isPick1 ? "lottery-card-done lottery-card-done-pick1"
                                           : isZone ? "lottery-card-done lottery-card-done-zone"
                                           : "lottery-card-done");

                            <div class="lottery-card @cardClass">
                                <div class="lottery-card-pick @(isPick1 && isLatest ? "lottery-pick-gold" : isZone && isLatest ? "lottery-pick-purple" : "")">
                                    @if (isPick1 && isLatest) { <Icone Nome="trophy" Tamanho="18" /> }
                                    #@pick.PickNumero
                                </div>
                                <img src="@EscudoUrl(pick.TimeNome)" alt="" class="lottery-card-escudo" onerror="this.style.display='none'" />
                                <div class="lottery-card-info">
                                    <div class="lottery-card-name">@pick.TimeNome</div>
                                    @if (isZone && isLatest)
                                    {
                                        <div class="lottery-card-zone-label">Concorreu à pick #1</div>
                                    }
                                </div>
                                <div class="lottery-card-pos">@pick.OrigemTexto</div>
                            </div>
                        }
                    </div>
                }

                <!-- Pending count -->
                @if (s.HasPending)
                {
                    <div class="lottery-pending-info">
                        <span class="lottery-pending-badge">@s.Pending.Count restante@(s.Pending.Count != 1 ? "s" : "")</span>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    protected override void OnInitialized()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/loteria"));
        LotteryService.OnChange += HandleChange;
    }

    // async void: uma exceção aqui (conexão já encerrada) derrubaria o processo, então fica contida.
    private async void HandleChange()
    {
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    public void Dispose() => LotteryService.OnChange -= HandleChange;

    private static string EscudoUrl(string teamName)
    {
        var normalized = string.Concat(
            teamName.Normalize(System.Text.NormalizationForm.FormD)
                    .Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c)
                                != System.Globalization.UnicodeCategory.NonSpacingMark));
        return $"/images/escudos/{normalized}.png";
    }
}

@* Uma entrada só para cada pick revelada (sobe e aparece); a pick #1 entra um pouco mais devagar e fica
   com o dourado. Sem tremida, brilho pulsando ou degradê. *@
<style>
    .lottery-page {
        max-width: 760px;
        margin: 0 auto;
        padding: 0.5rem 0 4rem;
    }

    /* ─ Esperando ─ */
    .lottery-waiting {
        padding: 5rem 1rem;
        text-align: center;
    }

    .lottery-waiting-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 4rem;
        height: 4rem;
        margin-bottom: 1rem;
        border: 1px solid var(--bs-border-color);
        border-radius: 50%;
        color: var(--bs-tertiary-color);
    }

    .lottery-waiting h2 {
        margin-bottom: 0.5rem;
        font-size: 1.5rem;
        font-weight: 500;
        color: var(--bs-emphasis-color);
    }

    .lottery-waiting p {
        margin: 0 auto;
        max-width: 28rem;
        font-size: 0.9375rem;
        color: var(--bs-secondary-color);
    }

    /* ─ Topo ─ */
    .lottery-header {
        margin-bottom: 2rem;
        text-align: center;
    }

    .lottery-header-meta {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .lottery-title {
        margin: 0 0 0.375rem;
        font-size: 2rem;
        font-weight: 500;
        color: var(--bs-emphasis-color);
    }

    .lottery-subtitle {
        margin: 0;
        font-size: 0.9375rem;
        color: var(--bs-secondary-color);
    }

    .lottery-finished-label {
        font-weight: 500;
        color: var(--cbfv-vitoria);
    }

    /* ─ Palco ─ */
    .lottery-stage {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .lottery-revealed-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .lottery-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1.25rem;
        border: 1px solid var(--bs-border-color);
        border-radius: 0.75rem;
        background: var(--bs-body-bg);
    }

    .lottery-card-latest {
        padding: 1rem 1.25rem;
        border-color: rgba(var(--bs-emphasis-color-rgb), 0.18);
        animation: lotteryReveal 360ms var(--cbfv-curva) both;
    }

    .lottery-card-done {
        background: transparent;
    }

    .lottery-card-pick1,
    .lottery-card-done-pick1 {
        border-color: rgba(201, 148, 40, 0.55);
        box-shadow: inset 3px 0 0 var(--cbfv-acento);
    }

    .lottery-card-pick1 {
        animation: lotteryRevealGrand 600ms var(--cbfv-curva) both;
    }

    @@keyframes lotteryReveal {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @@keyframes lotteryRevealGrand {
        from { opacity: 0; transform: translateY(12px) scale(0.98); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    @@media (prefers-reduced-motion: reduce) {
        .lottery-card-latest,
        .lottery-card-pick1 { animation: none; }
    }

    .lottery-card-pick {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        gap: 0.375rem;
        min-width: 3.5rem;
        font-family: var(--bs-font-monospace);
        font-size: 1.375rem;
        font-weight: 500;
        color: var(--bs-emphasis-color);
    }

    .lottery-pick-gold {
        color: var(--cbfv-acento-texto);
    }

    .lottery-card-done .lottery-card-pick {
        font-size: 0.9375rem;
        color: var(--bs-secondary-color);
    }

    .lottery-card-done-pick1 .lottery-card-pick {
        color: var(--cbfv-acento-texto);
    }

    .lottery-card-escudo {
        flex-shrink: 0;
        width: 44px;
        height: 44px;
        object-fit: contain;
    }

    .lottery-card-done .lottery-card-escudo {
        width: 28px;
        height: 28px;
    }

    .lottery-card-info {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 0.125rem;
        min-width: 0;
    }

    .lottery-card-name {
        font-size: 1.125rem;
        font-weight: 500;
        color: var(--bs-emphasis-color);
    }

    .lottery-card-done .lottery-card-name {
        font-size: 0.9375rem;
    }

    .lottery-card-zone-label {
        font-size: 0.75rem;
        color: var(--cbfv-acento-texto);
    }

    .lottery-card-pos {
        font-size: 0.8125rem;
        color: var(--bs-tertiary-color);
        white-space: nowrap;
    }

    .lottery-pending-info {
        padding: 0.5rem;
        text-align: center;
    }

    .lottery-pending-badge {
        font-size: 0.8125rem;
        font-variant-numeric: tabular-nums;
        color: var(--bs-tertiary-color);
    }

    /* ─ Resultado final ─ */
    .lottery-final-wrap {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .lottery-final-board {
        overflow: hidden;
        border: 1px solid var(--bs-border-color);
        border-radius: 0.75rem;
        background: var(--bs-body-bg);
    }

    .lottery-final-header {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--bs-border-color);
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--bs-body-color);
    }

    .lottery-final-row {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        padding: 0.625rem 1rem;
        border-bottom: 1px solid var(--bs-border-color);
    }

    .lottery-final-row:last-child { border-bottom: none; }

    .lottery-final-pick {
        min-width: 2.5rem;
        font-family: var(--bs-font-monospace);
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--bs-secondary-color);
        text-align: center;
    }

    .lottery-final-pick-gold {
        color: var(--cbfv-acento-texto) !important;
    }

    .lottery-final-escudo {
        width: 28px;
        height: 28px;
        object-fit: contain;
    }

    .lottery-final-name {
        flex: 1;
        font-size: 0.9375rem;
        font-weight: 500;
        color: var(--bs-emphasis-color);
    }

    .lottery-final-pos {
        font-size: 0.75rem;
        color: var(--bs-tertiary-color);
    }
</style>
