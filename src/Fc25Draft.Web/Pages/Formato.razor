@page "/formato"
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService

<PageTitle>Formato da Competição — CBFV Retro 2008/09</PageTitle>

<PageHeader Title="Formato da Competição" />

@code {
    protected override void OnInitialized()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/formato"));
    }
}

<div class="formato-page">

    <!-- LIGA -->
    <section class="fmt-section">
        <div class="fmt-section-header">
            <span class="fmt-section-icon">🏆</span>
            <h3>Liga</h3>
        </div>

        <div class="fmt-overview-grid fmt-overview-grid-3">
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">12</div>
                <div class="fmt-stat-label">Times</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">11</div>
                <div class="fmt-stat-label">Rodadas</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">1°</div>
                <div class="fmt-stat-label">É Campeão</div>
            </div>
        </div>

        <div class="fmt-card fmt-card-liga">
            <p class="fmt-desc">
                Todos os <strong>12 times</strong> se enfrentam em <strong>pontos corridos</strong> ao longo de <strong>11 rodadas</strong>.
                O primeiro colocado ao final é o <strong>campeão da Liga</strong>.
            </p>

            <div class="fmt-tiebreak-section">
                <div class="fmt-tiebreak-header">
                    <span class="fmt-tiebreak-icon">⚖️</span>
                    <span>Critérios de Desempate</span>
                </div>
                <div class="fmt-tiebreak-cards">
                    <div class="fmt-tiebreak-card">
                        <div class="fmt-tiebreak-badge fmt-badge-blue">2 times</div>
                        <div class="fmt-tiebreak-content">
                            <strong>Jogo Decisivo</strong>
                            <span>Os dois times empatados disputam um jogo único para definir o campeão.</span>
                        </div>
                    </div>
                    <div class="fmt-tiebreak-card">
                        <div class="fmt-tiebreak-badge fmt-badge-purple">3+ times</div>
                        <div class="fmt-tiebreak-content">
                            <strong>Mini Liga</strong>
                            <span>Contabiliza apenas os confrontos diretos entre os times empatados. Os 2 melhores da mini liga avançam para o jogo decisivo.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="fmt-flow">
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon">📋</div>
                <div class="fmt-flow-content">
                    <strong>Todos contra Todos</strong>
                    <span>11 rodadas · pontos corridos</span>
                </div>
            </div>
            <div class="fmt-flow-connector">→</div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon">⚖️</div>
                <div class="fmt-flow-content">
                    <strong>Empate no topo?</strong>
                    <span>Mini liga ou jogo decisivo</span>
                </div>
            </div>
            <div class="fmt-flow-connector">→</div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon">🏆</div>
                <div class="fmt-flow-content">
                    <strong>Campeão da Liga</strong>
                    <span>1° colocado ao final</span>
                </div>
            </div>
        </div>
    </section>

    <hr class="fmt-divider" />

    <!-- COPA -->
    <section class="fmt-section">
        <div class="fmt-section-header">
            <span class="fmt-section-icon">🥇</span>
            <h3>Copa</h3>
        </div>

        <div class="fmt-overview-grid fmt-overview-grid-4">
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">2</div>
                <div class="fmt-stat-label">Grupos</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">6</div>
                <div class="fmt-stat-label">Times por Grupo</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">2</div>
                <div class="fmt-stat-label">Classificados por Grupo</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">3</div>
                <div class="fmt-stat-label">Fases Finais</div>
            </div>
        </div>

        <div class="fmt-copa-phase">
            <div class="fmt-phase-label">
                <span class="fmt-phase-icon">📋</span>
                <span>Fase de Grupos</span>
            </div>

            <div class="fmt-groups-grid">
                <div class="fmt-group-card">
                    <div class="fmt-group-header fmt-group-a">Grupo A</div>
                    <div class="fmt-group-body">
                        <div class="fmt-group-teams">
                            <div class="fmt-group-team"><span class="fmt-team-dot fmt-dot-a"></span>Time A1</div>
                            <div class="fmt-group-team"><span class="fmt-team-dot fmt-dot-a"></span>Time A2</div>
                            <div class="fmt-group-team"><span class="fmt-team-dot fmt-dot-a"></span>Time A3</div>
                            <div class="fmt-group-team"><span class="fmt-team-dot fmt-dot-a"></span>Time A4</div>
                            <div class="fmt-group-team"><span class="fmt-team-dot fmt-dot-a"></span>Time A5</div>
                            <div class="fmt-group-team"><span class="fmt-team-dot fmt-dot-a"></span>Time A6</div>
                        </div>
                        <div class="fmt-group-desc">Enfrenta todos do <strong>Grupo B</strong> (cross-group)</div>
                        <div class="fmt-group-advance">
                            <span class="fmt-advance-badge">✅ Top 2 avançam</span>
                        </div>
                    </div>
                </div>

                <div class="fmt-groups-vs">
                    <div class="fmt-groups-vs-label">Cross-Group</div>
                    <div class="fmt-groups-vs-arrow">↔</div>
                </div>

                <div class="fmt-group-card">
                    <div class="fmt-group-header fmt-group-b">Grupo B</div>
                    <div class="fmt-group-body">
                        <div class="fmt-group-teams">
                            <div class="fmt-group-team"><span class="fmt-team-dot fmt-dot-b"></span>Time B1</div>
                            <div class="fmt-group-team"><span class="fmt-team-dot fmt-dot-b"></span>Time B2</div>
                            <div class="fmt-group-team"><span class="fmt-team-dot fmt-dot-b"></span>Time B3</div>
                            <div class="fmt-group-team"><span class="fmt-team-dot fmt-dot-b"></span>Time B4</div>
                            <div class="fmt-group-team"><span class="fmt-team-dot fmt-dot-b"></span>Time B5</div>
                            <div class="fmt-group-team"><span class="fmt-team-dot fmt-dot-b"></span>Time B6</div>
                        </div>
                        <div class="fmt-group-desc">Enfrenta todos do <strong>Grupo A</strong> (cross-group)</div>
                        <div class="fmt-group-advance">
                            <span class="fmt-advance-badge">✅ Top 2 avançam</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="fmt-copa-phase">
            <div class="fmt-phase-label">
                <span class="fmt-phase-icon">⚔️</span>
                <span>Fases Finais</span>
            </div>

            <div class="fmt-knockout-bracket">
                <div class="fmt-knockout-col">
                    <div class="fmt-ko-match fmt-ko-match-a">
                        <div class="fmt-ko-label">Semifinal — Grupo A</div>
                        <div class="fmt-ko-matchup">
                            <div class="fmt-ko-team">
                                <span class="fmt-ko-seed fmt-seed-a">A1°</span>
                                <span class="fmt-ko-name">1º do Grupo A</span>
                            </div>
                            <div class="fmt-ko-vs">VS</div>
                            <div class="fmt-ko-team">
                                <span class="fmt-ko-seed fmt-seed-a">A2°</span>
                                <span class="fmt-ko-name">2º do Grupo A</span>
                            </div>
                        </div>
                        <div class="fmt-ko-result">
                            <span class="fmt-result-win">Vencedor → Final</span>
                            <span class="fmt-result-lose">Perdedor → Eliminado</span>
                        </div>
                    </div>
                </div>

                <div class="fmt-knockout-arrow">→</div>

                <div class="fmt-knockout-col fmt-knockout-col-final">
                    <div class="fmt-ko-match fmt-ko-match-final">
                        <div class="fmt-ko-label">🏆 Final</div>
                        <div class="fmt-ko-matchup">
                            <div class="fmt-ko-team">
                                <span class="fmt-ko-seed fmt-seed-a">W-A</span>
                                <span class="fmt-ko-name">Vencedor SF-A</span>
                            </div>
                            <div class="fmt-ko-vs">VS</div>
                            <div class="fmt-ko-team">
                                <span class="fmt-ko-seed fmt-seed-b">W-B</span>
                                <span class="fmt-ko-name">Vencedor SF-B</span>
                            </div>
                        </div>
                        <div class="fmt-ko-result">
                            <span class="fmt-result-win fmt-result-champion">🏆 Campeão da Copa</span>
                        </div>
                    </div>
                </div>

                <div class="fmt-knockout-arrow">←</div>

                <div class="fmt-knockout-col">
                    <div class="fmt-ko-match fmt-ko-match-b">
                        <div class="fmt-ko-label">Semifinal — Grupo B</div>
                        <div class="fmt-ko-matchup">
                            <div class="fmt-ko-team">
                                <span class="fmt-ko-seed fmt-seed-b">B1°</span>
                                <span class="fmt-ko-name">1º do Grupo B</span>
                            </div>
                            <div class="fmt-ko-vs">VS</div>
                            <div class="fmt-ko-team">
                                <span class="fmt-ko-seed fmt-seed-b">B2°</span>
                                <span class="fmt-ko-name">2º do Grupo B</span>
                            </div>
                        </div>
                        <div class="fmt-ko-result">
                            <span class="fmt-result-win">Vencedor → Final</span>
                            <span class="fmt-result-lose">Perdedor → Eliminado</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="fmt-flow">
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon">📋</div>
                <div class="fmt-flow-content">
                    <strong>Fase de Grupos</strong>
                    <span>2 grupos × 6 times</span>
                </div>
            </div>
            <div class="fmt-flow-connector">→</div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon">⚔️</div>
                <div class="fmt-flow-content">
                    <strong>Semifinais</strong>
                    <span>Top 2 de cada grupo</span>
                </div>
            </div>
            <div class="fmt-flow-connector">→</div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon">🥇</div>
                <div class="fmt-flow-content">
                    <strong>Final</strong>
                    <span>Vencedores de cada SF</span>
                </div>
            </div>
            <div class="fmt-flow-connector">→</div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon">🏆</div>
                <div class="fmt-flow-content">
                    <strong>Campeão da Copa</strong>
                    <span>Vencedor da Final</span>
                </div>
            </div>
        </div>
    </section>

    <hr class="fmt-divider" />

    <!-- CALENDÁRIO -->
    <section class="fmt-section">
        <div class="fmt-section-header">
            <span class="fmt-section-icon">📅</span>
            <h3>Calendário da Temporada</h3>
        </div>

        <div class="fmt-overview-grid fmt-overview-grid-4">
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">20</div>
                <div class="fmt-stat-label">Datas</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">11</div>
                <div class="fmt-stat-label">Rodadas de Liga</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">6</div>
                <div class="fmt-stat-label">Grupos da Copa</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">3</div>
                <div class="fmt-stat-label">Datas Especiais</div>
            </div>
        </div>

        <div class="fmt-cal-legend">
            <span class="fmt-cal-legend-item"><span class="fmt-cal-dot fmt-dot-liga"></span>Liga</span>
            <span class="fmt-cal-legend-item"><span class="fmt-cal-dot fmt-dot-copa"></span>Copa</span>
            <span class="fmt-cal-legend-item"><span class="fmt-cal-dot fmt-dot-special"></span>Mercado / All-Star</span>
            <span class="fmt-cal-legend-item"><span class="fmt-cal-dot fmt-dot-semi"></span>Semifinais</span>
            <span class="fmt-cal-legend-item"><span class="fmt-cal-dot fmt-dot-final"></span>Final</span>
        </div>

        <div class="fmt-cal-grid">
            <div class="fmt-cal-card fmt-cal-liga">
                <span class="fmt-cal-num">1</span>
                <span class="fmt-cal-comp">Liga<small>Rodada 1</small></span>
            </div>
            <div class="fmt-cal-card fmt-cal-copa">
                <span class="fmt-cal-num">2</span>
                <span class="fmt-cal-comp">Copa<small>Rodada 1</small></span>
            </div>
            <div class="fmt-cal-card fmt-cal-liga">
                <span class="fmt-cal-num">3</span>
                <span class="fmt-cal-comp">Liga<small>Rodada 2</small></span>
            </div>
            <div class="fmt-cal-card fmt-cal-liga">
                <span class="fmt-cal-num">4</span>
                <span class="fmt-cal-comp">Liga<small>Rodada 3</small></span>
            </div>
            <div class="fmt-cal-card fmt-cal-copa">
                <span class="fmt-cal-num">5</span>
                <span class="fmt-cal-comp">Copa<small>Rodada 2</small></span>
            </div>
            <div class="fmt-cal-card fmt-cal-liga">
                <span class="fmt-cal-num">6</span>
                <span class="fmt-cal-comp">Liga<small>Rodada 4</small></span>
            </div>
            <div class="fmt-cal-card fmt-cal-copa">
                <span class="fmt-cal-num">7</span>
                <span class="fmt-cal-comp">Copa<small>Rodada 3</small></span>
            </div>
            <div class="fmt-cal-card fmt-cal-liga">
                <span class="fmt-cal-num">8</span>
                <span class="fmt-cal-comp">Liga<small>Rodada 5</small></span>
            </div>
            <div class="fmt-cal-card fmt-cal-liga">
                <span class="fmt-cal-num">9</span>
                <span class="fmt-cal-comp">Liga<small>Rodada 6</small></span>
            </div>
            <div class="fmt-cal-card fmt-cal-copa">
                <span class="fmt-cal-num">10</span>
                <span class="fmt-cal-comp">Copa<small>Rodada 4</small></span>
            </div>
            <div class="fmt-cal-card fmt-cal-special">
                <span class="fmt-cal-num">11</span>
                <span class="fmt-cal-comp">Mercado / All-Star</span>
            </div>
            <div class="fmt-cal-card fmt-cal-liga">
                <span class="fmt-cal-num">12</span>
                <span class="fmt-cal-comp">Liga<small>Rodada 7</small></span>
            </div>
            <div class="fmt-cal-card fmt-cal-copa">
                <span class="fmt-cal-num">13</span>
                <span class="fmt-cal-comp">Copa<small>Rodada 5</small></span>
            </div>
            <div class="fmt-cal-card fmt-cal-liga">
                <span class="fmt-cal-num">14</span>
                <span class="fmt-cal-comp">Liga<small>Rodada 8</small></span>
            </div>
            <div class="fmt-cal-card fmt-cal-liga">
                <span class="fmt-cal-num">15</span>
                <span class="fmt-cal-comp">Liga<small>Rodada 9</small></span>
            </div>
            <div class="fmt-cal-card fmt-cal-copa">
                <span class="fmt-cal-num">16</span>
                <span class="fmt-cal-comp">Copa<small>Rodada 6</small></span>
            </div>
            <div class="fmt-cal-card fmt-cal-liga">
                <span class="fmt-cal-num">17</span>
                <span class="fmt-cal-comp">Liga<small>Rodada 10</small></span>
            </div>
            <div class="fmt-cal-card fmt-cal-semi">
                <span class="fmt-cal-num">18</span>
                <span class="fmt-cal-comp">Semifinais da Copa</span>
            </div>
            <div class="fmt-cal-card fmt-cal-liga">
                <span class="fmt-cal-num">19</span>
                <span class="fmt-cal-comp">Liga<small>Rodada 11 · última</small></span>
            </div>
            <div class="fmt-cal-card fmt-cal-final">
                <span class="fmt-cal-num">20</span>
                <span class="fmt-cal-comp">Final da Copa</span>
            </div>
        </div>
    </section>

</div>

<style>
    .formato-page {
        max-width: 960px;
        margin: 0 auto;
        padding-bottom: 3rem;
    }

    .fmt-section { margin-bottom: 2rem; }

    .fmt-section-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1.1rem;
    }

    .fmt-section-icon { font-size: 1.4rem; line-height: 1; }

    .fmt-section-header h3 {
        font-size: 1.3rem;
        font-weight: 700;
        margin: 0;
        color: var(--bs-emphasis-color, #212529);
        letter-spacing: -0.01em;
    }

    .fmt-divider {
        border-color: var(--bs-border-color, #dee2e6);
        margin: 2rem 0;
        opacity: 0.4;
    }

    .fmt-card {
        background: var(--bs-body-bg, #fff);
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.5rem;
        padding: 1.1rem 1.25rem;
        margin-bottom: 1rem;
    }

    .fmt-card-liga { border-left: 4px solid var(--bs-primary, #0d6efd); }

    .fmt-desc {
        font-size: 0.92rem;
        color: var(--bs-secondary-color, #6c757d);
        margin-bottom: 1rem;
        line-height: 1.6;
    }

    .fmt-overview-grid { display: grid; gap: 1rem; margin-bottom: 1rem; }
    .fmt-overview-grid-3 { grid-template-columns: repeat(3, 1fr); }
    .fmt-overview-grid-4 { grid-template-columns: repeat(4, 1fr); }

    @@media (max-width: 768px) {
        .fmt-overview-grid-3,
        .fmt-overview-grid-4 { grid-template-columns: repeat(2, 1fr); }
    }

    .fmt-stat-card {
        background: var(--bs-body-bg, #fff);
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.6rem;
        padding: 1.25rem 1rem;
        text-align: center;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }

    .fmt-stat-number {
        font-size: 2.25rem;
        font-weight: 800;
        color: var(--bs-primary, #0d6efd);
        line-height: 1.1;
    }

    .fmt-stat-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--bs-secondary-color, #6c757d);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-top: 0.3rem;
    }

    .fmt-tiebreak-section { margin-top: 0.5rem; }

    .fmt-tiebreak-header {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--bs-secondary-color, #6c757d);
        margin-bottom: 0.75rem;
    }

    .fmt-tiebreak-icon { font-size: 1rem; }

    .fmt-tiebreak-cards { display: flex; gap: 0.75rem; flex-wrap: wrap; }

    .fmt-tiebreak-card {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        flex: 1;
        min-width: 220px;
        padding: 0.85rem 1rem;
        background: var(--bs-secondary-bg, #f8f9fa);
        border-radius: 0.5rem;
        border: 1px solid var(--bs-border-color, #dee2e6);
    }

    .fmt-tiebreak-badge {
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 700;
        white-space: nowrap;
        flex-shrink: 0;
        margin-top: 0.1rem;
    }

    .fmt-badge-blue   { background: rgba(13,110,253,0.12); color: var(--bs-primary, #0d6efd); }
    .fmt-badge-purple { background: rgba(124,58,237,0.12); color: #7c3aed; }

    .fmt-tiebreak-content { display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.85rem; }
    .fmt-tiebreak-content strong { font-weight: 700; color: var(--bs-emphasis-color, #212529); }
    .fmt-tiebreak-content span   { font-size: 0.8rem; color: var(--bs-secondary-color, #6c757d); line-height: 1.5; }

    .fmt-copa-phase { margin-bottom: 1.25rem; }

    .fmt-phase-label {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--bs-secondary-color, #6c757d);
        margin-bottom: 0.75rem;
    }

    .fmt-phase-icon { font-size: 1rem; }

    .fmt-groups-grid {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
    }

    @@media (max-width: 700px) {
        .fmt-groups-grid      { grid-template-columns: 1fr; }
        .fmt-groups-vs        { justify-content: center; }
    }

    .fmt-group-card {
        background: var(--bs-body-bg, #fff);
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.6rem;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    }

    .fmt-group-header {
        padding: 0.4rem 1rem;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #fff;
    }

    .fmt-group-a { background: linear-gradient(90deg, #0d6efd, #4d9bff); }
    .fmt-group-b { background: linear-gradient(90deg, #7c3aed, #a855f7); }

    .fmt-group-body { padding: 0.75rem 1rem; }

    .fmt-group-teams { display: flex; flex-direction: column; gap: 0.25rem; margin-bottom: 0.75rem; }

    .fmt-group-team {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.83rem;
        color: var(--bs-secondary-color, #6c757d);
    }

    .fmt-team-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .fmt-dot-a    { background: #0d6efd; }
    .fmt-dot-b    { background: #7c3aed; }

    .fmt-group-desc { font-size: 0.78rem; color: var(--bs-secondary-color, #6c757d); margin-bottom: 0.5rem; line-height: 1.5; }
    .fmt-group-advance { display: flex; }

    .fmt-advance-badge {
        background: color-mix(in srgb, var(--bs-success, #198754) 10%, var(--bs-body-bg, #fff));
        border: 1px solid color-mix(in srgb, var(--bs-success, #198754) 30%, transparent);
        color: var(--bs-success, #198754);
        border-radius: 999px;
        padding: 0.2rem 0.65rem;
        font-size: 0.72rem;
        font-weight: 700;
    }

