@page "/formato"
@using System.Globalization
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Interfaces
@using Fc25Draft.Core.Utilities
@inject ILigaPublicService LigaService
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService

<PageTitle>Formato da Competição — CBFV Retro 2008/09</PageTitle>

<PageHeader Title="Formato da Competição" />

@code {
    private IReadOnlyList<DataDaTemporada> _calendario = Array.Empty<DataDaTemporada>();
    private CalendarioTemporadaDto? _temporadaCalendario;

    protected override void OnInitialized()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/formato"));
    }

    protected override async Task OnInitializedAsync()
    {
        // A abertura é a gravada para a temporada (Admin › Temporada); rodada com data mudada à mão
        // aparece na data nova.
        _temporadaCalendario = await LigaService.GetCalendarioAtualAsync(CancellationToken.None);
        _calendario = _temporadaCalendario?.Datas ?? Array.Empty<DataDaTemporada>();
    }

    private static readonly CultureInfo Br = CultureInfo.GetCultureInfo("pt-BR");

    // Números das ligas contados das rodadas do calendário: em pontos corridos de turno único cada time
    // joga uma vez com cada outro, então são rodadas + 1 times. Sem calendário, vale o formato atual.
    private int Rodadas(Divisao divisao, int padrao)
    {
        var n = _calendario.Count(d => d.Divisao == divisao && d.Rodada is not null);
        return n > 0 ? n : padrao;
    }

    private int RodadasA => Rodadas(Divisao.SerieA, 9);
    private int TimesA => RodadasA + 1;
    private int RodadasB => Rodadas(Divisao.SerieB, 7);
    private int TimesB => RodadasB + 1;

    private static string Classe(DataDaTemporada data) => data switch
    {
        { EhJogo: false } => "fmt-cal-mercado",
        { Titulo: "Supercopa" } or { Titulo: "Playoff de acesso" } => "fmt-cal-final",
        { Tipo: TipoCompetition.Copa, Rodada: null } => "fmt-cal-semi",
        { Tipo: TipoCompetition.Copa } => "fmt-cal-copa",
        { Divisao: Divisao.SerieB } => "fmt-cal-special",
        _ => "fmt-cal-liga"
    };
}

<div class="formato-page">

    <!-- SÉRIE A -->
    <section class="fmt-section">
        <div class="fmt-section-header">
            <h3>Série A</h3>
        </div>

        <div class="fmt-overview-grid fmt-overview-grid-3">
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">@TimesA</div>
                <div class="fmt-stat-label">Times</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">@RodadasA</div>
                <div class="fmt-stat-label">Rodadas</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">1°</div>
                <div class="fmt-stat-label">É campeão</div>
            </div>
        </div>

        <div class="fmt-card fmt-card-liga">
            <p class="fmt-desc">
                Todos os <strong>@TimesA times</strong> se enfrentam em <strong>pontos corridos</strong> ao longo de <strong>@RodadasA rodadas</strong>.
                O primeiro colocado ao final é o <strong>campeão da Série A</strong>. O <strong>último cai</strong> para a Série B e o
                <strong>@(TimesA - 1)° disputa o playoff</strong> contra o 2° da Série B.
            </p>

            <div class="fmt-tiebreak-section">
                <div class="fmt-tiebreak-header">
                    <span>Critérios de desempate</span>
                </div>
                <div class="fmt-tiebreak-cards">
                    <div class="fmt-tiebreak-card">
                        <div class="fmt-tiebreak-badge fmt-badge-blue">2 times</div>
                        <div class="fmt-tiebreak-content">
                            <strong>Jogo decisivo</strong>
                            <span>Os dois times empatados disputam um jogo único para definir o campeão.</span>
                        </div>
                    </div>
                    <div class="fmt-tiebreak-card">
                        <div class="fmt-tiebreak-badge fmt-badge-purple">3+ times</div>
                        <div class="fmt-tiebreak-content">
                            <strong>Mini liga</strong>
                            <span>Contabiliza apenas os confrontos diretos entre os times empatados. Os 2 melhores da mini liga avançam para o jogo decisivo.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="fmt-flow">
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon"><Icone Nome="list-ordered" Tamanho="18" /></div>
                <div class="fmt-flow-content">
                    <strong>Todos contra todos</strong>
                    <span>@RodadasA rodadas · pontos corridos</span>
                </div>
            </div>
            <div class="fmt-flow-connector"><Icone Nome="chevron-right" Tamanho="16" /></div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon"><Icone Nome="scale" Tamanho="18" /></div>
                <div class="fmt-flow-content">
                    <strong>Empate no topo?</strong>
                    <span>Mini liga ou jogo decisivo</span>
                </div>
            </div>
            <div class="fmt-flow-connector"><Icone Nome="chevron-right" Tamanho="16" /></div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon"><Icone Nome="trophy" Tamanho="18" /></div>
                <div class="fmt-flow-content">
                    <strong>Campeão da Série A</strong>
                    <span>1° colocado ao final</span>
                </div>
            </div>
        </div>
    </section>

    <hr class="fmt-divider" />

    <!-- SÉRIE B E ACESSO -->
    <section class="fmt-section">
        <div class="fmt-section-header">
            <h3>Série B e acesso</h3>
        </div>

        <div class="fmt-card fmt-card-liga">
            <p class="fmt-desc">
                A <strong>Série B</strong> é a segunda divisão: <strong>@TimesB times</strong> em <strong>pontos corridos</strong>,
                ao longo de <strong>@RodadasB rodadas</strong>.
                O <strong>campeão sobe direto</strong> e o <strong>2° disputa o playoff de acesso</strong>.
            </p>
            <p class="fmt-desc">
                Na Série B o desempate da tabela, que vale também para o título, é
                <strong>Pontos → Vitórias → Saldo de Gols</strong>. Com <strong>2 times</strong> empatados, vale o
                <strong>confronto direto</strong>; se ele também empatar, os dois dividem a posição e, no fim da temporada,
                a vaga sai em <strong>jogo decisivo</strong>. Com <strong>3 ou mais</strong>, eles dividem a posição e,
                no fim, disputam uma <strong>mini liga</strong> (jogos extras entre eles).
            </p>
            <p class="fmt-desc">
                O <strong>playoff de acesso</strong> é um <strong>jogo único</strong> entre o 2° da Série B e o @(TimesA - 1)° da Série A.
                Quem vencer joga a Série A na temporada seguinte. Em caso de empate, a vaga sai nos <strong>pênaltis</strong>.
            </p>
        </div>

        <div class="fmt-flow">
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon"><Icone Nome="medal" Tamanho="18" /></div>
                <div class="fmt-flow-content">
                    <strong>Campeão da Série B</strong>
                    <span>sobe direto</span>
                </div>
            </div>
            <div class="fmt-flow-connector"><Icone Nome="chevron-right" Tamanho="16" /></div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon"><Icone Nome="swords" Tamanho="18" /></div>
                <div class="fmt-flow-content">
                    <strong>Playoff de acesso</strong>
                    <span>2° da B x @(TimesA - 1)° da A · jogo único</span>
                </div>
            </div>
            <div class="fmt-flow-connector"><Icone Nome="chevron-right" Tamanho="16" /></div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon"><Icone Nome="trending-down" Tamanho="18" /></div>
                <div class="fmt-flow-content">
                    <strong>Último da Série A</strong>
                    <span>cai direto</span>
                </div>
            </div>
        </div>
    </section>

    <hr class="fmt-divider" />

    <!-- SUPERCOPA -->
    <section class="fmt-section">
        <div class="fmt-section-header">
            <h3>Supercopa</h3>
        </div>

        <div class="fmt-card fmt-card-liga">
            <p class="fmt-desc">
                <strong>Jogo único</strong> entre o <strong>campeão da Série A</strong> e o <strong>campeão da Copa</strong> da temporada.
                Empatou, vai para os <strong>pênaltis</strong>. Se o mesmo time vencer as duas competições, o
                <strong>vice da Série A</strong> e o <strong>vice da Copa</strong> fazem uma semifinal, e quem vencer
                enfrenta o campeão das duas na final.
            </p>
        </div>
    </section>

    <hr class="fmt-divider" />

    <!-- COPA -->
    <section class="fmt-section">
        <div class="fmt-section-header">
            <h3>Copa</h3>
        </div>

        <div class="fmt-overview-grid fmt-overview-grid-4">
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">4</div>
                <div class="fmt-stat-label">Grupos</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">4-5</div>
                <div class="fmt-stat-label">Times por grupo</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">2</div>
                <div class="fmt-stat-label">Classificados por grupo</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">3</div>
                <div class="fmt-stat-label">Fases finais</div>
            </div>
        </div>

        <div class="fmt-copa-phase">
            <div class="fmt-phase-label">
                <span>Fase de grupos</span>
            </div>

            <p class="fmt-desc">
                Todos os times da temporada entram na Copa, divididos em <strong>4 grupos</strong> por <strong>sorteio em potes</strong>.
                Com <strong>18 times</strong> ficam <strong>2 grupos de 4 (A e B) e 2 de 5 (C e D)</strong>; os times do último pote é que completam os grupos maiores.
                Dentro do grupo, todos se enfrentam uma vez e os <strong>2 melhores avançam</strong>. A fase de grupos tem
                <strong>4 rodadas</strong>, o mesmo tanto de jogos que cada time faz: nos grupos de 5, a última rodada
                junta os jogos que sobrariam e alguns times jogam duas vezes nela; nos grupos de 4, os times folgam numa delas.
            </p>

            <div class="fmt-groups-grid fmt-groups-grid-2">
                @foreach (var (grupo, times) in new[] { ("A", 4), ("B", 4), ("C", 5), ("D", 5) })
                {
                    <div class="fmt-group-card">
                        <div class="fmt-group-header @(times == 4 ? "fmt-group-a" : "fmt-group-b")">
                            Grupo @grupo <small>· @times times</small>
                        </div>
                        <div class="fmt-group-body">
                            <div class="fmt-group-teams">
                                <div class="fmt-group-team"><span class="fmt-team-dot fmt-dot-a"></span>Pote 1</div>
                                <div class="fmt-group-team"><span class="fmt-team-dot fmt-dot-b"></span>Pote 2</div>
                                @for (int i = 0; i < times - 2; i++)
                                {
                                    <div class="fmt-group-team"><span class="fmt-team-dot fmt-dot-b"></span>Pote 3</div>
                                }
                            </div>
                            <div class="fmt-group-desc">
                                Todos contra todos <strong>dentro do grupo</strong> · @(times - 1) jogos
                            </div>
                            <div class="fmt-group-advance">
                                <span class="fmt-advance-badge"><Icone Nome="circle-check" Tamanho="12" /> Top 2 avançam</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="fmt-copa-phase">
            <div class="fmt-phase-label">
                <span>Fases finais</span>
            </div>

            <div class="fmt-knockout-bracket">
                <div class="fmt-knockout-col">
                    @foreach (var (numero, casa, fora) in new[] { (1, "A", "B"), (2, "B", "A"), (3, "C", "D"), (4, "D", "C") })
                    {
                        <div class="fmt-ko-match @(numero % 2 == 1 ? "fmt-ko-match-a" : "fmt-ko-match-b")">
                            <div class="fmt-ko-label">Quartas @numero</div>
                            <div class="fmt-ko-matchup">
                                <div class="fmt-ko-team">
                                    <span class="fmt-ko-seed fmt-seed-a">@(casa)1°</span>
                                    <span class="fmt-ko-name">1º do Grupo @casa</span>
                                </div>
                                <div class="fmt-ko-vs">x</div>
                                <div class="fmt-ko-team">
                                    <span class="fmt-ko-seed fmt-seed-b">@(fora)2°</span>
                                    <span class="fmt-ko-name">2º do Grupo @fora</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="fmt-knockout-arrow"><Icone Nome="chevron-right" Tamanho="18" /></div>

                <div class="fmt-knockout-col">
                    <div class="fmt-ko-match fmt-ko-match-a">
                        <div class="fmt-ko-label">Semifinal 1</div>
                        <div class="fmt-ko-matchup">
                            <div class="fmt-ko-team"><span class="fmt-ko-seed fmt-seed-a">W1</span><span class="fmt-ko-name">Vencedor Quartas 1</span></div>
                            <div class="fmt-ko-vs">x</div>
                            <div class="fmt-ko-team"><span class="fmt-ko-seed fmt-seed-b">W4</span><span class="fmt-ko-name">Vencedor Quartas 4</span></div>
                        </div>
                    </div>
                    <div class="fmt-ko-match fmt-ko-match-b">
                        <div class="fmt-ko-label">Semifinal 2</div>
                        <div class="fmt-ko-matchup">
                            <div class="fmt-ko-team"><span class="fmt-ko-seed fmt-seed-a">W2</span><span class="fmt-ko-name">Vencedor Quartas 2</span></div>
                            <div class="fmt-ko-vs">x</div>
                            <div class="fmt-ko-team"><span class="fmt-ko-seed fmt-seed-b">W3</span><span class="fmt-ko-name">Vencedor Quartas 3</span></div>
                        </div>
                    </div>
                </div>

                <div class="fmt-knockout-arrow"><Icone Nome="chevron-right" Tamanho="18" /></div>

                <div class="fmt-knockout-col fmt-knockout-col-final">
                    <div class="fmt-ko-match fmt-ko-match-final">
                        <div class="fmt-ko-label"><Icone Nome="trophy" Tamanho="12" /> Final</div>
                        <div class="fmt-ko-matchup">
                            <div class="fmt-ko-team">
                                <span class="fmt-ko-seed fmt-seed-a">W-S1</span>
                                <span class="fmt-ko-name">Vencedor Semifinal 1</span>
                            </div>
                            <div class="fmt-ko-vs">x</div>
                            <div class="fmt-ko-team">
                                <span class="fmt-ko-seed fmt-seed-b">W-S2</span>
                                <span class="fmt-ko-name">Vencedor Semifinal 2</span>
                            </div>
                        </div>
                        <div class="fmt-ko-result">
                            <span class="fmt-result-win fmt-result-champion"><Icone Nome="trophy" Tamanho="14" /> Campeão da Copa</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="fmt-flow">
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon"><Icone Nome="list-ordered" Tamanho="18" /></div>
                <div class="fmt-flow-content">
                    <strong>Fase de grupos</strong>
                    <span>4 grupos de 4 e 5 · 4 rodadas</span>
                </div>
            </div>
            <div class="fmt-flow-connector"><Icone Nome="chevron-right" Tamanho="16" /></div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon"><Icone Nome="swords" Tamanho="18" /></div>
                <div class="fmt-flow-content">
                    <strong>Quartas e semifinais</strong>
                    <span>Top 2 de cada grupo</span>
                </div>
            </div>
            <div class="fmt-flow-connector"><Icone Nome="chevron-right" Tamanho="16" /></div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon"><Icone Nome="medal" Tamanho="18" /></div>
                <div class="fmt-flow-content">
                    <strong>Final</strong>
                    <span>Vencedores de cada SF</span>
                </div>
            </div>
            <div class="fmt-flow-connector"><Icone Nome="chevron-right" Tamanho="16" /></div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon"><Icone Nome="trophy" Tamanho="18" /></div>
                <div class="fmt-flow-content">
                    <strong>Campeão da Copa</strong>
                    <span>Vencedor da Final</span>
                </div>
            </div>
        </div>
    </section>

    <hr class="fmt-divider" />

    <!-- CALENDÁRIO -->
    <section class="fmt-section">
        <div class="fmt-section-header">
            <h3>Calendário da temporada</h3>
        </div>

        <div class="fmt-overview-grid fmt-overview-grid-4">
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">@_calendario.Count</div>
                <div class="fmt-stat-label">Datas</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">@_calendario.Count(d => d.Divisao == Divisao.SerieA && d.Rodada is not null)</div>
                <div class="fmt-stat-label">Rodadas da Série A</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">@_calendario.Count(d => d.Divisao == Divisao.SerieB && d.Rodada is not null)</div>
                <div class="fmt-stat-label">Rodadas da Série B</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">@_calendario.Count(d => d.Tipo == TipoCompetition.Copa)</div>
                <div class="fmt-stat-label">Datas da Copa</div>
            </div>
        </div>

        <p class="fmt-desc">
            A temporada abre com a <strong>Supercopa</strong> e fecha com o <strong>playoff de acesso</strong>,
            logo depois da final da Copa. As rodadas de liga vêm sempre em dupla: primeiro a <strong>Série B</strong>,
            logo depois a <strong>Série A</strong> — e as duas séries terminam na mesma data.
            No meio do caminho entra a <strong>janela de transferências</strong>.
        </p>

        <div class="fmt-cal-legend">
            <span class="fmt-cal-legend-item"><span class="fmt-cal-dot fmt-dot-liga"></span>Série A</span>
            <span class="fmt-cal-legend-item"><span class="fmt-cal-dot fmt-dot-special"></span>Série B</span>
            <span class="fmt-cal-legend-item"><span class="fmt-cal-dot fmt-dot-copa"></span>Copa — grupos</span>
            <span class="fmt-cal-legend-item"><span class="fmt-cal-dot fmt-dot-semi"></span>Copa — mata-mata</span>
            <span class="fmt-cal-legend-item"><span class="fmt-cal-dot fmt-dot-mercado"></span>Mercado</span>
            <span class="fmt-cal-legend-item"><span class="fmt-cal-dot fmt-dot-final"></span>Decisões</span>
        </div>

        @if (_temporadaCalendario is { Abertura: null })
        {
            <div class="alert alert-info">O calendário da temporada @_temporadaCalendario.Temporada ainda não foi definido.</div>
        }

        <div class="fmt-cal-grid">
            @foreach (var data in _calendario)
            {
                <div class="fmt-cal-card @Classe(data)">
                    <span class="fmt-cal-num">@data.Numero</span>
                    <span class="fmt-cal-comp">
                        @data.Titulo
                        @if (!string.IsNullOrWhiteSpace(data.Detalhe))
                        {
                            <small>@data.Detalhe</small>
                        }
                        @if (data.Abre is DateTime abre)
                        {
                            <small class="fmt-cal-data">@abre.ToString("ddd dd/MM · HH'h'", Br) abre</small>
                        }
                        <small class="fmt-cal-data">
                            @data.Quando.ToString("ddd dd/MM · HH'h'", Br)@(data.Abre is null ? "" : " fecha")
                        </small>
                    </span>
                </div>
            }
        </div>
    </section>

</div>

<style>
    /* Formato da competição: seções numeradas por título, cartões neutros; a cor fica para o calendário,
       onde cada tipo de data precisa ser reconhecido de longe. */
    .formato-page {
        --fmt-serie-a: #4f8fd6;
        --fmt-serie-b: #3aa88a;
        --fmt-copa: #9a82d6;
        --fmt-mata: #d0708f;
        --fmt-mercado: #e0904a;
        --fmt-decisao: var(--cbfv-acento);
        max-width: 960px;
        padding-bottom: 3rem;
    }

    .fmt-section { margin-bottom: 2rem; }

    .fmt-section-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .fmt-section-header h3 {
        font-size: 1.125rem;
        font-weight: 500;
        margin: 0;
        color: var(--bs-emphasis-color);
    }

    .fmt-divider {
        border-color: var(--bs-border-color);
        margin: 2rem 0;
        opacity: 1;
    }

    .fmt-card {
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: 0.75rem;
        padding: 1.25rem;
        margin-bottom: 1rem;
    }

    .fmt-desc {
        font-size: 0.875rem;
        color: var(--bs-secondary-color);
        margin-bottom: 1rem;
        line-height: 1.6;
    }

    .fmt-desc strong { font-weight: 500; color: var(--bs-body-color); }
    .fmt-card .fmt-desc:last-child { margin-bottom: 0; }

    .fmt-overview-grid { display: grid; gap: 0.75rem; margin-bottom: 1rem; }
    .fmt-overview-grid-3 { grid-template-columns: repeat(3, 1fr); }
    .fmt-overview-grid-4 { grid-template-columns: repeat(4, 1fr); }

    @@media (max-width: 768px) {
        .fmt-overview-grid-3,
        .fmt-overview-grid-4 { grid-template-columns: repeat(2, 1fr); }
    }

    .fmt-stat-card {
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: 0.75rem;
        padding: 1rem;
    }

    .fmt-stat-number {
        font-size: 1.75rem;
        font-weight: 500;
        font-variant-numeric: tabular-nums;
        color: var(--bs-emphasis-color);
        line-height: 1.1;
    }

    .fmt-stat-label {
        font-size: 0.8125rem;
        color: var(--bs-tertiary-color);
        margin-top: 0.25rem;
    }

    .fmt-tiebreak-section { margin-top: 1rem; }

    .fmt-tiebreak-header {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--bs-body-color);
        margin-bottom: 0.625rem;
    }

    .fmt-tiebreak-cards { display: flex; gap: 0.75rem; flex-wrap: wrap; }

    .fmt-tiebreak-card {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        flex: 1;
        min-width: 220px;
        padding: 0.875rem 1rem;
        background: var(--bs-tertiary-bg);
        border-radius: 0.5rem;
    }

    .fmt-tiebreak-badge {
        display: inline-flex;
        align-items: center;
        height: 1.25rem;
        padding: 0 0.375rem;
        border: 1px solid var(--bs-border-color);
        border-radius: 0.375rem;
        font-size: 0.6875rem;
        font-weight: 500;
        white-space: nowrap;
        flex-shrink: 0;
        color: var(--bs-secondary-color);
