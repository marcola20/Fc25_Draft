@page "/formato"
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService

<PageTitle>Formato da Competição — CBFV Retro 2008/09</PageTitle>

<PageHeader Title="Formato da Competição" />

@code {
    protected override void OnInitialized()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/formato"));
    }

    private sealed record DataCalendario(int Numero, string Competicao, string? Detalhe, string Classe);

    /// <summary>
    /// Abre na Supercopa e fecha na final da Copa. As rodadas de liga andam em dupla (Série B e,
    /// em seguida, Série A) e as rodadas de grupo da Copa entram entre elas.
    /// </summary>
    private static readonly IReadOnlyList<DataCalendario> Calendario = MontarCalendario();

    private static List<DataCalendario> MontarCalendario()
    {
        const int rodadasSerieA = 9;
        const int rodadasSerieB = 7;
        const int rodadasGrupoCopa = 4; // cada time joga N-1 jogos; o grupo de 5 junta a sobra na última

        // Blocos de liga: a Série B sempre colada na Série A. Quando uma das séries acaba
        // antes da outra, o que sobra vira bloco de uma data só.
        var blocosDeLiga = new List<List<DataCalendario>>();
        int serieA = 1, serieB = 1;
        while (serieA <= rodadasSerieA || serieB <= rodadasSerieB)
        {
            var bloco = new List<DataCalendario>();
            if (serieB <= rodadasSerieB) bloco.Add(new DataCalendario(0, "Série B", $"Rodada {serieB++}", "fmt-cal-special"));
            if (serieA <= rodadasSerieA) bloco.Add(new DataCalendario(0, "Série A", $"Rodada {serieA++}", "fmt-cal-liga"));
            blocosDeLiga.Add(bloco);
        }

        // Datas da Copa na ordem em que acontecem; a final fica fora porque fecha a temporada.
        var datasDaCopa = new List<DataCalendario>();
        for (int copa = 1; copa <= rodadasGrupoCopa; copa++)
            datasDaCopa.Add(new DataCalendario(0, "Copa", $"Rodada {copa} · grupos", "fmt-cal-copa"));
        datasDaCopa.Add(new DataCalendario(0, "Copa", "Quartas de final", "fmt-cal-semi"));
        datasDaCopa.Add(new DataCalendario(0, "Copa", "Semifinais", "fmt-cal-semi"));

        var totalDeDatas = 1 + blocosDeLiga.Sum(b => b.Count) + datasDaCopa.Count + 1;

        // Em vez de amontoar a Copa no fim, cada data dela tem um lugar-alvo espalhado por igual
        // entre a Supercopa e a final; ela entra no primeiro intervalo entre blocos que alcança o alvo.
        int Alvo(int i) => 1 + (int)Math.Round(
            (double)i * (totalDeDatas - 1) / (datasDaCopa.Count + 1), MidpointRounding.AwayFromZero);

        var datas = new List<DataCalendario>();
        void Add(DataCalendario data) =>
            datas.Add(data with { Numero = datas.Count + 1 });

        Add(new DataCalendario(0, "Supercopa", "abre a temporada", "fmt-cal-final"));

        var proximaDaCopa = 1;
        foreach (var bloco in blocosDeLiga)
        {
            foreach (var data in bloco) Add(data);

            while (proximaDaCopa <= datasDaCopa.Count && datas.Count + 1 >= Alvo(proximaDaCopa))
                Add(datasDaCopa[proximaDaCopa++ - 1]);
        }

        // Sobra quando a liga acaba antes (ex.: poucas rodadas de liga e muitas de Copa).
        while (proximaDaCopa <= datasDaCopa.Count)
            Add(datasDaCopa[proximaDaCopa++ - 1]);

        Add(new DataCalendario(0, "Copa", "Final", "fmt-cal-final"));

        return datas;
    }
}

<div class="formato-page">

    <!-- SÉRIE A -->
    <section class="fmt-section">
        <div class="fmt-section-header">
            <span class="fmt-section-icon">🏆</span>
            <h3>Série A</h3>
        </div>

        <div class="fmt-overview-grid fmt-overview-grid-3">
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">10</div>
                <div class="fmt-stat-label">Times</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">9</div>
                <div class="fmt-stat-label">Rodadas</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">1°</div>
                <div class="fmt-stat-label">É Campeão</div>
            </div>
        </div>

        <div class="fmt-card fmt-card-liga">
            <p class="fmt-desc">
                Todos os <strong>10 times</strong> se enfrentam em <strong>pontos corridos</strong> ao longo de <strong>9 rodadas</strong>.
                O primeiro colocado ao final é o <strong>campeão da Série A</strong>. O <strong>último cai</strong> para a Série B e o
                <strong>9° disputa o playoff</strong> contra o 2° da Série B.
            </p>
            <p class="fmt-desc">
                ⚠️ <strong>Nesta temporada de transição</strong>, com 12 times, <strong>caem 2 direto</strong> e não há playoff:
                a Série A do ano que vem começa com 10.
            </p>

            <div class="fmt-tiebreak-section">
                <div class="fmt-tiebreak-header">
                    <span class="fmt-tiebreak-icon">⚖️</span>
                    <span>Critérios de Desempate</span>
                </div>
                <div class="fmt-tiebreak-cards">
                    <div class="fmt-tiebreak-card">
                        <div class="fmt-tiebreak-badge fmt-badge-blue">2 times</div>
                        <div class="fmt-tiebreak-content">
                            <strong>Jogo Decisivo</strong>
                            <span>Os dois times empatados disputam um jogo único para definir o campeão.</span>
                        </div>
                    </div>
                    <div class="fmt-tiebreak-card">
                        <div class="fmt-tiebreak-badge fmt-badge-purple">3+ times</div>
                        <div class="fmt-tiebreak-content">
                            <strong>Mini Liga</strong>
                            <span>Contabiliza apenas os confrontos diretos entre os times empatados. Os 2 melhores da mini liga avançam para o jogo decisivo.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="fmt-flow">
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon">📋</div>
                <div class="fmt-flow-content">
                    <strong>Todos contra Todos</strong>
                    <span>9 rodadas · pontos corridos</span>
                </div>
            </div>
            <div class="fmt-flow-connector">→</div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon">⚖️</div>
                <div class="fmt-flow-content">
                    <strong>Empate no topo?</strong>
                    <span>Mini liga ou jogo decisivo</span>
                </div>
            </div>
            <div class="fmt-flow-connector">→</div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon">🏆</div>
                <div class="fmt-flow-content">
                    <strong>Campeão da Série A</strong>
                    <span>1° colocado ao final</span>
                </div>
            </div>
        </div>
    </section>

    <hr class="fmt-divider" />

    <!-- SÉRIE B E ACESSO -->
    <section class="fmt-section">
        <div class="fmt-section-header">
            <span class="fmt-section-icon">🥈</span>
            <h3>Série B e Acesso</h3>
        </div>

        <div class="fmt-card fmt-card-liga">
            <p class="fmt-desc">
                A <strong>Série B</strong> é a segunda divisão, disputada em <strong>pontos corridos</strong> com o mesmo regulamento da Série A.
                O <strong>campeão sobe direto</strong> e o <strong>2° disputa o playoff de acesso</strong>.
            </p>
            <p class="fmt-desc">
                O <strong>playoff de acesso</strong> é um <strong>jogo único</strong> entre o 2° da Série B e o 9° da Série A.
                Quem vencer joga a Série A na temporada seguinte. Em caso de empate, a vaga sai nos <strong>pênaltis</strong>.
            </p>
        </div>

        <div class="fmt-flow">
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon">🥇</div>
                <div class="fmt-flow-content">
                    <strong>Campeão da Série B</strong>
                    <span>sobe direto</span>
                </div>
            </div>
            <div class="fmt-flow-connector">→</div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon">⚔️</div>
                <div class="fmt-flow-content">
                    <strong>Playoff de acesso</strong>
                    <span>2° da B x 9° da A · jogo único</span>
                </div>
            </div>
            <div class="fmt-flow-connector">→</div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon">⬇️</div>
                <div class="fmt-flow-content">
                    <strong>Último da Série A</strong>
                    <span>cai direto</span>
                </div>
            </div>
        </div>
    </section>

    <hr class="fmt-divider" />

    <!-- SUPERCOPA -->
    <section class="fmt-section">
        <div class="fmt-section-header">
            <span class="fmt-section-icon">🌟</span>
            <h3>Supercopa</h3>
        </div>

        <div class="fmt-card fmt-card-liga">
            <p class="fmt-desc">
                <strong>Jogo único</strong> entre o <strong>campeão da Série A</strong> e o <strong>campeão da Copa</strong> da temporada.
                Empatou, vai para os <strong>pênaltis</strong>. Se o mesmo time vencer as duas competições, não há Supercopa.
            </p>
        </div>
    </section>

    <hr class="fmt-divider" />

    <!-- COPA -->
    <section class="fmt-section">
        <div class="fmt-section-header">
            <span class="fmt-section-icon">🥇</span>
            <h3>Copa</h3>
        </div>

        <div class="fmt-overview-grid fmt-overview-grid-4">
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">4</div>
                <div class="fmt-stat-label">Grupos</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">4-5</div>
                <div class="fmt-stat-label">Times por Grupo</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">2</div>
                <div class="fmt-stat-label">Classificados por Grupo</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">3</div>
                <div class="fmt-stat-label">Fases Finais</div>
            </div>
        </div>

        <div class="fmt-copa-phase">
            <div class="fmt-phase-label">
                <span class="fmt-phase-icon">📋</span>
                <span>Fase de Grupos</span>
            </div>

            <p class="fmt-desc">
                Todos os times da temporada entram na Copa, divididos em <strong>4 grupos</strong> por <strong>sorteio em potes</strong>.
                Com <strong>18 times</strong> ficam <strong>2 grupos de 4 (A e B) e 2 de 5 (C e D)</strong>; os times do último pote é que completam os grupos maiores.
                Dentro do grupo, todos se enfrentam uma vez e os <strong>2 melhores avançam</strong>. A fase de grupos tem
                <strong>4 rodadas</strong>, o mesmo tanto de jogos que cada time faz: nos grupos de 5, a última rodada
                junta os jogos que sobrariam e alguns times jogam duas vezes nela; nos grupos de 4, os times folgam numa delas.
            </p>

            <div class="fmt-groups-grid fmt-groups-grid-2">
                @foreach (var (grupo, times) in new[] { ("A", 4), ("B", 4), ("C", 5), ("D", 5) })
                {
                    <div class="fmt-group-card">
                        <div class="fmt-group-header @(times == 4 ? "fmt-group-a" : "fmt-group-b")">
                            Grupo @grupo <small>· @times times</small>
                        </div>
                        <div class="fmt-group-body">
                            <div class="fmt-group-teams">
                                <div class="fmt-group-team"><span class="fmt-team-dot fmt-dot-a"></span>Pote 1</div>
                                <div class="fmt-group-team"><span class="fmt-team-dot fmt-dot-b"></span>Pote 2</div>
                                @for (int i = 0; i < times - 2; i++)
                                {
                                    <div class="fmt-group-team"><span class="fmt-team-dot fmt-dot-b"></span>Pote 3</div>
                                }
                            </div>
                            <div class="fmt-group-desc">
                                Todos contra todos <strong>dentro do grupo</strong> · @(times - 1) jogos
                            </div>
                            <div class="fmt-group-advance">
                                <span class="fmt-advance-badge">✅ Top 2 avançam</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="fmt-copa-phase">
            <div class="fmt-phase-label">
                <span class="fmt-phase-icon">⚔️</span>
                <span>Fases Finais</span>
            </div>

            <div class="fmt-knockout-bracket">
                <div class="fmt-knockout-col">
                    @foreach (var (numero, casa, fora) in new[] { (1, "A", "B"), (2, "B", "A"), (3, "C", "D"), (4, "D", "C") })
                    {
                        <div class="fmt-ko-match @(numero % 2 == 1 ? "fmt-ko-match-a" : "fmt-ko-match-b")">
                            <div class="fmt-ko-label">Quartas @numero</div>
                            <div class="fmt-ko-matchup">
                                <div class="fmt-ko-team">
                                    <span class="fmt-ko-seed fmt-seed-a">@(casa)1°</span>
                                    <span class="fmt-ko-name">1º do Grupo @casa</span>
                                </div>
                                <div class="fmt-ko-vs">VS</div>
                                <div class="fmt-ko-team">
                                    <span class="fmt-ko-seed fmt-seed-b">@(fora)2°</span>
                                    <span class="fmt-ko-name">2º do Grupo @fora</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="fmt-knockout-arrow">→</div>

                <div class="fmt-knockout-col">
                    <div class="fmt-ko-match fmt-ko-match-a">
                        <div class="fmt-ko-label">Semifinal 1</div>
                        <div class="fmt-ko-matchup">
                            <div class="fmt-ko-team"><span class="fmt-ko-seed fmt-seed-a">W1</span><span class="fmt-ko-name">Vencedor Quartas 1</span></div>
                            <div class="fmt-ko-vs">VS</div>
                            <div class="fmt-ko-team"><span class="fmt-ko-seed fmt-seed-b">W4</span><span class="fmt-ko-name">Vencedor Quartas 4</span></div>
                        </div>
                    </div>
                    <div class="fmt-ko-match fmt-ko-match-b">
                        <div class="fmt-ko-label">Semifinal 2</div>
                        <div class="fmt-ko-matchup">
                            <div class="fmt-ko-team"><span class="fmt-ko-seed fmt-seed-a">W2</span><span class="fmt-ko-name">Vencedor Quartas 2</span></div>
                            <div class="fmt-ko-vs">VS</div>
                            <div class="fmt-ko-team"><span class="fmt-ko-seed fmt-seed-b">W3</span><span class="fmt-ko-name">Vencedor Quartas 3</span></div>
                        </div>
                    </div>
                </div>

                <div class="fmt-knockout-arrow">→</div>

                <div class="fmt-knockout-col fmt-knockout-col-final">
                    <div class="fmt-ko-match fmt-ko-match-final">
                        <div class="fmt-ko-label">🏆 Final</div>
                        <div class="fmt-ko-matchup">
                            <div class="fmt-ko-team">
                                <span class="fmt-ko-seed fmt-seed-a">W-S1</span>
                                <span class="fmt-ko-name">Vencedor Semifinal 1</span>
                            </div>
                            <div class="fmt-ko-vs">VS</div>
                            <div class="fmt-ko-team">
                                <span class="fmt-ko-seed fmt-seed-b">W-S2</span>
                                <span class="fmt-ko-name">Vencedor Semifinal 2</span>
                            </div>
                        </div>
                        <div class="fmt-ko-result">
                            <span class="fmt-result-win fmt-result-champion">🏆 Campeão da Copa</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="fmt-flow">
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon">📋</div>
                <div class="fmt-flow-content">
                    <strong>Fase de Grupos</strong>
                    <span>4 grupos de 4 · 3 rodadas dentro do grupo</span>
                </div>
            </div>
            <div class="fmt-flow-connector">→</div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon">⚔️</div>
                <div class="fmt-flow-content">
                    <strong>Semifinais</strong>
                    <span>Top 2 de cada grupo</span>
                </div>
            </div>
            <div class="fmt-flow-connector">→</div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon">🥇</div>
                <div class="fmt-flow-content">
                    <strong>Final</strong>
                    <span>Vencedores de cada SF</span>
                </div>
            </div>
            <div class="fmt-flow-connector">→</div>
            <div class="fmt-flow-step">
                <div class="fmt-flow-icon">🏆</div>
                <div class="fmt-flow-content">
                    <strong>Campeão da Copa</strong>
                    <span>Vencedor da Final</span>
                </div>
            </div>
        </div>
    </section>

    <hr class="fmt-divider" />

    <!-- CALENDÁRIO -->
    <section class="fmt-section">
        <div class="fmt-section-header">
            <span class="fmt-section-icon">📅</span>
            <h3>Calendário da Temporada</h3>
        </div>

        <div class="fmt-overview-grid fmt-overview-grid-4">
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">@Calendario.Count</div>
                <div class="fmt-stat-label">Datas</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">9</div>
                <div class="fmt-stat-label">Rodadas da Série A</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">7</div>
                <div class="fmt-stat-label">Rodadas da Série B</div>
            </div>
            <div class="fmt-stat-card">
                <div class="fmt-stat-number">8</div>
                <div class="fmt-stat-label">Datas da Copa</div>
            </div>
        </div>

        <p class="fmt-desc">
            A temporada abre com a <strong>Supercopa</strong> e fecha com a <strong>final da Copa</strong>.
            As rodadas de liga vêm sempre em dupla: primeiro a <strong>Série B</strong>, logo depois a <strong>Série A</strong>.
        </p>

        <div class="fmt-cal-legend">
            <span class="fmt-cal-legend-item"><span class="fmt-cal-dot fmt-dot-liga"></span>Série A</span>
            <span class="fmt-cal-legend-item"><span class="fmt-cal-dot fmt-dot-special"></span>Série B</span>
            <span class="fmt-cal-legend-item"><span class="fmt-cal-dot fmt-dot-copa"></span>Copa — grupos</span>
            <span class="fmt-cal-legend-item"><span class="fmt-cal-dot fmt-dot-semi"></span>Copa — mata-mata</span>
            <span class="fmt-cal-legend-item"><span class="fmt-cal-dot fmt-dot-final"></span>Decisões</span>
        </div>

        <div class="fmt-cal-grid">
            @foreach (var data in Calendario)
            {
                <div class="fmt-cal-card @data.Classe">
                    <span class="fmt-cal-num">@data.Numero</span>
                    <span class="fmt-cal-comp">
                        @data.Competicao
                        @if (data.Detalhe is not null)
                        {
                            <small>@data.Detalhe</small>
                        }
                    </span>
                </div>
            }
        </div>
    </section>

</div>

<style>
    .formato-page {
        max-width: 960px;
        margin: 0 auto;
        padding-bottom: 3rem;
    }

    .fmt-section { margin-bottom: 2rem; }

    .fmt-section-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1.1rem;
    }

    .fmt-section-icon { font-size: 1.4rem; line-height: 1; }

    .fmt-section-header h3 {
        font-size: 1.3rem;
        font-weight: 700;
        margin: 0;
        color: var(--bs-emphasis-color, #212529);
        letter-spacing: -0.01em;
    }

    .fmt-divider {
        border-color: var(--bs-border-color, #dee2e6);
        margin: 2rem 0;
        opacity: 0.4;
    }

    .fmt-card {
        background: var(--bs-body-bg, #fff);
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.5rem;
        padding: 1.1rem 1.25rem;
        margin-bottom: 1rem;
    }

    .fmt-card-liga { border-left: 4px solid var(--bs-primary, #0d6efd); }

    .fmt-desc {
        font-size: 0.92rem;
        color: var(--bs-secondary-color, #6c757d);
        margin-bottom: 1rem;
        line-height: 1.6;
    }

    .fmt-overview-grid { display: grid; gap: 1rem; margin-bottom: 1rem; }
    .fmt-overview-grid-3 { grid-template-columns: repeat(3, 1fr); }
    .fmt-overview-grid-4 { grid-template-columns: repeat(4, 1fr); }

    @@media (max-width: 768px) {
        .fmt-overview-grid-3,
        .fmt-overview-grid-4 { grid-template-columns: repeat(2, 1fr); }
    }

    .fmt-stat-card {
        background: var(--bs-body-bg, #fff);
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.6rem;
        padding: 1.25rem 1rem;
        text-align: center;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }

    .fmt-stat-number {
        font-size: 2.25rem;
        font-weight: 800;
        color: var(--bs-primary, #0d6efd);
        line-height: 1.1;
    }

    .fmt-stat-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--bs-secondary-color, #6c757d);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-top: 0.3rem;
    }

    .fmt-tiebreak-section { margin-top: 0.5rem; }

    .fmt-tiebreak-header {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--bs-secondary-color, #6c757d);
        margin-bottom: 0.75rem;
    }

    .fmt-tiebreak-icon { font-size: 1rem; }

    .fmt-tiebreak-cards { display: flex; gap: 0.75rem; flex-wrap: wrap; }

    .fmt-tiebreak-card {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        flex: 1;
        min-width: 220px;
        padding: 0.85rem 1rem;
        background: var(--bs-secondary-bg, #f8f9fa);
        border-radius: 0.5rem;
        border: 1px solid var(--bs-border-color, #dee2e6);
    }

    .fmt-tiebreak-badge {
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 700;
        white-space: nowrap;
        flex-shrink: 0;
        margin-top: 0.1rem;
    }

    .fmt-badge-blue   { background: rgba(13,110,253,0.12); color: var(--bs-primary, #0d6efd); }
    .fmt-badge-purple { background: rgba(124,58,237,0.12); color: #7c3aed; }

