</div>


@code {
    private bool _carregando = true;
    private IReadOnlyList<PremiacaoDto> _premiacoes = Array.Empty<PremiacaoDto>();
    private PremiacaoDto? _premiacao;

    protected override void OnInitialized()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/premiacao"));
    }

    protected override async Task OnInitializedAsync()
    {
        // Cada temporada tem a sua tabela: a página abre na mais recente e dá para ver as antigas.
        _premiacoes = await PremiacaoSvc.ListAsync(CancellationToken.None);
        _premiacao = _premiacoes.FirstOrDefault();
        _carregando = false;
    }

    private void OnPremiacaoChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
            _premiacao = _premiacoes.FirstOrDefault(p => p.PremiacaoId == id);
    }

    private string TituloDaLiga(Divisao divisao) =>
        Posicoes(Divisao.SerieB).Count > 0 ? LigaLabels.DivisaoNome(divisao) : "Liga";

    private sealed record LinhaPosicao(string Rotulo, string Valor, string RowClass, string BadgeClass, string BarClass, int BarWidth);

    /// <summary>Prêmios por posição, do pior colocado para o campeão (como a tabela sempre foi mostrada).</summary>
    private IReadOnlyList<LinhaPosicao> Posicoes(Divisao divisao)
    {
        var itens = _premiacao?.Da(TipoCompetition.Liga, divisao) ?? Array.Empty<PremiacaoItemDto>();
        if (itens.Count == 0) return Array.Empty<LinhaPosicao>();

        var maior = itens.Max(i => i.Valor);
        var ultima = itens.Max(i => i.PosicaoAte ?? i.PosicaoDe ?? 0);

        return itens
            .OrderByDescending(i => i.PosicaoDe ?? 0)
            .Select(i =>
            {
                var posicao = i.PosicaoDe ?? 0;
                var cor = Cor(posicao, ultima);
                var sufixo = "";
                var rotulo = i.PosicaoAte is int ate && ate != posicao ? $"{posicao}º-{ate}º" : $"{posicao}º{sufixo}";

                return new LinhaPosicao(
                    rotulo,
                    Moeda(i.Valor),
                    $"prem-row-{cor}",
                    posicao == 1 ? "prem-badge-gold" : "",
                    $"prem-bar-{cor}",
                    maior <= 0 ? 0 : (int)Math.Round(i.Valor / maior * 100m));
            })
            .ToArray();
    }

    /// <summary>Seis faixas de cor, do topo da tabela (ouro) para a lanterna (vermelho).</summary>
    private static string Cor(int posicao, int totalPosicoes)
    {
        if (totalPosicoes < 1) return "gold";

        var faixa = Math.Min(5, (posicao - 1) * 6 / totalPosicoes);

        return faixa switch
        {
            0 => "gold",
            1 => "green",
            2 => "blue",
            3 => "yellow",
            4 => "orange",
            _ => "red"
        };
    }

    private sealed record PassoFase(string Rotulo, string Valor, string Icone, string StepClass, string PrizeClass, string? Times);

    private IReadOnlyList<PassoFase> Fases(TipoCompetition tipo)
    {
        var itens = _premiacao?.Da(tipo, null) ?? Array.Empty<PremiacaoItemDto>();

        return itens
            .OrderBy(i => i.Fase ?? 0)
            .Select(i =>
            {
                var fase = i.Fase ?? FasePremiacao.Campeao;
                return new PassoFase(
                    fase == FasePremiacao.Campeao ? $"Campeão d{(tipo == TipoCompetition.Copa ? "a Copa" : "a Supercopa")}" : PremiacaoLabels.Fase(fase),
                    Moeda(i.Valor),
                    Icone(fase),
                    fase switch
                    {
                        FasePremiacao.Campeao => "prem-step-champ",
                        FasePremiacao.Vice => "prem-step-vice",
                        FasePremiacao.FaseDeGrupos => "prem-step-grupos",
                        _ => "prem-step-semi"
                    },
                    fase == FasePremiacao.Campeao ? "prem-prize-gold" : "",
                    QuantosTimes(fase));
            })
            .ToArray();
    }

    private static string Icone(FasePremiacao fase) => fase switch
    {
        FasePremiacao.Campeao => "trophy",
        FasePremiacao.Vice => "medal",
        FasePremiacao.Semifinal => "swords",
        FasePremiacao.Quartas => "flag",
        _ => "list"
    };

    private static string? QuantosTimes(FasePremiacao fase) => fase switch
    {
        FasePremiacao.Campeao or FasePremiacao.Vice => "1 time",
        FasePremiacao.Semifinal => "2 times",
        FasePremiacao.Quartas => "4 times",
        _ => null
    };

    private static string Moeda(decimal valor) => $"{valor / 1_000_000m:0.##} Mi";
}
@* Estilo global da página. O valor do prêmio é uma série só: barras numa cor neutra; o dourado fica com o
   campeão (posição, degrau da Copa e valor). Medalhas 1, 2 e 3 em ouro, prata e bronze chapados. *@
<style>
    .prem-page {
        max-width: 860px;
        margin: 0 auto;
        padding-bottom: 3rem;
    }

    .prem-divider { margin: 2.5rem 0; border-color: var(--bs-border-color); opacity: 1; }
    .prem-section { margin-bottom: 0.5rem; }

    .prem-section-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .prem-section-icon { color: var(--bs-tertiary-color); }

    .prem-section-header h3 {
        margin: 0;
        font-size: 1.125rem;
        font-weight: 500;
        color: var(--bs-emphasis-color);
    }

    .prem-section-desc {
        max-width: 46rem;
        margin-bottom: 1rem;
        font-size: 0.875rem;
        line-height: 1.6;
        color: var(--bs-secondary-color);
    }

    .prem-section-desc a { color: var(--bs-emphasis-color); font-weight: 500; }

    .prem-league-grid {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid var(--bs-border-color);
        border-radius: 0.75rem;
        background: var(--bs-body-bg);
    }

    .prem-prize-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 1rem;
    }

    .prem-prize-row + .prem-prize-row { border-top: 1px solid var(--bs-border-color); }

    .prem-prize-pos { flex-shrink: 0; min-width: 4.5rem; }

    .prem-pos-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 2.25rem;
        height: 1.5rem;
        padding: 0 0.375rem;
        border-radius: 0.375rem;
        background: var(--bs-secondary-bg);
        color: var(--bs-secondary-color);
        font-size: 0.75rem;
        font-weight: 500;
        font-variant-numeric: tabular-nums;
    }

    .prem-badge-gold { background: var(--cbfv-acento); color: #1a1405; }

    .prem-prize-bar-wrap {
        flex: 1;
        height: 4px;
        overflow: hidden;
        border-radius: 2px;
        background: var(--bs-secondary-bg);
    }

    .prem-prize-bar { height: 100%; border-radius: 2px; background: var(--bs-tertiary-color); }

    .prem-prize-value {
        flex-shrink: 0;
        min-width: 3.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        font-variant-numeric: tabular-nums;
        color: var(--bs-emphasis-color);
        text-align: right;
    }

    .prem-copa-ladder {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid var(--bs-border-color);
        border-radius: 0.75rem;
        background: var(--bs-body-bg);
    }

    .prem-copa-step {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid var(--bs-border-color);
    }

    .prem-copa-step:last-child { border-bottom: none; }

    .prem-step-champ { box-shadow: inset 3px 0 0 var(--cbfv-acento); }

    .prem-step-icon  { display: inline-flex; flex-shrink: 0; justify-content: center; width: 2rem; color: var(--bs-tertiary-color); }
    .prem-step-champ .prem-step-icon { color: var(--cbfv-acento-texto); }
    .prem-step-info  { flex: 1; }
    .prem-step-stage { font-size: 0.9375rem; font-weight: 500; color: var(--bs-emphasis-color); }
    .prem-step-teams { margin-top: 0.125rem; font-size: 0.75rem; color: var(--bs-tertiary-color); }
    .prem-step-prize { flex-shrink: 0; font-size: 1.125rem; font-weight: 500; font-variant-numeric: tabular-nums; color: var(--bs-emphasis-color); }
    .prem-prize-gold { color: var(--cbfv-acento-texto); }

    .prem-stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin-bottom: 0.75rem;
        overflow: hidden;
        border: 1px solid var(--bs-border-color);
        border-radius: 0.75rem;
        background: var(--bs-body-bg);
    }

    @@media (max-width: 640px) {
        .prem-stats-grid { grid-template-columns: 1fr; }
    }

    .prem-stat-card {
        padding: 1rem 1.25rem;
        border-right: 1px solid var(--bs-border-color);
    }

    .prem-stat-card:last-child { border-right: none; }

    .prem-stat-title {
        margin-bottom: 0.75rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--bs-body-color);
    }

    .prem-stat-rows { display: flex; flex-direction: column; gap: 0.5rem; }

    .prem-stat-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
    }

    .prem-medal {
        display: inline-flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        width: 1.25rem;
        height: 1.25rem;
        border-radius: 50%;
        font-size: 0.6875rem;
        font-weight: 600;
    }

    .prem-medal.ouro   { background: var(--cbfv-acento); color: #1a1405; }
    .prem-medal.prata  { background: #c7ccd1; color: #16181b; }
    .prem-medal.bronze { background: #c08457; color: #fff; }

    .prem-stat-money { flex: 1; font-weight: 500; font-variant-numeric: tabular-nums; }

    .prem-over-badge {
        padding: 0.125rem 0.375rem;
        border: 1px solid var(--bs-border-color);
        border-radius: 0.375rem;
        font-size: 0.6875rem;
        font-weight: 500;
        color: var(--bs-secondary-color);
        white-space: nowrap;
    }

