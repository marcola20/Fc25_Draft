                    <div class="prem-stat-row">
                        <span class="prem-medal">🥈</span>
                        <span class="prem-stat-money">6 Mi</span>
                        <span class="prem-over-badge">+1 over</span>
                    </div>
                    <div class="prem-stat-row">
                        <span class="prem-medal">🥉</span>
                        <span class="prem-stat-money">4 Mi</span>
                        <span class="prem-over-badge">+1 over</span>
                    </div>
                </div>
            </div>

            <div class="prem-stat-card">
                <div class="prem-stat-title">🅰️ Assistências</div>
                <div class="prem-stat-rows">
                    <div class="prem-stat-row">
                        <span class="prem-medal">🥇</span>
                        <span class="prem-stat-money">6 Mi</span>
                        <span class="prem-over-badge">+1 over</span>
                    </div>
                    <div class="prem-stat-row">
                        <span class="prem-medal">🥈</span>
                        <span class="prem-stat-money">4 Mi</span>
                        <span class="prem-over-badge">+1 over</span>
                    </div>
                    <div class="prem-stat-row">
                        <span class="prem-medal">🥉</span>
                        <span class="prem-stat-money">2 Mi</span>
                        <span class="prem-over-badge">+1 over</span>
                    </div>
                </div>
            </div>

            <div class="prem-stat-card">
                <div class="prem-stat-title">🧤 Clean Sheets</div>
                <div class="prem-stat-rows">
                    <div class="prem-stat-row">
                        <span class="prem-medal">🥇</span>
                        <span class="prem-stat-money">6 Mi</span>
                        <span class="prem-over-badge">+1 over</span>
                    </div>
                    <div class="prem-stat-row">
                        <span class="prem-medal">🥈</span>
                        <span class="prem-stat-money">4 Mi</span>
                        <span class="prem-over-badge">+1 over</span>
                    </div>
                    <div class="prem-stat-row">
                        <span class="prem-medal">🥉</span>
