@page "/premiacao"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Interfaces
@using Fc25Draft.Core.Utilities
@inject IPremiacaoService PremiacaoSvc
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService

<PageTitle>Premiação</PageTitle>

<PageHeader Title="Premiação" />

<div class="prem-page">

    @if (_carregando)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    }
    else
    {
        @if (_premiacoes.Count > 1)
        {
            <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
                <select class="form-select form-select-sm w-auto" @onchange="OnPremiacaoChanged">
                    @foreach (var p in _premiacoes)
                    {
                        <option value="@p.PremiacaoId" selected="@(p.PremiacaoId == _premiacao?.PremiacaoId)">@p.Nome</option>
                    }
                </select>
                @if (_premiacao is not null && _premiacao.PremiacaoId != _premiacoes[0].PremiacaoId)
                {
                    <span class="badge bg-secondary">Temporada anterior</span>
                }
            </div>
        }

        @if (_premiacao is null)
        {
            <div class="alert alert-info">A premiação desta temporada ainda não foi cadastrada.</div>
        }
        else
        {
            <!-- SÉRIE A -->
            @if (Posicoes(Divisao.SerieA).Count > 0)
            {
                <section class="prem-section">
                    <div class="prem-section-header">
                        <span class="prem-section-icon">🏆</span>
                        <h3>@TituloDaLiga(Divisao.SerieA) — Prêmio por Classificação</h3>
                    </div>
                    <p class="prem-section-desc">
                        Quanto <strong>pior a posição</strong>, maior o prêmio — mecanismo de equilíbrio para a próxima temporada.
                        O campeão leva o título; quem escapou por pouco leva mais grana para reconstruir.
                    </p>

                    <div class="prem-league-grid">
                        @foreach (var linha in Posicoes(Divisao.SerieA))
                        {
                            <div class="prem-prize-row @linha.RowClass">
                                <div class="prem-prize-pos">
                                    <span class="prem-pos-badge @linha.BadgeClass">@linha.Rotulo</span>
                                </div>
                                <div class="prem-prize-bar-wrap">
                                    <div class="prem-prize-bar @linha.BarClass" style="width: @(linha.BarWidth)%"></div>
                                </div>
                                <div class="prem-prize-value">@linha.Valor</div>
                            </div>
                        }
                    </div>
                </section>
            }

            <!-- SÉRIE B -->
            @if (Posicoes(Divisao.SerieB).Count > 0)
            {
                <hr class="prem-divider" />

                <section class="prem-section">
                    <div class="prem-section-header">
                        <span class="prem-section-icon">🥈</span>
                        <h3>Série B</h3>
                    </div>
                    <p class="prem-section-desc">
                        ⬆ O <strong>campeão sobe direto</strong> para a Série A. O <strong>2° disputa o playoff de acesso</strong>,
                        em jogo único contra quem ficou logo acima da zona de rebaixamento da Série A.
                    </p>

                    <div class="prem-league-grid">
                        @foreach (var linha in Posicoes(Divisao.SerieB))
                        {
                            <div class="prem-prize-row @linha.RowClass">
                                <div class="prem-prize-pos">
                                    <span class="prem-pos-badge @linha.BadgeClass">@linha.Rotulo</span>
                                </div>
                                <div class="prem-prize-bar-wrap">
                                    <div class="prem-prize-bar @linha.BarClass" style="width: @(linha.BarWidth)%"></div>
                                </div>
                                <div class="prem-prize-value">@linha.Valor</div>
                            </div>
                        }
                    </div>
                </section>
            }

            <!-- COPA -->
            @if (Fases(TipoCompetition.Copa).Count > 0)
            {
                <hr class="prem-divider" />

                <section class="prem-section">
                    <div class="prem-section-header">
                        <span class="prem-section-icon">🥇</span>
                        <h3>Copa — Prêmio por Fase</h3>
                    </div>
                    <p class="prem-section-desc">Quanto mais longe chegar, maior o prêmio. O campeão leva o maior bônus.</p>

                    <div class="prem-copa-ladder">
                        @foreach (var passo in Fases(TipoCompetition.Copa))
                        {
                            <div class="prem-copa-step @passo.StepClass">
                                <div class="prem-step-icon">@passo.Icone</div>
                                <div class="prem-step-info">
                                    <div class="prem-step-stage">@passo.Rotulo</div>
                                    @if (passo.Times is not null)
                                    {
                                        <div class="prem-step-teams">@passo.Times</div>
                                    }
                                </div>
                                <div class="prem-step-prize @passo.PrizeClass">@passo.Valor</div>
                            </div>
                        }
                    </div>
                </section>
            }

            <!-- SUPERCOPA -->
            @if (Fases(TipoCompetition.Supercopa).Count > 0)
            {
                <hr class="prem-divider" />

                <section class="prem-section">
                    <div class="prem-section-header">
                        <span class="prem-section-icon">🌟</span>
                        <h3>Supercopa</h3>
                    </div>
                    <p class="prem-section-desc">Jogo único entre o campeão da Série A e o campeão da Copa.</p>

                    <div class="prem-copa-ladder">
                        @foreach (var passo in Fases(TipoCompetition.Supercopa))
                        {
                            <div class="prem-copa-step @passo.StepClass">
                                <div class="prem-step-icon">@passo.Icone</div>
                                <div class="prem-step-info">
                                    <div class="prem-step-stage">@passo.Rotulo</div>
                                </div>
                                <div class="prem-step-prize @passo.PrizeClass">@passo.Valor</div>
                            </div>
                        }
                    </div>
                </section>
            }
        }
    }

    <hr class="prem-divider" />

    <section class="prem-section">
        <div class="prem-section-header">
            <span class="prem-section-icon">📊</span>
            <h3>Premiações Individuais de Estatística</h3>
        </div>
        <p class="prem-section-desc">Top 3 de cada categoria recebem prêmio em dinheiro e +1 over.</p>

        <div class="prem-stats-grid">

            <div class="prem-stat-card">
                <div class="prem-stat-title">⚽ Artilharia</div>
