</div>


@code {
    private bool _carregando = true;
    private IReadOnlyList<PremiacaoDto> _premiacoes = Array.Empty<PremiacaoDto>();
    private PremiacaoDto? _premiacao;

    protected override void OnInitialized()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/premiacao"));
    }

    protected override async Task OnInitializedAsync()
    {
        // Cada temporada tem a sua tabela: a página abre na mais recente e dá para ver as antigas.
        _premiacoes = await PremiacaoSvc.ListAsync(CancellationToken.None);
        _premiacao = _premiacoes.FirstOrDefault();
        _carregando = false;
    }

    private void OnPremiacaoChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
            _premiacao = _premiacoes.FirstOrDefault(p => p.PremiacaoId == id);
    }

    private string TituloDaLiga(Divisao divisao) =>
        Posicoes(Divisao.SerieB).Count > 0 ? LigaLabels.DivisaoNome(divisao) : "Liga";

    private sealed record LinhaPosicao(string Rotulo, string Valor, string RowClass, string BadgeClass, string BarClass, int BarWidth);

    /// <summary>Prêmios por posição, do pior colocado para o campeão (como a tabela sempre foi mostrada).</summary>
    private IReadOnlyList<LinhaPosicao> Posicoes(Divisao divisao)
    {
        var itens = _premiacao?.Da(TipoCompetition.Liga, divisao) ?? Array.Empty<PremiacaoItemDto>();
        if (itens.Count == 0) return Array.Empty<LinhaPosicao>();

        var maior = itens.Max(i => i.Valor);
        var ultima = itens.Max(i => i.PosicaoAte ?? i.PosicaoDe ?? 0);

        return itens
            .OrderByDescending(i => i.PosicaoDe ?? 0)
            .Select(i =>
            {
                var posicao = i.PosicaoDe ?? 0;
                var cor = Cor(posicao, ultima);
                var sufixo = posicao == 1 ? " 🏆" : posicao == ultima && divisao == Divisao.SerieA ? " ⬇" : "";
                var rotulo = i.PosicaoAte is int ate && ate != posicao ? $"{posicao}º-{ate}º" : $"{posicao}º{sufixo}";

                return new LinhaPosicao(
                    rotulo,
                    Moeda(i.Valor),
                    $"prem-row-{cor}",
                    $"prem-badge-{cor}",
                    $"prem-bar-{cor}",
                    maior <= 0 ? 0 : (int)Math.Round(i.Valor / maior * 100m));
            })
            .ToArray();
    }

    /// <summary>Seis faixas de cor, do topo da tabela (ouro) para a lanterna (vermelho).</summary>
    private static string Cor(int posicao, int totalPosicoes)
    {
        if (totalPosicoes < 1) return "gold";

        var faixa = Math.Min(5, (posicao - 1) * 6 / totalPosicoes);

        return faixa switch
        {
            0 => "gold",
            1 => "green",
            2 => "blue",
            3 => "yellow",
            4 => "orange",
            _ => "red"
        };
    }

    private sealed record PassoFase(string Rotulo, string Valor, string Icone, string StepClass, string PrizeClass, string? Times);

    private IReadOnlyList<PassoFase> Fases(TipoCompetition tipo)
    {
        var itens = _premiacao?.Da(tipo, null) ?? Array.Empty<PremiacaoItemDto>();

        return itens
            .OrderBy(i => i.Fase ?? 0)
            .Select(i =>
            {
                var fase = i.Fase ?? FasePremiacao.Campeao;
                return new PassoFase(
                    fase == FasePremiacao.Campeao ? $"Campeão d{(tipo == TipoCompetition.Copa ? "a Copa" : "a Supercopa")}" : PremiacaoLabels.Fase(fase),
                    Moeda(i.Valor),
                    Icone(fase),
                    fase switch
                    {
                        FasePremiacao.Campeao => "prem-step-champ",
                        FasePremiacao.Vice => "prem-step-vice",
                        FasePremiacao.FaseDeGrupos => "prem-step-grupos",
                        _ => "prem-step-semi"
                    },
                    fase == FasePremiacao.Campeao ? "prem-prize-gold" : "",
                    QuantosTimes(fase));
            })
            .ToArray();
    }

    private static string Icone(FasePremiacao fase) => fase switch
    {
        FasePremiacao.Campeao => "🏆",
        FasePremiacao.Vice => "🥈",
        FasePremiacao.Semifinal => "⚔️",
        FasePremiacao.Quartas => "🥊",
        _ => "📋"
    };

    private static string? QuantosTimes(FasePremiacao fase) => fase switch
    {
        FasePremiacao.Campeao or FasePremiacao.Vice => "1 time",
        FasePremiacao.Semifinal => "2 times",
        FasePremiacao.Quartas => "4 times",
        _ => null
    };

    private static string Moeda(decimal valor) => $"{valor / 1_000_000m:0.##} Mi";
}
<style>
    .prem-page {
        max-width: 860px;
        margin: 0 auto;
        padding-bottom: 3rem;
    }

    .prem-divider { border-color: var(--bs-border-color, #dee2e6); margin: 2rem 0; opacity: 0.4; }
    .prem-section { margin-bottom: 0.5rem; }

    .prem-section-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 0.9rem;
    }

    .prem-section-icon { font-size: 1.4rem; line-height: 1; }

    .prem-section-header h3 {
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0;
        color: var(--bs-emphasis-color, #212529);
        letter-spacing: -0.01em;
    }

    .prem-section-desc {
        font-size: 0.9rem;
        color: var(--bs-secondary-color, #6c757d);
        margin-bottom: 1.1rem;
        line-height: 1.6;
    }

    .prem-league-grid { display: flex; flex-direction: column; gap: 0.3rem; }

    .prem-prize-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0.85rem;
        border-radius: 0.45rem;
        border: 1px solid transparent;
    }

    .prem-row-red    { background: color-mix(in srgb, var(--bs-danger, #dc3545) 8%, var(--bs-body-bg, #fff));  border-color: color-mix(in srgb, var(--bs-danger, #dc3545) 20%, transparent); }
    .prem-row-orange { background: color-mix(in srgb, #e07b00 7%, var(--bs-body-bg, #fff));                   border-color: color-mix(in srgb, #e07b00 18%, transparent); }
    .prem-row-yellow { background: color-mix(in srgb, #e5a000 7%, var(--bs-body-bg, #fff));                   border-color: color-mix(in srgb, #e5a000 18%, transparent); }
    .prem-row-blue   { background: color-mix(in srgb, var(--bs-primary, #0d6efd) 6%, var(--bs-body-bg, #fff)); border-color: color-mix(in srgb, var(--bs-primary, #0d6efd) 15%, transparent); }
    .prem-row-green  { background: color-mix(in srgb, var(--bs-success, #198754) 6%, var(--bs-body-bg, #fff)); border-color: color-mix(in srgb, var(--bs-success, #198754) 15%, transparent); }
    .prem-row-gold   { background: color-mix(in srgb, #a07800 6%, var(--bs-body-bg, #fff));                   border-color: color-mix(in srgb, #a07800 15%, transparent); }

    .prem-prize-pos  { flex-shrink: 0; min-width: 70px; }

    .prem-pos-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 36px;
        height: 1.6rem;
        padding: 0 0.4rem;
        border-radius: 0.3rem;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .prem-badge-red    { background: rgba(220,53,69,0.15);  color: var(--bs-danger, #dc3545); }
    .prem-badge-orange { background: rgba(224,123,0,0.18);  color: #c06800; }
    .prem-badge-yellow { background: rgba(229,160,0,0.2);   color: #9a7200; }
    .prem-badge-blue   { background: rgba(13,110,253,0.12); color: var(--bs-primary, #0d6efd); }
    .prem-badge-green  { background: rgba(25,135,84,0.12);  color: var(--bs-success, #198754); }
    .prem-badge-gold   { background: rgba(160,120,0,0.18);  color: #8a6400; }

    .prem-prize-bar-wrap {
        flex: 1;
        height: 8px;
        background: var(--bs-border-color, #dee2e6);
        border-radius: 999px;
        overflow: hidden;
    }

    .prem-prize-bar { height: 100%; border-radius: 999px; }

    .prem-bar-red    { background: linear-gradient(90deg, #a01020, #dc3545); }
    .prem-bar-orange { background: linear-gradient(90deg, #c06800, #e8a400); }
    .prem-bar-yellow { background: linear-gradient(90deg, #9a7200, #e5a000); }
    .prem-bar-blue   { background: linear-gradient(90deg, #3584e4, #72b3ff); }
    .prem-bar-green  { background: linear-gradient(90deg, #198754, #2ec27e); }
    .prem-bar-gold   { background: linear-gradient(90deg, #8a6400, #c89a00); }

    .prem-prize-value { flex-shrink: 0; font-size: 0.92rem; font-weight: 700; color: var(--bs-emphasis-color, #212529); min-width: 55px; text-align: right; }

    .prem-copa-ladder {
        display: flex;
        flex-direction: column;
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.6rem;
        overflow: hidden;
    }

    .prem-copa-step {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.85rem 1.1rem;
        border-bottom: 1px solid var(--bs-border-color, #dee2e6);
    }

    .prem-copa-step:last-child { border-bottom: none; }

    .prem-step-champ  { background: color-mix(in srgb, #a07800 12%, var(--bs-body-bg, #fff)); }
    .prem-step-vice   { background: color-mix(in srgb, #6c757d 8%, var(--bs-body-bg, #fff)); }
    .prem-step-semi   { background: color-mix(in srgb, var(--bs-primary, #0d6efd) 6%, var(--bs-body-bg, #fff)); }
    .prem-step-grupos { background: color-mix(in srgb, var(--bs-danger, #dc3545) 5%, var(--bs-body-bg, #fff)); }

    .prem-step-icon  { font-size: 1.5rem; flex-shrink: 0; width: 2rem; text-align: center; }
    .prem-step-info  { flex: 1; }
    .prem-step-stage { font-size: 0.95rem; font-weight: 600; color: var(--bs-emphasis-color, #212529); }
    .prem-step-teams { font-size: 0.78rem; color: var(--bs-secondary-color, #6c757d); margin-top: 0.1rem; }
    .prem-step-prize { font-size: 1.15rem; font-weight: 800; color: var(--bs-emphasis-color, #212529); flex-shrink: 0; }
    .prem-prize-gold { color: #a07800; }

    .prem-stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.6rem;
        overflow: hidden;
        margin-bottom: 0.75rem;
    }

    @@media (max-width: 640px) {
        .prem-stats-grid { grid-template-columns: 1fr; }
    }

