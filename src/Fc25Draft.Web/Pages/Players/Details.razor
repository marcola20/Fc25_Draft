@page "/players/details/{Id:int}"
@using Fc25Draft.Core.DTOs
@inject PlayersApiClient PlayersApiClient
@inject NavigationManager Navigation
@inject AdminAuthService AdminAuth

@implements IDisposable

<h3>Detalhes do Jogador</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <p><em>Carregando...</em></p>
}
else if (player is null)
{
    <p>Jogador não encontrado.</p>
}
else
{
    <dl class="row">
        <dt class="col-sm-3">Nome</dt>
        <dd class="col-sm-9">@player.Name</dd>

        <dt class="col-sm-3">Overall</dt>
        <dd class="col-sm-9">@player.Overall</dd>

        <dt class="col-sm-3">Idade</dt>
        <dd class="col-sm-9">@(player.Age?.ToString() ?? "-")</dd>

        <dt class="col-sm-3">Posição</dt>
        <dd class="col-sm-9">@player.PositionName</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@player.Status</dd>

        <dt class="col-sm-3">Time</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(player.TeamName) ? "-" : player.TeamName)</dd>
    </dl>

    <div class="d-flex gap-2">
        @if (AdminAuth.IsAuthenticated)
        {
            <button class="btn btn-primary" @onclick="() => Navigation.NavigateTo($"/players/edit/{player.PlayerId}")">
                Editar
            </button>
        }

        <button class="btn btn-secondary" @onclick="() => Navigation.NavigateTo("/players")">
            Voltar
        </button>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private PlayerDetailsDto? player;
    private string? errorMessage;
    private bool isLoading = true;
    private bool authInitialized;

    protected override void OnInitialized()
    {
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPlayerAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AdminAuth.EnsureInitializedAsync();
        authInitialized = true;
        StateHasChanged();
    }

    private async Task LoadPlayerAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            player = await PlayersApiClient.GetByIdAsync(Id);
            if (player is null)
            {
                errorMessage = "Jogador não encontrado.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnAuthenticationChanged()
    {
        if (!authInitialized)
        {
            return;
        }

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
    }
}
