@page "/players/details/{Id:int}"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Web.Services
@inject PlayersApiClient PlayersApiClient
@inject NavigationManager Navigation
@inject AdminAuthService AdminAuth
@inject IMinhaAreaService MinhaArea

@implements IDisposable

<h3>Detalhes do Jogador</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <p><em>Carregando...</em></p>
}
else if (player is null)
{
    <p>Jogador não encontrado.</p>
}
else
{
    <dl class="row">
        <dt class="col-sm-3">Nome</dt>
        <dd class="col-sm-9">@player.Name</dd>

        <dt class="col-sm-3">Overall</dt>
        <dd class="col-sm-9">@player.Overall</dd>

        <dt class="col-sm-3">Idade</dt>
        <dd class="col-sm-9">@(player.Age?.ToString() ?? "-")</dd>

        <dt class="col-sm-3">Posição</dt>
        <dd class="col-sm-9">@player.PositionName</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@player.Status</dd>

        <dt class="col-sm-3">Time</dt>
        <dd class="col-sm-9">
            @if (player.TeamId is Guid teamId && !string.IsNullOrWhiteSpace(player.TeamName))
            {
                <a href="/teams/details/@teamId" class="text-primary">@player.TeamName</a>
            }
            else
            {
                <span>-</span>
            }
        </dd>
    </dl>

    <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo($"/players/edit/{player.PlayerId}")'>
        Editar
    </button>

    <button class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/players")'>
        Voltar
    </button>

    <a href="/jogadores/comparar?a=@player.PlayerId" class="btn btn-outline-primary">⚖️ Comparar com outro jogador</a>

    @if (_podeObservar)
    {
        <button type="button" class="btn @(_observando ? "btn-warning" : "btn-outline-warning")" @onclick="AlternarObservacaoAsync"
                title="@(_observando ? "Tirar da lista de observação" : "Acompanhar na Minha Área (avisa quando entrar em leilão)")">
            @(_observando ? "★ Observando" : "☆ Observar")
        </button>
    }

    <JogadorCarreira @key="player.PlayerId" PlayerId="@player.PlayerId" />
}

@code {
    [Parameter]
    public int Id { get; set; }

    private PlayerDetailsDto? player;
    private string? errorMessage;
    private bool isLoading = true;
    private bool authInitialized;

    protected override void OnInitialized()
    {
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
    }

    private int? _carregadoId;
    private bool _podeObservar;
    private bool _observando;

    // Observar é do time: só aparece para quem entrou com o token de um time.
    private async Task CarregarObservacaoAsync()
    {
        await AdminAuth.EnsureInitializedAsync();
        var token = AdminAuth.IsAuthenticated ? AdminAuth.Token : null;
        _podeObservar = await MinhaArea.ResolverTimeAsync(token, CancellationToken.None) is not null;
        _observando = _podeObservar && await MinhaArea.EstaObservandoAsync(token, Id, CancellationToken.None);
    }

    private async Task AlternarObservacaoAsync()
    {
        try
        {
            _observando = await MinhaArea.AlternarObservacaoAsync(AdminAuth.Token, Id, CancellationToken.None);
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
    }

    // Recarrega quando o Id muda (o Blazor reaproveita a página ao navegar entre jogadores).
    protected override async Task OnParametersSetAsync()
    {
        if (_carregadoId == Id)
        {
            return;
        }

        _carregadoId = Id;
        await LoadPlayerAsync();
        await CarregarObservacaoAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AdminAuth.EnsureInitializedAsync();
        authInitialized = true;
        StateHasChanged();
    }

    private async Task LoadPlayerAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            player = await PlayersApiClient.GetByIdAsync(Id);
            if (player is null)
            {
                errorMessage = "Jogador não encontrado.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnAuthenticationChanged()
    {
        if (!authInitialized)
        {
            return;
        }

        // Entrou ou saiu um time: o botão de observar depende de quem está logado.
        _ = InvokeAsync(async () =>
        {
            await CarregarObservacaoAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
    }
}
