@page "/players/details/{Id:int}"
@inject IPlayerService PlayerService
@inject NavigationManager Navigation

<h3>Detalhes do Jogador</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <p><em>Carregando...</em></p>
}
else if (player is null)
{
    <p>Jogador não encontrado.</p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Nome</dt>
        <dd class="col-sm-10">@player.Name</dd>

        <dt class="col-sm-2">Overall</dt>
        <dd class="col-sm-10">@player.Overall</dd>

        <dt class="col-sm-2">Idade</dt>
        <dd class="col-sm-10">@(player.Age?.ToString() ?? "-")</dd>

        <dt class="col-sm-2">Posição</dt>
        <dd class="col-sm-10">@player.Position?.Name</dd>
    </dl>

    <div class="d-flex gap-2">
        <button class="btn btn-primary"
                @onclick="@(() => Navigation.NavigateTo($"/players/edit/{player.PlayerId}"))">
            Editar
        </button>

        <button class="btn btn-secondary"
                @onclick="@(() => Navigation.NavigateTo("/players"))">
            Voltar
        </button>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Player? player;
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            player = await PlayerService.GetAsync(Id);
            if (player is null)
            {
                errorMessage = "Jogador não encontrado.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
