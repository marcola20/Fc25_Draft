@page "/players/details/{Id:int}"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Utilities
@using Fc25Draft.Web.Services
@inject PlayersApiClient PlayersApiClient
@inject NavigationManager Navigation
@inject AdminAuthService AdminAuth
@inject IMinhaAreaService MinhaArea
@inject IPricingService Pricing
@inject IFotosJogadoresService Fotos
@inject IJSRuntime JS
@inject EscudoService Escudos

@implements IDisposable

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <p><em>Carregando...</em></p>
}
else if (player is null)
{
    <p>Jogador não encontrado.</p>
}
else
{
    <div class="card jogador-hero mb-3">
        <div class="card-body">
            <div class="jogador-hero-corpo">
                <div class="jogador-hero-foto">
                    <FotoJogador PlayerId="@player.PlayerId" Tamanho="120" Versao="@_versaoFoto" Alt="@player.Name" Classe="jogador-hero-img" />
                    @if (AdminAuth.IsAdmin)
                    {
                        <div class="jogador-hero-foto-admin">
                            <label class="btn btn-link btn-sm p-0" title="Trocar a foto deste jogador">
                                📷 Trocar
                                <input type="file" id="fotoJogadorArquivo" accept="image/*" class="d-none" @onchange="TrocarFotoAsync" />
                            </label>
                            @if (_foto?.TemFoto == true)
                            {
                                <span class="text-muted">·</span>
                                <button type="button" class="btn btn-link btn-sm p-0 text-danger" @onclick="RemoverFotoAsync">Remover</button>
                            }
                        </div>
                        @if (_foto?.TemFoto == true)
                        {
                            <div class="small text-muted">@(_foto.Origem == "MANUAL" ? "foto trocada à mão" : "foto do PES")</div>
                        }
                    }
                </div>

                <div class="jogador-hero-info">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h2 class="jogador-hero-nome">@player.Name</h2>
                        <span class="badge jogador-hero-overall @CorDoOverall(player.Overall)" title="Overall">@player.Overall</span>
                    </div>
                    <div class="jogador-hero-sub">
                        <span>@player.PositionName</span>
                        @if (player.Age is int idade)
                        {
                            <span>· @idade anos</span>
                        }
                        <span>·</span>
                        @if (player.TeamId is Guid teamId && !string.IsNullOrWhiteSpace(player.TeamName))
                        {
                            <a href="/teams/details/@teamId" class="jogador-hero-time">
                                <img src="@Escudos.GetEscudo(player.TeamName)" alt="" />@player.TeamName
                            </a>
                        }
                        else
                        {
                            <span>sem time</span>
                        }
                    </div>

                    <div class="jogador-hero-numeros">
                        <div>
                            <div class="jogador-hero-rotulo">Valor de mercado</div>
                            <div class="jogador-hero-valor">@(_valorDeMercado is decimal valor ? Dinheiro.Curto(valor) : "—")</div>
                        </div>
                        <div>
                            <div class="jogador-hero-rotulo">Situação</div>
                            <div class="jogador-hero-valor">@player.Status</div>
                        </div>
                        @if (OverallPes.CalcularDoJogador(player.Atributos) is double formula)
                        {
                            <div>
                                <div class="jogador-hero-rotulo">Overall pela fórmula do PES</div>
                                <div class="jogador-hero-valor">
                                    @formula.ToString("0.00") <a href="/overall" class="small fw-normal">como é calculado</a>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="jogador-hero-acoes">
                    @* Treinador logado com o token do time não é administrador. *@
                    @if (AdminAuth.IsAdmin)
                    {
                        <button class="btn btn-sm btn-primary" @onclick='() => Navigation.NavigateTo($"/players/edit/{player.PlayerId}")'>
                            ✏️ Editar
                        </button>
                    }
                    <a href="/jogadores/comparar?a=@player.PlayerId" class="btn btn-sm btn-outline-primary">⚖️ Comparar</a>
                    @if (_podeObservar)
                    {
                        <button type="button" class="btn btn-sm @(_observando ? "btn-warning" : "btn-outline-warning")" @onclick="AlternarObservacaoAsync"
                                title="@(_observando ? "Tirar da lista de observação" : "Acompanhar na Minha Área (avisa quando entrar em leilão)")">
                            @(_observando ? "★ Observando" : "☆ Observar")
                        </button>
                    }
                    <button class="btn btn-sm btn-outline-secondary" @onclick='() => Navigation.NavigateTo("/players")'>
                        ← Jogadores
                    </button>
                </div>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3" role="tablist">
        @if (player.Atributos is not null)
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link @(_aba == Aba.Atributos ? "active" : "")"
                        type="button" @onclick="() => _aba = Aba.Atributos">
                    Atributos
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(_aba == Aba.Habilidades ? "active" : "")"
                        type="button" @onclick="() => _aba = Aba.Habilidades">
                    Habilidades
                </button>
            </li>
        }
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_aba == Aba.Jogos ? "active" : "")"
                    type="button" @onclick="() => _aba = Aba.Jogos">
                Jogos
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_aba == Aba.Carreira ? "active" : "")"
                    type="button" @onclick="() => _aba = Aba.Carreira">
                Carreira
            </button>
        </li>
    </ul>

    @if (_aba == Aba.Atributos && player.Atributos is { } atributos)
    {
        <AtributosJogador Atributos="atributos" Goleiro="@(player.PositionId == (short)PositionType.Goleiro)"
                          MostrarIdPes="AdminAuth.IsAdmin" />
    }
    else if (_aba == Aba.Habilidades && player.Atributos is { } atributosHab)
    {
        <HabilidadesJogador Atributos="atributosHab" />
    }
    else if (_aba == Aba.Jogos)
    {
        <JogadorJogos @key="@($"jogos-{player.PlayerId}")" PlayerId="@player.PlayerId" />
    }
    else
    {
        <EvolucaoOverall @key="@($"overall-{player.PlayerId}")" PlayerId="@player.PlayerId" />
        <JogadorCarreira @key="player.PlayerId" PlayerId="@player.PlayerId" />
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private PlayerDetailsDto? player;
    private string? errorMessage;
    private bool isLoading = true;
    private bool authInitialized;

    protected override void OnInitialized()
    {
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
    }

    private enum Aba { Atributos, Habilidades, Jogos, Carreira }

    // Mesma escala de cores dos atributos.
    private static string CorDoOverall(int overall) => overall switch
    {
        >= 90 => "bg-danger",
        >= 85 => "jogador-overall-laranja",
        >= 80 => "bg-warning text-dark",
        >= 75 => "bg-success",
        _ => "bg-secondary"
    };

    // Foto: origem (PES ou trocada à mão) e a versão que força o navegador a buscar a nova.
    private FotoJogadorInfo? _foto;
    private string? _versaoFoto;

    private sealed record FotoLida(string Base64, string Tipo);

    private async Task TrocarFotoAsync(ChangeEventArgs _)
    {
        if (!AdminAuth.IsAdmin || player is null) return;
        try
        {
            var lida = await JS.InvokeAsync<FotoLida?>("cbfvFoto.ler", "fotoJogadorArquivo");
            if (lida is null) return;
            await Fotos.TrocarAsync(player.PlayerId, Convert.FromBase64String(lida.Base64), CancellationToken.None);
            await AtualizarFotoAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException or FormatException)
        {
            errorMessage = ex is JSException ? "Não foi possível ler a imagem escolhida." : ex.Message;
        }
    }

    private async Task RemoverFotoAsync()
    {
        if (!AdminAuth.IsAdmin || player is null) return;
        await Fotos.RemoverAsync(player.PlayerId, CancellationToken.None);
        await AtualizarFotoAsync();
    }

    private async Task AtualizarFotoAsync()
    {
        _foto = await Fotos.InfoAsync(player!.PlayerId, CancellationToken.None);
        _versaoFoto = _foto.Versao;
    }
    private Aba _aba;

    private int? _carregadoId;
    private bool _podeObservar;
    private bool _observando;

    // Observar é do time: só aparece para quem entrou com o token de um time.
    private async Task CarregarObservacaoAsync()
    {
        await AdminAuth.EnsureInitializedAsync();
        var token = AdminAuth.IsAuthenticated ? AdminAuth.Token : null;
        _podeObservar = await MinhaArea.ResolverTimeAsync(token, CancellationToken.None) is not null;
        _observando = _podeObservar && await MinhaArea.EstaObservandoAsync(token, Id, CancellationToken.None);
    }

    private async Task AlternarObservacaoAsync()
    {
        try
        {
            _observando = await MinhaArea.AlternarObservacaoAsync(AdminAuth.Token, Id, CancellationToken.None);
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
    }

    // Recarrega quando o Id muda (o Blazor reaproveita a página ao navegar entre jogadores).
    protected override async Task OnParametersSetAsync()
    {
        if (_carregadoId == Id)
        {
            return;
        }

        _carregadoId = Id;
        await LoadPlayerAsync();
        // Abre nos atributos quando o jogador tem; senão, na carreira.
        _aba = player?.Atributos is not null ? Aba.Atributos : Aba.Carreira;
        await CarregarObservacaoAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AdminAuth.EnsureInitializedAsync();
        authInitialized = true;
        StateHasChanged();
    }

    // Mesmo cálculo do leilão, da venda rápida e da compensação do draft de expansão (posição, overall e idade).
    private decimal? _valorDeMercado;

    private async Task LoadPlayerAsync()
    {
        isLoading = true;
        errorMessage = null;
        _valorDeMercado = null;

        try
        {
            player = await PlayersApiClient.GetByIdAsync(Id);
            if (player is null)
            {
                errorMessage = "Jogador não encontrado.";
            }
            else
            {
                _valorDeMercado = (await Pricing.CalculateForPlayerAsync(player.PlayerId, CancellationToken.None)).BasePrice;
                _foto = await Fotos.InfoAsync(player.PlayerId, CancellationToken.None);
                _versaoFoto = _foto.Versao;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnAuthenticationChanged()
    {
        if (!authInitialized)
        {
            return;
        }

        // Entrou ou saiu um time: o botão de observar depende de quem está logado.
        _ = InvokeAsync(async () =>
        {
            await CarregarObservacaoAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
    }
}
