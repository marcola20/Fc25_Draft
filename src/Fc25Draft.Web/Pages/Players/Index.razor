@page "/players"
@using System
@using System.Collections.Generic
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Entities
@using System.Linq
@using Microsoft.AspNetCore.WebUtilities
@inject PlayersApiClient PlayersApiClient
@inject IPositionService PositionService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AdminAuthService AdminAuth

@implements IDisposable

@* Barra de ações (baixar a lista e, para o admin, criar e importar) e um painel só com todos os filtros. *@
<div class="lista-acoes">
    @if (AdminAuth.IsAdmin)
    {
        <div class="d-flex gap-2" role="group" aria-label="Ações administrativas">
            <button class="btn btn-sm btn-outline-secondary" @onclick="CreatePlayer"><Icone Nome="plus" Tamanho="14" /> Novo jogador</button>
            <label class="btn btn-sm btn-outline-secondary mb-0">
                @if (isImporting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Importando...</span>
                }
                else
                {
                    <span>Importar CSV</span>
                }
                <InputFile @key="importInputKey" OnChange="OnCsvSelected" accept=".csv" class="d-none" disabled="@isImporting" />
            </label>
        </div>
    }
    <div class="ms-auto">
        @if (isDownloadDropdownOpen)
        {
            <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1000;" @onclick="CloseDownloadDropdown"></div>
        }
        <div class="position-relative" style="z-index: 1010;">
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    id="playerDownloadMenu"
                    title="Baixa a lista de acordo com os filtros aplicados"
                    disabled="@(isLoading || totalPlayers == 0)"
                    @onclick="ToggleDownloadDropdown"
                    aria-expanded="@isDownloadDropdownOpen">
                <Icone Nome="download" Tamanho="14" /> Baixar lista
            </button>
            <div class="dropdown-menu dropdown-menu-end shadow-sm @(isDownloadDropdownOpen ? "show" : string.Empty)"
                 aria-labelledby="playerDownloadMenu"
                 style="z-index: 1050;@(isDownloadDropdownOpen ? string.Empty : " display: none;")"
                 @onclick:stopPropagation>
                <h6 class="dropdown-header">@GetDownloadSummary()</h6>
                <button type="button" class="dropdown-item" @onclick="@(() => DownloadExport("csv"))">CSV</button>
                <button type="button" class="dropdown-item" @onclick="@(() => DownloadExport("xlsx"))">Excel (XLSX)</button>
                <button type="button" class="dropdown-item" @onclick="@(() => DownloadExport("json"))">JSON</button>
            </div>
        </div>
    </div>
</div>

<form class="filtros-jogadores" @onsubmit="OnSearchAsync" @onsubmit:preventDefault>
    <div class="filtro filtro-nome">
        <label class="form-label" for="playerSearch">Jogador</label>
        <div class="campo-busca">
            <Icone Nome="search" Tamanho="14" Classe="campo-busca-icone" />
            <input id="playerSearch" class="form-control form-control-sm" placeholder="Nome" @bind="search" />
        </div>
    </div>
    <div class="filtro">
        <label class="form-label" for="playerPositionFilter">Posições</label>
        @if (isPositionDropdownOpen)
        {
            <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1000;" @onclick="ClosePositionDropdown"></div>
        }
        <div class="position-relative" style="z-index: 1010;">
            <button class="form-select form-select-sm w-100 text-start d-flex align-items-center"
                    type="button"
                    id="playerPositionFilter"
                    @onclick="TogglePositionDropdown"
                    @onkeydown="HandlePositionDropdownKeyDown"
                    aria-expanded="@isPositionDropdownOpen">
                <span class="me-2 flex-grow-1">@GetSelectedPositionsLabel()</span>
            </button>
            <div class="dropdown-menu w-100 p-3 shadow-sm @(isPositionDropdownOpen ? "show" : string.Empty)"
                 aria-labelledby="playerPositionFilter"
                 style="@GetPositionDropdownMenuStyles()"
                 @onclick:stopPropagation>
                <div class="form-check mb-2">
                    <input class="form-check-input"
                           type="checkbox"
                           id="playerPositionsAll"
                           checked="@(!selectedPositionIds.Any())"
                           @onchange="OnSelectAllPositionsChanged" />
                    <label class="form-check-label" for="playerPositionsAll">Todas</label>
                </div>
                <div class="dropdown-divider"></div>
                @foreach (var position in positions)
                {
                    var checkboxId = $"playerPosition{position.PositionId}";
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="@checkboxId"
                               checked="@selectedPositionIds.Contains(position.PositionId)"
                               @onchange="args => OnPositionToggled(position.PositionId, args.Value)" />
                        <label class="form-check-label" for="@checkboxId">@position.Name</label>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="filtro filtro-faixa">
        <label class="form-label" for="overallMin">Overall</label>
        <div class="input-group input-group-sm">
            <InputNumber id="overallMin" class="form-control" @bind-Value="overallMin" min="70" max="99" placeholder="de" aria-label="Overall mínimo" />
            <InputNumber id="overallMax" class="form-control" @bind-Value="overallMax" min="70" max="99" placeholder="até" aria-label="Overall máximo" />
        </div>
    </div>
    <div class="filtro filtro-faixa">
        <label class="form-label" for="idadeMin">Idade</label>
        <div class="input-group input-group-sm">
            <InputNumber id="idadeMin" class="form-control" @bind-Value="idadeMin" min="14" max="50" placeholder="de" aria-label="Idade mínima" />
            <InputNumber id="idadeMax" class="form-control" @bind-Value="idadeMax" min="14" max="50" placeholder="até" aria-label="Idade máxima" />
            <button type="button" class="btn btn-outline-secondary" title="Só quem pode entrar no draft (até @IdadeDoDraft anos)" @onclick="SoSub23Async">Sub-@IdadeDoDraft</button>
        </div>
    </div>
    <div class="filtro-disponiveis form-check form-switch">
        <input id="onlyAvailableCheck" class="form-check-input" type="checkbox" role="switch" checked="@onlyAvailable" @onchange="OnOnlyAvailableChanged" />
        <label class="form-check-label" for="onlyAvailableCheck">Só disponíveis</label>
    </div>
    <div class="filtro-acoes">
        <button type="submit" class="btn btn-sm btn-primary">Filtrar</button>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(importSuccessMessage))
{
    <div class="alert alert-success" role="status">@importSuccessMessage</div>
}

@if (!string.IsNullOrWhiteSpace(importErrorMessage))
{
    <div class="alert alert-warning" role="alert">
        <p class="mb-1">@importErrorMessage</p>
        @if (importErrors.Count > 0)
        {
            <ul class="mb-0">
                @foreach (var detail in importErrors)
                {
                    <li>@detail</li>
                }
            </ul>
        }
    </div>
}

@if (isLoading)
{
    <div class="text-center py-5"><span class="spinner-border" role="status" aria-label="Carregando"></span></div>
}
else if (players.Count == 0)
{
    <div class="alert alert-secondary">@GetPlayersSummary()</div>
}
else
{
    <p class="lista-resumo">@GetPlayersSummary()</p>
    <div class="table-responsive painel">
        <table class="table table-hover align-middle mb-0 tabela-jogadores">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th class="text-center" title="País">País</th>
                    <th>Posição</th>
                    <th>
                        <button type="button"
                                class="ordenar @(sortBy == "overall" ? "ativo" : "")"
                                @onclick="@(() => ChangeSort("overall"))">
                            Overall
                            @if (sortBy == "overall")
                            {
                                <Icone Nome="@(sortDescending ? "arrow-down" : "arrow-up")" Tamanho="12" />
                            }
                        </button>
                    </th>
                    <th>
                        <button type="button"
                                class="ordenar @(sortBy == "age" ? "ativo" : "")"
                                @onclick="@(() => ChangeSort("age"))">
                            Idade
                            @if (sortBy == "age")
                            {
                                <Icone Nome="@(sortDescending ? "arrow-down" : "arrow-up")" Tamanho="12" />
                            }
                        </button>
                    </th>
                    <th>Status</th>
                    <th>Time</th>
                    @if (AdminAuth.IsAdmin)
                    {
                        <th class="text-end"><span class="visually-hidden">Ações</span></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var player in players)
                {
                    <tr>
                        <td class="text-nowrap"><FotoJogador PlayerId="@player.PlayerId" Tamanho="32" Classe="me-2" /><a href="/players/details/@player.PlayerId" class="jogador-nome">@player.Name</a></td>
                        <td class="text-center"><Bandeira Pais="@player.Pais" Largura="22" /></td>
                        <td>@player.PositionName</td>
                        <td><span class="ovr @Fc25Draft.Core.Utilities.AtributosPes.Faixa(player.Overall)">@player.Overall</span></td>
                        <td class="numero">@(player.Age?.ToString() ?? "—")</td>
                        <td><span class="etiqueta @(player.Status == "Disponível" ? "sucesso" : "")">@player.Status</span></td>
                        <td class="text-body-secondary">@(string.IsNullOrWhiteSpace(player.TeamName) ? "—" : player.TeamName)</td>
                        @* O nome já leva aos detalhes; editar e excluir só para o admin. *@
                        @if (AdminAuth.IsAdmin)
                        {
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-secondary btn-icone" title="Editar" aria-label="Editar @player.Name" @onclick="() => EditPlayer(player.PlayerId)"><Icone Nome="pencil" Tamanho="14" /></button>
                                <button class="btn btn-sm btn-outline-secondary btn-icone acao-perigo" title="Excluir" aria-label="Excluir @player.Name" @onclick="() => ConfirmDelete(player.PlayerId)"><Icone Nome="x" Tamanho="14" /></button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        var visiblePages = GetVisiblePageNumbers();
        <nav aria-label="Paginação de jogadores">
            <ul class="pagination">
                <li class="page-item @(currentPage == 1 ? "disabled" : string.Empty)">
                    <button type="button" class="page-link" @onclick="() => ChangePage(currentPage - 1)" disabled="@(currentPage == 1)">Anterior</button>
                </li>
                @if (visiblePages.Count > 0 && visiblePages[0] > 1)
                {
                    <li class="page-item">
                        <button type="button" class="page-link" @onclick="() => ChangePage(1)">1</button>
                    </li>
                    @if (visiblePages[0] > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    }
                }
                @foreach (var page in visiblePages)
                {
                    <li class="page-item @(page == currentPage ? "active" : string.Empty)">
                        <button type="button" class="page-link" @onclick="() => ChangePage(page)">@(page)</button>
                    </li>
                }
                @if (visiblePages.Count > 0 && visiblePages[visiblePages.Count - 1] < totalPages)
                {
                    @if (visiblePages[visiblePages.Count - 1] < totalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    }
                    <li class="page-item">
                        <button type="button" class="page-link" @onclick="() => ChangePage(totalPages)">@totalPages</button>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : string.Empty)">
                    <button type="button" class="page-link" @onclick="() => ChangePage(currentPage + 1)" disabled="@(currentPage == totalPages)">Próximo</button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    private const int PageSize = 25;
    private readonly List<PlayerListItemDto> players = new();
    private readonly List<Position> positions = new();
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalPlayers;
    private string? search;
    private string? errorMessage;
    private bool isLoading = true;
    private readonly HashSet<short> selectedPositionIds = new();
    private bool onlyAvailable;
    private bool authInitialized;
    private bool isImporting;
    private bool isPositionDropdownOpen;
    private bool isDownloadDropdownOpen;
    private string importInputKey = Guid.NewGuid().ToString();
    private string? importSuccessMessage;
    private string? importErrorMessage;
    private readonly List<string> importErrors = new();
    private int? overallMin;
    private int? overallMax;
    private string? appliedSearch;
    private int? appliedOverallMin;
    private int? appliedOverallMax;
    private int? idadeMin;
    private int? idadeMax;
    private int? appliedIdadeMin;
    private int? appliedIdadeMax;

    /// <summary>Idade máxima do draft (o draft é só para jovens).</summary>
    private const int IdadeDoDraft = 23;
    private string sortBy = "overall";
    private bool sortDescending = true;

    protected override void OnInitialized()
    {
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPositionsAsync();
        await LoadPlayersAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AdminAuth.EnsureInitializedAsync();
        authInitialized = true;
        StateHasChanged();
    }

    private async Task LoadPositionsAsync()
    {
        try
        {
            positions.Clear();
            var items = await PositionService.GetAllAsync();
            positions.AddRange(items);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task OnSearchAsync()
    {
        await ApplyFiltersAsync();
    }

    private async Task OnOnlyAvailableChanged(ChangeEventArgs args)
    {
        if (args.Value is bool boolean)
        {
            onlyAvailable = boolean;
        }
        else if (bool.TryParse(args.Value?.ToString(), out var parsed))
        {
            onlyAvailable = parsed;
        }
        else
        {
            onlyAvailable = false;
        }
        await ApplyFiltersAsync();
    }

    private async Task OnCsvSelected(InputFileChangeEventArgs args)
    {
        importSuccessMessage = null;
        importErrorMessage = null;
        importErrors.Clear();

        var file = args.File;

        if (file is null)
        {
            importInputKey = Guid.NewGuid().ToString();
            return;
        }

        if (!AdminAuth.IsAdmin)
        {
            importErrorMessage = "Entre como administrador para importar jogadores.";
            importInputKey = Guid.NewGuid().ToString();
            return;
        }

        isImporting = true;

        try
        {
            var result = await PlayersApiClient.ImportAsync(file);

            if (result.Imported > 0)
            {
                importSuccessMessage = result.Imported == 1
                    ? "1 jogador importado com sucesso."
                    : $"{result.Imported} jogadores importados com sucesso.";
            }
            else
            {
                importSuccessMessage = "Nenhum jogador foi importado.";
            }

            if (result.Errors.Count > 0)
            {
                importErrorMessage = "Algumas linhas não puderam ser importadas:";
                importErrors.AddRange(result.Errors);
            }

            await LoadPlayersAsync();
        }
        catch (Exception ex)
        {
            importErrorMessage = $"Falha ao importar jogadores: {ex.Message}";
        }
        finally
        {
            isImporting = false;
            importInputKey = Guid.NewGuid().ToString();
            StateHasChanged();
        }
    }

    private async Task LoadPlayersAsync()
    {
        isLoading = true;
        errorMessage = null;
        players.Clear();

        try
        {
            var result = await PlayersApiClient.GetAsync(
                search,
                selectedPositionIds,
                onlyAvailable,
                overallMin,
                overallMax,
                sortBy,
                sortDescending ? "desc" : "asc",
                currentPage,
                PageSize,
                idadeMin,
                idadeMax);
            players.AddRange(result.Items);
            totalPlayers = result.Total;
            appliedSearch = search;
            appliedOverallMin = overallMin;
            appliedOverallMax = overallMax;
            appliedIdadeMin = idadeMin;
            appliedIdadeMax = idadeMax;
            totalPages = Math.Max(1, (int)Math.Ceiling(totalPlayers / (double)PageSize));
            if (currentPage > totalPages)
            {
                currentPage = totalPages;
                await LoadPlayersAsync();
                return;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page == currentPage || page > totalPages)
        {
            return;
        }

        currentPage = page;
        await LoadPlayersAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        currentPage = 1;
        await LoadPlayersAsync();
    }

    private async Task ChangeSort(string column)
    {
        if (sortBy == column)
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortBy = column;
            sortDescending = true;
        }

        await ApplyFiltersAsync();
    }

    private async Task SoSub23Async()
    {
        idadeMin = null;
        idadeMax = IdadeDoDraft;
        await ApplyFiltersAsync();
    }

    private void CreatePlayer()
    {
        if (!AdminAuth.IsAdmin)
        {
            errorMessage = "Entre como administrador para adicionar jogadores.";
            return;
        }

        Navigation.NavigateTo("/players/edit");
    }

    private void EditPlayer(int id)
    {
        if (!AdminAuth.IsAdmin)
        {
            errorMessage = "Entre como administrador para editar jogadores.";
            return;
        }

        Navigation.NavigateTo($"/players/edit/{id}");
    }

    private void ViewDetails(int id) => Navigation.NavigateTo($"/players/details/{id}");

    private async Task ConfirmDelete(int id)
    {
        if (!AdminAuth.IsAdmin)
        {
            errorMessage = "Entre como administrador para excluir jogadores.";
            return;
        }

        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Tem certeza de que deseja excluir este jogador?"))
        {
            return;
        }

        try
        {
            await PlayersApiClient.DeleteAsync(id);
            await LoadPlayersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void DownloadExport(string format)
    {
        isDownloadDropdownOpen = false;

        var path = format switch
        {
            "json" => "api/players/export/json",
            "xlsx" => "api/players/export/xlsx",
            _ => "api/players/export/csv"
        };

        Navigation.NavigateTo(BuildExportUrl(path), forceLoad: true);
    }

    private string BuildExportUrl(string path)
    {
        var query = new List<KeyValuePair<string, string?>>();

        if (!string.IsNullOrWhiteSpace(appliedSearch))
        {
            query.Add(new("q", appliedSearch.Trim()));
        }

        foreach (var id in selectedPositionIds.OrderBy(id => id))
        {
            query.Add(new("pos", id.ToString()));
        }

        if (onlyAvailable)
        {
            query.Add(new("onlyAvailable", "true"));
        }

        if (appliedOverallMin.HasValue)
        {
            query.Add(new("overallMin", appliedOverallMin.Value.ToString()));
        }

        if (appliedOverallMax.HasValue)
        {
            query.Add(new("overallMax", appliedOverallMax.Value.ToString()));
        }

        if (appliedIdadeMin.HasValue)
        {
            query.Add(new("ageMin", appliedIdadeMin.Value.ToString()));
        }

        if (appliedIdadeMax.HasValue)
        {
            query.Add(new("ageMax", appliedIdadeMax.Value.ToString()));
        }

        query.Add(new("sortBy", sortBy));
        query.Add(new("sortOrder", sortDescending ? "desc" : "asc"));

        return QueryHelpers.AddQueryString(path, query);
    }

    private string GetDownloadSummary()
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(appliedSearch))
        {
            parts.Add($"nome \"{appliedSearch.Trim()}\"");
        }

        if (selectedPositionIds.Count > 0)
        {
            parts.Add(GetSelectedPositionsLabel());
        }

        if (onlyAvailable)
        {
            parts.Add("somente disponíveis");
        }

        if (appliedOverallMin.HasValue || appliedOverallMax.HasValue)
        {
            parts.Add((appliedOverallMin, appliedOverallMax) switch
            {
                ({ } min, { } max) => $"overall {min}-{max}",
                ({ } min, null) => $"overall ≥ {min}",
                (null, { } max) => $"overall ≤ {max}",
                _ => string.Empty
            });
        }

        if (appliedIdadeMin.HasValue || appliedIdadeMax.HasValue)
        {
            parts.Add((appliedIdadeMin, appliedIdadeMax) switch
            {
                ({ } min, { } max) => $"{min} a {max} anos",
                ({ } min, null) => $"{min}+ anos",
                (null, { } max) => $"até {max} anos",
                _ => string.Empty
            });
        }

        var count = totalPlayers == 1 ? "1 jogador" : $"{totalPlayers} jogadores";
        return parts.Count == 0 ? $"{count} (sem filtros)" : $"{count} · {string.Join(", ", parts)}";
    }

    private void ToggleDownloadDropdown()
    {
        isDownloadDropdownOpen = !isDownloadDropdownOpen;
    }

    private void CloseDownloadDropdown()
    {
        isDownloadDropdownOpen = false;
    }

    private IReadOnlyList<int> GetVisiblePageNumbers()
    {
        const int maxVisiblePages = 5;

        if (totalPages <= maxVisiblePages)
        {
            return Enumerable.Range(1, totalPages).ToList();
        }

        var start = Math.Max(1, currentPage - 2);
        var end = Math.Min(totalPages, start + maxVisiblePages - 1);
        start = Math.Max(1, end - maxVisiblePages + 1);

        return Enumerable.Range(start, end - start + 1).ToList();
    }

    private string GetPlayersSummary()
    {
        if (totalPlayers == 0)
        {
            return "Nenhum jogador encontrado com esses filtros";
        }

        if (players.Count == 0)
        {
            return $"Nenhum jogador nesta página. {totalPlayers} jogadores no total";
        }

        var start = (currentPage - 1) * PageSize + 1;
        var end = Math.Min(totalPlayers, start + players.Count - 1);

        return $"{start}–{end} de {totalPlayers} jogadores";
    }

    private string GetSelectedPositionsLabel()
    {
        if (selectedPositionIds.Count == 0 || positions.Count == 0)
        {
            return "Todas as posições";
        }

        var names = positions
            .Where(p => selectedPositionIds.Contains(p.PositionId))
            .Select(p => p.Name)
            .ToList();

        return names.Count == 0 ? "Todas as posições" : string.Join(", ", names);
    }

    private string GetPositionDropdownMenuStyles()
    {
        var visibility = isPositionDropdownOpen ? string.Empty : " display: none;";
        return $"max-height: 280px; overflow-y: auto; z-index: 1050;{visibility}";
    }

    private void TogglePositionDropdown()
    {
        isPositionDropdownOpen = !isPositionDropdownOpen;
    }

    private void ClosePositionDropdown()
    {
        if (!isPositionDropdownOpen)
        {
            return;
        }

        isPositionDropdownOpen = false;
    }

    private void HandlePositionDropdownKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            ClosePositionDropdown();
        }
    }

    private async Task OnPositionToggled(short positionId, object? value)
    {
        var isChecked = ParseCheckboxValue(value);
        var changed = isChecked
            ? selectedPositionIds.Add(positionId)
            : selectedPositionIds.Remove(positionId);

        if (changed)
        {
            await ApplyFiltersAsync();
        }
    }

    private async Task OnSelectAllPositionsChanged(ChangeEventArgs args)
    {
        if (!ParseCheckboxValue(args.Value))
        {
            return;
        }

        if (selectedPositionIds.Count == 0)
        {
            return;
        }

        selectedPositionIds.Clear();
        await ApplyFiltersAsync();
    }

    private static bool ParseCheckboxValue(object? value)
    {
        return value switch
        {
            bool boolean => boolean,
            string text when bool.TryParse(text, out var parsed) => parsed,
            _ => false
        };
    }

    private void OnAuthenticationChanged()
    {
        if (!authInitialized)
        {
            return;
        }

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
    }
}
