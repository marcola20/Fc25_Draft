@page "/players"
@using System
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Entities
@inject PlayersApiClient PlayersApiClient
@inject IPositionService PositionService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AdminAuthService AdminAuth

@implements IDisposable

<h3>Jogadores</h3>

<div class="row mb-3 g-2 align-items-end">
    <div class="col-md-4">
        <label class="form-label" for="playerSearch">Pesquisar</label>
        <form class="d-flex" @onsubmit="OnSearchAsync" @onsubmit:preventDefault>
            <input id="playerSearch" class="form-control me-2" placeholder="Procurar por nome" @bind="search" />
            <button type="submit" class="btn btn-primary">Buscar</button>
        </form>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="positionFilter">Posição</label>
        <select id="positionFilter" class="form-select" value="@selectedPositionId" @onchange="OnFilterChanged">
            <option value="">Todas</option>
            @foreach (var position in positions)
            {
                <option value="@position.PositionId">@position.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2 pt-4">
        <div class="form-check">
            <input id="onlyAvailableCheck" class="form-check-input" type="checkbox" checked="@onlyAvailable" @onchange="OnOnlyAvailableChanged" />
            <label class="form-check-label" for="onlyAvailableCheck">Somente disponíveis</label>
        </div>
    </div>
    <div class="col-md-3 text-md-end">
        <div class="btn-group" role="group" aria-label="Exportações">
            <button class="btn btn-outline-secondary" @onclick="@(() => DownloadExport("csv"))">Baixar CSV</button>
            <button class="btn btn-outline-secondary" @onclick="@(() => DownloadExport("json"))">Baixar JSON</button>
            <button class="btn btn-outline-secondary" @onclick="@(() => DownloadExport("xlsx"))">Baixar Excel</button>
        </div>
        @if (AdminAuth.IsAuthenticated)
        {
            <div class="btn-group ms-2" role="group" aria-label="Ações administrativas">
                <button class="btn btn-success" @onclick="CreatePlayer">Novo Jogador</button>
                <label class="btn btn-outline-success mb-0">
                    @if (isImporting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Importando...</span>
                    }
                    else
                    {
                        <span>Importar CSV</span>
                    }
                    <InputFile @key="importInputKey" OnChange="OnCsvSelected" accept=".csv" class="d-none" disabled="@isImporting" />
                </label>
            </div>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(importSuccessMessage))
{
    <div class="alert alert-success" role="status">@importSuccessMessage</div>
}

@if (!string.IsNullOrWhiteSpace(importErrorMessage))
{
    <div class="alert alert-warning" role="alert">
        <p class="mb-1">@importErrorMessage</p>
        @if (importErrors.Count > 0)
        {
            <ul class="mb-0">
                @foreach (var detail in importErrors)
                {
                    <li>@detail</li>
                }
            </ul>
        }
    </div>
}

@if (isLoading)
{
    <p><em>Carregando...</em></p>
}
else if (players.Count == 0)
{
    <p>Nenhum jogador encontrado.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Posição</th>
                    <th>Overall</th>
                    <th>Idade</th>
                    <th>Status</th>
                    <th>Time</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var player in players)
                {
                    <tr>
                        <td>@player.Name</td>
                        <td>@player.PositionName</td>
                        <td>@player.Overall</td>
                        <td>@(player.Age?.ToString() ?? "-")</td>
                        <td>@player.Status</td>
                        <td>@(string.IsNullOrWhiteSpace(player.TeamName) ? "-" : player.TeamName)</td>
                        <td class="text-end">
                            <button class="btn btn-link" @onclick="() => ViewDetails(player.PlayerId)">Detalhes</button>
                            @if (AdminAuth.IsAuthenticated)
                            {
                                <button class="btn btn-link" @onclick="() => EditPlayer(player.PlayerId)">Editar</button>
                                <button class="btn btn-link text-danger" @onclick="() => ConfirmDelete(player.PlayerId)">Excluir</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Paginação de jogadores">
        <ul class="pagination">
            <li class="page-item @(currentPage == 1 ? "disabled" : string.Empty)">
                <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" disabled="@(currentPage == 1)">Anterior</button>
            </li>
            @for (var page = 1; page <= totalPages; page++)
            {
                <li class="page-item @(page == currentPage ? "active" : string.Empty)">
                    <button class="page-link" @onclick="() => ChangePage(page)">@(page)</button>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : string.Empty)">
                <button class="page-link" @onclick="() => ChangePage(currentPage + 1)" disabled="@(currentPage == totalPages)">Próximo</button>
            </li>
        </ul>
    </nav>
}

@code {
    private const int PageSize = 10;
    private readonly List<PlayerListItemDto> players = new();
    private readonly List<Position> positions = new();
    private int currentPage = 1;
    private int totalPages = 1;
    private string? search;
    private string? errorMessage;
    private bool isLoading = true;
    private string? selectedPositionId;
    private bool onlyAvailable;
    private bool authInitialized;
    private bool isImporting;
    private string importInputKey = Guid.NewGuid().ToString();
    private string? importSuccessMessage;
    private string? importErrorMessage;
    private readonly List<string> importErrors = new();

    protected override void OnInitialized()
    {
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPositionsAsync();
        await LoadPlayersAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AdminAuth.EnsureInitializedAsync();
        authInitialized = true;
        StateHasChanged();
    }

    private async Task LoadPositionsAsync()
    {
        try
        {
            positions.Clear();
            var items = await PositionService.GetAllAsync();
            positions.AddRange(items);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task OnSearchAsync()
    {
        currentPage = 1;
        await LoadPlayersAsync();
    }

    private async Task OnFilterChanged(ChangeEventArgs args)
    {
        selectedPositionId = args.Value?.ToString();
        currentPage = 1;
        await LoadPlayersAsync();
    }

    private async Task OnOnlyAvailableChanged(ChangeEventArgs args)
    {
        if (args.Value is bool boolean)
        {
            onlyAvailable = boolean;
        }
        else if (bool.TryParse(args.Value?.ToString(), out var parsed))
        {
            onlyAvailable = parsed;
        }
        else
        {
            onlyAvailable = false;
        }
        currentPage = 1;
        await LoadPlayersAsync();
    }

    private async Task OnCsvSelected(InputFileChangeEventArgs args)
    {
        importSuccessMessage = null;
        importErrorMessage = null;
        importErrors.Clear();

        var file = args.File;

        if (file is null)
        {
            importInputKey = Guid.NewGuid().ToString();
            return;
        }

        if (!AdminAuth.IsAuthenticated)
        {
            importErrorMessage = "Entre como administrador para importar jogadores.";
            importInputKey = Guid.NewGuid().ToString();
            return;
        }

        isImporting = true;

        try
        {
            var result = await PlayersApiClient.ImportAsync(file);

            if (result.Imported > 0)
            {
                importSuccessMessage = result.Imported == 1
                    ? "1 jogador importado com sucesso."
                    : $"{result.Imported} jogadores importados com sucesso.";
            }
            else
            {
                importSuccessMessage = "Nenhum jogador foi importado.";
            }

            if (result.Errors.Count > 0)
            {
                importErrorMessage = "Algumas linhas não puderam ser importadas:";
                importErrors.AddRange(result.Errors);
            }

            await LoadPlayersAsync();
        }
        catch (Exception ex)
        {
            importErrorMessage = $"Falha ao importar jogadores: {ex.Message}";
        }
        finally
        {
            isImporting = false;
            importInputKey = Guid.NewGuid().ToString();
            StateHasChanged();
        }
    }

    private async Task LoadPlayersAsync()
    {
        isLoading = true;
        errorMessage = null;
        players.Clear();

        try
        {
            short? positionId = null;
            if (short.TryParse(selectedPositionId, out var parsed))
            {
                positionId = parsed;
            }

            var result = await PlayersApiClient.GetAsync(search, positionId, onlyAvailable, currentPage, PageSize);
            players.AddRange(result.Items);
            totalPages = Math.Max(1, (int)Math.Ceiling(result.Total / (double)PageSize));
            if (currentPage > totalPages)
            {
                currentPage = totalPages;
                await LoadPlayersAsync();
                return;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page == currentPage || page > totalPages)
        {
            return;
        }

        currentPage = page;
        await LoadPlayersAsync();
    }

    private void CreatePlayer()
    {
        if (!AdminAuth.IsAuthenticated)
        {
            errorMessage = "Entre como administrador para adicionar jogadores.";
            return;
        }

        Navigation.NavigateTo("/players/edit");
    }

    private void EditPlayer(int id)
    {
        if (!AdminAuth.IsAuthenticated)
        {
            errorMessage = "Entre como administrador para editar jogadores.";
            return;
        }

        Navigation.NavigateTo($"/players/edit/{id}");
    }

    private void ViewDetails(int id) => Navigation.NavigateTo($"/players/details/{id}");

    private async Task ConfirmDelete(int id)
    {
        if (!AdminAuth.IsAuthenticated)
        {
            errorMessage = "Entre como administrador para excluir jogadores.";
            return;
        }

        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Tem certeza de que deseja excluir este jogador?"))
        {
            return;
        }

        try
        {
            await PlayersApiClient.DeleteAsync(id);
            await LoadPlayersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void DownloadExport(string format)
    {
        var path = format switch
        {
            "csv" => "api/players/export/csv",
            "json" => "api/players/export/json",
            "xlsx" => "api/players/export/xlsx",
            _ => "api/players/export/csv"
        };

        Navigation.NavigateTo(path, forceLoad: true);
    }

    private void OnAuthenticationChanged()
    {
        if (!authInitialized)
        {
            return;
        }

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
    }
}
