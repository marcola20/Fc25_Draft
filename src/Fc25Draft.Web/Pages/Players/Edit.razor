@page "/players/edit"
@page "/players/edit/{Id:int}"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Entities
@inject PlayersApiClient PlayersApiClient
@inject IPositionService PositionService
@inject NavigationManager Navigation
@inject AdminAuthService AdminAuth

@implements IDisposable

<h3>@Title</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <p><em>Carregando...</em></p>
}
else if (!AdminAuth.IsAdmin)
{
    <div class="alert alert-warning" role="alert">Apenas administradores podem cadastrar ou editar jogadores.</div>
    <button class="btn btn-secondary" @onclick="Cancel">Voltar</button>
}
else
{
    <EditForm EditContext="editContext" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label" for="playerName">Nome</label>
            <InputText id="playerName" class="form-control" @bind-Value="model.Name" />
            <ValidationMessage For="() => model.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="playerAge">Idade</label>
            <InputNumber id="playerAge" class="form-control" @bind-Value="model.Age" />
            <ValidationMessage For="() => model.Age" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="playerOverall">Overall</label>
            <InputNumber id="playerOverall" class="form-control" @bind-Value="model.Overall" />
            <ValidationMessage For="() => model.Overall" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="playerPosition">Posição</label>
            <InputSelect id="playerPosition" class="form-select" @bind-Value="model.PositionId">
                <option value="">Selecione uma posição</option>
                @foreach (var position in positions)
                {
                    <option value="@position.PositionId">@position.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="() => model.PositionId" />
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit" disabled="@isSaving">Salvar</button>
            <button class="btn btn-secondary" type="button" @onclick="Cancel">Cancelar</button>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private readonly PlayerFormModel model = new();
    private EditContext? editContext;
    private readonly List<Position> positions = new();
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSaving;
    private bool authInitialized;

    private string Title => Id.HasValue ? "Editar Jogador" : "Novo Jogador";

    protected override void OnInitialized()
    {
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(model);

        try
        {
            var items = await PositionService.GetAllAsync();
            positions.AddRange(items);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        if (Id.HasValue)
        {
            await LoadPlayerAsync(Id.Value);
        }

        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AdminAuth.EnsureInitializedAsync();
        authInitialized = true;
        StateHasChanged();
    }

    private async Task LoadPlayerAsync(int id)
    {
        try
        {
            var details = await PlayersApiClient.GetByIdAsync(id);
            if (details is null)
            {
                errorMessage = "Jogador não encontrado.";
                return;
            }

            model.Name = details.Name;
            model.Age = details.Age;
            model.Overall = details.Overall;
            model.PositionId = details.PositionId;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (editContext is null)
        {
            return;
        }

        if (!AdminAuth.IsAdmin)
        {
            errorMessage = "Entre como administrador para salvar alterações.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            if (Id.HasValue)
            {
                await PlayersApiClient.UpdateAsync(Id.Value, new PlayerUpdateDto(model.Name!, model.Age, model.Overall!.Value, model.PositionId!.Value));
            }
            else
            {
                await PlayersApiClient.CreateAsync(new PlayerCreateDto(model.Name!, model.Age, model.Overall!.Value, model.PositionId!.Value));
            }

            Navigation.NavigateTo("/players");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel() => Navigation.NavigateTo("/players");

    private void OnAuthenticationChanged()
    {
        if (!authInitialized)
        {
            return;
        }

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
    }

    private sealed class PlayerFormModel
    {
        [Required]
        [StringLength(80, MinimumLength = 2)]
        public string? Name { get; set; }

        [Range(14, 55, ErrorMessage = "A idade deve estar entre 14 e 55 anos.")]
        public int? Age { get; set; }

        [Required(ErrorMessage = "O overall é obrigatório.")]
        [Range(0, 99)]
        public int? Overall { get; set; }

        [Required(ErrorMessage = "A posição é obrigatória.")]
        public short? PositionId { get; set; }
    }
}
