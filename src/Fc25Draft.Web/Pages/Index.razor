@page "/"
@page "/home"
@inject AdminAuthService AdminAuth
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService

@implements IDisposable

<PageHeader Title="Central CBFV"
            Subtitle="Escolha uma das áreas para navegar pela plataforma." />

@if (!authReady)
{
    <div class="alert alert-info" role="status">
        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
        Carregando preferências de acesso...
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-12 col-md-6 col-xl-3">
            <DashboardCard Title="Times"
                           Description="Gerencie elencos e acompanhe a composição das equipes."
                           Href="/times/elencos"
                           Icon="oi oi-people" />
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <DashboardCard Title="Draft"
                           Description="Controle as escolhas e visualize informações do draft em andamento."
                           Href="/draft/controle"
                           Icon="oi oi-flag" />
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <DashboardCard Title="Mercado de Transferências"
                           Description="Acompanhe negociações, histórico e itens disponíveis no mercado."
                           Href="/mercado"
                           Icon="oi oi-cart" />
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <DashboardCard Title="Regulamento"
                           Description="Consulte as regras oficiais de transferências, janelas e contratos da liga."
                           Href="/regulamento"
                           Icon="oi oi-document" />
        </div>
        @if (AdminAuth.IsAdmin)
        {
            <div class="col-12 col-md-6 col-xl-3">
                <DashboardCard Title="Administração"
                               Description="Acesse configurações avançadas, ciclos e geração de itens."
                               Href="/admin/ciclos"
                               Icon="oi oi-cog" />
            </div>
        }
    </div>
}

@code {
    private bool authReady;

    protected override void OnInitialized()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/home"));
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AdminAuth.EnsureInitializedAsync();
        authReady = true;
        StateHasChanged();
    }

    private void OnAuthenticationChanged()
    {
        InvokeAsync(async () =>
        {
            await AdminAuth.EnsureInitializedAsync();
            authReady = true;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
    }
}
