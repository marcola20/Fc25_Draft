@page "/"
@page "/home"
@inject AdminAuthService AdminAuth
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService
@inject ILigaPublicService LigaService
@inject IDiretoriaService DiretoriaSvc
@inject IAposentadoriaService AposentadoriaSvc
@inject IPremiosService PremiosSvc
@inject ITreinadorService TreinadorNoticiasSvc
@inject IParticipacaoService ParticipacaoSvc
@inject ITreinoService TreinoSvc
@inject IPicksDoDraftService PicksSvc

@implements IDisposable

<DestaquesInicio Dados="@_destaques" />

<PlantaoInicio Noticias="@_noticias" />

<section aria-labelledby="atalhos-titulo">
    <div class="secao-titulo">
        <h2 id="atalhos-titulo">Atalhos</h2>
    </div>
    <nav class="atalhos">
        @foreach (var atalho in Atalhos)
        {
            <a class="atalho" href="@atalho.Href">
                <Icone Nome="@atalho.Icone" Tamanho="18" Classe="atalho-icone" />
                <span class="atalho-texto">
                    <span class="atalho-titulo">@atalho.Titulo</span>
                    <span class="atalho-descricao">@atalho.Descricao</span>
                </span>
            </a>
        }
        @* O de administração só depois de saber quem entrou, para não piscar. *@
        @if (authReady && AdminAuth.IsAdmin)
        {
            <a class="atalho" href="/admin/ciclos">
                <Icone Nome="settings" Tamanho="18" Classe="atalho-icone" />
                <span class="atalho-texto">
                    <span class="atalho-titulo">Administração</span>
                    <span class="atalho-descricao">Ciclos, configurações e geração de itens</span>
                </span>
            </a>
        }
    </nav>
</section>

@code {
    private sealed record Atalho(string Titulo, string Descricao, string Href, string Icone);

    private static readonly Atalho[] Atalhos =
    [
        new("Times", "Elencos e composição de cada clube", "/times/elencos", "users"),
        new("Draft", "Escolhas e informações do draft em andamento", "/draft/controle", "flag"),
        new("Mercado de Transferências", "Leilões, negociações e histórico", "/mercado", "gavel"),
        new("Regulamento", "Regras de transferências, janelas e contratos", "/regulamento", "file-text"),
        new("Manual do Técnico", "Onde escalar o time, entrar no draft e negociar", "/manual", "book-open"),
    ];

    private bool authReady;
    private const int NoticiasNaPaginaInicial = 6;

    private DestaquesDto? _destaques;
    private IReadOnlyList<Fc25Draft.Core.Utilities.PlantaoNoticiaDto> _noticias = Array.Empty<Fc25Draft.Core.Utilities.PlantaoNoticiaDto>();

    // Uma consulta de cada vez: no Blazor Server a página toda divide a mesma conexão com o banco.
    // Destaques e Plantão são complementares: se um falhar, a página segue com o resto.
    protected override async Task OnInitializedAsync()
    {
        try { _destaques = await LigaService.GetDestaquesAsync(CancellationToken.None); } catch { _destaques = null; }
        try
        {
            var noticias = (await LigaService.GetPlantaoAsync(CancellationToken.None)).ToList();
            try { noticias.AddRange(await DiretoriaSvc.GetNoticiasAsync(CancellationToken.None)); } catch { }
            try { noticias.AddRange(await AposentadoriaSvc.GetNoticiasAsync(CancellationToken.None)); } catch { }
            try { noticias.AddRange(await PremiosSvc.GetNoticiasAsync(CancellationToken.None)); } catch { }
            try { noticias.AddRange(await TreinadorNoticiasSvc.GetNoticiasAsync(CancellationToken.None)); } catch { }
            try { noticias.AddRange(await ParticipacaoSvc.GetNoticiasAsync(CancellationToken.None)); } catch { }
            try { noticias.AddRange(await TreinoSvc.GetNoticiasAsync(CancellationToken.None)); } catch { }
            try { noticias.AddRange(await PicksSvc.GetNoticiasAsync(CancellationToken.None)); } catch { }
            _noticias = noticias.OrderByDescending(n => n.Data).Take(NoticiasNaPaginaInicial).ToList();
        }
        catch { }
    }

    protected override void OnInitialized()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/home"));
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AdminAuth.EnsureInitializedAsync();
        authReady = true;
        StateHasChanged();
    }

    private void OnAuthenticationChanged()
    {
        InvokeAsync(async () =>
        {
            await AdminAuth.EnsureInitializedAsync();
            authReady = true;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
    }
}
