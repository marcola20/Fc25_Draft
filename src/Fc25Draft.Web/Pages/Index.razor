@page "/"
@inject ApiClientFactory ApiClientFactory
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AdminAuthService AdminAuth

@implements IDisposable

<PageTitle>Início</PageTitle>

<h1 class="mb-3">Central do Draft FC25</h1>
<p class="text-muted">Gerencie equipes, jogadores e reinicie o draft quando necessário.</p>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="mb-4 d-flex flex-wrap gap-2">
    <button class="btn btn-primary" @onclick="GenerateDraftAsync" disabled="@(!AdminAuth.IsAuthenticated || isGenerating)">
        @if (isGenerating)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            <span>Gerando...</span>
        }
        else
        {
            <span>Gerar Draft</span>
        }
    </button>

    <button class="btn btn-danger" @onclick="ResetDraftAsync" disabled="@(!AdminAuth.IsAuthenticated || isResetting)">
        @if (isResetting)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            <span>Resetando...</span>
        }
        else
        {
            <span>Resetar Draft</span>
        }
    </button>
</div>

<section class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Equipes</h5>
                <p class="card-text">Cadastre, edite e consulte as equipes participantes do draft.</p>
                <a class="btn btn-outline-primary" href="teams">Gerenciar Equipes</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Jogadores</h5>
                <p class="card-text">Mantenha a base de atletas atualizada para as próximas escolhas.</p>
                <a class="btn btn-outline-primary" href="players">Gerenciar Jogadores</a>
            </div>
        </div>
    </div>
</section>

@code {
    private bool isGenerating;
    private bool isResetting;
    private string? successMessage;
    private string? errorMessage;
    private bool authInitialized;

    protected override void OnInitialized()
    {
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AdminAuth.EnsureInitializedAsync();
        authInitialized = true;
        StateHasChanged();
    }

    private async Task GenerateDraftAsync()
    {
        if (isGenerating)
        {
            return;
        }

        successMessage = null;
        errorMessage = null;

        string? roundsInput;

        try
        {
            roundsInput = await JSRuntime.InvokeAsync<string?>("prompt", "Quantas rodadas o draft deve ter?", "19");
        }
        catch (JSException ex)
        {
            errorMessage = $"Não foi possível solicitar o número de rodadas: {ex.Message}";
            return;
        }

        if (string.IsNullOrWhiteSpace(roundsInput))
        {
            return;
        }

        if (!int.TryParse(roundsInput, out var totalRounds))
        {
            errorMessage = "Informe um número válido de rodadas.";
            return;
        }

        if (totalRounds is < 1 or > 50)
        {
            errorMessage = "O número de rodadas deve estar entre 1 e 50.";
            return;
        }

        isGenerating = true;

        try
        {
            if (!AdminAuth.IsAuthenticated)
            {
                errorMessage = "Entre como administrador para gerar o draft.";
                return;
            }

            var client = await ApiClientFactory.CreateAsync(includeAdminToken: true);
            var uri = new Uri(new Uri(Navigation.BaseUri), "api/admin/draft/generate");
            var response = await client.PostAsJsonAsync(uri, new GenerateDraftRequestDto(totalRounds));

            if (response.IsSuccessStatusCode)
            {
                DraftStateDto? state = null;
                try
                {
                    state = await response.Content.ReadFromJsonAsync<DraftStateDto>();
                }
                catch
                {
                    // Ignored - fallback to generic success message.
                }

                if (state is not null && state.HasDraft)
                {
                    var draftName = string.IsNullOrWhiteSpace(state.DraftName) ? "Draft" : state.DraftName;
                    successMessage = $"{draftName} gerado com {state.TotalRounds} rodadas!";
                }
                else
                {
                    successMessage = $"Draft gerado com {totalRounds} rodadas!";
                }
            }
            else
            {
                ApiErrorResponse? error = null;
                try
                {
                    error = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
                }
                catch
                {
                    // ignore, fallback message below
                }

                errorMessage = error?.Message ?? $"Erro ao gerar o draft: {response.StatusCode}.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao gerar o draft: {ex.Message}";
        }
        finally
        {
            isGenerating = false;
        }
    }

    private async Task ResetDraftAsync()
    {
        if (isResetting)
        {
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Tem certeza que deseja resetar o draft?");
        if (!confirmed)
        {
            return;
        }

        isResetting = true;
        successMessage = null;
        errorMessage = null;

        try
        {
            if (!AdminAuth.IsAuthenticated)
            {
                errorMessage = "Entre como administrador para resetar o draft.";
                return;
            }

            var client = await ApiClientFactory.CreateAsync(includeAdminToken: true);
            var response = await client.PostAsync(new Uri(new Uri(Navigation.BaseUri), "api/admin/draft/reset"), content: null);
            response.EnsureSuccessStatusCode();
            successMessage = "Draft reiniciado com sucesso!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao resetar o draft: {ex.Message}";
        }
        finally
        {
            isResetting = false;
        }
    }

    private sealed record ApiErrorResponse(string? Message);

    private void OnAuthenticationChanged()
    {
        if (!authInitialized)
        {
            return;
        }

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
    }
}
