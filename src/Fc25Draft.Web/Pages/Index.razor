@page "/"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Início</PageTitle>

<h1 class="mb-3">Central do Draft FC25</h1>
<p class="text-muted">Gerencie equipes, jogadores e reinicie o draft quando necessário.</p>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="mb-4">
    <button class="btn btn-danger" @onclick="ResetDraftAsync" disabled="@isResetting">
        @if (isResetting)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            <span>Resetando...</span>
        }
        else
        {
            <span>Resetar Draft</span>
        }
    </button>
</div>

<section class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Equipes</h5>
                <p class="card-text">Cadastre, edite e consulte as equipes participantes do draft.</p>
                <a class="btn btn-outline-primary" href="teams">Gerenciar Equipes</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Jogadores</h5>
                <p class="card-text">Mantenha a base de atletas atualizada para as próximas escolhas.</p>
                <a class="btn btn-outline-primary" href="players">Gerenciar Jogadores</a>
            </div>
        </div>
    </div>
</section>

@code {
    private bool isResetting;
    private string? successMessage;
    private string? errorMessage;

    private async Task ResetDraftAsync()
    {
        if (isResetting)
        {
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Tem certeza que deseja resetar o draft?");
        if (!confirmed)
        {
            return;
        }

        isResetting = true;
        successMessage = null;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient();
            var response = await client.PostAsync(new Uri(new Uri(Navigation.BaseUri), "api/draft/reset"), content: null);
            response.EnsureSuccessStatusCode();
            successMessage = "Draft reiniciado com sucesso!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao resetar o draft: {ex.Message}";
        }
        finally
        {
            isResetting = false;
        }
    }
}
