@page
@model Fc25Draft.Web.Pages.ErrorModel

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Erro</title>
    <link href="~/css/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <div class="main">
        <div class="content px-4">
            <h1 class="text-danger">Ops, algo deu errado.</h1>
            <h2 class="text-danger">Ocorreu um erro ao processar sua requisição.</h2>

            @if (Model.ShowRequestId)
            {
                <p>
                    <strong>ID da requisição:</strong> <code>@Model.RequestId</code>
                </p>
            }

            <h3>Ambiente de desenvolvimento</h3>
            <p>
                Ao utilizar o ambiente <strong>Development</strong> são exibidos detalhes completos do erro.
            </p>
            <p>
                <strong>Não habilite o ambiente Development em produção.</strong>
                Isso pode revelar informações sensíveis para usuários finais.
                Para depuração local, defina a variável de ambiente <strong>ASPNETCORE_ENVIRONMENT</strong> como <strong>Development</strong>
                e reinicie a aplicação.
            </p>
        </div>
    </div>
</body>
</html>
