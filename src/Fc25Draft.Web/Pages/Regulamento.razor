@page "/regulamento"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Interfaces
@inject IRegulamentoService RegulamentoSvc
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService

<PageTitle>Regulamento</PageTitle>

<PageHeader Title="Regulamento Oficial" />

<div class="regulamento-page">

    @if (_carregando)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    }
    else if (_regulamento is null)
    {
        <div class="alert alert-info">O regulamento desta temporada ainda não foi cadastrado.</div>
    }
    else
    {
        <div class="reg-temporada-bar">
            <div class="reg-temporada-atual">
                <span class="reg-temporada-badge">Temporada @_regulamento.Temporada</span>
                <span class="reg-temporada-titulo">@_regulamento.Titulo</span>
                @if (_regulamentos.Count > 0 && _regulamento.Temporada != _regulamentos[0].Temporada)
                {
                    <span class="etiqueta">Regulamento antigo</span>
                }
                else
                {
                    <span class="etiqueta sucesso">Em vigor</span>
                }
            </div>
            @if (_regulamentos.Count > 1)
            {
                <select class="form-select form-select-sm w-auto" @onchange="OnRegulamentoChanged">
                    @foreach (var r in _regulamentos)
                    {
                        <option value="@r.RegulamentoId" selected="@(r.RegulamentoId == _regulamento.RegulamentoId)">@r.Titulo</option>
                    }
                </select>
            }
        </div>

        @((MarkupString)_regulamento.Conteudo)
    }

</div>

@code {
    private bool _carregando = true;
    private IReadOnlyList<RegulamentoDto> _regulamentos = Array.Empty<RegulamentoDto>();
    private RegulamentoDto? _regulamento;

    protected override void OnInitialized()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/regulamento"));
    }

    protected override async Task OnInitializedAsync()
    {
        // Cada temporada tem o seu regulamento: abre no mais recente e dá para ver os antigos.
        _regulamentos = await RegulamentoSvc.ListAsync(CancellationToken.None);
        _regulamento = _regulamentos.FirstOrDefault();
        _carregando = false;
    }

    private void OnRegulamentoChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
            _regulamento = _regulamentos.FirstOrDefault(r => r.RegulamentoId == id);
    }
}

<style>
    .reg-temporada-bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--bs-border-color);
    }

    .reg-temporada-atual {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .reg-temporada-badge {
        font-weight: 500;
        font-size: 1.125rem;
        color: var(--bs-emphasis-color);
    }

    .reg-temporada-titulo {
        font-size: 0.875rem;
        color: var(--bs-secondary-color);
    }

    .reg-temporada-bar select { margin-left: auto; }
</style>
<style>
    /* Páginas de leitura (manual e regulamento): coluna de texto, seções numeradas, cartões neutros. */
    .regulamento-page {
        max-width: 860px;
        padding-bottom: 3rem;
    }

    .reg-section {
        margin-bottom: 2rem;
    }

    .reg-section-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .reg-section-icon {
        display: none;
    }

    .reg-section-header h3 {
        font-size: 1.125rem;
        font-weight: 500;
        margin: 0;
        color: var(--bs-emphasis-color);
    }

    .reg-card {
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: 0.75rem;
        padding: 1.25rem;
    }

    .reg-card-title {
        font-size: 0.9375rem;
        font-weight: 500;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--bs-emphasis-color);
    }

    .reg-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.375rem;
        height: 1.375rem;
        background: var(--bs-tertiary-bg);
        border: 1px solid var(--bs-border-color);
        color: var(--bs-secondary-color);
        border-radius: 0.375rem;
        font: 500 0.6875rem/1 var(--bs-font-monospace);
        flex-shrink: 0;
    }

    .reg-desc {
        font-size: 0.875rem;
        color: var(--bs-secondary-color);
        margin-bottom: 0.625rem;
        line-height: 1.6;
    }

    .reg-desc strong {
        font-weight: 500;
        color: var(--bs-body-color);
    }

    .reg-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }

    /* Texto corrido: o negrito e o resto da frase na mesma linha; o ponto fica pendurado à esquerda. */
    .reg-list li {
        position: relative;
        padding-left: 1rem;
        font-size: 0.875rem;
        line-height: 1.6;
        color: var(--bs-body-color);
    }

    .reg-list li strong {
        font-weight: 500;
    }

    .reg-bullet {
        position: absolute;
        left: 0;
        color: var(--bs-tertiary-color);
    }

    .reg-section-desc {
        color: var(--bs-secondary-color);
        margin-bottom: 1rem;
        font-size: 0.875rem;
    }

    .reg-card {
        margin-bottom: 0.75rem;
    }

    /* Avisos do regulamento: traço amarelo à esquerda, sem fundo. */
    .reg-card-warning {
        border-left: 3px solid var(--zona-playoff-rebaixamento);
    }

    .reg-card-muted {
        background: var(--bs-tertiary-bg);
    }

    .reg-card-final {
        border-left: 3px solid var(--cbfv-vitoria);
    }

    .reg-icon-inline {
        display: none;
    }

    .reg-badge-warning {
        border-color: rgba(201, 148, 40, 0.45);
        color: var(--zona-playoff-rebaixamento);
    }

    .reg-badge-muted {
        color: var(--bs-tertiary-color);
    }

    .reg-divider {
        border-color: var(--bs-border-color);
        margin: 2rem 0;
        opacity: 1;
    }

    /* Quadros de contrato: cabeçalho neutro com a cor só num traço em cima. */
    .reg-contract {
        border: 1px solid var(--bs-border-color);
        border-radius: 0.75rem;
        overflow: hidden;
        height: 100%;
    }

    .reg-contract-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        font-weight: 500;
        font-size: 0.9375rem;
        color: var(--bs-emphasis-color);
        background: var(--bs-tertiary-bg);
        border-bottom: 1px solid var(--bs-border-color);
    }

    .reg-contract-header-blue { box-shadow: inset 0 2px 0 var(--cbfv-acento); }
    .reg-contract-header-green { box-shadow: inset 0 2px 0 var(--cbfv-vitoria); }
    .reg-contract-header-orange { box-shadow: inset 0 2px 0 var(--zona-playoff-rebaixamento); }

    .reg-contract-body {
        padding: 1rem;
        background: var(--bs-body-bg);
    }

    .reg-contract-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--bs-border-color);
        font-size: 0.875rem;
    }

    .reg-contract-row:last-child {
        border-bottom: none;
    }

    .reg-contract-row-highlight {
        background: var(--bs-tertiary-bg);
        border-radius: 0.375rem;
        padding-left: 0.5rem;
        padding-right: 0.5rem;
        border-bottom: none !important;
    }

    .reg-contract-label,
    .reg-contract-team-label {
        font-size: 0.75rem;
        font-weight: 400;
        color: var(--bs-tertiary-color);
    }

    .reg-contract-team-label {
        margin-bottom: 0.25rem;
    }

    .reg-contract-value {
        font-weight: 500;
        font-size: 0.875rem;
        font-variant-numeric: tabular-nums;
        color: var(--bs-emphasis-color);
    }

    .reg-contract-team-block {
        margin-bottom: 0.5rem;
    }

    .reg-contract-items {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .reg-contract-items li {
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.125rem 0;
        color: var(--bs-emphasis-color);
    }

    .reg-contract-swap-icon {
        text-align: center;
        font-size: 1.25rem;
        color: var(--bs-tertiary-color);
        margin: 0.375rem 0;
        line-height: 1;
    }

    /* ── Cláusulas contratuais ── */
    .clausulas-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    @@media (max-width: 768px) {
        .clausulas-grid {
            grid-template-columns: 1fr;
        }
    }

    .clausula-card {
        border: 1px solid var(--bs-border-color);
        border-radius: 0.75rem;
        overflow: hidden;
    }

    .clausula-card-wide {
        grid-column: span 2;
    }

    @@media (max-width: 768px) {
        .clausula-card-wide {
            grid-column: span 1;
        }
    }

    .clausula-card-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        font-weight: 500;
        font-size: 0.9375rem;
        color: var(--bs-emphasis-color);
        background: var(--bs-tertiary-bg);
        border-bottom: 1px solid var(--bs-border-color);
    }

    .clausula-icon {
        display: none;
    }

    .clausula-header-orange { box-shadow: inset 0 2px 0 var(--zona-playoff-rebaixamento); }
    .clausula-header-blue   { box-shadow: inset 0 2px 0 var(--bs-secondary-color); }
    .clausula-header-green  { box-shadow: inset 0 2px 0 var(--cbfv-vitoria); }
    .clausula-header-gold   { box-shadow: inset 0 2px 0 var(--cbfv-acento); }

    .clausula-card-body {
        padding: 0.875rem 1rem;
        background: var(--bs-body-bg);
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
    }

    .clausula-body-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.625rem;
    }

    @@media (max-width: 600px) {
        .clausula-body-grid {
            grid-template-columns: 1fr;
        }
    }

    .clausula-item {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        font-size: 0.875rem;
        line-height: 1.55;
    }

    /* Etiqueta do tipo de cláusula, no molde da .etiqueta do site. */
    .clausula-tag {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        height: 1.25rem;
        padding: 0 0.375rem;
        border: 1px solid var(--bs-border-color);
        border-radius: 0.375rem;
        font-size: 0.6875rem;
        font-weight: 500;
        margin-top: 0.125rem;
        white-space: nowrap;
        color: var(--bs-secondary-color);
    }

    .tag-orange { border-color: rgba(201, 148, 40, 0.45); color: var(--zona-playoff-rebaixamento); }
    .tag-blue   { color: var(--bs-body-color); }
    .tag-green  { border-color: rgba(47, 158, 106, 0.45); color: var(--cbfv-vitoria); }
    .tag-gold   { border-color: rgba(201, 148, 40, 0.45); color: var(--cbfv-acento-texto); }

    .clausula-text {
        color: var(--bs-body-color);
    }

    /* Regras gerais */
    .clausulas-rules {
        background: var(--bs-tertiary-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: 0.75rem;
        padding: 1rem 1.25rem;
    }

    .clausulas-rules-title {
        font-weight: 500;
        font-size: 0.9375rem;
        margin-bottom: 0.625rem;
        color: var(--bs-emphasis-color);
    }
</style>
