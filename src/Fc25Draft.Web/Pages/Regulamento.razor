@page "/regulamento"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Interfaces
@inject IRegulamentoService RegulamentoSvc
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService

<PageTitle>Regulamento</PageTitle>

<PageHeader Title="Regulamento Oficial" />

<div class="regulamento-page">

    @if (_carregando)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    }
    else if (_regulamento is null)
    {
        <div class="alert alert-info">O regulamento desta temporada ainda não foi cadastrado.</div>
    }
    else
    {
        <div class="reg-temporada-bar">
            <div class="reg-temporada-atual">
                <span class="reg-temporada-badge">Temporada @_regulamento.Temporada</span>
                <span class="reg-temporada-titulo">@_regulamento.Titulo</span>
                @if (_regulamentos.Count > 0 && _regulamento.Temporada != _regulamentos[0].Temporada)
                {
                    <span class="badge bg-secondary">Regulamento antigo</span>
                }
                else
                {
                    <span class="badge bg-success">Em vigor</span>
                }
            </div>
            @if (_regulamentos.Count > 1)
            {
                <select class="form-select form-select-sm w-auto" @onchange="OnRegulamentoChanged">
                    @foreach (var r in _regulamentos)
                    {
                        <option value="@r.RegulamentoId" selected="@(r.RegulamentoId == _regulamento.RegulamentoId)">@r.Titulo</option>
                    }
                </select>
            }
        </div>

        @((MarkupString)_regulamento.Conteudo)
    }

</div>

@code {
    private bool _carregando = true;
    private IReadOnlyList<RegulamentoDto> _regulamentos = Array.Empty<RegulamentoDto>();
    private RegulamentoDto? _regulamento;

    protected override void OnInitialized()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/regulamento"));
    }

    protected override async Task OnInitializedAsync()
    {
        // Cada temporada tem o seu regulamento: abre no mais recente e dá para ver os antigos.
        _regulamentos = await RegulamentoSvc.ListAsync(CancellationToken.None);
        _regulamento = _regulamentos.FirstOrDefault();
        _carregando = false;
    }

    private void OnRegulamentoChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
            _regulamento = _regulamentos.FirstOrDefault(r => r.RegulamentoId == id);
    }
}

<style>
    .reg-temporada-bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--bs-border-color, #dee2e6);
    }

    .reg-temporada-atual {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .reg-temporada-badge {
        font-weight: 800;
        font-size: 1.05rem;
        color: var(--bs-emphasis-color, #212529);
    }

    .reg-temporada-titulo {
        font-size: 0.9rem;
        color: var(--bs-secondary-color, #6c757d);
    }

    .reg-temporada-bar select { margin-left: auto; }
</style>
<style>
    .regulamento-page {
        max-width: 900px;
        margin: 0 auto;
        padding-bottom: 3rem;
    }

    .reg-section {
        margin-bottom: 2rem;
    }

    .reg-section-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1.25rem;
    }

    .reg-section-icon {
        font-size: 1.5rem;
        line-height: 1;
    }

    .reg-section-header h3 {
        font-size: 1.35rem;
        font-weight: 700;
        margin: 0;
        color: var(--bs-emphasis-color, #212529);
        letter-spacing: -0.01em;
    }

    .reg-section-desc {
        color: var(--bs-secondary-color, #6c757d);
        margin-bottom: 1.5rem;
        font-size: 0.95rem;
    }

    .reg-card {
        background: var(--bs-body-bg, #fff);
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-left: 4px solid var(--bs-primary, #0d6efd);
        border-radius: 0.5rem;
        padding: 1.1rem 1.25rem;
        margin-bottom: 1rem;
    }

    .reg-card-warning {
        border-left-color: var(--bs-warning, #ffc107);
    }

    .reg-card-muted {
        border-left-color: var(--bs-secondary, #6c757d);
    }

    .reg-card-final {
        border-left-color: var(--bs-success, #198754);
        background: color-mix(in srgb, var(--bs-success, #198754) 6%, var(--bs-body-bg, #fff));
    }

    .reg-card-title {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0.6rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--bs-emphasis-color, #212529);
    }

    .reg-icon-inline {
        font-size: 1rem;
        margin-left: auto;
    }

    .reg-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.5rem;
        height: 1.5rem;
        background: var(--bs-primary, #0d6efd);
        color: #fff;
        border-radius: 50%;
        font-size: 0.75rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .reg-badge-warning {
        background: var(--bs-warning, #ffc107);
        color: #000;
    }

    .reg-badge-muted {
        background: var(--bs-secondary, #6c757d);
    }

    .reg-desc {
        font-size: 0.9rem;
        color: var(--bs-secondary-color, #6c757d);
        margin-bottom: 0.5rem;
    }

    .reg-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .reg-list li {
        font-size: 0.92rem;
        line-height: 1.55;
        display: flex;
        gap: 0.5rem;
        align-items: flex-start;
    }

    .reg-bullet {
        color: var(--bs-primary, #0d6efd);
        font-weight: 700;
        flex-shrink: 0;
        margin-top: 0.05rem;
    }

    .reg-divider {
        border-color: var(--bs-border-color, #dee2e6);
        margin: 2rem 0;
        opacity: 0.5;
    }

    .reg-contract {
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.5rem;
        overflow: hidden;
        height: 100%;
    }

    .reg-contract-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.7rem 1rem;
        font-weight: 600;
        font-size: 0.95rem;
        color: #fff;
    }

    .reg-contract-header-blue {
        background: var(--bs-primary, #0d6efd);
    }

    .reg-contract-header-green {
        background: var(--bs-success, #198754);
    }

    .reg-contract-header-orange {
        background: #e07b00;
    }

    .reg-contract-body {
        padding: 1rem 1.1rem;
        background: var(--bs-body-bg, #fff);
    }

    .reg-contract-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.4rem 0;
        border-bottom: 1px solid var(--bs-border-color, #dee2e6);
        font-size: 0.88rem;
    }

    .reg-contract-row:last-child {
        border-bottom: none;
    }

    .reg-contract-row-highlight {
        background: color-mix(in srgb, var(--bs-primary, #0d6efd) 8%, transparent);
        border-radius: 0.3rem;
        padding-left: 0.4rem;
        padding-right: 0.4rem;
        border-bottom: none !important;
    }

    .reg-contract-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--bs-secondary-color, #6c757d);
    }

    .reg-contract-value {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--bs-emphasis-color, #212529);
    }

    .reg-contract-team-block {
        margin-bottom: 0.5rem;
    }

    .reg-contract-team-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--bs-secondary-color, #6c757d);
        margin-bottom: 0.25rem;
    }

    .reg-contract-items {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .reg-contract-items li {
        font-size: 0.9rem;
        font-weight: 500;
        padding: 0.15rem 0;
        color: var(--bs-emphasis-color, #212529);
    }

    .reg-contract-swap-icon {
        text-align: center;
        font-size: 1.4rem;
        color: var(--bs-secondary-color, #6c757d);
        margin: 0.4rem 0;
        line-height: 1;
    }

    /* ── Cláusulas Contratuais ── */
    .clausulas-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    @@media (max-width: 768px) {
        .clausulas-grid {
            grid-template-columns: 1fr;
        }
    }

    .clausula-card {
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.5rem;
        overflow: hidden;
    }

    .clausula-card-wide {
        grid-column: span 2;
    }

    @@media (max-width: 768px) {
        .clausula-card-wide {
            grid-column: span 1;
        }
    }

    .clausula-card-header {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.65rem 1rem;
        font-weight: 700;
        font-size: 0.9rem;
        color: #fff;
        letter-spacing: 0.01em;
    }

    .clausula-icon {
        font-size: 1.1rem;
    }

    .clausula-header-orange { background: #e07b00; }
    .clausula-header-blue   { background: var(--bs-primary, #0d6efd); }
    .clausula-header-green  { background: var(--bs-success, #198754); }
    .clausula-header-gold   { background: #a07800; }

    .clausula-card-body {
        padding: 0.75rem 1rem;
        background: var(--bs-body-bg, #fff);
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .clausula-body-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.6rem;
    }

    @@media (max-width: 600px) {
        .clausula-body-grid {
            grid-template-columns: 1fr;
        }
    }

    .clausula-item {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        font-size: 0.875rem;
        line-height: 1.5;
    }

    .clausula-tag {
        flex-shrink: 0;
        display: inline-block;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-top: 0.1rem;
        white-space: nowrap;
    }

    .tag-orange { background: rgba(224,123,0,0.15);  color: #c06800; }
    .tag-blue   { background: rgba(13,110,253,0.12); color: var(--bs-primary, #0d6efd); }
    .tag-green  { background: rgba(25,135,84,0.12);  color: var(--bs-success, #198754); }
    .tag-gold   { background: rgba(160,120,0,0.15);  color: #8a6400; }

    .clausula-text {
        color: var(--bs-body-color, #212529);
    }

    /* Regras gerais */
    .clausulas-rules {
        background: color-mix(in srgb, var(--bs-secondary, #6c757d) 7%, var(--bs-body-bg, #fff));
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.5rem;
        padding: 1rem 1.25rem;
    }

    .clausulas-rules-title {
        font-weight: 700;
        font-size: 0.95rem;
        margin-bottom: 0.6rem;
        color: var(--bs-emphasis-color, #212529);
    }
</style>
