@page "/teams/{TeamId:guid}/lineups"
@page "/times/{TeamId:guid}/escalacoes"
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Utilities
@using System.Globalization
@using Fc25Draft.Web.Models.Navigation
@inject LineupsApiClient LineupsApiClient
@inject TeamsApiClient TeamsApiClient
@inject ToastService Toasts
@inject LayoutState LayoutState
@inject NavigationManager Navigation
@inject ILogger<Fc25Draft.Web.Pages.Teams.Lineups> Logger
@inject IJSRuntime JSRuntime
@inject TeamAccessService TeamAccess

@implements IDisposable

<PageHeader Title="Escalações"
            Subtitle="@pageSubtitle" />

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2" role="status">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>Carregando escalações...</span>
    </div>
}
else if (!hasAccess)
{
    <div class="alert alert-warning" role="alert">
        @if (!string.IsNullOrWhiteSpace(accessMessage))
        {
            @accessMessage
        }
        else
        {
            <span>Informe o token do seu time para gerenciar as escalações.</span>
        }
    </div>
}
else if (currentEditor is null)
{
    <div class="alert alert-info" role="status">
        Nenhuma escalação criada ainda para este time. Crie uma nova escalação para começar.
    </div>
    <button class="btn btn-primary"
            @onclick="CreateNewLineup"
            disabled="@(isSaving || isDeleting || lineups.Count >= MaxLineupsPerTeam)">
        Criar escalação
    </button>
}
else
{
    if (lineups.Count >= MaxLineupsPerTeam && !currentEditor.IsActive)
    {
        <div class="alert alert-warning" role="status">
            Este time já possui @MaxLineupsPerTeam escalações salvas. Exclua uma escalação antes de criar outra.
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6 col-lg-4">
                    <label class="form-label" for="lineup-selector">Escalação</label>
                    <select id="lineup-selector"
                            class="form-select"
                            value="@CurrentSelectionValue"
                            @onchange="OnLineupChanged"
                            disabled="@(isSaving || isDeleting)">
                        @if (isNewLineup)
                        {
                            <option value="@NewLineupValue">Nova escalação</option>
                        }
                        @foreach (var lineup in lineups)
                        {
                            <option value="@lineup.LineupId">@GetLineupLabel(lineup)</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 col-lg-8 text-md-end d-flex flex-wrap justify-content-md-end gap-2">
                    <button type="button"
                            class="btn btn-outline-primary"
                            @onclick="CreateNewLineup"
                            disabled="@(isSaving || isDeleting || lineups.Count >= MaxLineupsPerTeam)">
                        Nova escalação
                    </button>
                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="ResetSelection"
                            disabled="@(isSaving || isDeleting)">
                        Recarregar escalação
                    </button>
                    <button type="button"
                            class="btn btn-outline-info"
                            @onclick="DuplicateCurrentAsync"
                            disabled="@(isSaving || isDeleting || isNewLineup || lineups.Count >= MaxLineupsPerTeam)">
                        Duplicar
                    </button>
                    <button type="button"
                            class="btn btn-danger"
                            @onclick="DeleteCurrentAsync"
                            disabled="@(isSaving || isDeleting)">
                        Excluir
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == Tab.Lineup ? "active" : "")"
                    type="button"
                    @onclick='() => activeTab = Tab.Lineup'>
                Escalação
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == Tab.Roles ? "active" : "")"
                    type="button"
                    @onclick='() => activeTab = Tab.Roles'>
                Funções
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == Tab.Offensive ? "active" : "")"
                    type="button"
                    @onclick='() => activeTab = Tab.Offensive'>
                Instruções Ofensivas
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == Tab.Defensive ? "active" : "")"
                    type="button"
                    @onclick='() => activeTab = Tab.Defensive'>
                Instruções Defensivas
            </button>
        </li>
    </ul>

    <!-- TAB: Escalação -->
    @if (activeTab == Tab.Lineup)
    {
        <div class="card mb-3">
            <div class="card-header">Informações da escalação</div>
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4 col-lg-3">
                        <label class="form-label" for="lineup-name">Nome</label>
                        <input id="lineup-name"
                               class="form-control"
                               value="@currentEditor.Name"
                               @oninput="OnNameChanged"
                               maxlength="80"
                               disabled="@isSaving" />
                    </div>
                    <div class="col-md-3 col-lg-3">
                        <label class="form-label" for="lineup-formation">Formação</label>
                        <select id="lineup-formation"
                                class="form-select"
                                value="@currentEditor.Formation"
                                @onchange="OnFormationChanged"
                                disabled="@isSaving">
                            @foreach (var formation in FormationOptions)
                            {
                                <option value="@formation">@formation</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 col-lg-3">
                        <label class="form-label" for="lineup-autosub">Substituições automáticas</label>
                        <select id="lineup-autosub"
                                class="form-select"
                                value="@currentEditor.AutoSubstitution"
                                @onchange="OnAutoSubstitutionChanged"
                                disabled="@isSaving">
                            <option value="1">Desativado</option>
                            <option value="2">Muito Tarde</option>
                            <option value="3">Flexível</option>
                            <option value="4">Muito Cedo</option>
                        </select>
                    </div>
                    <div class="col-md-2 col-lg-2">
                        <div class="form-check mt-4 pt-1">
                            <input id="lineup-active"
                                   class="form-check-input"
                                   type="checkbox"
                                   checked="@currentEditor.IsActive"
                                   @onchange="OnActiveChanged"
                                   disabled="@isSaving" />
                            <label class="form-check-label" for="lineup-active">Definir como ativa</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Titulares</div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var slot in currentEditor.Slots.Where(s => !s.IsBench).OrderBy(s => s.Order))
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="form-label" for="slot-@slot.SlotId">@slot.DisplayName</label>
                            <select id="slot-@slot.SlotId"
                                    class="form-select"
                                    value="@GetSlotSelectedValue(slot)"
                                    @onchange="e => OnSlotChanged(slot.SlotId, e.Value?.ToString())"
                                    disabled="@isSaving">
                                <option value="">- Nenhum -</option>
                                @foreach (var option in slot.AvailablePlayers)
                                {
                                    <option value="@option.PlayerId" selected="@(slot.SelectedPlayer?.PlayerId == option.PlayerId)">
                                        @FormatPlayerOption(option)
                                    </option>
                                }
                            </select>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Reservas</div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var slot in currentEditor.Slots.Where(s => s.IsBench).OrderBy(s => s.Order))
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="form-label" for="slot-@slot.SlotId">@slot.DisplayName</label>
                            <select id="slot-@slot.SlotId"
                                    class="form-select"
                                    value="@GetSlotSelectedValue(slot)"
                                    @onchange="e => OnSlotChanged(slot.SlotId, e.Value?.ToString())"
                                    disabled="@isSaving">
                                <option value="">- Nenhum -</option>
                                @foreach (var option in slot.AvailablePlayers)
                                {
                                    <option value="@option.PlayerId" selected="@(slot.SelectedPlayer?.PlayerId == option.PlayerId)">
                                        @FormatPlayerOption(option)
                                    </option>
                                }
                            </select>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- TAB: Funções -->
    @if (activeTab == Tab.Roles)
    {
        <div class="card mb-3">
            <div class="card-header">Funções especiais</div>
            <div class="card-body">
                @{ var starterOptions = GetStarterPlayerOptions(); }
                @if (starterOptions.Count == 0)
                {
                    <p class="text-muted">Defina os titulares para escolher capitão e cobradores.</p>
                }
                <div class="row g-3">
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="role-captain">Capitão</label>
                        <select id="role-captain" class="form-select" @onchange="e => OnRoleChanged(SpecialRoleType.Captain, e.Value?.ToString())" disabled="@isSaving">
                            <option value="">Selecione um jogador...</option>
                            @foreach (var option in starterOptions)
                            {
                                <option value="@option.PlayerId" selected="@(currentEditor.Roles.Captain?.PlayerId == option.PlayerId)">@FormatPlayerOption(option)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="role-shortfk1">Falta curta</label>
                        <select id="role-shortfk1" class="form-select" @onchange="e => OnRoleChanged(SpecialRoleType.ShortFreeKick1, e.Value?.ToString())" disabled="@isSaving">
                            <option value="">Selecione um jogador...</option>
                            @foreach (var option in starterOptions)
                            {
                                <option value="@option.PlayerId" selected="@(currentEditor.Roles.ShortFreeKick1?.PlayerId == option.PlayerId)">@FormatPlayerOption(option)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="role-shortfk2">Falta curta 2</label>
                        <select id="role-shortfk2" class="form-select" @onchange="e => OnRoleChanged(SpecialRoleType.ShortFreeKick2, e.Value?.ToString())" disabled="@isSaving">
                            <option value="">Selecione um jogador...</option>
                            @foreach (var option in starterOptions)
                            {
                                <option value="@option.PlayerId" selected="@(currentEditor.Roles.ShortFreeKick2?.PlayerId == option.PlayerId)">@FormatPlayerOption(option)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="role-longfk">Falta de longa distância</label>
                        <select id="role-longfk" class="form-select" @onchange="e => OnRoleChanged(SpecialRoleType.LongFreeKick, e.Value?.ToString())" disabled="@isSaving">
                            <option value="">Selecione um jogador...</option>
                            @foreach (var option in starterOptions)
                            {
                                <option value="@option.PlayerId" selected="@(currentEditor.Roles.LongFreeKick?.PlayerId == option.PlayerId)">@FormatPlayerOption(option)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="role-penalties">Pênaltis</label>
                        <select id="role-penalties" class="form-select" @onchange="e => OnRoleChanged(SpecialRoleType.Penalties, e.Value?.ToString())" disabled="@isSaving">
                            <option value="">Selecione um jogador...</option>
                            @foreach (var option in starterOptions)
                            {
                                <option value="@option.PlayerId" selected="@(currentEditor.Roles.Penalties?.PlayerId == option.PlayerId)">@FormatPlayerOption(option)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="role-corner-left">Escanteios - Esquerda</label>
                        <select id="role-corner-left" class="form-select" @onchange="e => OnRoleChanged(SpecialRoleType.CornerLeft, e.Value?.ToString())" disabled="@isSaving">
                            <option value="">Selecione um jogador...</option>
                            @foreach (var option in starterOptions)
                            {
                                <option value="@option.PlayerId" selected="@(currentEditor.Roles.CornerLeft?.PlayerId == option.PlayerId)">@FormatPlayerOption(option)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="role-corner-right">Escanteios - Direita</label>
                        <select id="role-corner-right" class="form-select" @onchange="e => OnRoleChanged(SpecialRoleType.CornerRight, e.Value?.ToString())" disabled="@isSaving">
                            <option value="">Selecione um jogador...</option>
                            @foreach (var option in starterOptions)
                            {
                                <option value="@option.PlayerId" selected="@(currentEditor.Roles.CornerRight?.PlayerId == option.PlayerId)">@FormatPlayerOption(option)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Jogadores que atacam</div>
            <div class="card-body">
                @if (starterOptions.Count == 0)
                {
                    <p class="text-muted">Defina os titulares para selecionar os jogadores que atacam.</p>
                }
                <div class="row g-3">
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="role-atk1">Jogador que ataca 1</label>
                        <select id="role-atk1" class="form-select" @onchange="e => OnRoleChanged(SpecialRoleType.AttackingPlayer1, e.Value?.ToString())" disabled="@isSaving">
                            <option value="">Selecione um jogador...</option>
                            @foreach (var option in starterOptions)
                            {
                                <option value="@option.PlayerId" selected="@(currentEditor.Roles.AttackingPlayer1?.PlayerId == option.PlayerId)">@FormatPlayerOption(option)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="role-atk2">Jogador que ataca 2</label>
                        <select id="role-atk2" class="form-select" @onchange="e => OnRoleChanged(SpecialRoleType.AttackingPlayer2, e.Value?.ToString())" disabled="@isSaving">
                            <option value="">Selecione um jogador...</option>
                            @foreach (var option in starterOptions)
                            {
                                <option value="@option.PlayerId" selected="@(currentEditor.Roles.AttackingPlayer2?.PlayerId == option.PlayerId)">@FormatPlayerOption(option)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="role-atk3">Jogador que ataca 3</label>
                        <select id="role-atk3" class="form-select" @onchange="e => OnRoleChanged(SpecialRoleType.AttackingPlayer3, e.Value?.ToString())" disabled="@isSaving">
                            <option value="">Selecione um jogador...</option>
                            @foreach (var option in starterOptions)
                            {
                                <option value="@option.PlayerId" selected="@(currentEditor.Roles.AttackingPlayer3?.PlayerId == option.PlayerId)">@FormatPlayerOption(option)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- TAB: Instruções Ofensivas -->
    @if (activeTab == Tab.Offensive)
    {
        <div class="card mb-3">
            <div class="card-header">
                Instruções Ofensivas
                <span class="text-muted small ms-2">(opcional)</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="oi-style">Estilo Ofensivo</label>
                        <select id="oi-style" class="form-select"
                                value="@(currentEditor.OffensiveInstructions?.OffensiveStyle ?? 0)"
                                @onchange="e => OnOffensiveChanged(nameof(OffensiveInstructionsEditor.OffensiveStyle), e.Value?.ToString())"
                                disabled="@isSaving">
                            <option value="0">- Não definido -</option>
                            <option value="1">Contra-ataque</option>
                            <option value="2">Posse de Bola no Ataque</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="oi-playmaker">Provocador</label>
                        <select id="oi-playmaker" class="form-select"
                                value="@(currentEditor.OffensiveInstructions?.Playmaker ?? 0)"
                                @onchange="e => OnOffensiveChanged(nameof(OffensiveInstructionsEditor.Playmaker), e.Value?.ToString())"
                                disabled="@isSaving">
                            <option value="0">- Não definido -</option>
                            <option value="1">Passe Longo</option>
                            <option value="2">Passe Curto</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="oi-area">Área de Ataque</label>
                        <select id="oi-area" class="form-select"
                                value="@(currentEditor.OffensiveInstructions?.AttackArea ?? 0)"
                                @onchange="e => OnOffensiveChanged(nameof(OffensiveInstructionsEditor.AttackArea), e.Value?.ToString())"
                                disabled="@isSaving">
                            <option value="0">- Não definido -</option>
                            <option value="1">Centro</option>
                            <option value="2">Ampla</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="oi-pos">Posicionamento</label>
                        <select id="oi-pos" class="form-select"
                                value="@(currentEditor.OffensiveInstructions?.Positioning ?? 0)"
                                @onchange="e => OnOffensiveChanged(nameof(OffensiveInstructionsEditor.Positioning), e.Value?.ToString())"
                                disabled="@isSaving">
                            <option value="0">- Não definido -</option>
                            <option value="1">Manter Formação</option>
                            <option value="2">Flexível</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="oi-support">Alcance de Apoio: @(currentEditor.OffensiveInstructions?.SupportRange ?? 5)</label>
                        <input id="oi-support" type="range" class="form-range"
                               min="1" max="10" step="1"
                               value="@(currentEditor.OffensiveInstructions?.SupportRange ?? 5)"
                               @onchange="e => OnOffensiveChanged(nameof(OffensiveInstructionsEditor.SupportRange), e.Value?.ToString())"
                               disabled="@isSaving" />
                        <div class="d-flex justify-content-between small text-muted"><span>1</span><span>10</span></div>
                    </div>
                </div>
                @if (currentEditor.OffensiveInstructions is not null)
                {
                    <div class="mt-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                @onclick="ClearOffensiveInstructions"
                                disabled="@isSaving">
                            Limpar instruções ofensivas
                        </button>
                    </div>
                }
            </div>
        </div>
    }

    <!-- TAB: Instruções Defensivas -->
    @if (activeTab == Tab.Defensive)
    {
        <div class="card mb-3">
            <div class="card-header">
                Instruções Defensivas
                <span class="text-muted small ms-2">(opcional)</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="di-style">Estilo Defensivo</label>
                        <select id="di-style" class="form-select"
                                value="@(currentEditor.DefensiveInstructions?.DefensiveStyle ?? 0)"
                                @onchange="e => OnDefensiveChanged(nameof(DefensiveInstructionsEditor.DefensiveStyle), e.Value?.ToString())"
                                disabled="@isSaving">
                            <option value="0">- Não definido -</option>
                            <option value="1">Retranca</option>
                            <option value="2">Pressão na Frente</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="di-area">Área de Contenção</label>
                        <select id="di-area" class="form-select"
                                value="@(currentEditor.DefensiveInstructions?.ContainmentArea ?? 0)"
                                @onchange="e => OnDefensiveChanged(nameof(DefensiveInstructionsEditor.ContainmentArea), e.Value?.ToString())"
                                disabled="@isSaving">
                            <option value="0">- Não definido -</option>
                            <option value="1">Ampla</option>
                            <option value="2">Centro</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="di-pressure">Pressão</label>
                        <select id="di-pressure" class="form-select"
                                value="@(currentEditor.DefensiveInstructions?.Pressure ?? 0)"
                                @onchange="e => OnDefensiveChanged(nameof(DefensiveInstructionsEditor.Pressure), e.Value?.ToString())"
                                disabled="@isSaving">
                            <option value="0">- Não definido -</option>
                            <option value="1">Tradicional</option>
                            <option value="2">Agressiva</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="di-line">Linha Defensiva: @(currentEditor.DefensiveInstructions?.DefensiveLine ?? 5)</label>
                        <input id="di-line" type="range" class="form-range"
                               min="1" max="10" step="1"
                               value="@(currentEditor.DefensiveInstructions?.DefensiveLine ?? 5)"
                               @onchange="e => OnDefensiveChanged(nameof(DefensiveInstructionsEditor.DefensiveLine), e.Value?.ToString())"
                               disabled="@isSaving" />
                        <div class="d-flex justify-content-between small text-muted"><span>1</span><span>10</span></div>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="di-density">Densidade: @(currentEditor.DefensiveInstructions?.Density ?? 5)</label>
                        <input id="di-density" type="range" class="form-range"
                               min="1" max="10" step="1"
                               value="@(currentEditor.DefensiveInstructions?.Density ?? 5)"
                               @onchange="e => OnDefensiveChanged(nameof(DefensiveInstructionsEditor.Density), e.Value?.ToString())"
                               disabled="@isSaving" />
                        <div class="d-flex justify-content-between small text-muted"><span>1</span><span>10</span></div>
                    </div>
                </div>
                @if (currentEditor.DefensiveInstructions is not null)
                {
                    <div class="mt-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                @onclick="ClearDefensiveInstructions"
                                disabled="@isSaving">
                            Limpar instruções defensivas
                        </button>
                    </div>
                }
            </div>
        </div>
    }

    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-primary"
                @onclick="SaveAsync"
                disabled="@(!CanSave || isSaving || isDeleting)">
            @(isSaving ? "Salvando..." : "Salvar escalação")
        </button>
        @if (isSaving)
        {
            <span class="text-muted">Processando alterações...</span>
        }
        @if (isDeleting)
        {
            <span class="text-muted">Excluindo escalação...</span>
        }
    </div>
}

@code {
    private const int MaxLineupsPerTeam = 3;
    private const string NewLineupValue = "__new__";
    private static readonly IReadOnlyList<string> FormationOptions = LineupTemplateCatalog.GetSupportedFormations();

    private enum Tab { Lineup, Roles, Offensive, Defensive }

    [Parameter]
    public Guid TeamId { get; set; }

    private readonly PageDefinition pageDefinition = new()
    {
        Title = "Escalações",
        Breadcrumbs = new List<BreadcrumbSegment>
        {
            new("Início", "/home"),
            new("Times", "/times/elencos"),
            new("Escalações")
        }
    };

    private readonly List<PlayerOption> rosterPlayers = new();
    private List<TeamLineupDto> lineups = new();
    private LineupEditorState? currentEditor;
    private Guid? selectedLineupId;
    private bool isNewLineup;
    private bool isLoading = true;
    private bool isSaving;
    private bool isDeleting;
    private bool hasAccess;
    private string? accessMessage;
    private string? currentTeamToken;
    private string? errorMessage;
    private string? pageSubtitle;
    private Tab activeTab = Tab.Lineup;
    private CancellationTokenSource? loadCts;
    private CancellationTokenSource? saveCts;
    private CancellationTokenSource? deleteCts;

    protected override void OnInitialized()
    {
        LayoutState.SetPage(pageDefinition);
        TeamAccess.TokenChanged += OnTeamTokenChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private void OnTeamTokenChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        loadCts?.Cancel();
        loadCts = new CancellationTokenSource();
        isLoading = true;
        errorMessage = null;
        accessMessage = null;
        hasAccess = false;

        try
        {
            string? token;
            try { token = await TeamAccess.GetTokenAsync(); }
            catch (InvalidOperationException) { return; }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Lineups:Error retrieving team token");
                accessMessage = "Não foi possível verificar o token do time.";
                currentTeamToken = null;
                ClearLocalState();
                return;
            }

            if (string.IsNullOrWhiteSpace(token))
            {
                accessMessage = "Informe o token do seu time para gerenciar as escalações.";
                currentTeamToken = null;
                ClearLocalState();
                return;
            }

            currentTeamToken = token.Trim();

            TeamIdentityDto? identity;
            try { identity = await TeamsApiClient.ResolveIdentityAsync(currentTeamToken, loadCts.Token); }
            catch (InvalidOperationException ex)
            {
                Logger.LogWarning(ex, "Lineups:Invalid team token");
                accessMessage = ex.Message;
                currentTeamToken = null;
                ClearLocalState();
                return;
            }

            if (identity is null)
            {
                accessMessage = "Token do time inválido.";
                currentTeamToken = null;
                ClearLocalState();
                return;
            }

            if (identity.TeamId != TeamId)
            {
                TeamId = identity.TeamId;
                var destination = $"/teams/{TeamId}/lineups";
                if (!Navigation.Uri.EndsWith(destination, StringComparison.OrdinalIgnoreCase))
                    Navigation.NavigateTo(destination, replace: true);
            }

            hasAccess = true;

            var rosterTask = TeamsApiClient.GetRosterByIdAsync(TeamId, loadCts.Token);
            var lineupsTask = LineupsApiClient.GetLineupsAsync(TeamId, currentTeamToken, loadCts.Token);

            TeamRosterDto? roster;
            IReadOnlyList<TeamLineupDto> fetchedLineups;

            try
            {
                await Task.WhenAll(rosterTask, lineupsTask);
                roster = rosterTask.Result;
                fetchedLineups = lineupsTask.Result;
            }
            catch (InvalidOperationException ex)
            {
                Logger.LogWarning(ex, "Lineups:Access denied for team {TeamId}", TeamId);
                accessMessage = ex.Message;
                hasAccess = false;
                ClearLocalState();
                return;
            }

            if (roster is null)
            {
                accessMessage = "Time não encontrado.";
                hasAccess = false;
                ClearLocalState();
                return;
            }

            rosterPlayers.Clear();
            rosterPlayers.AddRange(roster.Jogadores
                .Select(p => new PlayerOption(p.PlayerId, p.PlayerGuid, p.Nome, p.Posicao, p.PositionId, p.Overall))
                .OrderByDescending(p => p.Overall)
                .ThenBy(p => p.Name));

            lineups = fetchedLineups
                .OrderByDescending(l => l.IsActive)
                .ThenBy(l => l.CreatedAtUtc)
                .ToList();

            pageSubtitle = $"Gerencie as escalações do {roster.TeamName}.";
            LayoutState.SetPage(pageDefinition, subtitle: pageSubtitle);

            var pendingInvalid = TeamAccess.ConsumeInvalidTokenMessage();
            if (!string.IsNullOrWhiteSpace(pendingInvalid))
                errorMessage = pendingInvalid;

            if (lineups.Count > 0)
            {
                var active = lineups.FirstOrDefault(l => l.IsActive) ?? lineups[0];
                SelectExistingLineup(active.LineupId);
            }
            else
            {
                currentEditor = null;
                selectedLineupId = null;
                isNewLineup = false;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lineups:Error loading data for team {TeamId}", TeamId);
            errorMessage = "Não foi possível carregar as escalações. Tente novamente em instantes.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string CurrentSelectionValue => isNewLineup ? NewLineupValue : selectedLineupId?.ToString() ?? string.Empty;

    private bool CanSave => currentEditor is not null && !string.IsNullOrWhiteSpace(currentEditor.Name);

    private Task OnLineupChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value)) return Task.CompletedTask;

        if (value == NewLineupValue) { CreateNewLineup(); return Task.CompletedTask; }

        if (Guid.TryParse(value, out var lineupId))
            SelectExistingLineup(lineupId);

        return Task.CompletedTask;
    }

    private void SelectExistingLineup(Guid lineupId)
    {
        var lineup = lineups.FirstOrDefault(l => l.LineupId == lineupId) ?? lineups.FirstOrDefault();
        if (lineup is null) { currentEditor = null; selectedLineupId = null; isNewLineup = false; return; }

        selectedLineupId = lineup.LineupId;
        isNewLineup = false;
        currentEditor = BuildEditorState(lineup);
    }

    private void CreateNewLineup()
    {
        if (lineups.Count >= MaxLineupsPerTeam)
        {
            Toasts.ShowError($"Este time já possui {MaxLineupsPerTeam} escalações salvas. Exclua uma antes de criar outra.");
            return;
        }

        var template = LineupTemplateCatalog.GetTemplateOrDefault(LineupTemplateCatalog.DefaultFormation);
        var slots = BuildSlotsFromTemplate(template, null);
        var recalculated = RecalculateAvailability(slots);
        var suggestedName = $"Escalação {lineups.Count + 1}";
        var roles = SanitizeRoles(CreateEmptyRoles(), recalculated);

        currentEditor = new LineupEditorState(Guid.Empty, suggestedName, template.Formation, 1, lineups.Count == 0, recalculated, roles, null, null);
        selectedLineupId = null;
        isNewLineup = true;
    }

    private void ResetSelection()
    {
        if (isNewLineup) { CreateNewLineup(); return; }
        if (selectedLineupId.HasValue) SelectExistingLineup(selectedLineupId.Value);
    }

    private void ClearLocalState()
    {
        lineups.Clear();
        currentEditor = null;
        selectedLineupId = null;
        isNewLineup = false;
    }

    private void OnNameChanged(ChangeEventArgs args)
    {
        if (currentEditor is null) return;
        currentEditor = currentEditor with { Name = args.Value?.ToString() ?? string.Empty };
    }

    private void OnActiveChanged(ChangeEventArgs args)
    {
        if (currentEditor is null) return;
        if (bool.TryParse(args.Value?.ToString(), out var isActive))
            currentEditor = currentEditor with { IsActive = isActive };
    }

    private void OnAutoSubstitutionChanged(ChangeEventArgs args)
    {
        if (currentEditor is null) return;
        if (int.TryParse(args.Value?.ToString(), out var value) && value >= 1 && value <= 4)
            currentEditor = currentEditor with { AutoSubstitution = value };
    }

    private void OnFormationChanged(ChangeEventArgs args)
    {
        if (currentEditor is null) return;
        var value = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value) || value.Equals(currentEditor.Formation, StringComparison.OrdinalIgnoreCase))
            return;

        LineupTemplate template;
        try { template = LineupTemplateCatalog.GetTemplateOrDefault(value); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lineups:Unsupported formation selected: {Formation}", value);
            Toasts.ShowError($"Formação '{value}' não é suportada.");
            return;
        }

        var previousAssignments = currentEditor.Slots
            .Where(s => s.SelectedPlayer is not null)
            .ToDictionary(s => s.SlotCode, s => s.SelectedPlayer, StringComparer.OrdinalIgnoreCase);

        var slots = BuildSlotsFromTemplate(template, previousAssignments);
        var recalculated = RecalculateAvailability(slots);
        var sanitizedRoles = SanitizeRoles(currentEditor.Roles, recalculated);
        currentEditor = currentEditor with { Formation = template.Formation, Slots = recalculated, Roles = sanitizedRoles };
    }

    private void OnSlotChanged(Guid slotId, string? value)
    {
        if (currentEditor is null) return;

        var slots = currentEditor.Slots.ToList();
        var roles = currentEditor.Roles;
        var index = slots.FindIndex(s => s.SlotId == slotId);
        if (index < 0) return;

        if (string.IsNullOrWhiteSpace(value))
        {
            slots[index] = slots[index] with { SelectedPlayer = null };
        }
        else if (int.TryParse(value, out var playerId))
        {
            var selectedPlayer = rosterPlayers.FirstOrDefault(p => p.PlayerId == playerId) ?? slots[index].SelectedPlayer;
            if (selectedPlayer is null)
            {
                Toasts.ShowError("Jogador não encontrado no elenco.");
                slots[index] = slots[index] with { SelectedPlayer = null };
            }
            else
            {
                for (var i = 0; i < slots.Count; i++)
                {
                    if (i == index) continue;
                    if (slots[i].SelectedPlayer?.PlayerId == selectedPlayer.PlayerId)
                        slots[i] = slots[i] with { SelectedPlayer = null };
                }
                slots[index] = slots[index] with { SelectedPlayer = selectedPlayer };
            }
        }
        else
        {
            slots[index] = slots[index] with { SelectedPlayer = null };
        }

        var recalculated = RecalculateAvailability(slots);
        var sanitizedRoles = SanitizeRoles(roles, recalculated);
        currentEditor = currentEditor with { Slots = recalculated, Roles = sanitizedRoles };
    }

    private void OnOffensiveChanged(string field, string? rawValue)
    {
        if (currentEditor is null) return;
        if (!int.TryParse(rawValue, out var intValue)) return;

        var oi = currentEditor.OffensiveInstructions ?? new OffensiveInstructionsEditor(0, 0, 0, 0, 5);

        oi = field switch
        {
            nameof(OffensiveInstructionsEditor.OffensiveStyle) => oi with { OffensiveStyle = intValue },
            nameof(OffensiveInstructionsEditor.Playmaker) => oi with { Playmaker = intValue },
            nameof(OffensiveInstructionsEditor.AttackArea) => oi with { AttackArea = intValue },
            nameof(OffensiveInstructionsEditor.Positioning) => oi with { Positioning = intValue },
            nameof(OffensiveInstructionsEditor.SupportRange) => oi with { SupportRange = intValue },
            _ => oi
        };

        // If all fields are 0/default, treat as null (not set)
        var isBlank = oi.OffensiveStyle == 0 && oi.Playmaker == 0 && oi.AttackArea == 0 && oi.Positioning == 0;
        currentEditor = currentEditor with { OffensiveInstructions = isBlank ? null : oi };
    }

    private void OnDefensiveChanged(string field, string? rawValue)
    {
        if (currentEditor is null) return;
        if (!int.TryParse(rawValue, out var intValue)) return;

        var di = currentEditor.DefensiveInstructions ?? new DefensiveInstructionsEditor(0, 0, 0, 5, 5);

        di = field switch
        {
            nameof(DefensiveInstructionsEditor.DefensiveStyle) => di with { DefensiveStyle = intValue },
            nameof(DefensiveInstructionsEditor.ContainmentArea) => di with { ContainmentArea = intValue },
            nameof(DefensiveInstructionsEditor.Pressure) => di with { Pressure = intValue },
            nameof(DefensiveInstructionsEditor.DefensiveLine) => di with { DefensiveLine = intValue },
            nameof(DefensiveInstructionsEditor.Density) => di with { Density = intValue },
            _ => di
        };

        var isBlank = di.DefensiveStyle == 0 && di.ContainmentArea == 0 && di.Pressure == 0;
        currentEditor = currentEditor with { DefensiveInstructions = isBlank ? null : di };
    }

    private void ClearOffensiveInstructions()
    {
        if (currentEditor is null) return;
        currentEditor = currentEditor with { OffensiveInstructions = null };
    }

    private void ClearDefensiveInstructions()
    {
        if (currentEditor is null) return;
        currentEditor = currentEditor with { DefensiveInstructions = null };
    }

    private static string GetSlotSelectedValue(LineupSlotState slot)
        => slot.SelectedPlayer is null ? string.Empty : slot.SelectedPlayer.PlayerId.ToString(CultureInfo.InvariantCulture);

    private async Task SaveAsync()
    {
        if (currentEditor is null) return;
        if (!hasAccess || string.IsNullOrWhiteSpace(currentTeamToken))
        {
            Toasts.ShowError("Informe o token do seu time para salvar a escalação.");
            return;
        }

        saveCts?.Cancel();
        saveCts = new CancellationTokenSource();
        isSaving = true;

        try
        {
            var request = BuildSaveRequest(currentEditor);
            TeamLineupDto result;

            if (isNewLineup || currentEditor.LineupId == Guid.Empty)
            {
                result = await LineupsApiClient.CreateAsync(TeamId, request, currentTeamToken, saveCts.Token);
                Toasts.ShowSuccess("Escalação criada com sucesso.");
            }
            else
            {
                result = await LineupsApiClient.UpdateAsync(TeamId, currentEditor.LineupId, request, currentTeamToken, saveCts.Token);
                Toasts.ShowSuccess("Escalação atualizada com sucesso.");
            }

            await RefreshLineupsAsync(result.LineupId, saveCts.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lineups:Error saving lineup for team {TeamId}", TeamId);
            Toasts.ShowError(ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DuplicateCurrentAsync()
    {
        if (currentEditor is null || isNewLineup || currentEditor.LineupId == Guid.Empty) return;
        if (lineups.Count >= MaxLineupsPerTeam)
        {
            Toasts.ShowError($"O time já possui {MaxLineupsPerTeam} escalações cadastradas.");
            return;
        }
        if (!hasAccess || string.IsNullOrWhiteSpace(currentTeamToken))
        {
            Toasts.ShowError("Informe o token do seu time para duplicar a escalação.");
            return;
        }

        saveCts?.Cancel();
        saveCts = new CancellationTokenSource();
        isSaving = true;

        try
        {
            var duplicated = await LineupsApiClient.DuplicateAsync(TeamId, currentEditor.LineupId, currentTeamToken, saveCts.Token);
            Toasts.ShowSuccess("Escalação duplicada com sucesso.");
            await RefreshLineupsAsync(duplicated.LineupId, saveCts.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lineups:Error duplicating lineup {LineupId} for team {TeamId}", currentEditor.LineupId, TeamId);
            Toasts.ShowError(ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteCurrentAsync()
    {
        if (currentEditor is null) return;

        if (isNewLineup || currentEditor.LineupId == Guid.Empty)
        {
            currentEditor = null;
            selectedLineupId = null;
            isNewLineup = false;
            if (lineups.Count > 0)
            {
                var target = lineups.FirstOrDefault(l => l.IsActive) ?? lineups[0];
                SelectExistingLineup(target.LineupId);
            }
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Confirma a exclusão desta escalação?");
        if (!confirmed) return;

        if (!hasAccess || string.IsNullOrWhiteSpace(currentTeamToken))
        {
            Toasts.ShowError("Informe o token do seu time para excluir a escalação.");
            return;
        }

        deleteCts?.Cancel();
        deleteCts = new CancellationTokenSource();
        isDeleting = true;

        try
        {
            await LineupsApiClient.DeleteAsync(TeamId, currentEditor.LineupId, currentTeamToken, deleteCts.Token);
            Toasts.ShowSuccess("Escalação excluída com sucesso.");
            await RefreshLineupsAsync(null, deleteCts.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lineups:Error deleting lineup {LineupId} for team {TeamId}", currentEditor.LineupId, TeamId);
            Toasts.ShowError(ex.Message);
        }
        finally
        {
            isDeleting = false;
        }
    }

    private async Task RefreshLineupsAsync(Guid? preferredLineupId, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(currentTeamToken)) { hasAccess = false; ClearLocalState(); return; }

        var fetched = await LineupsApiClient.GetLineupsAsync(TeamId, currentTeamToken, ct);
        lineups = fetched.OrderByDescending(l => l.IsActive).ThenBy(l => l.CreatedAtUtc).ToList();

        if (lineups.Count == 0) { currentEditor = null; selectedLineupId = null; isNewLineup = false; return; }

        Guid targetId;
        if (preferredLineupId.HasValue && lineups.Any(l => l.LineupId == preferredLineupId.Value))
            targetId = preferredLineupId.Value;
        else
            targetId = lineups.FirstOrDefault(l => l.IsActive)?.LineupId ?? lineups[0].LineupId;

        SelectExistingLineup(targetId);
    }

    private LineupEditorState BuildEditorState(TeamLineupDto lineup)
    {
        var slots = lineup.Starters.Concat(lineup.Bench)
            .OrderBy(s => s.IsBench).ThenBy(s => s.Order)
            .Select(slot =>
            {
                PlayerOption? selected = null;
                if (slot.Player is not null)
                    selected = rosterPlayers.FirstOrDefault(p => p.PlayerId == slot.Player.PlayerId);

                return new LineupSlotState(
                    slot.SlotId, slot.SlotCode, slot.DisplayName, slot.IsBench, slot.Order,
                    slot.AllowedPositionIds?.ToArray() ?? Array.Empty<short>(),
                    selected, Array.Empty<PlayerOption>());
            })
            .ToList();

        var recalculated = RecalculateAvailability(slots);
        var roles = BuildRolesState(lineup.Roles, recalculated);

        OffensiveInstructionsEditor? oi = null;
        if (lineup.OffensiveInstructions is not null)
        {
            var src = lineup.OffensiveInstructions;
            oi = new OffensiveInstructionsEditor(src.OffensiveStyle, src.Playmaker, src.AttackArea, src.Positioning, src.SupportRange);
        }

        DefensiveInstructionsEditor? di = null;
        if (lineup.DefensiveInstructions is not null)
        {
            var src = lineup.DefensiveInstructions;
            di = new DefensiveInstructionsEditor(src.DefensiveStyle, src.ContainmentArea, src.Pressure, src.DefensiveLine, src.Density);
        }

        return new LineupEditorState(lineup.LineupId, lineup.Name, lineup.Formation, lineup.AutoSubstitution, lineup.IsActive, recalculated, roles, oi, di);
    }

    private IReadOnlyList<LineupSlotState> RecalculateAvailability(IReadOnlyList<LineupSlotState> slots)
    {
        var result = new List<LineupSlotState>(slots.Count);
        foreach (var slot in slots)
            result.Add(slot with { AvailablePlayers = BuildAvailability(slot, slots) });
        return result;
    }

    private IReadOnlyList<PlayerOption> BuildAvailability(LineupSlotState slot, IReadOnlyList<LineupSlotState> slots)
    {
        IEnumerable<PlayerOption> candidates = rosterPlayers;

        if (!slot.IsBench && slot.AllowedPositionIds.Count > 0)
            candidates = candidates.Where(p => slot.AllowedPositionIds.Contains(p.PositionId));

        var ordered = candidates.OrderByDescending(p => p.Overall).ThenBy(p => p.Name).ToList();

        if (slot.SelectedPlayer is not null && ordered.All(p => p.PlayerId != slot.SelectedPlayer.PlayerId))
            ordered.Insert(0, slot.SelectedPlayer);

        return ordered;
    }

    private IReadOnlyList<PlayerOption> GetStarterPlayerOptions()
    {
        if (currentEditor is null) return Array.Empty<PlayerOption>();

        return currentEditor.Slots
            .Where(s => !s.IsBench && s.SelectedPlayer is not null)
            .Select(s => s.SelectedPlayer!)
            .GroupBy(p => p.PlayerId)
            .Select(g => g.First())
            .OrderBy(p => p.PositionName)
            .ThenBy(p => p.Name)
            .ToList();
    }

    private LineupRolesState BuildRolesState(TeamLineupRolesDto? dto, IReadOnlyList<LineupSlotState> slots)
    {
        var roles = CreateEmptyRoles();

        if (dto is not null)
        {
            roles = roles with
            {
                Captain = ResolvePlayerOption(dto.Captain),
                ShortFreeKick1 = ResolvePlayerOption(dto.ShortFreeKick1),
                ShortFreeKick2 = ResolvePlayerOption(dto.ShortFreeKick2),
                LongFreeKick = ResolvePlayerOption(dto.LongFreeKick),
                Penalties = ResolvePlayerOption(dto.Penalties),
                CornerLeft = ResolvePlayerOption(dto.CornerLeft),
                CornerRight = ResolvePlayerOption(dto.CornerRight),
                AttackingPlayer1 = ResolvePlayerOption(dto.AttackingPlayer1),
                AttackingPlayer2 = ResolvePlayerOption(dto.AttackingPlayer2),
                AttackingPlayer3 = ResolvePlayerOption(dto.AttackingPlayer3),
            };
        }

        return SanitizeRoles(roles, slots);
    }

    private PlayerOption? ResolvePlayerOption(TeamLineupSlotPlayerDto? player)
    {
        if (player is null) return null;
        return rosterPlayers.FirstOrDefault(p => p.PlayerId == player.PlayerId);
    }

    private void OnRoleChanged(SpecialRoleType role, string? value)
    {
        if (currentEditor is null) return;

        PlayerOption? selected = null;
        if (!string.IsNullOrWhiteSpace(value) && int.TryParse(value, out var playerId))
            selected = GetStarterPlayerOptions().FirstOrDefault(p => p.PlayerId == playerId);

        var updatedRoles = role switch
        {
            SpecialRoleType.Captain => currentEditor.Roles with { Captain = selected },
            SpecialRoleType.ShortFreeKick1 => currentEditor.Roles with { ShortFreeKick1 = selected },
            SpecialRoleType.ShortFreeKick2 => currentEditor.Roles with { ShortFreeKick2 = selected },
            SpecialRoleType.LongFreeKick => currentEditor.Roles with { LongFreeKick = selected },
            SpecialRoleType.Penalties => currentEditor.Roles with { Penalties = selected },
            SpecialRoleType.CornerLeft => currentEditor.Roles with { CornerLeft = selected },
            SpecialRoleType.CornerRight => currentEditor.Roles with { CornerRight = selected },
            SpecialRoleType.AttackingPlayer1 => currentEditor.Roles with { AttackingPlayer1 = selected },
            SpecialRoleType.AttackingPlayer2 => currentEditor.Roles with { AttackingPlayer2 = selected },
            SpecialRoleType.AttackingPlayer3 => currentEditor.Roles with { AttackingPlayer3 = selected },
            _ => currentEditor.Roles
        };

        updatedRoles = SanitizeRoles(updatedRoles, currentEditor.Slots);
        currentEditor = currentEditor with { Roles = updatedRoles };
    }

    private static LineupRolesState CreateEmptyRoles()
        => new(null, null, null, null, null, null, null, null, null, null);

    private static LineupRolesState SanitizeRoles(LineupRolesState roles, IReadOnlyList<LineupSlotState> slots)
    {
        var starterIds = slots
            .Where(s => !s.IsBench && s.SelectedPlayer is not null)
            .Select(s => s.SelectedPlayer!.PlayerId)
            .ToHashSet();

        PlayerOption? Normalize(PlayerOption? player)
            => player is not null && starterIds.Contains(player.PlayerId) ? player : null;

        return roles with
        {
            Captain = Normalize(roles.Captain),
            ShortFreeKick1 = Normalize(roles.ShortFreeKick1),
            ShortFreeKick2 = Normalize(roles.ShortFreeKick2),
            LongFreeKick = Normalize(roles.LongFreeKick),
            Penalties = Normalize(roles.Penalties),
            CornerLeft = Normalize(roles.CornerLeft),
            CornerRight = Normalize(roles.CornerRight),
            AttackingPlayer1 = Normalize(roles.AttackingPlayer1),
            AttackingPlayer2 = Normalize(roles.AttackingPlayer2),
            AttackingPlayer3 = Normalize(roles.AttackingPlayer3),
        };
    }

    private static string FormatPlayerOption(PlayerOption option)
        => option.Overall > 0
            ? $"{option.Name} ({option.PositionName}, {option.Overall})"
            : $"{option.Name} ({option.PositionName})";

    private static string GetLineupLabel(TeamLineupDto lineup)
        => lineup.IsActive ? $"{lineup.Name} (Ativa)" : lineup.Name;

    private static List<LineupSlotState> BuildSlotsFromTemplate(LineupTemplate template, IDictionary<string, PlayerOption?>? assignments)
    {
        assignments ??= new Dictionary<string, PlayerOption?>(StringComparer.OrdinalIgnoreCase);

        return template.AllSlots
            .OrderBy(s => s.IsBench).ThenBy(s => s.Order)
            .Select(s =>
            {
                assignments.TryGetValue(s.SlotCode, out var selected);
                return new LineupSlotState(
                    Guid.NewGuid(), s.SlotCode, s.DisplayName, s.IsBench, s.Order,
                    s.AllowedPositionIds.ToArray(), selected, Array.Empty<PlayerOption>());
            })
            .ToList();
    }

    private static TeamLineupSaveRequestDto BuildSaveRequest(LineupEditorState editor)
    {
        var starters = editor.Slots
            .Where(s => !s.IsBench).OrderBy(s => s.Order)
            .Select(s => new TeamLineupSlotAssignmentDto(s.SlotCode, s.SelectedPlayer?.PlayerId))
            .ToList();

        var bench = editor.Slots
            .Where(s => s.IsBench).OrderBy(s => s.Order)
            .Select(s => new TeamLineupSlotAssignmentDto(s.SlotCode, s.SelectedPlayer?.PlayerId))
            .ToList();

        var roles = new TeamLineupRoleAssignmentsDto(
            editor.Roles.Captain?.PlayerId,
            editor.Roles.ShortFreeKick1?.PlayerId,
            editor.Roles.ShortFreeKick2?.PlayerId,
            editor.Roles.LongFreeKick?.PlayerId,
            editor.Roles.Penalties?.PlayerId,
            editor.Roles.CornerLeft?.PlayerId,
            editor.Roles.CornerRight?.PlayerId,
            editor.Roles.AttackingPlayer1?.PlayerId,
            editor.Roles.AttackingPlayer2?.PlayerId,
            editor.Roles.AttackingPlayer3?.PlayerId);

        TeamLineupOffensiveInstructionsDto? oi = null;
        if (editor.OffensiveInstructions is { } oiEditor && oiEditor.OffensiveStyle > 0)
        {
            oi = new TeamLineupOffensiveInstructionsDto(
                oiEditor.OffensiveStyle, oiEditor.Playmaker, oiEditor.AttackArea,
                oiEditor.Positioning, oiEditor.SupportRange);
        }

        TeamLineupDefensiveInstructionsDto? di = null;
        if (editor.DefensiveInstructions is { } diEditor && diEditor.DefensiveStyle > 0)
        {
            di = new TeamLineupDefensiveInstructionsDto(
                diEditor.DefensiveStyle, diEditor.ContainmentArea, diEditor.Pressure,
                diEditor.DefensiveLine, diEditor.Density);
        }

        return new TeamLineupSaveRequestDto(editor.Name, editor.Formation, editor.AutoSubstitution, editor.IsActive, starters, bench, roles, oi, di);
    }

    public void Dispose()
    {
        TeamAccess.TokenChanged -= OnTeamTokenChanged;
        loadCts?.Cancel(); loadCts?.Dispose();
        saveCts?.Cancel(); saveCts?.Dispose();
        deleteCts?.Cancel(); deleteCts?.Dispose();
    }

    private enum SpecialRoleType
    {
        Captain, ShortFreeKick1, ShortFreeKick2, LongFreeKick,
        Penalties, CornerLeft, CornerRight,
        AttackingPlayer1, AttackingPlayer2, AttackingPlayer3
    }

    private sealed record PlayerOption(int PlayerId, Guid PlayerGuid, string Name, string PositionName, short PositionId, int Overall);

    private sealed record LineupSlotState(
        Guid SlotId, string SlotCode, string DisplayName, bool IsBench, int Order,
        IReadOnlyList<short> AllowedPositionIds, PlayerOption? SelectedPlayer, IReadOnlyList<PlayerOption> AvailablePlayers);

    private sealed record LineupRolesState(
        PlayerOption? Captain,
        PlayerOption? ShortFreeKick1,
        PlayerOption? ShortFreeKick2,
        PlayerOption? LongFreeKick,
        PlayerOption? Penalties,
        PlayerOption? CornerLeft,
        PlayerOption? CornerRight,
        PlayerOption? AttackingPlayer1,
        PlayerOption? AttackingPlayer2,
        PlayerOption? AttackingPlayer3);

    private sealed record OffensiveInstructionsEditor(
        int OffensiveStyle, int Playmaker, int AttackArea, int Positioning, int SupportRange);

    private sealed record DefensiveInstructionsEditor(
        int DefensiveStyle, int ContainmentArea, int Pressure, int DefensiveLine, int Density);

    private sealed record LineupEditorState(
        Guid LineupId,
        string Name,
        string Formation,
        int AutoSubstitution,
        bool IsActive,
        IReadOnlyList<LineupSlotState> Slots,
        LineupRolesState Roles,
        OffensiveInstructionsEditor? OffensiveInstructions,
        DefensiveInstructionsEditor? DefensiveInstructions);
}
