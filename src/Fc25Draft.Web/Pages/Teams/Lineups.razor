    private int GetAdvancedValue(string field)
    {
        var ai = currentEditor?.AdvancedInstructions;
        if (ai is null) return 1;
        return field switch
        {
            "Attack1" => ai.Attack1,
            "Attack2" => ai.Attack2,
            "Defense1" => ai.Defense1,
            "Defense2" => ai.Defense2,
            _ => 1
        };
    }

    private int? GetAdvancedPlayerId(string field)
    {
        var ai = currentEditor?.AdvancedInstructions;
        if (ai is null) return null;
        return field switch
        {
            "AttackPlayer1Id" => ai.AttackPlayer1Id,
            "AttackPlayer2Id" => ai.AttackPlayer2Id,
            "DefensePlayer1Id" => ai.DefensePlayer1Id,
            "DefensePlayer2Id" => ai.DefensePlayer2Id,
            _ => null
        };
    }

    private void OnAdvancedChanged(string field, string? rawValue)
    {
        if (currentEditor is null) return;
        if (!int.TryParse(rawValue, out var value)) return;

        var ai = currentEditor.AdvancedInstructions ?? new AdvancedInstructionsEditor(1, null, 1, null, 1, null, 1, null);

        ai = field switch
        {
            "Attack1" => ai with { Attack1 = value, AttackPlayer1Id = (value == 2 || value == 4) ? ai.AttackPlayer1Id : null },
            "Attack2" => ai with { Attack2 = value, AttackPlayer2Id = (value == 2 || value == 4) ? ai.AttackPlayer2Id : null },
            "Defense1" => ai with { Defense1 = value, DefensePlayer1Id = value == 5 ? ai.DefensePlayer1Id : null },
            "Defense2" => ai with { Defense2 = value, DefensePlayer2Id = value == 5 ? ai.DefensePlayer2Id : null },
            _ => ai
        };

        var isBlank = ai.Attack1 <= 1 && ai.Attack2 <= 1 && ai.Defense1 <= 1 && ai.Defense2 <= 1;
        currentEditor = currentEditor with { AdvancedInstructions = isBlank ? null : ai };
    }

    private void OnAdvancedPlayerChanged(string field, string? rawValue)
    {
        if (currentEditor is null) return;
        int? playerId = string.IsNullOrWhiteSpace(rawValue) ? null : int.TryParse(rawValue, out var pid) ? pid : null;

        var ai = currentEditor.AdvancedInstructions ?? new AdvancedInstructionsEditor(1, null, 1, null, 1, null, 1, null);

        ai = field switch
        {
            "AttackPlayer1Id" => ai with { AttackPlayer1Id = playerId },
            "AttackPlayer2Id" => ai with { AttackPlayer2Id = playerId },
            "DefensePlayer1Id" => ai with { DefensePlayer1Id = playerId },
            "DefensePlayer2Id" => ai with { DefensePlayer2Id = playerId },
            _ => ai
        };

        currentEditor = currentEditor with { AdvancedInstructions = ai };
    }

    private void ClearAdvancedInstructions()
    {
        if (currentEditor is null) return;
        currentEditor = currentEditor with { AdvancedInstructions = null };
    }

    private IReadOnlyList<PlayerOption> GetOutfieldStarterOptions()
    {
        if (currentEditor is null) return Array.Empty<PlayerOption>();

        return currentEditor.Slots
            .Where(s => !s.IsBench && s.SelectedPlayer is not null
                && !s.SlotCode.Equals("GK", StringComparison.OrdinalIgnoreCase))
            .Select(s => s.SelectedPlayer!)
            .GroupBy(p => p.PlayerId)
            .Select(g => g.First())
            .OrderBy(p => p.PositionName)
            .ThenBy(p => p.Name)
            .ToList();
    }
