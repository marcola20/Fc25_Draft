                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="d-flex align-items-center gap-1 mb-1">
                            <label class="form-label mb-0" for="di-pressure">Pressão</label>
                            <span class="hint-anchor">
                                <button type="button" class="hint-toggle" title="Ver descrição"
                                        @onclick:stopPropagation="true"
                                        @onclick='() => ToggleHint("di-pressure")'>?</button>
                                @if (_activeHint == "di-pressure")
