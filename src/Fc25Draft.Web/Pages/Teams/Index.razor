@page "/teams"
@using System
@using Fc25Draft.Core.DTOs
@inject TeamsApiClient TeamsApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AdminAuthService AdminAuth

@implements IDisposable

<h3>Equipes</h3>

<div class="row mb-3 g-2 align-items-end">
    <div class="col-md-6">
        <form class="d-flex" @onsubmit="OnSearchAsync" @onsubmit:preventDefault>
            <input class="form-control me-2" placeholder="Pesquisar por equipe ou responsável" @bind="search" />
            <button type="submit" class="btn btn-primary">Buscar</button>
        </form>
    </div>
    <div class="col-md-6 text-md-end">
        @if (AdminAuth.IsAdmin)
        {
            <button class="btn btn-success ms-2" @onclick="CreateTeam">Nova Equipe</button>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <p><em>Carregando...</em></p>
}
else if (teams.Count == 0)
{
    <p>Nenhuma equipe encontrada.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Equipe</th>
                    <th>Responsável</th>
                    <th>Jogadores</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var team in teams)
                {
                    <tr>
                        <td>@team.TeamName</td>
                        <td>@(string.IsNullOrWhiteSpace(team.OwnerName) ? "-" : team.OwnerName)</td>
                        <td>@team.Jogadores</td>
                        <td class="text-end">
                            <button class="btn btn-link" @onclick="() => ViewDetails(team.TeamId)">Detalhes</button>
                            @if (AdminAuth.IsAdmin)
                            {
                                <button class="btn btn-link" @onclick="() => EditTeam(team.TeamId)">Editar</button>
                                <button class="btn btn-link text-danger" @onclick="() => ConfirmDelete(team.TeamId)">Excluir</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private const int PageSize = 14;
    private readonly List<TeamListItemDto> teams = new();
    private int currentPage = 1;
    private int totalPages = 1;
    private string? search;
    private string? errorMessage;
    private bool isLoading;
    private bool authInitialized;

    protected override void OnInitialized()
    {
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadTeamsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AdminAuth.EnsureInitializedAsync();
        authInitialized = true;
        StateHasChanged();
    }

    private async Task OnSearchAsync()
    {
        currentPage = 1;
        await LoadTeamsAsync();
    }

    private async Task LoadTeamsAsync()
    {
        isLoading = true;
        errorMessage = null;
        teams.Clear();

        try
        {
            var result = await TeamsApiClient.GetAsync(search, currentPage, PageSize);
            teams.AddRange(result.Items);
            totalPages = Math.Max(1, (int)Math.Ceiling(result.Total / (double)PageSize));
            if (currentPage > totalPages)
            {
                currentPage = totalPages;
                await LoadTeamsAsync();
                return;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page == currentPage || page > totalPages)
        {
            return;
        }

        currentPage = page;
        await LoadTeamsAsync();
    }

    private void CreateTeam()
    {
        if (!AdminAuth.IsAdmin)
        {
            errorMessage = "Entre como administrador para adicionar equipes.";
            return;
        }

        Navigation.NavigateTo("/teams/edit");
    }

    private void EditTeam(Guid id)
    {
        if (!AdminAuth.IsAdmin)
        {
            errorMessage = "Entre como administrador para editar equipes.";
            return;
        }

        Navigation.NavigateTo($"/teams/edit/{id}");
    }

    private void ViewDetails(Guid id) => Navigation.NavigateTo($"/teams/details/{id}");

    private async Task ConfirmDelete(Guid id)
    {
        if (!AdminAuth.IsAdmin)
        {
            errorMessage = "Entre como administrador para excluir equipes.";
            return;
        }

        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Tem certeza de que deseja excluir esta equipe?"))
        {
            return;
        }

        try
        {
            await TeamsApiClient.DeleteAsync(id);
            await LoadTeamsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void DownloadTeamsJson() => Navigation.NavigateTo("api/teams/export/json", forceLoad: true);

    private void NavigateToRosters() => Navigation.NavigateTo("/teams/roster");

    private void OnAuthenticationChanged()
    {
        if (!authInitialized)
        {
            return;
        }

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
    }
}
