    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    /// <summary>Jogador da lista de transferência para abrir já na proposta (vem do Mercado).</summary>
    [Parameter, SupplyParameterFromQuery(Name = "negociar")]
    public Guid? NegociarJogador { get; set; }

    /// <summary>Aba que a página já abre (?aba=extrato vem da Minha Área; ?aba=treino, do lembrete do treino).</summary>
    [Parameter, SupplyParameterFromQuery(Name = "aba")]
    public string? Aba { get; set; }

    private Guid? _propostaPorJogador;
    private RosterPlayerViewModel? _listingTarget;
    private decimal _listingPrice;
    private bool _listingProcessing;
    private string? _listingErrorMessage;
    private RosterPlayerViewModel? _saidaTarget;
    private bool _saidaProcessando;
    private string? _saidaErro;
    private RosterPlayerViewModel? _conversaTarget;
    private bool _conversaProcessando;
    private string? _conversaErro;

    private TeamDetailsDto? team;
    private int _maxQuickSell = 5;
    private bool _quickSellBloqueado = true;
    private decimal? teamAmount;
    private List<EmprestimoDto> _emprestadosFora = new();
    private TeamRosterDto? roster;
    private string? errorMessage;
    private bool isLoading = true;
    private IReadOnlyList<TimeTrajetoriaDto> _trajetoria = Array.Empty<TimeTrajetoriaDto>();
    private int _titulos;
    private IReadOnlyList<TimeTituloCopaDto> _titulosCopas = Array.Empty<TimeTituloCopaDto>();
    private TimePerfilDto? _perfil;
    private Guid? _carregadoId;
    private bool authInitialized;
    private readonly List<RosterPlayerViewModel> _rosterPlayers = new();
    private IReadOnlyList<RosterPlayerViewModel> _sortedRosterPlayers = Array.Empty<RosterPlayerViewModel>();
    private RosterSortColumn? _activeSortColumn = RosterSortColumn.Position;
    private bool _sortDescending;
    private string? _quickSellSuccessMessage;
    private string? _teamTokenErrorMessage;
    private bool _canQuickSell;
    private RosterPlayerViewModel? _quickSellTarget;
    private bool _quickSellModalOpen;
    private decimal _quickSellPayout;
    private bool _quickSellProcessing;
    private string? _quickSellErrorMessage;
    private string? _currentTeamToken;
    private static readonly CultureInfo BrazilCulture = CultureInfo.GetCultureInfo("pt-BR");

    protected override void OnInitialized()
    {
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
        TeamAccess.TokenChanged += OnTeamTokenChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cfg = await TransferConfigSvc.GetAsync(CancellationToken.None);
            _maxQuickSell = cfg.MaxQuickSellPerWindow;
            _quickSellBloqueado = cfg.QuickSellBloqueado;
        }
        catch { /* mantém o padrão se a config não carregar */ }
    }

    // Os links para adversários levam a esta mesma página com outro Id: o Blazor reaproveita o
    // componente, então os dados são recarregados aqui sempre que o time muda.
    protected override async Task OnParametersSetAsync()
    {
        if (_carregadoId == Id)
        {
            return;
        }

        _carregadoId = Id;
        _activeMainTab = Aba?.ToLowerInvariant() switch
        {
            "extrato" => MainTab.Extrato,
            "treino" => MainTab.Treino,
            _ => MainTab.Info
        };
        _quickSellSuccessMessage = null;
        _perfil = null;

        await LoadTeamAsync();
        await LoadTrajetoriaAsync();
        await LoadPerfilAsync();
        await RefreshTeamTokenStateAsync();

        if (NegociarJogador is Guid jogador && _canQuickSell)
        {
            _propostaPorJogador = jogador;
            _activeMainTab = MainTab.Negotiations;
        }
    }

    private async Task LoadPerfilAsync()
    {
        try
        {
            _perfil = await LigaService.GetPerfilTimeAsync(Id, CancellationToken.None);
        }
        catch
        {
            // Forma e jogos são complementares: se falhar, a página do time continua útil.
            _perfil = null;
        }
    }

    private async Task LoadTrajetoriaAsync()
    {
        try
        {
            _trajetoria = await LigaService.GetTrajetoriaTimeAsync(Id, CancellationToken.None);
            _titulosCopas = await LigaService.GetTitulosCopasTimeAsync(Id, CancellationToken.None);
            _titulos = _trajetoria.Count(t => t.Campeao) + _titulosCopas.Count;
        }
        catch
        {
            // Trajetória é complementar: se falhar, a página do time continua útil.
            _trajetoria = Array.Empty<TimeTrajetoriaDto>();
            _titulosCopas = Array.Empty<TimeTituloCopaDto>();
            _titulos = 0;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AdminAuth.EnsureInitializedAsync();
        authInitialized = true;
        StateHasChanged();
    }

    private async Task LoadTeamAsync()
    {
        isLoading = true;
        errorMessage = null;
        roster = null;
        _rosterPlayers.Clear();
        _sortedRosterPlayers = Array.Empty<RosterPlayerViewModel>();

        try
        {
            team = await TeamsApiClient.GetByIdAsync(Id);
            if (team is null)
            {
                errorMessage = "Time não encontrado.";
                return;
            }

            roster = await TeamsApiClient.GetRosterByIdAsync(Id);
            _emprestadosFora = (await EmprestimoSvc.ListarAtivosAsync(Id, CancellationToken.None))
                .Where(e => e.DonoTeamId == Id)
                .ToList();

            if (roster is not null)
            {
                await PopulateRosterPlayersAsync(roster.Jogadores);
            }
            else
            {
                ApplyRosterSort();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnAuthenticationChanged()
    {
        if (!authInitialized)
        {
            return;
        }

        InvokeAsync(StateHasChanged);
    }

    private void OnTeamTokenChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshTeamTokenStateAsync();
            StateHasChanged();
        });
    }

    private async Task PopulateRosterPlayersAsync(IReadOnlyList<TeamRosterPlayerDto> players)
    {
        _rosterPlayers.Clear();

        IReadOnlyDictionary<int, ParticipacaoJogador> participacoes;
        try
        {
            participacoes = await ParticipacaoSvc.GetTodosAsync(default);
        }
        catch
        {
            participacoes = new Dictionary<int, ParticipacaoJogador>();
        }

        foreach (var player in players)
        {
            decimal basePrice = 0m;
            try
            {
                var pricing = await PricingService.CalculateForPlayerAsync(player.PlayerId, default);
                basePrice = pricing.BasePrice;
            }
            catch
            {
                basePrice = 0m;
            }

            var positionId = player.Posicao.ToPositionId();

            _rosterPlayers.Add(new RosterPlayerViewModel(
                player.PlayerGuid,
                player.PlayerId,
                player.Nome,
                player.Posicao,
                positionId,
                player.Overall,
                player.Idade,
                basePrice,
                player.PrecoPedido,
                player.EmprestadoPor,
                participacoes.GetValueOrDefault(player.PlayerId) is { } part && part.TimeId == Id ? part : null));
        }

        teamAmount = _rosterPlayers.Sum(p => p.BasePrice);
        ApplyRosterSort();
    }

    private async Task RefreshTeamTokenStateAsync()
    {
        _teamTokenErrorMessage = null;
        _canQuickSell = false;
        _currentTeamToken = null;

        string? token;
        try
        {
            token = await TeamAccess.GetTokenAsync();
        }
        catch (InvalidOperationException)
        {
            return;
        }
        catch
        {
            _teamTokenErrorMessage = "Não foi possível verificar o token.";
            return;
        }

        if (string.IsNullOrWhiteSpace(token))
            return;

        await AdminAuth.EnsureInitializedAsync();
        if (AdminAuth.IsAdmin)
            return;

        _currentTeamToken = token.Trim();

        try
        {
            var identity = await TeamsApiClient.ResolveIdentityAsync(_currentTeamToken, default);
            if (identity is not null && identity.TeamId == Id)
            {
                _canQuickSell = true;
                _teamTokenErrorMessage = null;
            }
            else if (identity is not null)
            {
                if (!AdminAuth.IsAdmin)
                    _teamTokenErrorMessage = "O token configurado pertence a outro time.";
            }
            else
            {
                if (!AdminAuth.IsAdmin)
                    _teamTokenErrorMessage = "Token inválido.";
            }
        }
        catch (InvalidOperationException ex)
        {
            if (!AdminAuth.IsAdmin)
                _teamTokenErrorMessage = ex.Message;
        }
        catch
        {
            if (!AdminAuth.IsAdmin)
                _teamTokenErrorMessage = "Não foi possível validar o token.";
        }

        var invalidMessage = TeamAccess.ConsumeInvalidTokenMessage();
        if (!string.IsNullOrWhiteSpace(invalidMessage))
        {
            _teamTokenErrorMessage = invalidMessage;
        }

        if (!string.IsNullOrEmpty(_teamTokenErrorMessage))
        {
            _canQuickSell = false;
        }
    }

    private void ToggleRosterSort(RosterSortColumn column)
    {
        if (_activeSortColumn == column)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _activeSortColumn = column;
            _sortDescending = column switch
            {
                RosterSortColumn.Position => false,
                RosterSortColumn.Age => false,
                _ => true
            };
        }

        ApplyRosterSort();
    }

    private void ApplyRosterSort()
    {
        IEnumerable<RosterPlayerViewModel> query = _rosterPlayers;

        if (_activeSortColumn is null)
        {
            query = query.OrderBy(p => p.PositionId)
                .ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase);
        }
        else
        {
            query = _activeSortColumn switch
            {
                RosterSortColumn.Position => _sortDescending
                    ? query.OrderByDescending(p => p.PositionId).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                    : query.OrderBy(p => p.PositionId).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
                RosterSortColumn.Overall => _sortDescending
                    ? query.OrderByDescending(p => p.Overall).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                    : query.OrderBy(p => p.Overall).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
                RosterSortColumn.Age => _sortDescending
                    ? query.OrderByDescending(p => p.Age ?? int.MinValue).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                    : query.OrderBy(p => p.Age ?? int.MaxValue).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
                RosterSortColumn.BasePrice => _sortDescending
                    ? query.OrderByDescending(p => p.BasePrice).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                    : query.OrderBy(p => p.BasePrice).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
                _ => query
            };
        }

        _sortedRosterPlayers = query.ToList();
    }

    private void OpenQuickSellModal(RosterPlayerViewModel player)
    {
        if (!_canQuickSell)
        {
            return;
        }

        _quickSellTarget = player;
        _quickSellPayout = decimal.Round(player.BasePrice * 0.8m, 2, MidpointRounding.AwayFromZero);
        _quickSellErrorMessage = null;
        _quickSellModalOpen = true;
    }

    private void CloseQuickSellModal()
    {
        if (_quickSellProcessing)
        {
            return;
        }

        _quickSellModalOpen = false;
        _quickSellTarget = null;
        _quickSellErrorMessage = null;
    }

    private async Task ConfirmQuickSellAsync()
    {
        if (_quickSellTarget is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_currentTeamToken))
        {
            _quickSellErrorMessage = "Token não configurado.";
            return;
        }

        _quickSellProcessing = true;
        _quickSellErrorMessage = null;

        try
        {
            var result = await TeamsApiClient.QuickSellAsync(Id, _quickSellTarget.PlayerGuid, _currentTeamToken, default);
            var formattedBudget = result.TeamBudgetAfter.ToString("C", BrazilCulture);
            if (team is not null)
            {
                var remainingPlayers = Math.Max(0, team.Jogadores - 1);
                team = team with { Caixa = formattedBudget, Jogadores = remainingPlayers, QuickSellCount = team.QuickSellCount + 1 };
            }

            var newAmount = (teamAmount ?? 0m) - _quickSellTarget.BasePrice;
            teamAmount = newAmount < 0m ? 0m : newAmount;

            _rosterPlayers.RemoveAll(p => p.PlayerGuid == _quickSellTarget.PlayerGuid);
            ApplyRosterSort();

            _quickSellSuccessMessage = $"Jogador {_quickSellTarget.Name} vendido por {FormatCurrency(result.Payout)}. Caixa atualizado.";
            if (result.NewOverall != result.OldOverall)
            {
                _quickSellSuccessMessage += $" Overall {result.OldOverall} → {result.NewOverall}"
                    + (result.Evolucao is null ? "." : $" ({result.Evolucao}).");
            }
            _quickSellModalOpen = false;
            _quickSellTarget = null;
            _quickSellPayout = 0m;
        }
        catch (KeyNotFoundException ex)
        {
            _quickSellErrorMessage = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _quickSellErrorMessage = ex.Message;

            if (ex.Message.Contains("token", StringComparison.OrdinalIgnoreCase))
            {
                TeamAccess.ReportInvalidToken(ex.Message);
                await RefreshTeamTokenStateAsync();
            }
        }
        finally
        {
            _quickSellProcessing = false;
        }
    }

    private static string TituloInsatisfeito(ParticipacaoJogador p) =>
        $"Insatisfeito com o banco. Passa com {ParticipacaoCriterios.TitularSeguidoParaResolver} jogos seguidos como titular."
        + (p.Saida?.FaltamParaPedir switch
        {
            0 => " Vai pedir para sair.",
            int n => $" Se seguir assim por mais {n} jogo(s), pede para sair e vai sozinho para a lista.",
            _ => ""
        });

    private static string TituloVariacao(ParticipacaoJogador p) =>
        p.Travada ? "Preço travado: pediu para sair e está na lista"
        : p.ChegouEmBaixa ? $"Chegou em baixa: pediu para sair do clube anterior (vale até ele ter {ParticipacaoCriterios.JogosParaValer} jogos aqui)"
        : $"Participação de {(p.Percentual is decimal pct ? $"{pct * 100:0}%" : "—")} nos últimos {p.Jogos} jogos do clube";

    private static string TituloPapel(ParticipacaoJogador p) =>
        p.Papel is not { } papel ? ""
        : $"{PapelDoJogador.Nome(papel.Papel)}: {PapelDoJogador.OQueEspera(papel.Papel, papel.Janela)}."
          + (papel.PrataDaCasa ? " Prata da casa: tem mais paciência." : "")
          + (p.NaConversa ? $" Teve a conversa: valor {Participacao.Rotulo(PapelCriterios.DescontoDaConversa)} por alguns jogos." : "");

    // Titular e disputa podem descer; quem pediu para sair só tem a promessa.
    private bool PodeConversar(RosterPlayerViewModel player) =>
        _canQuickSell && player.EmprestadoPor is null
        && player.Participacao is { Papel: { } papel, Saida.NaLista: false }
        && PapelDoJogador.UmDegrauAbaixo(papel.Papel) is not null;

    private void AbrirConversa(RosterPlayerViewModel player)
    {
        if (!PodeConversar(player))
            return;

        _conversaTarget = player;
        _conversaErro = null;
    }

    private void FecharConversa()
    {
        if (_conversaProcessando)
            return;

        _conversaTarget = null;
        _conversaErro = null;
    }

    private async Task ConversarAsync()
    {
        if (_conversaTarget is null || string.IsNullOrWhiteSpace(_currentTeamToken))
            return;

        _conversaProcessando = true;
        _conversaErro = null;
        try
        {
            await OffersApi.ConversarAsync(_conversaTarget.PlayerGuid, _currentTeamToken);

            var participacao = await ParticipacaoSvc.GetAsync(_conversaTarget.PlayerId, default);
            var preco = await PricingService.CalculateForPlayerAsync(_conversaTarget.PlayerId, default);
            var index = _rosterPlayers.FindIndex(p => p.PlayerGuid == _conversaTarget.PlayerGuid);
            if (index >= 0)
                _rosterPlayers[index] = _rosterPlayers[index] with
                {
                    BasePrice = preco.BasePrice,
                    Participacao = participacao is { } part && part.TimeId == Id ? part : null
                };
            teamAmount = _rosterPlayers.Sum(p => p.BasePrice);
            ApplyRosterSort();

            _quickSellSuccessMessage = participacao?.Papel is { } papel
                ? $"Conversa feita: {_conversaTarget.Name} agora é {PapelDoJogador.Emoji(papel.Papel)} {PapelDoJogador.Nome(papel.Papel)}."
                : $"Conversa feita com {_conversaTarget.Name}.";
            _conversaTarget = null;
        }
        catch (Exception ex)
        {
            _conversaErro = ex.Message;
        }
        finally
        {
            _conversaProcessando = false;
        }
    }

    private void AbrirSaida(RosterPlayerViewModel player)
    {
        if (!_canQuickSell)
            return;

        _saidaTarget = player;
        _saidaErro = null;
    }

    private void FecharSaida()
    {
        if (_saidaProcessando)
            return;

        _saidaTarget = null;
        _saidaErro = null;
    }

    private async Task PrometerAsync()
    {
        if (_saidaTarget is null || string.IsNullOrWhiteSpace(_currentTeamToken))
            return;

        _saidaProcessando = true;
        _saidaErro = null;
        try
        {
            await OffersApi.PrometerAsync(_saidaTarget.PlayerGuid, _currentTeamToken);

            // Sai da lista e o preço volta à conta da participação.
            var participacao = await ParticipacaoSvc.GetAsync(_saidaTarget.PlayerId, default);
            var preco = await PricingService.CalculateForPlayerAsync(_saidaTarget.PlayerId, default);
            var index = _rosterPlayers.FindIndex(p => p.PlayerGuid == _saidaTarget.PlayerGuid);
            if (index >= 0)
                _rosterPlayers[index] = _rosterPlayers[index] with
                {
                    AskingPrice = null,
                    BasePrice = preco.BasePrice,
                    Participacao = participacao is { } part && part.TimeId == Id ? part : null
                };
            teamAmount = _rosterPlayers.Sum(p => p.BasePrice);
            ApplyRosterSort();

            _quickSellSuccessMessage = $"Promessa feita: {_saidaTarget.Name} saiu da lista. Escale ele como titular "
                + $"{ParticipacaoCriterios.TitularSeguidoParaResolver} jogos seguidos nos próximos {PedidoDeSaidaCriterios.JogosDaPromessa} jogos.";
            _saidaTarget = null;
        }
        catch (Exception ex)
        {
            _saidaErro = ex.Message;
        }
        finally
        {
            _saidaProcessando = false;
        }
    }

    private void OpenListingModal(RosterPlayerViewModel player)
    {
        if (!_canQuickSell)
            return;

        _listingTarget = player;
        _listingPrice = player.AskingPrice ?? 0m;
        _listingErrorMessage = null;
    }

    private void CloseListingModal()
    {
        if (_listingProcessing)
            return;

        _listingTarget = null;
        _listingErrorMessage = null;
    }

    private void OnListingPriceChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        // Tira os pontos de milhar e mantém só dígitos e a vírgula decimal.
        var cleaned = new string(raw.Where(c => char.IsDigit(c) || c == ',').ToArray());

        _listingPrice = decimal.TryParse(cleaned, NumberStyles.AllowDecimalPoint, BrazilCulture, out var parsed)
            ? Math.Max(0m, decimal.Round(parsed, 2, MidpointRounding.AwayFromZero))
            : 0m;
    }

    private async Task SaveListingAsync(decimal? price)
    {
        if (_listingTarget is null || string.IsNullOrWhiteSpace(_currentTeamToken))
            return;

        _listingProcessing = true;
        _listingErrorMessage = null;

        try
        {
            await OffersApi.SetAskingPriceAsync(_listingTarget.PlayerGuid, price, _currentTeamToken);

            var index = _rosterPlayers.FindIndex(p => p.PlayerGuid == _listingTarget.PlayerGuid);
            if (index >= 0)
                _rosterPlayers[index] = _rosterPlayers[index] with { AskingPrice = price };
            ApplyRosterSort();

            _quickSellSuccessMessage = price is decimal valor
                ? $"{_listingTarget.Name} está na lista de transferência por {FormatCurrency(valor)}."
                : $"{_listingTarget.Name} saiu da lista de transferência.";
            _listingTarget = null;
        }
        catch (Exception ex)
        {
            _listingErrorMessage = ex.Message;
        }
        finally
        {
            _listingProcessing = false;
        }
    }

    private string GetSortButtonClass(RosterSortColumn column)
    {
        var classes = "btn btn-link btn-sm p-0 text-decoration-none ordenar";
        if (_activeSortColumn == column)
        {
            classes += " fw-semibold";
        }

        return classes;
    }

    private string GetAriaSort(RosterSortColumn column)
    {
        if (_activeSortColumn != column)
        {
            return "none";
        }

        return _sortDescending ? "descending" : "ascending";
    }

    private string GetSortDirectionDescription(RosterSortColumn column)
    {
        if (_activeSortColumn != column)
        {
            return "Sem ordenação ativa";
        }

        return _sortDescending ? "Ordenado em ordem decrescente" : "Ordenado em ordem crescente";
    }

    private void NavigateToLineups()
    {
        Navigation.NavigateTo($"/teams/{Id}/lineups");
    }

    // Valores redondos sem os centavos ("R$ 26.444.500"); com centavos, o formato completo.
    private static string FormatCurrency(decimal value) =>
        value.ToString(value == decimal.Truncate(value) ? "C0" : "C", BrazilCulture);

    // O Core marca o papel no elenco com um emoji; aqui ele vira um ícone do lucide.
    private static string IconeDoPapel(PapelNoElenco papel) => papel switch
    {
        PapelNoElenco.Titular => "star",
        PapelNoElenco.Disputa => "repeat",
        PapelNoElenco.Rotacao => "armchair",
        _ => "sprout"
    };

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
        TeamAccess.TokenChanged -= OnTeamTokenChanged;
    }

    private MainTab _activeMainTab = MainTab.Info;

    private enum MainTab
    {
        Info,
        Temporada,
        Jogos,
        Historico,
        Retrospectiva,
        Transferencias,
        Negotiations,
        Extrato,
        Treino
    }

    private enum RosterSortColumn
    {
        Position,
        Overall,
        Age,
        BasePrice
    }

    private sealed record RosterPlayerViewModel(
        Guid PlayerGuid,
        int PlayerId,
        string Name,
        string Position,
        int PositionId,
        int Overall,
        int? Age,
        decimal BasePrice,
        decimal? AskingPrice,
        string? EmprestadoPor = null,
        ParticipacaoJogador? Participacao = null);
}
