                        Hoje ele é <strong>@PapelDoJogador.Emoji(papelAlvo.Papel) @PapelDoJogador.Nome(papelAlvo.Papel)</strong>:
                        @PapelDoJogador.OQueEspera(papelAlvo.Papel, papelAlvo.Janela).
                    </p>
                    <p>
                        Na conversa você explica que ele vai jogar menos e o papel passa a
                        <strong>@PapelDoJogador.Emoji(papelNovo) @PapelDoJogador.Nome(papelNovo)</strong>:
                        @PapelDoJogador.OQueEspera(papelNovo, papelAlvo.Janela).
                    </p>
                    <p class="mb-0">
                        Ele não gosta: o valor de mercado cai @Participacao.Rotulo(PapelCriterios.DescontoDaConversa) pelos próximos
                        @PapelCriterios.JogosDaConversa jogos do clube. É <strong>uma conversa por temporada</strong> para o time todo.
                    </p>
                    @if (!string.IsNullOrEmpty(_conversaErro))
                    {
                        <div class="alert alert-danger mt-3 mb-0" role="alert">@_conversaErro</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="FecharConversa" disabled="@_conversaProcessando">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="ConversarAsync" disabled="@_conversaProcessando">
                        @if (_conversaProcessando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        <Icone Nome="message-square" Tamanho="14" /> Conversar
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_listingTarget is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);" role="dialog" aria-modal="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Negociável: @_listingTarget.Name</h5>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="CloseListingModal" disabled="@_listingProcessing"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted">
                        O jogador entra na <a href="/mercado/lista">lista de transferência</a>. Qualquer time pode comprar direto
                        por este valor, na hora, ou mandar uma proposta pelas negociações.
                    </p>
                    <label class="form-label" for="askingPriceInput">Preço pedido</label>
                    <div class="input-group">
                        <span class="input-group-text">R$</span>
                        <input id="askingPriceInput" type="text" class="form-control" inputmode="decimal"
                               value="@(_listingPrice == 0m ? string.Empty : _listingPrice.ToString("N2", BrazilCulture))"
                               @onchange="OnListingPriceChanged"
                               placeholder="0,00" />
                    </div>
                    <div class="form-text">Preço base: @FormatCurrency(_listingTarget.BasePrice)</div>
                    @if (!string.IsNullOrEmpty(_listingErrorMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0" role="alert">@_listingErrorMessage</div>
                    }
                </div>
