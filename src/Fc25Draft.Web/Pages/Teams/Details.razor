@page "/teams/details/{Id:guid}"
@using System.Linq
@using System.Globalization
@using Fc25Draft.Core.Extensions
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Web.Services
@inject TeamsApiClient TeamsApiClient
@inject NavigationManager Navigation
@inject AdminAuthService AdminAuth
@inject IPricingService PricingService
@inject TeamAccessService TeamAccess

@implements IDisposable

<h3>Detalhes do Time</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (!string.IsNullOrEmpty(_quickSellSuccessMessage))
{
    <div class="alert alert-success" role="status">@_quickSellSuccessMessage</div>
}

@if (isLoading)
{
    <p><em>Carregando...</em></p>
}
else if (team is null)
{
    <p>Time não encontrado.</p>
}
else
{
    <dl class="row">
        <dt class="col-sm-3">Nome do Time</dt>
        <dd class="col-sm-9">@team.TeamName</dd>

        <dt class="col-sm-3">Responsável</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(team.OwnerName) ? "-" : team.OwnerName)</dd>

        <dt class="col-sm-3">Jogadores</dt>
        <dd class="col-sm-9">@team.Jogadores</dd>

        <dt class="col-sm-3">Caixa</dt>
        <dd class="col-sm-9">@team.Caixa</dd>

        <dt class="col-sm-3">Valor do Time</dt>
        <dd class="col-sm-9">@FormatCurrency(teamAmount ?? 0m)</dd>

        @if (AdminAuth.IsAuthenticated)
        {
            <dt class="col-sm-3">Token do Time</dt>
            <dd class="col-sm-9"><code>@team.Token</code></dd>
        }
    </dl>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <button type="button"
                class="btn btn-outline-primary"
                @onclick="NavigateToLineups">
            Gerenciar escalações
        </button>
    </div>

    <section class="mt-4" aria-labelledby="team-token-heading">
        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                    <div class="flex-grow-1">
                        <h5 id="team-token-heading" class="card-title mb-2">Token do time</h5>
                        <p class="mb-2">Informe o token compartilhado pelo administrador para liberar ações restritas como a venda rápida neste dispositivo.</p>
                        <span class="badge @(_teamTokenConfigured ? "bg-success" : "bg-secondary")">
                            @(_teamTokenConfigured ? "Token configurado" : "Token não configurado")
                        </span>
                        @if (!string.IsNullOrEmpty(_teamTokenErrorMessage))
                        {
                            <div class="alert alert-warning mt-3 mb-0" role="alert">@_teamTokenErrorMessage</div>
                        }
                        else if (!_teamTokenConfigured)
                        {
                            <p class="text-muted small mb-0 mt-3">Configure o token do time para habilitar a venda rápida.</p>
                        }
                    </div>
                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <button type="button"
                                class="btn btn-outline-primary"
                                @onclick="OpenTeamTokenModal">
                            Configurar token
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="mt-4">
        <h4>Elenco</h4>

        @if (roster is null)
        {
            <p class="text-muted">Não foi possível carregar o elenco da equipe.</p>
        }
        else if (_sortedRosterPlayers.Count == 0)
        {
            <p class="mb-0">Nenhum jogador vinculado.</p>
        }
        else
        {
            <div class="table-responsive-sm p-0">
                <table class="table table-striped table-sm mb-0">
                    <thead>
                        <tr class="align-middle text-center">
                            <th scope="col" class="text-start text-nowrap">Jogador</th>
                            <th scope="col" class="text-center text-nowrap">
                                <button type="button"
                                        class="@GetSortButtonClass(RosterSortColumn.Position)"
                                        @onclick="() => ToggleRosterSort(RosterSortColumn.Position)">
                                    Posição
                                    @if (_activeSortColumn == RosterSortColumn.Position)
                                    {
                                        <span class="ms-1" aria-hidden="true">@(_sortDescending ? "↓" : "↑")</span>
                                        <span class="visually-hidden">@GetSortDirectionDescription(RosterSortColumn.Position)</span>
                                    }
                                </button>
                            </th>
                            <th scope="col" class="text-center">
                                <button type="button"
                                        class="@GetSortButtonClass(RosterSortColumn.Overall)"
                                        @onclick="() => ToggleRosterSort(RosterSortColumn.Overall)">
                                    Overall
                                    @if (_activeSortColumn == RosterSortColumn.Overall)
                                    {
                                        <span class="ms-1" aria-hidden="true">@(_sortDescending ? "↓" : "↑")</span>
                                        <span class="visually-hidden">@GetSortDirectionDescription(RosterSortColumn.Overall)</span>
                                    }
                                </button>
                            </th>
                            <th scope="col" class="text-center">
                                <button type="button"
                                        class="@GetSortButtonClass(RosterSortColumn.Age)"
                                        @onclick="() => ToggleRosterSort(RosterSortColumn.Age)">
                                    Idade
                                    @if (_activeSortColumn == RosterSortColumn.Age)
                                    {
                                        <span class="ms-1" aria-hidden="true">@(_sortDescending ? "↓" : "↑")</span>
                                        <span class="visually-hidden">@GetSortDirectionDescription(RosterSortColumn.Age)</span>
                                    }
                                </button>
                            </th>
                            <th scope="col" class="text-center text-nowrap">
                                <button type="button"
                                        class="@GetSortButtonClass(RosterSortColumn.BasePrice)"
                                        @onclick="() => ToggleRosterSort(RosterSortColumn.BasePrice)">
                                    Preço base
                                    @if (_activeSortColumn == RosterSortColumn.BasePrice)
                                    {
                                        <span class="ms-1" aria-hidden="true">@(_sortDescending ? "↓" : "↑")</span>
                                        <span class="visually-hidden">@GetSortDirectionDescription(RosterSortColumn.BasePrice)</span>
                                    }
                                </button>
                            </th>
                            @if (_canQuickSell)
                            {
                                <th scope="col" class="text-center text-nowrap pe-0">Ações</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var player in _sortedRosterPlayers)
                        {
                            <tr class="align-middle text-center">
                                <td class="text-start text-nowrap">@player.Name</td>
                                <td class="text-center text-nowrap">@player.Position</td>
                                <td>@player.Overall</td>
                                <td>@(player.Age?.ToString(CultureInfo.InvariantCulture) ?? "-")</td>
                                <td class="text-nowrap">@FormatCurrency(player.BasePrice)</td>
                                @if (_canQuickSell)
                                {
                                    <td class="text-center pe-0">
                                        <button type="button" 
                                                class="btn btn-outline-danger btn-sm btn-icon"
                                                style="border-width: 2px;
                                                       border-color: red;
                                                       color: red;
                                                       padding: 2px 4px;
                                                       line-height: 1;
                                                       transition: background-color 0.2s ease;"
                                                title="Quicksell"
                                                aria-label="Vender rapidamente @player.Name"
                                                onmouseover="this.style.backgroundColor='rgba(255, 0, 0, 0.1)';"
                                                onmouseout="this.style.backgroundColor='transparent';"
                                                @onclick="() => OpenQuickSellModal(player)">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                 width="16" height="16" fill="red">
                                                <path d="M7 2v10h3v10l7-12h-4l4-8z" />
                                            </svg>
                                            <span class="visually-hidden">Venda rápida</span>
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <div class="d-flex gap-2 mt-4">
        @if (AdminAuth.IsAuthenticated)
        {
            <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo($"/teams/edit/{team.TeamId}")'>
                Editar
            </button>
        }

        <button class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/teams")'>
            Voltar
        </button>
    </div>
}

@if (_teamTokenModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);" role="dialog" aria-modal="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Configurar token do time</h5>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="CloseTeamTokenModal" disabled="@_teamTokenSaving"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="teamTokenInput">Token</label>
                        <input id="teamTokenInput"
                               class="form-control"
                               @bind="_teamTokenInput"
                               @bind:event="oninput"
                               autocomplete="one-time-code"
                               disabled="@_teamTokenSaving" />
                    </div>
                    @if (!string.IsNullOrEmpty(_teamTokenModalError))
                    {
                        <div class="alert alert-danger" role="alert">@_teamTokenModalError</div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">O token diferencia maiúsculas de minúsculas. Ele será armazenado de forma segura neste navegador.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseTeamTokenModal" disabled="@_teamTokenSaving">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ClearTeamTokenAsync" disabled="@(!_teamTokenConfigured || _teamTokenSaving)">Remover token</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveTeamTokenAsync" disabled="@_teamTokenSaving">
                        @if (_teamTokenSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        Salvar token
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_quickSellModalOpen && _quickSellTarget is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);" role="dialog" aria-modal="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar venda rápida</h5>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="CloseQuickSellModal" disabled="@_quickSellProcessing"></button>
                </div>
                <div class="modal-body">
                    <p>
                        Confirma a venda rápida de <strong>@_quickSellTarget.Name</strong>
                        por <strong>@FormatCurrency(_quickSellPayout)</strong>?
                    </p>
                    <ul class="list-unstyled small mb-0">
                        <li><strong>Overall:</strong> @_quickSellTarget.Overall</li>
                        <li><strong>Preço base:</strong> @FormatCurrency(_quickSellTarget.BasePrice)</li>
                        <li><strong>Pagamento (80%):</strong> @FormatCurrency(_quickSellPayout)</li>
                    </ul>
                    @if (!string.IsNullOrEmpty(_quickSellErrorMessage))
                    {
                        <div class="alert alert-danger mt-3" role="alert">@_quickSellErrorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="CloseQuickSellModal"
                            disabled="@_quickSellProcessing">
                        Cancelar
                    </button>
                    <button type="button"
                            class="btn btn-danger"
                            @onclick="ConfirmQuickSellAsync"
                            disabled="@_quickSellProcessing">
                        @if (_quickSellProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        Confirmar venda
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private TeamDetailsDto? team;
    private decimal? teamAmount;
    private TeamRosterDto? roster;
    private string? errorMessage;
    private bool isLoading = true;
    private bool authInitialized;
    private readonly List<RosterPlayerViewModel> _rosterPlayers = new();
    private IReadOnlyList<RosterPlayerViewModel> _sortedRosterPlayers = Array.Empty<RosterPlayerViewModel>();
    private RosterSortColumn? _activeSortColumn = RosterSortColumn.Position;
    private bool _sortDescending;
    private string? _quickSellSuccessMessage;
    private string? _teamTokenErrorMessage;
    private bool _teamTokenConfigured;
    private bool _canQuickSell;
    private RosterPlayerViewModel? _quickSellTarget;
    private bool _quickSellModalOpen;
    private decimal _quickSellPayout;
    private bool _quickSellProcessing;
    private string? _quickSellErrorMessage;
    private string? _currentTeamToken;
    private bool _teamTokenModalOpen;
    private string _teamTokenInput = string.Empty;
    private string? _teamTokenModalError;
    private bool _teamTokenSaving;
    private static readonly CultureInfo BrazilCulture = CultureInfo.GetCultureInfo("pt-BR");

    protected override void OnInitialized()
    {
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
        TeamAccess.TokenChanged += OnTeamTokenChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadTeamAsync();
        await RefreshTeamTokenStateAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AdminAuth.EnsureInitializedAsync();
        authInitialized = true;
        StateHasChanged();
    }

    private async Task LoadTeamAsync()
    {
        isLoading = true;
        errorMessage = null;
        roster = null;
        _rosterPlayers.Clear();
        _sortedRosterPlayers = Array.Empty<RosterPlayerViewModel>();

        try
        {
            team = await TeamsApiClient.GetByIdAsync(Id);
            if (team is null)
            {
                errorMessage = "Time não encontrado.";
                return;
            }

            roster = await TeamsApiClient.GetRosterByIdAsync(Id);

            if (roster is not null)
            {
                await PopulateRosterPlayersAsync(roster.Jogadores);
            }
            else
            {
                ApplyRosterSort();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnAuthenticationChanged()
    {
        if (!authInitialized)
        {
            return;
        }

        InvokeAsync(StateHasChanged);
    }

    private void OnTeamTokenChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshTeamTokenStateAsync();
            StateHasChanged();
        });
    }

    private async Task PopulateRosterPlayersAsync(IReadOnlyList<TeamRosterPlayerDto> players)
    {
        _rosterPlayers.Clear();

        foreach (var player in players)
        {
            decimal basePrice = 0m;
            try
            {
                var pricing = await PricingService.CalculateForPlayerAsync(player.PlayerId, default);
                basePrice = pricing.BasePrice;
            }
            catch
            {
                basePrice = 0m;
            }

            var positionId = player.Posicao.ToPositionId();

            _rosterPlayers.Add(new RosterPlayerViewModel(
                player.PlayerGuid,
                player.PlayerId,
                player.Nome,
                player.Posicao,
                positionId,
                player.Overall,
                player.Idade,
                basePrice));
        }

        teamAmount = _rosterPlayers.Sum(p => p.BasePrice);
        ApplyRosterSort();
    }

    private async Task RefreshTeamTokenStateAsync()
    {
        _teamTokenErrorMessage = null;
        _canQuickSell = false;
        _currentTeamToken = null;
        _teamTokenConfigured = false;

        string? token;
        try
        {
            token = await TeamAccess.GetTokenAsync();
        }
        catch (InvalidOperationException)
        {
            return;
        }
        catch
        {
            _teamTokenErrorMessage = "Não foi possível verificar o token do time.";
            return;
        }

        if (string.IsNullOrWhiteSpace(token))
        {
            _teamTokenErrorMessage = "Informe o token do seu time para utilizar a venda rápida.";
            return;
        }

        _currentTeamToken = token.Trim();
        _teamTokenConfigured = true;

        try
        {
            var identity = await TeamsApiClient.ResolveIdentityAsync(_currentTeamToken, default);
            if (identity is not null && identity.TeamId == Id)
            {
                _canQuickSell = true;
                _teamTokenErrorMessage = null;
            }
            else if (identity is not null)
            {
                _teamTokenErrorMessage = "O token configurado pertence a outro time.";
            }
            else
            {
                _teamTokenErrorMessage = "Token do time inválido.";
            }
        }
        catch (InvalidOperationException ex)
        {
            _teamTokenErrorMessage = ex.Message;
        }
        catch
        {
            _teamTokenErrorMessage = "Não foi possível validar o token do time.";
        }

        var invalidMessage = TeamAccess.ConsumeInvalidTokenMessage();
        if (!string.IsNullOrWhiteSpace(invalidMessage))
        {
            _teamTokenErrorMessage = invalidMessage;
        }

        if (!string.IsNullOrEmpty(_teamTokenErrorMessage))
        {
            _canQuickSell = false;
        }
    }

    private void ToggleRosterSort(RosterSortColumn column)
    {
        if (_activeSortColumn == column)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _activeSortColumn = column;
            _sortDescending = column switch
            {
                RosterSortColumn.Position => false,
                RosterSortColumn.Age => false,
                _ => true
            };
        }

        ApplyRosterSort();
    }

    private async Task OpenTeamTokenModal()
    {
        if (_teamTokenSaving)
        {
            return;
        }

        _teamTokenModalError = null;

        try
        {
            var token = await TeamAccess.GetTokenAsync();
            _teamTokenInput = token ?? string.Empty;
        }
        catch (InvalidOperationException)
        {
            _teamTokenModalError = "O armazenamento seguro ainda não está disponível. Aguarde o carregamento completo da página e tente novamente.";
            _teamTokenInput = string.Empty;
        }
        catch
        {
            _teamTokenModalError = "Não foi possível carregar o token atual.";
            _teamTokenInput = string.Empty;
        }

        _teamTokenModalOpen = true;
    }

    private void CloseTeamTokenModal()
    {
        if (_teamTokenSaving)
        {
            return;
        }

        _teamTokenModalOpen = false;
        _teamTokenModalError = null;
    }

    private async Task SaveTeamTokenAsync()
    {
        if (_teamTokenSaving)
        {
            return;
        }

        _teamTokenSaving = true;
        _teamTokenModalError = null;

        try
        {
            var trimmed = _teamTokenInput.Trim();
            await TeamAccess.SetTokenAsync(trimmed);
            await RefreshTeamTokenStateAsync();
            _teamTokenModalOpen = false;
        }
        catch (ArgumentException ex)
        {
            _teamTokenModalError = ex.Message;
        }
        catch (InvalidOperationException)
        {
            _teamTokenModalError = "Não foi possível acessar o armazenamento seguro. Recarregue a página e tente novamente.";
        }
        catch
        {
            _teamTokenModalError = "Não foi possível salvar o token. Tente novamente.";
        }
        finally
        {
            _teamTokenSaving = false;
        }
    }

    private async Task ClearTeamTokenAsync()
    {
        if (_teamTokenSaving)
        {
            return;
        }

        _teamTokenSaving = true;
        _teamTokenModalError = null;

        try
        {
            await TeamAccess.ClearTokenAsync();
            await RefreshTeamTokenStateAsync();
            _teamTokenModalOpen = false;
        }
        catch (InvalidOperationException)
        {
            _teamTokenModalError = "Não foi possível acessar o armazenamento seguro. Recarregue a página e tente novamente.";
        }
        catch
        {
            _teamTokenModalError = "Não foi possível remover o token. Tente novamente.";
        }
        finally
        {
            _teamTokenSaving = false;
        }
    }

    private void ApplyRosterSort()
    {
        IEnumerable<RosterPlayerViewModel> query = _rosterPlayers;

        if (_activeSortColumn is null)
        {
            query = query.OrderBy(p => p.PositionId)
                .ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase);
        }
        else
        {
            query = _activeSortColumn switch
            {
                RosterSortColumn.Position => _sortDescending
                    ? query.OrderByDescending(p => p.PositionId).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                    : query.OrderBy(p => p.PositionId).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
                RosterSortColumn.Overall => _sortDescending
                    ? query.OrderByDescending(p => p.Overall).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                    : query.OrderBy(p => p.Overall).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
                RosterSortColumn.Age => _sortDescending
                    ? query.OrderByDescending(p => p.Age ?? int.MinValue).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                    : query.OrderBy(p => p.Age ?? int.MaxValue).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
                RosterSortColumn.BasePrice => _sortDescending
                    ? query.OrderByDescending(p => p.BasePrice).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                    : query.OrderBy(p => p.BasePrice).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
                _ => query
            };
        }

        _sortedRosterPlayers = query.ToList();
    }

    private void OpenQuickSellModal(RosterPlayerViewModel player)
    {
        if (!_canQuickSell)
        {
            return;
        }

        _quickSellTarget = player;
        _quickSellPayout = decimal.Round(player.BasePrice * 0.8m, 2, MidpointRounding.AwayFromZero);
        _quickSellErrorMessage = null;
        _quickSellModalOpen = true;
    }

    private void CloseQuickSellModal()
    {
        if (_quickSellProcessing)
        {
            return;
        }

        _quickSellModalOpen = false;
        _quickSellTarget = null;
        _quickSellErrorMessage = null;
    }

    private async Task ConfirmQuickSellAsync()
    {
        if (_quickSellTarget is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_currentTeamToken))
        {
            _quickSellErrorMessage = "Token do time não configurado.";
            return;
        }

        _quickSellProcessing = true;
        _quickSellErrorMessage = null;

        try
        {
            var result = await TeamsApiClient.QuickSellAsync(Id, _quickSellTarget.PlayerGuid, _currentTeamToken, default);
            var formattedBudget = result.TeamBudgetAfter.ToString("C", BrazilCulture);
            if (team is not null)
            {
                var remainingPlayers = Math.Max(0, team.Jogadores - 1);
                team = team with { Caixa = formattedBudget, Jogadores = remainingPlayers };
            }

            var newAmount = (teamAmount ?? 0m) - _quickSellTarget.BasePrice;
            teamAmount = newAmount < 0m ? 0m : newAmount;

            _rosterPlayers.RemoveAll(p => p.PlayerGuid == _quickSellTarget.PlayerGuid);
            ApplyRosterSort();

            _quickSellSuccessMessage = $"Jogador {_quickSellTarget.Name} vendido por {FormatCurrency(result.Payout)}. Caixa atualizado.";
            _quickSellModalOpen = false;
            _quickSellTarget = null;
            _quickSellPayout = 0m;
        }
        catch (KeyNotFoundException ex)
        {
            _quickSellErrorMessage = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _quickSellErrorMessage = ex.Message;

            if (ex.Message.Contains("token", StringComparison.OrdinalIgnoreCase))
            {
                TeamAccess.ReportInvalidToken(ex.Message);
                await RefreshTeamTokenStateAsync();
            }
        }
        finally
        {
            _quickSellProcessing = false;
        }
    }

    private string GetSortButtonClass(RosterSortColumn column)
    {
        var classes = "btn btn-link btn-sm p-0 text-decoration-none text-body";
        if (_activeSortColumn == column)
        {
            classes += " fw-semibold";
        }

        return classes;
    }

    private string GetAriaSort(RosterSortColumn column)
    {
        if (_activeSortColumn != column)
        {
            return "none";
        }

        return _sortDescending ? "descending" : "ascending";
    }

    private string GetSortDirectionDescription(RosterSortColumn column)
    {
        if (_activeSortColumn != column)
        {
            return "Sem ordenação ativa";
        }

        return _sortDescending ? "Ordenado em ordem decrescente" : "Ordenado em ordem crescente";
    }

    private void NavigateToLineups()
    {
        Navigation.NavigateTo($"/teams/{Id}/lineups");
    }

    private static string FormatCurrency(decimal value) => value.ToString("C", BrazilCulture);

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
        TeamAccess.TokenChanged -= OnTeamTokenChanged;
    }

    private enum RosterSortColumn
    {
        Position,
        Overall,
        Age,
        BasePrice
    }

    private sealed record RosterPlayerViewModel(
        Guid PlayerGuid,
        int PlayerId,
        string Name,
        string Position,
        int PositionId,
        int Overall,
        int? Age,
        decimal BasePrice);
}
