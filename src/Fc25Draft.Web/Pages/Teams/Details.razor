@page "/teams/details/{Id:guid}"
@using System.Linq
@using System.Globalization
@using System.Net
@using Fc25Draft.Core.Extensions
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Web.Services
@inject TeamsApiClient TeamsApiClient
@inject NavigationManager Navigation
@inject AdminAuthService AdminAuth
@inject IPricingService PricingService
@inject TeamAccessService TeamAccess

@implements IDisposable

<h3>Detalhes do Time</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (!string.IsNullOrEmpty(teamAccessWarning))
{
    <div class="alert alert-warning" role="alert">@teamAccessWarning</div>
}

@if (isLoading)
{
    <p><em>Carregando...</em></p>
}
else if (team is null)
{
    <p>Time não encontrado.</p>
}
else
{
    <dl class="row">
        <dt class="col-sm-3">Nome do Time</dt>
        <dd class="col-sm-9">@team.TeamName</dd>

        <dt class="col-sm-3">Responsável</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(team.OwnerName) ? "-" : team.OwnerName)</dd>

        <dt class="col-sm-3">Jogadores</dt>
        <dd class="col-sm-9">@_teamPlayersCount</dd>

        <dt class="col-sm-3">Caixa</dt>
        <dd class="col-sm-9">@(_teamBudgetDisplay ?? team.Caixa)</dd>

        <dt class="col-sm-3">Valor do Time</dt>
        <dd class="col-sm-9">@FormatCurrency(teamAmount ?? 0m)</dd>

        @if (AdminAuth.IsAuthenticated)
        {
            <dt class="col-sm-3">Token do Time</dt>
            <dd class="col-sm-9"><code>@team.Token</code></dd>
        }
    </dl>

    <section class="mt-4">
        <h4>Elenco</h4>

        @if (roster is null)
        {
            <p class="text-muted">Não foi possível carregar o elenco da equipe.</p>
        }
        else if (_sortedRosterPlayers.Count == 0)
        {
            <p class="mb-0">Nenhum jogador vinculado.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-sm mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Jogador</th>
                            <th scope="col" class="text-center" aria-sort="@GetAriaSort(RosterSortColumn.Position)">
                                <button type="button"
                                        class="@GetSortButtonClass(RosterSortColumn.Position)"
                                        @onclick="() => ToggleRosterSort(RosterSortColumn.Position)">
                                    Posição
                                    @if (_activeSortColumn == RosterSortColumn.Position)
                                    {
                                        <span class="ms-1" aria-hidden="true">@(_sortDescending ? "▼" : "▲")</span>
                                        <span class="visually-hidden">@GetSortDirectionDescription(RosterSortColumn.Position)</span>
                                    }
                                </button>
                            </th>
                            <th scope="col" class="text-end" aria-sort="@GetAriaSort(RosterSortColumn.Overall)">
                                <button type="button"
                                        class="@GetSortButtonClass(RosterSortColumn.Overall)"
                                        @onclick="() => ToggleRosterSort(RosterSortColumn.Overall)">
                                    Overall
                                    @if (_activeSortColumn == RosterSortColumn.Overall)
                                    {
                                        <span class="ms-1" aria-hidden="true">@(_sortDescending ? "▼" : "▲")</span>
                                        <span class="visually-hidden">@GetSortDirectionDescription(RosterSortColumn.Overall)</span>
                                    }
                                </button>
                            </th>
                            <th scope="col" class="text-end" aria-sort="@GetAriaSort(RosterSortColumn.Age)">
                                <button type="button"
                                        class="@GetSortButtonClass(RosterSortColumn.Age)"
                                        @onclick="() => ToggleRosterSort(RosterSortColumn.Age)">
                                    Idade
                                    @if (_activeSortColumn == RosterSortColumn.Age)
                                    {
                                        <span class="ms-1" aria-hidden="true">@(_sortDescending ? "▼" : "▲")</span>
                                        <span class="visually-hidden">@GetSortDirectionDescription(RosterSortColumn.Age)</span>
                                    }
                                </button>
                            </th>
                            <th scope="col" class="text-end" aria-sort="@GetAriaSort(RosterSortColumn.BasePrice)">
                                <button type="button"
                                        class="@GetSortButtonClass(RosterSortColumn.BasePrice)"
                                        @onclick="() => ToggleRosterSort(RosterSortColumn.BasePrice)">
                                    Preço base
                                    @if (_activeSortColumn == RosterSortColumn.BasePrice)
                                    {
                                        <span class="ms-1" aria-hidden="true">@(_sortDescending ? "▼" : "▲")</span>
                                        <span class="visually-hidden">@GetSortDirectionDescription(RosterSortColumn.BasePrice)</span>
                                    }
                                </button>
                            </th>
                            <th scope="col" class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var player in _sortedRosterPlayers)
                        {
                            <tr>
                                <td>@player.Name</td>
                                <td class="text-center">@player.Position</td>
                                <td class="text-end">@player.Overall</td>
                                <td class="text-end">@(player.Age?.ToString(CultureInfo.InvariantCulture) ?? "-")</td>
                                <td class="text-end">@FormatCurrency(player.BasePrice)</td>
                                <td class="text-center">
                                    @if (_hasTeamAccess)
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => OpenQuickSellModal(player)">
                                            Quick Sell
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (_showQuickSellModal && _quickSellTarget is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0, 0, 0, 0.5);">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirmar Quick Sell</h5>
                        <button type="button" class="btn-close" aria-label="Fechar" @onclick="CloseQuickSellModal" disabled="@_quickSellSubmitting"></button>
                    </div>
                    <div class="modal-body">
                        <p>
                            Você tem certeza que deseja vender <strong>@_quickSellTarget.Name</strong> por
                            <strong>@FormatCurrency(_quickSellPayout)</strong>?
                        </p>
                        <ul class="list-unstyled mb-3">
                            <li><strong>Overall atual:</strong> @_quickSellTarget.Overall</li>
                            <li><strong>Preço base:</strong> @FormatCurrency(_quickSellTarget.BasePrice)</li>
                            <li><strong>Payout (80%):</strong> @FormatCurrency(_quickSellPayout)</li>
                        </ul>
                        @if (!string.IsNullOrEmpty(_quickSellError))
                        {
                            <div class="alert alert-danger" role="alert">@_quickSellError</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseQuickSellModal" disabled="@_quickSellSubmitting">Cancelar</button>
                        <button type="button" class="btn btn-danger" @onclick="ConfirmQuickSellAsync" disabled="@_quickSellSubmitting">
                            @_quickSellSubmitting ? "Processando..." : "Confirmar"
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="d-flex gap-2 mt-4">
        @if (AdminAuth.IsAuthenticated)
        {
            <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo($"/teams/edit/{team.TeamId}")'>
                Editar
            </button>
        }

        <button class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/teams")'>
            Voltar
        </button>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private TeamDetailsDto? team;
    private decimal? teamAmount;
    private TeamRosterDto? roster;
    private string? errorMessage;
    private string? successMessage;
    private string? teamAccessWarning;
    private bool isLoading = true;
    private bool authInitialized;
    private readonly List<RosterPlayerViewModel> _rosterPlayers = new();
    private IReadOnlyList<RosterPlayerViewModel> _sortedRosterPlayers = Array.Empty<RosterPlayerViewModel>();
    private RosterSortColumn? _activeSortColumn = RosterSortColumn.Position;
    private bool _sortDescending;
    private bool _hasTeamAccess;
    private bool _showQuickSellModal;
    private RosterPlayerViewModel? _quickSellTarget;
    private decimal _quickSellPayout;
    private bool _quickSellSubmitting;
    private string? _quickSellError;
    private string? _teamBudgetDisplay;
    private int _teamPlayersCount;
    private string? _teamToken;
    private static readonly CultureInfo BrazilCulture = CultureInfo.GetCultureInfo("pt-BR");

    protected override void OnInitialized()
    {
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
        TeamAccess.TokenChanged += OnTeamTokenChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadTeamAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AdminAuth.EnsureInitializedAsync();
        authInitialized = true;
        await RefreshTeamAccessAsync();
        StateHasChanged();
    }

    private async Task LoadTeamAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;
        roster = null;
        _rosterPlayers.Clear();
        _sortedRosterPlayers = Array.Empty<RosterPlayerViewModel>();

        try
        {
            team = await TeamsApiClient.GetByIdAsync(Id);
            if (team is null)
            {
                errorMessage = "Time não encontrado.";
                return;
            }

            _teamPlayersCount = team.Jogadores;
            _teamBudgetDisplay = team.Caixa;

            roster = await TeamsApiClient.GetRosterByIdAsync(Id);

            if (roster is not null)
            {
                await PopulateRosterPlayersAsync(roster.Jogadores);
            }
            else
            {
                ApplyRosterSort();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnAuthenticationChanged()
    {
        if (!authInitialized)
        {
            return;
        }

        InvokeAsync(StateHasChanged);
    }

    private async Task PopulateRosterPlayersAsync(IReadOnlyList<TeamRosterPlayerDto> players)
    {
        _rosterPlayers.Clear();

        foreach (var player in players)
        {
            decimal basePrice = 0m;
            try
            {
                var pricing = await PricingService.CalculateForPlayerAsync(player.PlayerId, default);
                basePrice = pricing.BasePrice;
            }
            catch
            {
                basePrice = 0m;
            }

            var positionId = player.Posicao.ToPositionId();

            _rosterPlayers.Add(new RosterPlayerViewModel(
                player.PlayerGuid,
                player.PlayerId,
                player.Nome,
                player.Posicao,
                positionId,
                player.Overall,
                player.Idade,
                basePrice));
        }

        teamAmount = _rosterPlayers.Sum(p => p.BasePrice);
        ApplyRosterSort();
    }

    private async Task RefreshTeamAccessAsync()
    {
        string? token;

        try
        {
            token = await TeamAccess.GetTokenAsync();
        }
        catch (InvalidOperationException)
        {
            return;
        }
        catch
        {
            _teamToken = null;
            _hasTeamAccess = false;
            teamAccessWarning = "Não foi possível validar o token do time.";
            return;
        }

        if (string.IsNullOrWhiteSpace(token))
        {
            _teamToken = null;
            _hasTeamAccess = false;
            teamAccessWarning = null;
            return;
        }

        _teamToken = token.Trim();

        try
        {
            var identity = await TeamsApiClient.GetIdentityByTokenAsync(_teamToken, default);
            if (identity is not null && identity.TeamId == Id)
            {
                _hasTeamAccess = true;
                teamAccessWarning = null;
            }
            else if (identity is not null)
            {
                _hasTeamAccess = false;
                teamAccessWarning = "O token configurado pertence a outro time.";
            }
            else
            {
                _hasTeamAccess = false;
                teamAccessWarning = "Token inválido.";
            }
        }
        catch (TeamsApiClient.TeamApiException ex)
        {
            _hasTeamAccess = false;
            teamAccessWarning = ex.Message;
        }
        catch
        {
            _hasTeamAccess = false;
            teamAccessWarning = "Não foi possível validar o token do time.";
        }
    }

    private void ToggleRosterSort(RosterSortColumn column)
    {
        if (_activeSortColumn == column)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _activeSortColumn = column;
            _sortDescending = column switch
            {
                RosterSortColumn.Position => false,
                RosterSortColumn.Age => false,
                _ => true
            };
        }

        ApplyRosterSort();
    }

    private void ApplyRosterSort()
    {
        IEnumerable<RosterPlayerViewModel> query = _rosterPlayers;

        if (_activeSortColumn is null)
        {
            query = query.OrderBy(p => p.PositionId)
                .ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase);
        }
        else
        {
            query = _activeSortColumn switch
            {
                RosterSortColumn.Position => _sortDescending
                    ? query.OrderByDescending(p => p.PositionId).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                    : query.OrderBy(p => p.PositionId).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
                RosterSortColumn.Overall => _sortDescending
                    ? query.OrderByDescending(p => p.Overall).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                    : query.OrderBy(p => p.Overall).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
                RosterSortColumn.Age => _sortDescending
                    ? query.OrderByDescending(p => p.Age ?? int.MinValue).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                    : query.OrderBy(p => p.Age ?? int.MaxValue).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
                RosterSortColumn.BasePrice => _sortDescending
                    ? query.OrderByDescending(p => p.BasePrice).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                    : query.OrderBy(p => p.BasePrice).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
                _ => query
            };
        }

        _sortedRosterPlayers = query.ToList();
    }

    private void OpenQuickSellModal(RosterPlayerViewModel player)
    {
        if (!_hasTeamAccess)
        {
            return;
        }

        _quickSellTarget = player;
        _quickSellPayout = decimal.Round(player.BasePrice * 0.8m, 2, MidpointRounding.AwayFromZero);
        _quickSellError = null;
        _showQuickSellModal = true;
    }

    private void CloseQuickSellModal()
    {
        if (_quickSellSubmitting)
        {
            return;
        }

        _showQuickSellModal = false;
        _quickSellTarget = null;
        _quickSellError = null;
    }

    private async Task ConfirmQuickSellAsync()
    {
        if (_quickSellTarget is null)
        {
            return;
        }

        _quickSellSubmitting = true;
        _quickSellError = null;
        successMessage = null;

        try
        {
            var token = _teamToken;
            if (string.IsNullOrWhiteSpace(token))
            {
                token = await TeamAccess.GetTokenAsync();
            }

            if (string.IsNullOrWhiteSpace(token))
            {
                _quickSellError = "Token do time não configurado.";
                return;
            }

            var result = await TeamsApiClient.QuickSellAsync(Id, _quickSellTarget.PlayerGuid, token, default);

            _rosterPlayers.RemoveAll(p => p.PlayerGuid == _quickSellTarget.PlayerGuid);
            teamAmount = _rosterPlayers.Sum(p => p.BasePrice);
            ApplyRosterSort();

            if (_teamPlayersCount > 0)
            {
                _teamPlayersCount--;
            }

            _teamBudgetDisplay = FormatCurrency(result.TeamBudgetAfter);
            successMessage = $"Jogador {_quickSellTarget.Name} vendido por {FormatCurrency(result.Payout)}. Orçamento do time atualizado.";

            _showQuickSellModal = false;
            _quickSellTarget = null;
        }
        catch (TeamsApiClient.TeamApiException ex)
        {
            _quickSellError = ex.Message;

            if (ex.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
            {
                TeamAccess.ReportInvalidToken(ex.Message);
                try
                {
                    await TeamAccess.ClearTokenAsync();
                }
                catch
                {
                }

                await RefreshTeamAccessAsync();
            }
        }
        catch
        {
            _quickSellError = "Ocorreu um erro ao processar o Quick Sell.";
        }
        finally
        {
            _quickSellSubmitting = false;
        }

        if (!_showQuickSellModal)
        {
            await RefreshTeamAccessAsync();
        }
    }

    private string GetSortButtonClass(RosterSortColumn column)
    {
        var classes = "btn btn-link btn-sm p-0 text-decoration-none text-body";
        if (_activeSortColumn == column)
        {
            classes += " fw-semibold";
        }

        return classes;
    }

    private string GetAriaSort(RosterSortColumn column)
    {
        if (_activeSortColumn != column)
        {
            return "none";
        }

        return _sortDescending ? "descending" : "ascending";
    }

    private string GetSortDirectionDescription(RosterSortColumn column)
    {
        if (_activeSortColumn != column)
        {
            return "Sem ordenação ativa";
        }

        return _sortDescending ? "Ordenado em ordem decrescente" : "Ordenado em ordem crescente";
    }

    private static string FormatCurrency(decimal value) => value.ToString("C", BrazilCulture);

    private void OnTeamTokenChanged()
    {
        if (!authInitialized)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await RefreshTeamAccessAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
        TeamAccess.TokenChanged -= OnTeamTokenChanged;
    }

    private enum RosterSortColumn
    {
        Position,
        Overall,
        Age,
        BasePrice
    }

    private sealed record RosterPlayerViewModel(Guid PlayerGuid, int PlayerId, string Name, string Position, int PositionId, int Overall, int? Age, decimal BasePrice);
}
