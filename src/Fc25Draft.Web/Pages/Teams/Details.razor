@page "/teams/details/{Id:guid}"
@inject ITeamService TeamService
@inject NavigationManager Navigation

<h3>Deatalhes do Time</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <p><em>Carregando...</em></p>
}
else if (team is null)
{
    <p>Time não encontrado</p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Nome do Time</dt>
        <dd class="col-sm-10">@team.TeamName</dd>

        <dt class="col-sm-2">Nome Presidente</dt>
        <dd class="col-sm-10">@(string.IsNullOrWhiteSpace(team.OwnerName) ? "-" : team.OwnerName)</dd>

        <dt class="col-sm-2">Team Token</dt>
        <dd class="col-sm-10"><code>@team.TeamToken</code></dd>
    </dl>

    <div class="d-flex gap-2">
        <div class="d-flex gap-2">
            <button class="btn btn-primary"
                    @onclick="@(() => Navigation.NavigateTo($"/teams/edit/{team!.TeamId}"))">
                Editar
            </button>

            <button class="btn btn-secondary"
                    @onclick="@(() => Navigation.NavigateTo("/teams"))">
                Voltar
            </button>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Team? team;
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            team = await TeamService.GetAsync(Id);
            if (team is null)
            {
                errorMessage = "Time não encontrado.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
