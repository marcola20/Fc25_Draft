@page "/teams/details/{Id:guid}"
@inject ITeamService TeamService
@inject NavigationManager Navigation

<h3>Detalhes do Time</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <p><em>Carregando...</em></p>
}
else if (team is null)
{
    <p>Time não encontrado.</p>
}
else
{
    <dl class="row">
        <dt class="col-sm-3">Nome do Time</dt>
        <dd class="col-sm-9">@team.TeamName</dd>

        <dt class="col-sm-3">Responsável</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(team.OwnerName) ? "-" : team.OwnerName)</dd>

        <dt class="col-sm-3">Token da Equipe</dt>
        <dd class="col-sm-9"><code>@team.TeamToken</code></dd>
    </dl>

    <div class="d-flex gap-2">
        <button class="btn btn-primary"
                @onclick="@(() => Navigation.NavigateTo($"/teams/edit/{team!.TeamId}"))">
            Editar
        </button>

        <button class="btn btn-secondary"
                @onclick="@(() => Navigation.NavigateTo("/teams"))">
            Voltar
        </button>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Team? team;
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            team = await TeamService.GetAsync(Id);
            if (team is null)
            {
                errorMessage = "Time não encontrado.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
