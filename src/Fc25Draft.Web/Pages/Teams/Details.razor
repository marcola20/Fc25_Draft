                    @if (_listingTarget.AskingPrice is not null)
                    {
                        <button type="button" class="btn btn-outline-danger me-auto" @onclick="() => SaveListingAsync(null)" disabled="@_listingProcessing">
                            Tirar da lista
                        </button>
                    }
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseListingModal" disabled="@_listingProcessing">Cancelar</button>
                    <button type="button" class="btn btn-warning" @onclick="() => SaveListingAsync(_listingPrice)" disabled="@(_listingProcessing || _listingPrice <= 0m)">
                        @if (_listingProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
