@page "/teams/details/{Id:guid}"
@using System.Linq
@using System.Globalization
@using Fc25Draft.Core.Extensions
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Interfaces
@using Fc25Draft.Core.Utilities
@using Fc25Draft.Web.Services
@using Fc25Draft.Web.Utilities
@inject ILigaPublicService LigaService
@inject TeamsApiClient TeamsApiClient
@inject NavigationManager Navigation
@inject AdminAuthService AdminAuth
@inject IPricingService PricingService
@inject IParticipacaoService ParticipacaoSvc
@inject ITransferConfigService TransferConfigSvc
@inject TeamAccessService TeamAccess
@inject TransferOffersApiClient OffersApi
@inject IEmprestimoService EmprestimoSvc
@inject EscudoService Escudos

@implements IDisposable

<PageTitle>@(team?.TeamName ?? "Time")</PageTitle>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (!string.IsNullOrEmpty(_quickSellSuccessMessage))
{
    <div class="alert alert-success" role="status">@_quickSellSuccessMessage</div>
}

@if (isLoading)
{
    <div class="text-center py-5"><span class="spinner-border" role="status" aria-label="Carregando"></span></div>
}
else if (team is null)
{
    <div class="alert alert-secondary">Time não encontrado.</div>
}
else
{
    <section class="time-topo" aria-label="@team.TeamName">
        <img src="@Escudos.GetEscudo(team.TeamName)" alt="" class="time-escudo" width="80" height="80" />
        <div class="time-identidade">
            <h1>@team.TeamName</h1>
            <p class="time-comissao">
                <span>Técnico <strong>@(string.IsNullOrWhiteSpace(team.OwnerName) ? "—" : team.OwnerName)</strong></span>
                @if (!string.IsNullOrWhiteSpace(team.AuxiliarName))
                {
                    <span>Auxiliar <strong>@team.AuxiliarName</strong></span>
                }
            </p>

            @if (_trajetoria.Count > 0 || _titulosCopas.Count > 0)
            {
                <div class="trajetoria" aria-label="Trajetória">
                    @if (_titulos > 0)
                    {
                        <span class="chip chip-titulo"><Icone Nome="trophy" Tamanho="14" /> @_titulos título@(_titulos > 1 ? "s" : "")</span>
                    }
                    @foreach (var c in _titulosCopas)
                    {
                        <span class="chip chip-titulo" title="@c.LigaNome">
                            <Icone Nome="trophy" Tamanho="14" /> @(c.Temporada is int ano ? $"{ano} · " : "")@LigaLabels.Competicao(c.Tipo, null)
                        </span>
                    }
                    @foreach (var tr in _trajetoria)
                    {
                        <span class="chip @ZonaEstilo.Linha(tr.Zona)" title="@tr.LigaNome">
                            <span class="legenda-cor"></span>
                            @tr.Temporada · @LigaLabels.DivisaoNome(tr.Divisao) · <span class="numero">@(tr.Posicao)º</span>@(tr.Encerrada ? "" : " (em andamento)")
                            @if (tr.Campeao) { <Icone Nome="trophy" Tamanho="12" Classe="text-acento" /> }
                            @if (tr.Movimento == "Promovido") { <Icone Nome="arrow-up" Tamanho="12" Classe="chip-sobe" /> }
                            @if (tr.Movimento == "Rebaixado") { <Icone Nome="arrow-down" Tamanho="12" Classe="chip-cai" /> }
                        </span>
                    }
                </div>
            }
        </div>

        <dl class="time-numeros">
            <div>
                <dt>Jogadores</dt>
                <dd class="numero">@team.Jogadores</dd>
            </div>
            <div>
                <dt>Valor do elenco</dt>
                <dd class="numero">@FormatCurrency(teamAmount ?? 0m)</dd>
            </div>
            @* O caixa é só do próprio time (e da organização): os outros não veem. *@
            @if (_canQuickSell || AdminAuth.IsAdmin)
            {
                <div>
                    <dt>Caixa</dt>
                    <dd class="numero">@team.Caixa</dd>
                </div>
            }
        </dl>
    </section>

    <div class="time-acoes">
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="NavigateToLineups">
            <Icone Nome="users" Tamanho="14" /> Gerenciar escalações
        </button>
        <BotaoAgenda TeamId="@Id" Classe="btn-sm btn-outline-secondary" />
        @if (AdminAuth.IsAdmin)
        {
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick='() => Navigation.NavigateTo($"/teams/edit/{team.TeamId}")'>
                <Icone Nome="pencil" Tamanho="14" /> Editar
            </button>
        }
    </div>

    @if (AdminAuth.IsAdmin && (!string.IsNullOrWhiteSpace(team.Token) || !string.IsNullOrWhiteSpace(team.AuxToken)))
    {
        <details class="time-admin">
            <summary><Icone Nome="key" Tamanho="14" /> Tokens de acesso</summary>
            <dl>
                @if (!string.IsNullOrWhiteSpace(team.Token))
                {
                    <dt>Treinador</dt>
                    <dd><code>@team.Token</code></dd>
                }
                @if (!string.IsNullOrWhiteSpace(team.AuxToken))
                {
                    <dt>Auxiliar</dt>
                    <dd><code>@team.AuxToken</code></dd>
                }
            </dl>
            <p class="small text-body-secondary mb-0">
                O token é da pessoa, não do time: <a href="/admin/treinadores">cadastro de treinadores</a>.
            </p>
        </details>
    }

    <TimeResumoFaixa Perfil="@_perfil" />

    @* As chaves levam um prefixo: a diretoria e a aba aberta ficam lado a lado na página, e duas
       chaves iguais (só o Id do time) derrubavam a conexão inteira ao renderizar. *@
    <DiretoriaCard @key="@($"diretoria-{Id}")" TeamId="@Id" />

    <ComissaoTecnica TeamId="@Id" />

    <ul class="nav nav-tabs mt-4 mb-4" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeMainTab == MainTab.Info ? "active" : "")"
                    type="button" @onclick="() => _activeMainTab = MainTab.Info">
                Informações
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeMainTab == MainTab.Temporada ? "active" : "")"
                    type="button" @onclick="() => _activeMainTab = MainTab.Temporada">
                Temporada
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeMainTab == MainTab.Jogos ? "active" : "")"
                    type="button" @onclick="() => _activeMainTab = MainTab.Jogos">
                Jogos
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeMainTab == MainTab.Historico ? "active" : "")"
                    type="button" @onclick="() => _activeMainTab = MainTab.Historico">
                Histórico
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeMainTab == MainTab.Retrospectiva ? "active" : "")"
                    type="button" @onclick="() => _activeMainTab = MainTab.Retrospectiva">
                Retrospectiva
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeMainTab == MainTab.Transferencias ? "active" : "")"
                    type="button" @onclick="() => _activeMainTab = MainTab.Transferencias">
                Transferências
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeMainTab == MainTab.Treino ? "active" : "")"
                    type="button" @onclick="() => _activeMainTab = MainTab.Treino">
                Treino
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeMainTab == MainTab.Extrato ? "active" : "")"
                    type="button" @onclick="() => _activeMainTab = MainTab.Extrato">
                Extrato
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeMainTab == MainTab.Negotiations ? "active" : "")"
                    type="button" @onclick="() => _activeMainTab = MainTab.Negotiations"
                    disabled="@(!_canQuickSell)">
                Negociações
            </button>
        </li>
    </ul>

    @if (_activeMainTab == MainTab.Negotiations)
    {
        <Negotiations @key="@($"negociacoes-{Id}")" TeamId="@Id" TeamToken="@_currentTeamToken" TransferCount="@(team?.TransferCount ?? 0)"
                      PropostaPorJogador="@_propostaPorJogador" />
    }
    else if (_activeMainTab == MainTab.Temporada)
    {
        <TimeTemporadaTab @key="@($"temporada-{Id}")" TeamId="@Id" />
    }
    else if (_activeMainTab == MainTab.Jogos)
    {
        <TimeJogosTab Perfil="@_perfil" />
    }
    else if (_activeMainTab == MainTab.Historico)
    {
        <TimeHistoricoTab @key="@($"historico-{Id}")" TeamId="@Id" />
    }
    else if (_activeMainTab == MainTab.Retrospectiva)
    {
        <TimeRetrospectivaTab @key="@($"retrospectiva-{Id}")" TeamId="@Id" />
    }
    else if (_activeMainTab == MainTab.Transferencias)
    {
        <TimeTransferenciasTab @key="@($"transferencias-{Id}")" TeamId="@Id" />
    }
    else if (_activeMainTab == MainTab.Treino)
    {
        <TimeTreinoTab @key="@($"treino-{Id}")" TeamId="@Id" TeamToken="@(_canQuickSell ? _currentTeamToken : null)" />
    }
    else if (_activeMainTab == MainTab.Extrato)
    {
        <TimeExtratoTab @key="@($"extrato-{Id}")" TeamId="@Id" />
    }
    else
    {

    @if (!string.IsNullOrEmpty(_teamTokenErrorMessage))
    {
        <div class="alert alert-warning mt-3" role="alert">@_teamTokenErrorMessage</div>
    }

    <section>
        <div class="secao-titulo">
            <h2>Elenco</h2>
        </div>

        @if (_canQuickSell && _quickSellBloqueado)
        {
            <div class="alert alert-secondary py-2 small" role="status">
                As <strong>vendas rápidas estão bloqueadas</strong> no momento. A organização libera quando a janela abrir.
            </div>
        }

        @if (roster is null)
        {
            <p class="text-muted">Não foi possível carregar o elenco da equipe.</p>
        }
        else if (_sortedRosterPlayers.Count == 0)
        {
            <p class="mb-0">Nenhum jogador vinculado.</p>
        }
        else
        {
            <div class="table-responsive painel">
                <table class="table table-hover align-middle mb-0 tabela-elenco">
                    <thead>
                        <tr class="align-middle text-center">
                            <th scope="col" class="text-start text-nowrap">Jogador</th>
                            <th scope="col" class="text-center text-nowrap">
                                <button type="button"
                                        class="@GetSortButtonClass(RosterSortColumn.Position)"
                                        @onclick="() => ToggleRosterSort(RosterSortColumn.Position)">
                                    Posição
                                    @if (_activeSortColumn == RosterSortColumn.Position)
                                    {
                                        <Icone Nome="@(_sortDescending ? "arrow-down" : "arrow-up")" Tamanho="12" />
                                        <span class="visually-hidden">@GetSortDirectionDescription(RosterSortColumn.Position)</span>
                                    }
                                </button>
                            </th>
                            <th scope="col" class="text-center">
                                <button type="button"
                                        class="@GetSortButtonClass(RosterSortColumn.Overall)"
                                        @onclick="() => ToggleRosterSort(RosterSortColumn.Overall)">
                                    Overall
                                    @if (_activeSortColumn == RosterSortColumn.Overall)
                                    {
                                        <Icone Nome="@(_sortDescending ? "arrow-down" : "arrow-up")" Tamanho="12" />
                                        <span class="visually-hidden">@GetSortDirectionDescription(RosterSortColumn.Overall)</span>
                                    }
                                </button>
                            </th>
                            <th scope="col" class="text-center">
                                <button type="button"
                                        class="@GetSortButtonClass(RosterSortColumn.Age)"
                                        @onclick="() => ToggleRosterSort(RosterSortColumn.Age)">
                                    Idade
                                    @if (_activeSortColumn == RosterSortColumn.Age)
                                    {
                                        <Icone Nome="@(_sortDescending ? "arrow-down" : "arrow-up")" Tamanho="12" />
                                        <span class="visually-hidden">@GetSortDirectionDescription(RosterSortColumn.Age)</span>
                                    }
                                </button>
                            </th>
                            <th scope="col" class="text-end text-nowrap">
                                <button type="button"
                                        class="@GetSortButtonClass(RosterSortColumn.BasePrice)"
                                        @onclick="() => ToggleRosterSort(RosterSortColumn.BasePrice)">
                                    Preço base
                                    @if (_activeSortColumn == RosterSortColumn.BasePrice)
                                    {
                                        <Icone Nome="@(_sortDescending ? "arrow-down" : "arrow-up")" Tamanho="12" />
                                        <span class="visually-hidden">@GetSortDirectionDescription(RosterSortColumn.BasePrice)</span>
                                    }
                                </button>
                            </th>
                            @if (_canQuickSell)
                            {
                                <th scope="col" class="text-center text-nowrap pe-0">Ações</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var player in _sortedRosterPlayers)
                        {
                            <tr class="align-middle text-center">
                                <td class="text-start text-nowrap">
                                    <FotoJogador PlayerId="@player.PlayerId" Tamanho="28" Classe="me-2" />
                                    <a href="/players/details/@player.PlayerId" class="jogador-nome">@player.Name</a>
                                    @if (player.Participacao is { Papel: { } papel } comPapel)
                                    {
                                        <span class="papel ms-1" role="img" aria-label="@PapelDoJogador.Nome(papel.Papel)" title="@TituloPapel(comPapel)"><Icone Nome="@IconeDoPapel(papel.Papel)" Tamanho="14" /></span>
                                    }
                                    @if (player.AskingPrice is decimal preco)
                                    {
                                        <span class="etiqueta acento ms-1" title="Negociável: qualquer time pode comprar direto por este valor">
                                            <Icone Nome="tag" Tamanho="12" /> À venda · @FormatCurrency(preco)
                                        </span>
                                    }
                                    @if (player.EmprestadoPor is string dono)
                                    {
                                        <span class="etiqueta ms-1" title="Volta para o dono no fim da temporada">
                                            Emprestado pelo @dono
                                        </span>
                                    }
                                    @if (player.Participacao?.Saida is { NaLista: true } saida)
                                    {
                                        <span class="etiqueta perigo ms-1"
                                              title="@(saida.PromessaQuebrada ? "Promessa quebrada: voltou à lista pela metade da venda rápida e só sai vendido" : "Pediu para sair: está na lista pelo preço da venda rápida e só sai dela com a promessa de colocar para jogar")"><Icone Nome="door-open" Tamanho="12" /> Pediu para sair</span>
                                    }
                                    else if (player.Participacao?.Saida is { PromessaEm: not null } promessa)
                                    {
                                        <span class="etiqueta ms-1"
                                              title="Promessa de colocar para jogar: ele precisa ser titular @ParticipacaoCriterios.TitularSeguidoParaResolver jogos seguidos. Faltam @promessa.FaltamDaPromessa jogo(s); se não acontecer, volta à lista pela metade do preço."><Icone Nome="handshake" Tamanho="12" /> Promessa · @promessa.JogosDaPromessa/@PedidoDeSaidaCriterios.JogosDaPromessa</span>
                                    }
                                    @if (player.Participacao is { Insatisfeito: true } insatisfeito)
                                    {
                                        <span class="etiqueta perigo ms-1" title="@TituloInsatisfeito(insatisfeito)"><Icone Nome="frown" Tamanho="12" /> Insatisfeito</span>
                                    }
                                    else if (player.Participacao is { Incomodado: true })
                                    {
                                        <span class="etiqueta aviso ms-1" title="Incomodado: se não jogar o próximo jogo do clube, fica insatisfeito"><Icone Nome="meh" Tamanho="12" /> Incomodado</span>
                                    }
                                </td>
                                <td class="text-center text-nowrap">@player.Position</td>
                                <td class="numero fw-semibold">@player.Overall</td>
                                <td class="numero">@(player.Age?.ToString(CultureInfo.InvariantCulture) ?? "—")</td>
                                <td class="text-nowrap text-end numero">
                                    @FormatCurrency(player.BasePrice)
                                    @if (player.Participacao is { Variacao: not 0m } part)
                                    {
                                        <span class="variacao-valor @(part.Variacao > 0 ? "sobe" : "cai")"
                                              title="@TituloVariacao(part)">
                                            <Icone Nome="@(part.Travada ? "lock" : part.Variacao > 0 ? "arrow-up" : "arrow-down")" Tamanho="12" />@Participacao.Rotulo(part.Variacao)
                                        </span>
                                    }
                                </td>
                                @if (_canQuickSell && player.EmprestadoPor is not null)
                                {
                                    <td class="text-center text-nowrap pe-0 text-muted small" title="Emprestado não pode ser vendido">—</td>
                                }
                                else if (_canQuickSell)
                                {
                                    <td class="text-center text-nowrap pe-0">
                                        @if (player.Participacao?.Saida is { NaLista: true })
                                        {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary btn-icone acao-perigo me-1"
                                                title="Pediu para sair: ver a promessa de colocar para jogar"
                                                aria-label="Pediu para sair: @player.Name"
                                                @onclick="() => AbrirSaida(player)">
                                            <Icone Nome="door-open" Tamanho="14" />
                                        </button>
                                        }
                                        else
                                        {
                                        @if (PodeConversar(player))
                                        {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary btn-icone me-1"
                                                title="Conversa: rebaixar o papel dele no elenco"
                                                aria-label="Conversa com @player.Name"
                                                @onclick="() => AbrirConversa(player)">
                                            <Icone Nome="message-circle" Tamanho="14" />
                                        </button>
                                        }
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary btn-icone me-1 @(player.AskingPrice is null ? "" : "acao-ativa")"
                                                title="@(player.AskingPrice is null ? "Colocar como negociável" : "Alterar preço ou tirar da lista")"
                                                aria-label="Negociável: @player.Name"
                                                @onclick="() => OpenListingModal(player)">
                                            <Icone Nome="tag" Tamanho="14" />
                                        </button>
                                        }
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary btn-icone acao-perigo"
                                                title="@(_quickSellBloqueado ? "Vendas rápidas bloqueadas no momento" : "Venda rápida")"
                                                disabled="@_quickSellBloqueado"
                                                aria-label="Vender rapidamente @player.Name"
                                                @onclick="() => OpenQuickSellModal(player)">
                                            <Icone Nome="zap" Tamanho="14" />
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_emprestadosFora.Count > 0)
        {
            <h6 class="mt-4">Emprestados a outros times</h6>
            <ul class="list-unstyled small mb-0">
                @foreach (var loan in _emprestadosFora)
                {
                    <li>
                        <a href="/players/details/@loan.PlayerId">@loan.JogadorNome</a>
                        <span class="text-muted">(@loan.Posicao, @loan.Overall) · no @loan.TomadorTeamNome até o fim da temporada</span>
                    </li>
                }
            </ul>
        }
    </section>

    <div class="mt-4">
        <a href="/teams" class="small text-body-secondary"><Icone Nome="arrow-left" Tamanho="14" /> Todos os times</a>
    </div>

    } @* end Info tab *@
}


@if (_quickSellModalOpen && _quickSellTarget is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);" role="dialog" aria-modal="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar venda rápida</h5>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="CloseQuickSellModal" disabled="@_quickSellProcessing"></button>
                </div>
                <div class="modal-body">
                    <p>
                        Confirma a venda rápida de <strong>@_quickSellTarget.Name</strong>
                        por <strong>@FormatCurrency(_quickSellPayout)</strong>?
                    </p>
                    <ul class="list-unstyled small mb-0">
                        <li><strong>Overall:</strong> @_quickSellTarget.Overall</li>
                        <li><strong>Preço base:</strong> @FormatCurrency(_quickSellTarget.BasePrice)@(_quickSellTarget.Participacao is { Variacao: not 0m } qsPart ? $" ({Participacao.Rotulo(qsPart.Variacao)} pela participação)" : "")</li>
                        <li><strong>Pagamento (80%):</strong> @FormatCurrency(_quickSellPayout)</li>
                        <li><strong>Quick-sells restantes:</strong> @(Math.Max(0, _maxQuickSell - (team?.QuickSellCount ?? 0))) / @_maxQuickSell</li>
                    </ul>
                    @if (!string.IsNullOrEmpty(_quickSellErrorMessage))
                    {
                        <div class="alert alert-danger mt-3" role="alert">@_quickSellErrorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="CloseQuickSellModal"
                            disabled="@_quickSellProcessing">
                        Cancelar
                    </button>
                    <button type="button"
                            class="btn btn-danger"
                            @onclick="ConfirmQuickSellAsync"
                            disabled="@_quickSellProcessing">
                        @if (_quickSellProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        Confirmar venda
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_saidaTarget is { Participacao.Saida: { } saidaAlvo })
{
    var promessaEmAndamento = _rosterPlayers.FirstOrDefault(p => p.Participacao?.Saida?.PromessaEm is not null);
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);" role="dialog" aria-modal="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><Icone Nome="door-open" Tamanho="14" /> @_saidaTarget.Name pediu para sair</h5>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="FecharSaida" disabled="@_saidaProcessando"></button>
                </div>
                <div class="modal-body">
                    @if (saidaAlvo.PromessaQuebrada)
                    {
                        <p>
                            A promessa de colocar para jogar não foi cumprida: ele voltou à
                            <a href="/mercado/lista">lista de transferência</a> por
                            <strong>@FormatCurrency(_saidaTarget.AskingPrice ?? 0m)</strong>, metade do preço da venda rápida
                            (e a venda rápida dele também caiu pela metade).
                        </p>
                        <div class="alert alert-secondary mb-0">Ele não acredita mais em promessa: só sai do clube vendido.</div>
                    }
                    else
                    {
                        <p>
                            Ficou insatisfeito e seguiu no banco, então foi sozinho para a
                            <a href="/mercado/lista">lista de transferência</a> por
                            <strong>@FormatCurrency(_saidaTarget.AskingPrice ?? 0m)</strong>, o preço da venda rápida. Qualquer time
                            pode comprar direto (com a janela aberta). Você não muda o preço nem tira da lista.
                        </p>
                        <p class="mb-2">
                            <strong><Icone Nome="handshake" Tamanho="14" /> Promessa:</strong> ele sai da lista e você tem @PedidoDeSaidaCriterios.JogosDaPromessa jogos
                            para escalá-lo como titular @ParticipacaoCriterios.TitularSeguidoParaResolver jogos seguidos. Se não
                            cumprir, ele volta para a lista pela <strong>metade</strong> do preço da venda rápida (e a venda rápida
                            dele também cai pela metade). Uma promessa por vez.
                        </p>
                        @if (promessaEmAndamento is not null)
                        {
                            <div class="alert alert-warning mb-0">
                                Você já tem uma promessa em andamento com @promessaEmAndamento.Name. Cumpra ou quebre essa antes.
                            </div>
                        }
                    }
                    @if (!string.IsNullOrEmpty(_saidaErro))
                    {
                        <div class="alert alert-danger mt-3 mb-0" role="alert">@_saidaErro</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="FecharSaida" disabled="@_saidaProcessando">Fechar</button>
                    @if (!saidaAlvo.PromessaQuebrada)
                    {
                        <button type="button" class="btn btn-primary" @onclick="PrometerAsync"
                                disabled="@(_saidaProcessando || promessaEmAndamento is not null)">
                            @if (_saidaProcessando)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            <Icone Nome="handshake" Tamanho="14" /> Tirar da lista prometendo jogar
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_conversaTarget is { Participacao.Papel: { } papelAlvo } && PapelDoJogador.UmDegrauAbaixo(papelAlvo.Papel) is { } papelNovo)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);" role="dialog" aria-modal="true">
