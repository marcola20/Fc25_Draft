@using System.Globalization
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Web.Utilities
@using Fc25Draft.Core.Entities
@using Fc25Draft.Web.Services
@inject TransferOffersApiClient OffersApi
@inject TeamsApiClient TeamsApi
@inject Fc25Draft.Core.Interfaces.ITransferConfigService TransferConfigSvc
@inject Fc25Draft.Core.Interfaces.IEmprestimoService EmprestimoSvc
@inject Fc25Draft.Core.Interfaces.IPicksDoDraftService PicksSvc
@inject Fc25Draft.Core.Interfaces.ITransferOfferService OffersSvc
@inject IJSRuntime JS

<div class="mt-3">
    @if (_mercadoFechado)
    {
        <div class="alert alert-warning py-2" role="status">
            <strong>Mercado fechado!</strong> Não dá para mandar nem aceitar propostas até a próxima janela. Recusar e cancelar continuam liberados.
        </div>
    }

    <ul class="nav nav-pills mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(ActiveSubTab == SubTab.Received ? "active" : "")"
                    type="button" @onclick="() => SwitchSubTab(SubTab.Received)">
                Recebidas
                @if (_received.Count > 0)
                {
                    <span class="badge bg-danger ms-1">@_received.Count</span>
                }
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(ActiveSubTab == SubTab.Sent ? "active" : "")"
                    type="button" @onclick="() => SwitchSubTab(SubTab.Sent)">
                Enviadas
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(ActiveSubTab == SubTab.Finished ? "active" : "")"
                    type="button" @onclick="() => SwitchSubTab(SubTab.Finished)">
                Finalizadas
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(ActiveSubTab == SubTab.Loans ? "active" : "")"
                    type="button" @onclick="() => SwitchSubTab(SubTab.Loans)">
                Empréstimos e recompras
                @if (_loans.Count > 0)
                {
                    <span class="badge bg-secondary ms-1">@_loans.Count</span>
                }
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(ActiveSubTab == SubTab.NewOffer ? "active" : "")"
                    type="button" @onclick="() => SwitchSubTab(SubTab.NewOffer)">
                + Nova Proposta
            </button>
        </li>
    </ul>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    @if (!string.IsNullOrEmpty(_success))
    {
        <div class="alert alert-success" role="alert">@_success</div>
    }

    @if (_loading)
    {
        <p><em>Carregando...</em></p>
    }
    else
    {
        @* ===== RECEBIDAS ===== *@
        @if (ActiveSubTab == SubTab.Received)
        {
            @if (_received.Count == 0)
            {
                <p class="text-muted">Nenhuma proposta recebida.</p>
            }
            else
            {
                @foreach (var offer in _received)
                {
                    @RenderOfferCard(offer, showActions: true, showCancel: false)
                }
            }
        }

        @* ===== ENVIADAS ===== *@
        @if (ActiveSubTab == SubTab.Sent)
        {
            @if (_sent.Count == 0)
            {
                <p class="text-muted">Nenhuma proposta enviada pendente.</p>
            }
            else
            {
                @foreach (var offer in _sent)
                {
                    @RenderOfferCard(offer, showActions: false, showCancel: true)
                }
            }
        }

        @* ===== FINALIZADAS ===== *@
        @if (ActiveSubTab == SubTab.Finished)
        {
            @if (_finished.Count == 0)
            {
                <p class="text-muted">Nenhuma negociação finalizada.</p>
            }
            else
            {
                <h6 class="mt-2">Aceitas</h6>
                @if (AcceptedOffers.Count == 0)
                {
                    <p class="text-muted small">Nenhuma.</p>
                }
                else
                {
                    @foreach (var offer in AcceptedOffers)
                    {
                        @RenderOfferCard(offer, showActions: false, showCancel: false)
                    }
                }

                <h6 class="mt-3">Recusadas</h6>
                @if (RejectedOffers.Count == 0)
                {
                    <p class="text-muted small">Nenhuma.</p>
                }
                else
                {
                    @foreach (var offer in RejectedOffers)
                    {
                        @RenderOfferCard(offer, showActions: false, showCancel: false)
                    }
                }

                @if (CounteredOffers.Count > 0)
                {
                    <h6 class="mt-3">Contraofertadas</h6>
                    @foreach (var offer in CounteredOffers)
                    {
                        @RenderOfferCard(offer, showActions: false, showCancel: false)
                    }
                }

                @if (CancelledOffers.Count > 0)
                {
                    <h6 class="mt-3">Canceladas</h6>
                    @foreach (var offer in CancelledOffers)
                    {
                        @RenderOfferCard(offer, showActions: false, showCancel: false)
                    }
                }
            }
        }

        @* ===== EMPRÉSTIMOS ===== *@
        @if (ActiveSubTab == SubTab.Loans)
        {
            @if (_recompras.Count > 0)
            {
                <h6 class="mt-2">🔁 Cláusulas de recompra</h6>
                <ul class="list-group mb-4">
                    @foreach (var r in _recompras)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2 @(r.Vale ? "" : "text-muted")">
                            <div>
                                <a href="/players/details/@r.PlayerId">@r.PlayerName</a>
                                <div class="small text-muted">
                                    @(r.VendedorId == TeamId ? $"Você vendeu para o {r.CompradorNome}" : $"Você comprou do {r.VendedorNome}")
                                    · recompra por @FormatCurrency(r.Preco)
                                    @if (!r.Vale)
                                    {
                                        <text> · não vale mais: @r.Situacao</text>
                                    }
                                </div>
                            </div>
                            @if (r.Vale && r.VendedorId == TeamId)
                            {
                                <button class="btn btn-sm btn-outline-success" disabled="@_processing" @onclick="() => RecomprarAsync(r)">
                                    Recomprar por @FormatCurrency(r.Preco)
                                </button>
                            }
                            else if (r.Vale)
                            {
                                <span class="badge bg-warning text-dark">O @r.VendedorNome pode recomprar</span>
                            }
                        </li>
                    }
                </ul>
            }

            <p class="text-muted small">
                Empréstimos vão até o fim da temporada: quando a próxima começa, o jogador volta sozinho para o dono.
                Com opção de compra, quem pegou emprestado pode ficar com ele em definitivo pagando o valor combinado.
                Limite de empréstimos por janela: <strong>@_loansUsed / @_maxLoans</strong>.
            </p>

            <h6 class="mt-2">Jogadores que você pegou emprestado</h6>
            @if (BorrowedLoans.Count == 0)
            {
                <p class="text-muted small">Nenhum.</p>
            }
            else
            {
                <ul class="list-group mb-3">
                    @foreach (var loan in BorrowedLoans)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <a href="/players/details/@loan.PlayerId">@loan.JogadorNome</a>
                                <span class="text-muted small">(@loan.Posicao, @loan.Overall)</span>
                                <div class="small text-muted">Emprestado pelo @loan.DonoTeamNome desde @BrazilTime.FormatDateTime(loan.InicioUtc)</div>
                            </div>
                            @if (loan.ValorOpcaoCompra is decimal preco)
                            {
                                <button class="btn btn-sm btn-outline-success" disabled="@_processing"
                                        @onclick="() => ExerciseBuyOptionAsync(loan)">
                                    Comprar por @FormatCurrency(preco)
                                </button>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark">Sem opção de compra</span>
                            }
                        </li>
                    }
                </ul>
            }

            <h6 class="mt-3">Jogadores seus emprestados</h6>
            @if (LentLoans.Count == 0)
            {
                <p class="text-muted small">Nenhum.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var loan in LentLoans)
                    {
                        <li class="list-group-item">
                            <a href="/players/details/@loan.PlayerId">@loan.JogadorNome</a>
                            <span class="text-muted small">(@loan.Posicao, @loan.Overall)</span>
                            <div class="small text-muted">
                                No @loan.TomadorTeamNome até o fim da temporada
                                @if (loan.ValorOpcaoCompra is decimal preco)
                                {
                                    <text> · opção de compra por @FormatCurrency(preco)</text>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        }

        @* ===== NOVA PROPOSTA ===== *@
        @if (ActiveSubTab == SubTab.NewOffer)
        {
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@(_counterOfferParentId.HasValue ? "Contraproposta" : "Nova Proposta")</h5>

                    @if (_counterOfferParentId.HasValue)
                    {
                        <div class="alert alert-info">
                            Contraproposta baseada na proposta original. Todos os campos são editáveis.
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Time adversário</label>
                            <select class="form-select" @onchange="OnTargetTeamChanged" value="@_selectedTargetTeamId">
                                <option value="">Selecione um time...</option>
                                @foreach (var t in _allTeams)
                                {
                                    @if (t.TeamId != TeamId)
                                    {
                                        <option value="@t.TeamId">@t.TeamName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Tipo de negociação</label>
                            <select class="form-select" @bind="_newOfferType">
                                <option value="@OfferType.Sale">Venda (Dinheiro)</option>
                                <option value="@OfferType.Loan">Empréstimo</option>
                                <option value="@OfferType.Swap">Troca</option>
                            </select>
                        </div>
                    </div>

                    @if (_targetRoster.Count > 0)
                    {
                        <div class="mt-3">
                            <label class="form-label">Jogadores alvo (do time adversário)</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var player in _targetRoster)
                                {
                                    var isSelected = _selectedTargetPlayerIds.Contains(player.PlayerGuid);
                                    <button type="button"
                                            class="btn btn-sm @(isSelected ? "btn-danger" : "btn-outline-secondary")"
                                            @onclick="() => ToggleTargetPlayer(player.PlayerGuid)">
                                        @player.Nome (@player.Posicao, @player.Overall)
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (_newOfferType == OfferType.Loan)
                    {
                        <div class="alert alert-info small mt-3 mb-0">
                            <strong>Empréstimo até o fim da temporada.</strong>
                            Escolha jogadores de um lado só: os do adversário para pegar emprestado, ou os seus para emprestar.
                            O valor em dinheiro é a taxa do empréstimo. Conta no limite de empréstimos de quem recebe o jogador, não no de transferências.
                        </div>
                    }

                    @if ((_newOfferType is OfferType.Swap or OfferType.Loan || _selectedOfferedPlayerIds.Count > 0 || _counterOfferParentId.HasValue) && _myRoster.Count > 0)
                    {
                        <div class="mt-3">
                            <label class="form-label">Jogadores oferecidos (do seu time)</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var player in _myRoster)
                                {
                                    var isSelected = _selectedOfferedPlayerIds.Contains(player.PlayerGuid);
                                    <button type="button"
                                            class="btn btn-sm @(isSelected ? "btn-success" : "btn-outline-secondary")"
                                            @onclick="() => ToggleOfferedPlayer(player.PlayerGuid)">
                                        @player.Nome (@player.Posicao, @player.Overall)
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (_picks is { Aberta: true } picks && _newOfferType != OfferType.Loan && Guid.TryParse(_selectedTargetTeamId, out var adversarioId))
                    {
                        var deles = picks.Picks.Where(pk => pk.DonoId == adversarioId && !pk.Usada).ToList();
                        var minhas = picks.Picks.Where(pk => pk.DonoId == TeamId && !pk.Usada).ToList();
                        var escolhidas = picks.Picks.Where(pk => _selectedTargetPicks.Contains(pk.Ref) || _selectedOfferedPicks.Contains(pk.Ref)).ToList();
                        <div class="mt-3">
                            <label class="form-label mb-1">Picks do draft</label>
                            <div class="small text-muted mb-2">
                                Antes da loteria, a pick vale a posição que o time dono dela pela classificação tirar; depois, já
                                tem número (#3). Negocia até ser usada no draft. Negócio só de picks (e dinheiro) vale fora da
                                janela e não conta no limite de transferências.
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                                <span class="small text-muted me-1">Pedir:</span>
                                @if (deles.Count == 0) { <span class="small text-muted">o time não tem picks</span> }
                                @foreach (var pk in deles)
                                {
                                    var sel = _selectedTargetPicks.Contains(pk.Ref);
                                    <button type="button" class="btn btn-sm @(sel ? "btn-danger" : "btn-outline-secondary")"
                                            @onclick="() => TogglePick(_selectedTargetPicks, pk.Ref)">🔄 @pk.Rotulo</button>
                                }
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <span class="small text-muted me-1">Oferecer:</span>
                                @if (minhas.Count == 0) { <span class="small text-muted">você não tem picks</span> }
                                @foreach (var pk in minhas)
                                {
                                    var sel = _selectedOfferedPicks.Contains(pk.Ref);
                                    <button type="button" class="btn btn-sm @(sel ? "btn-success" : "btn-outline-secondary")"
                                            @onclick="() => TogglePick(_selectedOfferedPicks, pk.Ref)">🔄 @pk.Rotulo</button>
                                }
                            </div>
                            @foreach (var pk in escolhidas)
                            {
                                var refPk = pk.Ref;
                                @if (pk.Posicao is null && (pk.ProtegidaAte is null || pk.ProtecaoAcionada is not null))
                                {
                                    <div class="d-flex flex-wrap gap-2 align-items-center mt-2 small">
                                        <span>🛡️ Proteção da <strong>@pk.Rotulo</strong>:</span>
                                        <select class="form-select form-select-sm w-auto"
                                                value="@(_protecaoAte.GetValueOrDefault(refPk).ToString(CultureInfo.InvariantCulture))"
                                                @onchange="e => DefinirProtecao(refPk, e.Value?.ToString())">
                                            <option value="0">sem proteção</option>
                                            @foreach (var ate in new[] { 1, 2, 3, 4, 5, 6, 8, 10 })
                                            {
                                                <option value="@ate">protegida até a #@ate</option>
                                            }
                                        </select>
                                        @if (_protecaoAte.GetValueOrDefault(refPk) > 0)
                                        {
                                            <span>se acionar, quem cede devolve R$</span>
                                            <input type="text" class="form-control form-control-sm w-auto" inputmode="decimal" style="max-width:9rem"
                                                   value="@FormatMoneyInput(_protecaoDevolucao.GetValueOrDefault(refPk))"
                                                   @onchange="e => DefinirDevolucao(refPk, e.Value?.ToString())" placeholder="0,00" />
                                        }
                                    </div>
                                }
                                else if (pk.ProtegidaAte is int jaProtegida && pk.ProtecaoAcionada is null)
                                {
                                    <div class="small text-muted mt-2">🛡️ A @pk.Rotulo já é protegida até a #@jaProtegida (volta para o @pk.ProtetorNome se cair até lá).</div>
                                }
                            }
                        </div>
                    }

                    <div class="row g-3 mt-2">
                        <div class="col-md-5">
                            <label class="form-label">Valor em dinheiro</label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input type="text" class="form-control" inputmode="decimal"
                                       value="@FormatMoneyInput(_newOfferMoney)"
                                       @onchange="OnMoneyChanged"
                                       placeholder="0,00" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Quem paga?</label>
                            <select class="form-select" @bind="_selectedPayerTeamId">
                                <option value="">Selecione...</option>
                                <option value="@TeamId">@MyTeamName</option>
                                @if (Guid.TryParse(_selectedTargetTeamId, out var _tgtId))
                                {
                                    <option value="@_selectedTargetTeamId">@TargetTeamName</option>
                                }
                            </select>
                        </div>
                        @if (_newOfferType == OfferType.Loan)
                        {
                            <div class="col-md-3">
                                <label class="form-label">Opção de compra</label>
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <input type="text" class="form-control" inputmode="decimal"
                                           value="@FormatMoneyInput(_newOfferBuyOption)"
                                           @onchange="OnBuyOptionChanged"
                                           placeholder="Sem opção" />
                                </div>
                            </div>
                        }
                        else if (_newOfferType != OfferType.Swap)
                        {
                            <div class="col-md-3">
                                <label class="form-label">Revenda futura</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" inputmode="decimal"
                                           value="@FormatPercentInput(_newOfferSellOn)"
                                           @onchange="OnSellOnChanged"
                                           placeholder="0,00" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        }
                    </div>

                    @if (PodeTerRecompra)
                    {
                        <div class="row g-3 mt-1">
                            <div class="col-md-5">
                                <label class="form-label">🔁 Recompra (opcional)</label>
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <input type="text" class="form-control" inputmode="decimal"
                                           value="@FormatMoneyInput(_newOfferBuyback)"
                                           @onchange="OnBuybackChanged"
                                           placeholder="Sem recompra" />
                                </div>
                            </div>
                            <div class="col-md-7 small text-muted d-flex align-items-end">
                                O @QuemVende pode comprar o jogador de volta por esse valor até o fim da temporada, enquanto
                                ele estiver no clube que comprou. Se ele for vendido ou emprestado, a recompra cai.
                            </div>
                        </div>
                    }

                    <div class="mt-3">
                        <label class="form-label">Cláusulas e Bônus</label>
                        <textarea class="form-control" rows="2" @bind="_newOfferClauses"></textarea>
                    </div>

                    <div class="mt-3">
                        <label class="form-label">Observações</label>
                        <textarea class="form-control" rows="2" @bind="_newOfferNotes"></textarea>
                    </div>

                    <div class="mt-3 d-flex gap-2">
                        <button class="btn btn-primary" disabled="@_processing" @onclick="SubmitOfferAsync">
                            @if (_processing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            @(_counterOfferParentId.HasValue ? "Enviar Contraproposta" : "Enviar Proposta")
                        </button>
                        @if (_counterOfferParentId.HasValue)
                        {
                            <button class="btn btn-outline-secondary" @onclick="CancelCounterOffer">Cancelar</button>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@* ===== MODAL DE DETALHES ===== *@
@if (_detailOffer is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Detalhes da Proposta</h5>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="CloseDetailModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>De:</strong></div>
                        <div class="col-sm-8">@_detailOffer.FromTeamName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Para:</strong></div>
                        <div class="col-sm-8">@_detailOffer.ToTeamName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Tipo:</strong></div>
                        <div class="col-sm-8"><span class="badge bg-info">@TranslateType(_detailOffer.Type)</span></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Status:</strong></div>
                        <div class="col-sm-8"><span class="badge @GetStatusBadgeClass(_detailOffer.Status)">@TranslateStatus(_detailOffer.Status)</span></div>
                    </div>

                    @if (_detailOffer.TargetPlayers.Count > 0)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4"><strong>Jogadores solicitados:</strong></div>
                            <div class="col-sm-8">
                                @foreach (var p in _detailOffer.TargetPlayers)
                                {
                                    <span class="badge bg-danger me-1 mb-1">@p.Name (@p.Position, OVR @p.Overall)</span>
                                }
                            </div>
                        </div>
                    }

                    @if (_detailOffer.OfferedPlayers.Count > 0)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4"><strong>Jogadores oferecidos:</strong></div>
                            <div class="col-sm-8">
                                @foreach (var p in _detailOffer.OfferedPlayers)
                                {
                                    <span class="badge bg-success me-1 mb-1">@p.Name (@p.Position, OVR @p.Overall)</span>
                                }
                            </div>
                        </div>
                    }

                    @if ((_detailOffer.TargetPicks?.Count ?? 0) + (_detailOffer.OfferedPicks?.Count ?? 0) > 0)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4"><strong>Picks do draft:</strong></div>
                            <div class="col-sm-8">
                                @foreach (var pk in _detailOffer.TargetPicks ?? [])
                                {
                                    <span class="badge bg-danger me-1 mb-1">🔄 @pk.Rotulo (pedida)@(pk.ProtegidaAte is int a3 ? $" · 🛡️ protegida até a #{a3}, devolve {FormatCurrency(pk.Compensacao ?? 0m)}" : "")</span>
                                }
                                @foreach (var pk in _detailOffer.OfferedPicks ?? [])
                                {
                                    <span class="badge bg-success me-1 mb-1">🔄 @pk.Rotulo (oferecida)@(pk.ProtegidaAte is int a4 ? $" · 🛡️ protegida até a #{a4}, devolve {FormatCurrency(pk.Compensacao ?? 0m)}" : "")</span>
                                }
                            </div>
                        </div>
                    }

                    @if (_detailOffer.Money > 0)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4"><strong>Valor:</strong></div>
                            <div class="col-sm-8">
                                @FormatCurrency(_detailOffer.Money)
                                @if (!string.IsNullOrEmpty(_detailOffer.MoneyPayerTeamName))
                                {
                                    <span class="text-muted ms-1">(pago por @_detailOffer.MoneyPayerTeamName)</span>
                                }
                            </div>
                        </div>
                    }

                    @if (_detailOffer.BuyOptionPrice is decimal opcaoDetalhe)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4"><strong>Opção de compra:</strong></div>
                            <div class="col-sm-8">@FormatCurrency(opcaoDetalhe)</div>
                        </div>
                    }

                    @if (_detailOffer.SellOnPercentage > 0)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4"><strong>Revenda futura:</strong></div>
                            <div class="col-sm-8">@_detailOffer.SellOnPercentage.ToString("N2", BrazilCulture)%</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_detailOffer.Clauses))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4"><strong>Cláusulas e Bônus:</strong></div>
                            <div class="col-sm-8">@_detailOffer.Clauses</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_detailOffer.Notes))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4"><strong>Observações:</strong></div>
                            <div class="col-sm-8">@_detailOffer.Notes</div>
                        </div>
                    }

                    <div class="row mb-2">
                        <div class="col-sm-4"><strong>Criada em:</strong></div>
                        <div class="col-sm-8">@BrazilTime.FormatDateTime(_detailOffer.CreatedAtUtc)</div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4"><strong>Atualizada em:</strong></div>
                        <div class="col-sm-8">@BrazilTime.FormatDateTime(_detailOffer.UpdatedAtUtc)</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDetailModal">Fechar</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@* ===== MODAL DE CONFIRMAÇÃO DE ACEITE ===== *@
@if (_acceptConfirmOffer is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);" role="dialog" aria-modal="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar aceite</h5>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="CloseAcceptConfirmModal" disabled="@_processing"></button>
                </div>
                <div class="modal-body">
                    <p>Deseja aceitar a proposta de <strong>@_acceptConfirmOffer.FromTeamName</strong>?</p>
                    @if (_acceptConfirmOffer.Type == nameof(OfferType.Loan))
                    {
                        <p class="mb-0">
                            É um <strong>empréstimo até o fim da temporada</strong>@(_acceptConfirmOffer.BuyOptionPrice is decimal opcaoAceite ? $", com opção de compra por {FormatCurrency(opcaoAceite)}" : "").
                            Conta no limite de empréstimos de quem recebe o jogador, não no de transferências.
                        </p>
                    }
                    else
                    {
                        <p class="mb-0"><strong>Transferências restantes após aceite:</strong> @(Math.Max(0, _maxTransfers - TransferCount - 1)) / @_maxTransfers</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseAcceptConfirmModal" disabled="@_processing">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="ConfirmAcceptAsync" disabled="@_processing">
                        @if (_processing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        Confirmar aceite
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public Guid TeamId { get; set; }
    [Parameter] public string? TeamToken { get; set; }
    [Parameter] public int TransferCount { get; set; }

    /// <summary>Jogador da lista de transferência: abre a nova proposta já com ele e o preço pedido.</summary>
    [Parameter] public Guid? PropostaPorJogador { get; set; }

    private SubTab ActiveSubTab = SubTab.Received;
    private bool _loading;
    private bool _processing;
    private string? _error;
    private string? _success;

    private List<TransferOfferListItemDto> _received = new();
    private List<TransferOfferListItemDto> _sent = new();
    private List<TransferOfferListItemDto> _finished = new();

    private List<TransferOfferListItemDto> AcceptedOffers => _finished.Where(f => f.Status == "Accepted").ToList();
    private List<TransferOfferListItemDto> RejectedOffers => _finished.Where(f => f.Status == "Rejected").ToList();
    private List<TransferOfferListItemDto> CounteredOffers => _finished.Where(f => f.Status == "Countered").ToList();
    private List<TransferOfferListItemDto> CancelledOffers => _finished.Where(f => f.Status == "Cancelled").ToList();

    private List<TeamListItemDto> _allTeams = new();
    private List<TeamRosterPlayerDto> _targetRoster = new();
    private List<TeamRosterPlayerDto> _myRoster = new();

    private string _selectedTargetTeamId = string.Empty;
    private OfferType _newOfferType = OfferType.Sale;
    private HashSet<Guid> _selectedTargetPlayerIds = new();
    private HashSet<Guid> _selectedOfferedPlayerIds = new();
    private HashSet<PickRefDto> _selectedTargetPicks = new();
    private HashSet<PickRefDto> _selectedOfferedPicks = new();
    private PicksDoProximoDraftDto? _picks;
    private Dictionary<PickRefDto, int> _protecaoAte = new();
    private Dictionary<PickRefDto, decimal> _protecaoDevolucao = new();
    private decimal _newOfferMoney;
    private string _selectedPayerTeamId = string.Empty;
    private decimal _newOfferSellOn;
    private decimal _newOfferBuyback;
    private List<DireitoDeRecompraDto> _recompras = new();

    /// <summary>Venda de um jogador só: dá para pôr cláusula de recompra para quem vende.</summary>
    private bool PodeTerRecompra =>
        _newOfferType == OfferType.Sale && _selectedTargetPlayerIds.Count + _selectedOfferedPlayerIds.Count == 1;

    private string QuemVende => _selectedTargetPlayerIds.Count == 1 ? TargetTeamName : "seu time";
    private decimal _newOfferBuyOption;
    private string? _newOfferClauses;
    private string? _newOfferNotes;
    private Guid? _counterOfferParentId;

    private List<EmprestimoDto> _loans = new();
    private List<EmprestimoDto> BorrowedLoans => _loans.Where(l => l.TomadorTeamId == TeamId).ToList();
    private List<EmprestimoDto> LentLoans => _loans.Where(l => l.DonoTeamId == TeamId).ToList();
    private int _maxLoans = 3;
    private int _loansUsed;

    private TransferOfferListItemDto? _detailOffer;
    private TransferOfferListItemDto? _acceptConfirmOffer;

    private static readonly CultureInfo BrazilCulture = CultureInfo.GetCultureInfo("pt-BR");

    private string MyTeamName => _allTeams.FirstOrDefault(t => t.TeamId == TeamId)?.TeamName ?? "Meu time";
    private string TargetTeamName
    {
        get
        {
            if (Guid.TryParse(_selectedTargetTeamId, out var id))
                return _allTeams.FirstOrDefault(t => t.TeamId == id)?.TeamName ?? "Time adversário";
            return "Time adversário";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _maxTransfers = await TransferConfigSvc.GetMaxTransfersForAsync(TeamId, CancellationToken.None);
            var cfg = await TransferConfigSvc.GetAsync(CancellationToken.None);
            _maxLoans = cfg.MaxLoans;
            _mercadoFechado = cfg.MercadoFechado;
        }
        catch { /* mantém o padrão se a config não carregar */ }
        await LoadDataAsync();

        if (PropostaPorJogador is Guid jogador)
            await StartOfferForListedPlayerAsync(jogador);
    }

    private async Task StartOfferForListedPlayerAsync(Guid playerGuid)
    {
        try
        {
            var lista = await OffersApi.GetTransferListAsync();
            var item = lista.FirstOrDefault(i => i.PlayerGuid == playerGuid);
            if (item is null)
            {
                _error = "Este jogador não está mais na lista de transferência.";
                return;
            }

            ResetNewOfferForm();
            _selectedTargetTeamId = item.TeamId.ToString();
            var roster = await TeamsApi.GetRosterByIdAsync(item.TeamId);
            _targetRoster = Negotiable(roster);
            _selectedTargetPlayerIds.Add(playerGuid);
            _newOfferType = OfferType.Sale;
            _newOfferMoney = item.AskingPrice;
            _selectedPayerTeamId = TeamId.ToString();
            ActiveSubTab = SubTab.NewOffer;
            _success = $"{item.Name} está à venda por {FormatCurrency(item.AskingPrice)}. Ajuste o valor e envie sua proposta.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private int _maxTransfers = 5;
    private bool _mercadoFechado;

    private async Task LoadDataAsync()
    {
        if (string.IsNullOrEmpty(TeamToken)) return;

        _loading = true;
        _error = null;

        try
        {
            var receivedTask = OffersApi.GetReceivedAsync(TeamToken);
            var sentTask = OffersApi.GetSentAsync(TeamToken);
            var finishedTask = OffersApi.GetFinishedAsync(TeamToken);
            var teamsTask = TeamsApi.GetAsync(null, 1, 100);

            await Task.WhenAll(receivedTask, sentTask, finishedTask, teamsTask);

            _received = (await receivedTask).ToList();
            _sent = (await sentTask).ToList();
            _finished = (await finishedTask).ToList();
            _allTeams = (await teamsTask).Items?.ToList() ?? new();

            var myRosterDto = await TeamsApi.GetRosterByIdAsync(TeamId);
            _myRoster = Negotiable(myRosterDto);

            _loans = (await EmprestimoSvc.ListarAtivosAsync(TeamId, CancellationToken.None)).ToList();
            _picks = await PicksSvc.ProximoDraftAsync(CancellationToken.None);
            _recompras = (await OffersSvc.RecomprasDoTimeAsync(TeamId, CancellationToken.None)).ToList();
            _loansUsed = (await TeamsApi.GetByIdAsync(TeamId))?.LoanCount ?? 0;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SwitchSubTab(SubTab tab)
    {
        ActiveSubTab = tab;
        _error = null;
        _success = null;
    }

    private async Task OnTargetTeamChanged(ChangeEventArgs e)
    {
        _selectedTargetTeamId = e.Value?.ToString() ?? string.Empty;
        _selectedTargetPlayerIds.Clear();
        _selectedTargetPicks.Clear();
        _targetRoster.Clear();

        if (Guid.TryParse(_selectedTargetTeamId, out var targetId))
        {
            try
            {
                var roster = await TeamsApi.GetRosterByIdAsync(targetId);
                _targetRoster = Negotiable(roster);
            }
            catch (Exception ex)
            {
                _error = $"Erro ao carregar elenco: {ex.Message}";
            }
        }
    }

    private void ToggleTargetPlayer(Guid playerGuid)
    {
        if (!_selectedTargetPlayerIds.Remove(playerGuid))
            _selectedTargetPlayerIds.Add(playerGuid);
    }

    private void ToggleOfferedPlayer(Guid playerGuid)
    {
        if (!_selectedOfferedPlayerIds.Remove(playerGuid))
            _selectedOfferedPlayerIds.Add(playerGuid);
    }

    private void TogglePick(HashSet<PickRefDto> selecionadas, PickRefDto pick)
    {
        if (!selecionadas.Remove(pick))
            selecionadas.Add(pick);
        else
        {
            _protecaoAte.Remove(pick);
            _protecaoDevolucao.Remove(pick);
        }
    }

    private void DefinirProtecao(PickRefDto pick, string? valor) =>
        _protecaoAte[pick] = int.TryParse(valor, out var ate) ? ate : 0;

    private void DefinirDevolucao(PickRefDto pick, string? valor)
    {
        var cleaned = new string((valor ?? "").Where(c => char.IsDigit(c) || c == ',').ToArray());
        _protecaoDevolucao[pick] = decimal.TryParse(cleaned, NumberStyles.AllowDecimalPoint, BrazilCulture, out var v)
            ? Math.Max(0, decimal.Round(v, 2, MidpointRounding.AwayFromZero))
            : 0m;
    }

    private PickProtecaoDto[]? ProtecoesEscolhidas()
    {
        var lista = _protecaoAte
            .Where(p => p.Value > 0 && (_selectedTargetPicks.Contains(p.Key) || _selectedOfferedPicks.Contains(p.Key)))
            .Select(p => new PickProtecaoDto(p.Key, p.Value, _protecaoDevolucao.GetValueOrDefault(p.Key)))
            .ToArray();
        return lista.Length == 0 ? null : lista;
    }

    private async Task RespondAsync(Guid offerId, OfferStatus response)
    {
        if (string.IsNullOrEmpty(TeamToken)) return;

        _processing = true;
        _error = null;
        _success = null;

        try
        {
            await OffersApi.RespondToOfferAsync(offerId, response, TeamToken);
            _success = response == OfferStatus.Accepted
                ? "Proposta aceita! Jogadores transferidos."
                : "Proposta recusada.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task CancelOfferAsync(Guid offerId)
    {
        if (string.IsNullOrEmpty(TeamToken)) return;

        _processing = true;
        _error = null;
        _success = null;

        try
        {
            await OffersApi.CancelOfferAsync(offerId, TeamToken);
            _success = "Proposta cancelada.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _processing = false;
        }
    }

    private void StartCounterOffer(TransferOfferListItemDto offer)
    {
        _counterOfferParentId = offer.OfferId;
        _selectedTargetTeamId = offer.FromTeamId.ToString();
        _newOfferType = Enum.TryParse<OfferType>(offer.Type, out var t) ? t : OfferType.Sale;
        _newOfferMoney = offer.Money;
        _newOfferSellOn = offer.SellOnPercentage;
        _newOfferBuyback = offer.BuybackPrice ?? 0m;
        _newOfferBuyOption = offer.BuyOptionPrice ?? 0m;
        _newOfferClauses = offer.Clauses;
        _newOfferNotes = offer.Notes;
        _selectedPayerTeamId = offer.MoneyPayerTeamId?.ToString() ?? string.Empty;
        // As picks pedidas eram minhas (viram oferecidas) e as oferecidas eram deles (viram pedidas).
        _selectedTargetPicks = (offer.OfferedPicks ?? []).Select(pk => pk.Ref).ToHashSet();
        _selectedOfferedPicks = (offer.TargetPicks ?? []).Select(pk => pk.Ref).ToHashSet();
        var comProtecao = (offer.TargetPicks ?? []).Concat(offer.OfferedPicks ?? []).Where(pk => pk.ProtegidaAte is not null).ToList();
        _protecaoAte = comProtecao.ToDictionary(pk => pk.Ref, pk => pk.ProtegidaAte!.Value);
        _protecaoDevolucao = comProtecao.ToDictionary(pk => pk.Ref, pk => pk.Compensacao ?? 0m);

        if (_newOfferType == OfferType.Swap)
        {
            // Swap: invert target <-> offered
            _selectedTargetPlayerIds = new HashSet<Guid>(offer.OfferedPlayers.Select(p => p.PlayerGuid));
            _selectedOfferedPlayerIds = new HashSet<Guid>(offer.TargetPlayers.Select(p => p.PlayerGuid));
        }
        else
        {
            // Sale/Loan: original TargetPlayers are MY players being sold -> become OfferedPlayers
            _selectedTargetPlayerIds = new HashSet<Guid>();
            _selectedOfferedPlayerIds = new HashSet<Guid>(offer.TargetPlayers.Select(p => p.PlayerGuid));
        }

        _ = InvokeAsync(async () =>
        {
            try
            {
                var roster = await TeamsApi.GetRosterByIdAsync(offer.FromTeamId);
                _targetRoster = Negotiable(roster);

                // Remove stale selections: keep only players still in the current rosters
                var currentTargetGuids = _targetRoster.Select(p => p.PlayerGuid).ToHashSet();
                _selectedTargetPlayerIds.IntersectWith(currentTargetGuids);

                var currentMyGuids = _myRoster.Select(p => p.PlayerGuid).ToHashSet();
                _selectedOfferedPlayerIds.IntersectWith(currentMyGuids);

                StateHasChanged();
            }
            catch { }
        });

        ActiveSubTab = SubTab.NewOffer;
    }

    private void CancelCounterOffer()
    {
        _counterOfferParentId = null;
        ResetNewOfferForm();
        ActiveSubTab = SubTab.Received;
    }

    private async Task SubmitOfferAsync()
    {
        if (string.IsNullOrEmpty(TeamToken)) return;

        _processing = true;
        _error = null;
        _success = null;

        try
        {
            if (!Guid.TryParse(_selectedTargetTeamId, out var targetTeamId))
                throw new InvalidOperationException("Selecione um time adversário.");

            if (_selectedTargetPlayerIds.Count == 0 && _selectedOfferedPlayerIds.Count == 0
                && _selectedTargetPicks.Count == 0 && _selectedOfferedPicks.Count == 0)
                throw new InvalidOperationException("Selecione ao menos um jogador ou uma pick do draft na negociação.");

            if (_newOfferType == OfferType.Loan && _selectedTargetPlayerIds.Count > 0 && _selectedOfferedPlayerIds.Count > 0)
                throw new InvalidOperationException("No empréstimo os jogadores vão para um time só: peça ou ofereça, não os dois.");

            Guid? payerTeamId = null;
            if (_newOfferMoney > 0)
            {
                if (!Guid.TryParse(_selectedPayerTeamId, out var parsedPayer))
                    throw new InvalidOperationException("Informe qual time paga o valor em dinheiro.");
                payerTeamId = parsedPayer;
            }

            var dto = new CreateTransferOfferDto(
                FromTeamId: TeamId,
                ToTeamId: targetTeamId,
                Type: _newOfferType,
                TargetPlayerIds: _selectedTargetPlayerIds.ToArray(),
                OfferedPlayerIds: _selectedOfferedPlayerIds.Count > 0 ? _selectedOfferedPlayerIds.ToArray() : null,
                Money: _newOfferMoney,
                MoneyPayerTeamId: payerTeamId,
                SellOnPercentage: _newOfferType is OfferType.Swap or OfferType.Loan ? 0 : _newOfferSellOn,
                Clauses: _newOfferClauses,
                Notes: _newOfferNotes,
                ParentOfferId: _counterOfferParentId,
                BuyOptionPrice: _newOfferType == OfferType.Loan && _newOfferBuyOption > 0 ? _newOfferBuyOption : null,
                TargetPicks: _newOfferType == OfferType.Loan || _selectedTargetPicks.Count == 0 ? null : _selectedTargetPicks.ToArray(),
                OfferedPicks: _newOfferType == OfferType.Loan || _selectedOfferedPicks.Count == 0 ? null : _selectedOfferedPicks.ToArray(),
                BuybackPrice: PodeTerRecompra && _newOfferBuyback > 0 ? _newOfferBuyback : null,
                Protecoes: _newOfferType == OfferType.Loan ? null : ProtecoesEscolhidas());

            await OffersApi.CreateOfferAsync(dto, TeamToken);
            _success = _counterOfferParentId.HasValue ? "Contraproposta enviada!" : "Proposta enviada!";
            _counterOfferParentId = null;
            ResetNewOfferForm();
            await LoadDataAsync();
            ActiveSubTab = SubTab.Sent;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _processing = false;
        }
    }

    private void ResetNewOfferForm()
    {
        _selectedTargetTeamId = string.Empty;
        _selectedTargetPlayerIds.Clear();
        _selectedOfferedPlayerIds.Clear();
        _selectedTargetPicks.Clear();
        _selectedOfferedPicks.Clear();
        _protecaoAte.Clear();
        _protecaoDevolucao.Clear();
        _targetRoster.Clear();
        _newOfferType = OfferType.Sale;
        _newOfferMoney = 0;
        _selectedPayerTeamId = string.Empty;
        _newOfferSellOn = 0;
        _newOfferBuyOption = 0;
        _newOfferBuyback = 0;
        _newOfferClauses = null;
        _newOfferNotes = null;
    }

    private void OpenDetailModal(TransferOfferListItemDto offer) => _detailOffer = offer;
    private void CloseDetailModal() => _detailOffer = null;

    private void OpenAcceptConfirmModal(TransferOfferListItemDto offer) => _acceptConfirmOffer = offer;
    private void CloseAcceptConfirmModal() => _acceptConfirmOffer = null;

    private async Task ConfirmAcceptAsync()
    {
        if (_acceptConfirmOffer is null) return;
        var offerId = _acceptConfirmOffer.OfferId;
        _acceptConfirmOffer = null;
        await RespondAsync(offerId, OfferStatus.Accepted);
    }

    private RenderFragment RenderOfferCard(TransferOfferListItemDto offer, bool showActions, bool showCancel) => __builder =>
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="card-title mb-1">
                            @if (offer.FromTeamId == TeamId)
                            {
                                <span>Proposta para <strong>@offer.ToTeamName</strong></span>
                            }
                            else
                            {
                                <span>Proposta de <strong>@offer.FromTeamName</strong></span>
                            }
                        </h6>
                        <span class="badge bg-info me-1">@TranslateType(offer.Type)</span>
                        <span class="badge @GetStatusBadgeClass(offer.Status)">@TranslateStatus(offer.Status)</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <small class="text-muted">@BrazilTime.FormatDateTime(offer.CreatedAtUtc)</small>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => OpenDetailModal(offer)" title="Ver detalhes">
                            Detalhes
                        </button>
                    </div>
                </div>

                <div class="mt-2">
                    <strong>Jogadores solicitados:</strong>
                    @foreach (var p in offer.TargetPlayers)
                    {
                        <span class="badge bg-danger me-1">@p.Name (@p.Position, @p.Overall)</span>
                    }
                </div>

                @if (offer.OfferedPlayers.Count > 0)
                {
                    <div class="mt-1">
                        <strong>Jogadores oferecidos:</strong>
                        @foreach (var p in offer.OfferedPlayers)
                        {
                            <span class="badge bg-success me-1">@p.Name (@p.Position, @p.Overall)</span>
                        }
                    </div>
                }

                @if ((offer.TargetPicks?.Count ?? 0) + (offer.OfferedPicks?.Count ?? 0) > 0)
                {
                    <div class="mt-1">
                        <strong>Picks do draft:</strong>
                        @foreach (var pk in offer.TargetPicks ?? [])
                        {
                            <span class="badge bg-danger me-1" title="Pedida (vai para o @offer.FromTeamName)">🔄 @pk.Rotulo@(pk.ProtegidaAte is int a1 ? $" · 🛡️ até #{a1}" : "")</span>
                        }
                        @foreach (var pk in offer.OfferedPicks ?? [])
                        {
                            <span class="badge bg-success me-1" title="Oferecida (vai para o @offer.ToTeamName)">🔄 @pk.Rotulo@(pk.ProtegidaAte is int a2 ? $" · 🛡️ até #{a2}" : "")</span>
                        }
                    </div>
                }

                @if (offer.Money > 0)
                {
                    <div class="mt-1">
                        <strong>Valor:</strong> @FormatCurrency(offer.Money)
                        @if (!string.IsNullOrEmpty(offer.MoneyPayerTeamName))
                        {
                            <span class="text-muted ms-1">(pago por @offer.MoneyPayerTeamName)</span>
                        }
                    </div>
                }

                @if (offer.BuyOptionPrice is decimal opcaoCard)
                {
                    <div class="mt-1"><strong>Opção de compra:</strong> @FormatCurrency(opcaoCard)</div>
                }

                @if (offer.BuybackPrice is decimal recompraCard)
                {
                    <div class="mt-1"><strong>🔁 Recompra:</strong> @FormatCurrency(recompraCard) <span class="text-muted small">(quem vende pode comprar de volta até o fim da temporada)</span></div>
                }

                @if (offer.SellOnPercentage > 0)
                {
                    <div class="mt-1"><strong>Revenda futura:</strong> @offer.SellOnPercentage.ToString("F2", BrazilCulture)%</div>
                }

                @if (!string.IsNullOrEmpty(offer.Clauses))
                {
                    <div class="mt-1"><strong>Cláusulas e Bônus:</strong> @offer.Clauses</div>
                }

                @if (showActions)
                {
                    <div class="mt-3 d-flex gap-2">
                        <button class="btn btn-success btn-sm" disabled="@_processing"
                                @onclick="() => OpenAcceptConfirmModal(offer)">
                            Aceitar
                        </button>
                        <button class="btn btn-danger btn-sm" disabled="@_processing"
                                @onclick="() => RespondAsync(offer.OfferId, OfferStatus.Rejected)">
                            Recusar
                        </button>
                        <button class="btn btn-outline-primary btn-sm" disabled="@_processing"
                                @onclick="() => StartCounterOffer(offer)">
                            Contraofertar
                        </button>
                    </div>
                }

                @if (showCancel)
                {
                    <div class="mt-3">
                        <button class="btn btn-outline-danger btn-sm" disabled="@_processing"
                                @onclick="() => CancelOfferAsync(offer.OfferId)">
                            Cancelar Proposta
                        </button>
                    </div>
                }
            </div>
        </div>
    };

    private static string FormatCurrency(decimal value) => value.ToString("C", BrazilCulture);

    private static string FormatMoneyInput(decimal value)
        => value == 0m ? string.Empty : value.ToString("N2", BrazilCulture);

    private static string FormatPercentInput(decimal value)
        => value == 0m ? string.Empty : value.ToString("F2", BrazilCulture);

    private void OnSellOnChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        var cleaned = new string(raw.Where(c => char.IsDigit(c) || c == ',').ToArray());

        if (decimal.TryParse(cleaned, NumberStyles.AllowDecimalPoint, BrazilCulture, out var parsed))
            _newOfferSellOn = Math.Clamp(decimal.Round(parsed, 2, MidpointRounding.AwayFromZero), 0m, 100m);
        else
            _newOfferSellOn = 0m;
    }

    /// <summary>Emprestado não entra em proposta nenhuma até voltar para o dono.</summary>
    private static List<TeamRosterPlayerDto> Negotiable(TeamRosterDto? roster)
        => roster?.Jogadores?.Where(p => p.EmprestadoPor is null).ToList() ?? new();

    private void OnBuybackChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        var cleaned = new string(raw.Where(c => char.IsDigit(c) || c == ',').ToArray());
        _newOfferBuyback = decimal.TryParse(cleaned, NumberStyles.AllowDecimalPoint, BrazilCulture, out var parsed)
            ? Math.Max(0, decimal.Round(parsed, 2, MidpointRounding.AwayFromZero))
            : 0m;
    }

    private async Task RecomprarAsync(DireitoDeRecompraDto direito)
    {
        if (string.IsNullOrEmpty(TeamToken)) return;
        _processing = true;
        _error = null;
        _success = null;
        try
        {
            await OffersApi.RecomprarAsync(direito.DireitoId, TeamToken);
            _success = $"🔁 {direito.PlayerName} voltou para o seu time por {FormatCurrency(direito.Preco)}.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _processing = false;
        }
    }

    private void OnBuyOptionChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        var cleaned = new string(raw.Where(c => char.IsDigit(c) || c == ',').ToArray());

        if (decimal.TryParse(cleaned, NumberStyles.AllowDecimalPoint, BrazilCulture, out var parsed))
            _newOfferBuyOption = Math.Max(0, decimal.Round(parsed, 2, MidpointRounding.AwayFromZero));
        else
            _newOfferBuyOption = 0m;
    }

    private async Task ExerciseBuyOptionAsync(EmprestimoDto loan)
    {
        if (string.IsNullOrEmpty(TeamToken) || loan.ValorOpcaoCompra is not decimal preco) return;

        var confirmado = await JS.InvokeAsync<bool>("confirm",
            $"Comprar {loan.JogadorNome} do {loan.DonoTeamNome} em definitivo por {FormatCurrency(preco)}?");
        if (!confirmado) return;

        _processing = true;
        _error = null;
        _success = null;

        try
        {
            await EmprestimoSvc.ExercerOpcaoCompraAsync(loan.EmprestimoId, TeamToken, CancellationToken.None);
            _success = $"{loan.JogadorNome} agora é seu em definitivo.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _processing = false;
        }
    }

    private void OnMoneyChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        // Strip dots (thousand sep) and keep only digits + comma
        var cleaned = new string(raw.Where(c => char.IsDigit(c) || c == ',').ToArray());

        if (decimal.TryParse(cleaned, NumberStyles.AllowDecimalPoint, BrazilCulture, out var parsed))
            _newOfferMoney = Math.Max(0, decimal.Round(parsed, 2, MidpointRounding.AwayFromZero));
        else
            _newOfferMoney = 0m;
    }

    private static string TranslateType(string type) => type switch
    {
        "Sale" => "Venda",
        "Loan" => "Empréstimo",
        "Swap" => "Troca",
        _ => type
    };

    private static string TranslateStatus(string status) => status switch
    {
        "Pending" => "Pendente",
        "Accepted" => "Aceita",
        "Rejected" => "Recusada",
        "Countered" => "Contraofertada",
        "Cancelled" => "Cancelada",
        "Expired" => "Expirada",
        _ => status
    };

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Accepted" => "bg-success",
        "Rejected" => "bg-danger",
        "Countered" => "bg-info",
        "Cancelled" => "bg-secondary",
        "Expired" => "bg-secondary",
        _ => "bg-warning text-dark"
    };

    private enum SubTab
    {
        Received,
        Sent,
        Finished,
        Loans,
        NewOffer
    }
