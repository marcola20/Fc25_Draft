@page "/times/caixa"
@using System.Globalization
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Interfaces
@inject TeamsApiClient TeamsApiClient
@inject IPricingService PricingService
@inject ILogger<Fc25Draft.Web.Pages.Teams.Budget> Logger

<PageTitle>Valor de Elenco</PageTitle>

<PageHeader Title="Valor de Elenco"
            Subtitle="Valor de elenco de cada time." />

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}
else if (_isLoading)
{
    <div class="alert alert-info" role="status">Carregando valor de elenco dos times...</div>
}
else if (_rows.Count == 0)
{
    <div class="alert alert-warning" role="status">Nenhum time encontrado.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Time</th>
                    <th scope="col">Responsável</th>
                    <th scope="col" class="text-end">
                        <button type="button"
                                class="btn btn-link btn-sm p-0 text-decoration-none text-body fw-semibold"
                                @onclick="ToggleSort">
                            Valor de Elenco
                            <span class="ms-1" aria-hidden="true">@(_sortDesc ? "↓" : "↑")</span>
                        </button>
                    </th>
                </tr>
            </thead>
            <tbody>
                @for (var index = 0; index < _sortedRows.Count; index++)
                {
                    var row = _sortedRows[index];
                    <tr>
                        <td>@(index + 1)</td>
                        <td class="fw-semibold">@row.TeamName</td>
                        <td>@(string.IsNullOrWhiteSpace(row.OwnerName) ? "-" : row.OwnerName)</td>
                        <td class="text-end text-nowrap">@FormatCurrency(row.SquadValue)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private static readonly CultureInfo BrazilCulture = new("pt-BR");
    private readonly List<SquadValueRow> _rows = new();
    private IReadOnlyList<SquadValueRow> _sortedRows = Array.Empty<SquadValueRow>();
    private bool _isLoading = true;
    private string? _errorMessage;
    private bool _sortDesc = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _rows.Clear();

        try
        {
            var budgetsTask = TeamsApiClient.GetBudgetsAsync();
            var rostersTask = TeamsApiClient.GetRostersAsync();

            await Task.WhenAll(budgetsTask, rostersTask);

            var budgets = await budgetsTask;
            var rosters = await rostersTask;

            var rosterMap = rosters.ToDictionary(r => r.TeamId);

            foreach (var team in budgets)
            {
                decimal squadValue = 0m;

                if (rosterMap.TryGetValue(team.TeamId, out var roster))
                {
                    foreach (var player in roster.Jogadores)
                    {
                        try
                        {
                            var pricing = await PricingService.CalculateForPlayerAsync(player.PlayerId, default);
                            squadValue += pricing.BasePrice;
                        }
                        catch
                        {
                            // ignore pricing failures
                        }
                    }
                }

                _rows.Add(new SquadValueRow(team.TeamId, team.TeamName, team.OwnerName, squadValue));
            }

            ApplySort();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao carregar valor de elenco dos times.");
            _errorMessage = "Não foi possível carregar o valor de elenco dos times. Tente novamente.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleSort()
    {
        _sortDesc = !_sortDesc;
        ApplySort();
    }

    private void ApplySort()
    {
        _sortedRows = (_sortDesc
                ? _rows.OrderByDescending(r => r.SquadValue).ThenBy(r => r.TeamName)
                : _rows.OrderBy(r => r.SquadValue).ThenBy(r => r.TeamName))
            .ToList();
    }

    private static string FormatCurrency(decimal value) => value.ToString("C", BrazilCulture);

    private sealed record SquadValueRow(Guid TeamId, string TeamName, string? OwnerName, decimal SquadValue);
}
