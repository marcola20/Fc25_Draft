@page "/times/caixa"
@using System.Globalization
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Interfaces
@inject TeamsApiClient TeamsApiClient
@inject IPricingService PricingService
@inject ILogger<Fc25Draft.Web.Pages.Teams.Budget> Logger
@inject EscudoService Escudos

<PageTitle>Valor de Elenco</PageTitle>

<PageHeader Title="Valor de Elenco"
            Subtitle="Valor de elenco de cada time." />

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}
else if (_isLoading)
{
    <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
}
else if (_rows.Count == 0)
{
    <div class="painel p-3 small text-body-secondary">Nenhum time encontrado.</div>
}
else
{
    var maior = _rows.Max(r => r.SquadValue);
    <div class="table-responsive painel">
        <table class="table table-hover align-middle mb-0 elenco-tabela">
            <thead>
                <tr>
                    <th scope="col" style="width: 3rem;">#</th>
                    <th scope="col">Time</th>
                    <th scope="col" class="d-none d-md-table-cell">Responsável</th>
                    <th scope="col" class="d-none d-sm-table-cell" style="width: 30%;"></th>
                    <th scope="col" class="text-end">
                        <button type="button" class="ordenar ativo" @onclick="ToggleSort">
                            Valor de elenco
                            <Icone Nome="@(_sortDesc ? "arrow-down" : "arrow-up")" Tamanho="12" />
                        </button>
                    </th>
                </tr>
            </thead>
            <tbody>
                @for (var index = 0; index < _sortedRows.Count; index++)
                {
                    var row = _sortedRows[index];
                    var maisCaro = row.SquadValue == maior && maior > 0;
                    <tr>
                        <td><span class="num-posicao @(maisCaro ? "podio" : "zona-neutra")">@(_sortDesc ? index + 1 : _sortedRows.Count - index)</span></td>
                        <td class="text-nowrap">
                            <a href="/teams/details/@row.TeamId" class="elenco-time">
                                <img src="@Escudos.GetEscudo(row.TeamName)" alt="" width="24" height="24" />
                                @row.TeamName
                            </a>
                        </td>
                        <td class="d-none d-md-table-cell text-body-secondary">@(string.IsNullOrWhiteSpace(row.OwnerName) ? "—" : row.OwnerName)</td>
                        <td class="d-none d-sm-table-cell">
                            <div class="elenco-barra"><span class="@(maisCaro ? "topo" : "")" style="width: @Largura(row.SquadValue, maior)%;"></span></div>
                        </td>
                        <td class="text-end text-nowrap numero fw-medium text-body-emphasis">@FormatCurrency(row.SquadValue)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private static readonly CultureInfo BrazilCulture = new("pt-BR");
    private readonly List<SquadValueRow> _rows = new();
    private IReadOnlyList<SquadValueRow> _sortedRows = Array.Empty<SquadValueRow>();
    private bool _isLoading = true;
    private string? _errorMessage;
    private bool _sortDesc = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _rows.Clear();

        try
        {
            var budgetsTask = TeamsApiClient.GetBudgetsAsync();
            var rostersTask = TeamsApiClient.GetRostersAsync();

            await Task.WhenAll(budgetsTask, rostersTask);

            var budgets = await budgetsTask;
            var rosters = await rostersTask;

            var rosterMap = rosters.ToDictionary(r => r.TeamId);

            foreach (var team in budgets)
            {
                decimal squadValue = 0m;

                if (rosterMap.TryGetValue(team.TeamId, out var roster))
                {
                    foreach (var player in roster.Jogadores)
                    {
                        try
                        {
                            var pricing = await PricingService.CalculateForPlayerAsync(player.PlayerId, default);
                            squadValue += pricing.BasePrice;
                        }
                        catch
                        {
                            // ignore pricing failures
                        }
                    }
                }

                _rows.Add(new SquadValueRow(team.TeamId, team.TeamName, team.OwnerName, squadValue));
            }

            ApplySort();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao carregar valor de elenco dos times.");
            _errorMessage = "Não foi possível carregar o valor de elenco dos times. Tente novamente.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleSort()
    {
        _sortDesc = !_sortDesc;
        ApplySort();
    }

    private void ApplySort()
    {
        _sortedRows = (_sortDesc
                ? _rows.OrderByDescending(r => r.SquadValue).ThenBy(r => r.TeamName)
                : _rows.OrderBy(r => r.SquadValue).ThenBy(r => r.TeamName))
            .ToList();
    }

    private static string FormatCurrency(decimal value) => value.ToString("C", BrazilCulture);

    // Largura da barra em relação ao elenco mais caro (o mais caro enche a barra).
    private static string Largura(decimal valor, decimal maior) =>
        (maior <= 0 ? 0 : valor / maior * 100).ToString("0.#", CultureInfo.InvariantCulture);

    private sealed record SquadValueRow(Guid TeamId, string TeamName, string? OwnerName, decimal SquadValue);
}
