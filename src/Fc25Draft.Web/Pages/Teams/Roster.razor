@page "/times/elencos"
@page "/teams/roster"
@using Fc25Draft.Core.DTOs
@inject TeamsApiClient TeamsApiClient
@inject EscudoService EscudoService
@inject NavigationManager Navigation
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService
@inject ILogger<Fc25Draft.Web.Pages.Teams.Roster> Logger

@implements IDisposable


<PageHeader Title="Elencos"
            Subtitle="Escolha um clube para ver o elenco completo" />

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2" role="status">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>Carregando equipes...</span>
    </div>
}
else if (teams.Count == 0)
{
    <div class="alert alert-warning" role="status">Nenhuma equipe encontrada.</div>
}
else
{
    <div class="clubes">
        @foreach (var team in teams)
        {
            <a class="clube" href="/teams/details/@team.TeamId">
                <span class="clube-faixa" style="background: @Faixa(team.TeamName)" aria-hidden="true"></span>
                <img class="clube-escudo" src="@GetTeamEscudo(team.TeamName)" alt="" width="48" height="48" />
                <span class="clube-texto">
                    <span class="clube-nome">@team.TeamName</span>
                    <span class="clube-comissao">
                        @(string.IsNullOrWhiteSpace(team.OwnerName) ? "Sem técnico" : team.OwnerName)@(string.IsNullOrWhiteSpace(team.AuxiliarName) ? "" : $" · {team.AuxiliarName}")
                    </span>
                    <span class="clube-elenco"><span class="numero">@team.Jogadores</span> jogador@(team.Jogadores == 1 ? "" : "es")</span>
                </span>
                <Icone Nome="chevron-right" Tamanho="16" Classe="clube-seta" />
            </a>
        }
    </div>
}

@code {
    private readonly List<TeamListItemDto> teams = new();
    private bool isLoading = true;
    private string? errorMessage;
    private CancellationTokenSource? loadCts;

    // As cores de cada clube, na ordem da camisa. A faixa no topo do cartão mostra todas em partes iguais:
    // assim os clubes de preto (Botafogo, Corinthians...) aparecem pelo branco também no tema escuro.
    private const string Preto = "#141414";
    private const string Branco = "#f2f2f2";

    private static readonly Dictionary<string, string[]> CoresDosClubes = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Botafogo"] = [Preto, Branco],
        ["Corinthians"] = [Branco, Preto],
        ["Coritiba"] = ["#1a6b2f", Branco],
        ["Cruzeiro"] = ["#1a3e8c", Branco],
        ["Figueirense"] = [Preto, Branco],
        ["Flamengo"] = ["#c8102e", Preto],
        ["Fluminense"] = ["#8b1a2b", Branco, "#1f6b3a"],
        ["Grêmio"] = ["#3b6ab5", Preto, Branco],
        ["Internacional"] = ["#c8102e", Branco],
        ["Juventude"] = ["#00843d", Branco],
        ["Náutico"] = ["#c8102e", Branco],
        ["Palmeiras"] = ["#006437", Branco],
        ["Paraná"] = ["#1a3e8c", "#c8102e", Branco],
        ["Santos"] = [Branco, Preto],
        ["São Paulo"] = ["#c8102e", Branco, Preto],
        ["Sport"] = ["#d71920", Preto],
        ["Vasco"] = [Preto, Branco],
        ["Vitória"] = ["#e30613", Preto],
    };

    /// <summary>Para clubes fora da lista, uma cor fixa derivada do nome (com branco ao lado).</summary>
    private static readonly string[] CoresExtras =
        { "#1a6b2f", "#1a3e8c", "#c8102e", "#8b1a2b", "#006437", "#3b6ab5", "#b45309", "#0f766e" };

    private static string[] CoresDoClube(string name)
    {
        if (CoresDosClubes.TryGetValue(name, out var cores)) return cores;
        if (string.IsNullOrWhiteSpace(name)) return ["#888780"];

        var soma = name.Where(char.IsLetterOrDigit).Sum(c => (int)char.ToLowerInvariant(c));
        return [CoresExtras[soma % CoresExtras.Length], Branco];
    }

    /// <summary>Faixas de cor sólidas e de mesma largura (corte seco, sem degradê).</summary>
    private static string Faixa(string name)
    {
        var cores = CoresDoClube(name);
        if (cores.Length == 1) return cores[0];
        var partes = cores.Select((c, i) =>
        {
            var de = (i * 100.0 / cores.Length).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            var ate = ((i + 1) * 100.0 / cores.Length).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            return $"{c} {de}% {ate}%";
        });
        return $"linear-gradient(90deg, {string.Join(", ", partes)})";
    }

    // Escudo vem da pasta wwwroot/images/escudos: basta o arquivo ter o nome do time.
    private string GetTeamEscudo(string name) => EscudoService.GetEscudo(name);

    protected override async Task OnInitializedAsync()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/times/elencos"));
        await LoadTeamsAsync();
    }

    private async Task LoadTeamsAsync()
    {
        isLoading = true;
        errorMessage = null;
        teams.Clear();
        loadCts?.Cancel();
        loadCts = new CancellationTokenSource();

        try
        {
            var result = await TeamsApiClient.GetAsync(search: null, page: 1, pageSize: 100, loadCts.Token);
            teams.AddRange(result.Items);
        }
        catch (OperationCanceledException)
        {
            errorMessage = "Carregamento cancelado.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LayoutNav:Error ao carregar elencos de equipes");
            errorMessage = "Não foi possível carregar as equipes. Tente novamente em instantes.";
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
        loadCts?.Cancel();
        loadCts?.Dispose();
    }
}