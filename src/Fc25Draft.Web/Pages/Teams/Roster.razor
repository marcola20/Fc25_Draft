@page "/teams/roster"
@using System.Globalization
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Extensions
@inject TeamsApiClient TeamsApiClient
@inject NavigationManager Navigation

<h3>Elencos das Equipes</h3>

<p class="text-muted">Selecione uma equipe para visualizar a relação completa de jogadores.</p>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <p><em>Carregando equipes...</em></p>
}
else if (teams.Count == 0)
{
    <p>Nenhuma equipe encontrada.</p>
}
else
{
    <div class="row g-4">
        @foreach (var team in teams)
        {
            <div class="col-12 col-lg-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@team.TeamName</h5>
                        <p class="card-text mb-2">
                            <span class="text-muted">Responsável:</span>
                            @(string.IsNullOrWhiteSpace(team.OwnerName) ? "-" : team.OwnerName)
                        </p>
                        <p class="card-text mb-3">
                            <strong>@team.PlayerCount</strong> jogador@(team.PlayerCount == 1 ? string.Empty : "es") cadastrados.
                        </p>

                        <div class="flex-grow-1 d-flex flex-column">
                            @if (team.SortedPlayers.Count == 0)
                            {
                                <p class="text-muted mt-3 mb-0">Nenhum jogador vinculado.</p>
                            }
                            else
                            {
                                <div class="table-responsive mt-3">
                                    <table class="table table-striped table-sm mb-0">
                                        <thead>
                                            <tr>
                                                <th scope="col">Jogador</th>
                                                <th scope="col" class="text-center" aria-sort="@GetAriaSort(team, RosterSortColumn.Position)">
                                                    <button type="button"
                                                            class="@GetSortButtonClass(team, RosterSortColumn.Position)"
                                                            @onclick="() => ToggleRosterSort(team, RosterSortColumn.Position)">
                                                        Posição
                                                        @if (team.ActiveSortColumn == RosterSortColumn.Position)
                                                        {
                                                            <span class="ms-1" aria-hidden="true">@(team.SortDescending ? "▼" : "▲")</span>
                                                            <span class="visually-hidden">@GetSortDirectionDescription(team, RosterSortColumn.Position)</span>
                                                        }
                                                    </button>
                                                </th>
                                                <th scope="col" class="text-end" aria-sort="@GetAriaSort(team, RosterSortColumn.Overall)">
                                                    <button type="button"
                                                            class="@GetSortButtonClass(team, RosterSortColumn.Overall)"
                                                            @onclick="() => ToggleRosterSort(team, RosterSortColumn.Overall)">
                                                        Overall
                                                        @if (team.ActiveSortColumn == RosterSortColumn.Overall)
                                                        {
                                                            <span class="ms-1" aria-hidden="true">@(team.SortDescending ? "▼" : "▲")</span>
                                                            <span class="visually-hidden">@GetSortDirectionDescription(team, RosterSortColumn.Overall)</span>
                                                        }
                                                    </button>
                                                </th>
                                                <th scope="col" class="text-end" aria-sort="@GetAriaSort(team, RosterSortColumn.Age)">
                                                    <button type="button"
                                                            class="@GetSortButtonClass(team, RosterSortColumn.Age)"
                                                            @onclick="() => ToggleRosterSort(team, RosterSortColumn.Age)">
                                                        Idade
                                                        @if (team.ActiveSortColumn == RosterSortColumn.Age)
                                                        {
                                                            <span class="ms-1" aria-hidden="true">@(team.SortDescending ? "▼" : "▲")</span>
                                                            <span class="visually-hidden">@GetSortDirectionDescription(team, RosterSortColumn.Age)</span>
                                                        }
                                                    </button>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var player in team.SortedPlayers)
                                            {
                                                <tr>
                                                    <td>@player.Name</td>
                                                    <td class="text-center">@player.Position</td>
                                                    <td class="text-end">@player.Overall</td>
                                                    <td class="text-end">@(player.Age?.ToString(CultureInfo.InvariantCulture) ?? "-")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>

                        <div class="mt-3">
                            <button class="btn btn-primary" @onclick="@(() => Navigation.NavigateTo($"/teams/details/{team.TeamId}"))">
                                Ver elenco completo
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private readonly List<TeamRosterViewModel> teams = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadTeamsAsync();
    }

    private async Task LoadTeamsAsync()
    {
        isLoading = true;
        errorMessage = null;
        teams.Clear();

        try
        {
            var result = await TeamsApiClient.GetRostersAsync();

            foreach (var roster in result)
            {
                teams.Add(new TeamRosterViewModel(roster));
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleRosterSort(TeamRosterViewModel team, RosterSortColumn column)
    {
        team.ToggleSort(column);
    }

    private static string GetSortButtonClass(TeamRosterViewModel team, RosterSortColumn column)
    {
        var classes = "btn btn-link btn-sm p-0 text-decoration-none text-body";

        if (team.ActiveSortColumn == column)
        {
            classes += " fw-semibold";
        }

        return classes;
    }

    private static string GetAriaSort(TeamRosterViewModel team, RosterSortColumn column)
    {
        if (team.ActiveSortColumn != column)
        {
            return "none";
        }

        return team.SortDescending ? "descending" : "ascending";
    }

    private static string GetSortDirectionDescription(TeamRosterViewModel team, RosterSortColumn column)
    {
        if (team.ActiveSortColumn != column)
        {
            return "Sem ordenação ativa";
        }

        return team.SortDescending ? "Ordenado em ordem decrescente" : "Ordenado em ordem crescente";
    }

    private enum RosterSortColumn
    {
        Position,
        Overall,
        Age
    }

    private sealed class TeamRosterViewModel
    {
        private readonly List<RosterPlayerViewModel> _players = new();
        private IReadOnlyList<RosterPlayerViewModel> _sortedPlayers = Array.Empty<RosterPlayerViewModel>();
        private RosterSortColumn? _activeSortColumn = RosterSortColumn.Position;
        private bool _sortDescending;

        public TeamRosterViewModel(TeamRosterDto dto)
        {
            TeamId = dto.TeamId;
            TeamName = dto.TeamName;
            OwnerName = dto.OwnerName;

            if (dto.Jogadores is not null)
            {
                foreach (var player in dto.Jogadores)
                {
                    _players.Add(new RosterPlayerViewModel(
                        player.PlayerGuid,
                        player.PlayerId,
                        player.Nome,
                        player.Posicao,
                        player.Posicao.ToPositionId(),
                        player.Overall,
                        player.Idade,
                        player.EscolhidoEm,
                        player.Rodada,
                        player.Escolha));
                }
            }

            ApplySort();
        }

        public Guid TeamId { get; }
        public string TeamName { get; }
        public string? OwnerName { get; }
        public int PlayerCount => _players.Count;
        public IReadOnlyList<RosterPlayerViewModel> SortedPlayers => _sortedPlayers;
        public RosterSortColumn? ActiveSortColumn => _activeSortColumn;
        public bool SortDescending => _sortDescending;

        public void ToggleSort(RosterSortColumn column)
        {
            if (_activeSortColumn == column)
            {
                _sortDescending = !_sortDescending;
            }
            else
            {
                _activeSortColumn = column;
                _sortDescending = column switch
                {
                    RosterSortColumn.Age => false,
                    RosterSortColumn.Position => false,
                    _ => true
                };
            }

            ApplySort();
        }

        private void ApplySort()
        {
            IEnumerable<RosterPlayerViewModel> query = _players;

            if (_activeSortColumn is null)
            {
                query = query.OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase);
            }
            else
            {
                query = _activeSortColumn switch
                {
                    RosterSortColumn.Position => _sortDescending
                        ? query.OrderBy(p => p.PositionId <= 0)
                            .ThenByDescending(p => p.PositionId)
                            .ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                        : query.OrderBy(p => p.PositionId <= 0)
                            .ThenBy(p => p.PositionId)
                            .ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
                    RosterSortColumn.Overall => _sortDescending
                        ? query.OrderByDescending(p => p.Overall).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                        : query.OrderBy(p => p.Overall).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
                    RosterSortColumn.Age => _sortDescending
                        ? query.OrderByDescending(p => p.Age ?? int.MinValue).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                        : query.OrderBy(p => p.Age ?? int.MaxValue).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
                    _ => query
                };
            }

            _sortedPlayers = query.ToList();
        }
    }

    private sealed record RosterPlayerViewModel(
        Guid PlayerGuid,
        int PlayerId,
        string Name,
        string Position,
        int PositionId,
        int Overall,
        int? Age,
        DateTime? PickedAt,
        int? Round,
        int? Pick);
}
