@page "/times/elencos"
@page "/teams/roster"
@using Fc25Draft.Core.DTOs
@inject TeamsApiClient TeamsApiClient
@inject NavigationManager Navigation
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService
@inject ILogger<Fc25Draft.Web.Pages.Teams.Roster> Logger

@implements IDisposable

<PageHeader Title="Elencos"
            Subtitle="Selecione uma equipe para visualizar a relação completa de jogadores." />

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2" role="status">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>Carregando equipes...</span>
    </div>
}
else if (teams.Count == 0)
{
    <div class="alert alert-warning" role="status">Nenhuma equipe encontrada.</div>
}
else
{
    <div class="row g-4">
        @foreach (var team in teams)
        {
            <div class="col-12 col-lg-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@team.TeamName</h5>
                        <p class="card-text mb-2">
                            <span class="text-muted">Responsável:</span>
                            @(string.IsNullOrWhiteSpace(team.OwnerName) ? "-" : team.OwnerName)
                        </p>
                        <p class="card-text mb-4">
                            <strong>@team.Jogadores</strong> jogador@(team.Jogadores == 1 ? string.Empty : "es") cadastrados.
                        </p>
                        <div class="mt-auto">
                            <button class="btn btn-primary" @onclick="@(() => Navigation.NavigateTo($"/teams/details/{team.TeamId}"))">
                                Ver elenco completo
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private readonly List<TeamListItemDto> teams = new();
    private bool isLoading = true;
    private string? errorMessage;
    private CancellationTokenSource? loadCts;

    protected override async Task OnInitializedAsync()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/times/elencos"));
        await LoadTeamsAsync();
    }

    private async Task LoadTeamsAsync()
    {
        isLoading = true;
        errorMessage = null;
        teams.Clear();
        loadCts?.Cancel();
        loadCts = new CancellationTokenSource();

        try
        {
            var result = await TeamsApiClient.GetAsync(search: null, page: 1, pageSize: 100, loadCts.Token);
            teams.AddRange(result.Items);
        }
        catch (OperationCanceledException)
        {
            errorMessage = "Carregamento cancelado.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LayoutNav:Error ao carregar elencos de equipes");
            errorMessage = "Não foi possível carregar as equipes. Tente novamente em instantes.";
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
        loadCts?.Cancel();
        loadCts?.Dispose();
    }
}
