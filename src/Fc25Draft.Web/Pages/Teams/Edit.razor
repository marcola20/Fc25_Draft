@page "/teams/edit"
@page "/teams/edit/{Id:guid}"
@using Fc25Draft.Core.DTOs
@inject TeamsApiClient TeamsApiClient
@inject NavigationManager Navigation
@inject AdminAuthService AdminAuth

@implements IDisposable

<h3>@Title</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (isLoading)
{
    <p><em>Carregando...</em></p>
}
else if (!AdminAuth.IsAdmin)
{
    <div class="alert alert-warning" role="alert">Apenas administradores podem cadastrar ou editar equipes.</div>
    <button class="btn btn-secondary" @onclick="Cancel">Voltar</button>
}
else
{
    <EditForm EditContext="editContext" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label" for="teamName">Nome do Time</label>
            <InputText id="teamName" class="form-control" @bind-Value="model.TeamName" />
            <ValidationMessage For="() => model.TeamName" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="ownerName">Responsável</label>
            <InputText id="ownerName" class="form-control" @bind-Value="model.OwnerName" />
            <ValidationMessage For="() => model.OwnerName" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="auxiliarName">Auxiliar <span class="text-muted">(opcional)</span></label>
            <InputText id="auxiliarName" class="form-control" @bind-Value="model.AuxiliarName" />
            <ValidationMessage For="() => model.AuxiliarName" />
            <div class="form-text">Ao preencher, um token de acesso próprio é gerado automaticamente para o auxiliar, com as mesmas permissões do responsável. Ao limpar o campo, o acesso do auxiliar é revogado.</div>
        </div>

        @if (Id.HasValue)
        {
            <div class="card mb-3">
                <div class="card-header">Tokens de acesso</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label d-block">Token do Responsável</label>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <code>@currentToken</code>
                            <button type="button" class="btn btn-sm btn-outline-warning" @onclick="HandleRegenerateTokenAsync" disabled="@isRegeneratingToken">
                                @(isRegeneratingToken ? "Gerando..." : "Regenerar")
                            </button>
                        </div>
                        <div class="form-text">O token atual deixa de funcionar imediatamente ao regenerar.</div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(model.AuxiliarName))
                    {
                        <div class="mb-0">
                            <label class="form-label d-block">Token do Auxiliar</label>
                            @if (string.IsNullOrWhiteSpace(currentAuxToken))
                            {
                                <div class="text-muted small">Será gerado automaticamente ao salvar.</div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <code>@currentAuxToken</code>
                                    <button type="button" class="btn btn-sm btn-outline-warning" @onclick="HandleRegenerateAuxTokenAsync" disabled="@isRegeneratingAuxToken">
                                        @(isRegeneratingAuxToken ? "Gerando..." : "Regenerar")
                                    </button>
                                </div>
                                <div class="form-text">O token atual deixa de funcionar imediatamente ao regenerar.</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit" disabled="@isSaving">Salvar</button>
            <button class="btn btn-secondary" type="button" @onclick="Cancel">Cancelar</button>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private readonly TeamFormModel model = new();
    private EditContext? editContext;
    private string? errorMessage;
    private string? successMessage;
    private bool isSaving;
    private bool isLoading = true;
    private bool authInitialized;
    private string? currentToken;
    private string? currentAuxToken;
    private bool isRegeneratingToken;
    private bool isRegeneratingAuxToken;

    private string Title => Id.HasValue ? "Editar Time" : "Novo Time";

    protected override void OnInitialized()
    {
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(model);

        if (Id.HasValue)
        {
            await LoadTeamAsync(Id.Value);
        }

        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AdminAuth.EnsureInitializedAsync();
        authInitialized = true;
        StateHasChanged();
    }

    private async Task LoadTeamAsync(Guid id)
    {
        try
        {
            var details = await TeamsApiClient.GetByIdAsync(id);
            if (details is null)
            {
                errorMessage = "Time não encontrado.";
                return;
            }

            model.TeamName = details.TeamName;
            model.OwnerName = details.OwnerName;
            model.AuxiliarName = details.AuxiliarName;
            currentToken = details.Token;
            currentAuxToken = details.AuxToken;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task HandleRegenerateTokenAsync()
    {
        if (!Id.HasValue) return;

        isRegeneratingToken = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            currentToken = await TeamsApiClient.RegenerateTokenAsync(Id.Value);
            successMessage = "Token do responsável regenerado.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isRegeneratingToken = false;
        }
    }

    private async Task HandleRegenerateAuxTokenAsync()
    {
        if (!Id.HasValue) return;

        isRegeneratingAuxToken = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            currentAuxToken = await TeamsApiClient.RegenerateAuxTokenAsync(Id.Value);
            successMessage = "Token do auxiliar regenerado.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isRegeneratingAuxToken = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (editContext is null)
        {
            return;
        }

        if (!AdminAuth.IsAdmin)
        {
            errorMessage = "Entre como administrador para salvar alterações.";
            return;
        }

        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (Id.HasValue)
            {
                await TeamsApiClient.UpdateAsync(Id.Value, new TeamUpdateDto(model.TeamName!, model.OwnerName, model.AuxiliarName));
            }
            else
            {
                await TeamsApiClient.CreateAsync(new TeamCreateDto(model.TeamName!, model.OwnerName, model.AuxiliarName));
            }

            Navigation.NavigateTo("/teams");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel() => Navigation.NavigateTo("/teams");

    private void OnAuthenticationChanged()
    {
        if (!authInitialized)
        {
            return;
        }

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
    }

    private sealed class TeamFormModel
    {
        [Required]
        [StringLength(80, MinimumLength = 2)]
        public string? TeamName { get; set; }

        [StringLength(80)]
        public string? OwnerName { get; set; }

        [StringLength(80)]
        public string? AuxiliarName { get; set; }
    }
}
