@page "/teams/edit"
@page "/teams/edit/{Id:guid}"
@inject ITeamService TeamService
@inject NavigationManager Navigation

<h3>@Title</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm EditContext="editContext" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label" for="teamName">Team Name</label>
            <InputText id="teamName" class="form-control" @bind-Value="model.TeamName" />
            <ValidationMessage For="() => model.TeamName" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="ownerName">Owner Name</label>
            <InputText id="ownerName" class="form-control" @bind-Value="model.OwnerName" />
            <ValidationMessage For="() => model.OwnerName" />
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit" disabled="@isSaving">Save</button>
            <button class="btn btn-secondary" type="button" @onclick="Cancel">Cancel</button>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private readonly TeamFormModel model = new();
    private EditContext? editContext;
    private string? errorMessage;
    private bool isSaving;
    private bool isLoading = true;

    private string Title => Id.HasValue ? "Edit Team" : "Create Team";

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(model);

        if (Id.HasValue)
        {
            try
            {
                var team = await TeamService.GetAsync(Id.Value);
                if (team is null)
                {
                    errorMessage = "Team not found.";
                }
                else
                {
                    model.TeamName = team.TeamName;
                    model.OwnerName = team.OwnerName;
                }
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
            }
        }

        isLoading = false;
    }

    private async Task HandleValidSubmit()
    {
        if (editContext is null)
        {
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            if (Id.HasValue)
            {
                await TeamService.UpdateAsync(Id.Value, new TeamUpdateDto(model.TeamName!, model.OwnerName));
            }
            else
            {
                await TeamService.CreateAsync(new TeamCreateDto(model.TeamName!, model.OwnerName));
            }

            Navigation.NavigateTo("/teams");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/teams");
    }

    private sealed class TeamFormModel
    {
        [Required]
        [StringLength(80, MinimumLength = 2)]
        public string? TeamName { get; set; }

        [StringLength(80)]
        public string? OwnerName { get; set; }
    }
}
