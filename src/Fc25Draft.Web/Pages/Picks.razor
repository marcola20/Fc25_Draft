@page "/picks"
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService

<PageTitle>Picks do Draft — CBFV</PageTitle>

<PageHeader Title="Picks do Draft" />

@code {
    protected override void OnInitialized()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/picks"));
    }
}

<div class="picks-page">

    <div class="picks-tabs" role="tablist">
        @foreach (var regra in Regras)
        {
            var r = regra;
            <button type="button" role="tab" aria-selected="@(r == _regra)"
                    class="picks-tab @(r == _regra ? "active" : "")" @onclick="() => _regra = r">
                <span class="picks-tab-title">@r.Aba</span>
                <span class="picks-tab-sub">@r.AbaSub</span>
            </button>
        }
    </div>

    <section class="picks-section">
        <div class="picks-card picks-card-info">
            <p>@_regra.Intro</p>
        </div>
    </section>

    <hr class="picks-divider" />

    <!-- ═══ ROUND 1 ═══ -->
    <section class="picks-section">
        <div class="picks-section-header">
            <span class="picks-section-icon">🏆</span>
            <h3>Round 1 — Liga</h3>
        </div>
        <p class="picks-section-desc">@_regra.R1Desc</p>
        @TabelaPicks(("Resultado na Liga", _regra.R1))
    </section>

    @LoteriaSecao(_regra.R1Loteria)

    <hr class="picks-divider" />

    <!-- ═══ ROUND 2 ═══ -->
    <section class="picks-section">
        <div class="picks-section-header">
            <span class="picks-section-icon">🥇</span>
            <h3>Round 2 — Copa</h3>
        </div>
        <p class="picks-section-desc">@_regra.R2Desc</p>
        @TabelaPicks(("Resultado na Copa", _regra.R2))
    </section>

    @LoteriaSecao(_regra.R2Loteria)

    <hr class="picks-divider" />

    <section class="picks-section">
        <div class="picks-section-header">
            <span class="picks-section-icon">🗺️</span>
            <h3>Mapa de Picks — Round 1</h3>
        </div>
        @MapaPicks(_regra.R1)
    </section>

    <section class="picks-section picks-section-sub">
        <div class="picks-section-header">
            <span class="picks-section-icon">🗺️</span>
            <h3>Mapa de Picks — Round 2</h3>
        </div>
        @MapaPicks(_regra.R2)
    </section>

</div>

@code {
    // Tom = red | orange | blue | green | silver | gold: cor da linha, das picks e do mapa.
    private sealed record PickRow(
        string Icon,
        string Stage,
        int[] Picks,
        string RangeLabel,
        string Tom,
        string MapLabel);

    private sealed record LotteryEntry(string Icon, string Stage, string Detail, int Pct, string Tom);

    private sealed record LotteryBlock(string? Title, string? Sub, IReadOnlyList<LotteryEntry> Entries);

    private sealed record LotterySection(string Title, string Desc, IReadOnlyList<LotteryBlock> Blocks, MarkupString Note);

    private sealed record RegraPicks(
        string Aba,
        string AbaSub,
        string Intro,
        string R1Desc,
        IReadOnlyList<PickRow> R1,
        LotterySection R1Loteria,
        string R2Desc,
        IReadOnlyList<PickRow> R2,
        LotterySection R2Loteria);

    // ── Regra atual: 12 times, uma divisão ──────────────────────────────────
    private static readonly RegraPicks RegraAtual = new(
        Aba: "Próximo draft",
        AbaSub: "12 times · regra atual",
        Intro: "O draft tem dois rounds: o Round 1 segue a classificação final da Liga e o Round 2 segue o desempenho na Copa. Nos dois, quem foi pior escolhe antes.",
        R1Desc: "Baseado na classificação final da fase de Liga (pontos corridos). O pior time da Liga tem a maior chance de ficar com a pick #1.",
        R1: new List<PickRow>
        {
            new("🎰", "9° ao 12° da Liga", [1, 2, 3, 4], "Loteria 1–4",  "red",    "Loteria"),
            new("⚖️", "7° e 8° da Liga",   [5, 6],       "50/50 5–6",    "orange", "50/50 7°/8°"),
            new("⚖️", "5° e 6° da Liga",   [7, 8],       "50/50 7–8",    "orange", "50/50 5°/6°"),
            new("⚖️", "3° e 4° da Liga",   [9, 10],      "50/50 9–10",   "blue",   "50/50 3°/4°"),
            new("⚖️", "1° e 2° da Liga",   [11, 12],     "50/50 11–12",  "green",  "50/50 1°/2°"),
        },
        R1Loteria: new(
            "Loteria R1 — Pick #1",
            "Os 4 piores times da Liga (9° ao 12°) disputam a pick #1 por loteria ponderada.",
            [
                new(null, null,
                [
                    new("🔴", "12° da Liga", "Pior classificado",    35, "red"),
                    new("🔴", "11° da Liga", "2° pior classificado", 35, "red"),
                    new("🟠", "10° da Liga", "3° pior classificado", 15, "orange"),
                    new("🟠", "9° da Liga",  "4° pior classificado", 15, "orange"),
                ]),
            ],
            new("O 11° e o 12° têm juntos <strong>70%</strong> de chance de pegar a pick #1. As picks 2, 3 e 4 são sorteadas em sequência do mesmo pool (sem reposição). O 9° e o 10° ficam com os <strong>30%</strong> restantes.")),
        R2Desc: "Baseado no desempenho na Copa. Times eliminados na fase de grupos têm mais chances nas melhores picks. O campeão da Copa fica com a pick #12.",
        R2: new List<PickRow>
        {
            new("🎰", "Elim. Grupos — 4 piores (Copa)",    [1, 2, 3, 4], "Loteria 1–4", "red",    "Lot. Grupos A"),
            new("🎰", "Elim. Grupos — 4 seguintes (Copa)", [5, 6, 7, 8], "Loteria 5–8", "orange", "Lot. Grupos B"),
            new("🎖️", "Eliminados nas Semis",             [9, 10],      "9–10",        "blue",   "Semis"),
            new("🥈", "Vice-Campeão Copa",                 [11],         "11",          "silver", "Vice Copa"),
            new("🏆", "Campeão Copa",                      [12],         "12",          "gold",   "Campeão Copa"),
        },
        R2Loteria: new(
            "Loteria R2 — Picks #1–8",
            "Os 8 eliminados na fase de grupos disputam as picks 1–8 em dois blocos: o pior quarteto briga pelas picks 1–4 e o melhor quarteto pelas picks 5–8.",
            [
                new("Bloco A — Picks 1–4", "4 piores eliminados (Copa posição 9°–12°)",
                [
                    new("🔴", "Pior eliminado", "12° Copa", 35, "red"),
                    new("🔴", "2° eliminado",   "11° Copa", 35, "red"),
                    new("🟠", "3° eliminado",   "10° Copa", 15, "orange"),
                    new("🟠", "4° eliminado",   "9° Copa",  15, "orange"),
                ]),
                new("Bloco B — Picks 5–8", "4 próximos eliminados (Copa posição 5°–8°)",
                [
                    new("🔵", "5° eliminado", "8° Copa", 35, "blue"),
                    new("🔵", "6° eliminado", "7° Copa", 35, "blue"),
                    new("🟣", "7° eliminado", "6° Copa", 15, "purple"),
                    new("🟣", "8° eliminado", "5° Copa", 15, "purple"),
                ]),
            ],
            new("Dentro de cada bloco as picks são sorteadas em sequência, sem reposição. Pior posição na Copa = maior chance de pick antecipada.")));

    // ── Com Série A e Série B: 18 times ─────────────────────────────────────
    private static readonly RegraPicks RegraSerieB = new(
        Aba: "Com Série B",
        AbaSub: "18 times · a partir do draft seguinte",
        Intro: "Com Série A (10 times) e Série B (8 times), cada round tem 18 picks. No Round 1 a Série B escolhe antes da Série A. No Round 2 vale só a campanha na Copa, sem separar divisão. Conta a divisão em que o time jogou a temporada, e o playoff de acesso não muda as picks.",
        R1Desc: "Classificação única: os 8 da Série B vêm todos antes dos 10 da Série A. O pior da Série B tem a maior chance de ficar com a pick #1.",
        R1: new List<PickRow>
        {
            new("🎰", "3° ao 8° da Série B", [1, 2, 3, 4, 5, 6], "Loteria 1–6",  "red",    "Loteria B"),
            new("⚖️", "1° e 2° da Série B",  [7, 8],             "50/50 7–8",    "orange", "50/50 1°/2° B"),
            new("⚖️", "9° e 10° da Série A", [9, 10],            "50/50 9–10",   "blue",   "50/50 9°/10° A"),
            new("⚖️", "7° e 8° da Série A",  [11, 12],           "50/50 11–12",  "blue",   "50/50 7°/8° A"),
            new("⚖️", "5° e 6° da Série A",  [13, 14],           "50/50 13–14",  "blue",   "50/50 5°/6° A"),
            new("⚖️", "3° e 4° da Série A",  [15, 16],           "50/50 15–16",  "green",  "50/50 3°/4° A"),
            new("⚖️", "1° e 2° da Série A",  [17, 18],           "50/50 17–18",  "green",  "50/50 1°/2° A"),
        },
        R1Loteria: new(
            "Loteria R1 — Picks #1–6",
            "Os 6 piores da Série B (3° ao 8°) disputam as picks 1–6 por loteria ponderada. Quanto pior a campanha, maior a chance.",
            [
                new(null, null,
                [
                    new("🔴", "8° da Série B", "Lanterna da B",   25, "red"),
                    new("🔴", "7° da Série B", "2° pior da B",    20, "red"),
                    new("🟠", "6° da Série B", "3° pior da B",    17, "orange"),
                    new("🟠", "5° da Série B", "4° pior da B",    15, "orange"),
                    new("🔵", "4° da Série B", "5° pior da B",    13, "blue"),
                    new("🔵", "3° da Série B", "6° pior da B",    10, "blue"),
                ]),
            ],
            new("As chances acima são as da pick #1. As picks 2 a 6 saem em sequência do mesmo pool (sem reposição), então os seis ficam com as seis primeiras picks, só muda a ordem. O rebaixado da Série A <strong>não</strong> entra na loteria: ele desce com elenco melhor que o dos times da B.")),
        R2Desc: "Baseado só na campanha na Copa, com os 18 times juntos. Como há grupos de 4 e de 5 times, os eliminados nos grupos são ordenados primeiro pela posição no grupo (5°s, depois 4°s, depois 3°s) e depois pelo aproveitamento. Nas quartas e nas semis, quem teve pior aproveitamento na Copa escolhe antes.",
        R2: new List<PickRow>
        {
            new("🎰", "Elim. Grupos — 5 piores",    [1, 2, 3, 4, 5],    "Loteria 1–5", "red",    "Lot. Grupos A"),
            new("🎰", "Elim. Grupos — 5 seguintes", [6, 7, 8, 9, 10],   "Loteria 6–10", "orange", "Lot. Grupos B"),
            new("🎖️", "Eliminados nas Quartas",    [11, 12, 13, 14],   "11–14",       "blue",   "Quartas"),
            new("🎖️", "Eliminados nas Semis",      [15, 16],           "15–16",       "green",  "Semis"),
            new("🥈", "Vice-Campeão Copa",          [17],               "17",          "silver", "Vice Copa"),
            new("🏆", "Campeão Copa",               [18],               "18",          "gold",   "Campeão Copa"),
        },
        R2Loteria: new(
            "Loteria R2 — Picks #1–10",
            "Os 10 eliminados na fase de grupos disputam as picks 1–10 em dois blocos de 5: os 5 piores brigam pelas picks 1–5 e os 5 seguintes pelas picks 6–10.",
            [
                new("Bloco A — Picks 1–5", "5 piores eliminados nos grupos",
                [
                    new("🔴", "Pior eliminado", "10° entre os eliminados", 30, "red"),
                    new("🔴", "2° pior",        "9° entre os eliminados",  30, "red"),
                    new("🟠", "3° pior",        "8° entre os eliminados",  15, "orange"),
                    new("🟠", "4° pior",        "7° entre os eliminados",  15, "orange"),
                    new("🟠", "5° pior",        "6° entre os eliminados",  10, "orange"),
                ]),
                new("Bloco B — Picks 6–10", "5 melhores eliminados nos grupos",
                [
                    new("🔵", "6° pior",  "5° entre os eliminados", 30, "blue"),
                    new("🔵", "7° pior",  "4° entre os eliminados", 30, "blue"),
                    new("🟣", "8° pior",  "3° entre os eliminados", 15, "purple"),
                    new("🟣", "9° pior",  "2° entre os eliminados", 15, "purple"),
                    new("🟣", "10° pior", "Melhor eliminado",       10, "purple"),
                ]),
            ],
            new("Dentro de cada bloco as picks são sorteadas em sequência, sem reposição. Aqui a divisão não conta: time da Série A e da Série B concorrem igual.")));

    private static readonly IReadOnlyList<RegraPicks> Regras = [RegraAtual, RegraSerieB];

    private RegraPicks _regra = RegraAtual;

    private static RenderFragment TabelaPicks((string Cabecalho, IReadOnlyList<PickRow> Rows) t) => __builder =>
    {
        <div class="picks-table-wrap">
            <table class="picks-table">
                <thead>
                    <tr>
                        <th>@t.Cabecalho</th>
                        <th>Times</th>
                        <th>Picks Disponíveis</th>
                        <th class="picks-th-range">Faixa</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in t.Rows)
                    {
                        <tr class="picks-row picks-row-@row.Tom">
                            <td>
                                <div class="picks-stage-cell">
                                    <span class="picks-stage-icon">@row.Icon</span>
                                    <span class="picks-stage-name">@row.Stage</span>
                                </div>
                            </td>
                            <td class="picks-td-count">
                                <span class="picks-count-badge picks-cnt-@row.Tom">@row.Picks.Length</span>
                            </td>
                            <td>
                                <div class="picks-chips">
                                    @foreach (var pick in row.Picks)
                                    {
                                        <span class="picks-chip picks-chip-@row.Tom">@pick</span>
                                    }
                                </div>
                            </td>
                            <td class="picks-td-range">
                                <span class="picks-range-badge picks-rng-@row.Tom">@row.RangeLabel</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    private static RenderFragment LoteriaSecao(LotterySection sec) => __builder =>
    {
        <section class="picks-section picks-section-sub">
            <div class="picks-section-header">
                <span class="picks-section-icon">🎰</span>
                <h3>@sec.Title</h3>
            </div>
            <p class="picks-section-desc">@sec.Desc</p>

            <div class="@(sec.Blocks.Count > 1 ? "picks-r2-blocks" : "")">
                @foreach (var block in sec.Blocks)
                {
                    var maxPct = block.Entries.Max(e => e.Pct);
                    <div class="@(block.Title is null ? "" : "picks-r2-block")">
                        @if (block.Title is not null)
                        {
                            <div class="picks-r2-block-title">@block.Title</div>
                            <div class="picks-r2-block-sub">@block.Sub</div>
                        }
                        <div class="picks-lottery-grid @(block.Title is null ? "" : "picks-lottery-grid-2")">
                            @foreach (var entry in block.Entries)
                            {
                                <div class="picks-lottery-card picks-lot-@entry.Tom">
                                    <div class="picks-lottery-team">
                                        <span class="picks-lottery-icon">@entry.Icon</span>
                                        <div>
                                            <div class="picks-lottery-stage">@entry.Stage</div>
                                            <div class="picks-lottery-detail">@entry.Detail</div>
                                        </div>
                                    </div>
                                    <div class="picks-lottery-odds-wrap">
                                        <div class="picks-lottery-pct">@entry.Pct%</div>
                                        <div class="picks-lottery-bar-bg">
                                            <div class="picks-lottery-bar picks-lot-bar-@entry.Tom" style="width: @(entry.Pct * 100 / maxPct)%"></div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="picks-lottery-note">
                <span class="picks-lottery-note-icon">ℹ️</span>
                <span>@sec.Note</span>
            </div>
        </section>
    };

    private static RenderFragment MapaPicks(IReadOnlyList<PickRow> rows) => __builder =>
    {
        <div class="picks-map">
            @foreach (var row in rows)
            {
                foreach (var pick in row.Picks)
                {
                    <div class="picks-map-col">
                        <div class="picks-map-num picks-chip-@row.Tom">#@pick</div>
                        <div class="picks-map-label">@row.MapLabel</div>
                    </div>
                }
            }
        </div>
    };
}

<style>
    .picks-page {
        max-width: 900px;
        margin: 0 auto;
        padding-bottom: 3rem;
    }

    /* Abas de regra */
    .picks-tabs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
    }

    .picks-tab {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.1rem;
        padding: 0.65rem 0.9rem;
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.55rem;
        background: var(--bs-body-bg, #fff);
        color: var(--bs-body-color, #212529);
        text-align: left;
        cursor: pointer;
    }

    .picks-tab:hover { border-color: color-mix(in srgb, var(--bs-primary, #0d6efd) 45%, transparent); }

    .picks-tab.active {
        border-color: var(--bs-primary, #0d6efd);
        background: color-mix(in srgb, var(--bs-primary, #0d6efd) 8%, var(--bs-body-bg, #fff));
        box-shadow: inset 0 -3px 0 var(--bs-primary, #0d6efd);
    }

    .picks-tab-title { font-weight: 700; font-size: 0.95rem; color: var(--bs-emphasis-color, #212529); }
    .picks-tab-sub   { font-size: 0.75rem; color: var(--bs-secondary-color, #6c757d); }

    .picks-divider {
        border-color: var(--bs-border-color, #dee2e6);
        margin: 2rem 0;
        opacity: 0.4;
    }

    .picks-section { margin-bottom: 0.5rem; }
    .picks-section-sub { margin-top: 1.5rem; }

    .picks-section-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 0.9rem;
    }

    .picks-section-icon { font-size: 1.4rem; line-height: 1; }

    .picks-section-header h3 {
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0;
        color: var(--bs-emphasis-color, #212529);
        letter-spacing: -0.01em;
    }

    .picks-section-desc {
        font-size: 0.9rem;
        color: var(--bs-secondary-color, #6c757d);
        margin-bottom: 1.1rem;
        line-height: 1.6;
    }

    .picks-card {
        border-radius: 0.5rem;
        padding: 1rem 1.2rem;
        font-size: 0.92rem;
        line-height: 1.65;
    }

    .picks-card-info {
        background: color-mix(in srgb, var(--bs-primary, #0d6efd) 7%, var(--bs-body-bg, #fff));
        border: 1px solid color-mix(in srgb, var(--bs-primary, #0d6efd) 22%, transparent);
        border-left: 4px solid var(--bs-primary, #0d6efd);
        color: var(--bs-body-color, #212529);
    }
    .picks-card-info p { margin: 0; }

    .picks-table-wrap {
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.6rem;
        overflow-x: auto;
    }

    .picks-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.88rem;
    }

    .picks-table thead tr { background: var(--bs-secondary-bg, #f8f9fa); }

    .picks-table th {
        padding: 0.6rem 0.9rem;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--bs-secondary-color, #6c757d);
        text-align: left;
        border-bottom: 1px solid var(--bs-border-color, #dee2e6);
    }

    .picks-th-range { text-align: right; }

    .picks-table td {
        padding: 0.65rem 0.9rem;
        vertical-align: middle;
        border-bottom: 1px solid var(--bs-border-color, #dee2e6);
    }

    .picks-table tbody tr:last-child td { border-bottom: none; }

    .picks-row-red    { background: color-mix(in srgb, var(--bs-danger, #dc3545) 5%, var(--bs-body-bg, #fff)); }
    .picks-row-orange { background: color-mix(in srgb, #e07b00 5%, var(--bs-body-bg, #fff)); }
    .picks-row-blue   { background: color-mix(in srgb, var(--bs-primary, #0d6efd) 4%, var(--bs-body-bg, #fff)); }
    .picks-row-green  { background: color-mix(in srgb, #198754 4%, var(--bs-body-bg, #fff)); }
    .picks-row-silver { background: color-mix(in srgb, #6c757d 4%, var(--bs-body-bg, #fff)); }
    .picks-row-gold   { background: color-mix(in srgb, #a07800 6%, var(--bs-body-bg, #fff)); }

    .picks-stage-cell { display: flex; align-items: center; gap: 0.5rem; }
    .picks-stage-icon { font-size: 1.1rem; flex-shrink: 0; }
    .picks-stage-name { font-weight: 600; color: var(--bs-emphasis-color, #212529); }

    .picks-td-count { text-align: center; }

    .picks-count-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.8rem;
        height: 1.6rem;
        border-radius: 0.3rem;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 0 0.35rem;
    }

    .picks-cnt-red    { background: rgba(220,53,69,0.14);   color: var(--bs-danger, #dc3545); }
    .picks-cnt-orange { background: rgba(224,123,0,0.16);   color: #c06800; }
    .picks-cnt-blue   { background: rgba(13,110,253,0.12);  color: var(--bs-primary, #0d6efd); }
    .picks-cnt-green  { background: rgba(25,135,84,0.12);   color: #198754; }
    .picks-cnt-silver { background: rgba(108,117,125,0.14); color: #6c757d; }
    .picks-cnt-gold   { background: rgba(160,120,0,0.18);   color: #8a6400; }

    .picks-chips { display: flex; flex-wrap: wrap; gap: 0.3rem; }

    .picks-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 1.7rem;
        border-radius: 0.35rem;
        font-size: 0.78rem;
