@page "/picks"
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService

<PageTitle>Picks do Draft — CBFV Retro 2008/09</PageTitle>

<PageHeader Title="Picks do Draft" />

@code {
    protected override void OnInitialized()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/picks"));
    }
}

<div class="picks-page">

    <section class="picks-section">
        <div class="picks-card picks-card-info">
            <p>Os times que terminarem em posições mais baixas têm acesso a escolhas mais cedo no draft. Times eliminados nas fases iniciais do mata-mata também ganham picks antecipadas, premiando reconstruções para o futuro.</p>
        </div>
    </section>

    <hr class="picks-divider" />

    <section class="picks-section">
        <div class="picks-section-header">
            <span class="picks-section-icon">🎯</span>
            <h3>Picks por Resultado</h3>
        </div>

        <div class="picks-table-wrap">
            <table class="picks-table">
                <thead>
                    <tr>
                        <th>Resultado</th>
                        <th>Times</th>
                        <th>Picks Disponíveis</th>
                        <th class="picks-th-range">Faixa</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in PicksData)
                    {
                        <tr class="picks-row @row.RowClass">
                            <td>
                                <div class="picks-stage-cell">
                                    <span class="picks-stage-icon">@row.Icon</span>
                                    <span class="picks-stage-name">@row.Stage</span>
                                </div>
                            </td>
                            <td class="picks-td-count">
                                <span class="picks-count-badge @row.CountBadgeClass">@row.TeamCount</span>
                            </td>
                            <td>
                                <div class="picks-chips">
                                    @foreach (var pick in row.Picks)
                                    {
                                        <span class="picks-chip @GetPickClass(pick)">@pick</span>
                                    }
                                </div>
                            </td>
                            <td class="picks-td-range">
                                <span class="picks-range-badge @row.RangeBadgeClass">@row.RangeLabel</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <hr class="picks-divider" />

    <section class="picks-section">
        <div class="picks-section-header">
            <span class="picks-section-icon">🎰</span>
            <h3>Loteria — Pick #1</h3>
        </div>
        <p class="picks-section-desc">A pick #1 não é garantida. Os 4 times elegíveis participam de uma loteria com as probabilidades abaixo.</p>

        <div class="picks-lottery-grid">
            @foreach (var entry in LotteryOdds)
            {
                <div class="picks-lottery-card @entry.CardClass">
                    <div class="picks-lottery-team">
                        <span class="picks-lottery-icon">@entry.Icon</span>
                        <div>
                            <div class="picks-lottery-stage">@entry.Stage</div>
                            <div class="picks-lottery-detail">@entry.Detail</div>
                        </div>
                    </div>
                    <div class="picks-lottery-odds-wrap">
                        <div class="picks-lottery-pct">@entry.Pct%</div>
                        <div class="picks-lottery-bar-bg">
                            <div class="picks-lottery-bar @entry.BarClass" style="width: @entry.Pct%"></div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="picks-lottery-note">
            <span class="picks-lottery-note-icon">ℹ️</span>
            <span>O 11° e o 12° colocado têm juntos <strong>70%</strong> de chance de conquistar a pick #1. Os dois times eliminados no Play-In dividem os <strong>30%</strong> restantes.</span>
        </div>
    </section>

    <hr class="picks-divider" />

    <section class="picks-section">
        <div class="picks-section-header">
            <span class="picks-section-icon">🗺️</span>
            <h3>Mapa de Picks</h3>
        </div>
        <p class="picks-section-desc">Visualização de quais posições do draft estão disponíveis para cada grupo de times.</p>

        <div class="picks-map">
            @for (int pick = 1; pick <= 12; pick++)
            {
                var p = pick;
                <div class="picks-map-col">
                    <div class="picks-map-num @GetPickMapClass(p)">#@p</div>
                    <div class="picks-map-label">@GetPickMapLabel(p)</div>
                </div>
            }
        </div>
    </section>

</div>

@code {
    private sealed record PickRow(
        string Icon,
        string Stage,
        string TeamCount,
        int[] Picks,
        string RangeLabel,
        string RowClass,
        string CountBadgeClass,
        string RangeBadgeClass);

    private sealed record LotteryEntry(
        string Icon,
        string Stage,
        string Detail,
        int Pct,
        string CardClass,
        string BarClass);

    private static readonly IReadOnlyList<PickRow> PicksData = new List<PickRow>
    {
        new("❌", "11° Colocado",             "1",   new[] {1, 2, 3, 4}, "1–4",  "picks-row-red",    "picks-cnt-red",    "picks-rng-lottery"),
        new("❌", "12° Colocado",             "1",   new[] {1, 2, 3, 4}, "1–4",  "picks-row-red",    "picks-cnt-red",    "picks-rng-lottery"),
        new("🎯", "Eliminado no Play-In",     "2",   new[] {1, 2, 3, 4}, "1–4",  "picks-row-orange", "picks-cnt-orange", "picks-rng-lottery"),
        new("⚔️", "Eliminado nas Quartas",    "4",   new[] {5, 6, 7, 8}, "5–8",  "picks-row-blue",   "picks-cnt-blue",   "picks-rng-mid"),
        new("🎖️", "Eliminado nas Semis",      "2",   new[] {9, 10},      "9–10", "picks-row-green",  "picks-cnt-green",  "picks-rng-late"),
        new("🥈", "Vice-Campeão",             "1",   new[] {11},          "11",   "picks-row-silver", "picks-cnt-silver", "picks-rng-late"),
        new("🏆", "Campeão",                  "1",   new[] {12},          "12",   "picks-row-gold",   "picks-cnt-gold",   "picks-rng-last"),
    };

    private static readonly IReadOnlyList<LotteryEntry> LotteryOdds = new List<LotteryEntry>
    {
        new("❌", "11° Colocado",         "Eliminado na Liga",  35, "picks-lot-red",    "picks-lot-bar-red"),
        new("❌", "12° Colocado",         "Eliminado na Liga",  35, "picks-lot-red",    "picks-lot-bar-red"),
        new("🎯", "Eliminado Play-In #1", "1° a ser eliminado", 15, "picks-lot-orange", "picks-lot-bar-orange"),
        new("🎯", "Eliminado Play-In #2", "2° a ser eliminado", 15, "picks-lot-orange", "picks-lot-bar-orange"),
    };

    private static string GetPickClass(int pick) => pick switch
    {
        <= 4  => "picks-chip-lottery",
        <= 8  => "picks-chip-mid",
        <= 10 => "picks-chip-late",
        _     => "picks-chip-last"
    };

    private static string GetPickMapClass(int pick) => pick switch
    {
        <= 4  => "picks-map-lottery",
        <= 8  => "picks-map-mid",
        <= 10 => "picks-map-late",
        11    => "picks-map-silver",
        _     => "picks-map-gold"
    };

    private static string GetPickMapLabel(int pick) => pick switch
    {
        1  => "Loteria",
        2  => "Loteria",
        3  => "Loteria",
        4  => "Loteria",
        5  => "Quartas",
        6  => "Quartas",
        7  => "Quartas",
        8  => "Quartas",
        9  => "Semis",
        10 => "Semis",
        11 => "Vice",
        _  => "Campeão"
    };
}

<style>
    .picks-page {
        max-width: 900px;
        margin: 0 auto;
        padding-bottom: 3rem;
    }

    .picks-divider {
        border-color: var(--bs-border-color, #dee2e6);
        margin: 2rem 0;
        opacity: 0.4;
    }

    .picks-section {
        margin-bottom: 0.5rem;
    }

    .picks-section-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 0.9rem;
    }

    .picks-section-icon { font-size: 1.4rem; line-height: 1; }

    .picks-section-header h3 {
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0;
        color: var(--bs-emphasis-color, #212529);
        letter-spacing: -0.01em;
    }

    .picks-section-desc {
        font-size: 0.9rem;
        color: var(--bs-secondary-color, #6c757d);
        margin-bottom: 1.1rem;
        line-height: 1.6;
    }

    .picks-card {
        border-radius: 0.5rem;
        padding: 1rem 1.2rem;
        font-size: 0.92rem;
        line-height: 1.65;
    }

    .picks-card-info {
        background: color-mix(in srgb, var(--bs-primary, #0d6efd) 7%, var(--bs-body-bg, #fff));
        border: 1px solid color-mix(in srgb, var(--bs-primary, #0d6efd) 22%, transparent);
        border-left: 4px solid var(--bs-primary, #0d6efd);
        color: var(--bs-body-color, #212529);
    }

    .picks-card-info p { margin: 0; }

    .picks-table-wrap {
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.6rem;
        overflow: hidden;
    }

    .picks-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.88rem;
    }

    .picks-table thead tr {
        background: var(--bs-secondary-bg, #f8f9fa);
    }

    .picks-table th {
        padding: 0.6rem 0.9rem;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--bs-secondary-color, #6c757d);
        text-align: left;
        border-bottom: 1px solid var(--bs-border-color, #dee2e6);
    }

    .picks-th-range { text-align: right; }

    .picks-table td {
        padding: 0.65rem 0.9rem;
        vertical-align: middle;
        border-bottom: 1px solid var(--bs-border-color, #dee2e6);
    }

    .picks-table tbody tr:last-child td { border-bottom: none; }

    .picks-row-red    { background: color-mix(in srgb, var(--bs-danger, #dc3545) 5%, var(--bs-body-bg, #fff)); }
    .picks-row-orange { background: color-mix(in srgb, #e07b00 5%, var(--bs-body-bg, #fff)); }
    .picks-row-blue   { background: color-mix(in srgb, var(--bs-primary, #0d6efd) 4%, var(--bs-body-bg, #fff)); }
    .picks-row-green  { background: color-mix(in srgb, #198754 4%, var(--bs-body-bg, #fff)); }
    .picks-row-silver { background: color-mix(in srgb, #6c757d 4%, var(--bs-body-bg, #fff)); }
    .picks-row-gold   { background: color-mix(in srgb, #a07800 6%, var(--bs-body-bg, #fff)); }

    .picks-stage-cell {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .picks-stage-icon { font-size: 1.1rem; flex-shrink: 0; }

    .picks-stage-name {
        font-weight: 600;
        color: var(--bs-emphasis-color, #212529);
    }

    .picks-td-count { text-align: center; }

    .picks-count-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.8rem;
        height: 1.6rem;
        border-radius: 0.3rem;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 0 0.35rem;
    }

    .picks-cnt-red    { background: rgba(220,53,69,0.14);  color: var(--bs-danger, #dc3545); }
    .picks-cnt-orange { background: rgba(224,123,0,0.16);  color: #c06800; }
    .picks-cnt-blue   { background: rgba(13,110,253,0.12); color: var(--bs-primary, #0d6efd); }
    .picks-cnt-green  { background: rgba(25,135,84,0.12);  color: #198754; }
    .picks-cnt-silver { background: rgba(108,117,125,0.14); color: #6c757d; }
    .picks-cnt-gold   { background: rgba(160,120,0,0.18);  color: #8a6400; }

    .picks-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
    }

    .picks-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 1.7rem;
        border-radius: 0.35rem;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .picks-chip-lottery { background: linear-gradient(135deg, #a01020, #dc3545); color: #fff; }
    .picks-chip-mid     { background: linear-gradient(135deg, #1a5fb4, #3584e4); color: #fff; }
    .picks-chip-late    { background: linear-gradient(135deg, #1c5829, #2ec27e); color: #fff; }
    .picks-chip-last    { background: linear-gradient(135deg, #a07800, #e5a000); color: #fff; }

    .picks-td-range { text-align: right; }

    .picks-range-badge {
        display: inline-block;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .picks-rng-lottery { background: rgba(220,53,69,0.14);  color: var(--bs-danger, #dc3545); }
    .picks-rng-mid     { background: rgba(13,110,253,0.12); color: var(--bs-primary, #0d6efd); }
    .picks-rng-late    { background: rgba(25,135,84,0.12);  color: #198754; }
    .picks-rng-last    { background: rgba(160,120,0,0.18);  color: #8a6400; }

    .picks-lottery-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.85rem;
        margin-bottom: 1rem;
    }

    @@media (max-width: 600px) {
        .picks-lottery-grid { grid-template-columns: 1fr; }
    }

    .picks-lottery-card {
        border-radius: 0.6rem;
        padding: 1rem 1.1rem;
        border: 1px solid var(--bs-border-color, #dee2e6);
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }

    .picks-lot-red    { border-left: 4px solid var(--bs-danger, #dc3545);  background: color-mix(in srgb, var(--bs-danger, #dc3545) 6%, var(--bs-body-bg, #fff)); }
    .picks-lot-orange { border-left: 4px solid #e07b00; background: color-mix(in srgb, #e07b00 6%, var(--bs-body-bg, #fff)); }

    .picks-lottery-team {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
    }

    .picks-lottery-icon { font-size: 1.3rem; flex-shrink: 0; margin-top: 0.05rem; }

    .picks-lottery-stage {
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--bs-emphasis-color, #212529);
    }

    .picks-lottery-detail {
        font-size: 0.75rem;
        color: var(--bs-secondary-color, #6c757d);
        margin-top: 0.1rem;
    }

    .picks-lottery-odds-wrap {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .picks-lottery-pct {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--bs-emphasis-color, #212529);
        line-height: 1;
    }

    .picks-lottery-bar-bg {
        height: 8px;
        background: var(--bs-border-color, #dee2e6);
        border-radius: 999px;
        overflow: hidden;
    }

    .picks-lottery-bar {
        height: 100%;
        border-radius: 999px;
    }

    .picks-lot-bar-red    { background: linear-gradient(90deg, #a01020, #dc3545); }
    .picks-lot-bar-orange { background: linear-gradient(90deg, #c06800, #e8a400); }

    .picks-lottery-note {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        background: var(--bs-secondary-bg, #f8f9fa);
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        font-size: 0.85rem;
        color: var(--bs-body-color, #212529);
        line-height: 1.5;
    }

    .picks-lottery-note-icon { font-size: 1rem; flex-shrink: 0; margin-top: 0.05rem; }

    .picks-map {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
    }

    .picks-map-col {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.3rem;
        flex: 1;
        min-width: 56px;
    }

    .picks-map-num {
        width: 100%;
        text-align: center;
        padding: 0.6rem 0.3rem;
        border-radius: 0.45rem;
        font-size: 0.85rem;
        font-weight: 800;
        color: #fff;
    }

    .picks-map-lottery { background: linear-gradient(135deg, #a01020, #dc3545); }
    .picks-map-mid     { background: linear-gradient(135deg, #1a5fb4, #3584e4); }
    .picks-map-late    { background: linear-gradient(135deg, #1c5829, #2ec27e); }
    .picks-map-silver  { background: linear-gradient(135deg, #5a6370, #8d959e); }
    .picks-map-gold    { background: linear-gradient(135deg, #a07800, #e5a000); }

    .picks-map-label {
        font-size: 0.65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--bs-secondary-color, #6c757d);
        text-align: center;
        line-height: 1.2;
    }
</style>
