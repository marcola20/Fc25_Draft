@page "/album"
@using Fc25Draft.Core.Utilities
@using Fc25Draft.Web.Components.Album
@using Fc25Draft.Web.Components.Layouts
@inject IAlbumService AlbumSvc
@inject ITreinadorService TreinadorSvc
@inject AdminAuthService AdminAuth
@inject EscudoService Escudos
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Álbum de Figurinhas</PageTitle>

<div class="container-fluid py-3 album-pagina" style="max-width: 1200px;">
    @if (_erro is not null)
    {
        <div class="alert alert-danger alert-dismissible">@_erro<button type="button" class="btn-close" @onclick="() => _erro = null"></button></div>
    }
    @if (_ok is not null)
    {
        <div class="alert alert-success alert-dismissible">@_ok<button type="button" class="btn-close" @onclick="() => _ok = null"></button></div>
    }

    @if (_carregando)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    }
    else if (_eu is null)
    {
        <div class="alert alert-info">
            Entre com o seu token (botão <strong>Entrar</strong> no topo) para ver o seu álbum. O álbum é por pessoa —
            treinador e auxiliar colecionam separado, e quem troca de clube leva o álbum.
        </div>
    }
    else if (_album is null)
    {
        <div class="alert alert-secondary">O álbum desta temporada ainda não foi lançado. Quando sair, ele aparece aqui.</div>
    }
    else if (_mostrarCapa)
    {
        var a = _album;
        @* ---- A capa do álbum fechado: abre uma vez por sessão ---- *@
        <div class="capa-livro @(_abrindoCapa ? "abrindo" : "")">
            <div class="capa-frente" @onclick="AbrirCapaAsync">
                <div class="capa-brilho" aria-hidden="true"></div>
                <span class="capa-faixa">Álbum oficial de figurinhas</span>
                <img src="images/album/cbfv-escudo.webp" class="capa-logo" width="287" height="360" alt="CBFV" />
                <h1 class="capa-nome">@a.Album.Nome</h1>
                <span class="capa-temporada">Temporada @a.Album.Temporada</span>
                <div class="capa-quadro">
                    <img src="images/album/mascote.webp" width="720" height="1080" alt="A mascote da CBFV" />
                </div>
                <div class="capa-rodape">
                    <span class="capa-progresso"><strong>@a.Coladas</strong> de @a.Total figurinhas · @a.Percentual%</span>
                    @if (a.PacotesParaAbrir > 0)
                    {
                        <span class="capa-pacotes"><Icone Nome="package" Tamanho="14" /> @a.PacotesParaAbrir pacote@(a.PacotesParaAbrir == 1 ? "" : "s") esperando</span>
                    }
                    <button type="button" class="btn btn-warning capa-abrir" @onclick="AbrirCapaAsync" @onclick:stopPropagation="true">
                        <Icone Nome="book-open" Tamanho="16" /> Abrir o álbum
                    </button>
                </div>
            </div>
            <div class="capa-miolo" aria-hidden="true"></div>
        </div>
    }
    else
    {
        var a = _album;

        <div class="@(_capaVerificada ? "" : "aguardando-capa") @(_recemAberto ? "recem-aberto" : "")">
        @* ---- Topo: progresso e pacotes ---- *@
        <div class="card capa mb-3">
            <div class="card-body d-flex flex-wrap gap-4 align-items-center">
                <div class="flex-grow-1" style="min-width: 240px;">
                    <div class="text-body-tertiary small">Temporada @a.Album.Temporada</div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <h1 class="h3 mb-0">@a.Album.Nome</h1>
                        <div class="d-flex flex-wrap gap-2 ms-auto">
                            <button type="button" class="btn btn-sm btn-outline-secondary" title="Fechar o álbum e ver a capa" @onclick="VerCapa"><Icone Nome="book-open" Tamanho="14" /> Capa</button>
                            <a href="/album/trocas" class="btn btn-sm btn-outline-secondary position-relative">
                                <Icone Nome="arrow-left-right" Tamanho="14" /> Trocas
                                @if (a.TrocasEsperando > 0)
                                {
                                    <span class="sino-contador numero" title="Propostas esperando a sua resposta">@a.TrocasEsperando</span>
                                }
                            </a>
                            <a href="/album/colecionadores" class="btn btn-sm btn-outline-secondary"><Icone Nome="award" Tamanho="14" /> Colecionadores</a>
                        </div>
                    </div>
                    @if (a.AlbumCompleto is { } completo)
                    {
                        <div class="album-completo mb-2"><Icone Nome="trophy" Tamanho="14" /> Álbum completo em @BrazilTime.FormatDateTime(completo.Em, "dd/MM/yyyy") — seu nome está no <a href="/hall-of-fame#colecionadores">Hall da Fama</a>.</div>
                    }
                    <div class="d-flex justify-content-between small mb-1">
                        <span><strong>@a.Coladas</strong> de @a.Total figurinhas</span>
                        <span class="fw-semibold">@a.Percentual%</span>
                    </div>
                    <div class="progress" role="progressbar" aria-valuenow="@a.Percentual" aria-valuemin="0" aria-valuemax="100" style="height: .7rem;">
                        <div class="progress-bar" style="width: @(a.Percentual)%; background: var(--cbfv-acento);"></div>
                    </div>
                    <div class="d-flex flex-wrap gap-3 mt-2 small">
                        <span class="raridade-chip comum">Comuns <strong>@a.ColadasPorRaridade.Comuns</strong>/@a.TotalPorRaridade.Comuns</span>
                        <span class="raridade-chip brilhante">Brilhantes <strong>@a.ColadasPorRaridade.Brilhantes</strong>/@a.TotalPorRaridade.Brilhantes</span>
                        @if (a.TotalPorRaridade.Lendarias > 0)
                        {
                            <span class="raridade-chip lendaria">★ Lendárias <strong>@a.ColadasPorRaridade.Lendarias</strong>/@a.TotalPorRaridade.Lendarias</span>
                        }
                        <span class="text-muted">@a.Repetidas repetida@(a.Repetidas == 1 ? "" : "s")</span>
                    </div>
                </div>
                <div class="text-center pacotes">
                    <div class="pacote-icone" aria-hidden="true"><Icone Nome="package" Tamanho="28" /></div>
                    <div class="fw-bold fs-4 lh-1">@a.PacotesParaAbrir</div>
                    <div class="small text-muted mb-2">pacote@(a.PacotesParaAbrir == 1 ? "" : "s") para abrir</div>
                    <button class="btn btn-primary" disabled="@(a.PacotesParaAbrir == 0 || _abrindo)" @onclick="AbrirAsync">
                        @(_abrindo ? "Abrindo…" : "Abrir pacote")
                    </button>
                    @if (a.PacoteDoDiaDisponivel)
                    {
                        <button class="btn btn-outline-secondary d-block w-100 mt-2" disabled="@_pegandoDoDia" @onclick="PegarDoDiaAsync">
                            Pegar os @AlbumFigurinhas.PacotesDoDia pacotes do dia
                        </button>
                    }
                    else if (a.Album.Ativo)
                    {
                        <div class="small text-muted mt-2">Pacotes do dia pegos<br />Amanhã tem mais.</div>
                    }
                </div>
            </div>
            @if (a.Fechados.Count > 0)
            {
                @* De onde veio cada pacote fechado, na ordem em que vão ser abertos. *@
                var grupos = a.Fechados
                    .GroupBy(f => (f.DeOndeVeio, f.Estrelas))
                    .Select(g => (Texto: g.Key.DeOndeVeio, Origem: g.First().Origem, Estrelas: g.Key.Estrelas, Quantos: g.Count()))
                    .ToList();
                <div class="card-footer bg-transparent small">
                    <span class="text-muted me-1">Fechados:</span>
                    @foreach (var g in grupos.Take(MaximoDeOrigens))
                    {
                        <span class="pacote-origem @g.Origem"><Icone Nome="@(g.Estrelas ? "star" : IconeDaOrigem(g.Origem))" Tamanho="12" /> @g.Texto@(g.Quantos > 1 ? $" ×{g.Quantos}" : "")</span>
                    }
                    @if (grupos.Count > MaximoDeOrigens)
                    {
                        <span class="text-muted">e mais @(grupos.Skip(MaximoDeOrigens).Sum(g => g.Quantos))</span>
                    }
                </div>
            }
        </div>

        @* ---- Pacote aberto: a abertura em tela cheia ---- *@
        @if (_aberto is { } p)
        {
            <AberturaDePacote Pacote="@p" AlbumNome="@a.Album.Nome" SeloLendaria="@Selo" Abrindo="@_abrindo" EuId="@_eu.TreinadorId"
                              OnFechar="() => _aberto = null" OnProximo="AbrirAsync"
                              OnCompartilhar="f => _compartilhar = f" />
        }
        <CompartilharCarta Figurinha="@_compartilhar" AlbumNome="@a.Album.Nome" SeloLendaria="@Selo" Quem="@_eu.Nome"
                           OnFechar="() => _compartilhar = null" />

        @* ---- Últimas raras tiradas (de todo mundo) ---- *@
        @if (_raras.Count > 0 && _pagina is null && !_apresentacao && string.IsNullOrWhiteSpace(_busca))
        {
            <div class="card mb-3">
                <div class="card-header d-flex align-items-baseline gap-2">
                    <strong>Últimas raras tiradas</strong>
                    <span class="small text-muted">brilhantes, lendárias e especiais que saíram nos pacotes</span>
                </div>
                <div class="card-body py-2">
                    <div class="faixa-raras">
                        @foreach (var r in _raras)
                        {
                            <div class="rara @(r.TreinadorId == _eu.TreinadorId ? "minha" : "")">
                                @if (r.Figurinha.Deitada)
                                {
                                    @* Deitada (campeão): girada, ocupa o mesmo lugar de uma carta em pé. *@
                                    <div class="rara-girada"><div class="rara-giro"><CartaFigurinha Figurinha="@r.Figurinha" Largura="92" SeloLendaria="@Selo" /></div></div>
                                }
                                else
                                {
                                    <CartaFigurinha Figurinha="@r.Figurinha" Largura="92" SeloLendaria="@Selo" />
                                }
                                <div class="rara-quem text-truncate" title="@r.Nome">@(r.TreinadorId == _eu.TreinadorId ? "Você" : r.Nome)</div>
                                <div class="rara-quando">@AvisosSino.Quando(r.Quando)</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @* ---- Filtros ---- *@
        <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
            <input type="search" class="form-control" style="max-width: 280px;" placeholder="Buscar jogador, clube ou número"
                   value="@_busca" @oninput="e => _busca = e.Value?.ToString() ?? string.Empty" />
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="soFaltam" checked="@_soFaltam" @onchange="e => _soFaltam = e.Value is true" />
                <label class="form-check-label" for="soFaltam">Só as que faltam</label>
            </div>
            @if ((_pagina is not null || _apresentacao) && string.IsNullOrWhiteSpace(_busca))
            {
                <a href="@Endereco(null)" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => IrParaAsync(null, -1)" @onclick:preventDefault="true">
                    <Icone Nome="list" Tamanho="14" /> Sumário
                </a>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_busca))
        {
            var achadas = Filtrar(a.Paginas.SelectMany(pg => pg.Vagas)).Where(Bate).ToList();
            <h2 class="h6 text-muted mb-2">@achadas.Count figurinha@(achadas.Count == 1 ? "" : "s") para “@_busca”</h2>
            <div class="grade-cartas">
                @foreach (var v in achadas.Take(60))
                {
                    <CartaFigurinha @key="v.Figurinha.FigurinhaId" Figurinha="@v.Figurinha" Vazia="@(!v.Colada)" Quantidade="@v.Quantidade" Nova="@v.Nova" SeloLendaria="@Selo" />
                }
            </div>
        }
        else
        {
            <div class="livro-folhas">
                @if (_pagina is { } pg)
                {
                    @* ---- Uma folha do álbum: clube ou página especial ---- *@
                    var indice = IndiceDa(pg);
                    var anterior = indice > 0 ? Folhas(a)[indice - 1] : null;
                    var proxima = indice < Folhas(a).Count - 1 ? Folhas(a)[indice + 1] : null;
                    var info = pg.Especial is { } especial ? AlbumFigurinhas.Especial(especial) : null;
                    var vagas = Filtrar(pg.Vagas).ToList();
                    var novaN = 0;

                    <article class="folha @(info is null ? "de-clube" : $"especial p-{info.Endereco}")" @key="@pg.Chave.NoEndereco">
                        <header class="folha-cabeca">
                            @if (info is not null)
                            {
                                <span class="folha-icone"><Icone Nome="@info.Icone" Tamanho="30" /></span>
                            }
                            else
                            {
                                <img class="folha-escudo" src="@Escudos.GetEscudo(pg.Titulo)" alt="" width="52" height="52" />
                            }
                            <div class="flex-grow-1 min-w-0">
                                <div class="folha-sobre">@(info?.Subtitulo ?? "Clube")</div>
                                <h2 class="folha-titulo">@pg.Titulo</h2>
                                <div class="folha-conta">
                                    @pg.Coladas de @pg.Total · @pg.Percentual%
                                    @if (a.SeloDaPagina(pg.Chave) is { } seloDaPagina)
                                    {
                                        <span class="badge selo-badge ms-1" title="Completa em @BrazilTime.FormatDateTime(seloDaPagina.Em, "dd/MM/yyyy")"><Icone Nome="award" Tamanho="12" /> Página completa</span>
                                    }
                                    else if (pg.Completa)
                                    {
                                        <span class="etiqueta sucesso ms-1"><Icone Nome="check" Tamanho="12" /> Página completa</span>
                                    }
                                </div>
                            </div>
                        </header>

                        <div class="folha-miolo">
                            @if (vagas.Count == 0)
                            {
                                <div class="text-muted">Não falta nenhuma.</div>
                            }
                            <div class="grade-cartas">
                                @foreach (var v in vagas)
                                {
                                    @if (v.Colada)
                                    {
                                        var colada = v.Figurinha;
                                        var colar = _colar.Contains(colada.FigurinhaId);
                                        <button type="button" class="carta-botao" @key="v.Figurinha.FigurinhaId" title="Compartilhar" @onclick="() => _compartilhar = colada">
                                            <CartaFigurinha Figurinha="@v.Figurinha" Quantidade="@v.Quantidade" Nova="@v.Nova" SeloLendaria="@Selo"
                                                            Colar="@colar" AtrasoColar="@(colar ? 350 + 120 * novaN++ : 0)" />
                                        </button>
                                    }
                                    else
                                    {
                                        <CartaFigurinha @key="v.Figurinha.FigurinhaId" Figurinha="@v.Figurinha" Vazia="true" />
                                    }
                                }
                            </div>
                            @if (pg.Coladas > 0)
                            {
                                <div class="small text-muted mt-3">Toque numa figurinha colada para compartilhar.</div>
                            }
                        </div>

                        <footer class="folha-pe">
                            <button type="button" class="folha-seta" title="@(anterior?.Titulo ?? "Sumário")" @onclick="() => IrParaAsync(anterior, -1)">
                                <Icone Nome="chevron-left" Tamanho="18" /> <span class="folha-seta-nome">@(anterior?.Titulo ?? "Sumário")</span>
                            </button>
                            <span class="folha-numero">pág. @(indice + 1) de @Folhas(a).Count</span>
                            <button type="button" class="folha-seta" title="@(proxima?.Titulo ?? "")" disabled="@(proxima is null)" @onclick="() => IrParaAsync(proxima, 1)">
                                <span class="folha-seta-nome">@(proxima?.Titulo ?? "Fim do álbum")</span> <Icone Nome="chevron-right" Tamanho="18" />
                            </button>
                        </footer>
                    </article>
                }
                else if (_apresentacao)
                {
                    @* ---- Apresentação: a CBFV e a Áurea, entre a capa e o sumário ---- *@
                    var titulosLiga = a.Paginas.FirstOrDefault(x => x.Especial == PaginaEspecial.CampeoesLiga);
                    var titulosCopa = a.Paginas.FirstOrDefault(x => x.Especial == PaginaEspecial.CampeoesCopa);
                    var clubesCampeoes = new[] { titulosLiga, titulosCopa }.OfType<PaginaDoAlbumDto>()
                        .SelectMany(x => x.Vagas).Select(v => v.Figurinha.NomeImpresso.Trim().ToLowerInvariant()).Distinct().Count();

                    // As figurinhas da folha (página especial Apresentação): a Áurea no lugar da ilustração, o escudo
                    // ao lado do texto da CBFV e, se o admin puser mais alguma, no pé da folha.
                    var daApresentacao = PaginaDaApresentacao(a);
                    var vagasDaFolha = daApresentacao?.Vagas ?? new List<VagaDoAlbumDto>();
                    var vagaAurea = vagasDaFolha.FirstOrDefault(EhAurea);
                    var vagaCbfv = vagasDaFolha.FirstOrDefault(v => v != vagaAurea);
                    var outrasVagas = vagasDaFolha.Where(v => v != vagaAurea && v != vagaCbfv).ToList();
                    var novaApresentacao = 0;

                    RenderFragment Vaga(VagaDoAlbumDto v) => __builder =>
                    {
                        var f = v.Figurinha;
                        if (v.Colada)
                        {
                            var colar = _colar.Contains(f.FigurinhaId);
                            <button type="button" class="carta-botao" @key="f.FigurinhaId" title="Compartilhar" @onclick="() => _compartilhar = f">
                                <CartaFigurinha Figurinha="@f" Largura="170" Quantidade="@v.Quantidade" Nova="@v.Nova" SeloLendaria="@Selo" Lazy="false"
                                                Colar="@colar" AtrasoColar="@(colar ? 350 + 120 * novaApresentacao++ : 0)" />
                            </button>
                        }
                        else
                        {
                            <CartaFigurinha @key="f.FigurinhaId" Figurinha="@f" Largura="170" Vazia="true" />
                        }
                    };

                    <article class="folha apresentacao" @key="@("apresentacao")">
                        <header class="folha-cabeca">
                            <span class="folha-icone"><Icone Nome="book-open" Tamanho="30" /></span>
                            <div class="flex-grow-1 min-w-0">
                                <div class="folha-sobre">@a.Album.Nome</div>
                                <h2 class="folha-titulo">Apresentação</h2>
                                <div class="folha-conta">
                                    @if (daApresentacao is not null)
                                    {
                                        <span>@daApresentacao.Coladas de @daApresentacao.Total figurinha@(daApresentacao.Total == 1 ? "" : "s") · </span>
                                    }
                                    A CBFV e a Áurea, a nossa Harpia
                                    @if (daApresentacao is not null && a.SeloDaPagina(daApresentacao.Chave) is { } seloDaApresentacao)
                                    {
                                        <span class="badge selo-badge ms-1" title="Completa em @BrazilTime.FormatDateTime(seloDaApresentacao.Em, "dd/MM/yyyy")"><Icone Nome="award" Tamanho="12" /> Página completa</span>
                                    }
                                </div>
                            </div>
                        </header>

                        <div class="folha-miolo">
                            <div class="apresentacao-grade">
                                <section>
                                    <h3 class="apresentacao-titulo">A CBFV</h3>
                                    <div class="apresentacao-cbfv @(vagaCbfv is null ? "" : "com-vaga")">
                                        @if (vagaCbfv is not null)
                                        {
                                            <div class="apresentacao-vaga">@Vaga(vagaCbfv)</div>
                                        }
                                        <p class="apresentacao-abre">
                                            A Confederação Brasileira de Futebol Virtual nasceu em 2019 e chega à oitava edição com sete anos de
                                            história: muitos jogos, leilões, rivalidades, títulos e treinadores que fazem dela mais do que um campeonato.
                                        </p>
                                    </div>

                                    <ul class="apresentacao-numeros">
                                        <li><strong>8</strong><span>edições</span></li>
                                        <li><strong>7</strong><span>anos</span></li>
                                        @if (titulosLiga is not null)
                                        {
                                            <li><strong>@titulosLiga.Total</strong><span>título@(titulosLiga.Total == 1 ? "" : "s") de liga</span></li>
                                        }
                                        @if (titulosCopa is not null)
                                        {
                                            <li><strong>@titulosCopa.Total</strong><span>copa@(titulosCopa.Total == 1 ? "" : "s")</span></li>
                                        }
                                        @if (clubesCampeoes > 0)
                                        {
                                            <li><strong>@clubesCampeoes</strong><span>clubes campeões</span></li>
                                        }
                                    </ul>

                                    <ol class="linha-do-tempo">
                                        <li>
                                            <span class="ldt-quando">1ª edição · 2019</span>
                                            <span class="ldt-texto">Tudo começou no FIFA 18, no PS4, com a <strong>Nordic League</strong>: só clubes nórdicos em campo.</span>
                                        </li>
                                        <li>
                                            <span class="ldt-quando">2ª edição</span>
                                            <span class="ldt-texto">A liga veio para o Brasil e ganhou o <strong>leilão</strong> de jogadores, agora no PES 19, ainda no PS4.</span>
                                        </li>
                                        <li>
                                            <span class="ldt-quando">3ª edição</span>
                                            <span class="ldt-texto">De volta ao FIFA, desta vez com os <strong>elencos oficiais</strong> dos clubes escolhidos.</span>
                                        </li>
                                        <li>
                                            <span class="ldt-quando">4ª à 7ª edição</span>
                                            <span class="ldt-texto">A mudança para o <strong>PC</strong>, no FIFA, onde a liga cresceu por quatro edições seguidas.</span>
                                        </li>
                                        <li class="agora">
                                            <span class="ldt-quando">8ª edição · hoje</span>
                                            <span class="ldt-texto">O retorno ao <strong>PES</strong>, com uma nova identidade e este álbum para colecionar.</span>
                                        </li>
                                    </ol>
                                </section>

                                <section class="apresentacao-aurea">
                                    <h3 class="apresentacao-titulo">Áurea, a nossa Harpia</h3>
                                    @if (vagaAurea is not null)
                                    {
                                        <div class="apresentacao-vaga apresentacao-vaga-aurea">@Vaga(vagaAurea)</div>
                                    }
                                    else
                                    {
                                        <img class="apresentacao-ilustracao" src="images/album/mascote.webp" width="720" height="1080" alt="Áurea, a Harpia mascote da CBFV" loading="lazy" />
                                    }
                                    <p>
                                        Uma nova era merecia uma identidade à sua altura. Inspirada numa das aves mais majestosas da fauna
                                        brasileira, a <strong>Áurea</strong> representa a força, a imponência e o espírito competitivo da CBFV.
                                    </p>
                                    <p>
                                        A coroa fala da nobreza e da tradição que estamos construindo, as cores são as nossas, e as
                                        <strong>oito estrelas</strong> lembram a história e a grandeza da CBFV. Mais do que uma mascote, ela é um
                                        símbolo de pertencimento e de orgulho para todos que fazem parte da nossa comunidade.
                                    </p>
                                    <p class="apresentacao-lema">Áurea. A força de uma harpia. A grandeza da CBFV.</p>
                                </section>
                            </div>

                            @if (outrasVagas.Count > 0)
                            {
                                <div class="grade-cartas mt-4">
                                    @foreach (var v in outrasVagas)
                                    {
                                        @Vaga(v)
                                    }
                                </div>
                            }
                            @if (daApresentacao is { Coladas: > 0 })
                            {
                                <div class="small text-muted mt-3">Toque numa figurinha colada para compartilhar.</div>
                            }
                        </div>

                        <footer class="folha-pe">
                            <button type="button" class="folha-seta" title="Capa" @onclick="VerCapa">
                                <Icone Nome="chevron-left" Tamanho="18" /> <span class="folha-seta-nome">Capa</span>
                            </button>
                            <span class="folha-numero">apresentação</span>
                            <button type="button" class="folha-seta" title="Sumário" @onclick="() => IrParaAsync(null, 1)">
                                <span class="folha-seta-nome">Sumário</span> <Icone Nome="chevron-right" Tamanho="18" />
                            </button>
                        </footer>
                    </article>
                }
                else
                {
                    @* ---- Sumário: a primeira folha do álbum ---- *@
                    <article class="folha sumario" @key="@("sumario")">
                        <header class="folha-cabeca">
                            <span class="folha-icone"><Icone Nome="list-ordered" Tamanho="30" /></span>
                            <div class="flex-grow-1 min-w-0">
                                <div class="folha-sobre">@a.Album.Nome</div>
                                <h2 class="folha-titulo">Sumário</h2>
                                <div class="folha-conta">@Folhas(a).Count páginas · deslize para o lado ou use as setas para folhear</div>
                            </div>
                        </header>

                        <div class="folha-miolo">
                            <a class="indice-item card text-reset text-decoration-none apresentacao-link mb-3" href="/album?pagina=@Apresentacao"
                               @onclick="IrParaApresentacaoAsync" @onclick:preventDefault="true">
                                <div class="card-body d-flex align-items-center gap-2 p-2">
                                    <span class="indice-icone"><Icone Nome="book-open" Tamanho="22" /></span>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="fw-semibold">Apresentação</div>
                                        <div class="small text-muted text-truncate">A história da CBFV e a Áurea, a nossa Harpia</div>
                                    </div>
                                    @if (PaginaDaApresentacao(a) is { } paginaApresentacao)
                                    {
                                        <span class="small text-muted text-nowrap">@paginaApresentacao.Coladas/@paginaApresentacao.Total</span>
                                    }
                                    <Icone Nome="chevron-right" Tamanho="16" />
                                </div>
                            </a>
                            @foreach (var secao in Secoes(a))
                            {
                                <h3 class="sumario-secao">@secao.Titulo</h3>
                                <div class="indice">
                                    @foreach (var pagina in secao.Paginas)
                                    {
                                        var selo = a.SeloDaPagina(pagina.Chave);
                                        var infoPagina = pagina.Especial is { } e ? AlbumFigurinhas.Especial(e) : null;
                                        <a class="indice-item card text-reset text-decoration-none @(pagina.Completa ? "completa" : "") @(infoPagina is null ? "" : $"especial p-{infoPagina.Endereco}")"
                                           href="@Endereco(pagina)" @onclick="() => IrParaAsync(pagina, 1)" @onclick:preventDefault="true">
                                            <div class="card-body d-flex align-items-center gap-2 p-2">
                                                @if (infoPagina is not null)
                                                {
                                                    <span class="indice-icone"><Icone Nome="@infoPagina.Icone" Tamanho="22" /></span>
                                                }
                                                else
                                                {
                                                    <img src="@Escudos.GetEscudo(pagina.Titulo)" alt="" width="40" height="40" style="object-fit: contain;" loading="lazy" />
                                                }
                                                <div class="flex-grow-1 min-w-0">
                                                    <div class="fw-semibold text-truncate">@pagina.Titulo</div>
                                                    <div class="progress mt-1" style="height: .35rem;">
                                                        <div class="progress-bar" style="width: @(pagina.Percentual)%; background: @(pagina.Completa ? "var(--cbfv-acento)" : "var(--bs-tertiary-color)");"></div>
                                                    </div>
                                                    <div class="small text-muted mt-1 d-flex justify-content-between"><span>@pagina.Coladas/@pagina.Total</span><span>p. @(IndiceDa(pagina) + 1)</span></div>
                                                </div>
                                                @if (selo is not null)
                                                {
                                                    <span class="selo-pagina" title="Página completa em @BrazilTime.FormatDateTime(selo.Em, "dd/MM/yyyy")"><Icone Nome="award" Tamanho="14" /></span>
                                                }
                                                else if (pagina.Completa)
                                                {
                                                    <span class="selo-completa" title="Página completa"><Icone Nome="check" Tamanho="14" /></span>
                                                }
                                            </div>
                                        </a>
                                    }
                                </div>
                            }
                        </div>

                        <footer class="folha-pe">
                            <button type="button" class="folha-seta" title="Apresentação" @onclick="IrParaApresentacaoAsync">
                                <Icone Nome="chevron-left" Tamanho="18" /> <span class="folha-seta-nome">Apresentação</span>
                            </button>
                            <span class="folha-numero">sumário</span>
                            <button type="button" class="folha-seta" disabled="@(Folhas(a).Count == 0)" @onclick="() => IrParaAsync(Folhas(a).FirstOrDefault(), 1)">
                                <span class="folha-seta-nome">@(Folhas(a).FirstOrDefault()?.Titulo)</span> <Icone Nome="chevron-right" Tamanho="18" />
                            </button>
                        </footer>
                    </article>
                }
            </div>

            @if (_pagina is null && !_apresentacao && a.ForaDoAlbum is { Count: > 0 } fora)
            {
                @* ---- Figurinhas de quem saiu dos clubes da liga ---- *@
                <div class="card mt-4">
                    <div class="card-header d-flex flex-wrap align-items-center gap-2">
                        <span class="fw-semibold">Saíram do álbum</span>
                        <span class="small text-muted">@fora.Sum(v => v.Quantidade) cópia@(fora.Sum(v => v.Quantidade) == 1 ? "" : "s")</span>
                        <a href="/album/trocas?aba=repetidas" class="btn btn-sm btn-outline-secondary ms-auto"><Icone Nome="refresh-cw" Tamanho="14" /> Reciclar</a>
                    </div>
                    <div class="card-body">
                        <p class="small text-muted">
                            Jogadores e técnicos que deixaram os clubes da liga numa atualização do álbum. A figurinha continua sua,
                            mas não tem mais vaga nas páginas: todas as cópias, até a que estava colada, podem ir para a reciclagem.
                        </p>
                        <div class="grade-cartas">
                            @foreach (var v in fora)
                            {
                                <CartaFigurinha @key="v.Figurinha.FigurinhaId" Figurinha="@v.Figurinha" Largura="110" Quantidade="@v.Quantidade" SeloLendaria="@Selo" />
                            }
                        </div>
                    </div>
                </div>
            }
        }
        </div>
    }
</div>

@code {
    // Enquanto a aba desta página está escondida, a query do endereço é a de outra aba (ver AbasService).
    [CascadingParameter] public AbaAberta? AbaAberta { get; set; }

    /// <summary>Endereço antigo da página do clube (avisos e links de antes das páginas especiais).</summary>
    [SupplyParameterFromQuery(Name = "clube")]
    public Guid? Clube { get; set; }

    /// <summary>A página aberta: o id do clube ou o nome da especial (<c>organizacao</c>, <c>lendarios</c>…).</summary>
    [SupplyParameterFromQuery(Name = "pagina")]
    public string? PaginaPedida { get; set; }

    private bool _carregando = true;
    private const int MaximoDeOrigens = 12;

    private bool _abrindo;
    private bool _pegandoDoDia;
    private string? _erro;
    private string? _ok;

    private TreinadorDto? _eu;
    private MeuAlbumDto? _album;
    private PacoteAbertoDto? _aberto;
    private FigurinhaDto? _compartilhar;
    private IReadOnlyList<RaraTiradaDto> _raras = Array.Empty<RaraTiradaDto>();

    private const int RarasNaCapa = 12;
    private PaginaDoAlbumDto? _pagina;

    /// <summary>A folha de apresentação (a CBFV e a Áurea), entre a capa e o sumário: <c>/album?pagina=apresentacao</c>.</summary>
    private const string Apresentacao = "apresentacao";
    private bool _apresentacao;

    private string _busca = string.Empty;
    private bool _soFaltam;

    // O livro: a capa (uma vez por sessão), a folha que vira e as novas que entram colando.
    private bool _capaVerificada;
    private bool _mostrarCapa;
    private bool _abrindoCapa;
    private bool _recemAberto;
    private bool _rolarParaOLivro;
    private bool _virando;
    private HashSet<Guid> _colar = new();
    private readonly HashSet<Guid> _jaColadas = new();
    private string? _paginaDasNovas;
    private DotNetObjectReference<Album>? _ponte;

    private string? Selo => _album is null ? null : $"Melhores de {_album.Album.Temporada - 1}";

    protected override async Task OnInitializedAsync()
    {
        AdminAuth.AuthenticationChanged += AoTrocarDeToken;
        await CarregarAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AbaAberta?.Escondida == true) return;
        if (!_carregando) await AbrirPaginaAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_album is not null && !_capaVerificada)
        {
            _capaVerificada = true;
            try
            {
                _ponte ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("cbfvAlbum.ligar", _ponte);
                // Quem chega direto numa página (link de aviso, busca) não vê a capa.
                var aberta = await JS.InvokeAsync<bool>("cbfvAlbum.capaJaAberta");
                _mostrarCapa = !aberta && _pagina is null && !_apresentacao;
            }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
            StateHasChanged();
            return;
        }

        if (_rolarParaOLivro)
        {
            _rolarParaOLivro = false;
            try { await JS.InvokeVoidAsync("cbfvAlbum.topoDoLivro"); }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        AdminAuth.AuthenticationChanged -= AoTrocarDeToken;
        try { await JS.InvokeVoidAsync("cbfvAlbum.desligar"); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        _ponte?.Dispose();
    }

    private void AoTrocarDeToken() => _ = InvokeAsync(async () => { await CarregarAsync(); StateHasChanged(); });

    // Uma ida ao banco por vez nesta tela. Na primeira carga o login termina de inicializar no meio do
    // caminho e avisa (AuthenticationChanged), o que pede outra carga; sem a fila, as duas usariam o mesmo
    // DbContext ao mesmo tempo ("A second operation was started on this context instance...").
    private readonly SemaphoreSlim _umaPorVez = new(1, 1);

    private async Task CarregarAsync()
    {
        await _umaPorVez.WaitAsync();
        _carregando = true;
        try
        {
            await AdminAuth.EnsureInitializedAsync();
            var token = await AdminAuth.GetTokenAsync();
            _eu = string.IsNullOrWhiteSpace(token) ? null : await TreinadorSvc.GetPorTokenAsync(token, CancellationToken.None);
            _album = _eu is null ? null : await AlbumSvc.MeuAlbumAsync(_eu.TreinadorId, null, CancellationToken.None);
            _raras = _album is null ? Array.Empty<RaraTiradaDto>() : await AlbumSvc.UltimasRarasAsync(RarasNaCapa, CancellationToken.None);
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally
        {
            _carregando = false;
            _umaPorVez.Release();
        }

        await AbrirPaginaAsync();
    }

    /// <summary>
    /// A página pedida no endereço. As novas que aparecem nela entram colando (só desta vez) e deixam de ser
    /// novas da próxima.
    /// </summary>
    private async Task AbrirPaginaAsync()
    {
        _apresentacao = _album is not null && string.Equals(PaginaPedida?.Trim(), Apresentacao, StringComparison.OrdinalIgnoreCase);
        _pagina = _apresentacao ? null : PaginaDoEndereco();

        // A folha aberta, para as novas: a página, ou as figurinhas da Apresentação.
        var daVez = _apresentacao && _album is not null ? PaginaDaApresentacao(_album) : _pagina;
        var chave = _apresentacao ? Apresentacao : _pagina?.Chave.NoEndereco;
        if (chave != _paginaDasNovas)
        {
            _paginaDasNovas = chave;
            // Voltar à página depois (as novas continuam marcadas na memória) não cola de novo.
            _colar = daVez?.Vagas.Where(v => v.Nova && _jaColadas.Add(v.Figurinha.FigurinhaId)).Select(v => v.Figurinha.FigurinhaId).ToHashSet() ?? new();
        }
        if (daVez is null || _eu is null) return;

        var novas = daVez.Vagas.Where(v => v.Nova).Select(v => v.Figurinha.FigurinhaId).ToList();
        if (novas.Count == 0) return;
        await _umaPorVez.WaitAsync();
        try { await AlbumSvc.MarcarVistasAsync(_eu.TreinadorId, novas, CancellationToken.None); }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _umaPorVez.Release(); }
    }

    private PaginaDoAlbumDto? PaginaDoEndereco()
    {
        if (_album is null) return null;
        if (!string.IsNullOrWhiteSpace(PaginaPedida))
        {
            if (AlbumFigurinhas.EspecialPeloEndereco(PaginaPedida) is { } especial)
                return _album.Paginas.FirstOrDefault(p => p.Especial == especial);
            return Guid.TryParse(PaginaPedida, out var id) ? _album.Paginas.FirstOrDefault(p => p.Especial is null && p.TeamId == id) : null;
        }

        return Clube is { } clube ? _album.Paginas.FirstOrDefault(p => p.Especial is null && p.TeamId == clube) : null;
    }

    /// <summary>
    /// O endereço da folha; nulo = o sumário. O sumário também leva <c>?pagina=</c>: "/album" puro é tratado pelas
    /// abas como clique no menu e volta para a última folha aberta (AbasService), então a folha nunca saía do lugar.
    /// </summary>
    private static string Endereco(PaginaDoAlbumDto? pagina) => $"/album?pagina={pagina?.Chave.NoEndereco ?? Sumario}";

    private const string Sumario = "sumario";

    /// <summary>As folhas que se folheiam: todas as páginas menos a da Apresentação (as figurinhas dela ficam na folha de texto).</summary>
    private static List<PaginaDoAlbumDto> Folhas(MeuAlbumDto a) =>
        a.Paginas.Where(p => p.Especial != PaginaEspecial.Apresentacao).ToList();

    private static PaginaDoAlbumDto? PaginaDaApresentacao(MeuAlbumDto a) =>
        a.Paginas.FirstOrDefault(p => p.Especial == PaginaEspecial.Apresentacao);

    /// <summary>A figurinha da Áurea vai no lugar da ilustração (pelo nome, sem ligar para acento).</summary>
    private static bool EhAurea(VagaDoAlbumDto v) =>
        System.Globalization.CultureInfo.InvariantCulture.CompareInfo.IndexOf(v.Figurinha.NomeImpresso, "aurea",
            System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace) >= 0;

    private int IndiceDa(PaginaDoAlbumDto pagina) =>
        _album is null ? -1 : Folhas(_album).FindIndex(p => p.Chave == pagina.Chave);

    /// <summary>Vira a folha (para a frente ou para trás) e vai para a página; nulo = o sumário.</summary>
    private Task IrParaAsync(PaginaDoAlbumDto? destino, int direcao) => VirarParaAsync(Endereco(destino), direcao);

    /// <summary>A apresentação vem antes do sumário: chegar nela é sempre voltar uma folha.</summary>
    private Task IrParaApresentacaoAsync() => VirarParaAsync($"/album?pagina={Apresentacao}", -1);

    private string EnderecoAtual => _apresentacao ? $"/album?pagina={Apresentacao}" : Endereco(_pagina);

    private async Task VirarParaAsync(string endereco, int direcao)
    {
        if (_virando || endereco == EnderecoAtual) return;
        _virando = true;
        try
        {
            try { await JS.InvokeVoidAsync("cbfvAlbum.virar", direcao); }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
            _rolarParaOLivro = true;
            Navigation.NavigateTo(endereco);
        }
        finally { _virando = false; }
    }

    /// <summary>Arrastar para o lado no celular ou as setas do teclado (cbfvAlbum no app.js).</summary>
    [JSInvokable]
    public async Task Virar(bool proxima)
    {
        if (_album is null || _mostrarCapa || !string.IsNullOrWhiteSpace(_busca) || _aberto is not null || _compartilhar is not null) return;
        var paginas = Folhas(_album);
        if (_apresentacao)
        {
            if (proxima) await IrParaAsync(null, 1);
            return;
        }
        if (_pagina is null)
        {
            if (proxima && paginas.Count > 0) await IrParaAsync(paginas[0], 1);
            else if (!proxima) await IrParaApresentacaoAsync();
            return;
        }

        var i = IndiceDa(_pagina);
        if (proxima && i < paginas.Count - 1) await IrParaAsync(paginas[i + 1], 1);
        else if (!proxima) await IrParaAsync(i > 0 ? paginas[i - 1] : null, -1);
    }

    private async Task AbrirCapaAsync()
    {
        if (_abrindoCapa) return;
        _abrindoCapa = true;
        var reduzido = false;
        try
        {
            await JS.InvokeVoidAsync("cbfvAlbum.marcarCapaAberta");
            reduzido = await JS.InvokeAsync<bool>("cbfvAlbum.movimentoReduzido");
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }

        if (!reduzido)
        {
            StateHasChanged();
            await Task.Delay(950);
        }
        _mostrarCapa = false;
        _abrindoCapa = false;
        _recemAberto = !reduzido;
    }

    private void VerCapa()
    {
        _mostrarCapa = true;
        _recemAberto = false;
        // Fechou o livro: ao abrir de novo, começa pelo sumário.
        if (_pagina is not null || _apresentacao) Navigation.NavigateTo(Endereco(null));
    }

    /// <summary>O sumário em partes: a abertura (Organização), os clubes e a história (Campeões e Lendários).</summary>
    private static IEnumerable<(string Titulo, List<PaginaDoAlbumDto> Paginas)> Secoes(MeuAlbumDto a)
    {
        bool Antes(PaginaDoAlbumDto p) => p.Especial is { } e && AlbumFigurinhas.Especial(e).AntesDosClubes;
        var abertura = Folhas(a).Where(Antes).ToList();
        var clubes = a.Paginas.Where(p => p.Especial is null).ToList();
        var historia = a.Paginas.Where(p => p.Especial is not null && !Antes(p)).ToList();
        if (abertura.Count > 0) yield return ("Abertura", abertura);
        if (clubes.Count > 0) yield return ("Clubes", clubes);
        if (historia.Count > 0) yield return ("Hall da Fama e Lendas", historia);
    }

    private async Task PegarDoDiaAsync()
    {
        if (_eu is null) return;
        _pegandoDoDia = true;
        _erro = null;
        await _umaPorVez.WaitAsync();
        try
        {
            var ganhou = await AlbumSvc.PegarPacoteDoDiaAsync(_eu.TreinadorId, CancellationToken.None);
            _album = await AlbumSvc.MeuAlbumAsync(_eu.TreinadorId, null, CancellationToken.None);
            _pagina = PaginaDoEndereco();
            _ok = ganhou ? "Pacotes do dia na mão. É só abrir!" : "Você já pegou os pacotes de hoje. Amanhã tem mais.";
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally
        {
            _pegandoDoDia = false;
            _umaPorVez.Release();
        }
    }

    private static string IconeDaOrigem(string origem) => origem switch
    {
        PacoteGanho.OrigemDiario => "sun",
        PacoteGanho.OrigemJogo => "trophy",
        PacoteGanho.OrigemDiaDeJogo => "goal",
        PacoteGanho.OrigemBolao => "target",
        PacoteGanho.OrigemAdmin => "package",
        _ => "images"
    };

    private async Task AbrirAsync()
    {
        if (_eu is null) return;
        _abrindo = true;
        _erro = null;
        _ok = null;
        await _umaPorVez.WaitAsync();
        try
        {
            _aberto = await AlbumSvc.AbrirPacoteAsync(_eu.TreinadorId, CancellationToken.None);
            _album = await AlbumSvc.MeuAlbumAsync(_eu.TreinadorId, null, CancellationToken.None);
            _raras = await AlbumSvc.UltimasRarasAsync(RarasNaCapa, CancellationToken.None);
            _pagina = PaginaDoEndereco();
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally
        {
            _abrindo = false;
            _umaPorVez.Release();
        }
    }

    private IEnumerable<VagaDoAlbumDto> Filtrar(IEnumerable<VagaDoAlbumDto> vagas) =>
        _soFaltam ? vagas.Where(v => !v.Colada) : vagas;

    private bool Bate(VagaDoAlbumDto v)
    {
        var termo = _busca.Trim().TrimStart('#');
        if (termo.Length == 0) return true;
        if (int.TryParse(termo, out var numero)) return v.Figurinha.Numero == numero;
        var normal = TextoBusca.Normalizar(termo);
        return TextoBusca.Normalizar(v.Figurinha.NomeImpresso).Contains(normal)
               || TextoBusca.Normalizar(v.Figurinha.TimeNome ?? "").Contains(normal)
               || TextoBusca.Normalizar(v.Figurinha.Destaque ?? "").Contains(normal);
    }
}
