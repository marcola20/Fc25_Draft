@page "/calendario"
@using System
@using System.Collections.Generic
@using System.Linq
@using Fc25Draft.Core.DTOs.Seasons
@using Fc25Draft.Web.Utilities
@inject SeasonApiClient SeasonApiClient
@inject Blazored.Toast.Services.IToastService Toasts
@inject RoundSelectionApiClient RoundSelectionApiClient

<PageTitle>Calendário de Rodadas</PageTitle>

<h1 class="h3 mb-3">Calendário de Rodadas</h1>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}
else if (_seasons is null)
{
    <div class="alert alert-info" role="status">Carregando temporadas...</div>
}
else if (_seasons.Count == 0)
{
    <div class="alert alert-warning" role="status">Nenhuma temporada cadastrada até o momento.</div>
}
else
{
    <div class="row g-3 mb-3 align-items-end">
        <div class="col-12 col-md-4 col-lg-3">
            <label for="season-select" class="form-label">Temporada</label>
            <select id="season-select" class="form-select" @bind="_selectedSeasonId" @bind:after="@(async () => await OnSeasonChangedAsync(_selectedSeasonId))">
                @foreach (var season in _seasons)
                {
                    <option value="@season.SeasonId">@season.Name@(season.IsActive ? " (Ativa)" : string.Empty)</option>
                }
            </select>
        </div>
    </div>

    if (_isScheduleLoading)
    {
        <div class="alert alert-info" role="status">Carregando calendário...</div>
    }
    else if (_schedule is null || _schedule.Count == 0)
    {
        <div class="alert alert-warning" role="status">Nenhuma rodada cadastrada para esta temporada.</div>
    }
    else
    {
        <ol class="list-group list-group-numbered">
            @foreach (var item in _schedule.OrderBy(s => s.Order))
            {
                <li class="list-group-item" role="button" tabindex="0" style="cursor: pointer;"
                    @onclick="async () => await ToggleRoundAsync(item.RoundId)"
                    @onkeydown="async args => await OnRoundKeyDownAsync(args, item.RoundId)">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fw-semibold">@item.CompetitionName — @item.RoundName</div>
                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                            {
                                <div class="text-muted small">@item.Notes</div>
                            }
                        </div>
                        <div class="text-end">
                            <div>@StatusLabel(item)</div>
                            <div class="text-muted">@FormatDate(item.PlayedAtUtc)</div>
                        </div>
                    </div>

                    @if (_expandedRoundId == item.RoundId)
                    {
                        var state = GetSelectionState(item.RoundId);
                        <div class="mt-3 border-top pt-3" @onclick:stopPropagation="true">
                            <h6 class="fw-semibold mb-2">Seleção da Rodada</h6>

                            @if (state.IsLoading)
                            {
                                <div class="alert alert-info" role="status">Carregando seleção...</div>
                            }
                            else if (!string.IsNullOrEmpty(state.Error))
                            {
                                <div class="alert alert-warning" role="status">@state.Error</div>
                            }
                            else if (state.Players.Count == 0)
                            {
                                <div class="text-muted">Seleção da rodada ainda não definida.</div>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var player in state.Players)
                                    {
                                        <li class="list-group-item px-0">
                                            @FormatSelectionLine(player)
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </li>
            }
        </ol>
    }
}

@code {
    private IReadOnlyList<SeasonDto>? _seasons;
    private Guid? _selectedSeasonId;
    private IReadOnlyList<SeasonScheduleEntryDto>? _schedule;
    private Guid? _expandedRoundId;
    private readonly Dictionary<Guid, RoundSelectionViewState> _selectionCache = new();
    private bool _isScheduleLoading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadSeasonsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task LoadSeasonsAsync()
    {
        try
        {
            _seasons = await SeasonApiClient.GetSeasonsAsync();
            _selectedSeasonId = _seasons.FirstOrDefault(s => s.IsActive)?.SeasonId ?? _seasons.FirstOrDefault()?.SeasonId;
            if (_selectedSeasonId.HasValue)
            {
                await LoadScheduleAsync(_selectedSeasonId.Value);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task OnSeasonChangedAsync(Guid? seasonId)
    {
        if (seasonId.HasValue)
        {
            _selectedSeasonId = seasonId;
            await LoadScheduleAsync(seasonId.Value);
        }
    }

    private async Task LoadScheduleAsync(Guid seasonId)
    {
        _isScheduleLoading = true;
        _schedule = null;
        _expandedRoundId = null;
        _selectionCache.Clear();
        StateHasChanged();

        try
        {
            _schedule = await SeasonApiClient.GetScheduleAsync(seasonId);
        }
        catch (Exception ex)
        {
            Toasts.ShowError(ex.Message);
        }
        finally
        {
            _isScheduleLoading = false;
            StateHasChanged();
        }
    }

    private static string StatusLabel(SeasonScheduleEntryDto entry)
        => entry.IsCompleted ? "✅ Concluída" : "⏳ Aguardando";

    private static string FormatDate(DateTime? utc)
        => utc.HasValue ? BrazilTime.FormatDateTime(utc.Value, "dd/MM/yyyy") : "Sem data";

    private RoundSelectionViewState GetSelectionState(Guid roundId)
    {
        if (!_selectionCache.TryGetValue(roundId, out var state))
        {
            state = new RoundSelectionViewState();
            _selectionCache[roundId] = state;
        }

        return state;
    }

    private async Task ToggleRoundAsync(Guid roundId)
    {
        if (_expandedRoundId == roundId)
        {
            _expandedRoundId = null;
            StateHasChanged();
            return;
        }

        _expandedRoundId = roundId;

        var state = GetSelectionState(roundId);
        if (!state.HasLoaded || state.Error is not null)
        {
            await LoadSelectionForRoundAsync(roundId, state);
        }
        else
        {
            StateHasChanged();
        }
    }

    private async Task OnRoundKeyDownAsync(KeyboardEventArgs args, Guid roundId)
    {
        if (args.Key is "Enter" or " " or "Spacebar")
        {
            await ToggleRoundAsync(roundId);
        }
    }

    private async Task LoadSelectionForRoundAsync(Guid roundId, RoundSelectionViewState? state = null)
    {
        state ??= GetSelectionState(roundId);

        if (state.IsLoading)
        {
            return;
        }

        state.IsLoading = true;
        state.Error = null;
        StateHasChanged();

        try
        {
            var selection = await RoundSelectionApiClient.GetAsync(roundId);
            state.Players = selection.Players?
                .OrderBy(p => p.PositionOrder)
                .ThenBy(p => p.PlayerName)
                .ToList()
                ?? new List<RoundSelectionPlayerDto>();
        }
        catch (Exception ex)
        {
            state.Error = ex.Message;
            state.Players = Array.Empty<RoundSelectionPlayerDto>();
        }
        finally
        {
            state.IsLoading = false;
            state.HasLoaded = true;
            StateHasChanged();
        }
    }

    private static string FormatSelectionLine(RoundSelectionPlayerDto player)
    {
        var prefix = player.PositionOrder >= 999 ? string.Empty : $"{player.PositionOrder} — ";
        return $"{prefix}{player.PositionName}: {player.PlayerName}";
    }

    private sealed class RoundSelectionViewState
    {
        public bool IsLoading { get; set; }
        public bool HasLoaded { get; set; }
        public string? Error { get; set; }
        public IReadOnlyList<RoundSelectionPlayerDto> Players { get; set; } = Array.Empty<RoundSelectionPlayerDto>();
    }
}
