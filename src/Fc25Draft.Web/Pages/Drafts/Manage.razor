@page "/draft/info"
@page "/drafts/manage"
@using Fc25Draft.Core.DTOs
@using System.Globalization;
@using System.Runtime.InteropServices;
@inject DraftAdminApiClient DraftAdminApiClient
@inject TeamsApiClient TeamsApiClient
@inject AdminAuthService AdminAuth
@inject IJSRuntime JSRuntime
@inject LayoutState LayoutState
@inject LayoutNavigationService NavigationService
@inject ILogger<Fc25Draft.Web.Pages.Drafts.Manage> Logger

@implements IDisposable

<PageHeader Title="Informações do Draft"
            Subtitle="Consulte e gerencie os drafts cadastrados." />

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

@if (!authInitialized)
{
    <p><em>Carregando informações de autenticação...</em></p>
}
else
{
    if (!AdminAuth.IsAuthenticated)
    {
        <div class="alert alert-info" role="alert">
            Você está visualizando a lista de drafts. Informe o token de administrador na página inicial para adicionar ou remover rodadas.
        </div>
    }

    <div class="mb-4">
        <label class="form-label" for="draftSelector">Draft</label>
        <select id="draftSelector" class="form-select" @onchange="OnDraftChanged" disabled="@isLoadingDrafts">
            @if (isLoadingDrafts)
            {
                <option>Carregando drafts...</option>
            }
            else if (drafts.Count == 0)
            {
                <option>Nenhum draft encontrado</option>
            }
            else
            {
                @foreach (var draft in drafts)
                {
                    <option value="@draft.DraftId" selected="@(selectedDraftId == draft.DraftId)">
                        @draft.Name
                    </option>
                }
            }
        </select>
    </div>

    @if (isLoadingDetails)
    {
        <p><em>Carregando detalhes do draft...</em></p>
    }
    else if (selectedDraft is null)
    {
        <p>Nenhum draft selecionado.</p>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">@selectedDraft.Name</h5>
                <dl class="row mb-0">
                    <dt class="col-sm-3">Total de equipes</dt>
                    <dd class="col-sm-9">@selectedDraft.TotalTeams</dd>
                    <dt class="col-sm-3">Total de rodadas</dt>
                    <dd class="col-sm-9">@selectedDraft.TotalRounds</dd>
                    <dt class="col-sm-3">Modo de configuração</dt>
                    <dd class="col-sm-9">@FormatSetupMode(selectedDraft.SetupMode)</dd>
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">@FormatStatus(selectedDraft.Status)</dd>
                </dl>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">Iniciar draft</div>
            <div class="card-body d-flex flex-column flex-lg-row gap-3 align-items-lg-center justify-content-lg-between">
                <div>
                    <p class="mb-1">O draft só pode iniciar quando todas as escolhas estiverem atribuídas.</p>
                    @if (HasUnassignedPicks)
                    {
                        <small class="text-warning">Ainda existem escolhas sem time atribuído.</small>
                    }
                    else
                    {
                        <small class="text-muted">Todas as escolhas estão atribuídas.</small>
                    }
                </div>
                <div>
                    <button class="btn btn-success"
                            @onclick="StartDraftAsync"
                            disabled="@(!CanStartDraft)">
                        Iniciar draft
                    </button>
                </div>
            </div>
        </div>

        @if (selectedDraft.SetupMode == DraftSetupMode.Manual)
        {
            <div class="card mb-4">
                <div class="card-header">Configuração manual das escolhas</div>
                <div class="card-body">
                    @if (!AdminAuth.IsAuthenticated)
                    {
                        <div class="alert alert-secondary mb-0" role="alert">
                            Somente administradores podem atribuir os donos das escolhas.
                        </div>
                    }
                    else if (isLoadingTeams)
                    {
                        <p><em>Carregando times participantes...</em></p>
                    }
                    else if (draftTeams.Count == 0)
                    {
                        <div class="alert alert-warning mb-0" role="alert">
                            Nenhum time encontrado para atribuir às escolhas.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Rodada</th>
                                        <th>Escolha</th>
                                        <th>Overall</th>
                                        <th>Time</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var round in OrderedRounds)
                                    {
                                        foreach (var pick in round.Picks.OrderBy(p => p.PickInRound))
                                        {
                                            var isUnassigned = pick.Status == DraftPickStatus.Unassigned || pick.TeamId is null;
                                            <tr class="@(isUnassigned ? "table-warning" : string.Empty)">
                                                <td>@round.RoundNumber</td>
                                                <td>@pick.PickInRound</td>
                                                <td>@pick.OverallPick</td>
                                                <td>
                                                    <select class="form-select form-select-sm"
                                                            value="@FormatTeamId(pick.TeamId)"
                                                            @onchange="args => AssignPickOwnerAsync(pick, args)"
                                                            disabled="@(!CanEditAssignments)">
                                                        <option value="">Selecione um time</option>
                                                        @foreach (var team in draftTeams)
                                                        {
                                                            <option value="@team.TeamId">@team.TeamName</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td>@FormatPickStatus(pick.Status)</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }

        @if (AdminAuth.IsAuthenticated)
        {
            <div class="card mb-4">
                <div class="card-header">Adicionar rodada</div>
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label" for="overallMin">Overall mínimo</label>
                            <InputNumber TValue="int?" id="overallMin" class="form-control" @bind-Value="newRoundOverallMin" Min="0" Max="150" disabled="@isProcessing" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label" for="overallMax">Overall máximo</label>
                            <InputNumber TValue="int?" id="overallMax" class="form-control" @bind-Value="newRoundOverallMax" Min="0" Max="150" disabled="@isProcessing" />
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-primary" @onclick="AddRoundAsync" disabled="@isProcessing">Adicionar rodada</button>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2">Os limites são opcionais. Deixe em branco para não restringir o overall.</small>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-secondary mb-4" role="alert">Somente administradores podem adicionar novas rodadas.</div>
        }

        @if (OrderedRounds.Count == 0)
        {
            <p>Nenhuma rodada cadastrada para este draft.</p>
        }
        else
        {
            @if (RoundToDisplay is not null)
            {
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <strong>Rodada @RoundToDisplay.RoundNumber</strong>
                            <span class="ms-2 text-muted">@FormatOverallRange(RoundToDisplay)</span>
                        </div>
                        @if (AdminAuth.IsAuthenticated && CanRemoveRound(RoundToDisplay))
                        {
                            <button class="btn btn-outline-danger btn-sm"
                                    @onclick="() => ConfirmRemoveRoundAsync(RoundToDisplay.RoundNumber)"
                                    disabled="@isProcessing">
                                Remover rodada
                            </button>
                        }
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Escolha</th>
                                        <th>Time</th>
                                        <th>Responsável</th>
                                        <th>Jogador</th>
                                        <th>Data/Hora</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pick in RoundToDisplay.Picks.OrderBy(p => p.PickInRound))
                                    {
                                        <tr>
                                            <td>@pick.PickInRound (@pick.OverallPick)</td>
                                            <td>@(string.IsNullOrWhiteSpace(pick.TeamName) ? "A definir" : pick.TeamName)</td>
                                            <td>@(string.IsNullOrWhiteSpace(pick.TeamOwner) ? "-" : pick.TeamOwner)</td>
                                            <td>@(string.IsNullOrWhiteSpace(pick.PlayerName) ? "Disponível" : pick.PlayerName)</td>
                                            <td>@FormatDateTimePtBr(pick.PickedAtUtc)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <nav class="mb-3" aria-label="Navegação de rodadas">
                <ul class="pagination pagination-sm flex-wrap mb-0">
                    @foreach (var round in OrderedRounds)
                    {
                        <li class="page-item @(round.RoundNumber == selectedRoundNumber ? "active" : string.Empty)">
                            <button type="button" class="page-link"
                                    @onclick="() => SelectRound(round.RoundNumber)"
                                    disabled="@isProcessing">
                                @round.RoundNumber
                            </button>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
}

@code {
    private readonly List<DraftSummaryDto> drafts = new();
    private DraftDetailsDto? selectedDraft;
    private Guid? selectedDraftId;
    private bool authInitialized;
    private bool isLoadingDrafts = true;
    private bool isLoadingDetails;
    private bool isLoadingTeams;
    private bool isProcessing;
    private string? errorMessage;
    private string? successMessage;
    private int? newRoundOverallMin;
    private int? newRoundOverallMax;
    private int? selectedRoundNumber;

    private List<DraftRoundDetailsDto> OrderedRounds = new();
    private DraftRoundDetailsDto? RoundToDisplay;
    private readonly List<TeamListItemDto> draftTeams = new();
    private bool isAssigningPick;

    private bool HasUnassignedPicks => selectedDraft?.Rounds
        .SelectMany(r => r.Picks)
        .Any(p => p.Status == DraftPickStatus.Unassigned || p.TeamId is null) == true;

    private bool CanStartDraft => AdminAuth.IsAuthenticated
        && selectedDraft is not null
        && selectedDraft.Status == DraftStatus.Setup
        && !HasUnassignedPicks
        && !isProcessing;

    private bool CanEditAssignments => AdminAuth.IsAuthenticated
        && selectedDraft is not null
        && selectedDraft.Status == DraftStatus.Setup
        && !isProcessing
        && !isAssigningPick;

    protected override void OnInitialized()
    {
        AdminAuth.AuthenticationChanged += OnAuthenticationChanged;
    }

    private static readonly CultureInfo PtBr = new("pt-BR");
    private static readonly TimeZoneInfo SaoPauloTz =
        TimeZoneInfo.FindSystemTimeZoneById(
            RuntimeInformation.IsOSPlatform(OSPlatform.Windows)
                ? "E. South America Standard Time"   
                : "America/Sao_Paulo"               
        );

    private static string FormatDateTimePtBr(DateTime? pickedAtUtc)
    {
        if (!pickedAtUtc.HasValue) return "-";

        var utc = DateTime.SpecifyKind(pickedAtUtc.Value, DateTimeKind.Utc);

        var local = TimeZoneInfo.ConvertTimeFromUtc(utc, SaoPauloTz);

        return local.ToString("g", PtBr);
    }

    private static string FormatDateTimePtBr(DateTimeOffset? pickedAt)
    {
        if (!pickedAt.HasValue) return "-";
        var local = TimeZoneInfo.ConvertTimeFromUtc(pickedAt.Value.UtcDateTime, SaoPauloTz);
        return local.ToString("g", PtBr);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AdminAuth.EnsureInitializedAsync();
        authInitialized = true;

        await LoadDraftsAndDetailsAsync();

        StateHasChanged();
    }

    private async Task LoadDraftsAndDetailsAsync()
    {
        LayoutState.SetPage(NavigationService.GetPageDefinition("/draft/info"));
        await LoadDraftsAsync();

        Guid? draftId = null;

        if (selectedDraftId.HasValue && drafts.Any(d => d.DraftId == selectedDraftId.Value))
        {
            draftId = selectedDraftId.Value;
        }
        else if (drafts.Count > 0)
        {
            draftId = drafts[0].DraftId;
        }

        if (draftId.HasValue)
        {
            selectedDraftId = draftId.Value;
            await LoadDraftDetailsAsync(draftId.Value);
        }
        else
        {
            selectedDraft = null;
            selectedDraftId = null;
            isLoadingDetails = false;
            selectedRoundNumber = null;
            OrderedRounds = new();
            RoundToDisplay = null;
            draftTeams.Clear();
        }
    }

    private async Task LoadDraftsAsync()
    {
        try
        {
            isLoadingDrafts = true;
            errorMessage = null;
            var result = await DraftAdminApiClient.GetDraftsAsync();
            drafts.Clear();
            drafts.AddRange(result);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Logger.LogError(ex, "LayoutNav:Error ao carregar lista de drafts");
        }
        finally
        {
            isLoadingDrafts = false;
        }
    }

    private async Task LoadDraftDetailsAsync(Guid draftId)
    {
        try
        {
            isLoadingDetails = true;
            errorMessage = null;

            var draft = await DraftAdminApiClient.GetDraftAsync(draftId);
            if (draft is null)
            {
                errorMessage = "Draft não encontrado.";
                selectedDraft = null;
                selectedDraftId = null;
                selectedRoundNumber = null;
                OrderedRounds = new();
                RoundToDisplay = null;
                return;
            }

            selectedDraft = draft;
            selectedDraftId = draft.DraftId;

            if (draft.SetupMode == DraftSetupMode.Manual && AdminAuth.IsAuthenticated)
            {
                await LoadDraftTeamsAsync();
            }
            else
            {
                draftTeams.Clear();
            }

            if (draft.Rounds.Count == 0)
            {
                selectedRoundNumber = null;
            }
            else if (!selectedRoundNumber.HasValue ||
                     !draft.Rounds.Any(r => r.RoundNumber == selectedRoundNumber.Value))
            {
                selectedRoundNumber = draft.Rounds
                    .OrderBy(r => r.RoundNumber)
                    .First()
                    .RoundNumber;
            }

            RecomputeRounds();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Logger.LogError(ex, "LayoutNav:Error ao carregar detalhes do draft {DraftId}", draftId);
        }
        finally
        {
            isLoadingDetails = false;
        }
    }

    private async Task LoadDraftTeamsAsync()
    {
        try
        {
            isLoadingTeams = true;
            draftTeams.Clear();
            var result = await TeamsApiClient.GetAsync(null, 1, 200);
            draftTeams.AddRange(result.Items);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Logger.LogError(ex, "LayoutNav:Error ao carregar times do draft");
        }
        finally
        {
            isLoadingTeams = false;
        }
    }

    private void RecomputeRounds()
    {
        OrderedRounds = selectedDraft?.Rounds?
            .OrderBy(r => r.RoundNumber)
            .ToList() ?? new();

        RoundToDisplay = OrderedRounds
            .FirstOrDefault(r => selectedRoundNumber.HasValue &&
                                 r.RoundNumber == selectedRoundNumber.Value)
            ?? OrderedRounds.FirstOrDefault();
    }

    private async Task OnDraftChanged(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var draftId))
        {
            selectedDraftId = draftId;
            errorMessage = null;
            successMessage = null;
            await LoadDraftDetailsAsync(draftId);
            StateHasChanged();
        }
    }

    private async Task AddRoundAsync()
    {
        if (!selectedDraftId.HasValue || isProcessing) return;

        if (!AdminAuth.IsAuthenticated)
        {
            errorMessage = "Somente administradores podem adicionar rodadas.";
            successMessage = null;
            return;
        }

        try
        {
            isProcessing = true;
            errorMessage = null;
            successMessage = null;

            var request = new DraftRoundCreateDto(newRoundOverallMin, newRoundOverallMax);
            var round = await DraftAdminApiClient.AddRoundAsync(selectedDraftId.Value, request);
            successMessage = $"Rodada {round.RoundNumber} adicionada com sucesso.";
            newRoundOverallMin = null;
            newRoundOverallMax = null;

            await LoadDraftsAsync();
            await LoadDraftDetailsAsync(selectedDraftId.Value); 
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Logger.LogError(ex, "LayoutNav:Error ao adicionar rodada ao draft {DraftId}", selectedDraftId);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task StartDraftAsync()
    {
        if (!selectedDraftId.HasValue || isProcessing)
        {
            return;
        }

        if (!AdminAuth.IsAuthenticated)
        {
            errorMessage = "Somente administradores podem iniciar o draft.";
            successMessage = null;
            return;
        }

        try
        {
            isProcessing = true;
            errorMessage = null;
            successMessage = null;

            await DraftAdminApiClient.StartDraftAsync(selectedDraftId.Value);
            successMessage = "Draft iniciado com sucesso.";
            await LoadDraftDetailsAsync(selectedDraftId.Value);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Logger.LogError(ex, "LayoutNav:Error ao iniciar o draft {DraftId}", selectedDraftId);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ConfirmRemoveRoundAsync(int roundNumber)
    {
        if (!selectedDraftId.HasValue || isProcessing) return;

        if (!AdminAuth.IsAuthenticated)
        {
            errorMessage = "Somente administradores podem remover rodadas.";
            successMessage = null;
            return;
        }

        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"Remover a rodada {roundNumber}? Esta ação não pode ser desfeita.");
        if (!confirm) return;

        try
        {
            isProcessing = true;
            errorMessage = null;
            successMessage = null;

            await DraftAdminApiClient.DeleteRoundAsync(selectedDraftId.Value, roundNumber);
            successMessage = $"Rodada {roundNumber} removida com sucesso.";

            await LoadDraftsAsync();
            if (selectedDraftId.HasValue)
            {
                await LoadDraftDetailsAsync(selectedDraftId.Value); 
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Logger.LogError(ex, "LayoutNav:Error ao remover rodada {Round} do draft {DraftId}", roundNumber, selectedDraftId);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void SelectRound(int roundNumber)
    {
        selectedRoundNumber = roundNumber;
        RecomputeRounds();
    }

    private async Task AssignPickOwnerAsync(DraftRoundPickDto pick, ChangeEventArgs args)
    {
        if (!selectedDraftId.HasValue || !CanEditAssignments)
        {
            return;
        }

        if (args.Value is null || string.IsNullOrWhiteSpace(args.Value.ToString()))
        {
            return;
        }

        if (!Guid.TryParse(args.Value.ToString(), out var teamId))
        {
            errorMessage = "Time inválido para atribuição.";
            return;
        }

        if (pick.TeamId == teamId)
        {
            return;
        }

        try
        {
            isAssigningPick = true;
            errorMessage = null;
            successMessage = null;

            await DraftAdminApiClient.AssignDraftPickOwnerAsync(
                pick.DraftPickId,
                teamId,
                pick.RowVersion.ToString(CultureInfo.InvariantCulture));

            successMessage = "Escolha atualizada com sucesso.";
            await LoadDraftDetailsAsync(selectedDraftId.Value);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Logger.LogError(ex, "LayoutNav:Error ao atribuir time à escolha {PickId}", pick.DraftPickId);
        }
        finally
        {
            isAssigningPick = false;
        }
    }

    private bool CanRemoveRound(DraftRoundDetailsDto round)
    {
        if (!AdminAuth.IsAuthenticated || selectedDraft is null) return false;

        var isLastRound = round.RoundNumber == selectedDraft.Rounds.Max(r => r.RoundNumber);
        var hasSelections = round.Picks.Any(p => p.PlayerId.HasValue);
        return isLastRound && !hasSelections;
    }

    private static string FormatOverallRange(DraftRoundDetailsDto round)
    {
        if (round.OverallMin is null && round.OverallMax is null) return "Sem limite de overall";

        if (round.OverallMin is int min && round.OverallMax is int max) return $"Overall {min} - {max}";
        if (round.OverallMin is int minValue) return $"Overall mínimo {minValue}";
        if (round.OverallMax is int maxValue) return $"Overall máximo {maxValue}";
        return string.Empty;
    }

    private static string FormatSetupMode(DraftSetupMode setupMode)
        => setupMode switch
        {
            DraftSetupMode.Manual => "Manual",
            _ => "Automático"
        };

    private static string FormatStatus(DraftStatus status)
        => status switch
        {
            DraftStatus.Active => "Em andamento",
            _ => "Em configuração"
        };

    private static string FormatPickStatus(DraftPickStatus status)
        => status switch
        {
            DraftPickStatus.Assigned => "Atribuída",
            DraftPickStatus.Used => "Utilizada",
            _ => "Não atribuída"
        };

    private static string FormatTeamId(Guid? teamId)
        => teamId?.ToString("D") ?? string.Empty;

    private void OnAuthenticationChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadDraftsAndDetailsAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AdminAuth.AuthenticationChanged -= OnAuthenticationChanged;
    }
}
