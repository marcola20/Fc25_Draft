@page "/plantao"
@using Fc25Draft.Core.Utilities
@inject ILigaPublicService LigaService
@inject IDiretoriaService DiretoriaSvc
@inject IAposentadoriaService AposentadoriaSvc
@inject IPremiosService PremiosSvc
@inject ITreinadorService TreinadorNoticiasSvc
@inject IParticipacaoService ParticipacaoSvc
@inject ITreinoService TreinoSvc
@inject IPicksDoDraftService PicksSvc

<PageTitle>Plantão CBFV</PageTitle>

<div style="max-width: 900px;">
    <p class="text-body-secondary small mb-3">
        Notícias sobre jogos, gols, títulos, transferências, diretoria e jogadores. Clique para ver o time ou o jogador.
    </p>
    <ul class="nav nav-pills mb-4" role="tablist" aria-label="Filtro">
        <li class="nav-item"><button type="button" class="nav-link @(_filtro is null ? "active" : "")" @onclick="() => Filtrar(null)">Tudo</button></li>
        <li class="nav-item"><button type="button" class="nav-link @(_filtro == PlantaoCategoria.Jogo ? "active" : "")" @onclick="() => Filtrar(PlantaoCategoria.Jogo)">Jogos</button></li>
        <li class="nav-item"><button type="button" class="nav-link @(_filtro == PlantaoCategoria.Mercado ? "active" : "")" @onclick="() => Filtrar(PlantaoCategoria.Mercado)">Mercado</button></li>
        <li class="nav-item"><button type="button" class="nav-link @(_filtro == PlantaoCategoria.Diretoria ? "active" : "")" @onclick="() => Filtrar(PlantaoCategoria.Diretoria)">Diretoria</button></li>
        <li class="nav-item"><button type="button" class="nav-link @(_filtro == PlantaoCategoria.Carreira ? "active" : "")" @onclick="() => Filtrar(PlantaoCategoria.Carreira)">Carreira</button></li>
    </ul>

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    }
    else if (_erro is not null)
    {
        <div class="alert alert-danger"><strong>Erro ao carregar o Plantão:</strong> @_erro</div>
    }
    else if (!Filtradas.Any())
    {
        <div class="alert alert-secondary">Nenhuma notícia ainda.</div>
    }
    else
    {
        @* Como um caderno de esportes: as notícias agrupadas por dia, do mais recente para o mais antigo. *@
        @foreach (var dia in Filtradas.Take(_limite).GroupBy(n => BrazilTime.ConvertFromUtc(n.Data).Date))
        {
            <section class="mb-4">
                <div class="secao-titulo"><h2>@RotuloDoDia(dia.Key)</h2></div>
                <PlantaoLista Noticias="@dia" SoHora="true" />
            </section>
        }

        @if (Filtradas.Count() > _limite)
        {
            <div class="text-center mt-3">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => _limite += PorPagina">Ver mais notícias</button>
            </div>
        }
    }
</div>

@code {
    private const int PorPagina = 30;
    private static readonly System.Globalization.CultureInfo Br = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");

    // "Hoje", "Ontem" ou o dia da semana com a data ("ter., 03/11").
    private static string RotuloDoDia(DateTime dia)
    {
        var hoje = BrazilTime.ConvertFromUtc(DateTime.UtcNow).Date;
        if (dia == hoje) return "Hoje";
        if (dia == hoje.AddDays(-1)) return "Ontem";
        var texto = dia.ToString("ddd, dd/MM", Br);
        return char.ToUpper(texto[0], Br) + texto[1..];
    }

    private IReadOnlyList<PlantaoNoticiaDto> _noticias = Array.Empty<PlantaoNoticiaDto>();
    private PlantaoCategoria? _filtro;
    private int _limite = PorPagina;
    private bool _loading = true;
    private string? _erro;

    private IEnumerable<PlantaoNoticiaDto> Filtradas =>
        _filtro is null ? _noticias : _noticias.Where(n => n.Categoria == _filtro);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var noticias = (await LigaService.GetPlantaoAsync(CancellationToken.None)).ToList();
            // A diretoria é complementar: se falhar, o Plantão segue com o resto.
            try { noticias.AddRange(await DiretoriaSvc.GetNoticiasAsync(CancellationToken.None)); } catch { }
            try { noticias.AddRange(await AposentadoriaSvc.GetNoticiasAsync(CancellationToken.None)); } catch { }
            try { noticias.AddRange(await PremiosSvc.GetNoticiasAsync(CancellationToken.None)); } catch { }
            try { noticias.AddRange(await TreinadorNoticiasSvc.GetNoticiasAsync(CancellationToken.None)); } catch { }
            try { noticias.AddRange(await ParticipacaoSvc.GetNoticiasAsync(CancellationToken.None)); } catch { }
            try { noticias.AddRange(await TreinoSvc.GetNoticiasAsync(CancellationToken.None)); } catch { }
            try { noticias.AddRange(await PicksSvc.GetNoticiasAsync(CancellationToken.None)); } catch { }
            _noticias = noticias.OrderByDescending(n => n.Data).ToList();
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void Filtrar(PlantaoCategoria? categoria)
    {
        _filtro = categoria;
        _limite = PorPagina;
    }
}
