@using System.Globalization
@using Fc25Draft.Core.DTOs
@inject EscudoService Escudos

@* O que está acontecendo agora na liga: aparece no topo da Central CBFV.
   Primeira linha só com times, segunda só com jogadores; cada linha divide a largura entre os seus cards. *@

@if (_dados is not null && TemAlgo)
{
    <h5 class="text-uppercase text-muted small fw-bold mb-2">Destaques</h5>

    @if (TemTime)
    {
        <div class="row g-3 mb-3">
            @foreach (var lider in _dados.Lideres)
            {
                <div class="col-12 col-md">
                    <a href="/liga?liga=@lider.LigaId" class="card h-100 text-decoration-none text-body border-warning">
                        <div class="card-body py-2 d-flex align-items-center gap-3">
                            <img src="@Escudos.GetEscudo(lider.TimeNome)" alt="" width="40" height="40" style="object-fit: contain;" />
                            <div class="min-w-0">
                                <div class="small text-muted text-truncate">🏆 Líder · @lider.LigaNome</div>
                                <div class="fs-5 fw-bold text-truncate">@lider.TimeNome</div>
                                <div class="small text-muted">@lider.Pontos pontos em @lider.Jogos jogos</div>
                            </div>
                        </div>
                    </a>
                </div>
            }

            @if (_dados.MelhorFase.Count > 0)
            {
                var n = _dados.MelhorFase[0].Jogos;
                @Fase(_dados.MelhorFase, "🔥 Em melhor fase", "border-success", "text-success",
                    f => f.Vitorias == f.Jogos ? $"{n} vitórias seguidas" : $"Invicto há {n} jogos · {Retrospecto(f)}",
                    $"Invictos há {n} jogos")
            }

            @if (_dados.PiorFase.Count > 0)
            {
                var n = _dados.PiorFase[0].Jogos;
                @Fase(_dados.PiorFase, "🥶 Em pior fase", "border-danger", "text-danger",
                    f => f.Derrotas == f.Jogos ? $"{n} derrotas seguidas" : $"Sem vencer há {n} jogos · {Retrospecto(f)}",
                    $"Sem vencer há {n} jogos")
            }
        </div>
    }

    @if (TemJogador)
    {
        <div class="row g-3 mb-4">
            @if (_dados.Artilheiros.Count > 0)
            {
                @Contagem(_dados.Artilheiros, "⚽", "Artilheiro", "Artilheiros", "gol", "gols", "border-primary")
            }

            @if (_dados.Garcons.Count > 0)
            {
                @Contagem(_dados.Garcons, "🎯", "Garçom", "Garçons", "assistência", "assistências", "border-info")
            }

            @if (_dados.MelhorNota is { } nota)
            {
                <div class="col-12 col-sm-6 col-xl">
                    <a href="/players/details/@nota.JogadorId" class="card h-100 text-decoration-none text-body border-success">
                        <div class="card-body py-2 d-flex align-items-center gap-3">
                            <FotoJogador PlayerId="@nota.JogadorId" Tamanho="48" Classe="flex-shrink-0" />
                            <div class="min-w-0">
                                <div class="small text-muted">⭐ Melhor nota</div>
                                <div class="fs-5 fw-bold text-truncate">@nota.Nome</div>
                                <div class="small text-muted text-truncate">
                                    @nota.Media.ToString("0.00", Brasil) em @nota.Jogos @(nota.Jogos == 1 ? "jogo" : "jogos") · @nota.TimeNome
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }

            @if (_dados.Paredoes.Count > 0)
            {
                @Contagem(_dados.Paredoes, "🧤", "Paredão", "Paredões", "clean sheet", "clean sheets", "border-secondary")
            }
        </div>
    }
}

@code {
    private static readonly CultureInfo Brasil = CultureInfo.GetCultureInfo("pt-BR");

    // Fotos sobrepostas no card de empate; os nomes aparecem todos.
    private const int FotosNoEmpate = 3;

    // Carregado pela página inicial (em sequência com o Plantão: as duas consultas usam a mesma conexão).
    [Parameter] public DestaquesDto? Dados { get; set; }

    private DestaquesDto? _dados => Dados;

    private bool TemTime => _dados is not null && (_dados.Lideres.Count > 0 || _dados.MelhorFase.Count > 0 || _dados.PiorFase.Count > 0);

    /// <summary>"3V 2E": o que o time fez na sequência, sem os zeros.</summary>
    private static string Retrospecto(DestaqueFaseDto f) => string.Join(" ",
        new[] { (f.Vitorias, "V"), (f.Empates, "E"), (f.Derrotas, "D") }.Where(x => x.Item1 > 0).Select(x => $"{x.Item1}{x.Item2}"));

    /// <summary>Card da melhor/pior fase; no empate, todos os times com o retrospecto de cada um.</summary>
    private RenderFragment Fase(IReadOnlyList<DestaqueFaseDto> times, string titulo, string borda, string cor,
        Func<DestaqueFaseDto, string> sequencia, string sequenciaEmpate) => __builder =>
    {
        if (times.Count == 1)
        {
            var f = times[0];
            <div class="col-12 col-md">
                <a href="/teams/details/@f.TimeId" class="card h-100 text-decoration-none text-body @borda">
                    <div class="card-body py-2 d-flex align-items-center gap-3">
                        <img src="@Escudos.GetEscudo(f.TimeNome)" alt="" width="40" height="40" style="object-fit: contain;" />
                        <div class="min-w-0">
                            <div class="small text-muted">@titulo</div>
                            <div class="fs-5 fw-bold text-truncate">@f.TimeNome</div>
                            <div class="small @cor fw-semibold">@sequencia(f)</div>
                        </div>
                    </div>
                </a>
            </div>
        }
        else
        {
            <div class="col-12 col-md">
                <div class="card h-100 @borda">
                    <div class="card-body py-2 d-flex align-items-center gap-3">
                        <div class="d-flex flex-shrink-0">
                            @foreach (var (f, i) in times.Take(FotosNoEmpate).Select((f, i) => (f, i)))
                            {
                                <img src="@Escudos.GetEscudo(f.TimeNome)" alt="" width="36" height="36"
                                     style="object-fit: contain; @(i == 0 ? "" : "margin-left: -12px;")" />
                            }
                        </div>
                        <div class="min-w-0">
                            <div class="small text-muted">@titulo</div>
                            @foreach (var f in times)
                            {
                                <div class="text-truncate lh-sm">
                                    <a href="/teams/details/@f.TimeId" class="fw-bold text-body text-decoration-none">@f.TimeNome</a>
                                    <span class="small text-muted">@Retrospecto(f)</span>
                                </div>
                            }
                            <div class="small @cor fw-semibold">@sequenciaEmpate</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    };

    private bool TemJogador => _dados is not null
        && (_dados.Artilheiros.Count > 0 || _dados.Garcons.Count > 0 || _dados.MelhorNota is not null || _dados.Paredoes.Count > 0);

    private bool TemAlgo => TemTime || TemJogador;

    /// <summary>Card de quem lidera uma contagem; no empate, todos os empatados com o link de cada um.</summary>
    private RenderFragment Contagem(IReadOnlyList<DestaqueJogadorDto> jogadores, string icone, string titulo,
        string tituloPlural, string unidade, string unidadePlural, string borda) => __builder =>
    {
        var total = jogadores[0].Total;
        var numero = $"{total} {(total == 1 ? unidade : unidadePlural)}";
        if (jogadores.Count == 1)
        {
            var j = jogadores[0];
            <div class="col-12 col-sm-6 col-xl">
                <a href="/players/details/@j.JogadorId" class="card h-100 text-decoration-none text-body @borda">
                    <div class="card-body py-2 d-flex align-items-center gap-3">
                        <FotoJogador PlayerId="@j.JogadorId" Tamanho="48" Classe="flex-shrink-0" />
                        <div class="min-w-0">
                            <div class="small text-muted">@icone @titulo da temporada</div>
                            <div class="fs-5 fw-bold text-truncate">@j.Nome</div>
                            <div class="small text-muted text-truncate">@numero · @j.TimeNome</div>
                        </div>
                    </div>
                </a>
            </div>
        }
        else
        {
            <div class="col-12 col-sm-6 col-xl">
                <div class="card h-100 @borda">
                    <div class="card-body py-2 d-flex align-items-center gap-3">
                        <div class="d-flex flex-shrink-0">
                            @foreach (var (j, i) in jogadores.Take(FotosNoEmpate).Select((j, i) => (j, i)))
                            {
                                <span style="@(i == 0 ? "" : "margin-left: -18px;")">
                                    <FotoJogador PlayerId="@j.JogadorId" Tamanho="40" Classe="border border-2 border-dark rounded-circle" />
                                </span>
                            }
                        </div>
                        <div class="min-w-0">
                            <div class="small text-muted">@icone @tituloPlural da temporada</div>
                            <div class="fw-bold lh-sm">
                                @for (var i = 0; i < jogadores.Count; i++)
                                {
                                    var j = jogadores[i];
                                    <a href="/players/details/@j.JogadorId" class="text-body text-decoration-none" title="@j.TimeNome">@j.Nome</a>@(i < jogadores.Count - 1 ? ", " : "")
                                }
                            </div>
                            <div class="small text-muted">@numero cada</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    };
}
