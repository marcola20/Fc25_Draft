@using System.Globalization
@using Fc25Draft.Core.DTOs
@inject EscudoService Escudos

@* A capa da liga no topo da Central CBFV: uma linha com os times (líderes, melhor e pior fase) e outra com os
   jogadores da temporada. As células dividem a largura e são separadas por linhas finas, como uma tabela de
   jornal; a cor fica com os escudos, as fotos e a sequência de resultados. *@

@if (_dados is not null && TemAlgo)
{
    <section class="destaques" aria-labelledby="destaques-titulo">
        <div class="secao-titulo">
            <h2 id="destaques-titulo">Destaques</h2>
        </div>

        <div class="capa">
            @if (TemTime)
            {
                <div class="capa-linha">
                    @foreach (var lider in _dados.Lideres)
                    {
                        <a href="/liga?liga=@lider.LigaId" class="capa-item capa-lider">
                            <img src="@Escudos.GetEscudo(lider.TimeNome)" alt="" class="capa-escudo" width="44" height="44" />
                            <span class="capa-texto">
                                <span class="capa-rotulo">Líder · @lider.LigaNome</span>
                                <span class="capa-nome">@lider.TimeNome</span>
                                <span class="capa-meta"><span class="numero">@lider.Pontos</span> pontos em <span class="numero">@lider.Jogos</span> jogos</span>
                            </span>
                        </a>
                    }

                    @if (_dados.MelhorFase.Count > 0)
                    {
                        var n = _dados.MelhorFase[0].Jogos;
                        @Fase(_dados.MelhorFase, "Em melhor fase",
                            f => f.Vitorias == f.Jogos ? $"{n} vitórias seguidas" : $"Invicto há {n} jogos",
                            $"Invictos há {n} jogos")
                    }

                    @if (_dados.PiorFase.Count > 0)
                    {
                        var n = _dados.PiorFase[0].Jogos;
                        @Fase(_dados.PiorFase, "Em pior fase",
                            f => f.Derrotas == f.Jogos ? $"{n} derrotas seguidas" : $"Sem vencer há {n} jogos",
                            $"Sem vencer há {n} jogos")
                    }
                </div>
            }

            @if (TemJogador)
            {
                <div class="capa-linha">
                    @if (_dados.Artilheiros.Count > 0)
                    {
                        @Contagem(_dados.Artilheiros, "Artilheiro", "Artilheiros", "gol", "gols")
                    }

                    @if (_dados.Garcons.Count > 0)
                    {
                        @Contagem(_dados.Garcons, "Garçom", "Garçons", "assistência", "assistências")
                    }

                    @if (_dados.MelhorNota is { } nota)
                    {
                        <a href="/players/details/@nota.JogadorId" class="capa-item">
                            <FotoJogador PlayerId="@nota.JogadorId" Tamanho="44" Classe="capa-foto" />
                            <span class="capa-texto">
                                <span class="capa-rotulo">Melhor nota</span>
                                <span class="capa-nome">@nota.Nome</span>
                                <span class="capa-meta">
                                    <span class="numero">@nota.Media.ToString("0.00", Brasil)</span> em <span class="numero">@nota.Jogos</span> @(nota.Jogos == 1 ? "jogo" : "jogos") · @nota.TimeNome
                                </span>
                            </span>
                        </a>
                    }

                    @if (_dados.Paredoes.Count > 0)
                    {
                        @Contagem(_dados.Paredoes, "Paredão", "Paredões", "clean sheet", "clean sheets")
                    }
                </div>
            }
        </div>
    </section>
}

@code {
    private static readonly CultureInfo Brasil = CultureInfo.GetCultureInfo("pt-BR");

    // Fotos sobrepostas na célula de empate; os nomes aparecem todos.
    private const int FotosNoEmpate = 3;

    // Carregado pela página inicial (em sequência com o Plantão: as duas consultas usam a mesma conexão).
    [Parameter] public DestaquesDto? Dados { get; set; }

    private DestaquesDto? _dados => Dados;

    private bool TemTime => _dados is not null && (_dados.Lideres.Count > 0 || _dados.MelhorFase.Count > 0 || _dados.PiorFase.Count > 0);

    private bool TemJogador => _dados is not null
        && (_dados.Artilheiros.Count > 0 || _dados.Garcons.Count > 0 || _dados.MelhorNota is not null || _dados.Paredoes.Count > 0);

    private bool TemAlgo => TemTime || TemJogador;

    /// <summary>"3V 2E": o que o time fez na sequência, sem os zeros (vai no título, para quem passa o mouse).</summary>
    private static string Retrospecto(DestaqueFaseDto f) => string.Join(" ",
        new[] { (f.Vitorias, "V"), (f.Empates, "E"), (f.Derrotas, "D") }.Where(x => x.Item1 > 0).Select(x => $"{x.Item1}{x.Item2}"));

    /// <summary>Os jogos da sequência em quadradinhos, agrupados por resultado (a ordem dos jogos não vem no resumo).</summary>
    private static RenderFragment Sequencia(DestaqueFaseDto f) => __builder =>
    {
        <span class="sequencia" role="img" aria-label="@Retrospecto(f)" title="@Retrospecto(f)">
            @for (var i = 0; i < f.Vitorias; i++) { <span class="v">V</span> }
            @for (var i = 0; i < f.Empates; i++) { <span class="e">E</span> }
            @for (var i = 0; i < f.Derrotas; i++) { <span class="d">D</span> }
        </span>
    };

    /// <summary>Célula da melhor/pior fase; no empate, todos os times com a sequência de cada um.</summary>
    private RenderFragment Fase(IReadOnlyList<DestaqueFaseDto> times, string titulo,
        Func<DestaqueFaseDto, string> sequencia, string sequenciaEmpate) => __builder =>
    {
        if (times.Count == 1)
        {
            var f = times[0];
            <a href="/teams/details/@f.TimeId" class="capa-item">
                <img src="@Escudos.GetEscudo(f.TimeNome)" alt="" class="capa-escudo" width="44" height="44" />
                <span class="capa-texto">
                    <span class="capa-rotulo">@titulo</span>
                    <span class="capa-nome">@f.TimeNome</span>
                    <span class="capa-meta capa-meta-sequencia">@Sequencia(f) @sequencia(f)</span>
                </span>
            </a>
        }
        else
        {
            <div class="capa-item">
                <span class="capa-empilhado">
                    @foreach (var f in times.Take(FotosNoEmpate))
                    {
                        <img src="@Escudos.GetEscudo(f.TimeNome)" alt="" class="capa-escudo" width="36" height="36" />
                    }
                </span>
                <span class="capa-texto">
                    <span class="capa-rotulo">@titulo</span>
                    @foreach (var f in times)
                    {
                        <span class="capa-nome-lista">
                            <a href="/teams/details/@f.TimeId">@f.TimeNome</a> @Sequencia(f)
                        </span>
                    }
                    <span class="capa-meta">@sequenciaEmpate</span>
                </span>
            </div>
        }
    };

    /// <summary>Célula de quem lidera uma contagem; no empate, todos os empatados com o link de cada um.</summary>
    private RenderFragment Contagem(IReadOnlyList<DestaqueJogadorDto> jogadores, string titulo,
        string tituloPlural, string unidade, string unidadePlural) => __builder =>
    {
        var total = jogadores[0].Total;
        var unidadeTexto = total == 1 ? unidade : unidadePlural;
        if (jogadores.Count == 1)
        {
            var j = jogadores[0];
            <a href="/players/details/@j.JogadorId" class="capa-item">
                <FotoJogador PlayerId="@j.JogadorId" Tamanho="44" Classe="capa-foto" />
                <span class="capa-texto">
                    <span class="capa-rotulo">@titulo da temporada</span>
                    <span class="capa-nome">@j.Nome</span>
                    <span class="capa-meta"><span class="numero">@total</span> @unidadeTexto · @j.TimeNome</span>
                </span>
            </a>
        }
        else
        {
            <div class="capa-item">
                <span class="capa-empilhado">
                    @foreach (var j in jogadores.Take(FotosNoEmpate))
                    {
                        <FotoJogador PlayerId="@j.JogadorId" Tamanho="36" Classe="capa-foto" />
                    }
                </span>
                <span class="capa-texto">
                    <span class="capa-rotulo">@tituloPlural da temporada</span>
                    <span class="capa-nomes">
                        @foreach (var j in jogadores)
                        {
                            <a href="/players/details/@j.JogadorId" title="@j.Nome · @j.TimeNome">@j.Nome</a>
                        }
                    </span>
                    <span class="capa-meta"><span class="numero">@total</span> @unidadeTexto cada</span>
                </span>
            </div>
        }
    };
}
