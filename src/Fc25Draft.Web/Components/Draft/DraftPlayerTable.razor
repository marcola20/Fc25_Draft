@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Utilities

@if (IsLoading)
{
    <div class="text-center py-4"><span class="spinner-border spinner-border-sm" aria-label="Carregando os jogadores disponíveis"></span></div>
}
else if (Players.Count == 0)
{
    <div class="disponiveis-vazio">Nenhum jogador disponível para escolha</div>
}
else
{
    <div class="table-responsive painel">
        <table class="table table-hover align-middle mb-0 tabela-disponiveis">
            <thead>
                <tr>
                    <th>Jogador</th>
                    <th>Posição</th>
                    <th class="text-center">Overall</th>
                    <th class="text-center">Idade</th>
                    @if (MostrarTime)
                    {
                        <th>Time atual</th>
                    }
                    <th class="text-end"><span class="visually-hidden">Ação</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var player in Players)
                {
                    <tr>
                        <td class="text-nowrap">
                            <FotoJogador PlayerId="@player.PlayerId" Tamanho="28" Classe="me-2" />
                            <a href="/players/details/@player.PlayerId" class="disponivel-nome" target="_blank">@player.Name</a>
                        </td>
                        <td class="text-body-secondary">@player.PositionName</td>
                        <td class="text-center"><span class="ovr @AtributosPes.Faixa(player.Overall)">@player.Overall</span></td>
                        <td class="text-center numero">@(player.Age?.ToString() ?? "—")</td>
                        @if (MostrarTime)
                        {
                            <td class="text-body-secondary">@player.TeamName</td>
                        }
                        <td class="text-end">
                            <button class="btn btn-sm btn-primary" @onclick="() => OnPlayerSelected.InvokeAsync(player)" disabled="@DisableSelection">Escolher</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public List<AvailablePlayerDto> Players { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool DisableSelection { get; set; }
    [Parameter] public EventCallback<AvailablePlayerDto> OnPlayerSelected { get; set; }

    // No draft de expansão os jogadores vêm de outros times.
    private bool MostrarTime => Players.Any(p => p.TeamName is not null);
}
