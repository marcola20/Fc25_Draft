@using Fc25Draft.Core.DTOs
@using Fc25Draft.Web.Services
@inject DraftAutoPickService AutoPickService

@* Admin: rodadas do próximo draft (overall de cada uma), para os times montarem a escolha automática
   antes de o draft existir. Carrega só ao abrir: a página já está usando a conexão com o banco. *@

<div class="card border-warning mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>🛠️ Admin · Planejar o próximo draft</strong>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AlternarAsync">
            @(_aberto ? "Fechar" : "Abrir")
        </button>
    </div>
    @if (_aberto)
    {
        <div class="card-body">
            <p class="small text-muted">
                Os times fora do draft em andamento montam a lista com estas rodadas. Ao gerar o draft
                (pelo Controle do Draft ou pela Loteria do Draft), o overall de cada rodada já vem preenchido com elas,
                as listas entram no draft e as escolhas automáticas começam na hora.
                O planejamento é apagado depois que o draft é gerado.
            </p>

            @if (_carregando)
            {
                <div class="text-center py-2"><div class="spinner-border spinner-border-sm" role="status"></div></div>
            }
            else
            {
                @if (_rodadas.Count == 0)
                {
                    <p class="text-muted small">Nenhuma rodada planejada.</p>
                }
                else
                {
                    <table class="table table-sm align-middle mb-2" style="max-width: 480px;">
                        <thead>
                            <tr>
                                <th>Rodada</th>
                                <th>Overall mínimo</th>
                                <th>Overall máximo</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < _rodadas.Count; i++)
                            {
                                var index = i;
                                var r = _rodadas[i];
                                <tr>
                                    <td>@(index + 1)</td>
                                    <td><input type="number" class="form-control form-control-sm" value="@r.Min" @onchange="e => r.Min = Numero(e)" placeholder="livre" /></td>
                                    <td><input type="number" class="form-control form-control-sm" value="@r.Max" @onchange="e => r.Max = Numero(e)" placeholder="livre" /></td>
                                    <td><button type="button" class="btn btn-sm btn-outline-danger" title="Remover rodada" @onclick="() => _rodadas.RemoveAt(index)">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <div class="d-flex gap-2 flex-wrap">
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AdicionarRodada">+ Rodada</button>
                    <button type="button" class="btn btn-sm btn-success" disabled="@_salvando" @onclick="SalvarAsync">
                        @(_salvando ? "Salvando..." : "Salvar planejamento")
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(_mensagem))
                {
                    <div class="small mt-2 @(_erro ? "text-danger" : "text-success")">@_mensagem</div>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback OnSalvo { get; set; }

    private sealed class Linha
    {
        public int? Min { get; set; }
        public int? Max { get; set; }
    }

    private readonly List<Linha> _rodadas = new();
    private bool _aberto;
    private bool _carregando;
    private bool _salvando;
    private string? _mensagem;
    private bool _erro;

    private async Task AlternarAsync()
    {
        _aberto = !_aberto;
        if (!_aberto) return;

        _carregando = true;
        _mensagem = null;
        try
        {
            var plano = await AutoPickService.GetPlanoAsync();
            _rodadas.Clear();
            _rodadas.AddRange(plano.Select(r => new Linha { Min = r.OverallMin, Max = r.OverallMax }));
        }
        catch (Exception ex)
        {
            _erro = true;
            _mensagem = ex.Message;
        }
        finally
        {
            _carregando = false;
        }
    }

    // Nova rodada começa com os limites da anterior (normalmente só o máximo muda).
    private void AdicionarRodada()
    {
        var anterior = _rodadas.LastOrDefault();
        _rodadas.Add(new Linha { Min = anterior?.Min, Max = anterior?.Max });
    }

    private static int? Numero(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var n) ? n : null;

    private async Task SalvarAsync()
    {
        _salvando = true;
        _mensagem = null;
        try
        {
            await AutoPickService.SalvarPlanoAsync(_rodadas.Select((r, i) => new DraftPlanoRodadaDto(i + 1, r.Min, r.Max)).ToList());
            _erro = false;
            _mensagem = _rodadas.Count == 0
                ? "Planejamento removido."
                : $"✅ Planejamento salvo: {_rodadas.Count} rodada(s).";
            await OnSalvo.InvokeAsync();
        }
        catch (InvalidOperationException ex)
        {
            _erro = true;
            _mensagem = ex.Message;
        }
        finally
        {
            _salvando = false;
        }
    }
}
