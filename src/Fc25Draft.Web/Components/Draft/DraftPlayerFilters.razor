@using Fc25Draft.Core.Entities

<div class="row g-3 align-items-end mb-3">
    <div class="col-lg-4">
        <label class="form-label" for="playerSearch">Pesquisar</label>
        <form class="d-flex" @onsubmit="OnSearchSubmitAsync" @onsubmit:preventDefault>
            <input id="playerSearch" class="form-control me-2" placeholder="Procurar por nome" @bind="searchTerm" />
            <button type="submit" class="btn btn-primary" disabled="@IsLoading">Buscar</button>
        </form>
    </div>
    <div class="col-lg-3">
        <label class="form-label" for="draftPositionFilter">Posições</label>
        @if (isDropdownOpen)
        {
            <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1000;" @onclick="CloseDropdown"></div>
        }
        <div class="position-relative" style="z-index: 1010;">
            <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start text-wrap d-flex align-items-center justify-content-between"
                    type="button"
                    id="draftPositionFilter"
                    @onclick="ToggleDropdown"
                    @onkeydown="HandleKeyDown"
                    aria-expanded="@isDropdownOpen">
                <span class="me-2 flex-grow-1">@GetSelectedPositionsLabel()</span>
            </button>
            <div class="dropdown-menu w-100 p-3 shadow-sm @(isDropdownOpen ? "show" : string.Empty)"
                 aria-labelledby="draftPositionFilter"
                 style="@GetDropdownMenuStyles()"
                 @onclick:stopPropagation>
                <div class="form-check mb-2">
                    <input class="form-check-input"
                           type="checkbox"
                           id="draftPositionsAll"
                           checked="@(!selectedPositionIds.Any())"
                           @onchange="OnSelectAllChangedAsync" />
                    <label class="form-check-label" for="draftPositionsAll">Todas</label>
                </div>
                <div class="dropdown-divider"></div>
                @foreach (var position in Positions)
                {
                    var checkboxId = $"draftPosition{position.PositionId}";
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="@checkboxId"
                               checked="@selectedPositionIds.Contains(position.PositionId)"
                               @onchange="args => OnPositionToggledAsync(position.PositionId, args.Value)" />
                        <label class="form-check-label" for="@checkboxId">@position.Name</label>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-3 d-none d-sm-block">
        <label class="form-label d-block">Atualizar</label>
        <button class="btn btn-outline-primary w-50" @onclick="NotifyFilterChangedAsync" disabled="@IsLoading">Atualizar lista</button>
    </div>
</div>

<div class="row g-3 align-items-end mb-4 draft-filter-group">
    <div class="col-4 col-sm-4 col-md-3 col-lg-2">
        <label class="form-label" for="overallMin">Overall mínimo</label>
        <InputNumber TValue="int?" id="overallMin" class="form-control" min="70" max="99" @bind-Value="overallMin" />
    </div>
    <div class="col-5 col-sm-4 col-md-3 col-lg-2">
        <label class="form-label" for="overallMax">Overall máximo</label>
        <InputNumber TValue="int?" id="overallMax" class="form-control" min="70" max="99" @bind-Value="overallMax" />
    </div>
    <div class="col-3 col-sm-4 col-md-3 col-lg-2 d-flex flex-column justify-content-end gap-2">
        <label class="form-label d-none d-sm-block">&nbsp;</label>
        <button type="button" class="btn btn-outline-primary filter-apply-btn w-100" @onclick="NotifyFilterChangedAsync" disabled="@IsLoading">Filtrar</button>
    </div>
</div>

@code {
    [Parameter] public List<Position> Positions { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback<PlayerFilterState> OnFilterChanged { get; set; }

    private readonly HashSet<short> selectedPositionIds = new();
    private string searchTerm = string.Empty;
    private int? overallMin;
    private int? overallMax;
    private bool isDropdownOpen;

    public record PlayerFilterState(string? SearchTerm, HashSet<short> PositionIds, int? OverallMin, int? OverallMax);

    private Task OnSearchSubmitAsync() => NotifyFilterChangedAsync();

    private Task NotifyFilterChangedAsync()
        => OnFilterChanged.InvokeAsync(new PlayerFilterState(
            string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
            new HashSet<short>(selectedPositionIds),
            overallMin,
            overallMax));

    private async Task OnPositionToggledAsync(short positionId, object? value)
    {
        var isChecked = ParseCheckbox(value);
        var changed = isChecked ? selectedPositionIds.Add(positionId) : selectedPositionIds.Remove(positionId);
        if (changed) await NotifyFilterChangedAsync();
    }

    private async Task OnSelectAllChangedAsync(ChangeEventArgs args)
    {
        if (!ParseCheckbox(args.Value) || selectedPositionIds.Count == 0) return;
        selectedPositionIds.Clear();
        await NotifyFilterChangedAsync();
    }

    private string GetSelectedPositionsLabel()
    {
        if (selectedPositionIds.Count == 0 || Positions.Count == 0) return "Todas as posições";
        var names = Positions.Where(p => selectedPositionIds.Contains(p.PositionId)).Select(p => p.Name).ToList();
        return names.Count == 0 ? "Todas as posições" : string.Join(", ", names);
    }

    private string GetDropdownMenuStyles()
    {
        var visibility = isDropdownOpen ? string.Empty : " display: none;";
        return $"max-height: 280px; overflow-y: auto; z-index: 1050;{visibility}";
    }

    private void ToggleDropdown() => isDropdownOpen = !isDropdownOpen;

    private void CloseDropdown() { if (isDropdownOpen) isDropdownOpen = false; }

    private void HandleKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") CloseDropdown(); }

    private static bool ParseCheckbox(object? value) => value switch
    {
        bool b => b,
        string s when bool.TryParse(s, out var parsed) => parsed,
        _ => false
    };
}
