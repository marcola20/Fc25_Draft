@using Fc25Draft.Core.DTOs
@inject EscudoService Escudos

@* A mesa do draft: quem está na vez (escudo grande), em que rodada e escolha, quem vem depois e o andamento. *@
<section class="mesa">
    @if (IsLoading)
    {
        <div class="mesa-vazia"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Carregando o draft</div>
    }
    else if (State is null || !State.HasDraft)
    {
        <div class="mesa-vazia">Nenhum draft configurado no momento</div>
    }
    else if (State.DraftCompleted)
    {
        <div class="mesa-corpo">
            <div class="mesa-vez">
                <span class="mesa-rotulo">Draft concluído</span>
                <span class="mesa-time">@State.TotalPicks escolhas feitas</span>
            </div>
        </div>
        <div class="mesa-andamento concluido" aria-hidden="true"><div style="width: 100%"></div></div>
    }
    else
    {
        <div class="mesa-corpo">
            @if (!string.IsNullOrWhiteSpace(State.CurrentTeamName))
            {
                <img src="@Escudos.GetEscudo(State.CurrentTeamName)" alt="" class="mesa-escudo" width="56" height="56" />
            }
            <div class="mesa-vez">
                <span class="mesa-rotulo">Na vez</span>
                <span class="mesa-time">@State.CurrentTeamName</span>
                @if (!string.IsNullOrWhiteSpace(State.CurrentTeamOwner))
                {
                    <span class="mesa-dono">@State.CurrentTeamOwner</span>
                }
            </div>
            <dl class="mesa-numeros">
                <div>
                    <dt>Rodada</dt>
                    <dd class="numero">@State.CurrentRound</dd>
                </div>
                <div>
                    <dt>Escolha na rodada</dt>
                    <dd class="numero">@State.CurrentPickInRound</dd>
                </div>
                <div>
                    <dt>Geral</dt>
                    <dd><span class="numero">@State.CurrentOverallPick</span><span class="mesa-de"> de @State.TotalPicks</span></dd>
                </div>
            </dl>
            @if (!string.IsNullOrEmpty(State.NextTeamName))
            {
                <div class="mesa-proximo">
                    <span class="mesa-rotulo">Depois</span>
                    <span class="mesa-proximo-time">
                        <img src="@Escudos.GetEscudo(State.NextTeamName)" alt="" width="20" height="20" />
                        @State.NextTeamName
                    </span>
                </div>
            }
        </div>
        <div class="mesa-andamento" role="progressbar" aria-label="Andamento do draft"
             aria-valuenow="@GetProgressValue()" aria-valuemin="0" aria-valuemax="100"><div style="width: @GetProgressWidth();"></div></div>
    }
</section>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public DraftStateDto? State { get; set; }

    private int GetProgressValue()
    {
        if (State is null || State.TotalPicks == 0) return 0;
        return (int)Math.Round((double)State.CompletedPicks * 100 / State.TotalPicks);
    }

    private string GetProgressWidth()
        => State is null || State.TotalPicks == 0 ? "0%" : $"{GetProgressValue()}%";
}
