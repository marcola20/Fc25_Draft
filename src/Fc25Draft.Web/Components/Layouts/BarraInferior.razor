@using Microsoft.AspNetCore.Components.Routing
@inject LayoutNavigationService Menu
@inject AbasEscondidas AbasEscondidas
@implements IDisposable

@* Atalhos fixos no rodapé do celular para as páginas mais usadas; some no computador (CSS). *@
<nav class="barra-inferior" aria-label="Atalhos">
    @foreach (var atalho in Atalhos.Where(a => !Menu.EstaEscondida(a.Href)))
    {
        <NavLink class="barra-inferior-item" href="@atalho.Href"
                 Match="@(atalho.Prefixo ? NavLinkMatch.Prefix : NavLinkMatch.All)">
            <Icone Nome="@atalho.Icone" Tamanho="18" />
            <span class="barra-inferior-texto">@atalho.Texto</span>
        </NavLink>
    }
</nav>

@code {
    // Atalho de página escondida em /admin/abas some também daqui (para todo mundo: é só atalho).
    protected override void OnInitialized() => AbasEscondidas.Mudou += AoMudar;

    private void AoMudar() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => AbasEscondidas.Mudou -= AoMudar;

    private sealed record Atalho(string Texto, string Href, string Icone, bool Prefixo = false);

    private static readonly Atalho[] Atalhos =
    [
        new("Início", "/home", "house"),
        new("Liga", "/liga", "list-ordered", Prefixo: true),
        new("Mercado", "/mercado", "gavel", Prefixo: true),
        new("Bolão", "/bolao", "target", Prefixo: true),
        new("Minha Área", "/minha-area", "user"),
    ];
}
