@using Microsoft.AspNetCore.Components

<header class="app-header" role="banner">
    <div class="app-header-main">
        <div class="app-header-brand">
            <button type="button" class="toggle-sidebar" @onclick="ToggleSidebar" aria-label="Alternar menu">
                <span class="oi oi-menu" aria-hidden="true"></span>
            </button>
            <div class="app-header-titles">
                @if (!string.IsNullOrWhiteSpace(HomeHref))
                {
                    <a class="app-header-title-link text-white text-decoration-none" href="@HomeHref" style="cursor: default;">@Title</a>
                }
                else
                {
                    <span class="app-header-title-text text-white">@Title</span>
                }

                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <span class="subtitle">@Subtitle</span>
                }
            </div>
        </div>

        <div class="app-header-controls">
            @if (Actions is not null)
            {
                <div class="app-header-actions">
                    @Actions
                </div>
            }

            <div class="app-header-status" role="status">
                <span class="status-label">@AccessLabel</span>
                @if (ShowAuthProgress)
                {
                    <span class="spinner-border spinner-border-sm text-light" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <div class="btn-group" role="group" aria-label="Controles de acesso">
                        @if (IsAdmin)
                        {
                            <button class="btn btn-sm btn-outline-light" @onclick="SignOut">Sair</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-light" @onclick="SignIn">Entrar como Admin</button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</header>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string AccessLabel { get; set; } = string.Empty;
    [Parameter] public bool ShowAuthProgress { get; set; }
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public string? HomeHref { get; set; }
    [Parameter] public EventCallback ToggleSidebar { get; set; }
    [Parameter] public EventCallback SignIn { get; set; }
    [Parameter] public EventCallback SignOut { get; set; }
}
