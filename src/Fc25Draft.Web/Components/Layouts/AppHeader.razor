@using Microsoft.AspNetCore.Components

<header class="app-header" role="banner">
    <div class="app-header-main">
        <div class="app-header-brand">
            <button type="button" class="toggle-sidebar" @onclick="ToggleSidebar" aria-label="Alternar menu">
                <Icone Nome="menu" Tamanho="18" />
            </button>
            <div class="app-header-titles">
                @if (!string.IsNullOrWhiteSpace(HomeHref))
                {
                    <a class="app-header-title-link" href="@HomeHref">@Title</a>
                }
                else
                {
                    <span class="app-header-title-text">@Title</span>
                }

                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <span class="subtitle">@Subtitle</span>
                }
            </div>
        </div>

        <div class="app-header-controls">
            @if (Actions is not null)
            {
                <div class="app-header-actions">
                    @Actions
                </div>
            }

            <BuscaGeral />
            <BotaoTema />
            <AvisosSino TeamId="@AvisosTeamId" />

            <div class="app-header-status" role="status">
                <span class="status-label">@AccessLabel</span>
                @if (ShowAuthProgress)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                else
                {
                    @if (IsAuthenticated)
                    {
                        <button type="button" class="btn-moldura" @onclick="SignOut">Sair</button>
                    }
                    else
                    {
                        <button type="button" class="btn-moldura" @onclick="SignIn">Entrar</button>
                    }
                }
            </div>
        </div>
    </div>
</header>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string AccessLabel { get; set; } = string.Empty;
    [Parameter] public bool ShowAuthProgress { get; set; }
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public bool IsAuthenticated { get; set; }
    [Parameter] public string? HomeHref { get; set; }
    [Parameter] public EventCallback ToggleSidebar { get; set; }
    [Parameter] public EventCallback SignIn { get; set; }
    [Parameter] public EventCallback SignOut { get; set; }

    /// <summary>Time de quem entrou, para o sino de avisos (nulo esconde o sino).</summary>
    [Parameter] public Guid? AvisosTeamId { get; set; }
}
