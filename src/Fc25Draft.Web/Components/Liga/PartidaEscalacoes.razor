@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Enums
@inject EscudoService Escudos

@* Formação dos dois times no jogo, com os lances de cada jogador. Nada enquanto carrega. *@
@if (Dados is not null)
{
    <div class="row g-3 escalacoes">
        @foreach (var time in new[] { Dados.Casa, Dados.Fora })
        {
            <div class="col-6">
                <div class="d-flex align-items-center gap-1 fw-bold mb-2 text-truncate">
                    <img src="@Escudos.GetEscudo(time.TimeNome)" alt="" width="20" height="20" style="object-fit:contain;flex-shrink:0" />
                    <span class="text-truncate">@time.TimeNome</span>
                </div>
                @if (time.Vazia)
                {
                    <div class="text-muted small">Escalação não registrada.</div>
                }
                else
                {
                    @Lista("Titulares", time.Jogadores.Where(j => j.Titular))
                    @Lista("Reservas", time.Jogadores.Where(j => !j.Titular))
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public PartidaEscalacoesDto? Dados { get; set; }

    private static string Min(int? minuto) => minuto.HasValue ? $" {minuto}'" : "";

    private RenderFragment Lista(string titulo, IEnumerable<PartidaEscalacaoJogadorDto> jogadores) => __builder =>
    {
        var lista = jogadores.ToList();
        if (lista.Count == 0) return;

        <div class="fw-bold mt-2 mb-1">@titulo</div>
        <ul class="list-unstyled mb-0">
            @foreach (var j in lista)
            {
                <li class="jogador">
                    <div class="d-flex align-items-center gap-1">
                        <span class="nome text-truncate">@j.JogadorNome</span>
                        <span class="lances">@Lances(j.JogadorId)</span>
                        @if (j.MelhorEmCampo)
                        {
                            <span title="Melhor em campo">⭐</span>
                        }
                        @if (j.Nota is decimal nota)
                        {
                            <span class="badge ms-auto @NotaPes.Cor(nota)" title="Nota do PES">@NotaPes.Texto(nota)</span>
                        }
                    </div>
                    @foreach (var sub in Subs(j.JogadorId))
                    {
                        <div class="sub small text-muted">@sub</div>
                    }
                </li>
            }
        </ul>
    };

    private RenderFragment Lances(int jogadorId) => __builder =>
    {
        foreach (var ev in Dados!.Eventos)
        {
            if (ev.Tipo == TipoEvento.Gol && ev.JogadorId == jogadorId)
            {
                <span title="Gol@(Min(ev.Minuto))">⚽</span>
            }
            else if (ev.Tipo == TipoEvento.GolContra && ev.JogadorId == jogadorId)
            {
                <span title="Gol contra@(Min(ev.Minuto))">⚽<sup class="text-danger fw-bold">GC</sup></span>
            }
            if (ev.Tipo == TipoEvento.Gol && ev.AssistenteId == jogadorId)
            {
                <span title="Assistência@(Min(ev.Minuto))">🎯</span>
            }
            if (ev.Tipo == TipoEvento.CartaoAmarelo && ev.JogadorId == jogadorId)
            {
                <span class="cartao amarelo" title="Cartão amarelo@(Min(ev.Minuto))"></span>
            }
            if (ev.Tipo == TipoEvento.CartaoVermelho && ev.JogadorId == jogadorId)
            {
                <span class="cartao vermelho" title="Cartão vermelho@(Min(ev.Minuto))"></span>
            }
            if (ev.Tipo == TipoEvento.Substituicao && ev.JogadorSaiuId == jogadorId)
            {
                <span class="seta-sai" title="Saiu@(Min(ev.Minuto))">▼</span>
            }
            if (ev.Tipo == TipoEvento.Substituicao && ev.JogadorId == jogadorId)
            {
                <span class="seta-entra" title="Entrou@(Min(ev.Minuto))">▲</span>
            }
        }
    };

    // Linha de apoio "quem entrou / quem saiu" embaixo do nome.
    private IEnumerable<string> Subs(int jogadorId)
    {
        foreach (var ev in Dados!.Eventos.Where(e => e.Tipo == TipoEvento.Substituicao))
        {
            if (ev.JogadorSaiuId == jogadorId)
                yield return $"▼{Min(ev.Minuto)} entrou {ev.JogadorNome}";
            else if (ev.JogadorId == jogadorId)
                yield return ev.JogadorSaiuNome is null
                    ? $"▲{Min(ev.Minuto)} entrou"
                    : $"▲{Min(ev.Minuto)} no lugar de {ev.JogadorSaiuNome}";
        }
    }
}
