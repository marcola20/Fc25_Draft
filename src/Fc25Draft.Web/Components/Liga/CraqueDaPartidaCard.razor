@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Utilities
@inject EscudoService Escudos

@* O craque do jogo encerrado: foto em pé, nota do PES, gols e assistências. Fica dentro do FimDeJogoCard,
   que põe o placar em cima e compartilha os dois juntos. Não aparece em jogo sem nota (sem importação do PES). *@
@if (_craque is { } c)
{
    <div class="craque">
        @* Foto como fundo, e não <img>: o html2canvas ignora object-fit e esticava a foto quadrada no retângulo.
           Fundo com background-size: cover ele desenha certo. Mesmo endereço do FotoJogador. *@
        <div class="foto" role="img" aria-label="@c.Jogador.JogadorNome"
             style="background-image: url('/fotos/jogadores/@c.Jogador.JogadorId')"></div>
        <div class="info">
            <div class="rotulo"><Icone Nome="star" Tamanho="14" /> Craque da partida</div>
            <div class="nome">@c.Jogador.JogadorNome</div>
            <div class="time">
                <img src="@Escudos.GetEscudo(c.TimeNome)" alt="" />
                <span>@c.TimeNome · @c.Jogador.Posicao</span>
            </div>
            <div class="numeros">
                @if (c.Jogador.Nota is decimal nota)
                {
                    <span class="nota badge @NotaPes.Cor(nota)" title="Nota do PES">@NotaPes.Texto(nota)</span>
                }
                @if (c.Gols > 0)
                {
                    <span><Icone Nome="goal" Tamanho="14" /> @c.Gols @(c.Gols == 1 ? "gol" : "gols")</span>
                }
                @if (c.Assistencias > 0)
                {
                    <span><Icone Nome="target" Tamanho="14" /> @c.Assistencias @(c.Assistencias == 1 ? "assistência" : "assistências")</span>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public PartidaEscalacoesDto? Escalacoes { get; set; }

    private CraqueDaPartidaInfo? _craque;

    protected override void OnParametersSet() =>
        _craque = Escalacoes is null ? null : CraqueDaPartida.Escolher(Escalacoes);
}
