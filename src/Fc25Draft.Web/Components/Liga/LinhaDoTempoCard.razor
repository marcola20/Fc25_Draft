@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Utilities
@inject EscudoService Escudos

@* A história da fase de pontos, da rodada mais recente para a primeira. Fato com jogo abre o jogo. *@
@if (_fatos.Count > 0)
{
    var grupos = _fatos.GroupBy(f => f.Rodada).OrderByDescending(g => g.Key).ToList();
    var visiveis = _tudo ? grupos : grupos.Take(RodadasIniciais).ToList();

    <div class="card mt-3 linha-do-tempo">
        <div class="card-header d-flex flex-wrap align-items-baseline gap-2">
            <strong>🗓️ Linha do tempo da temporada</strong>
            <span class="small text-muted">Os fatos que marcaram cada rodada</span>
        </div>
        <div class="card-body">
            <ol class="rodadas">
                @foreach (var grupo in visiveis)
                {
                    <li class="rodada">
                        <div class="marco">Rodada @grupo.Key</div>
                        <ul class="fatos">
                            @foreach (var fato in grupo)
                            {
                                var f = fato;
                                <li class="fato @(f.Jogo is null ? "" : "com-jogo")" @onclick="() => AbrirAsync(f)"
                                    title="@(f.Jogo is null ? null : "Ver o jogo")">
                                    <span class="icone" aria-hidden="true">@f.Icone</span>
                                    @if (f.TimeNome is not null)
                                    {
                                        <img src="@Escudos.GetEscudo(f.TimeNome)" alt="" width="18" height="18" />
                                    }
                                    <span class="texto">@f.Texto</span>
                                </li>
                            }
                        </ul>
                    </li>
                }
            </ol>
            @if (grupos.Count > RodadasIniciais)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _tudo = !_tudo">
                    @(_tudo ? "Mostrar só as últimas rodadas" : $"Ver a temporada inteira ({grupos.Count} rodadas)")
                </button>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<LigaRodadaComPartidasDto> Rodadas { get; set; } = [];
    /// <summary>A classificação já na ordem da tabela.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<LigaClassificacaoItemDto> Tabela { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyDictionary<Guid, IReadOnlyList<PosicaoNaRodada>> Posicoes { get; set; } = new Dictionary<Guid, IReadOnlyList<PosicaoNaRodada>>();
    [Parameter, EditorRequired] public LigaRegraZonas Regra { get; set; } = LigaRegraZonas.SoCampeao;
    [Parameter] public EventCallback<LigaPartidaDto> OnAbrir { get; set; }

    private const int RodadasIniciais = 5;

    private IReadOnlyList<FatoDaTemporada> _fatos = [];
    private object? _geradoDe;
    private bool _tudo;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_geradoDe, Posicoes)) return;
        _geradoDe = Posicoes;
        _fatos = LinhaDoTempoTemporada.Gerar(Rodadas, Tabela, Posicoes, Regra);
        _tudo = false;
    }

    private Task AbrirAsync(FatoDaTemporada f) => f.Jogo is { } jogo ? OnAbrir.InvokeAsync(jogo) : Task.CompletedTask;
}
