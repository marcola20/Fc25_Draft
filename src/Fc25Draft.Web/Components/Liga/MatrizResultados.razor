@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Enums
@inject EscudoService Escudos

@* Todos contra todos da fase de pontos: a linha é o mandante, a coluna o visitante, e a cor é o
   resultado do mandante. Tocar no placar abre o jogo. *@
@if (Tabela.Count > 1)
{
    <div class="card matriz">
        <div class="card-header d-flex flex-wrap align-items-baseline gap-2">
            <strong>🗂️ Matriz de resultados</strong>
            <span class="small text-muted">Linha = mandante · coluna = visitante. Toque no placar para ver o jogo.</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-bordered mb-0 text-center align-middle">
                    <thead>
                        <tr>
                            <th class="time canto text-start small text-muted fw-normal"><span class="d-none d-sm-inline">Casa ↓ · Fora →</span></th>
                            @foreach (var fora in Tabela)
                            {
                                <th class="coluna" title="@fora.TimeNome">
                                    <img src="@Escudos.GetEscudo(fora.TimeNome)" alt="@fora.TimeNome" width="20" height="20" />
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var casa in Tabela)
                        {
                            <tr>
                                <th class="time text-start text-nowrap">
                                    <img src="@Escudos.GetEscudo(casa.TimeNome)" alt="" width="18" height="18" />
                                    <span class="nome">@casa.TimeNome</span>
                                </th>
                                @foreach (var fora in Tabela)
                                {
                                    if (casa.TimeId == fora.TimeId)
                                    {
                                        <td class="diagonal"></td>
                                        continue;
                                    }
                                    <td class="celula">
                                        @foreach (var jogo in _jogos.GetValueOrDefault((casa.TimeId, fora.TimeId)) ?? [])
                                        {
                                            var j = jogo;
                                            <button type="button" class="placar @Classe(j)" title="@Dica(j)" @onclick="() => OnAbrir.InvokeAsync(j)">@Texto(j)</button>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex gap-3 flex-wrap small text-muted px-3 py-2">
                <span><span class="placar v legenda">2-1</span> Mandante venceu</span>
                <span><span class="placar e legenda">1-1</span> Empate</span>
                <span><span class="placar d legenda">0-1</span> Visitante venceu</span>
                <span><span class="placar ao-vivo legenda">1-0</span> Em andamento</span>
                <span><span class="placar a-jogar legenda">R5</span> A jogar (rodada)</span>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<LigaRodadaComPartidasDto> Rodadas { get; set; } = [];
    /// <summary>A classificação já na ordem da tabela: linhas e colunas seguem essa ordem.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<LigaClassificacaoItemDto> Tabela { get; set; } = [];
    [Parameter] public EventCallback<LigaPartidaDto> OnAbrir { get; set; }

    private Dictionary<(Guid Casa, Guid Fora), List<LigaPartidaDto>> _jogos = new();
    private object? _montadoDe;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_montadoDe, Rodadas)) return;
        _montadoDe = Rodadas;

        // Só a fase de pontos: mini liga, decisão do título e jogo decisivo ficam de fora.
        _jogos = Rodadas
            .Where(r => r.Numero > 0 && !r.Desempate)
            .OrderBy(r => r.Numero)
            .SelectMany(r => r.Partidas)
            .GroupBy(p => (p.TimeCasaId, p.TimeForaId))
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private static string Classe(LigaPartidaDto j) => j.Status switch
    {
        PartidaStatus.Agendada => "a-jogar",
        PartidaStatus.EmAndamento => "ao-vivo",
        _ => j.GolsCasa > j.GolsFora ? "v" : j.GolsCasa < j.GolsFora ? "d" : "e"
    };

    private static string Texto(LigaPartidaDto j) =>
        j.Status == PartidaStatus.Agendada ? $"R{j.RodadaNumero}" : $"{j.GolsCasa}-{j.GolsFora}";

    private static string Dica(LigaPartidaDto j) => j.Status switch
    {
        PartidaStatus.Agendada => $"{j.TimeCasaNome} x {j.TimeForaNome} · rodada {j.RodadaNumero} · a jogar",
        PartidaStatus.EmAndamento => $"{j.TimeCasaNome} {j.GolsCasa} x {j.GolsFora} {j.TimeForaNome} · rodada {j.RodadaNumero} · em andamento",
        _ => $"{j.TimeCasaNome} {j.GolsCasa} x {j.GolsFora} {j.TimeForaNome} · rodada {j.RodadaNumero}{(j.IsWO ? " · WO" : "")}"
    };
}
