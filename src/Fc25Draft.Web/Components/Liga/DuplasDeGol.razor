@using Fc25Draft.Core.DTOs
@inject EscudoService Escudos

@* Duplas que mais combinaram em gol (assistência de um, gol do outro, nos dois sentidos). Clicar abre os gols. *@
@if (Duplas.Count == 0)
{
    <div class="text-muted">Nenhum gol com assistência registrado.</div>
    return;
}

<div class="d-flex flex-wrap align-items-center gap-3 mb-2 small text-muted">
    <span>Gols em que um deu a assistência e o outro marcou. Clique na dupla para ver os gols.</span>
    <div class="form-check mb-0">
        <input class="form-check-input" type="checkbox" id="todasDuplas" @bind="_todas" />
        <label class="form-check-label" for="todasDuplas">Mostrar todas (sem o mínimo de @Minimo gols)</label>
    </div>
</div>

@if (!Visiveis.Any())
{
    <div class="text-muted small">Nenhuma dupla com @Minimo gols ou mais ainda.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle" style="font-size:0.875rem;">
            <thead class="table-dark">
                <tr>
                    <th style="width:35px;">#</th>
                    <th>Dupla</th>
                    <th class="d-none d-md-table-cell">Time</th>
                    <th class="text-center" style="width:70px;">Gols</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (d, i) in Visiveis.Select((d, i) => (d, i)))
                {
                    var chave = (d.JogadorAId, d.JogadorBId);
                    <tr style="cursor:pointer;" title="Ver os gols" @onclick="() => _aberta = _aberta == chave ? null : chave">
                        <td class="fw-bold text-muted">@(i + 1)</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="d-flex flex-shrink-0">
                                    <FotoJogador PlayerId="@d.JogadorAId" Tamanho="28" />
                                    <span style="margin-left:-10px;"><FotoJogador PlayerId="@d.JogadorBId" Tamanho="28" /></span>
                                </div>
                                <div class="min-w-0">
                                    <div class="text-truncate">
                                        <a href="/players/details/@d.JogadorAId" class="text-body">@d.JogadorANome</a>
                                        <span class="text-muted">&amp;</span>
                                        <a href="/players/details/@d.JogadorBId" class="text-body">@d.JogadorBNome</a>
                                    </div>
                                    <div class="small text-muted text-truncate">@Sentidos(d)</div>
                                </div>
                            </div>
                        </td>
                        <td class="d-none d-md-table-cell text-muted small text-nowrap">
                            <img src="@Escudos.GetEscudo(d.TimeNome)" alt="" width="18" height="18" class="me-1" style="object-fit:contain" />
                            @d.TimeNome
                        </td>
                        <td class="text-center fw-bold text-nowrap">@d.Total <span class="text-muted small fw-normal">@(_aberta == chave ? "▴" : "▾")</span></td>
                    </tr>
                    @if (_aberta == chave)
                    {
                        <tr>
                            <td colspan="4" class="p-0 border-0">
                                <ul class="list-group list-group-flush small border-bottom">
                                    @foreach (var g in d.Gols)
                                    {
                                        var (autor, garcom) = g.DeAParaB ? (d.JogadorBNome, d.JogadorANome) : (d.JogadorANome, d.JogadorBNome);
                                        <li class="list-group-item d-flex flex-wrap gap-2 align-items-center ps-5">
                                            <span class="text-muted" style="min-width:90px;">@(MostrarCompeticao ? $"{g.Jogo.Competicao} · " : "")@g.Jogo.Rotulo</span>
                                            <span>@g.Jogo.CasaNome <strong>@g.Jogo.GolsCasa x @g.Jogo.GolsFora</strong> @g.Jogo.ForaNome</span>
                                            <span class="text-muted">⚽ @autor <span class="small">(assist. @garcom)</span>@(g.Minuto is int m ? $" {m}'" : "")</span>
                                        </li>
                                    }
                                </ul>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<DuplaDto> Duplas { get; set; } = Array.Empty<DuplaDto>();

    /// <summary>No histórico os gols vêm de várias competições: o nome dela entra antes da rodada.</summary>
    [Parameter] public bool MostrarCompeticao { get; set; }

    private const int Minimo = 2;
    private bool _todas;
    private (int, int)? _aberta;

    private IEnumerable<DuplaDto> Visiveis => _todas ? Duplas : Duplas.Where(d => d.Total >= Minimo);

    /// <summary>"Alex → Shevchenko 3 · Shevchenko → Alex 1", sem o sentido que não aconteceu.</summary>
    private static string Sentidos(DuplaDto d) => string.Join(" · ", new[]
        {
            (d.AParaB, $"{d.JogadorANome} → {d.JogadorBNome}"),
            (d.BParaA, $"{d.JogadorBNome} → {d.JogadorANome}")
        }
        .Where(x => x.Item1 > 0)
        .Select(x => $"{x.Item2} {x.Item1}"));
}
