@using Fc25Draft.Core.Utilities

@* O campinho do esquema favorito, em SVG: escala com a largura e fica igual no tema claro e no escuro. *@
@if (EsquemasTaticos.Achar(Esquema) is { } e)
{
    <svg class="campinho @Classe" viewBox="0 0 100 130" role="img" aria-label="Esquema @e.Nome"
         style="width: @(Largura)px; height: @(Largura * 1.3)px;">
        <rect x="1" y="1" width="98" height="128" rx="4" class="gramado" />
        <g class="linhas">
            <rect x="4" y="4" width="92" height="122" rx="2" />
            <line x1="4" y1="65" x2="96" y2="65" />
            <circle cx="50" cy="65" r="11" />
            <rect x="27" y="4" width="46" height="17" />
            <rect x="27" y="109" width="46" height="17" />
        </g>
        @foreach (var p in e.Posicoes)
        {
            // Y do esquema: 0 é o ataque e 100 o próprio gol; o campinho tem 130 de altura útil.
            var y = 6 + p.Y * 1.18;
            <circle cx="@F(p.X)" cy="@F(y)" r="@(Siglas ? "5.2" : "4.2")" class="jogador @(p.Sigla == "GOL" ? "goleiro" : "")" />
            @if (Siglas)
            {
                @Texto(p.X, y + 1.6, p.Sigla, "3.4px", "#0a3622")
            }
        }
        @if (MostrarNome)
        {
            @Texto(50, 62, e.Nome, "7px", "rgba(255,255,255,.35)")
        }
    </svg>
}

@code {
    /// <summary>Nome do esquema da lista fixa ("4-3-3"); fora da lista, não desenha nada.</summary>
    [Parameter] public string? Esquema { get; set; }

    [Parameter] public int Largura { get; set; } = 90;

    /// <summary>Escreve a sigla de cada posição (fica bom de 120 px para cima).</summary>
    [Parameter] public bool Siglas { get; set; }

    [Parameter] public bool MostrarNome { get; set; }

    [Parameter] public string? Classe { get; set; }

    // O Razor não deixa escrever a tag <text> do SVG com atributos; os textos vêm de lista fixa (siglas e
    // nomes de esquema), então podem ir como marcação pronta.
    private static MarkupString Texto(double x, double y, string conteudo, string tamanho, string cor) =>
        new($"<text x=\"{F(x)}\" y=\"{F(y)}\" font-size=\"{tamanho}\" font-weight=\"700\" fill=\"{cor}\" text-anchor=\"middle\">{System.Net.WebUtility.HtmlEncode(conteudo)}</text>");

    private static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
