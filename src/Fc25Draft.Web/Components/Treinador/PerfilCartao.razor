@* Uma pessoa com o perfil inteiro: foto, nome e apelido, papel, frase e o campinho do esquema favorito.
   Usado na comissão técnica do clube e na carreira (e, quando existir, na coletiva). *@
<div class="perfil-cartao">
    <FotoTreinador TreinadorId="@Perfil.TreinadorId" Tamanho="@TamanhoFoto" Versao="@Perfil.VersaoFoto" Alt="@Perfil.Nome" />
    <div class="perfil-texto">
        <div class="d-flex flex-wrap align-items-baseline gap-2">
            @if (Link)
            {
                <a href="/treinadores/@Perfil.TreinadorId" class="text-reset fw-semibold text-decoration-none"><NomeTreinador Perfil="@Perfil" Completo="true" /></a>
            }
            else
            {
                <span class="fw-semibold"><NomeTreinador Perfil="@Perfil" Completo="true" /></span>
            }
            @if (Papel is not null)
            {
                <span class="badge @(Papel == PapelTreinador.Auxiliar ? "text-bg-info" : "text-bg-primary")">@(Papel == PapelTreinador.Auxiliar ? "Auxiliar" : "Técnico")</span>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Perfil.Frase))
        {
            <div class="frase">“@Perfil.Frase”</div>
        }
        @if (Perfil.Esquema is not null)
        {
            <div class="small text-muted">Esquema favorito: <strong>@Perfil.Esquema</strong></div>
        }
    </div>
    <CampinhoEsquema Esquema="@Perfil.Esquema" Largura="@LarguraCampinho" />
</div>

@code {
    [Parameter, EditorRequired] public PerfilTreinadorDto Perfil { get; set; } = null!;
    [Parameter] public PapelTreinador? Papel { get; set; }
    [Parameter] public bool Link { get; set; } = true;
    [Parameter] public int TamanhoFoto { get; set; } = 64;
    [Parameter] public int LarguraCampinho { get; set; } = 56;
}
