@using System.Collections.Generic
@using System.Linq
@using Fc25Draft.Web.Models.Transfers

@if (Visible)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0, 0, 0, 0.5);" @onclick="OnBackdropClicked">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Title</h5>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="OnCancelClicked" disabled="@IsBusy"></button>
                </div>
                <EditForm EditContext="_editContext" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                        {
                            <div class="alert alert-danger" role="alert">@ErrorMessage</div>
                        }

                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Jogador alvo</label>
                            <div>
                                <span class="fw-semibold">@(_model.TargetPlayerName ?? "-" )</span>
                                <small class="text-muted ms-2">ID: @_model.TargetPlayerId</small>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="cashInput">Valor em dinheiro</label>
                                <InputNumber @bind-Value="_model.Cash" id="cashInput" class="form-control" step="0.5" disabled="@IsBusy" />
                                <div class="form-text">Informe o valor em dinheiro ofertado (opcional).</div>
                                <ValidationMessage For="() => _model.Cash" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="sellOnInput">Sell-on (%)</label>
                                <InputNumber @bind-Value="_model.SellOnPercentage" id="sellOnInput" class="form-control" step="0.5" disabled="@IsBusy" />
                                <div class="form-text">Percentual de revenda futura (opcional).</div>
                                <ValidationMessage For="() => _model.SellOnPercentage" />
                            </div>
                        </div>

                        <div class="mt-3">
                            <label class="form-label">Jogadores para troca</label>
                            @if (SwapCandidates?.Any() == true)
                            {
                                <div class="list-group">
                                    @foreach (var candidate in SwapCandidates)
                                    {
                                        var isChecked = _model.SwapPlayerIds.Contains(candidate.PlayerId);
                                        <label class="list-group-item list-group-item-action d-flex align-items-start gap-3">
                                            <input class="form-check-input mt-1" type="checkbox" checked="@isChecked" disabled="@IsBusy" @onchange="args => OnSwapPlayerChanged(candidate.PlayerId, args)" />
                                            <div>
                                                <div class="fw-semibold">@candidate.Nome <small class="text-muted">(@candidate.Posicao)</small></div>
                                                <div class="text-muted small">OVR: @candidate.Overall</div>
                                            </div>
                                        </label>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted mb-0">Nenhum jogador disponível para incluir na troca.</p>
                            }
                        </div>

                        <div class="mt-3">
                            <label class="form-label" for="messageInput">Mensagem para o outro time</label>
                            <InputTextArea id="messageInput" class="form-control" rows="3" @bind-Value="_model.Message" disabled="@IsBusy" />
                            <ValidationMessage For="() => _model.Message" />
                        </div>

                        <div class="mt-3">
                            <label class="form-label" for="tokenInput">Token do time emissor</label>
                            <InputText id="tokenInput" class="form-control" @bind-Value="_model.TeamToken" disabled="@IsBusy" />
                            <ValidationMessage For="() => _model.TeamToken" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="OnCancelClicked" disabled="@IsBusy">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@IsBusy">Enviar proposta</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private OfferEditorModel _model = new();
    private EditContext? _editContext;

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public string Title { get; set; } = "Nova proposta";

    [Parameter]
    public OfferEditorModel Model { get; set; } = new();

    [Parameter]
    public IReadOnlyList<TeamRosterPlayerDto> SwapCandidates { get; set; } = Array.Empty<TeamRosterPlayerDto>();

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback<OfferEditorModel> OnSubmit { get; set; }

    protected override void OnParametersSet()
    {
        var model = Model ?? new OfferEditorModel();
        if (!ReferenceEquals(_model, model))
        {
            _model = model;
            _editContext = new EditContext(_model);
        }

        _editContext ??= new EditContext(_model);
    }

    private async Task HandleValidSubmit()
    {
        if (OnSubmit.HasDelegate)
        {
            var payload = new OfferEditorModel
            {
                TeamToken = _model.TeamToken?.Trim(),
                Cash = _model.Cash,
                SellOnPercentage = _model.SellOnPercentage,
                Message = string.IsNullOrWhiteSpace(_model.Message) ? null : _model.Message.Trim(),
                TargetPlayerId = _model.TargetPlayerId,
                TargetPlayerGuid = _model.TargetPlayerGuid,
                TargetPlayerName = _model.TargetPlayerName,
                SwapPlayerIds = new HashSet<int>(_model.SwapPlayerIds)
            };

            await OnSubmit.InvokeAsync(payload);
        }
    }

    private async Task OnCancelClicked()
    {
        if (IsBusy)
        {
            return;
        }

        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }

    private async Task OnBackdropClicked()
    {
        if (IsBusy)
        {
            return;
        }

        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }

    private void OnSwapPlayerChanged(int playerId, ChangeEventArgs args)
    {
        if (_model is null)
        {
            return;
        }

        var isChecked = args.Value switch
        {
            bool b => b,
            string s when bool.TryParse(s, out var parsed) => parsed,
            _ => false
        };

        if (isChecked)
        {
            _model.SwapPlayerIds.Add(playerId);
        }
        else
        {
            _model.SwapPlayerIds.Remove(playerId);
        }
    }
}
