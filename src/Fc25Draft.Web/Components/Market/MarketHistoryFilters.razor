@using System.Linq
@using Fc25Draft.Core.Enums
@using Fc25Draft.Core.Extensions
@using Fc25Draft.Web.Models.Market
@using Fc25Draft.Web.Utilities

<EditForm Model="Model" OnSubmit="HandleSubmitAsync">
    <div class="bg-light border rounded p-3">
        <div class="row g-3 g-xl-2 align-items-end">
            <div class="col-12 col-sm-6 col-lg-3 col-xxl-2">
                <label class="form-label" for="history-cycle">Ciclo</label>
                <input id="history-cycle"
                       class="form-control form-control-sm"
                       @bind-value="_cycleIdInput"
                       @bind-value:event="oninput"
                       placeholder="GUID do ciclo"
                       autocomplete="off" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3 col-xxl-2">
                <label class="form-label" for="history-item">Item</label>
                <input id="history-item"
                       class="form-control form-control-sm"
                       @bind-value="_itemIdInput"
                       @bind-value:event="oninput"
                       placeholder="GUID do item"
                       autocomplete="off" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3 col-xxl-2">
                <label class="form-label" for="history-player">Jogador</label>
                <InputText id="history-player"
                           class="form-control form-control-sm"
                           @bind-Value="Model.PlayerName"
                           placeholder="Nome ou parte do nome" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3 col-xxl-2">
                <label class="form-label" for="history-team">Time</label>
                <InputText id="history-team"
                           class="form-control form-control-sm"
                           @bind-Value="Model.TeamName"
                           placeholder="Nome do time" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3 col-xxl-2">
                <label class="form-label" for="history-type">Tipo</label>
                <InputSelect id="history-type"
                             class="form-select form-select-sm"
                             @bind-Value="Model.Type"
                             TValue="MarketTransactionType?">
                    <option value="">Todos</option>
                    @foreach (var option in TypeOptions)
                    {
                        <option value="@option.Type">@option.Label</option>
                    }
                </InputSelect>
            </div>
            <div class="col-12 col-sm-6 col-lg-4 col-xxl-3">
                <label class="form-label" for="history-from">Início do período</label>
                <input id="history-from"
                       type="datetime-local"
                       class="@GetInputClass(_fromError)"
                       @bind-value="_fromInput"
                       @bind-value:event="oninput"
                       step="60"
                       aria-describedby="history-from-help"
                       autocomplete="off" />
                @if (!string.IsNullOrEmpty(_fromError))
                {
                    <div class="invalid-feedback d-block">@_fromError</div>
                }
            </div>
            <div class="col-12 col-sm-6 col-lg-4 col-xxl-3">
                <label class="form-label" for="history-to">Fim do período</label>
                <input id="history-to"
                       type="datetime-local"
                       class="@GetInputClass(_toError)"
                       @bind-value="_toInput"
                       @bind-value:event="oninput"
                       step="60"
                       autocomplete="off" />
                @if (!string.IsNullOrEmpty(_toError))
                {
                    <div class="invalid-feedback d-block">@_toError</div>
                }
            </div>

            @if (ShowAdminFields)
            {
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label" for="history-target-team">Time destino</label>
                    <InputText id="history-target-team"
                               class="form-control form-control-sm"
                               @bind-Value="Model.TargetTeamName"
                               placeholder="Nome do time destino" />
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label" for="history-performed">Responsável</label>
                    <InputText id="history-performed"
                               class="form-control form-control-sm"
                               @bind-Value="Model.PerformedBy"
                               placeholder="Usuário ou sistema" />
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(_generalError))
        {
            <div class="alert alert-warning mt-3" role="alert">@_generalError</div>
        }

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="submit" class="btn btn-primary btn-sm" disabled="@IsLoading">Aplicar filtros</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="HandleResetAsync" disabled="@IsLoading">Limpar</button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public MarketHistoryQueryOptions Model { get; set; } = default!;

    [Parameter]
    public EventCallback OnApply { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }

    [Parameter]
    public bool ShowAdminFields { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    private static readonly IReadOnlyList<(MarketTransactionType Type, string Label)> TypeOptions = Enum
        .GetValues<MarketTransactionType>()
        .Select(type => (type, type.ToDisplayName()))
        .ToArray();

    private int _initialPageSize;
    private string _itemIdInput = string.Empty;
    private string _cycleIdInput = string.Empty;
    private DateTime? _fromInput;
    private DateTime? _toInput;
    private string? _fromError;
    private string? _toError;
    private string? _generalError;
    private Guid? _lastAppliedItemId;
    private Guid? _lastAppliedCycleId;
    private DateTime? _lastAppliedFromUtc;
    private DateTime? _lastAppliedToUtc;

    protected override void OnParametersSet()
    {
        if (_initialPageSize == 0 && Model is not null)
        {
            _initialPageSize = Model.PageSize > 0 ? Model.PageSize : 25;
        }

        if (Model is null)
        {
            return;
        }

        if (_lastAppliedItemId != Model.ItemId)
        {
            _lastAppliedItemId = Model.ItemId;
            _itemIdInput = Model.ItemId.HasValue && Model.ItemId.Value != Guid.Empty
                ? Model.ItemId.Value.ToString()
                : string.Empty;
        }

        if (_lastAppliedCycleId != Model.CycleId)
        {
            _lastAppliedCycleId = Model.CycleId;
            _cycleIdInput = Model.CycleId.HasValue && Model.CycleId.Value != Guid.Empty
                ? Model.CycleId.Value.ToString()
                : string.Empty;
        }

        if (_lastAppliedFromUtc != Model.FromUtc)
        {
            _lastAppliedFromUtc = Model.FromUtc;
            _fromInput = Model.FromUtc.HasValue
                ? BrazilTime.ConvertFromUtc(Model.FromUtc.Value)
                : (DateTime?)null;
        }

        if (_lastAppliedToUtc != Model.ToUtc)
        {
            _lastAppliedToUtc = Model.ToUtc;
            _toInput = Model.ToUtc.HasValue
                ? BrazilTime.ConvertFromUtc(Model.ToUtc.Value)
                : (DateTime?)null;
        }
    }

    private async Task HandleSubmitAsync(EditContext context)
    {
        if (Model is null)
        {
            return;
        }

        _fromError = null;
        _toError = null;
        _generalError = null;

        DateTime? fromUtc = null;
        DateTime? toUtc = null;

        if (_fromInput.HasValue)
        {
            if (_fromInput.HasValue && BrazilTime.TryParseDateTime(_fromInput.Value.ToString("yyyy-MM-ddTHH:mm"), out var parsedFrom))
                fromUtc = parsedFrom;
            else
                _fromError = "Formato inválido. Use AAAA-MM-DDTHH:MM.";
        }

        if (_toInput.HasValue)
        {
            if (_toInput.HasValue && BrazilTime.TryParseDateTime(_toInput.Value.ToString("yyyy-MM-ddTHH:mm"), out var parsedTo))
                toUtc = parsedTo;
            else
                _toError = "Formato inválido. Use AAAA-MM-DDTHH:MM.";
        }

        if (_fromError is not null || _toError is not null)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (fromUtc.HasValue && toUtc.HasValue && fromUtc.Value > toUtc.Value)
        {
            _generalError = "A data final deve ser igual ou posterior à data inicial.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        Model.CycleId = Guid.TryParse(_cycleIdInput, out var parsedCycle) ? parsedCycle : null;
        Model.ItemId = Guid.TryParse(_itemIdInput, out var parsedItem) ? parsedItem : null;
        Model.FromUtc = fromUtc;
        Model.ToUtc = toUtc;
        Model.Page = 1;

        if (OnApply.HasDelegate)
        {
            await OnApply.InvokeAsync();
        }
        else
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleResetAsync()
    {
        if (Model is null)
        {
            return;
        }

        Model.CycleId = null;
        Model.ItemId = null;
        Model.TeamId = null;
        Model.PlayerId = null;
        Model.PlayerName = null;
        Model.TeamName = null;
        Model.TargetTeamName = null;
        Model.Type = null;
        Model.PerformedBy = null;
        Model.FromUtc = null;
        Model.ToUtc = null;
        Model.Page = 1;
        Model.PageSize = _initialPageSize > 0 ? _initialPageSize : 25;

        _itemIdInput = string.Empty;
        _cycleIdInput = string.Empty;
        _fromInput = null;
        _toInput = null;
        _fromError = null;
        _toError = null;
        _generalError = null;
        _lastAppliedItemId = null;
        _lastAppliedCycleId = null;
        _lastAppliedFromUtc = null;
        _lastAppliedToUtc = null;

        if (OnReset.HasDelegate)
        {
            await OnReset.InvokeAsync();
        }
        else if (OnApply.HasDelegate)
        {
            await OnApply.InvokeAsync();
        }
    }

    private static string GetInputClass(string? error)
        => string.IsNullOrEmpty(error) ? "form-control form-control-sm" : "form-control form-control-sm is-invalid";
}
