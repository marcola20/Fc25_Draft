@using System
@using System.Globalization
@using System.Threading
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using BidRequest = Fc25Draft.Core.DTOs.BidRequest
@using BuyNowRequest = Fc25Draft.Core.DTOs.BuyNowRequest
@using CoreItemVm = Fc25Draft.Core.DTOs.MarketItemVm
@using Fc25Draft.Core.Extensions
@using Fc25Draft.Web.Services
@using Fc25Draft.Web.Utilities
@using System.Reflection
@inject Fc25Draft.Web.Services.MarketClient Client
@inject ILogger<MarketItemCard> Logger
@implements IAsyncDisposable

<div class="card h-100 border-0 shadow-sm">
    <div class="card-body d-flex flex-column gap-3">
        <div class="d-flex justify-content-between flex-wrap gap-2 align-items-start">
            <div>
                <h3 class="h5 mb-1">@Item.PlayerName</h3>

                <div class="d-flex gap-2">
                    <span class="badge bg-primary">@Item.PositionId.ToPositionName()</span>
                    <span class="badge bg-secondary">OVR @Item.Overall</span>
                </div>
            </div>

            <span class="badge @StatusBadgeClass">@StatusDisplay</span>
        </div>

        <div class="d-flex flex-wrap gap-3 justify-content-between align-items-start">
            @if (ShowBuyNowSummary)
            {
                <div class="d-flex flex-column gap-2">
                    <div class="text-muted small">Adquirido por</div>
                    <div>
                        <div class="fw-semibold text-body">@FormatCurrency(Item.BuyNowPrice!.Value)</div>
                    </div>
                    <div class="small text-muted">
                        pelo @((MarkupString)$"<strong>{BuyNowWinnerDisplay}</strong>")
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    <div>
                        <div class="text-muted small">Líder atual</div>
                        @if (Item.CurrentLeaderAmount.HasValue)
                        {
                            <div class="fw-semibold text-body">@FormatCurrency(Item.CurrentLeaderAmount.Value)</div>
                            @if (!string.IsNullOrWhiteSpace(Item.CurrentLeaderTeamName))
                            {
                                <div class="small text-muted">por @Item.CurrentLeaderTeamName</div>
                            }
                        }
                        else
                        {
                            <div class="fw-semibold text-body">Nenhum lance ainda</div>
                            <div class="small text-muted">Seja o primeiro a dar um lance.</div>
                        }
                    </div>
                    <div>
                        <div class="text-muted small" title="@MinIncrementTooltip">Lance mínimo</div>
                        <div class="fw-semibold text-body">@FormatCurrency(Item.RequiredMinBid)</div>
                    </div>
                    @if (CanBuyNow)
                    {
                        <div>
                            <div class="text-muted small">Comprar agora</div>
                            <div class="fw-semibold text-body">@FormatCurrency(Item.BuyNowPrice!.Value)</div>
                        </div>
                    }
                </div>
            }
            <div class="text-end" aria-live="polite">
                @if (IsSold)
                {
                    <span class="badge bg-danger">(Vendido)</span>
                }
                else if (IsExpired)
                {
                    <span class="badge bg-secondary">Encerrado</span>
                }
                else
                {
                    <span class="fw-semibold">Tempo restante: @CountdownText</span>
                }
            </div>
        </div>

        @if (!ShowBuyNowSummary)
        {
            <EditForm EditContext="_editContext" OnValidSubmit="HandleBidSubmitAsync">
                <div class="mb-2">
                    <label class="form-label" for="@BidInputId">Valor do lance</label>
                    <div class="input-group input-group-sm">
                        <InputText @key="Item.ItemId"
                                   @bind-Value="_model.AmountText"
                                   @bind-Value:event="@oninput"
                                   class="form-control me-2"
                                   id="@BidInputId"
                                   inputmode="decimal"
                                   placeholder="Ex.: R$ 30.000.000,00"
                                   @onfocus="BeginEditing"
                                   @onblur="EndEditing" />
                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@IsBidDisabled"
                                title="@LeaderTooltip">
                            Dar lance
                        </button>
                    </div>
                </div>
            </EditForm>

            @if (CanBuyNow)
            {
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="text-muted small">Comprar agora por @FormatCurrency(Item.BuyNowPrice!.Value)</span>
                        <button type="button"
                                class="btn btn-outline-success btn-sm ms-auto"
                                disabled="@IsBuyNowDisabled"
                                @onclick="ShowBuyNowConfirm">
                            Comprar agora
                        </button>
                    </div>

                    @if (_showBuyConfirm)
                    {
                        <div class="alert alert-warning py-2 mb-0" role="alert">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="me-auto">Confirmar compra imediata?</span>
                                <button type="button"
                                        class="btn btn-warning btn-sm"
                                        disabled="@_isSubmitting"
                                        @onclick="ConfirmBuyNowAsync">
                                    Confirmar
                                </button>
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm"
                                        disabled="@_isSubmitting"
                                        @onclick="CancelBuyNow">
                                    Cancelar
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        @if (!string.IsNullOrEmpty(_infoMessage))
        {
            <div class="alert alert-info mb-0" role="status">@_infoMessage</div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger mb-0" role="alert">@_errorMessage</div>
        }
    </div>
</div>

@code {
    [Parameter]
    public CoreItemVm Item { get; set; } = default!;

    [Parameter]
    public Guid? CurrentTeamId { get; set; }

    [Parameter]
    public TimeSpan ServerTimeOffset { get; set; }

    [Parameter]
    public EventCallback<CoreItemVm> OnBidPlaced { get; set; }

    [Parameter]
    public EventCallback<CoreItemVm> OnBought { get; set; }

    [Parameter]
    public EventCallback OnTeamTokenMissing { get; set; }

    [Parameter]
    public EventCallback<Guid> OnEditStart { get; set; }

    [Parameter]
    public EventCallback<Guid> OnEditEnd { get; set; }

    private readonly BidFormModel _model = new();
    private EditContext? _editContext;
    private ValidationMessageStore? _validationMessageStore;
    private CancellationTokenSource? _lifetimeCts;
    private CancellationTokenSource? _submitCts;
    private CancellationTokenSource? _timerCts;
    private PeriodicTimer? _timer;
    private static readonly Func<PeriodicTimer, ValueTask>? _disposeTimerDelegate = CreateDisposeTimerDelegate();
    private static readonly CultureInfo CurrencyCulture = CultureInfo.GetCultureInfo("pt-BR");
    private Task? _timerTask;
    private bool _isSubmitting;
    private bool _showBuyConfirm;
    private string? _infoMessage;
    private string? _errorMessage;
    private bool _isEditing;
    private Guid _itemId;
    private bool _allowRenderWhileEditing;

    private string BidInputId => $"bid-amount-{Item.ItemId}";

    private bool IsExpired => Remaining <= TimeSpan.Zero;

    private bool IsBidDisabled => _isSubmitting || IsExpired || !Item.IsActive || !_model.ParsedAmount.HasValue || IsCurrentTeamLeader;
    private bool IsBuyNowDisabled => _isSubmitting || IsExpired || !Item.IsActive;

    private bool CanBuyNow => Item.IsActive && Item.BuyNowPrice.HasValue;

    private bool IsCurrentTeamLeader => CurrentTeamId.HasValue && Item.CurrentLeaderTeamId.HasValue && Item.CurrentLeaderTeamId.Value == CurrentTeamId.Value;

    private string? LeaderTooltip => IsCurrentTeamLeader ? "Seu time já é o líder do lance atual." : null;

    private string? MinIncrementTooltip => Item.MinIncrement > 0m ? $"Incremento mínimo: {FormatCurrency(Item.MinIncrement)}" : null;

    private bool ShowBuyNowSummary => !Item.IsActive
        && Item.BuyNowPrice.HasValue
        && Item.CurrentLeaderAmount.HasValue
        && AreAmountsEqual(Item.CurrentLeaderAmount.Value, Item.BuyNowPrice.Value);

    private string BuyNowWinnerDisplay => !string.IsNullOrWhiteSpace(Item.CurrentLeaderTeamName)
        ? Item.CurrentLeaderTeamName!
        : Item.CurrentLeaderTeamId?.ToString() ?? "Time desconhecido";

    private string StatusDisplay => IsExpired ? "Encerrado" : TranslateStatus(Item.Status);

    private string StatusBadgeClass
    {
        get
        {
            var rawStatus = IsExpired ? "encerrado" : Item.Status ?? string.Empty;
            var status = rawStatus.ToLowerInvariant();
            return status switch
            {
                "active" or "published" or "ativo" or "publicado" => "bg-success",
                "sold" or "settled" or "vendido" or "finalizado" => "bg-danger",
                "closed" or "encerrado" => "bg-secondary",
                "canceled" or "cancelled" or "cancelado" => "bg-secondary",
                _ => "bg-secondary"
            };
        }
    }

    private bool IsSold => IsSoldStatus(Item.Status);

    private TimeSpan Remaining
    {
        get
        {
            if (!Item.IsActive)
            {
                return TimeSpan.Zero;
            }

            var remaining = Item.ExpiresAtUtc - (DateTime.UtcNow + ServerTimeOffset);
            return remaining < TimeSpan.Zero ? TimeSpan.Zero : remaining;
        }
    }

    private string CountdownText
    {
        get
        {
            var remaining = Remaining;
            return string.Format(CultureInfo.InvariantCulture, "{0:D2}:{1:D2}:{2:D2}", remaining.Hours + (remaining.Days * 24), remaining.Minutes, remaining.Seconds);
        }
    }

    protected override void OnInitialized()
    {
        if (Item is null)
        {
            throw new InvalidOperationException("Item parameter is required.");
        }

        _itemId = Item.ItemId;
        _model.AmountText = string.Empty;
        _model.ParsedAmount = null;
        _lifetimeCts = new CancellationTokenSource();
        _editContext = new EditContext(_model);
        _validationMessageStore = new ValidationMessageStore(_editContext);
        _editContext.OnValidationRequested += HandleValidationRequested;
        _editContext.OnFieldChanged += HandleFieldChanged;
    }

    protected override void OnParametersSet()
    {
        if (Item is null)
        {
            throw new InvalidOperationException("Item parameter is required.");
        }

        if (_editContext is null)
        {
            _editContext = new EditContext(_model);
            _validationMessageStore = new ValidationMessageStore(_editContext);
            _editContext.OnValidationRequested += HandleValidationRequested;
            _editContext.OnFieldChanged += HandleFieldChanged;
        }

        if (_itemId != Item.ItemId)
        {
            _itemId = Item.ItemId;
        }

        EnsureTimer();
    }


    private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs e)
    {
        ValidateAmount();
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (e.FieldIdentifier.FieldName == nameof(BidFormModel.AmountText))
        {
            ValidateAmount();
        }
    }

    private void ValidateAmount()
    {
        if (_editContext is null || _validationMessageStore is null)
        {
            return;
        }

        var field = new FieldIdentifier(_model, nameof(BidFormModel.AmountText));
        _validationMessageStore.Clear(field);

        _model.ParsedAmount = null;

        var raw = _model.AmountText;
        if (string.IsNullOrWhiteSpace(raw))
        {
            _editContext.NotifyValidationStateChanged();
            return;
        }

        if (!TryParseAmount(raw, out var parsed))
        {
            _validationMessageStore.Add(field, "Informe um valor válido.");
        }
        else
        {
            _model.ParsedAmount = parsed;
            var minimum = Item.RequiredMinBid;
            if (parsed < minimum)
            {
                _validationMessageStore.Add(field, $"O lance deve ser de pelo menos {FormatCurrency(minimum)}.");
                _model.ParsedAmount = null;
            }
        }

        _editContext.NotifyValidationStateChanged();

        if (_isEditing)
        {
            RequestRender();
        }
    }

    private static bool TryParseAmount(string? input, out decimal amount)
    {
        if (string.IsNullOrWhiteSpace(input))
        {
            amount = 0m;
            return false;
        }

        var sanitized = input.Trim();

        if (sanitized.StartsWith("R$", StringComparison.OrdinalIgnoreCase))
        {
            sanitized = sanitized[2..].TrimStart();
        }

        sanitized = sanitized
            .Replace("\u00A0", string.Empty, StringComparison.Ordinal)
            .Replace(" ", string.Empty, StringComparison.Ordinal);

        return decimal.TryParse(
            sanitized,
            NumberStyles.Number | NumberStyles.AllowCurrencySymbol,
            CurrencyCulture,
            out amount);
    }

    private async Task BeginEditing(FocusEventArgs _)
    {
        if (_isEditing)
        {
            return;
        }

        _isEditing = true;

        if (OnEditStart.HasDelegate)
        {
            await OnEditStart.InvokeAsync(Item.ItemId);
        }
    }

    private async Task EndEditing(FocusEventArgs _)
    {
        if (!_isEditing)
        {
            return;
        }

        _isEditing = false;

        if (TryParseAmount(_model.AmountText, out var parsed) && parsed >= Item.RequiredMinBid)
        {
            var formatted = FormatCurrency(parsed);
            if (!string.Equals(_model.AmountText, formatted, StringComparison.Ordinal))
            {
                _model.AmountText = formatted;
                NotifyAmountChanged();
            }

            _model.ParsedAmount = parsed;
            ClearValidation();
        }
        else
        {
            ValidateAmount();
        }

        if (OnEditEnd.HasDelegate)
        {
            await OnEditEnd.InvokeAsync(Item.ItemId);
        }
    }

    private void NotifyAmountChanged()
    {
        if (_editContext is null)
        {
            return;
        }

        var field = new FieldIdentifier(_model, nameof(BidFormModel.AmountText));
        _editContext.NotifyFieldChanged(field);
    }

    private void ClearValidation()
    {
        if (_validationMessageStore is null || _editContext is null)
        {
            return;
        }

        var field = new FieldIdentifier(_model, nameof(BidFormModel.AmountText));
        _validationMessageStore.Clear(field);
        _editContext.NotifyValidationStateChanged();

        if (_isEditing)
        {
            RequestRender();
        }
    }

    private static string FormatCurrency(decimal value) => value.ToString("C", CurrencyCulture);

    private static bool AreAmountsEqual(decimal left, decimal right) => Math.Abs(left - right) < 0.01m;

    protected override bool ShouldRender()
        => !_isEditing || _allowRenderWhileEditing;

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        _allowRenderWhileEditing = false;
    }

    private void RequestRender()
    {
        _allowRenderWhileEditing = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void EnsureTimer()
    {
        if (_lifetimeCts is null)
        {
            return;
        }

        if (Remaining <= TimeSpan.Zero)
        {
            StopTimer();
            return;
        }

        if (_timerTask is not null)
        {
            if (!_timerTask.IsCompleted)
            {
                return;
            }

            _timerTask = null;
        }

        StopTimer();

        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _timerCts = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCts.Token);
        _timerTask = RunTimerAsync(_timer, _timerCts.Token);
    }

    private void StopTimer()
    {
        _timerCts?.Cancel();
    }

    private async Task RunTimerAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (IsExpired)
                {
                    await InvokeAsync(StateHasChanged);
                    break;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Ignored
        }
        finally
        {
            await DisposeTimerIfSupportedAsync(timer);

            if (ReferenceEquals(_timer, timer))
            {
                _timer = null;
                _timerTask = null;
                _timerCts?.Dispose();
                _timerCts = null;
            }
        }
    }

    private async Task HandleBidSubmitAsync()
    {
        if (_editContext is null)
        {
            return;
        }

        if (_isSubmitting)
        {
            return;
        }

        _infoMessage = null;
        _errorMessage = null;

        if (!_editContext.Validate())
        {
            return;
        }

        if (!_model.ParsedAmount.HasValue)
        {
            return;
        }

        _isSubmitting = true;
        _submitCts?.Cancel();
        _submitCts?.Dispose();
        _submitCts = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCts?.Token ?? CancellationToken.None);

        try
        {
            var request = new BidRequest
            {
                ItemId = Item.ItemId,
                Amount = _model.ParsedAmount.Value,
                RowVersion = Item.RowVersion
            };

            var response = await Client.PlaceBidAsync(request, _submitCts.Token);
            Item = response.Payload;
            _infoMessage = response.Message;
            _model.AmountText = string.Empty;
            _model.ParsedAmount = null;
            var field = new FieldIdentifier(_model, nameof(BidFormModel.AmountText));
            _editContext.NotifyFieldChanged(field);
            _validationMessageStore?.Clear();
            _editContext.NotifyValidationStateChanged();
            await OnBidPlaced.InvokeAsync(response.Payload);
        }
        catch (MarketConcurrencyException ex)
        {
            Logger.LogWarning(ex, "Bid rejected for item {ItemId}", Item.ItemId);
            _infoMessage = ex.Message;
            StopTimer();
            EnsureTimer();
            if (OnBidPlaced.HasDelegate)
            {
                await OnBidPlaced.InvokeAsync(Item);
            }
        }
        catch (TeamTokenMissingException ex)
        {
            _errorMessage = ex.Message;
            if (OnTeamTokenMissing.HasDelegate)
            {
                await OnTeamTokenMissing.InvokeAsync();
            }
        }
        catch (MarketClientException ex)
        {
            Logger.LogWarning(ex, "Bid rejected for item {ItemId}", Item.ItemId);
            _errorMessage = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "HTTP error placing bid for item {ItemId}", Item.ItemId);
            _errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error placing bid for item {ItemId}", Item.ItemId);
            _errorMessage = "Ocorreu um erro ao registrar o seu lance. Tente novamente.";
        }
        finally
        {
            _isSubmitting = false;
            _submitCts?.Dispose();
            _submitCts = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ShowBuyNowConfirm()
    {
        if (IsBuyNowDisabled || !CanBuyNow)
            return;

        _showBuyConfirm = true;
    }

    private void CancelBuyNow()
    {
        _showBuyConfirm = false;
    }

    private async Task ConfirmBuyNowAsync()
    {
        if (_isSubmitting)
        {
            return;
        }

        if (!CanBuyNow)
        {
            return;
        }

        _infoMessage = null;
        _errorMessage = null;
        _isSubmitting = true;
        _submitCts?.Cancel();
        _submitCts?.Dispose();
        _submitCts = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCts?.Token ?? CancellationToken.None);

        try
        {
            var request = new BuyNowRequest
            {
                ItemId = Item.ItemId,
                RowVersion = Item.RowVersion
            };

            var response = await Client.BuyNowAsync(request, _submitCts.Token);
            Item = response.Payload;
            _infoMessage = response.Message;
            _showBuyConfirm = false;
            StopTimer();
            EnsureTimer();
            await OnBought.InvokeAsync(response.Payload);
        }
        catch (MarketConcurrencyException ex)
        {
            Logger.LogWarning(ex, "Buy now rejected for item {ItemId}", Item.ItemId);
            _showBuyConfirm = false;
            _infoMessage = ex.Message;
            StopTimer();
            EnsureTimer();
            if (OnBought.HasDelegate)
            {
                await OnBought.InvokeAsync(Item);
            }
        }
        catch (TeamTokenMissingException ex)
        {
            _showBuyConfirm = false;
            _errorMessage = ex.Message;
            if (OnTeamTokenMissing.HasDelegate)
            {
                await OnTeamTokenMissing.InvokeAsync();
            }
        }
        catch (MarketClientException ex)
        {
            Logger.LogWarning(ex, "Buy now rejected for item {ItemId}", Item.ItemId);
            _showBuyConfirm = false;
            _errorMessage = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "HTTP error buying item {ItemId}", Item.ItemId);
            _showBuyConfirm = false;
            _errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error buying item {ItemId}", Item.ItemId);
            _errorMessage = "Ocorreu um erro ao concluir a compra. Tente novamente.";
        }
        finally
        {
            _isSubmitting = false;
            _submitCts?.Dispose();
            _submitCts = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _submitCts?.Cancel();
        _submitCts?.Dispose();

        StopTimer();

        if (_timerTask is not null)
        {
            try
            {
                await _timerTask;
            }
            catch (OperationCanceledException)
            {
            }
            finally
            {
                _timerTask = null;
            }
        }

        if (_timer is not null)
        {
            await DisposeTimerIfSupportedAsync(_timer);
            _timer = null;
        }

        if (_timerCts is not null)
        {
            _timerCts.Dispose();
            _timerCts = null;
        }

        _lifetimeCts?.Cancel();
        _lifetimeCts?.Dispose();

        if (_editContext is not null)
        {
            _editContext.OnValidationRequested -= HandleValidationRequested;
            _editContext.OnFieldChanged -= HandleFieldChanged;
        }
    }

    private static ValueTask DisposeTimerIfSupportedAsync(PeriodicTimer timer)
    {
        return _disposeTimerDelegate is Func<PeriodicTimer, ValueTask> disposer
            ? disposer(timer)
            : ValueTask.CompletedTask;
    }

    private static Func<PeriodicTimer, ValueTask>? CreateDisposeTimerDelegate()
    {
        const string disposeAsyncName = nameof(IAsyncDisposable.DisposeAsync);
        var disposeMethod = typeof(PeriodicTimer).GetMethod(disposeAsyncName, BindingFlags.Public | BindingFlags.Instance, null, Type.EmptyTypes, null);
        if (disposeMethod is null || disposeMethod.ReturnType != typeof(ValueTask))
        {
            return null;
        }

        return (Func<PeriodicTimer, ValueTask>)disposeMethod.CreateDelegate(typeof(Func<PeriodicTimer, ValueTask>));
    }

    private class BidFormModel
    {
        public string AmountText { get; set; } = string.Empty;

        public decimal? ParsedAmount { get; set; }
    }

    private static string TranslateStatus(string status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return string.Empty;
        }

        var normalized = status.ToLowerInvariant();
        return normalized switch
        {
            "draft" or "rascunho" => "Rascunho",
            "published" or "publicado" or "active" or "ativo" => "Ativo",
            "settled" or "finalizado" or "sold" or "vendido" => "Vendido",
            "canceled" or "cancelled" or "cancelado" => "Cancelado",
            "expired" or "expirado" => "Expirado",
            "closed" or "encerrado" => "Encerrado",
            _ => CultureInfo.GetCultureInfo("pt-BR").TextInfo.ToTitleCase(normalized)
        };
    }

    private static bool IsSoldStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return false;
        }

        return status.ToLowerInvariant() switch
        {
            "sold" or "settled" or "vendido" or "finalizado" => true,
            _ => false
        };
    }
}
