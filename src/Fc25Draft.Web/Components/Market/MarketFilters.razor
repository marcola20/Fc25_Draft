@using System
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Fc25Draft.Core.Extensions
@using Fc25Draft.Web.Models.Market
@using CoreQueryVm = Fc25Draft.Core.DTOs.MarketQueryVm

<style>
    .market-filters label.form-label {
        color: white !important;
    }
</style>

<EditForm Model="Model" OnValidSubmit="ApplyAsync">
    <div class="market-filters border rounded-3 p-3 bg-body">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-6">
                <label class="form-label" for="market-filter-name">Nome do jogador</label>
                <InputText id="market-filter-name"
                           class="form-control form-control-sm"
                           @bind-Value="Model.Name"
                           placeholder="Filtrar pelo nome"
                           aria-label="Filtrar pelo nome" />
            </div>

            <div class="col-12 col-md-6">
                <PositionMultiSelect Label="Posições"
                                     WrapperClass="w-100"
                                     ToggleClass="form-select form-select-sm text-start"
                                     IdPrefix="market-pos"
                                     Options="@(PositionOptions.Select(p => new PositionMultiSelect.OptionItem(p.Id, p.Name)).ToList())"
                                     @bind-SelectedIds="Model.Positions" />

            </div>
        </div>

        <div class="row g-2 align-items-end mt-2">
            <div class="col-12 col-md">
                <label class="form-label" for="market-filter-status">Status</label>
                <InputSelect class="form-select form-select-sm" id="market-filter-status" @bind-Value="Model.Status">
                    <option value="">Todos</option>
                    @foreach (var status in StatusOptions)
                    {
                        <option value="@status">@status</option>
                    }
                </InputSelect>
            </div>

            <div class="col-12 col-md">
                <label class="form-label" for="market-filter-sort">Ordenar por</label>
                <InputSelect class="form-select form-select-sm" id="market-filter-sort" @bind-Value="Model.Sort">
                    <option value="">Padrão</option>
                    @foreach (var option in SortOptions)
                    {
                        <option value="@option.Value">@option.DisplayName</option>
                    }
                </InputSelect>
            </div>

            <div class="col-12 col-md">
                <label class="form-label" for="market-filter-overall-min">Overall</label>
                <div class="input-group input-group-sm">
                    <InputNumber TValue="int?" id="market-filter-overall-min" class="form-control"
                                 @bind-Value="Model.OverallMin" min="0" aria-label="Overall mínimo" />
                    <span class="input-group-text">até</span>
                    <InputNumber TValue="int?" id="market-filter-overall-max" class="form-control"
                                 @bind-Value="Model.OverallMax" min="0" aria-label="Overall máximo" />
                </div>
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-12">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="submit" class="btn btn-primary btn-sm">Aplicar filtros</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearAsync">Limpar</button>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(ResultsSummary))
        {
            <div class="row mt-1">
                <div class="col-12">
                    <span class="text-muted small float-end">@ResultsSummary</span>
                </div>
            </div>
        }
    </div>
</EditForm>

@code {
    private static readonly IReadOnlyList<int> PageSizeOptions = new[] { 20, 50, 100 };
    private CoreQueryVm Model = new() { Page = 1, PageSize = 20 };

    [Parameter]
    public EventCallback<CoreQueryVm> OnApply { get; set; }

    [Parameter]
    public IReadOnlyList<MarketPositionOption> PositionOptions { get; set; } = Array.Empty<MarketPositionOption>();

    [Parameter]
    public IReadOnlyList<string> StatusOptions { get; set; } = Array.Empty<string>();

    [Parameter]
    public IReadOnlyList<MarketSortOption> SortOptions { get; set; } = Array.Empty<MarketSortOption>();

    [Parameter]
    public string ResultsSummary { get; set; } = string.Empty;

    private string PositionsDisplayText
    {
        get
        {
            if (Model.Positions is null || Model.Positions.Count == 0)
            {
                return "Todas";
            }

            var codes = Model.Positions
                .Select(PositionExtensions.ToPositionCode)
                .Where(code => !string.IsNullOrWhiteSpace(code))
                .ToList();

            if (codes.Count == Model.Positions.Count)
            {
                return string.Join(", ", codes);
            }

            var names = PositionOptions
                .Where(option => Model.Positions.Contains(option.Id))
                .Select(option => option.Name)
                .Where(name => !string.IsNullOrWhiteSpace(name))
                .ToList();

            if (names.Count > 0)
            {
                return string.Join(", ", names);
            }

            return string.Join(", ", Model.Positions);
        }
    }

    private async Task ApplyAsync()
    {
        var copy = new CoreQueryVm
        {
            Name = Model.Name,
            Positions = Model.Positions?.ToList() ?? new List<int>(),
            OverallMin = Model.OverallMin,
            OverallMax = Model.OverallMax,
            Status = Model.Status,
            Page = 1,
            PageSize = Model.PageSize,
            Sort = Model.Sort
        };

        if (OnApply.HasDelegate)
        {
            await OnApply.InvokeAsync(copy);
        }
    }

    private async Task ClearAsync()
    {
        Model = new CoreQueryVm { Page = 1, PageSize = 20 };
        await ApplyAsync();
    }

    private void OnPositionChanged(int positionId, ChangeEventArgs e)
    {
        var isChecked =
            e.Value is bool b ? b :
            string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(e.Value?.ToString(), "on", StringComparison.OrdinalIgnoreCase);

        var positions = Model.Positions ??= new List<int>();

        if (isChecked)
        {
            if (!positions.Contains(positionId)) positions.Add(positionId);
        }
        else
        {
            positions.Remove(positionId);
        }

        StateHasChanged();
    }

    private void OnPositionsSelectChanged(ChangeEventArgs e)
    {
        var values = e.Value as IEnumerable<string>;      // Blazor envia string[]
        Model.Positions = values?.Select(int.Parse).ToList() ?? new();
        StateHasChanged();
    }

}
