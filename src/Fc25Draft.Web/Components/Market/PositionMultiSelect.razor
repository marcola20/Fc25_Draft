@using System.Collections.Generic
@using Microsoft.AspNetCore.Components

<div class="@($"position-multi {WrapperClass}")" style="position:relative; z-index:1010;">
    @if (IsOpen)
    {
        <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index:1000;" @onclick="Close"></div>
    }

    <label class="form-label">@Label</label>

    <button type="button"
            class="@ToggleClass"
            @onclick="Toggle"
            @onkeydown="HandleKeyDown"
            aria-expanded="@IsOpen">
        <span class="flex-grow-1 text-truncate">@DisplayText</span>
        <span class="ms-2" aria-hidden="true">▾</span>
    </button>

    @code {
       
    }

    <div class="dropdown-menu w-100 p-3 shadow-sm @(IsOpen ? "show" : null)"
         style="max-height:280px; overflow-y:auto; z-index:1050;"
         @onclick:stopPropagation>
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="@($"{IdPrefix}-all")"
                   checked="@(!SelectedIds?.Any() ?? true)"
                   @onchange="SelectAll" />
            <label class="form-check-label" for="@($"{IdPrefix}-all")">Todas</label>
        </div>
        <div class="dropdown-divider"></div>

        @foreach (var opt in Options)
        {
            var cid = $"{IdPrefix}-{opt.Id}";
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="@cid"
                       checked="@(SelectedIds?.Contains(opt.Id) ?? false)"
                       @onchange="e => ToggleItem(opt.Id, e.Value)" />
                <label class="form-check-label" for="@cid">@opt.Name</label>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "Posições";
    [Parameter] public IReadOnlyList<OptionItem> Options { get; set; } = Array.Empty<OptionItem>();
    [Parameter] public List<int> SelectedIds { get; set; } = new();
    [Parameter] public EventCallback<List<int>> SelectedIdsChanged { get; set; }
    [Parameter] public string IdPrefix { get; set; } = "pos-ms";
    [Parameter] public string ToggleClass { get; set; } = "form-select form-select-sm d-flex align-items-center justify-content-between";
    [Parameter] public string WrapperClass { get; set; } = "";

    private bool IsOpen;

    private string DisplayText =>
        (SelectedIds is null || SelectedIds.Count == 0)
        ? "Todas as posições"
        : string.Join(", ", Options.Where(o => SelectedIds.Contains(o.Id)).Select(o => o.Name));

    private void Toggle() => IsOpen = !IsOpen;
    private void Close() => IsOpen = false;

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
    }

    private async Task ToggleItem(int id, object? value)
    {
        var isChecked = value is bool b ? b :
                        string.Equals(value?.ToString(), "true", StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(value?.ToString(), "on", StringComparison.OrdinalIgnoreCase);

        SelectedIds ??= new();
        bool changed = false;

        if (isChecked)
        {
            if (!SelectedIds.Contains(id))
            {
                SelectedIds.Add(id);
                changed = true;
            }
        }
        else
        {
            changed = SelectedIds.Remove(id);
        }

        if (changed)
            await SelectedIdsChanged.InvokeAsync(new List<int>(SelectedIds));
    }

    private async Task SelectAll(ChangeEventArgs e)
    {
        if (e.Value is bool b && b)
        {
            SelectedIds?.Clear();
            await SelectedIdsChanged.InvokeAsync(new List<int>());
        }
    }

    public record OptionItem(int Id, string Name);
}
