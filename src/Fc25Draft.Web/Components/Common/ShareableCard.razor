@inject IJSRuntime JS

@* Envolve um conteúdo (tabela, rodada, chaveamento…) e gera um botão que
   captura o bloco como imagem PNG para compartilhar (WhatsApp etc.).
   O cabeçalho e o rodapé de marca (.share-only) só aparecem na imagem gerada. *@

<div class="d-flex justify-content-end mb-2">
    <button type="button" class="btn btn-sm btn-success" @onclick="Share" disabled="@_sharing">
        @if (_sharing)
        {
            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            <span>Gerando…</span>
        }
        else
        {
            <span>📷 Compartilhar</span>
        }
    </button>
</div>

<div id="@Id" class="share-capture">
    <div class="share-brand share-only">
        <img src="/images/logobranca.png" alt="CBFV" />
        <div>
            <div class="share-brand-title">@Titulo</div>
            @if (!string.IsNullOrWhiteSpace(Subtitulo))
            {
                <div class="share-brand-sub">@Subtitulo</div>
            }
        </div>
        <div class="share-brand-meta">
            <div>🎮 CBFV</div>
            <div>cbfv-app.onrender.com</div>
        </div>
    </div>

    @ChildContent

    <div class="share-footer share-only">🎮 <strong>CBFV</strong> — cbfv-app.onrender.com</div>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter] public string Titulo { get; set; } = "CBFV";
    [Parameter] public string? Subtitulo { get; set; }
    [Parameter] public string Arquivo { get; set; } = "cbfv.png";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _sharing;

    // Legenda enviada junto da imagem (vira legenda da foto no WhatsApp do celular).
    private string Caption => string.IsNullOrWhiteSpace(Subtitulo)
        ? $"{Titulo}\nhttps://cbfv-app.onrender.com/liga"
        : $"{Titulo} — {Subtitulo}\nhttps://cbfv-app.onrender.com/liga";

    private async Task Share()
    {
        if (_sharing) return;

        _sharing = true;
        StateHasChanged();

        try
        {
            await JS.InvokeAsync<string>("fc25ShareImage.capture", Id, Arquivo, Caption);
        }
        catch
        {
            // silencioso — o usuário pode tentar de novo
        }
        finally
        {
            _sharing = false;
            StateHasChanged();
        }
    }
}
