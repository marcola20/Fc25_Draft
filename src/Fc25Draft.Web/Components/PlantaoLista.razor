@using Fc25Draft.Core.Utilities
@inject EscudoService Escudos

@* Lista de notícias do Plantão CBFV: escudo do time (ou foto do jogador), manchete com o placar em números
   de largura fixa, linha fina e quando aconteceu. *@

<ul class="plantao">
    @foreach (var n in Noticias)
    {
        <li>
            <a href="@n.Link" class="plantao-item">
                @if (n.JogadorId is int jogadorId)
                {
                    <FotoJogador PlayerId="jogadorId" Tamanho="32" />
                }
                else
                {
                    <img src="@Escudos.GetEscudo(n.TimeNome)" alt="" width="32" height="32" class="plantao-escudo" />
                }
                <span class="plantao-texto">
                    <span class="plantao-manchete">@Manchete(n.Manchete)</span>
                    @if (!string.IsNullOrWhiteSpace(n.Detalhe))
                    {
                        <span class="plantao-detalhe" title="@n.Detalhe">@n.Detalhe</span>
                    }
                </span>
                <span class="plantao-quando">@Quando(n.Data)</span>
            </a>
        </li>
    }
</ul>

@code {
    // O placar da manchete ("por 2 x 1") sai em números de largura fixa.
    private static readonly System.Text.RegularExpressions.Regex Placar =
        new(@"\b\d+ x \d+\b", System.Text.RegularExpressions.RegexOptions.Compiled);

    private static RenderFragment Manchete(string texto) => __builder =>
    {
        var resto = 0;
        foreach (System.Text.RegularExpressions.Match m in Placar.Matches(texto))
        {
            @(texto[resto..m.Index])<span class="placar">@m.Value</span>
            resto = m.Index + m.Length;
        }
        @(texto[resto..])
    };

    [Parameter, EditorRequired] public IEnumerable<PlantaoNoticiaDto> Noticias { get; set; } = Array.Empty<PlantaoNoticiaDto>();

    // "hoje", "ontem", "há 3 dias"; depois de uma semana, a data.
    private static string Quando(DateTime utc)
    {
        var local = BrazilTime.ConvertFromUtc(utc);
        var dias = (BrazilTime.ConvertFromUtc(DateTime.UtcNow).Date - local.Date).Days;
        return dias switch
        {
            (<= 0) => $"hoje, {local:HH:mm}",
            1 => "ontem",
            (< 7) => $"há {dias} dias",
            _ => local.ToString("dd/MM/yyyy")
        };
    }
}
