@using System.Globalization
@using Fc25Draft.Core.Utilities

@* Barra da confiança da diretoria (0 a 100) com a faixa e a variação do último jogo. *@
<div class="termometro @Classe(Time.Faixa)">
    <span class="termometro-faixa">@DiretoriaLabels.Faixa(Time.Faixa)</span>
    <div class="termometro-barra" role="progressbar"
         aria-label="Confiança da diretoria" aria-valuenow="@Time.Confianca.ToString("0", CultureInfo.InvariantCulture)" aria-valuemin="0" aria-valuemax="100">
        <div style="width: @Time.Confianca.ToString("0.#", CultureInfo.InvariantCulture)%"></div>
    </div>
    <span class="termometro-valor">@Time.Confianca.ToString("0", Brasil)</span>
    @if (Time.UltimaVariacao is double v)
    {
        <span class="termometro-variacao @(v > 0 ? "texto-vitoria" : v < 0 ? "texto-derrota" : "")" title="Último jogo">
            @if (v != 0)
            {
                <Icone Nome="@(v > 0 ? "arrow-up" : "arrow-down")" Tamanho="12" />@Math.Abs(v).ToString("0.0", Brasil)
            }
            else
            {
                <text>–</text>
            }
        </span>
    }
</div>
@if (Time.Ultimato is { } u)
{
    <div class="alert alert-danger py-1 px-2 mt-2 mb-0 small d-flex flex-wrap gap-2 align-items-center">
        <strong class="d-inline-flex align-items-center gap-1"><Icone Nome="triangle-alert" Tamanho="14" /> Ultimato da diretoria:</strong>
        <span>@u.Pontos de @u.PontosExigidos pontos · @(u.JogosRestantes == 1 ? "falta 1 jogo" : $"faltam {u.JogosRestantes} jogos")</span>
        @if (u.PontosQueFaltam > 0)
        {
            <span class="text-muted">(precisa de mais @u.PontosQueFaltam)</span>
        }
    </div>
}

@code {
    private static readonly CultureInfo Brasil = CultureInfo.GetCultureInfo("pt-BR");

    [Parameter, EditorRequired] public DiretoriaTimeDto Time { get; set; } = null!;

    private static string Classe(FaixaConfianca faixa) => faixa switch
    {
        FaixaConfianca.Prestigiado => "faixa-prestigiado",
        FaixaConfianca.Estavel => "faixa-estavel",
        FaixaConfianca.SobObservacao => "faixa-observacao",
        FaixaConfianca.Pressionado => "faixa-pressionado",
        _ => "faixa-balancando"
    };
}
