@using Fc25Draft.Core.DTOs
@using Fc25Draft.Web.Utilities

@* Forma, sequência atual e próximo jogo: o "como o time está" logo abaixo do topo da página. *@
@if (Perfil is not null && (Perfil.Jogos > 0 || Perfil.ProximoJogo is not null))
{
    <div class="faixa-time">
        @if (Perfil.Forma.Count > 0)
        {
            <div class="faixa-item">
                <span class="faixa-rotulo">Forma</span>
                <span class="sequencia" aria-label="Últimos jogos, do mais recente para o mais antigo">
                    @foreach (var jogo in Perfil.Forma)
                    {
                        <span class="@(jogo.Resultado?.ToLowerInvariant())" title="@TimeJogoEstilo.Descricao(jogo)">@jogo.Resultado</span>
                    }
                </span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Perfil.SequenciaAtual))
        {
            <div class="faixa-item">
                <span class="faixa-rotulo">Momento</span>
                <span class="faixa-valor @TimeJogoEstilo.Texto(Perfil.SequenciaTipo)">
                    <Icone Nome="@TimeJogoEstilo.Icone(Perfil.SequenciaTipo)" Tamanho="14" /> @Perfil.SequenciaAtual
                </span>
            </div>
        }

        @if (Perfil.ProximoJogo is { } proximo)
        {
            <div class="faixa-item faixa-proximo">
                <span class="faixa-rotulo">Próximo jogo</span>
                <span class="faixa-valor">
                    @(proximo.EmCasa ? "vs" : "@")
                    <a href="/teams/details/@proximo.AdversarioId">@proximo.AdversarioNome</a>
                    <span class="faixa-meta">@proximo.Competicao · @proximo.Etapa · @(proximo.EmCasa ? "em casa" : "fora")</span>
                </span>
            </div>
        }
    </div>
}

@code {
    [Parameter] public TimePerfilDto? Perfil { get; set; }
}
