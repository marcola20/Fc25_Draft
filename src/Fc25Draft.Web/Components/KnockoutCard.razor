@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Enums

<div class="card @(Destaque ? "border-warning border-2" : "") h-100"
     style="@(OnClick.HasDelegate ? "cursor:pointer;" : "")"
     @onclick="() => OnClick.InvokeAsync(Jogo)">
    <div class="card-header d-flex justify-content-between align-items-center py-1 px-2 @(Destaque ? "bg-warning text-dark" : "bg-dark text-white")">
        @{ var (fase, confronto) = DividirLabel(Jogo.FaseLabel); }
        <div class="lh-sm" style="min-width:0">
            <small class="fw-bold d-block">@fase</small>
            @if (confronto is not null)
            {
                <small class="d-block text-truncate" style="opacity:.75;font-size:.72rem">@confronto</small>
            }
        </div>
        @if (Jogo.PartidaStatus.HasValue)
        {
            <span class="badge @StatusBadge(Jogo.PartidaStatus.Value) ms-1 flex-shrink-0">@StatusLabel(Jogo.PartidaStatus.Value)</span>
        }
    </div>
    <div class="card-body py-2 px-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="fw-semibold @(IsVencedor(Jogo.TimeCasaId) ? "text-success" : "") d-flex align-items-center gap-1" style="min-width:0">
                <img src="@EscudoUrl(Jogo.TimeCasaNome)" alt="" width="20" height="20" style="object-fit:contain;flex-shrink:0" onerror="this.src='/images/escudos/escudo.png'" />
                <span class="text-truncate">@(Jogo.TimeCasaNome ?? "A definir")</span>
            </span>
            <span class="badge bg-secondary fs-6 ms-2 flex-shrink-0">@(Jogo.GolsCasa?.ToString() ?? "—")</span>
        </div>
        <div class="d-flex justify-content-between align-items-center">
            <span class="fw-semibold @(IsVencedor(Jogo.TimeForaId) ? "text-success" : "") d-flex align-items-center gap-1" style="min-width:0">
                <img src="@EscudoUrl(Jogo.TimeForaNome)" alt="" width="20" height="20" style="object-fit:contain;flex-shrink:0" onerror="this.src='/images/escudos/escudo.png'" />
                <span class="text-truncate">@(Jogo.TimeForaNome ?? "A definir")</span>
            </span>
            <span class="badge bg-secondary fs-6 ms-2 flex-shrink-0">@(Jogo.GolsFora?.ToString() ?? "—")</span>
        </div>
        @if (Jogo.TemPenaltis && Jogo.VencedorNome is not null)
        {
            <div class="mt-1 text-center">
                <small class="text-muted">Nos pênaltis: <strong>@Jogo.VencedorNome</strong></small>
            </div>
        }
        @if (Jogo.VencedorId.HasValue && !Jogo.TemPenaltis)
        {
            <div class="mt-1 text-center">
                <small class="text-success fw-bold">✓ @Jogo.VencedorNome</small>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public LigaKnockoutJogoDto Jogo { get; set; } = null!;
    [Parameter] public bool Destaque { get; set; }
    [Parameter] public EventCallback<LigaKnockoutJogoDto> OnClick { get; set; }

    private bool IsVencedor(Guid? timeId) => timeId.HasValue && timeId == Jogo.VencedorId;

    // "Quartas 1 — 1º Grupo A x 2º Grupo B" vira título curto + confronto em linha menor,
    // para o cartão não quebrar em três linhas quando fica estreito.
    private static (string Fase, string? Confronto) DividirLabel(string label)
    {
        var i = label.IndexOf(" — ", StringComparison.Ordinal);
        return i < 0 ? (label, null) : (label[..i], label[(i + 3)..]);
    }

    private static string EscudoUrl(string? teamName)
    {
        if (string.IsNullOrWhiteSpace(teamName)) return "/images/escudos/escudo.png";
        var normalized = teamName.Normalize(System.Text.NormalizationForm.FormD);
        var clean = new string(normalized.Where(c =>
            System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) !=
            System.Globalization.UnicodeCategory.NonSpacingMark).ToArray());
        return $"/images/escudos/{clean}.png";
    }

    private static string StatusBadge(PartidaStatus s) => s switch
    {
        PartidaStatus.EmAndamento => "bg-warning text-dark",
        PartidaStatus.Encerrada => "bg-success",
        _ => "bg-secondary"
    };

    private static string StatusLabel(PartidaStatus s) => s switch
    {
        PartidaStatus.EmAndamento => "Ao vivo",
        PartidaStatus.Encerrada => "Encerrado",
        _ => "Agendado"
    };
}
