@using System
@using System.Collections.Generic
@using System.Linq
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Interfaces
@using Fc25Draft.Web.Services
@inject TeamsApiClient TeamsApiClient
@inject ToastService Toasts
@inject IPositionEligibilityService PositionEligibility

@if (Roster is null)
{
    <div class="text-muted">Carregando elenco...</div>
}
else if (Roster.Jogadores.Count == 0)
{
    <div class="alert alert-warning" role="alert">Carregue o elenco do time para configurar a escalação.</div>
}
else if (!_initialized)
{
    <div class="text-muted">Carregando escalação...</div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label" for="activeLineupSelect">Escalação ativa</label>
                    <select id="activeLineupSelect"
                            class="form-select"
                            value="@(_activeLineupId?.ToString() ?? string.Empty)"
                            @onchange="OnActiveLineupChanged"
                            disabled="@(_isLoading || _isSaving || _lineupSummaries.Count == 0)">
                        @if (_lineupSummaries.Count == 0)
                        {
                            <option value="">Nenhuma escalação salva</option>
                        }
                        else
                        {
                            @foreach (var summary in _lineupSummaries)
                            {
                                <option value="@summary.LineupId">@summary.Name (@summary.FormationCode)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-6 text-md-end">
                    <button type="button"
                            class="btn btn-outline-primary me-2"
                            @onclick="StartNewLineupAsync"
                            disabled="@(_isLoading || _isSaving || _isTemplateLoading)">
                        Nova escalação
                    </button>
                    <button type="button"
                            class="btn btn-outline-danger"
                            @onclick="DeleteCurrentLineupAsync"
                            disabled="@(_currentLineupId is null || _isSaving || _isTemplateLoading)">
                        Excluir escalação
                    </button>
                </div>
            </div>

            <div class="row g-3 align-items-end mt-2">
                <div class="col-md-4">
                    <label class="form-label" for="formationSelect">Formação</label>
                    <select id="formationSelect"
                            class="form-select"
                            @onchange="OnFormationChangedAsync"
                            value="@_selectedFormation"
                            disabled="@_isLoading">
                        @foreach (var formation in _supportedFormations)
                        {
                            <option value="@formation">@formation</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="tacticInput">Código da tática</label>
                    <input id="tacticInput"
                           class="form-control"
                           maxlength="40"
                           @bind="_tacticCode"
                           @bind:event="oninput"
                           disabled="@_isLoading" />
                </div>
                <div class="col-md-4 text-md-end">
                    @if (_updatedAtUtc.HasValue)
                    {
                        <span class="badge bg-secondary">Atualizado em: @_updatedAtUtc.Value:dd/MM/yyyy HH:mm UTC</span>
                    }
                </div>
            </div>

            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <label class="form-label" for="lineupNameInput">Nome da escalação</label>
                    <input id="lineupNameInput"
                           class="form-control"
                           maxlength="@MaxLineupNameLength"
                           @bind="_lineupName"
                           @bind:event="oninput"
                           disabled="@_isLoading" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="observationInput">Observação</label>
                    <textarea id="observationInput"
                              class="form-control"
                              rows="1"
                              maxlength="@MaxObservationLength"
                              @bind="_observation"
                              @bind:event="oninput"
                              disabled="@_isLoading"></textarea>
                    <div class="form-text">Até @MaxObservationLength caracteres.</div>
                </div>
            </div>

            <p class="text-muted mt-3">Selecione 11 titulares e 7 reservas, sem repetir jogadores. É obrigatório ter 1 GK entre os titulares.</p>

            @if (_lineupSummaries.Count == 0 && string.IsNullOrEmpty(_errorMessage) && !_isLoading && !_isTemplateLoading)
            {
                <div class="alert alert-info" role="status">
                    Nenhuma escalação foi salva ainda. Clique em "Nova escalação" para começar.
                </div>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger" role="alert">@_errorMessage</div>
            }

            @if (_isLoading || _isTemplateLoading)
            {
                <div class="d-flex align-items-center gap-2 my-4">
                    <div class="spinner-border" role="status" aria-hidden="true"></div>
                    <span>Carregando slots da formação...</span>
                </div>
            }
            else
            {
                <div class="row g-4">
                    <div class="col-12 col-lg-6">
                        <h5>Titulares (11)</h5>
                        @foreach (var slot in GetSlotsByRole(0))
                        {
                            <div class="mb-3" @key="GetSlotKey(slot)">
                                <label class="form-label fw-semibold" for="@GetSlotElementId(slot)">@GetSlotLabel(slot)</label>
                                <select id="@GetSlotElementId(slot)"
                                        class="form-select"
                                        value="@(slot.PlayerId?.ToString() ?? string.Empty)"
                                        @onchange="e => OnSlotPlayerChanged(slot, e)"
                                        disabled="@(_isSaving || _isTemplateLoading)">
                                    <option value="">— Selecionar —</option>
                                    @foreach (var option in GetPlayerOptionsForSlot(slot))
                                    {
                                        <option value="@option.PlayerId">@option.DisplayName</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                    <div class="col-12 col-lg-6">
                        <h5>Reservas (7)</h5>
                        @foreach (var slot in GetSlotsByRole(1))
                        {
                            <div class="mb-3" @key="GetSlotKey(slot)">
                                <label class="form-label fw-semibold" for="@GetSlotElementId(slot)">@GetSlotLabel(slot)</label>
                                <select id="@GetSlotElementId(slot)"
                                        class="form-select"
                                        value="@(slot.PlayerId?.ToString() ?? string.Empty)"
                                        @onchange="e => OnSlotPlayerChanged(slot, e)"
                                        disabled="@(_isSaving || _isTemplateLoading)">
                                    <option value="">— Selecionar —</option>
                                    @foreach (var option in GetPlayerOptionsForSlot(slot))
                                    {
                                        <option value="@option.PlayerId">@option.DisplayName</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="mt-4">
                <h5>Funções especiais</h5>
                <p class="text-muted small">Escolha titulares para cada função abaixo. Um mesmo jogador pode ser escolhido em múltiplas funções.</p>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="captainSelect">Capitão</label>
                        <select id="captainSelect"
                                class="form-select"
                                value="@GetSpecialRoleValue(SpecialRoleType.Captain)"
                                @onchange="e => OnSpecialRoleChanged(SpecialRoleType.Captain, e)"
                                disabled="@(!_hasAllStartersSelected || _isSaving || _isTemplateLoading)">
                            <option value="">— Selecionar —</option>
                            @foreach (var option in GetStarterOptions())
                            {
                                <option value="@option.PlayerId">@option.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="shortFkLeftSelect">Falta perto (esquerda)</label>
                        <select id="shortFkLeftSelect"
                                class="form-select"
                                value="@GetSpecialRoleValue(SpecialRoleType.ShortFreeKickLeft)"
                                @onchange="e => OnSpecialRoleChanged(SpecialRoleType.ShortFreeKickLeft, e)"
                                disabled="@(!_hasAllStartersSelected || _isSaving || _isTemplateLoading)">
                            <option value="">— Selecionar —</option>
                            @foreach (var option in GetStarterOptions())
                            {
                                <option value="@option.PlayerId">@option.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="shortFkRightSelect">Falta perto (direita)</label>
                        <select id="shortFkRightSelect"
                                class="form-select"
                                value="@GetSpecialRoleValue(SpecialRoleType.ShortFreeKickRight)"
                                @onchange="e => OnSpecialRoleChanged(SpecialRoleType.ShortFreeKickRight, e)"
                                disabled="@(!_hasAllStartersSelected || _isSaving || _isTemplateLoading)">
                            <option value="">— Selecionar —</option>
                            @foreach (var option in GetStarterOptions())
                            {
                                <option value="@option.PlayerId">@option.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="longFkSelect">Falta de longe</label>
                        <select id="longFkSelect"
                                class="form-select"
                                value="@GetSpecialRoleValue(SpecialRoleType.LongFreeKick)"
                                @onchange="e => OnSpecialRoleChanged(SpecialRoleType.LongFreeKick, e)"
                                disabled="@(!_hasAllStartersSelected || _isSaving || _isTemplateLoading)">
                            <option value="">— Selecionar —</option>
                            @foreach (var option in GetStarterOptions())
                            {
                                <option value="@option.PlayerId">@option.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="penaltySelect">Pênaltis</label>
                        <select id="penaltySelect"
                                class="form-select"
                                value="@GetSpecialRoleValue(SpecialRoleType.Penalty)"
                                @onchange="e => OnSpecialRoleChanged(SpecialRoleType.Penalty, e)"
                                disabled="@(!_hasAllStartersSelected || _isSaving || _isTemplateLoading)">
                            <option value="">— Selecionar —</option>
                            @foreach (var option in GetStarterOptions())
                            {
                                <option value="@option.PlayerId">@option.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="cornerLeftSelect">Escanteio esquerdo</label>
                        <select id="cornerLeftSelect"
                                class="form-select"
                                value="@GetSpecialRoleValue(SpecialRoleType.CornerLeft)"
                                @onchange="e => OnSpecialRoleChanged(SpecialRoleType.CornerLeft, e)"
                                disabled="@(!_hasAllStartersSelected || _isSaving || _isTemplateLoading)">
                            <option value="">— Selecionar —</option>
                            @foreach (var option in GetStarterOptions())
                            {
                                <option value="@option.PlayerId">@option.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="cornerRightSelect">Escanteio direito</label>
                        <select id="cornerRightSelect"
                                class="form-select"
                                value="@GetSpecialRoleValue(SpecialRoleType.CornerRight)"
                                @onchange="e => OnSpecialRoleChanged(SpecialRoleType.CornerRight, e)"
                                disabled="@(!_hasAllStartersSelected || _isSaving || _isTemplateLoading)">
                            <option value="">— Selecionar —</option>
                            @foreach (var option in GetStarterOptions())
                            {
                                <option value="@option.PlayerId">@option.DisplayName</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex justify-content-end">
                <button class="btn btn-primary"
                        @onclick="SaveAsync"
                        disabled="@IsSaveDisabled">
                    @if (_isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        @:Salvando...
                    }
                    else
                    {
                        @:Salvar Escalação
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (_showLineupLimitModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Limite de escalações atingido</h5>
                    <button type="button" class="btn-close" @onclick="CloseLineupLimitModal"></button>
                </div>
                <div class="modal-body">
                    <p>O time já possui 3 escalações salvas. Exclua uma delas para registrar uma nova.</p>
                    @if (_lineupSummaries.Count == 0)
                    {
                        <div class="alert alert-info">Nenhuma escalação encontrada.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Nome</th>
                                        <th>Formação</th>
                                        <th>Atualizado em</th>
                                        <th class="text-end">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var summary in _lineupSummaries)
                                    {
                                        <tr>
                                            <td>@summary.Name</td>
                                            <td>@summary.FormationCode</td>
                                            <td>@summary.UpdatedAtUtc:dd/MM HH:mm</td>
                                            <td class="text-end">
                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm"
                                                        @onclick="async () => await DeleteLineupAsync(summary.LineupId)"
                                                        disabled="@_isDeletingLineup">
                                                    Excluir
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseLineupLimitModal">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid TeamId { get; set; }

    [Parameter]
    public TeamRosterDto? Roster { get; set; }

    [Parameter]
    public EventCallback<TeamLineupResponse> OnLineupSaved { get; set; }

    private const int MaxLineupNameLength = 60;
    private const int MaxObservationLength = 500;
    private readonly string[] _supportedFormations = new[] { "4-2-4", "4-2-2-2", "4-3-3", "4-2-3-1", "4-4-2" };

    private bool _initialized;
    private bool _isLoading = true;
    private bool _isTemplateLoading;
    private bool _isSaving;
    private bool _isDeletingLineup;
    private string? _errorMessage;
    private string _selectedFormation = "4-2-4";
    private string _tacticCode = string.Empty;
    private DateTime? _updatedAtUtc;
    private readonly List<LineupSlotViewModel> _slots = new();
    private IReadOnlyList<PlayerOption> _playerOptions = Array.Empty<PlayerOption>();
    private Dictionary<int, PlayerOption> _playerLookup = new();
    private Guid _loadedTeamId;
    private readonly List<TeamLineupSummaryResponse> _lineupSummaries = new();
    private Guid? _currentLineupId;
    private Guid? _activeLineupId;
    private string _lineupName = string.Empty;
    private string _observation = string.Empty;
    private LineupSpecialRolesViewModel _specialRoles = new();
    private bool _showLineupLimitModal;
    private int _rosterFingerprint;
    private bool HasRoster => Roster?.Jogadores is { Count: > 0 };

    protected override async Task OnParametersSetAsync()
    {
        if (!HasRoster)
        {
            ResetStateForMissingRoster();
            _initialized = false;
            _rosterFingerprint = 0;
            return;
        }

        var teamChanged = _loadedTeamId != TeamId;
        var fingerprint = CalculateRosterFingerprint();
        var rosterChanged = fingerprint != _rosterFingerprint;
        _loadedTeamId = TeamId;
        _rosterFingerprint = fingerprint;

        RefreshPlayerOptions();

        if (!_initialized || teamChanged)
        {
            await LoadAsync();
            _initialized = true;
        }
        else if (rosterChanged && _currentLineupId.HasValue)
        {
            await LoadLineupAsync(_currentLineupId.Value);
        }
    }

    private async Task LoadAsync()
    {
        if (!HasRoster)
        {
            _isLoading = false;
            return;
        }

        if (TeamId == Guid.Empty)
        {
            _errorMessage = "Time inválido.";
            _isLoading = false;
            return;
        }

        _isLoading = true;
        _errorMessage = null;
        try
        {
            var summaries = await TeamsApiClient.GetLineupsAsync(TeamId);
            _lineupSummaries.Clear();
            _lineupSummaries.AddRange(summaries);
            _activeLineupId = _lineupSummaries.FirstOrDefault(s => s.IsActive)?.LineupId;

            if (_activeLineupId.HasValue)
            {
                await LoadLineupAsync(_activeLineupId.Value);
            }
            else if (_lineupSummaries.Count > 0)
            {
                await LoadLineupAsync(_lineupSummaries[0].LineupId);
            }
            else
            {
                _currentLineupId = null;
                _lineupName = string.Empty;
                _observation = string.Empty;
                _selectedFormation = _supportedFormations.First();
                _tacticCode = string.Empty;
                _updatedAtUtc = null;
                _specialRoles.Clear();
                await LoadTemplateAsync(_selectedFormation, preservePlayers: false);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadLineupAsync(Guid lineupId)
    {
        if (!HasRoster || lineupId == Guid.Empty)
        {
            return;
        }

        try
        {
            var lineup = await TeamsApiClient.GetLineupByIdAsync(TeamId, lineupId);
            if (lineup is null)
            {
                Toasts.ShowError("Escalação não encontrada.");
                return;
            }

            ApplyLineup(lineup);
            _currentLineupId = lineup.LineupId;
            if (lineup.IsActive)
            {
                _activeLineupId = lineup.LineupId;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task RefreshSummariesAsync()
    {
        try
        {
            var summaries = await TeamsApiClient.GetLineupsAsync(TeamId);
            _lineupSummaries.Clear();
            _lineupSummaries.AddRange(summaries);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task LoadTemplateAsync(string formation, bool preservePlayers)
    {
        if (!HasRoster)
        {
            _isTemplateLoading = false;
            return;
        }

        _isTemplateLoading = true;
        _errorMessage = null;
        try
        {
            var template = await TeamsApiClient.GetLineupTemplateAsync(TeamId, formation);
            var previousSlots = preservePlayers
                ? _slots.ToDictionary(s => (s.Order, s.Role))
                : new Dictionary<(int Order, byte Role), LineupSlotViewModel>();
            var preservedPlayers = new HashSet<int>();

            _slots.Clear();

            foreach (var slot in template.OrderBy(s => s.Order))
            {
                int? playerId = null;
                if (preservePlayers && previousSlots.TryGetValue((slot.Order, slot.Role), out var previous) && previous.PlayerId.HasValue)
                {
                    var pid = previous.PlayerId.Value;
                    if (!preservedPlayers.Contains(pid) && _playerLookup.TryGetValue(pid, out var player))
                    {
                        var eligible = slot.Role == 1 || PositionEligibility.IsEligible(slot.PrimaryPositionId, player.PositionId, player.SecondaryPositionIds);
                        if (eligible)
                        {
                            playerId = pid;
                            preservedPlayers.Add(pid);
                        }
                    }
                }

                _slots.Add(new LineupSlotViewModel
                {
                    Order = slot.Order,
                    Role = slot.Role,
                    PrimaryPositionId = slot.PrimaryPositionId,
                    PositionLabel = slot.PositionLabel,
                    PlayerId = playerId
                });
            }

            PruneSpecialRoles();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isTemplateLoading = false;
        }
    }

    private void ApplyLineup(TeamLineupResponse response)
    {
        _selectedFormation = response.FormationCode;
        _tacticCode = response.TacticCode;
        _updatedAtUtc = response.UpdatedAtUtc;
        _lineupName = response.Name;
        _observation = response.Observation ?? string.Empty;
        _specialRoles = new LineupSpecialRolesViewModel
        {
            CaptainPlayerId = response.SpecialRoles.CaptainPlayerId,
            ShortFreeKickLeftPlayerId = response.SpecialRoles.ShortFreeKickLeftPlayerId,
            ShortFreeKickRightPlayerId = response.SpecialRoles.ShortFreeKickRightPlayerId,
            LongFreeKickPlayerId = response.SpecialRoles.LongFreeKickPlayerId,
            PenaltyKickPlayerId = response.SpecialRoles.PenaltyKickPlayerId,
            LeftCornerPlayerId = response.SpecialRoles.LeftCornerPlayerId,
            RightCornerPlayerId = response.SpecialRoles.RightCornerPlayerId
        };
        _slots.Clear();
        var usedPlayers = new HashSet<int>();

        foreach (var slot in response.Slots.OrderBy(s => s.Order))
        {
            int? playerId = null;
            if (slot.PlayerId.HasValue && _playerLookup.TryGetValue(slot.PlayerId.Value, out var player))
            {
                var eligible = slot.Role == 1 || PositionEligibility.IsEligible(slot.PrimaryPositionId, player.PositionId, player.SecondaryPositionIds);
                if (eligible && usedPlayers.Add(slot.PlayerId.Value))
                    playerId = slot.PlayerId.Value;
            }

            _slots.Add(new LineupSlotViewModel
            {
                Order = slot.Order,
                Role = slot.Role,
                PrimaryPositionId = slot.PrimaryPositionId,
                PositionLabel = slot.PositionLabel,
                PlayerId = playerId
            });
        }

        PruneSpecialRoles();
    }

    private async Task OnFormationChangedAsync(ChangeEventArgs args)
    {
        if (args?.Value is not string value)
            return;

        var normalized = value.Trim();
        if (string.Equals(_selectedFormation, normalized, StringComparison.OrdinalIgnoreCase))
            return;

        _selectedFormation = normalized;
        await LoadTemplateAsync(_selectedFormation, preservePlayers: true);
        StateHasChanged();
    }

    private IEnumerable<LineupSlotViewModel> GetSlotsByRole(byte role) => _slots.Where(s => s.Role == role).OrderBy(s => s.Order);

    private static string GetSlotKey(LineupSlotViewModel slot) => $"{slot.Role}-{slot.Order}";

    private static string GetSlotElementId(LineupSlotViewModel slot) => $"slot-{slot.Role}-{slot.Order}";

    private bool _hasAllStartersSelected => _slots.Count(s => s.Role == 0 && s.PlayerId is not null) == 11;

    private IEnumerable<PlayerOption> GetPlayerOptionsForSlot(LineupSlotViewModel slot)
    {
        IEnumerable<PlayerOption> baseOptions;

        if (slot.Role == 1)
        {
            baseOptions = _playerOptions;
        }
        else
        {
            var eligibles = PositionEligibility.GetEligiblePositionIdsFor(slot.PrimaryPositionId);
            baseOptions = _playerOptions.Where(p =>
                eligibles.Contains(p.PositionId) ||
                (p.SecondaryPositionIds?.Any(eligibles.Contains) ?? false));
        }

        var selectedIds = GetSelectedPlayerIds(slot);

        if (slot.PlayerId is int current)
        {
            return baseOptions.Where(p => p.PlayerId == current || !selectedIds.Contains(p.PlayerId));
        }

        return baseOptions.Where(p => !selectedIds.Contains(p.PlayerId));
    }

    private IEnumerable<PlayerOption> GetStarterOptions()
    {
        return _slots
            .Where(s => s.Role == 0 && s.PlayerId.HasValue)
            .OrderBy(s => s.Order)
            .Select(s => _playerLookup.TryGetValue(s.PlayerId!.Value, out var player) ? player : null)
            .Where(p => p is not null)!
            .Select(p => p!);
    }

    private string GetSpecialRoleValue(SpecialRoleType role) => GetSpecialRolePlayerId(role)?.ToString() ?? string.Empty;

    private int? GetSpecialRolePlayerId(SpecialRoleType role) => role switch
    {
        SpecialRoleType.Captain => _specialRoles.CaptainPlayerId,
        SpecialRoleType.ShortFreeKickLeft => _specialRoles.ShortFreeKickLeftPlayerId,
        SpecialRoleType.ShortFreeKickRight => _specialRoles.ShortFreeKickRightPlayerId,
        SpecialRoleType.LongFreeKick => _specialRoles.LongFreeKickPlayerId,
        SpecialRoleType.Penalty => _specialRoles.PenaltyKickPlayerId,
        SpecialRoleType.CornerLeft => _specialRoles.LeftCornerPlayerId,
        SpecialRoleType.CornerRight => _specialRoles.RightCornerPlayerId,
        _ => null
    };

    private void OnSpecialRoleChanged(SpecialRoleType role, ChangeEventArgs args)
    {
        if (args?.Value is not string raw)
        {
            SetSpecialRole(role, null);
            return;
        }

        if (string.IsNullOrWhiteSpace(raw))
        {
            SetSpecialRole(role, null);
            return;
        }

        if (!int.TryParse(raw, out var playerId))
        {
            return;
        }

        if (!GetStarterIds().Contains(playerId))
        {
            Toasts.ShowError("Selecione um titular para esta função.");
            return;
        }

        SetSpecialRole(role, playerId);
    }

    private void SetSpecialRole(SpecialRoleType role, int? playerId)
    {
        switch (role)
        {
            case SpecialRoleType.Captain:
                _specialRoles.CaptainPlayerId = playerId;
                break;
            case SpecialRoleType.ShortFreeKickLeft:
                _specialRoles.ShortFreeKickLeftPlayerId = playerId;
                break;
            case SpecialRoleType.ShortFreeKickRight:
                _specialRoles.ShortFreeKickRightPlayerId = playerId;
                break;
            case SpecialRoleType.LongFreeKick:
                _specialRoles.LongFreeKickPlayerId = playerId;
                break;
            case SpecialRoleType.Penalty:
                _specialRoles.PenaltyKickPlayerId = playerId;
                break;
            case SpecialRoleType.CornerLeft:
                _specialRoles.LeftCornerPlayerId = playerId;
                break;
            case SpecialRoleType.CornerRight:
                _specialRoles.RightCornerPlayerId = playerId;
                break;
        }
    }

    private HashSet<int> GetStarterIds()
    {
        var ids = new HashSet<int>();

        foreach (var slot in _slots.Where(s => s.Role == 0 && s.PlayerId.HasValue))
        {
            ids.Add(slot.PlayerId!.Value);
        }

        return ids;
    }

    private void PruneSpecialRoles()
    {
        var starters = GetStarterIds();

        if (starters.Count == 0)
        {
            _specialRoles.Clear();
            return;
        }

        if (!_specialRoles.CaptainPlayerId.HasValue || !starters.Contains(_specialRoles.CaptainPlayerId.Value))
            _specialRoles.CaptainPlayerId = null;
        if (!_specialRoles.ShortFreeKickLeftPlayerId.HasValue || !starters.Contains(_specialRoles.ShortFreeKickLeftPlayerId.Value))
            _specialRoles.ShortFreeKickLeftPlayerId = null;
        if (!_specialRoles.ShortFreeKickRightPlayerId.HasValue || !starters.Contains(_specialRoles.ShortFreeKickRightPlayerId.Value))
            _specialRoles.ShortFreeKickRightPlayerId = null;
        if (!_specialRoles.LongFreeKickPlayerId.HasValue || !starters.Contains(_specialRoles.LongFreeKickPlayerId.Value))
            _specialRoles.LongFreeKickPlayerId = null;
        if (!_specialRoles.PenaltyKickPlayerId.HasValue || !starters.Contains(_specialRoles.PenaltyKickPlayerId.Value))
            _specialRoles.PenaltyKickPlayerId = null;
        if (!_specialRoles.LeftCornerPlayerId.HasValue || !starters.Contains(_specialRoles.LeftCornerPlayerId.Value))
            _specialRoles.LeftCornerPlayerId = null;
        if (!_specialRoles.RightCornerPlayerId.HasValue || !starters.Contains(_specialRoles.RightCornerPlayerId.Value))
            _specialRoles.RightCornerPlayerId = null;
    }

    private bool AreSpecialRolesValid()
    {
        var starters = GetStarterIds();

        bool HasStarter(int? playerId) => playerId.HasValue && starters.Contains(playerId.Value);

        return starters.Count >= 11 &&
            HasStarter(_specialRoles.CaptainPlayerId) &&
            HasStarter(_specialRoles.ShortFreeKickLeftPlayerId) &&
            HasStarter(_specialRoles.ShortFreeKickRightPlayerId) &&
            HasStarter(_specialRoles.LongFreeKickPlayerId) &&
            HasStarter(_specialRoles.PenaltyKickPlayerId) &&
            HasStarter(_specialRoles.LeftCornerPlayerId) &&
            HasStarter(_specialRoles.RightCornerPlayerId);
    }

    private string GetSlotLabel(LineupSlotViewModel slot)
    {
        if (slot.Role == 1)
        {
            var reserveIndex = GetReserveIndex(slot);

            return $"Reserva {reserveIndex}";
        }

        return $"{slot.PositionLabel} ({slot.Order})";
    }

    private int GetReserveIndex(LineupSlotViewModel slot)
    {
        var startersCount = _slots.Count(s => s.Role == 0);
        var reserveIndex = slot.Order - startersCount;

        if (reserveIndex < 1)
        {
            reserveIndex = _slots
                .Where(s => s.Role == 1)
                .OrderBy(s => s.Order)
                .Select((s, index) => new { Slot = s, Index = index + 1 })
                .FirstOrDefault(s => ReferenceEquals(s.Slot, slot))?.Index ?? slot.Order;
        }

        return reserveIndex;
    }

    private void OnSlotPlayerChanged(LineupSlotViewModel slot, ChangeEventArgs args)
    {
        if (args?.Value is not string raw || string.IsNullOrWhiteSpace(raw))
        {
            if (slot.PlayerId.HasValue)
            {
                slot.PlayerId = null;
            }
            StateHasChanged();
            return;
        }

        if (!int.TryParse(raw, out var playerId)) return;

        if (!_playerLookup.TryGetValue(playerId, out var player))
        {
            Toasts.ShowError("Jogador não encontrado.");
            StateHasChanged();
            return;
        }

        var isEligible = slot.Role == 1 || PositionEligibility.IsEligible(slot.PrimaryPositionId, player.PositionId, player.SecondaryPositionIds);
        if (!isEligible)
        {
            Toasts.ShowError("Jogador não elegível para este slot.");
            StateHasChanged();
            return;
        }

        if (_slots.Any(s => !ReferenceEquals(s, slot) && s.PlayerId == playerId))
        {
            Toasts.ShowError("Jogador já selecionado em outro slot.");
            StateHasChanged();
            return;
        }

        slot.PlayerId = playerId;
        PruneSpecialRoles();
        StateHasChanged();
    }

    private HashSet<int> GetSelectedPlayerIds(LineupSlotViewModel? excludeSlot)
    {
        var ids = new HashSet<int>();

        foreach (var slot in _slots)
        {
            if (excludeSlot is not null && ReferenceEquals(slot, excludeSlot))
            {
                continue;
            }

            if (slot.PlayerId is int playerId)
            {
                ids.Add(playerId);
            }
        }

        return ids;
    }

    private bool IsSaveDisabled =>
        _isLoading ||
        _isTemplateLoading ||
        _isSaving ||
        string.IsNullOrWhiteSpace(_tacticCode) ||
        _tacticCode.Trim().Length > 40 ||
        string.IsNullOrWhiteSpace(_lineupName) ||
        _lineupName.Trim().Length > MaxLineupNameLength ||
        !_hasAllStartersSelected ||
        !AreSpecialRolesValid() ||
        _slots.Any(s => s.PlayerId is null);

    private async Task SaveAsync()
    {
        if (IsSaveDisabled)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var request = new SaveLineupRequest
            {
                LineupId = _currentLineupId,
                Name = _lineupName.Trim(),
                FormationCode = _selectedFormation,
                TacticCode = _tacticCode.Trim(),
                Observation = string.IsNullOrWhiteSpace(_observation) ? null : _observation.Trim(),
                SetAsActive = true,
                SpecialRoles = new LineupSpecialRolesDto
                {
                    CaptainPlayerId = _specialRoles.CaptainPlayerId,
                    ShortFreeKickLeftPlayerId = _specialRoles.ShortFreeKickLeftPlayerId,
                    ShortFreeKickRightPlayerId = _specialRoles.ShortFreeKickRightPlayerId,
                    LongFreeKickPlayerId = _specialRoles.LongFreeKickPlayerId,
                    PenaltyKickPlayerId = _specialRoles.PenaltyKickPlayerId,
                    LeftCornerPlayerId = _specialRoles.LeftCornerPlayerId,
                    RightCornerPlayerId = _specialRoles.RightCornerPlayerId
                },
                Slots = _slots
                    .Select(s => new SaveLineupSlotDto
                    {
                        Order = s.Order,
                        Role = s.Role,
                        PrimaryPositionId = s.PrimaryPositionId,
                        PlayerId = s.PlayerId
                    })
                    .ToList()
            };

            var response = await TeamsApiClient.SaveLineupAsync(TeamId, request);
            ApplyLineup(response);
            _currentLineupId = response.LineupId;
            _activeLineupId = response.LineupId;
            await RefreshSummariesAsync();
            Toasts.ShowSuccess("Escalação salva com sucesso.");
            if (OnLineupSaved.HasDelegate)
            {
                await OnLineupSaved.InvokeAsync(response);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            if (ex is InvalidOperationException && ex.Message.Contains("3 escalações", StringComparison.OrdinalIgnoreCase))
            {
                _showLineupLimitModal = true;
                await RefreshSummariesAsync();
            }
            Toasts.ShowError(ex.Message);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void RefreshPlayerOptions()
    {
        if (!HasRoster)
        {
            _playerOptions = Array.Empty<PlayerOption>();
            _playerLookup = new Dictionary<int, PlayerOption>();
            return;
        }

        _playerOptions = Roster!.Jogadores
            .OrderBy(p => p.Nome)
            .Select(p => new PlayerOption(p.PlayerId, p.PositionId, Array.Empty<int>(), p.Nome, p.Posicao, p.Overall))
            .ToList();

        _playerLookup = _playerOptions.ToDictionary(p => p.PlayerId);

        foreach (var slot in _slots)
        {
            if (slot.PlayerId.HasValue && !_playerLookup.ContainsKey(slot.PlayerId.Value))
            {
                slot.PlayerId = null;
            }
        }

        PruneSpecialRoles();
    }

    private void ResetStateForMissingRoster()
    {
        _isLoading = false;
        _isTemplateLoading = false;
        _playerOptions = Array.Empty<PlayerOption>();
        _playerLookup = new Dictionary<int, PlayerOption>();
        _lineupSummaries.Clear();
        _slots.Clear();
        _specialRoles.Clear();
        _currentLineupId = null;
        _activeLineupId = null;
        _selectedFormation = _supportedFormations.First();
        _lineupName = string.Empty;
        _observation = string.Empty;
        _tacticCode = string.Empty;
        _updatedAtUtc = null;
        _errorMessage = null;
        _showLineupLimitModal = false;
    }

    private async Task StartNewLineupAsync()
    {
        _currentLineupId = null;
        _lineupName = string.Empty;
        _observation = string.Empty;
        _updatedAtUtc = null;
        _specialRoles.Clear();
        await LoadTemplateAsync(_selectedFormation, preservePlayers: false);
        StateHasChanged();
    }

    private async Task DeleteCurrentLineupAsync()
    {
        if (_currentLineupId is null)
        {
            return;
        }

        await DeleteLineupAsync(_currentLineupId.Value);
    }

    private async Task DeleteLineupAsync(Guid lineupId)
    {
        if (lineupId == Guid.Empty)
        {
            return;
        }

        _isDeletingLineup = true;
        try
        {
            await TeamsApiClient.DeleteLineupAsync(TeamId, lineupId);
            Toasts.ShowSuccess("Escalação excluída com sucesso.");
            _showLineupLimitModal = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toasts.ShowError(ex.Message);
        }
        finally
        {
            _isDeletingLineup = false;
        }
    }

    private void CloseLineupLimitModal()
    {
        _showLineupLimitModal = false;
    }

    private async Task OnActiveLineupChanged(ChangeEventArgs args)
    {
        if (args?.Value is not string raw || string.IsNullOrWhiteSpace(raw))
        {
            return;
        }

        if (!Guid.TryParse(raw, out var lineupId))
        {
            return;
        }

        if (_activeLineupId.HasValue && _activeLineupId.Value == lineupId)
        {
            return;
        }

        try
        {
            await TeamsApiClient.SetActiveLineupAsync(TeamId, lineupId);
            _activeLineupId = lineupId;
            await LoadLineupAsync(lineupId);
            await RefreshSummariesAsync();
        }
        catch (Exception ex)
        {
            Toasts.ShowError(ex.Message);
        }
    }

    private int CalculateRosterFingerprint()
    {
        if (!HasRoster)
        {
            return 0;
        }

        var hash = new HashCode();
        hash.Add(Roster!.Jogadores.Count);
        foreach (var player in Roster.Jogadores.OrderBy(p => p.PlayerId))
        {
            hash.Add(player.PlayerId);
            hash.Add(player.PositionId);
        }

        return hash.ToHashCode();
    }

