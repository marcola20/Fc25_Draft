@using System.Linq
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.DTOs.Seasons
@inject TeamsApiClient TeamsApiClient
@inject RoundSelectionApiClient RoundSelectionApiClient
@inject Blazored.Toast.Services.IToastService Toasts

<div class="mt-4">
    <h5 class="fw-semibold">Seleção da Rodada</h5>

    @if (!RoundId.HasValue)
    {
        <div class="alert alert-info mt-3" role="status">Selecione uma rodada existente para gerenciar a seleção.</div>
    }
    else if (_isInitializationLoading)
    {
        <div class="alert alert-info mt-3" role="status">Carregando dados da seleção...</div>
    }
    else if (_rosters is null || _rosters.Count == 0)
    {
        <div class="alert alert-warning mt-3" role="status">Nenhum time disponível para selecionar jogadores.</div>
    }
    else
    {
        <div class="row g-3 mt-2">
            <div class="col-12 col-lg-7">
                <div class="mb-3">
                    <label class="form-label" for="team-filter">Time</label>
                    <select id="team-filter" class="form-select" @bind-Value="_selectedTeamId" @bind-Value:event="onchange">
                        @foreach (var team in _rosters)
                        {
                            <option value="@team.TeamId">@team.TeamName</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="player-search">Buscar jogador</label>
                    <input id="player-search" class="form-control" type="search" @bind-value="_playerSearch" @bind-value:event="oninput" placeholder="Digite parte do nome" />
                </div>

                <div class="list-group list-group-flush border rounded">
                    @if (_selectedTeamPlayers.Count == 0)
                    {
                        <div class="list-group-item text-muted">Nenhum jogador encontrado para os filtros informados.</div>
                    }
                    else
                    {
                        var limitReached = _selection.Count + _pendingSelections.Count >= 11;

                        @foreach (var player in _selectedTeamPlayers)
                        {
                            var alreadySelected = _selection.Any(p => p.PlayerId == player.PlayerGuid);
                            var isPending = _pendingSelections.Contains(player.PlayerGuid);
                            var disabled = alreadySelected || (limitReached && !isPending);

                            <div class="list-group-item d-flex align-items-center justify-content-between">
                                <div class="me-2">
                                    <div class="fw-semibold">@player.Nome</div>
                                    <div class="text-muted small">@player.Posicao — Overall @player.Overall</div>
                                </div>

                                <div class="form-check m-0">
                                    <input id="player-@player.PlayerGuid"
                                           class="form-check-input"
                                           type="checkbox"
                                           checked="@isPending"
                                           disabled="@disabled"
                                           @onchange="(args) => TogglePending(player.PlayerGuid, (bool)args.Value!)" />
                                    <label class="form-check-label visually-hidden" for="player-@player.PlayerGuid">
                                        Selecionar @player.Nome
                                    </label>
                                </div>
                            </div>
                        }
                    }
                </div>


                <div class="mt-3 d-flex justify-content-end">
                    <button class="btn btn-primary" type="button" disabled="@(!_canSave || _isSaving)" @onclick="SaveSelectionAsync">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        }
                        <span>Salvar seleção</span>
                    </button>
                </div>
            </div>
            <div class="col-12 col-lg-5">
                <div class="border rounded p-3 bg-light h-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-semibold">Jogadores selecionados (@_selection.Count/11)</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadSelectionAsync" disabled="@_isSelectionLoading">
                            @if (_isSelectionLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            }
                            <span>Atualizar</span>
                        </button>
                    </div>
                    @if (_isSelectionLoading)
                    {
                        <div class="alert alert-info" role="status">Carregando seleção...</div>
                    }
                    else if (_selection.Count == 0)
                    {
                        <div class="text-muted">Nenhum jogador selecionado ainda.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var player in _selection)
                            {
                                var isRemoving = _removingPlayers.Contains(player.PlayerId);
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold">@player.PlayerName</div>
                                        <div class="text-muted small">
                                            @player.PositionName
                                            <span>
                                                — @(string.IsNullOrWhiteSpace(player.TeamName) ? "Sem time" : player.TeamName)
                                            </span>
                                        </div>
                                    </div>
                                    <button class="btn btn-sm btn-outline-danger" type="button" disabled="@(_isSaving || isRemoving)" @onclick="() => RemovePlayerAsync(player.PlayerId)">
                                        @if (isRemoving)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                        }
                                        <span>Remover</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid? RoundId { get; set; }

    private IReadOnlyList<TeamRosterDto>? _rosters;
    private Guid? _selectedTeamId;
    private string _playerSearch = string.Empty;
    private readonly HashSet<Guid> _pendingSelections = new();
    private readonly HashSet<Guid> _removingPlayers = new();
    private List<RoundSelectionPlayerDto> _selection = new();
    private bool _isInitializationLoading = true;
    private bool _isSelectionLoading;
    private bool _isSaving;
    private Guid? _lastLoadedRoundId;

    private IReadOnlyList<TeamRosterPlayerDto> _selectedTeamPlayers =>
                    (_rosters?.FirstOrDefault(r => r.TeamId == _selectedTeamId)?.Jogadores
                        ?? Enumerable.Empty<TeamRosterPlayerDto>())
                    .Where(FilterPlayer)
                    .OrderBy(p => p.Nome)
                    .ToList();


    private bool _canSave => RoundId.HasValue && _pendingSelections.Count > 0 && !_isSelectionLoading;

    protected override async Task OnInitializedAsync()
    {
        await LoadRostersAsync();
        _isInitializationLoading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (RoundId != _lastLoadedRoundId)
        {
            _pendingSelections.Clear();
            await LoadSelectionAsync();
            _lastLoadedRoundId = RoundId;
        }
    }

    private async Task LoadRostersAsync()
    {
        try
        {
            _rosters = await TeamsApiClient.GetRostersAsync();
            _selectedTeamId ??= _rosters.FirstOrDefault()?.TeamId;
        }
        catch (Exception ex)
        {
            Toasts.ShowError("Erro ao carregar times: " + ex.Message);
            _rosters = Array.Empty<TeamRosterDto>();
        }
    }

    private async Task LoadSelectionAsync()
    {
        if (!RoundId.HasValue)
        {
            _selection = new List<RoundSelectionPlayerDto>();
            StateHasChanged();
            return;
        }

        _isSelectionLoading = true;
        StateHasChanged();

        try
        {
            var selection = await RoundSelectionApiClient.GetAsync(RoundId.Value);
            _selection = selection.Players?.OrderBy(p => p.PositionOrder).ThenBy(p => p.PlayerName).ToList()
                ?? new List<RoundSelectionPlayerDto>();
        }
        catch (Exception ex)
        {
            Toasts.ShowError("Erro ao carregar seleção" + ex.Message);
            _selection = new List<RoundSelectionPlayerDto>();
        }
        finally
        {
            _isSelectionLoading = false;
            StateHasChanged();
        }
    }

    private bool FilterPlayer(TeamRosterPlayerDto player)
    {
        if (string.IsNullOrWhiteSpace(_playerSearch))
        {
            return true;
        }

        return player.Nome.Contains(_playerSearch, StringComparison.OrdinalIgnoreCase);
    }

    private void TogglePending(Guid playerId, object? value)
    {
        if (value is bool isChecked)
        {
            if (isChecked)
            {
                if (!_pendingSelections.Contains(playerId))
                {
                    _pendingSelections.Add(playerId);
                }
            }
            else
            {
                _pendingSelections.Remove(playerId);
            }
            StateHasChanged();
        }
    }

    private async Task SaveSelectionAsync()
    {
        if (!RoundId.HasValue || _pendingSelections.Count == 0)
        {
            return;
        }

        _isSaving = true;
        try
        {
            var result = await RoundSelectionApiClient.AddPlayersAsync(RoundId.Value, _pendingSelections);
            if (result.Success)
            {
                Toasts.ShowSuccess(result.Message);
                _pendingSelections.Clear();
                await LoadSelectionAsync();
            }
            else
            {
                Toasts.ShowWarning(result.Message);
            }
        }
        catch (Exception ex)
        {
            Toasts.ShowError("Erro ao atualizar seleção" + ex.Message);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task RemovePlayerAsync(Guid playerId)
    {
        if (!RoundId.HasValue)
        {
            return;
        }

        if (_removingPlayers.Contains(playerId))
        {
            return;
        }

        _removingPlayers.Add(playerId);
        StateHasChanged();

        try
        {
            var result = await RoundSelectionApiClient.RemovePlayerAsync(RoundId.Value, playerId);
            if (result.Success)
            {
                Toasts.ShowSuccess(result.Message);
                _selection.RemoveAll(p => p.PlayerId == playerId);
            }
            else
            {
                Toasts.ShowWarning(result.Message);
            }
        }
        catch (Exception ex)
        {
            Toasts.ShowError("Erro ao remover jogador" + ex.Message);
        }
        finally
        {
            _removingPlayers.Remove(playerId);
            StateHasChanged();
        }
    }
}
