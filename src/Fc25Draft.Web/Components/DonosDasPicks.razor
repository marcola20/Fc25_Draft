@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Interfaces
@inject IPicksDoDraftService PicksSvc

@* Dono de cada pick negociada dos drafts abertos, com posição (depois da loteria) e proteção. *@
@if (_dados is { } dados && dados.Picks.Count > 0)
{
    <section class="picks-section">
        <div class="picks-section-header">
            <span class="picks-section-icon">🔄</span>
            <h3>Picks negociadas</h3>
        </div>
        <p class="picks-section-desc">
            As picks entram nas propostas entre times (aba Negociações) até serem usadas no draft. Antes da loteria, a
            pick vale a posição que o time dono dela pela classificação tirar; depois, já tem número, e trocar a pick
            troca quem escolhe naquela posição. Quem cede antes da loteria pode protegê-la: se cair dentro da proteção,
            volta para quem protegeu, que devolve o combinado.
        </p>
        @foreach (var draft in dados.Picks.GroupBy(p => p.Temporada).OrderBy(g => g.Key))
        {
            var negociadas = draft.Where(p => p.Negociada || p.ProtegidaAte is not null).ToList();
            <h6 class="mt-3">Draft do fim da temporada @draft.Key</h6>
            @if (negociadas.Count == 0)
            {
                <p class="small text-muted">Nenhuma pick negociada: cada time tem as suas.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>Pick</th><th>Dono hoje</th><th>Proteção</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var p in negociadas)
                            {
                                <tr class="@(p.Usada ? "text-muted" : "")">
                                    <td>@p.Rotulo @(p.Usada ? "(já usada)" : "")</td>
                                    <td class="fw-semibold">@p.DonoNome</td>
                                    <td class="small">
                                        @if (p.ProtegidaAte is int ate)
                                        {
                                            <span>🛡️ até a #@ate · volta para o @p.ProtetorNome</span>
                                            @(p.ProtecaoAcionada switch
                                            {
                                                true => " (acionou: voltou)",
                                                false => " (não acionou)",
                                                _ => ""
                                            })
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </section>
}

@code {
    private PicksDoProximoDraftDto? _dados;

    protected override async Task OnInitializedAsync()
    {
        try { _dados = await PicksSvc.ProximoDraftAsync(CancellationToken.None); }
        catch { /* sem a lista, a página mostra só as regras */ }
    }
}
