@using Fc25Draft.Core.Utilities
@inject IAlbumService AlbumSvc
@inject ITreinadorService TreinadorSvc
@inject AdminAuthService AdminAuth
@inject EscudoService Escudos

@* Cartão "Álbum" da Minha Área: o progresso da pessoa, os pacotes para abrir e os pacotes do dia.
   Sem álbum lançado (ou sem pessoa no token) não aparece. *@
@if (_resumo is { } r)
{
    <div class="card mb-3 album-cartao">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <div class="flex-grow-1" style="min-width: 220px;">
                <div class="d-flex align-items-baseline gap-2 mb-1">
                    <strong>🎴 @r.Album.Nome</strong>
                    <span class="small text-muted ms-auto">@r.Coladas de @r.Total · @r.Percentual%</span>
                </div>
                <div class="progress" role="progressbar" aria-label="Progresso do álbum" aria-valuenow="@r.Percentual" aria-valuemin="0" aria-valuemax="100" style="height: .5rem;">
                    <div class="progress-bar bg-success" style="width: @(r.Percentual)%"></div>
                </div>
                <div class="small text-muted mt-1">
                    @if (r.PacotesParaAbrir > 0)
                    {
                        <span>🎁 <strong>@r.PacotesParaAbrir</strong> pacote@(r.PacotesParaAbrir == 1 ? "" : "s") para abrir</span>
                    }
                    else
                    {
                        <span>Nenhum pacote fechado</span>
                    }
                    @if (r.Repetidas > 0)
                    {
                        <span> · 🔁 @r.Repetidas repetida@(r.Repetidas == 1 ? "" : "s")</span>
                    }
                </div>
                @if (r.AlbumCompleto is not null || r.PaginasCompletas.Count > 0)
                {
                    <div class="selos-cartao small mt-1">
                        @if (r.AlbumCompleto is { } completo)
                        {
                            <span class="selo-trofeu" title="Completo em @BrazilTime.FormatDateTime(completo.Em, "dd/MM/yyyy")">🏆 Álbum completo</span>
                        }
                        @if (r.PaginasCompletas.Count > 0)
                        {
                            <span title="Páginas completas: @string.Join(", ", r.PaginasCompletas.Select(p => p.TimeNome))">
                                🏅 @r.PaginasCompletas.Count página@(r.PaginasCompletas.Count == 1 ? "" : "s") completa@(r.PaginasCompletas.Count == 1 ? "" : "s")
                            </span>
                            @foreach (var p in r.PaginasCompletas.Take(8))
                            {
                                <img src="@Escudos.GetEscudo(p.TimeNome)" alt="@p.TimeNome" title="@p.TimeNome" width="18" height="18" loading="lazy" />
                            }
                        }
                    </div>
                }
                @if (_mensagem is not null)
                {
                    <div class="small mt-1 @(_falhou ? "text-danger" : "text-success")">@_mensagem</div>
                }
            </div>
            <div class="d-flex flex-wrap gap-2">
                @if (r.PacoteDoDiaDisponivel)
                {
                    <button class="btn btn-sm btn-success" disabled="@_pegando" @onclick="PegarAsync">🌅 Pegar os @AlbumFigurinhas.PacotesDoDia pacotes do dia</button>
                }
                <a href="/album" class="btn btn-sm btn-outline-primary">@(r.PacotesParaAbrir > 0 ? "Abrir pacotes" : "Ver o álbum")</a>
                <a href="/album/trocas" class="btn btn-sm @(r.TrocasEsperando > 0 ? "btn-warning" : "btn-outline-secondary")">
                    🔁 Trocas
                    @if (r.TrocasEsperando > 0)
                    {
                        <span class="badge rounded-pill text-bg-danger" title="Propostas esperando a sua resposta">@r.TrocasEsperando</span>
                    }
                </a>
            </div>
        </div>
    </div>
}

@code {
    private Guid? _treinadorId;
    private AlbumResumoDoTreinadorDto? _resumo;
    private bool _pegando;
    private string? _mensagem;
    private bool _falhou;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await CarregarAsync();
        StateHasChanged();
    }

    private async Task CarregarAsync()
    {
        try
        {
            var token = await AdminAuth.GetTokenAsync();
            _treinadorId ??= string.IsNullOrWhiteSpace(token)
                ? null
                : (await TreinadorSvc.GetPorTokenAsync(token, CancellationToken.None))?.TreinadorId;
            _resumo = _treinadorId is { } id ? await AlbumSvc.ResumoAsync(id, CancellationToken.None) : null;
        }
        catch
        {
            // O cartão é um extra: se falhar, a Minha Área continua sem ele.
            _resumo = null;
        }
    }

    private async Task PegarAsync()
    {
        if (_treinadorId is not { } id) return;
        _pegando = true;
        _falhou = false;
        try
        {
            var ganhou = await AlbumSvc.PegarPacoteDoDiaAsync(id, CancellationToken.None);
            _mensagem = ganhou ? "Pacotes do dia na mão. É só abrir no álbum!" : "Você já pegou os pacotes de hoje.";
            await CarregarAsync();
        }
        catch (Exception ex) { _mensagem = ex.Message; _falhou = true; }
        finally { _pegando = false; }
    }
}
