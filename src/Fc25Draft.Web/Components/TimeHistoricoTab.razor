@using Fc25Draft.Web.Utilities
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Interfaces
@inject ILigaPublicService LigaService

@if (_loading)
{
    <div class="text-center py-4"><div class="spinner-border" role="status"></div></div>
}
else if (_erro is not null)
{
    <div class="alert alert-danger"><strong>Erro ao carregar o histórico:</strong> @_erro</div>
}
else if (_dados is null || _dados.Jogadores.Count == 0)
{
    <div class="alert alert-info mb-0">Nenhum gol ou assistência registrado por este time.</div>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card border-primary h-100">
                <div class="card-body py-2">
                    <h6 class="card-title small text-muted mb-1">Gols do time</h6>
                    <h3 class="mb-0">@_dados.TotalGols</h3>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-success h-100">
                <div class="card-body py-2">
                    <h6 class="card-title small text-muted mb-1">Assistências</h6>
                    <h3 class="mb-0">@_dados.TotalAssistencias</h3>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-dark h-100">
                <div class="card-body py-2">
                    <h6 class="card-title small text-muted mb-1">G/A</h6>
                    <h3 class="mb-0">@(_dados.TotalGols + _dados.TotalAssistencias)</h3>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-secondary h-100">
                <div class="card-body py-2">
                    <h6 class="card-title small text-muted mb-1">Jogadores</h6>
                    <h3 class="mb-0">@_dados.Jogadores.Count</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <div class="input-group input-group-sm" style="max-width:320px;">
            <span class="input-group-text">🔎</span>
            <input class="form-control" placeholder="Pesquisar jogador pelo nome"
                   value="@_busca" @oninput="OnBuscaChanged" />
            @if (!string.IsNullOrWhiteSpace(_busca))
            {
                <button type="button" class="btn btn-outline-secondary" @onclick="() => _busca = string.Empty">✕</button>
            }
        </div>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="hist-so-elenco"
                   checked="@_somenteElenco" @onchange="OnSomenteElencoChanged" />
            <label class="form-check-label small" for="hist-so-elenco">Somente elenco atual</label>
        </div>
    </div>

    <p class="text-muted small">
        Só contam gols e assistências feitos <strong>por este time</strong> — o que o jogador fez em
        outros clubes não entra. Quem já saiu continua listado.
    </p>

    @if (!Filtrados.Any())
    {
        <div class="alert alert-warning mb-0">Nenhum jogador encontrado com esse filtro.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle" style="font-size:0.875rem;">
                <thead class="table-dark">
                    <tr>
                        <th style="width:40px;">#</th>
                        <th>Jogador</th>
                        <th class="text-center" style="width:90px;cursor:pointer;user-select:none;" @onclick='() => SetSort("gols")'>
                            ⚽ Gols @SortIcon("gols")
                        </th>
                        <th class="text-center" style="width:120px;cursor:pointer;user-select:none;" @onclick='() => SetSort("assistencias")'>
                            🅰️ Assist. @SortIcon("assistencias")
                        </th>
                        <th class="text-center" style="width:90px;cursor:pointer;user-select:none;" @onclick='() => SetSort("ga")'>
                            G/A @SortIcon("ga")
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{ var pos = 0; }
                    @foreach (var j in Ordenados)
                    {
                        pos++;
                        <tr>
                            <td class="fw-bold text-muted">@pos</td>
                            <td>
                                @j.JogadorNome
                                @if (!j.NoElencoAtual)
                                {
                                    <span class="badge bg-secondary ms-2" title="Não está mais no elenco">ex-jogador</span>
                                }
                            </td>
                            <td class="text-center fw-bold">@j.Gols</td>
                            <td class="text-center text-muted">@(j.Assistencias > 0 ? j.Assistencias.ToString() : "—")</td>
                            <td class="text-center fw-bold">@(j.Gols + j.Assistencias)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public Guid TeamId { get; set; }

    private bool _loading = true;
    private string? _erro;
    private TimeHistoricoDto? _dados;

    private string _busca = string.Empty;
    private bool _somenteElenco;
    private string _sortBy = "ga";
    private bool _sortAsc;

    private IEnumerable<TimeHistoricoJogadorDto> Filtrados
    {
        get
        {
            var itens = _dados?.Jogadores ?? (IReadOnlyList<TimeHistoricoJogadorDto>)Array.Empty<TimeHistoricoJogadorDto>();
            IEnumerable<TimeHistoricoJogadorDto> query = itens;

            if (_somenteElenco)
                query = query.Where(j => j.NoElencoAtual);

            if (!string.IsNullOrWhiteSpace(_busca))
            {
                var termo = TextoBusca.Normalizar(_busca);
                query = query.Where(j => TextoBusca.Normalizar(j.JogadorNome).Contains(termo));
            }

            return query;
        }
    }

    private IEnumerable<TimeHistoricoJogadorDto> Ordenados => _sortBy switch
    {
        "gols" => _sortAsc
            ? Filtrados.OrderBy(x => x.Gols).ThenBy(x => x.Assistencias)
            : Filtrados.OrderByDescending(x => x.Gols).ThenByDescending(x => x.Assistencias),
        "assistencias" => _sortAsc
            ? Filtrados.OrderBy(x => x.Assistencias).ThenBy(x => x.Gols)
            : Filtrados.OrderByDescending(x => x.Assistencias).ThenByDescending(x => x.Gols),
        _ => _sortAsc
            ? Filtrados.OrderBy(x => x.Gols + x.Assistencias).ThenBy(x => x.Gols)
            : Filtrados.OrderByDescending(x => x.Gols + x.Assistencias).ThenByDescending(x => x.Gols),
    };

    protected override async Task OnParametersSetAsync()
    {
        if (_dados?.TimeId == TeamId) return;

        _loading = true;
        _erro = null;
        try
        {
            _dados = await LigaService.GetHistoricoTimeAsync(TeamId, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnBuscaChanged(ChangeEventArgs e) => _busca = e.Value?.ToString() ?? string.Empty;

    private void OnSomenteElencoChanged(ChangeEventArgs e) => _somenteElenco = e.Value is true;

    private void SetSort(string col)
    {
        if (_sortBy == col)
            _sortAsc = !_sortAsc;
        else
        {
            _sortBy = col;
            _sortAsc = false;
        }
    }

    private string SortIcon(string col)
    {
        if (_sortBy != col) return "⇅";
        return _sortAsc ? "↑" : "↓";
    }
}
