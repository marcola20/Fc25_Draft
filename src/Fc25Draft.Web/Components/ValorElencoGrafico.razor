@using System.Globalization
@using Fc25Draft.Core.Interfaces
@inject IValorElencoService ValorElenco

@* Valor do elenco ao fim de cada janela do mercado (a preços de hoje). Some sem pelo menos dois momentos. *@
@if (_pontos is { Count: > 1 } pontos)
{
    var max = (double)pontos.Max(p => p.Valor);
    var min = (double)pontos.Min(p => p.Valor);
    var folga = Math.Max((max - min) * 0.15, max * 0.02);
    var topo = max + folga;
    var base0 = Math.Max(0, min - folga);
    const double largura = 640;
    const double altura = 200;
    double X(int i) => 40 + i * (largura - 80) / (pontos.Count - 1);
    double Y(decimal v) => 28 + (topo - (double)v) * (altura - 70) / Math.Max(1, topo - base0);
    var primeiro = pontos[0];
    var ultimo = pontos[^1];
    var variacao = primeiro.Valor == 0 ? (decimal?)null : (ultimo.Valor - primeiro.Valor) * 100 / primeiro.Valor;

    <div class="card mb-3">
        <div class="card-header d-flex flex-wrap align-items-baseline gap-2">
            <strong>📈 Valor do elenco ao longo do tempo</strong>
            @if (variacao is decimal v)
            {
                <span class="small @(v >= 0 ? "text-success" : "text-danger") fw-semibold">
                    @(v > 0 ? "+" : "")@v.ToString("0", Brasil)% desde o início
                </span>
            }
        </div>
        <div class="card-body">
            <svg viewBox="0 0 @Num(largura) @Num(altura)" class="w-100" style="max-height: 240px;" role="img"
                 aria-label="Valor do elenco de @Dinheiro.Curto(primeiro.Valor) para @Dinheiro.Curto(ultimo.Valor)">
                <polyline fill="none" stroke="var(--cbfv-azul)" stroke-width="2.5"
                          points="@string.Join(" ", pontos.Select((p, i) => $"{Num(X(i))},{Num(Y(p.Valor))}"))" />
                @for (var i = 0; i < pontos.Count; i++)
                {
                    var p = pontos[i];
                    <circle cx="@Num(X(i))" cy="@Num(Y(p.Valor))" r="5" fill="var(--cbfv-azul)">
                        <title>@p.Rotulo · @Dinheiro.Curto(p.Valor) · @p.Jogadores jogadores · overall médio @p.OverallMedio.ToString("0.0", Brasil)</title>
                    </circle>
                    <g><text x="@Num(X(i))" y="@Num(Y(p.Valor) - 10)" text-anchor="middle" font-size="12" font-weight="600"
                          fill="currentColor">@Dinheiro.Curto(p.Valor).Replace("R$ ", "")</text></g>
                    <g><text x="@Num(X(i))" y="@Num(altura - 22)" text-anchor="middle" font-size="11"
                          fill="currentColor" opacity="0.7">@p.Rotulo</text></g>
                    <g><text x="@Num(X(i))" y="@Num(altura - 8)" text-anchor="middle" font-size="10"
                          fill="currentColor" opacity="0.55">@p.Jogadores jog. · @p.OverallMedio.ToString("0", Brasil)</text></g>
                }
            </svg>
            <div class="small text-muted mt-1">
                O elenco de cada momento com o valor de mercado de hoje de cada jogador, para comparar os elencos entre si.
                Embaixo: quantos jogadores e o overall médio.
            </div>
        </div>
    </div>
}

@code {
    private static readonly CultureInfo Brasil = CultureInfo.GetCultureInfo("pt-BR");

    [Parameter, EditorRequired] public Guid TeamId { get; set; }

    private IReadOnlyList<ValorElencoPontoDto>? _pontos;

    protected override async Task OnParametersSetAsync() =>
        _pontos = await ValorElenco.HistoricoAsync(TeamId, CancellationToken.None);

    private static string Num(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);
}
