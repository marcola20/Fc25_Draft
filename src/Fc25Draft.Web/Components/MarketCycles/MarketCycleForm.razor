@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks

<EditForm EditContext="_editContext" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
    <DataAnnotationsValidator />
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" for="cycle-name">Nome do ciclo</label>
            <InputText id="cycle-name"
                       class="form-control"
                       @bind-Value="Model.Name"/>
            <ValidationMessage For="@(() => Model.Name)" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="cycle-status">Status</label>
            <InputSelect id="cycle-status" class="form-select" @bind-Value="Model.Status">
                @foreach (var status in StatusOptions)
                {
                    <option value="@status.Value">@status.Label</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => Model.Status)" />
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label" for="starts-at">Início (horário local)</label>
            <input id="starts-at"
                   class="form-control"
                   type="datetime-local"
                   @bind="Model.StartsAtLocal"
                   @bind:format="yyyy-MM-ddTHH:mm"
                   @bind:event="oninput" />
            <ValidationMessage For="@(() => Model.StartsAtLocal)" />
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label" for="ends-at">Término (horário local)</label>
            <input id="ends-at"
                   class="form-control"
                   type="datetime-local"
                   @bind="Model.EndsAtLocal"
                   @bind:format="yyyy-MM-ddTHH:mm"
                   @bind:event="oninput" />
            <ValidationMessage For="@(() => Model.EndsAtLocal)" />
        </div>
        <div class="col-12">
            <label class="form-label" for="cycle-notes">Anotações (opcional)</label>
            <InputTextArea id="cycle-notes"
                           class="form-control"
                           Rows="3"
                           @bind-Value="Model.Notes"/>
            <ValidationMessage For="@(() => Model.Notes)" />
        </div>
    </div>

    @if (_showValidationSummary)
    {
        <div class="alert alert-danger mt-3" role="alert">
            Preencha todos os campos obrigatórios antes de salvar.
        </div>
    }

    <div class="d-flex flex-wrap gap-2 mt-4">
        <button type="submit" class="btn btn-primary" disabled="@(!CanSubmit)">
            @if (IsSubmitting)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Salvando...</span>
            }
            else
            {
                <span>@SubmitLabel</span>
            }
        </button>
        @if (ShowCancelButton)
        {
            <button type="button" class="btn btn-outline-secondary" @onclick="OnCancel">Cancelar</button>
        }
    </div>
</EditForm>

@code {
    private EditContext? _editContext;
    private bool _showValidationSummary;
    private bool _isDirty;

    [Parameter, EditorRequired]
    public MarketCycleFormModel Model { get; set; } = default!;

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter]
    public EventCallback<MarketCycleFormModel> OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback<bool> DirtyStateChanged { get; set; }

    [Parameter]
    public string SubmitLabel { get; set; } = "Salvar ciclo";

    [Parameter]
    public bool ShowCancelButton { get; set; } = true;

    private bool CanSubmit => !IsSubmitting && Model is not null && EvaluateReadiness();

    private static IReadOnlyList<(MarketCycleStatus Value, string Label)> StatusOptions { get; } = Enum
        .GetValues<MarketCycleStatus>()
        .Select(value => (value, GetLabel(value)))
        .ToList();

    protected override void OnParametersSet()
    {
        if (Model is null)
        {
            throw new InvalidOperationException("O modelo do formulário não pode ser nulo.");
        }

        if (_editContext is null || !ReferenceEquals(_editContext.Model, Model))
        {
            if (_editContext is not null)
            {
                _editContext.OnFieldChanged -= OnFieldChanged;
                _editContext.OnValidationStateChanged -= OnValidationChanged;
            }

            _editContext = new EditContext(Model);
            _editContext.OnFieldChanged += OnFieldChanged;
            _editContext.OnValidationStateChanged += OnValidationChanged;
            _isDirty = false;
            _showValidationSummary = false;
            _ = DirtyStateChanged.InvokeAsync(false);
        }
    }

    private async Task HandleValidSubmit()
    {
        _showValidationSummary = false;
        await OnValidSubmit.InvokeAsync(Model);
    }

    private void HandleInvalidSubmit()
    {
        _showValidationSummary = true;
    }

    private void OnFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        _isDirty = true;
        _ = DirtyStateChanged.InvokeAsync(true);
        StateHasChanged();
    }

    private void OnValidationChanged(object? sender, ValidationStateChangedEventArgs e)
    {
        StateHasChanged();
    }

    private bool EvaluateReadiness()
    {
        if (string.IsNullOrWhiteSpace(Model.Name))
        {
            return false;
        }

        if (!Model.StartsAtLocal.HasValue || !Model.EndsAtLocal.HasValue)
        {
            return false;
        }

        if (Model.StartsAtLocal.Value >= Model.EndsAtLocal.Value)
        {
            return false;
        }

        return true;
    }

    public void ResetDirtyState()
    {
        _isDirty = false;
        _ = DirtyStateChanged.InvokeAsync(false);
        if (_editContext is not null)
        {
            _editContext.MarkAsUnmodified();
        }
    }

    public bool HasChanges => _isDirty;

    private static string GetLabel(MarketCycleStatus status) => status switch
    {
        MarketCycleStatus.Draft => "Rascunho",
        MarketCycleStatus.Open => "Aberto",
        MarketCycleStatus.Closed => "Encerrado",
        _ => status.ToString()
    };
}
