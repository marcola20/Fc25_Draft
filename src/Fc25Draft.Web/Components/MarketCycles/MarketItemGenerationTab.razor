@using System.Globalization
@using System.Linq
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Entities
@using Fc25Draft.Core.Interfaces
@using Fc25Draft.Web.Models.MarketCycles
@using Fc25Draft.Web.Services
@using Fc25Draft.Web.Utilities
@implements IDisposable

@if (Cycle is null)
{
    <div class="alert alert-info" role="alert">
        Selecione um ciclo em rascunho na aba de listagem para gerar itens automaticamente.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <h2 class="h5 mb-1">Gerar itens para @Cycle.Name</h2>
                    <div class="text-muted small">
                        Início: @BrazilTime.FormatDateTime(Cycle.StartsAtUtc)
                        &bull;
                        Término: @BrazilTime.FormatDateTime(Cycle.EndsAtUtc)
                    </div>
                </div>
                <span class="badge @GetStatusBadgeClass(Cycle.Status)">@GetStatusLabel(Cycle.Status)</span>
            </div>

            @if (!IsDraftCycle)
            {
                <div class="alert alert-warning" role="alert">
                    Apenas ciclos em rascunho podem receber novos itens gerados automaticamente.
                </div>
            }

            @if (!string.IsNullOrEmpty(_positionsError))
            {
                <div class="alert alert-danger" role="alert">@_positionsError</div>
            }

            <EditForm EditContext="_editContext" OnValidSubmit="HandlePreviewAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <fieldset disabled="@(!IsDraftCycle || IsBusy || _model is null)">
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="generation-count">Quantidade desejada</label>
                            <InputNumber id="generation-count" class="form-control" @bind-Value="_model!.DesiredCount" />
                            <ValidationMessage For="@(() => _model!.DesiredCount)" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="generation-seed">Semente (opcional)</label>
                            <InputNumber id="generation-seed" class="form-control" @bind-Value="_model!.Seed" />
                            <ValidationMessage For="@(() => _model!.Seed)" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="generation-duration">Duração (horas)</label>
                            <InputNumber id="generation-duration" class="form-control" @bind-Value="_model!.Lifecycle.DurationHours" />
                            <ValidationMessage For="@(() => _model!.Lifecycle.DurationHours)" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="generation-publish">Publicar em (horário local, opcional)</label>
                            <input id="generation-publish"
                                   class="form-control"
                                   type="datetime-local"
                                   @bind="_model!.Lifecycle.PublishAtLocal"
                                   @bind:format="yyyy-MM-ddTHH:mm"
                                   @bind:event="oninput" />
                            <ValidationMessage For="@(() => _model!.Lifecycle.PublishAtLocal)" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="generation-expire">Expira em (horário local, opcional)</label>
                            <input id="generation-expire"
                                   class="form-control"
                                   type="datetime-local"
                                   @bind="_model!.Lifecycle.ExpiresAtLocal"
                                   @bind:format="yyyy-MM-ddTHH:mm"
                                   @bind:event="oninput" />
                            <ValidationMessage For="@(() => _model!.Lifecycle.ExpiresAtLocal)" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label" for="generation-ovr-min">Overall mínimo</label>
                            <InputNumber id="generation-ovr-min" class="form-control" @bind-Value="_model!.Filters.MinOverall" />
                            <ValidationMessage For="@(() => _model!.Filters.MinOverall)" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label" for="generation-ovr-max">Overall máximo</label>
                            <InputNumber id="generation-ovr-max" class="form-control" @bind-Value="_model!.Filters.MaxOverall" />
                            <ValidationMessage For="@(() => _model!.Filters.MaxOverall)" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label" for="generation-age-min">Idade mínima</label>
                            <InputNumber id="generation-age-min" class="form-control" @bind-Value="_model!.Filters.MinAge" />
                            <ValidationMessage For="@(() => _model!.Filters.MinAge)" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label" for="generation-age-max">Idade máxima</label>
                            <InputNumber id="generation-age-max" class="form-control" @bind-Value="_model!.Filters.MaxAge" />
                            <ValidationMessage For="@(() => _model!.Filters.MaxAge)" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <InputCheckbox id="generation-free-agents" class="form-check-input" @bind-Value="_model!.Filters.OnlyFreeAgents" />
                                <label class="form-check-label" for="generation-free-agents">Apenas agentes livres</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label d-block">Posições</label>
                            @if (_isLoadingPositions)
                            {
                                <div class="form-text">Carregando posições...</div>
                            }
                            else if (_positionOptions.Count == 0)
                            {
                                <div class="form-text text-muted">Nenhuma posição disponível foi encontrada.</div>
                            }
                            else
                            {
                                <div class="d-flex flex-wrap gap-3">
                                    @foreach (var option in _positionOptions)
                                    {
                                        var checkboxId = $"generation-position-{option.Id}";
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="@checkboxId"
                                                   checked="@IsPositionSelected(option.Id)"
                                                   @onchange="args => OnPositionToggled(option.Id, args)" />
                                            <label class="form-check-label" for="@checkboxId">@option.Name</label>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </fieldset>

                @if (_showValidationSummary)
                {
                    <div class="alert alert-danger mt-3" role="alert">
                        Corrija os campos destacados antes de continuar.
                    </div>
                }

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-outline-primary" disabled="@(!CanPreview)">
                        @if (_isPreviewing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Pré-visualizando...</span>
                        }
                        else
                        {
                            <span>Pré-visualizar</span>
                        }
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="HandleGenerateAsync" disabled="@(!CanGenerate)">
                        @if (_isGenerating)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Gerando itens...</span>
                        }
                        else
                        {
                            <span>Gerar itens</span>
                        }
                    </button>
                    <button type="button" class="btn btn-outline-danger" @onclick="HandleClearAsync" disabled="@(!CanClear)">
                        @if (_isClearing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Limpando...</span>
                        }
                        else
                        {
                            <span>Limpar rascunho</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showPreviewModal && _preview is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Pré-visualização da geração</h5>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="ClosePreview"></button>
                </div>
                <div class="modal-body">
                    <dl class="row small">
                        <dt class="col-sm-3">Solicitados</dt>
                        <dd class="col-sm-9">@_preview.RequestedCount</dd>
                        <dt class="col-sm-3">Elegíveis</dt>
                        <dd class="col-sm-9">@_preview.EligibleCount</dd>
                        <dt class="col-sm-3">Semente utilizada</dt>
                        <dd class="col-sm-9">@_preview.Seed</dd>
                    </dl>

                    @if (_preview.Items.Count == 0)
                    {
                        <div class="alert alert-info" role="alert">
                            Nenhum jogador elegível foi encontrado com os filtros informados.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Jogador</th>
                                        <th>Posição</th>
                                        <th class="text-center">Overall</th>
                                        <th class="text-center">Idade</th>
                                        <th class="text-end">Preço inicial</th>
                                        <th class="text-end">Comprar já</th>
                                        <th class="text-end">Incremento mínimo</th>
                                        <th class="text-nowrap">Expira em</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var item in CurrentPreviewPageItems)
                                {
                                    <tr>
                                        <td>@item.PlayerName</td>
                                        <td>@item.PositionName</td>
                                        <td class="text-center">@item.Overall</td>
                                        <td class="text-center">@(item.Age?.ToString() ?? "–")</td>
                                        <td class="text-end">@item.BasePrice.ToString("C0", BrazilTime.Culture)</td>
                                        <td class="text-end">@(item.BuyNowPrice.HasValue ? item.BuyNowPrice.Value.ToString("C0", BrazilTime.Culture) : "–")</td>
                                        <td class="text-end">@item.MinIncrement.ToString("C0", BrazilTime.Culture)</td>
                                        <td class="text-nowrap">@BrazilTime.FormatDateTime(item.ExpiresAtUtc)</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>

                        @if (TotalPreviewPages > 1)
                        {
                            <nav class="mt-2" aria-label="Paginação da pré-visualização">
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(_previewPage <= 1 ? "disabled" : null)">
                                        <button class="page-link" type="button" @onclick="() => ChangePreviewPage(_previewPage - 1)" disabled="@(_previewPage <= 1)">Anterior</button>
                                    </li>
                                    @for (var page = 1; page <= TotalPreviewPages; page++)
                                    {
                                        <li class="page-item @(page == _previewPage ? "active" : null)">
                                            <button class="page-link" type="button" @onclick="() => ChangePreviewPage(page)">@page</button>
                                        </li>
                                    }
                                    <li class="page-item @(_previewPage >= TotalPreviewPages ? "disabled" : null)">
                                        <button class="page-link" type="button" @onclick="() => ChangePreviewPage(_previewPage + 1)" disabled="@(_previewPage >= TotalPreviewPages)">Próxima</button>
                                    </li>
                                </ul>
                            </nav>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="ClosePreview">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const int PreviewPageSize = 10;

    private MarketItemGenerationFormModel? _model;
    private EditContext? _editContext;
    private readonly List<PositionOption> _positionOptions = new();
    private bool _isLoadingPositions;
    private string? _positionsError;
    private bool _isPreviewing;
    private bool _isGenerating;
    private bool _isClearing;
    private bool _showValidationSummary;
    private MarketItemGenerationPreviewDto? _preview;
    private bool _showPreviewModal;
    private int _previewPage = 1;
    private CancellationTokenSource? _operationCts;

    [Parameter]
    public MarketCycleDto? Cycle { get; set; }

    [Parameter]
    public EventCallback<Guid> CycleUpdated { get; set; }

    [Inject]
    public IPositionService PositionService { get; set; } = default!;

    [Inject]
    public IMarketItemGenerationClient GenerationClient { get; set; } = default!;

    [Inject]
    public ToastService Toasts { get; set; } = default!;

    [Inject]
    public IJSRuntime JSRuntime { get; set; } = default!;

    private bool IsDraftCycle => Cycle?.Status == MarketCycleStatus.Draft;

    private bool IsBusy => _isPreviewing || _isGenerating || _isClearing;

    private bool CanPreview => IsDraftCycle && !IsBusy && _model is not null && _editContext is not null;

    private bool CanGenerate => IsDraftCycle && !IsBusy && _model is not null && _editContext is not null;

    private bool CanClear => IsDraftCycle && !_isClearing && Cycle is not null;

    private IReadOnlyList<MarketItemGenerationItemDto> CurrentPreviewPageItems
    {
        get
        {
            if (_preview is null)
            {
                return Array.Empty<MarketItemGenerationItemDto>();
            }

            var skip = (_previewPage - 1) * PreviewPageSize;
            return _preview.Items.Skip(skip).Take(PreviewPageSize).ToList();
        }
    }

    private int TotalPreviewPages
        => _preview is null || _preview.Items.Count == 0
            ? 1
            : Math.Max(1, (int)Math.Ceiling(_preview.Items.Count / (double)PreviewPageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadPositionsAsync();
    }

    protected override void OnParametersSet()
    {
        if (Cycle is null)
        {
            ResetModel(null);
            return;
        }

        if (_model is null || _model.CycleId != Cycle.CycleId)
        {
            ResetModel(Cycle.CycleId);
        }
    }

    private async Task LoadPositionsAsync()
    {
        if (_positionOptions.Count > 0)
        {
            return;
        }

        _isLoadingPositions = true;
        _positionsError = null;

        try
        {
            var positions = await PositionService.GetAllAsync().ConfigureAwait(false);
            _positionOptions.Clear();
            _positionOptions.AddRange(positions
                .OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase)
                .Select(p => new PositionOption(p.PositionId, p.Name)));
        }
        catch (Exception ex)
        {
            _positionsError = "Não foi possível carregar as posições disponíveis.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _isLoadingPositions = false;
        }
    }

    private void ResetModel(Guid? cycleId)
    {
        CancelOperation();
        DisposeEditContext();
        _preview = null;
        _showPreviewModal = false;
        _previewPage = 1;
        _showValidationSummary = false;

        if (!cycleId.HasValue)
        {
            _model = null;
            return;
        }

        _model = MarketItemGenerationFormModel.Create(cycleId.Value);
        _model.Lifecycle.PublishAtLocal = BrazilTime.ConvertFromUtc(DateTime.UtcNow);
        ConfigureEditContext();
    }

    private void ConfigureEditContext()
    {
        if (_model is null)
        {
            return;
        }

        _editContext = new EditContext(_model);
        _editContext.OnFieldChanged += OnFieldChanged;
        _editContext.OnValidationStateChanged += OnValidationStateChanged;
    }

    private void DisposeEditContext()
    {
        if (_editContext is not null)
        {
            _editContext.OnFieldChanged -= OnFieldChanged;
            _editContext.OnValidationStateChanged -= OnValidationStateChanged;
        }

        _editContext = null;
    }

    private void OnFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnValidationStateChanged(object? sender, ValidationStateChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private bool IsPositionSelected(short positionId)
        => _model?.Filters.PositionIds.Contains(positionId) ?? false;

    private void OnPositionToggled(short positionId, ChangeEventArgs args)
    {
        if (_model is null || _editContext is null)
        {
            return;
        }

        var isChecked = args.Value is bool b && b;
        var list = _model.Filters.PositionIds;

        if (isChecked)
        {
            if (!list.Contains(positionId))
            {
                list.Add(positionId);
            }
        }
        else
        {
            list.Remove(positionId);
        }

        _editContext.NotifyFieldChanged(new FieldIdentifier(_model.Filters, nameof(_model.Filters.PositionIds)));
    }

    private async Task HandlePreviewAsync()
    {
        if (!IsDraftCycle || Cycle is null || _model is null)
        {
            return;
        }

        _showValidationSummary = false;
        _isPreviewing = true;
        var token = BeginOperation();

        try
        {
            var request = _model.ToRequestDto();
            var preview = await GenerationClient.PreviewAsync(Cycle.CycleId, request, token).ConfigureAwait(false);
            _preview = preview;
            _previewPage = 1;
            _showPreviewModal = true;
        }
        catch (OperationCanceledException)
        {
            // ignorado
        }
        catch (HttpRequestException ex)
        {
            Toasts.ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            Toasts.ShowError("Não foi possível pré-visualizar os itens.");
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _isPreviewing = false;
            CompleteOperation();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleGenerateAsync()
    {
        if (!IsDraftCycle || Cycle is null || _model is null || _editContext is null)
        {
            return;
        }

        if (!_editContext.Validate())
        {
            _showValidationSummary = true;
            return;
        }

        _showValidationSummary = false;

        var confirmed = await ConfirmAsync($"Deseja gerar {_model.DesiredCount} itens para o ciclo '{Cycle.Name}'?").ConfigureAwait(false);
        if (!confirmed)
        {
            return;
        }

        _isGenerating = true;
        var token = BeginOperation();

        try
        {
            var request = _model.ToRequestDto();
            var result = await GenerationClient.GenerateAsync(Cycle.CycleId, request, token).ConfigureAwait(false);
            var message = $"Gerados {result.CreatedCount} itens (solicitados {result.RequestedCount}).";
            if (result.SkippedExistingCount > 0)
            {
                message += $" {result.SkippedExistingCount} itens existentes foram ignorados.";
            }

            Toasts.ShowSuccess(message);

            _preview = new MarketItemGenerationPreviewDto(result.RequestedCount, result.EligibleCount, result.Seed, result.Items);
            _previewPage = 1;
            _showPreviewModal = true;

            if (CycleUpdated.HasDelegate)
            {
                await CycleUpdated.InvokeAsync(Cycle.CycleId).ConfigureAwait(false);
            }
        }
        catch (OperationCanceledException)
        {
            // ignorado
        }
        catch (HttpRequestException ex)
        {
            Toasts.ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            Toasts.ShowError("Falha ao gerar itens para o ciclo.");
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _isGenerating = false;
            CompleteOperation();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleClearAsync()
    {
        if (!IsDraftCycle || Cycle is null)
        {
            return;
        }

        var confirmed = await ConfirmAsync("Deseja remover todos os itens em rascunho deste ciclo?").ConfigureAwait(false);
        if (!confirmed)
        {
            return;
        }

        _isClearing = true;
        var token = BeginOperation();

        try
        {
            var result = await GenerationClient.DeleteDraftsAsync(Cycle.CycleId, token).ConfigureAwait(false);
            if (result.RemovedCount > 0)
            {
                Toasts.ShowSuccess($"{result.RemovedCount} itens foram removidos do ciclo.");
            }
            else
            {
                Toasts.ShowInfo("Nenhum item em rascunho foi encontrado para remoção.");
            }

            if (CycleUpdated.HasDelegate)
            {
                await CycleUpdated.InvokeAsync(Cycle.CycleId).ConfigureAwait(false);
            }
        }
        catch (OperationCanceledException)
        {
            // ignorado
        }
        catch (HttpRequestException ex)
        {
            Toasts.ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            Toasts.ShowError("Falha ao limpar os itens do ciclo.");
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _isClearing = false;
            CompleteOperation();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ClosePreview()
    {
        _showPreviewModal = false;
    }

    private void ChangePreviewPage(int page)
    {
        if (page < 1 || page > TotalPreviewPages)
        {
            return;
        }

        _previewPage = page;
    }

    private CancellationToken BeginOperation()
    {
        CancelOperation();
        _operationCts = new CancellationTokenSource();
        return _operationCts.Token;
    }

    private void CancelOperation()
    {
        if (_operationCts is null)
        {
            return;
        }

        try
        {
            _operationCts.Cancel();
        }
        catch
        {
            // ignorado
        }
        finally
        {
            _operationCts.Dispose();
            _operationCts = null;
        }
    }

    private void CompleteOperation()
    {
        _operationCts?.Dispose();
        _operationCts = null;
    }

    private async Task<bool> ConfirmAsync(string message)
    {
        try
        {
            return await JSRuntime.InvokeAsync<bool>("confirm", message);
        }
        catch (JSException)
        {
            return true;
        }
    }

    private static string GetStatusLabel(MarketCycleStatus status) => status switch
    {
        MarketCycleStatus.Draft => "Rascunho",
        MarketCycleStatus.Open => "Aberto",
        MarketCycleStatus.Closed => "Encerrado",
        _ => status.ToString()
    };

    private static string GetStatusBadgeClass(MarketCycleStatus status) => status switch
    {
        MarketCycleStatus.Draft => "bg-secondary",
        MarketCycleStatus.Open => "bg-success",
        MarketCycleStatus.Closed => "bg-dark",
        _ => "bg-secondary"
    };

    public void Dispose()
    {
        CancelOperation();
        DisposeEditContext();
    }

    private sealed record PositionOption(short Id, string Name);
}
