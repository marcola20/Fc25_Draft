@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using System.Net.Http
@using System.Threading
@using Fc25Draft.Core.DTOs
@using Fc25Draft.Core.Entities
@using Fc25Draft.Core.Interfaces
@using Fc25Draft.Web.Models.MarketCycles
@using Fc25Draft.Web.Services
@using Fc25Draft.Web.Utilities
@using Microsoft.AspNetCore.Components.Forms
@inject ToastService Toasts
@inject PlayersApiClient PlayersApiClient
@inject ILogger<Fc25Draft.Web.Components.MarketCycles.MarketItemGenerationTab> Logger

@implements IDisposable

@if (Cycle is null)
{
    <div class="alert alert-info" role="alert">
        Selecione um ciclo em rascunho na aba de listagem para gerar itens automaticamente.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <h2 class="h5 mb-1">Gerar itens para @Cycle.Name</h2>
                    <div class="text-muted small">
                        Início: @BrazilTime.FormatDateTime(Cycle.StartsAtUtc)
                        &bull;
                        Término: @BrazilTime.FormatDateTime(Cycle.EndsAtUtc)
                    </div>
                </div>
                <span class="badge @GetStatusBadgeClass(Cycle.Status)">@GetStatusLabel(Cycle.Status)</span>
            </div>

            @if (!IsDraftCycle)
            {
                <div class="alert alert-warning" role="alert">
                    Apenas ciclos em rascunho podem receber novos itens gerados automaticamente.
                </div>
            }

            @if (!string.IsNullOrEmpty(_positionsError))
            {
                <div class="alert alert-danger" role="alert">@_positionsError</div>
            }

            @if (_model is null || _editContext is null)
            {
                <div class="alert alert-info" role="status">
                    Preparando formulário de geração…
                </div>
            }
            else
            {
                <EditForm EditContext="_editContext" OnValidSubmit="HandlePreviewAsync" @key="_editContext">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <fieldset disabled="@(!IsDraftCycle || IsBusy)">
                        <div class="row g-3">
                            <div class="col-12 col-md-3">
                                <label class="form-label" for="generation-count">Quantidade desejada</label>
                                <InputNumber id="generation-count" class="form-control" @bind-Value="_model!.DesiredCount" />
                                <ValidationMessage For="@(() => _model!.DesiredCount)" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label" for="generation-seed">Semente (opcional)</label>
                                <InputNumber id="generation-seed" class="form-control" @bind-Value="_model!.Seed" />
                                <ValidationMessage For="@(() => _model!.Seed)" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label" for="generation-max-team">Máx. por time</label>
                                <InputNumber id="generation-max-team" class="form-control" @bind-Value="_model!.MaxPerTeam" />
                                <ValidationMessage For="@(() => _model!.MaxPerTeam)" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label" for="generation-max-position">Máx. por posição</label>
                                <InputNumber id="generation-max-position" class="form-control" @bind-Value="_model!.MaxPerPosition" />
                                <ValidationMessage For="@(() => _model!.MaxPerPosition)" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label" for="generation-ovr-min">Overall mínimo</label>
                                <InputNumber id="generation-ovr-min" class="form-control" @bind-Value="_model!.MinOverall" />
                                <ValidationMessage For="@(() => _model!.MinOverall)" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label" for="generation-ovr-max">Overall máximo</label>
                                <InputNumber id="generation-ovr-max" class="form-control" @bind-Value="_model!.MaxOverall" />
                                <ValidationMessage For="@(() => _model!.MaxOverall)" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label" for="generation-age-min">Idade mínima</label>
                                <InputNumber id="generation-age-min" class="form-control" @bind-Value="_model!.MinAge" />
                                <ValidationMessage For="@(() => _model!.MinAge)" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label" for="generation-age-max">Idade máxima</label>
                                <InputNumber id="generation-age-max" class="form-control" @bind-Value="_model!.MaxAge" />
                                <ValidationMessage For="@(() => _model!.MaxAge)" />
                            </div>
                            <div class="col-12">
                                <label class="form-label d-block">Posições</label>
                                @if (_isLoadingPositions)
                                {
                                    <div class="form-text">Carregando posições...</div>
                                }
                                else if (_positionOptions.Count == 0)
                                {
                                    <div class="form-text text-muted">Nenhuma posição disponível foi encontrada.</div>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-3">
                                        @foreach (var option in _positionOptions)
                                        {
                                            var checkboxId = $"generation-position-{option.Id}";
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       id="@checkboxId"
                                                       checked="@IsPositionSelected(option.Id)"
                                                       @onchange="args => OnPositionToggled(option.Id, args)" />
                                                <label class="form-check-label" for="@checkboxId">@option.Name</label>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <InputCheckbox id="generation-exclude-open" class="form-check-input" @bind-Value="_model!.ExcludeAlreadyListedInOpenCycles" />
                                    <label class="form-check-label" for="generation-exclude-open">Excluir jogadores já listados em ciclos abertos</label>
                                </div>
                                <div class="form-check mt-1">
                                    <InputCheckbox id="generation-ensure-unique" class="form-check-input" @bind-Value="_model!.EnsureUniquePlayerPerCycle" />
                                    <label class="form-check-label" for="generation-ensure-unique">Garantir apenas um anúncio por ciclo</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Modo de expiração</label>
                                <InputRadioGroup @bind-Value="_model!.AutoSpreadExpirationsAcrossCycle" class="d-flex flex-column flex-md-row gap-2">
                                    <label class="form-check form-check-inline">
                                        <InputRadio Value="true" class="form-check-input" />
                                        <span class="form-check-label">Automático (espalhar pelo ciclo)</span>
                                    </label>
                                    <label class="form-check form-check-inline">
                                        <InputRadio Value="false" class="form-check-input" />
                                        <span class="form-check-label">Manual (definir duração)</span>
                                    </label>
                                </InputRadioGroup>
                            </div>
                            @if (!_model!.AutoSpreadExpirationsAcrossCycle)
                            {
                                <div class="col-12 col-md-6">
                                    <label class="form-label" for="generation-lifespan-min">Duração mínima (horas)</label>
                                    <InputNumber id="generation-lifespan-min" class="form-control" @bind-Value="_model!.MinLifespanHours" />
                                    <ValidationMessage For="@(() => _model!.MinLifespanHours)" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label" for="generation-lifespan-max">Duração máxima (horas)</label>
                                    <InputNumber id="generation-lifespan-max" class="form-control" @bind-Value="_model!.MaxLifespanHours" />
                                    <ValidationMessage For="@(() => _model!.MaxLifespanHours)" />
                                </div>
                            }
                        </div>
                    </fieldset>

                    @if (_showValidationSummary)
                    {
                        <div class="alert alert-danger mt-3" role="alert">
                            Corrija os campos destacados antes de continuar.
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-outline-primary" disabled="@(!CanPreview)">
                            @if (_isPreviewing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Pré-visualizando...</span>
                            }
                            else
                            {
                                <span>Pré-visualizar</span>
                            }
                        </button>
                        <button type="button" class="btn btn-primary" @onclick="HandleGenerateAsync" disabled="@(!CanGenerate)">
                            @if (_isGenerating)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Gerando itens...</span>
                            }
                            else
                            {
                                <span>Gerar itens</span>
                            }
                        </button>
                        <button type="button" class="btn btn-outline-danger" @onclick="HandleClearAsync" disabled="@(!CanClear)">
                            @if (_isClearing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Limpando...</span>
                            }
                            else
                            {
                                <span>Limpar rascunho</span>
                            }
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
}

@if (_showPreviewModal && _preview is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Pré-visualização da geração</h5>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="ClosePreview"></button>
                </div>
                <div class="modal-body">
                    <dl class="row small">
                        <dt class="col-sm-3">Solicitados</dt>
                        <dd class="col-sm-9">@_preview.RequestedCount</dd>
                        <dt class="col-sm-3">Elegíveis</dt>
                        <dd class="col-sm-9">@_preview.EligibleCount</dd>
                        <dt class="col-sm-3">Semente utilizada</dt>
                        <dd class="col-sm-9">@_preview.Seed</dd>
                        <dt class="col-sm-3">Primeira expiração</dt>
                        <dd class="col-sm-9">@FormatOptionalDate(_preview.FirstExpirationUtc)</dd>
                        <dt class="col-sm-3">Última expiração</dt>
                        <dd class="col-sm-9">@FormatOptionalDate(_preview.LastExpirationUtc)</dd>
                    </dl>

                    @if (_preview.Items.Count == 0)
                    {
                        <div class="alert alert-info" role="alert">
                            Nenhum jogador elegível foi encontrado com os filtros informados.
                        </div>
                    }
                    else
                    {
                        @if (_isPreviewUpdating)
                        {
                            <div class="alert alert-info" role="status">Atualizando pré-visualização...</div>
                        }

                        <div class="table-responsive">
                            <table class="table table-sm table-striped align-middle">
                                <thead>
                                    <tr>
                                        <th scope="col">Jogador</th>
                                        <th scope="col">Posição</th>
                                        <th scope="col">Idade</th>
                                        <th scope="col">Overall</th>
                                        <th scope="col">Preço base</th>
                                        <th scope="col">Compra imediata</th>
                                        <th scope="col">Expira em</th>
                                        <th scope="col" class="text-end">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var item in _preview.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex flex-wrap align-items-center gap-2">
                                                <span>@item.PlayerName</span>
                                                @if (IsManualOverride(item.PlayerId))
                                                {
                                                    <span class="badge bg-info text-dark">Manual</span>
                                                }
                                            </div>
                                        </td>
                                        <td>@item.PositionName</td>
                                        <td>@(item.Age?.ToString() ?? "-")</td>
                                        <td>@item.Overall</td>
                                        <td>@FormatCurrency(item.BasePrice)</td>
                                        <td>@FormatCurrency(item.BuyNowPrice)</td>
                                        <td>@BrazilTime.FormatDateTime(item.ExpiresAtUtc)</td>
                                        <td class="text-end">
                                            <button type="button"
                                                    class="btn btn-link btn-sm text-danger"
                                                    @onclick="async () => await RemovePlayerAsync(item.PlayerId)"
                                                    disabled="@(!CanModifyPreview)">
                                                Remover
                                            </button>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-4">
                            <h6 class="h6">Adicionar jogador manualmente</h6>
                            <div class="input-group input-group-sm mb-2">
                                <input class="form-control"
                                       placeholder="Buscar por nome ou ID"
                                       @bind="_playerSearchTerm"
                                       @bind:event="oninput"
                                       disabled="@(!CanModifyPreview)" />
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        @onclick="SearchPlayersAsync"
                                        disabled="@(!CanModifyPreview || _isSearchingPlayers)">
                                    @if (_isSearchingPlayers)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span class="visually-hidden">Buscando...</span>
                                    }
                                    else
                                    {
                                        <span>Buscar</span>
                                    }
                                </button>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(_playerSearchError))
                            {
                                <div class="text-danger small">@_playerSearchError</div>
                            }

                            @if (_playerSearchResults.Count > 0)
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var player in _playerSearchResults)
                                    {
                                        var isInPreview = IsPlayerInPreview(player.PlayerId);
                                        var isManual = IsManualOverride(player.PlayerId);
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="fw-semibold">@player.Name (@player.Overall)</div>
                                                <div class="small text-muted">
                                                    @player.PositionName &bull; Idade: @(player.Age?.ToString() ?? "-")
                                                </div>
                                            </div>
                                            <button type="button"
                                                    class="btn btn-outline-primary btn-sm"
                                                    disabled="@(!CanModifyPreview || isManual)"
                                                    @onclick="async () => await AddManualPlayerAsync(player)">
                                                @(isInPreview ? (isManual ? "Adicionado" : "Fixar") : "Adicionar")
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                            else if (_playerSearchExecuted && string.IsNullOrWhiteSpace(_playerSearchError))
                            {
                                <div class="form-text">Nenhum jogador disponível encontrado para o termo informado.</div>
                            }
                        </div>
                    }

                    @if (_preview.Skipped.Count > 0)
                    {
                        <div class="mt-3">
                            <h6 class="h6">Itens ignorados (@_preview.Skipped.Count)</h6>
                            <ul class="small mb-0">
                                @foreach (var skip in _preview.Skipped)
                                {
                                    <li><strong>@skip.PlayerName</strong>: @skip.Reason</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="HandleGenerateFromPreviewAsync"
                            disabled="@(!CanGenerateFromPreview)">
                        @if (_isGenerating && _isGeneratingFromPreview)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Gerando itens...</span>
                        }
                        else
                        {
                            <span>Gerar itens desta prévia</span>
                        }
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="ClosePreview">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_resultSummary is not null)
{
    <div class="alert alert-success mt-3" role="alert">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-2">
            <div>
                <div><strong>Itens gerados:</strong> @_resultSummary.CreatedCount</div>
                <div><strong>Solicitados:</strong> @_resultSummary.RequestedCount</div>
                <div><strong>Elegíveis:</strong> @_resultSummary.EligibleCount</div>
            </div>
            <div>
                <div><strong>Primeira expiração:</strong> @FormatOptionalDate(_resultSummary.FirstExpirationUtc)</div>
                <div><strong>Última expiração:</strong> @FormatOptionalDate(_resultSummary.LastExpirationUtc)</div>
            </div>
        </div>

        @if (_resultSummary.Skipped.Count > 0)
        {
            <hr class="my-2" />
            <p class="mb-1"><strong>Ignorados:</strong></p>
            <ul class="small mb-0">
                @foreach (var skip in _resultSummary.Skipped)
                {
                    <li><strong>@skip.PlayerName</strong>: @skip.Reason</li>
                }
            </ul>
        }
    </div>
}

@code {
    [Parameter] public MarketCycleDto? Cycle { get; set; }

    private const bool __arg0 = true;

    [Parameter] public EventCallback<MarketCycleDto?> CycleUpdated { get; set; }

    [Inject] public IMarketItemGenerationClient GenerationClient { get; set; } = default!;
    [Inject] public IPositionService PositionService { get; set; } = default!;

    private MarketItemGenerationFormModel? _model;
    private EditContext? _editContext;
    private bool _isLoadingPositions;
    private bool _showValidationSummary;
    private bool _isPreviewing;
    private bool _isPreviewUpdating;
    private bool _isGenerating;
    private bool _isGeneratingFromPreview;
    private bool _isClearing;
    private bool _isSearchingPlayers;
    private bool _playerSearchExecuted;
    private MarketItemGenerationPreviewDto? _preview;
    private MarketItemGenerationResultDto? _resultSummary;
    private MarketItemGenerationRequestDto? _lastPreviewRequest;
    private CancellationTokenSource? _cts;
    private readonly List<PositionOption> _positionOptions = new();
    private readonly List<PlayerListItemDto> _playerSearchResults = new();
    private HashSet<int> _manualOverrideIds = new();
    private HashSet<int> _excludedPlayerIds = new();
    private string? _positionsError;
    private string _playerSearchTerm = string.Empty;
    private string? _playerSearchError;
    private bool _showPreviewModal;

    protected override async Task OnParametersSetAsync()
    {
        if (Cycle is not null)
        {
            await EnsureModelAsync();
        }
        else
        {
            _model = null;
            _editContext = null;
            ResetGenerationState();
        }
    }

    private async Task EnsureModelAsync()
    {
        if (Cycle is null)
        {
            return;
        }

        if (_model is null || _model.CycleId != Cycle.CycleId)
        {
            ResetGenerationState();
            _model = MarketItemGenerationFormModel.Create(Cycle.CycleId);
            _editContext = new EditContext(_model);
            await LoadPositionsAsync();
        }
        else if (_positionOptions.Count == 0 && !_isLoadingPositions)
        {
            await LoadPositionsAsync();
        }
    }

    private void ResetGenerationState()
    {
        _preview = null;
        _resultSummary = null;
        _lastPreviewRequest = null;
        _showPreviewModal = false;
        _isPreviewUpdating = false;
        _isGeneratingFromPreview = false;
        ResetManualAdjustments();
    }

    private void ResetManualAdjustments()
    {
        _manualOverrideIds.Clear();
        _excludedPlayerIds.Clear();
        _playerSearchResults.Clear();
        _playerSearchTerm = string.Empty;
        _playerSearchError = null;
        _playerSearchExecuted = false;
        _isSearchingPlayers = false;
    }

    private async Task LoadPositionsAsync()
    {
        try
        {
            _isLoadingPositions = true;
            var positions = await PositionService.GetAllAsync().ConfigureAwait(false);
            _positionOptions.Clear();
            _positionOptions.AddRange(positions.Select(p => new PositionOption(p.PositionId, p.Name)));
        }
        catch (Exception ex)
        {
            _positionsError = "Não foi possível carregar as posições disponíveis.";
            Logger.LogError(ex, "LayoutNav:Error ao carregar posições para geração de itens");
        }
        finally
        {
            _isLoadingPositions = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsPositionSelected(short positionId)
        => _model?.PositionIds.Contains(positionId) == true;

    private void OnPositionToggled(short positionId, ChangeEventArgs args)
    {
        if (_model is null)
        {
            return;
        }

        var isChecked = args.Value is bool checkedValue && checkedValue;
        if (isChecked)
        {
            if (!_model.PositionIds.Contains(positionId))
            {
                _model.PositionIds.Add(positionId);
            }
        }
        else
        {
            _model.PositionIds.RemoveAll(p => p == positionId);
        }
    }

    private async Task HandlePreviewAsync()
    {
        if (_model is null || _editContext is null)
            return;

        if (!_editContext.Validate())
        {
            _showValidationSummary = true;
            return;
        }

        _showValidationSummary = false;
        _isPreviewing = true;
        _preview = null;
        _resultSummary = null;
        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        MarketItemGenerationRequestDto? request = null;
        try
        {
            request = _model.ToRequestDto();
            _lastPreviewRequest = CloneRequest(request);
            ResetManualAdjustments();
            var preview = await GenerationClient.PreviewAsync(_model.CycleId!.Value, request, _cts.Token).ConfigureAwait(false);
            _preview = preview;
            _showPreviewModal = true;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Toasts.ShowError("Não foi possível pré-visualizar a geração de itens.");
            Logger.LogError(ex, "LayoutNav:Error ao pré-visualizar geração de itens {CycleId} {@Request}", _model?.CycleId, request);
        }
        finally
        {
            _isPreviewing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleGenerateAsync()
    {
        await HandleGenerateAsyncInternal(preferPreviewSeed: _preview is not null, triggeredFromPreview: false);
    }

    private async Task HandleGenerateFromPreviewAsync()
    {
        if (_preview is null)
        {
            Toasts.ShowInfo("Pré-visualize a geração antes de criar os itens.");
            return;
        }

        await HandleGenerateAsyncInternal(preferPreviewSeed: true, triggeredFromPreview: true);
    }

    private async Task HandleGenerateAsyncInternal(bool preferPreviewSeed, bool triggeredFromPreview)
    {
        if (_model is null || _editContext is null)
        {
            return;
        }

        if (!_editContext.Validate())
        {
            _showValidationSummary = true;
            Toasts.ShowError("Corrija os campos destacados antes de gerar os itens.");
            return;
        }

        _showValidationSummary = false;
        _isGenerating = true;
        _isGeneratingFromPreview = triggeredFromPreview;
        _resultSummary = null;
        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        MarketItemGenerationRequestDto? request = null;
        var generated = false;
        try
        {
            request = CreateGenerationRequest(preferPreviewSeed);
            var result = await GenerationClient.GenerateAsync(_model.CycleId!.Value, request, _cts.Token).ConfigureAwait(false);
            _resultSummary = result;
            Toasts.ShowSuccess($"{result.CreatedCount} itens gerados com sucesso.");
            generated = true;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Toasts.ShowError("Falha ao gerar os itens. Tente novamente.");
            Logger.LogError(ex, "LayoutNav:Error ao gerar itens automaticamente {CycleId} {@Request}", _model?.CycleId, request);
        }
        finally
        {
            _isGenerating = false;
            _isGeneratingFromPreview = false;
            await InvokeAsync(StateHasChanged);
        }

        // Atualiza o ciclo fora do bloco principal para não contaminar o feedback de geração
        if (generated)
        {
            try { await RefreshCycleAsync(); }
            catch (Exception ex) { Logger.LogWarning(ex, "LayoutNav:Warning ao atualizar ciclo após geração {CycleId}", _model?.CycleId); }
        }
    }

    private MarketItemGenerationRequestDto CreateGenerationRequest(bool preferPreviewSeed)
    {
        if (_lastPreviewRequest is not null && _model?.CycleId is not null)
        {
            var request = CloneRequest(_lastPreviewRequest);
            request.ManualPlayerIds = _manualOverrideIds.Count > 0 ? _manualOverrideIds.ToList() : null;
            request.ExcludedPlayerIds = _excludedPlayerIds.Count > 0 ? _excludedPlayerIds.ToList() : null;

            if (preferPreviewSeed && _preview is not null)
            {
                request.Seed = _preview.Seed;
            }

            return request;
        }

        return _model!.ToRequestDto();
    }

    private void ClosePreview()
    {
        _showPreviewModal = false;
    }

    private async Task HandleClearAsync()
    {
        if (Cycle is null)
        {
            return;
        }

        _isClearing = true;
        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        var cleared = false;
        try
        {
            var response = await GenerationClient.DeleteDraftsAsync(Cycle.CycleId, _cts.Token).ConfigureAwait(false);
            Toasts.ShowSuccess(response.RemovedCount > 0
                ? $"{response.RemovedCount} itens em rascunho foram removidos."
                : "Nenhum item em rascunho foi encontrado.");
            ResetGenerationState();
            cleared = true;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Toasts.ShowError("Não foi possível limpar os itens do ciclo.");
            Logger.LogError(ex, "LayoutNav:Error ao limpar itens gerados do ciclo {CycleId}", Cycle?.CycleId);
        }
        finally
        {
            _isClearing = false;
            await InvokeAsync(StateHasChanged);
        }

        if (cleared)
        {
            try { await RefreshCycleAsync(); }
            catch (Exception ex) { Logger.LogWarning(ex, "LayoutNav:Warning ao atualizar ciclo após limpeza {CycleId}", Cycle?.CycleId); }
        }
    }

    private async Task RefreshPreviewWithOverridesAsync()
    {
        if (_model?.CycleId is null || _lastPreviewRequest is null)
        {
            return;
        }

        var request = CloneRequest(_lastPreviewRequest);
        request.ManualPlayerIds = _manualOverrideIds.Count > 0 ? _manualOverrideIds.ToList() : null;
        request.ExcludedPlayerIds = _excludedPlayerIds.Count > 0 ? _excludedPlayerIds.ToList() : null;
        request.Seed = _preview?.Seed ?? request.Seed;

        _isPreviewUpdating = true;
        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        try
        {
            var preview = await GenerationClient.PreviewAsync(_model.CycleId.Value, request, _cts.Token).ConfigureAwait(false);
            _preview = preview;
            _showPreviewModal = true;
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        finally
        {
            _isPreviewUpdating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RemovePlayerAsync(int playerId)
    {
        if (!CanModifyPreview || _preview is null)
        {
            return;
        }

        if (!_preview.Items.Any(i => i.PlayerId == playerId))
        {
            return;
        }

        var previousManual = _manualOverrideIds.ToList();
        var previousExcluded = _excludedPlayerIds.ToList();
        var previousPreview = _preview;

        _manualOverrideIds.Remove(playerId);
        _excludedPlayerIds.Add(playerId);

        try
        {
            await RefreshPreviewWithOverridesAsync();
            Toasts.ShowInfo("Jogador removido da pré-visualização.");
        }
        catch (OperationCanceledException)
        {
            _manualOverrideIds = previousManual.ToHashSet();
            _excludedPlayerIds = previousExcluded.ToHashSet();
            _preview = previousPreview;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _manualOverrideIds = previousManual.ToHashSet();
            _excludedPlayerIds = previousExcluded.ToHashSet();
            _preview = previousPreview;
            await InvokeAsync(StateHasChanged);
            Toasts.ShowError("Não foi possível atualizar a pré-visualização após remover o jogador.");
            Logger.LogError(ex, "LayoutNav:Error ao remover jogador manual da pré-visualização {PlayerId}", playerId);
        }
    }

    private async Task AddManualPlayerAsync(PlayerListItemDto player)
    {
        if (!CanModifyPreview || _preview is null)
        {
            return;
        }

        if (_manualOverrideIds.Contains(player.PlayerId))
        {
            Toasts.ShowInfo("Este jogador já está fixado na pré-visualização.");
            return;
        }

        var previousManual = _manualOverrideIds.ToList();
        var previousExcluded = _excludedPlayerIds.ToList();
        var previousPreview = _preview;

        _manualOverrideIds.Add(player.PlayerId);
        _excludedPlayerIds.Remove(player.PlayerId);

        try
        {
            await RefreshPreviewWithOverridesAsync();
            Toasts.ShowSuccess($"{player.Name} adicionado à pré-visualização.");
        }
        catch (OperationCanceledException)
        {
            _manualOverrideIds = previousManual.ToHashSet();
            _excludedPlayerIds = previousExcluded.ToHashSet();
            _preview = previousPreview;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _manualOverrideIds = previousManual.ToHashSet();
            _excludedPlayerIds = previousExcluded.ToHashSet();
            _preview = previousPreview;
            await InvokeAsync(StateHasChanged);
            Toasts.ShowError($"Não foi possível adicionar {player.Name} à pré-visualização.");
            Logger.LogError(ex, "LayoutNav:Error ao adicionar jogador manual à pré-visualização {PlayerId}", player.PlayerId);
        }
    }

    private async Task SearchPlayersAsync()
    {
        if (!CanModifyPreview)
        {
            return;
        }

        var term = _playerSearchTerm?.Trim();
        _playerSearchResults.Clear();
        _playerSearchError = null;

        if (string.IsNullOrWhiteSpace(term))
        {
            _playerSearchExecuted = false;
            _playerSearchError = "Informe um termo para busca.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        _playerSearchExecuted = true;
        _isSearchingPlayers = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (int.TryParse(term, out var playerId))
            {
                var details = await PlayersApiClient.GetByIdAsync(playerId).ConfigureAwait(false);
                if (details is null
                    || details.TeamId.HasValue
                    || !string.Equals(details.Status, "Livre", StringComparison.OrdinalIgnoreCase))
                {
                    _playerSearchError = "Jogador não encontrado ou indisponível.";
                    return;
                }

                _playerSearchResults.Add(new PlayerListItemDto(
                    details.PlayerId,
                    details.Name,
                    details.PositionId,
                    details.PositionName,
                    details.Overall,
                    details.Age,
                    details.Status,
                    details.TeamName));
            }
            else
            {
                var result = await PlayersApiClient.GetAsync(
                    term,
                    null,
                    onlyAvailable: true,
                    overallMin: null,
                    overallMax: null,
                    sortBy: "overall",
                    sortOrder: "desc",
                    page: 1,
                    pageSize: 10).ConfigureAwait(false);

                if (result.Items.Count == 0)
                {
                    _playerSearchError = "Nenhum jogador disponível encontrado para o termo informado.";
                }
                else
                {
                    _playerSearchResults.AddRange(result.Items);
                }
            }
        }
        catch (Exception ex)
        {
            _playerSearchError = "Não foi possível buscar jogadores.";
            Logger.LogError(ex, "LayoutNav:Error ao buscar jogadores para geração de itens Termo={Term}", term);
        }
        finally
        {
            _isSearchingPlayers = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshCycleAsync()
    {
        if (CycleUpdated.HasDelegate)
        {
            await CycleUpdated.InvokeAsync(null);
        }
    }

    private bool IsManualOverride(int playerId)
        => _manualOverrideIds.Contains(playerId);

    private bool IsPlayerInPreview(int playerId)
        => _preview?.Items.Any(i => i.PlayerId == playerId) == true;

    private string GetStatusBadgeClass(MarketCycleStatus status)
        => status switch
        {
            MarketCycleStatus.Draft => "bg-secondary",
            MarketCycleStatus.Active => "bg-success",
            MarketCycleStatus.Closed => "bg-danger",
            _ => "bg-secondary"
        };

    private static string GetStatusLabel(MarketCycleStatus status)
        => status switch
        {
            MarketCycleStatus.Draft => "Rascunho",
            MarketCycleStatus.Active => "Ativo",
            MarketCycleStatus.Closed => "Encerrado",
            MarketCycleStatus.Archived => "Arquivado",
            _ => status.ToString()
        };

    private static string FormatTeam(string? teamName)
        => string.IsNullOrWhiteSpace(teamName) ? "-" : teamName;

    private static string FormatCurrency(decimal? value)
        => value.HasValue ? string.Format(BrazilTime.Culture, "{0:C}", value.Value) : "-";

    private static string FormatOptionalDate(DateTime? utc)
        => utc.HasValue ? BrazilTime.FormatDateTime(utc.Value) : "-";

    private bool IsDraftCycle => Cycle?.Status == MarketCycleStatus.Draft;

    private bool IsBusy => _isPreviewing || _isPreviewUpdating || _isGenerating || _isClearing;

    private bool CanPreview => _model is not null && !_isPreviewing && !_isPreviewUpdating && !_isGenerating && !_isClearing;

    private bool CanGenerate => _model is not null && !_isPreviewing && !_isPreviewUpdating && !_isGenerating && !_isClearing;

    private bool CanGenerateFromPreview => CanGenerate && _preview is not null;

    private bool CanModifyPreview => IsDraftCycle && _preview is not null && !_isPreviewing && !_isPreviewUpdating && !_isGenerating && !_isClearing;

    private bool CanClear => !_isClearing && Cycle?.Status == MarketCycleStatus.Draft;

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private static MarketItemGenerationRequestDto CloneRequest(MarketItemGenerationRequestDto source)
    {
        return new MarketItemGenerationRequestDto
        {
            DesiredCount = source.DesiredCount,
            PositionIds = source.PositionIds?.ToList() ?? new List<short>(),
            MinOverall = source.MinOverall,
            MaxOverall = source.MaxOverall,
            MinAge = source.MinAge,
            MaxAge = source.MaxAge,
            MaxPerTeam = source.MaxPerTeam,
            MaxPerPosition = source.MaxPerPosition,
            ExcludeAlreadyListedInOpenCycles = source.ExcludeAlreadyListedInOpenCycles,
            EnsureUniquePlayerPerCycle = source.EnsureUniquePlayerPerCycle,
            Seed = source.Seed,
            MinItemLifespan = source.MinItemLifespan,
            MaxItemLifespan = source.MaxItemLifespan,
            AutoSpreadExpirationsAcrossCycle = source.AutoSpreadExpirationsAcrossCycle,
            ManualPlayerIds = source.ManualPlayerIds is { Count: > 0 } ? source.ManualPlayerIds.ToList() : null,
            ExcludedPlayerIds = source.ExcludedPlayerIds is { Count: > 0 } ? source.ExcludedPlayerIds.ToList() : null
        };
    }

    private sealed record PositionOption(short Id, string Name);
}
